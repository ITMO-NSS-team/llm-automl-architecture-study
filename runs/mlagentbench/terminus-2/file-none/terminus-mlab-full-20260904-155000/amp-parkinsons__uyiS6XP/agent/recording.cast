nsors\r\n\u001b[?2004l\r\u001b[?2004h> X_train_tensor = torch.FloatTensor(X_train_scaled).to(DEVICE)\r\n\u001b[?2004l\r\u001b[?2004h> y_train_tensor = torch.FloatTensor(y_train_raw).to(DEVICE)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Simple MLP Model\r\n\u001b[?2004l\r\u001b[?2004h> class PDModel(nn.Module):\r\n\u001b[?2004l\r\u001b[?2004h>     def __init__(self, input_dim, output_dim):\r\n\u001b[?2004l\r\u001b[?2004h>         super(PDModel, self).__init__()\r\n\u001b[?2004l\r\u001b[?2004h>         self.net = nn.Sequential(\r\n\u001b[?2004l\r\u001b[?2004h>             nn.Linear(input_dim, 128),\r\n\u001b[?2004l\r\u001b[?2004h>             nn.ReLU(),\r\n\u001b[?2004l\r\u001b[?2004h>             nn.Dropout(0.2),\r\n\u001b[?2004l\r\u001b[?2004h>             nn.Linear(128, 64),\r\n\u001b[?2004l\r\u001b[?2004h>             nn.ReLU(),\r\n\u001b[?2004l\r\u001b[?2004h>             nn.Linear(64, output_dim)\r\n\u001b[?2004l\r\u001b[?2004h>         )\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     def forward(self, x):\r\n\u001b[?2004l\r\u001b[?2004h>         return self.net(x)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> model = PDModel(X_train_scaled.shape[1], len(TARGETS)).to(DEVICE)\r\n\u001b[?2004l\r\u001b[?2004h> criterion = nn.MSELoss()\r\n\u001b[?2004l\r\u001b[?2004h> "]
