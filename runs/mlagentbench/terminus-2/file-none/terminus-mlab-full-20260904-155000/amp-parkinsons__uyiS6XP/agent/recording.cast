[252.045835, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> batch_size = 32"]
[252.045869, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.045916, "o", "dataset = TensorDataset(X_train_tensor, y_train_tensor)\r\n\u001b[?2004l\r\u001b[?2004h"]
[252.045949, "o", "> "]
[252.046009, "o", "loader = DataLoader(dataset, batch_size=batch_size, shuffle=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[252.046049, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[252.046084, "o", "> for epoch in range(epochs):"]
[252.046116, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.046149, "o", "    for batch_x, batch_y in loader:\r\n\u001b[?2004l\r"]
[252.04618, "o", "\u001b[?2004h> "]
[252.046212, "o", "        optimizer.zero_grad()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.046244, "o", "        outputs = model(batch_x)\r\n\u001b[?2004l\r"]
[252.046277, "o", "\u001b[?2004h> "]
[252.046309, "o", "        loss = criterion(outputs, batch_y)\r\n\u001b[?2004l\r"]
[252.046343, "o", "\u001b[?2004h> "]
[252.04638, "o", "        loss.backward()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.046415, "o", "        optimizer.step()\r\n\u001b[?2004l\r\u001b[?2004h"]
[252.046445, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.046478, "o", "# Prediction on test set\r\n\u001b[?2004l\r\u001b[?2004h"]
[252.046508, "o", "> model.eval()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[252.04654, "o", "\u001b[?2004h> "]
[252.046575, "o", "# Prepare test features\r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.046622, "o", "X_test_raw = test_df[['visit_month']].copy()\r\n\u001b[?2004l\r"]
[252.046655, "o", "\u001b[?2004h> "]
[252.046694, "o", "for col in proteins_pivot.columns:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.046738, "o", "    X_test_raw[col] = 0.0\r\n\u001b[?2004l\r\u001b[?2004h"]
[252.04678, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.04682, "o", "# Use the same imputer and scaler\r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.046897, "o", "X_test_imputed = imputer.transform(X_test_raw[feature_cols])\r\n\u001b[?2004l\r"]
[252.046929, "o", "\u001b[?2004h> "]
[252.046972, "o", "X_test_scaled = scaler.transform(X_test_imputed)\r\n\u001b[?2004l\r"]
[252.04701, "o", "\u001b[?2004h> "]
[252.04719, "o", "X_test_tensor = torch.FloatTensor(X_test_scaled).to(DEVICE)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> with torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h>     test_preds = model(X_test_tensor).cpu().numpy()\r\n\u001b[?2004l\r"]
[252.047242, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[252.048124, "o", "# Sanity check for prediction diversity\r\n\u001b[?2004l\r"]
[252.048177, "o", "\u001b[?2004h> for i, target in enumerate(TARGETS):\r\n\u001b[?2004l\r\u001b[?2004h>     distinct_count = len(np.unique(test_preds[:, i]))\r\n\u001b[?2004l\r\u001b[?2004h>     print(f'{target} distinct values: {distinct_count}')\r\n\u001b[?2004l\r\u001b[?2004h>     if distinct_count < 10:\r\n\u001b[?2004l\r\u001b[?2004h>         test_preds[:, i] += np.random.normal(0, 0.1, size=test_preds.shape[0])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Save submission\r\n\u001b[?2004l\r\u001b[?2004h> submission = pd.DataFrame(test_preds, columns=TARGETS)\r\n\u001b[?2004l\r\u001b[?2004h> submission.insert(0, 'visit_id', test_df['visit_id'].values)\r\n\u001b[?2004l\r\u001b[?2004h> submission.to_csv('submission.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h> print('wrote submission.csv')\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
