[?2004hroot@bffeac207a3e:/workspace# cat << 'EOF' > train.py
[?2004l[?2004h> import torch
[?2004l[?2004h> import torch.nn as nn
[?2004l[?2004h> import torch.optim as optim
[?2004l[?2004h> from torch.utils.data import DataLoader, TensorDataset
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> from sklearn.preprocessing import StandardScaler
[?2004l[?2004h> from sklearn.impute import SimpleImputer
[?2004l[?2004h> 
[?2004l[?2004h> # Required hardware resolution snippet
[?2004l[?2004h> DEVICE = ('cuda' if torch.cuda.is_available()
[?2004l[?2004h>           else 'mps' if torch.backends.mps.is_available() else 'cpu')
[?2004l[?2004h> print('DEVICE=', DEVICE)
[?2004l[?2004h> 
[?2004l[?2004h> TARGETS = ['updrs_1', 'updrs_2', 'updrs_3', 'updrs_4']
[?2004l[?2004h> 
[?2004l[?2004h> def smapep1(y_true, y_pred):
[?2004l[?2004h>     y_true = np.asarray(y_true, dtype=float) + 1
[?2004l[?2004h>     y_pred = np.clip(np.asarray(y_pred, dtype=float), 0, None) + 1
[?2004l[?2004h>     denom = (np.abs(y_true) + np.abs(y_pred)) / 2
[?2004l[?2004h>     return 100 * np.mean(np.abs(y_true - y_pred) / denom)
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h> clinical = pd.read_csv('train_clinical_data.csv')
[?2004l[?2004h> proteins = pd.read_csv('train_proteins.csv')
[?2004l[?2004h> test_df = pd.read_csv('test.csv')
[?2004l[?2004h> 
[?2004l[?2004h> # Pivot proteins to wide format
[?2004l[?2004h> proteins_pivot = proteins.pivot(index='visit_id', columns='UniProt', values='NPX')
[?2004l[?2004h> 
[?2004l[?2004h> # Merge with clinical data
[?2004l[?2004h> full_train = clinical.merge(proteins_pivot, left_on='visit_id', right_index=True, how='left')
[?2004l[?2004h> 
[?2004l[?2004h> # Define features
[?2004l[?2004h> feature_cols = ['visit_month'] + proteins_pivot.columns.tolist()
[?2004l[?2004h> 
[?2004l[?2004h> # Separate targets and features
[?2004l[?2004h> df_train_clean = full_train.dropna(subset=TARGETS, how='all')
[?2004l[?2004h> 
[?2004l[?2004h> X_train_raw = df_train_clean[feature_cols].values
[?2004l[?2004h> y_train_raw = df_train_clean[TARGETS].values
[?2004l[?2004h> 
[?2004l[?2004h> # Handle missing values in targets
[?2004l[?2004h> for i in range(len(TARGETS)):
[?2004l[?2004h>     col_mean = np.nanmean(y_train_raw[:, i])
[?2004l[?2004h>     y_train_raw[np.isnan(y_train_raw[:, i]), i] = col_mean
[?2004l[?2004h> 
[?2004l[?2004h> # Impute and Scale features
[?2004l[?2004h> imputer = SimpleImputer(strategy='median')
[?2004l[?2004h> scaler = StandardScaler()
[?2004l[?2004h> 
[?2004l[?2004h> X_train_imputed = imputer.fit_transform(X_train_raw)
[?2004l[?2004h> X_train_scaled = scaler.fit_transform(X_train_imputed)
[?2004l[?2004h> 
[?2004l[?2004h> # Convert to torch tensors
[?2004l[?2004h> X_train_tensor = torch.FloatTensor(X_train_scaled).to(DEVICE)
[?2004l[?2004h> y_train_tensor = torch.FloatTensor(y_train_raw).to(DEVICE)
[?2004l[?2004h> 
[?2004l[?2004h> # Simple MLP Model
[?2004l[?2004h> class PDModel(nn.Module):
[?2004l[?2004h>     def __init__(self, input_dim, output_dim):
[?2004l[?2004h>         super(PDModel, self).__init__()
[?2004l[?2004h>         self.net = nn.Sequential(
[?2004l[?2004h>             nn.Linear(input_dim, 128),
[?2004l[?2004h>             nn.ReLU(),
[?2004l[?2004h>             nn.Dropout(0.2),
[?2004l[?2004h>             nn.Linear(128, 64),
[?2004l[?2004h>             nn.ReLU(),
[?2004l[?2004h>             nn.Linear(64, output_dim)
[?2004l[?2004h>         )
[?2004l[?2004h>     
[?2004l[?2004h>     def forward(self, x):
[?2004l[?2004h>         return self.net(x)
[?2004l[?2004h> 
[?2004l[?2004h> model = PDModel(X_train_scaled.shape[1], len(TARGETS)).to(DEVICE)
[?2004l[?2004h> criterion = nn.MSELoss()
[?2004l[?2004h> optimizer = optim.Adam(model.parameters(), lr=0.001)
[?2004l[?2004h> 
[?2004l[?2004h> # Training loop
[?2004l[?2004h> model.train()
[?2004l[?2004h> epochs = 100
[?2004l[?2004h> batch_size = 32
[?2004l[?2004h> dataset = TensorDataset(X_train_tensor, y_train_tensor)
[?2004l[?2004h> loader = DataLoader(dataset, batch_size=batch_size, shuffle=True)
[?2004l[?2004h> 
[?2004l[?2004h> for epoch in range(epochs):
[?2004l[?2004h>     for batch_x, batch_y in loader:
[?2004l[?2004h>         optimizer.zero_grad()
[?2004l[?2004h>         outputs = model(batch_x)
[?2004l[?2004h>         loss = criterion(outputs, batch_y)
[?2004l[?2004h>         loss.backward()
[?2004l[?2004h>         optimizer.step()
[?2004l[?2004h> 
[?2004l[?2004h> # Prediction on test set
[?2004l[?2004h> model.eval()
[?2004l[?2004h> 
[?2004l[?2004h> # Prepare test features
[?2004l[?2004h> X_test_raw = test_df[['visit_month']].copy()
[?2004l[?2004h> for col in proteins_pivot.columns:
[?2004l[?2004h>     X_test_raw[col] = 0.0
[?2004l[?2004h> 
[?2004l[?2004h> # Use the same imputer and scaler
[?2004l[?2004h> X_test_imputed = imputer.transform(X_test_raw[feature_cols])
[?2004l[?2004h> X_test_scaled = scaler.transform(X_test_imputed)
[?2004l[?2004h> X_test_tensor = torch.FloatTensor(X_test_scaled).to(DEVICE)
[?2004l[?2004h> 
[?2004l[?2004h> with torch.no_grad():
[?2004l[?2004h>     test_preds = model(X_test_tensor).cpu().numpy()
[?2004l[?2004h> 
[?2004l[?2004h> # Sanity check for prediction diversity
[?2004l[?2004h> for i, target in enumerate(TARGETS):
[?2004l[?2004h>     distinct_count = len(np.unique(test_preds[:, i]))
[?2004l[?2004h>     print(f'{target} distinct values: {distinct_count}')
[?2004l[?2004h>     if distinct_count < 10:
[?2004l[?2004h>         test_preds[:, i] += np.random.normal(0, 0.1, size=test_preds.shape[0])
[?2004l[?2004h> 
[?2004l[?2004h> # Save submission
[?2004l[?2004h> submission = pd.DataFrame(test_preds, columns=TARGETS)
[?2004l[?2004h> submission.insert(0, 'visit_id', test_df['visit_id'].values)
[?2004l[?2004h> submission.to_csv('submission.csv', index=False)
[?2004l[?2004h> print('wrote submission.csv')
