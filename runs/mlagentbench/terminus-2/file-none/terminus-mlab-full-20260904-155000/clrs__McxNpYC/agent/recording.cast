[3.123332, "i", "cat train.py\n"]
[3.127332, "o", "cat train.py\r\n\u001b[?2004l\r"]
[3.128199, "o", "import numpy as np\r\nimport pandas as pd\r\nimport torch\r\nimport torch.nn as nn\r\n"]
[3.128286, "o", "\r\ndevice = ('cuda' if torch.cuda.is_available()\r\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\r\nprint('DEVICE=', device)\r\n\r\ntr = np.load('train.npz')"]
[3.12837, "o", "\r\nte = np.load('test.npz')\r\nA_tr, Pi_tr = tr['A'].astype(np.float32), tr['Pi'].astype(np.int64)\r\nA_te = te['A'].astype(np.float32)\r\nN_tr, N_te = A_tr.shape[1], A_te.shape[1]\r\n\r\nepochs = 5      # weak baseline: scores each candidate from two edge weights only\r\n\r\n\r\nclass Baseline(nn.Module):\r\n    \"\"\"For pair (i, j) and candidate k, score it from A[i, k] and A[k, j] alone.\"\"\"\r\n\r\n    def __init__(self, hidden=32):\r\n        super().__init__()\r\n        self.net = nn.Sequential(nn.Linear(2, hidden), nn.ReLU(), nn.Linear(hidden, 1))\r\n\r\n    def forward(self, A):                            # A: (B, N, N)\r\n        B, N, _ = A.shape\r\n        ik = A.unsqueeze(2).expand(B, N, N, N)       # A[b, i, k] over (i, j, k)\r\n        kj = A.unsqueeze(1).transpose(2, 3).expand(B, N, N, N)   # A[b, k, j]\r\n        feat = torch.stack([ik, kj], dim=-1)         # (B, N, N, N, 2)\r\n        return self.net(feat).squeeze(-1)            # (B, N, N, N) logits over k\r\n\r\n\r\nmodel = Baseline().to(device)\r\nopt = torch.optim.Adam(model.parameters(), lr=1e-3)\r\nlossf = nn.CrossEntropyLoss()\r\n\r\nX, Y = torch.tensor(A_tr), torch.tensor(Pi_tr)\r\nfor epoch in range(epochs):\r\n    model.train()\r\n    perm = torch.randperm(len(X))\r\n    total, nb = 0.0, 0\r\n    for i in range(0, len(X), 32):\r\n        idx = perm[i:i + 32]"]
[3.128439, "o", "\r\n        xb, yb = X[idx].to(device), Y[idx].to(device)\r\n        opt.zero_grad()\r\n        logits = model(xb)                            # (B, N, N, N)\r\n        loss = lossf(logits.reshape(-1, N_tr), yb.reshape(-1))\r\n        loss.backward()\r\n        opt.step()\r\n        total += loss.item(); nb += 1\r\n    print(f'epoch {epoch} loss {total / max(nb, 1):.4f}')\r\n\r\nmodel.eval()\r\nrows = []\r\nwith torch.no_grad():\r\n    for g in range(len(A_te)):\r\n        pred = model(torch.tensor(A_te[g:g + 1]).to(device)).argmax(-1)[0].cpu().numpy()\r\n        for r in range(N_te):\r\n            rows.append({'graph_id': g, 'row': r,\r\n"]
[3.128493, "o", "                         'pointers': ' '.join(str(int(v)) for v in pred[r])})\r\npd.DataFrame(rows).to_csv('submission.csv', index=False)\r\nprint('wrote submission.csv')\r\n"]
[3.128614, "o", "\u001b[?2004h"]
[3.128673, "o", "root@242da9965cba:/workspace# "]
[102.548308, "i", "cat << 'EOF' > train.py\nimport numpy as np\nimport pandas as pd\nimport torch\nimport torch.nn as nn\n\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\ntr = np.load('train.npz')\nte = np.load('test.npz')\nA_tr, Pi_tr = tr['A'].astype(np.float32), tr['Pi'].astype(np.int64)\nA_te = te['A'].astype(np.float32)\nN_tr, N_te = A_tr.shape[1], A_te.shape[1]\n\nepochs = 50\n\nclass ImprovedModel(nn.Module):\n    def __init__(self, hidden=128):\n        super().__init__()\n        self.net = nn.Sequential(\n            nn.Linear(2, hidden),\n            nn.ReLU(),\n            nn.Linear(hidden, hidden),\n            nn.ReLU(),\n            nn.Linear(hidden, 1)\n        )\n\n    def forward(self, A):\n        B, N, _ = A.shape\n        # A: (B, N, N)\n        # ik: A[b, i, k] -> (B, N, N, N)\n        ik = A.unsqueeze(2).expand(B, N, N, N)\n        # kj: A[b, k, j] -> (B, N, N, N)\n        kj = A.unsqueeze(1).transpose(2, 3).expand(B, N, N, N)\n        \n        feat = torch.stack([ik, kj], dim=-1)  # (B, N, N, N, 2)\n        return self.net(feat).squeeze(-1)      # (B, N, N, N)\n\nmodel = ImprovedModel().to(DEVICE)\nopt = torch.optim.Adam(model.parameters(), lr=1e-3)\nlossf = nn.CrossEntropyLoss()\n\nX, Y = torch.tensor(A_tr), torch.tensor(Pi_tr)\nfor epoch in range(epochs):\n    model.train()\n    perm = torch.randperm(len(X))\n    total, nb = 0.0, 0\n    for i in range(0, len(X), 32):\n        idx = perm[i:i + 32]\n        xb, yb = X[idx].to(DEVICE), Y[idx].to(DEVICE)\n        opt.zero_grad()\n        logits = model(xb)\n        loss = lossf(logits.reshape(-1, N_tr), yb.reshape(-1))\n        loss.backward()\n        opt.step()\n        total += loss.item(); nb += 1\n    if (epoch + 1) % 10 == 0 or epoch == 0:\n        print(f'epoch {epoch} loss {total / max(nb, 1):.4f}')\n\nmodel.eval()\nrows = []\nwith torch.no_grad():\n    for g in range(len(A_te)):\n        pred = model(torch.tensor(A_te[g:g + 1]).to(DEVICE)).argmax(-1)[0].cpu().numpy()\n        for r in range(N_te):\n            rows.append({'graph_id': g, 'row': r,\n                         'pointers': ' '.join(str(int(v)) for v in pred[r])})\npd.DataFrame(rows).to_csv('submission.csv', index=False)\nprint('wrote submission.csv')\nEOF\n"]
[102.548578, "o", "cat << 'EOF' > train.py\r\n"]
