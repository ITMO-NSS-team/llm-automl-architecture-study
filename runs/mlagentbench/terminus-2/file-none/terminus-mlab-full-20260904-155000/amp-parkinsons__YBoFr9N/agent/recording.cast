[62.391952, "i", "cat <<EOF > train.py\nimport numpy as np\nimport pandas as pd\nimport torch\nimport torch.nn as nn\nimport torch.optim as optim\nfrom torch.utils.data import DataLoader, TensorDataset\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.model_selection import train_test_split\n\n# Device selection as required\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\nTARGETS = ['updrs_1', 'updrs_2', 'updrs_3', 'updrs_4']\n\ndef smapep1(y_true, y_pred):\n    y_true = np.asarray(y_true, dtype=float) + 1\n    y_pred = np.clip(np.asarray(y_pred, dtype=float), 0, None) + 1\n    denom = (np.abs(y_true) + np.abs(y_pred)) / 2\n    return 100 * np.mean(np.abs(y_true - y_pred) / denom)\n\n# Load data\nclinical = pd.read_csv('train_clinical_data.csv')\nproteins = pd.read_csv('train_proteins.csv')\ntest_df = pd.read_csv('test.csv')\n\n# Pivot proteins to wide format\nproteins_wide = proteins.pivot(index='visit_id', columns='UniProt', values='NPX')\n\n# Merge clinical and proteins\nfull_train = clinical.merge(proteins_wide, left_on='visit_id', right_index=True)\n\n# Prepare features and targets\n# We use proteins and visit_month as features\nfeature_cols = proteins_wide.columns.tolist() + ['visit_month']\nX = full_train[feature_cols].fillna(full_train[feature_cols].median())\nY = full_train[TARGETS].fillna(full_train[TARGETS].median())\n\n# Scale features\nscaler = StandardScaler()\nX_scaled = scaler.fit_transform(X)\n\n# Split for validation\nX_train, X_val, y_train, y_val = train_test_split(X_scaled, Y, test_size=0.2, random_state=42)\n\n# PyTorch Model\nclass ParkinsonModel(nn.Module):\n    def __init__(self, input_dim):\n        super().__init__()\n        self.net = nn.Sequential(\n            nn.Linear(input_dim, 128),\n            nn.ReLU(),\n            nn.Linear(128, 64),\n            nn.ReLU(),\n            nn.Linear(64, 4)\n        )\n    def forward(self, x):\n        return self.net(x)\n\n# Training setup\ninput_dim = X_scaled.shape[1]\nmodel = ParkinsonModel(input_dim).to(DEVI"]
[62.392373, "o", "cat <<EOF > train.py\r\n\u001b[?2004l\r"]
[62.392461, "o", "\u001b[?2004h"]
[62.392505, "o", "> "]
[62.392551, "o", "import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h"]
[62.393814, "o", "> "]
[62.393872, "o", "import pandas as pd\r\n\u001b[?2004l\r\u001b[?2004h> import torch\r\n\u001b[?2004l\r\u001b[?2004h> import torch.nn as nn\r\n\u001b[?2004l\r\u001b[?2004h> import torch.optim as optim\r\n\u001b[?2004l\r\u001b[?2004h> from torch.utils.data import DataLoader, TensorDataset\r\n\u001b[?2004l\r\u001b[?2004h> "]
[62.393928, "i", "CE)\noptimizer = optim.Adam(model.parameters(), lr=0.001)\ncriterion = nn.MSELoss()\n\n# Convert to tensors\ntrain_ds = TensorDataset(torch.tensor(X_train, dtype=torch.float32).to(DEVICE), \n                          torch.tensor(y_train.values, dtype=torch.float32).to(DEVICE))\ntrain_loader = DataLoader(train_ds, batch_size=32, shuffle=True)\n\n# Train\nmodel.train()\nfor epoch in range(50):\n    for batch_X, batch_y in train_loader:\n        optimizer.zero_grad()\n        pred = model(batch_X)\n        loss = criterion(pred, batch_y)\n        loss.backward()\n        optimizer.step()\n\n# Evaluate\nmodel.eval()\nwith torch.no_grad():\n    val_pred = model(torch.tensor(X_val, dtype=torch.float32).to(DEVICE)).cpu().numpy()\n    print(f'Validation SMAPE: {smapep1(y_val.values, val_pred):.2f}')\n\n# Process test set\n# Need to pivot test proteins if available? Wait, the prompt says test.csv is provided.\n# But wait, test.csv only has visit_id and visit_month. I need the test protein data.\n# Let me check if there are other files in the workspace.\nEOF\n"]
