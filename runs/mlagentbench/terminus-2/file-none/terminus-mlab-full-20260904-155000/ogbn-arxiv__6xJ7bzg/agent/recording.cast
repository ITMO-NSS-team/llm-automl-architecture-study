[243.408202, "o", "    edge_index = edge_index.t().contiguous()\r\n\u001b[?2004l\r"]
[243.408256, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[243.408295, "o", "\u001b[?2004h> "]
[243.408346, "o", "data = Data(x=x, edge_index=edge_index)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[243.408366, "o", "> # Labels and masks\r\n\u001b[?2004l\r\u001b[?2004h> "]
[243.408397, "o", "n_nodes = feat.shape[0]\r\n\u001b[?2004l\r"]
[243.408419, "o", "\u001b[?2004h> "]
[243.408446, "o", "train_ids = tr['id'].values\r\n\u001b[?2004l\r"]
[243.408515, "o", "\u001b[?2004h> "]
[243.408566, "o", "train_labels = tr['label'].values\r\n\u001b[?2004l\r"]
[243.408616, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[243.408664, "o", "all_labels = torch.full((n_nodes,), -1, dtype=torch.long)\r\n\u001b[?2004l\r"]
[243.408707, "o", "\u001b[?2004h> "]
[243.408733, "o", "all_labels[train_ids] = torch.tensor(train_labels, dtype=torch.long)\r\n\u001b[?2004l\r"]
[243.408761, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[243.408799, "o", "\u001b[?2004h> "]
[243.408834, "o", "train_mask = torch.zeros(n_nodes, dtype=torch.bool)\r\n\u001b[?2004l\r"]
[243.408861, "o", "\u001b[?2004h> "]
[243.408901, "o", "train_mask[train_ids] = True\r\n\u001b[?2004l\r"]
[243.408921, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[243.408957, "o", "test_ids = te['id'].values\r\n\u001b[?2004l\r"]
[243.408977, "o", "\u001b[?2004h> "]
[243.409019, "o", "n_classes = int(tr['label'].max()) + 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[243.409049, "o", "> "]
[243.409126, "o", "\r\n\u001b[?2004l\r"]
[243.409157, "o", "\u001b[?2004h> "]
[243.409192, "o", "class SAGE(nn.Module):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[243.409246, "o", "    def __init__(self, in_dim, hidden, out_dim):\r\n\u001b[?2004l\r"]
[243.40928, "o", "\u001b[?2004h> "]
[243.409311, "o", "        super().__init__()\r\n\u001b[?2004l\r\u001b[?2004h"]
[243.409427, "o", "> "]
[243.409482, "o", "        self.conv1 = SAGEConv(in_dim, hidden)\r\n\u001b[?2004l\r\u001b[?2004h>         self.conv2 = SAGEConv(hidden, out_dim)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[243.40954, "o", "\u001b[?2004h>     def forward(self, x, edge_index):\r\n\u001b[?2004l\r"]
[243.409557, "o", "\u001b[?2004h>         x = self.conv1(x, edge_index)\r\n\u001b[?2004l\r"]
[243.409597, "o", "\u001b[?2004h> "]
[243.40964, "o", "        x = F.relu(x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[243.409681, "o", "        x = F.dropout(x, p=0.5, training=self.training)\r\n\u001b[?2004l\r"]
[243.409708, "o", "\u001b[?2004h> "]
[243.40974, "o", "        x = self.conv2(x, edge_index)\r\n\u001b[?2004l\r"]
[243.409766, "o", "\u001b[?2004h> "]
[243.40981, "o", "        return x\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[243.409861, "o", "\u001b[?2004h> "]
[243.409918, "o", "model = SAGE(feat.shape[1], 256, n_classes).to(DEVICE)\r\n\u001b[?2004l\r\u001b[?2004h"]
[243.409953, "o", "> "]
[243.40998, "o", "optimizer = torch.optim.Adam(model.parameters(), lr=0.01, weight_decay=5e-4)\r\n\u001b[?2004l\r"]
[243.410008, "o", "\u001b[?2004h> "]
[243.410043, "o", "criterion = nn.CrossEntropyLoss()\r\n\u001b[?2004l\r"]
[243.410073, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[243.410099, "o", "data = data.to(DEVICE)\r\n\u001b[?2004l\r\u001b[?2004h"]
[243.410121, "o", "> "]
[243.410413, "o", "all_labels = all_labels.to(DEVICE)\r\n\u001b[?2004l\r\u001b[?2004h> train_mask = train_mask.to(DEVICE)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> epochs = 10\r\n\u001b[?2004l\r\u001b[?2004h"]
[243.410428, "o", "> "]
[243.41048, "o", "for epoch in range(epochs):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[243.410495, "o", "    model.train()\r\n\u001b[?2004l\r\u001b[?2004h"]
[243.410508, "o", "> "]
[243.410559, "o", "    optimizer.zero_grad()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[243.410608, "o", "    out = model(data.x, data.edge_index)\r\n\u001b[?2004l\r"]
[243.41063, "o", "\u001b[?2004h> "]
[243.410703, "o", "    loss = criterion(out[train_mask], all_labels[train_mask])\r\n\u001b[?2004l\r"]
[243.410719, "o", "\u001b[?2004h> "]
[243.410742, "o", "    loss.backward()\r\n\u001b[?2004l\r"]
[243.410755, "o", "\u001b[?2004h> "]
[243.410796, "o", "    optimizer.step()\r\n\u001b[?2004l\r"]
[243.410812, "o", "\u001b[?2004h> "]
[243.410893, "o", "    print(f'epoch {epoch} loss {loss.item():.4f}')"]
[243.41108, "o", "\r\n\u001b[?2004l\r"]
[243.411112, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> model.eval()\r\n\u001b[?2004l\r\u001b[?2004h> with torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[243.411128, "o", "    out = model(data.x, data.edge_index)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[243.411196, "o", "    pred = out[test_ids].argmax(1).cpu().numpy()"]
[243.411262, "o", "\r\n\u001b[?2004l\r"]
[243.411298, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[243.411327, "o", "> "]
[243.411395, "o", "pd.DataFrame({'id': test_ids, 'label': pred}).to_csv('submission.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h"]
[243.411428, "o", "> "]
[243.411462, "o", "print('wrote submission.csv')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[243.411496, "o", "EOF\r\n\u001b[?2004l\r"]
