[12.666756, "o", "\r\n\u001b[?2004l\r"]
[12.669894, "o", "import numpy as np\r\nimport pandas as pd"]
[12.669942, "o", "\r\nimport torch\r\nimport torch.nn as nn\r\nimport torch.nn.functional as F\r\n\r\ndevice = ('cuda' if torch.cuda.is_available()\r\n"]
[12.669993, "o", "          else 'mps' if torch.backends.mps.is_available() else 'cpu')\r\nprint('DEVICE=', device)\r\n\r\n"]
[12.670027, "o", "feat = np.load('node_features.npy').astype(np.float32)\r\nedges = np.load('edges.npy')            # the baseline below ignores the graph entirely\r\ntr = pd.read_csv('train.csv')\r\nte = pd.read_csv('test.csv')\r\n\r\nXtr = torch.tensor(feat[tr['id'].values])\r\n"]
[12.670083, "o", "ytr = torch.tensor(tr['label'].values, dtype=torch.long)\r\nXte = torch.tensor(feat[te['id'].values])\r\nn_classes = int(tr['label'].max()) + 1"]
[12.670135, "o", "\r\n\r\n\r\nclass MLP(nn.Module):\r\n    def __init__(self, in_dim, hidden, out_dim, num_layers=2, dropout=0.0):\r\n        super().__init__()\r\n        self.lins = nn.ModuleList([nn.Linear(in_dim, hidden)])\r\n"]
[12.670176, "o", "        for _ in range(num_layers - 2):\r\n            self.lins.append(nn.Linear(hidden, hidden))\r\n        self.lins.append(nn.Linear(hidden, out_dim))\r\n        self.dropout = dropout\r\n\r\n    def forward(self, x):\r\n        for lin in self.lins[:-1]:\r\n            x = F.relu(lin(x))\r\n            x = F.dropout(x, p=self.dropout, training=self.training)\r\n        return self.lins[-1](x)\r\n\r\n\r\n# model = SAGE(feat.shape[1], 256, n_classes, num_layers=2)   # graph model, unused\r\n"]
[12.670215, "o", "model = MLP(feat.shape[1], hidden=16, out_dim=n_classes, num_layers=2).to(device)\r\noptimizer = torch.optim.Adam(model.parameters(), lr=1)\r\ncriterion = nn.CrossEntropyLoss()\r\n\r\nepochs = 4\r\nXtr_d, ytr_d = Xtr.to(device), ytr.to(device)\r\nfor epoch in range(epochs):\r\n    model.train()\r\n    optimizer.zero_grad()\r\n    loss = criterion(model(Xtr_d), ytr_d)"]
[12.670269, "o", "\r\n    loss.backward()\r\n    optimizer.step()\r\n    print(f'epoch {epoch} loss {loss.item():.4f}')\r\n\r\nmodel.eval()\r\n"]
[12.670318, "o", "with torch.no_grad():\r\n    pred = model(Xte.to(device)).argmax(1).cpu().numpy()\r\npd.DataFrame({'id': te['id'].values, 'label': pred}).to_csv('submission.csv', index=False)\r\nprint('wrote submission.csv')\r\n"]
[12.670428, "o", "\u001b[?2004hroot@3c4a8bce5752:/workspace# "]
[16.060163, "i", "pip list | grep torch-geometric\n"]
[16.060342, "o", "pip list | grep torch-geometric\r\n"]
[16.060387, "o", "\u001b[?2004l\r"]
[16.227886, "o", "torch-geometric          2.8.0.post1\r\n"]
[16.246817, "o", "\u001b[?2004hroot@3c4a8bce5752:/workspace# "]
[43.471072, "i", "cat << 'EOF' > train.py\nimport numpy as np\nimport pandas as pd\nimport torch\nimport torch.nn as nn\nimport torch.nn.functional as F\nfrom torch_geometric.nn import SAGEConv\nfrom torch_geometric.data import Data\n\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\nfeat = np.load('node_features.npy').astype(np.float32)\nedges_np = np.load('edges.npy')\ntr = pd.read_csv('train.csv')\nte = pd.read_csv('test.csv')\n\n# Create PyG Data object\nx = torch.tensor(feat, dtype=torch.float)\nedge_index = torch.tensor(edges_np, dtype=torch.long).t().contiguous()\n\n# Use all nodes in the graph for the message passing\ndata = Data(x=x, edge_index=edge_index)\n\n# Labels: Need to handle the fact that not all nodes are in the train set\n# We initialize labels with -1 and fill in the training labels\nn_nodes = feat.shape[0]\nall_labels = torch.full((n_nodes,), -1, dtype=torch.long)\nall_labels[tr['id'].values] = torch.tensor(tr['label'].values, dtype=torch.long)\n\n# Training mask\ntrain_mask = torch.zeros(n_nodes, dtype=torch.bool)\ntrain_mask[tr['id'].values] = True\n\n# Test IDs\ntest_ids = te['id'].values\n\nn_classes = int(tr['label'].max()) + 1\n\nclass SAGE(nn.Module):\n    def __init__(self, in_dim, hidden, out_dim):\n        super().__init__()\n        self.conv1 = SAGEConv(in_dim, hidden)\n        self.conv2 = SAGEConv(hidden, out_dim)\n\n    def forward(self, x, edge_index):\n        x = self.conv1(x, edge_index)\n        x = F.relu(x)\n        x = F.dropout(x, p=0.5, training=self.training)\n        x = self.conv2(x, edge_index)\n        return x\n\nmodel = SAGE(feat.shape[1], 256, n_classes).to(DEVICE)\noptimizer = torch.optim.Adam(model.parameters(), lr=0.01, weight_decay=5e-4)\ncriterion = nn.CrossEntropyLoss()\n\n# Move data to device\ndata = data.to(DEVICE)\nall_labels = all_labels.to(DEVICE)\ntrain_mask = train_mask.to(DEVICE)\n\nepochs = 10\nfor epoch in range(epochs):\n    model.train()\n    optimizer.zero_grad()\n    out = model(data.x, data.edge_index)\n    # Only calculate loss for training nodes\n    loss = criterion(out[train_mask], all_labels[train_mask])\n    loss.backward()\n    optimizer.step()\n    print(f'epoch {epoch} loss {loss.item():.4f}')\n\nmodel.eval()\nwith torch.no_grad():\n    out = model(data.x, data.edge_index)\n    pred = out[test_ids].argmax(1).cpu().numpy()\n\npd.DataFrame({'id': test_ids, 'label': pred}).to_csv('submission.csv', index=False)\nprint('wrote submission.csv')\nEOF\n"]
[43.4713, "o", "cat << 'EOF' > train.py"]
