[119.849204, "i", "cat << 'EOF' > train.py\nimport pandas as pd\nimport torch\nimport torch.nn as nn\nimport torch.optim as optim\nimport numpy as np\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.metrics import mean_absolute_error\nfrom sklearn.preprocessing import StandardScaler\n\n# Resolve the compute device\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\n# Load the data\niowa_file_path = 'train.csv'\nhome_data = pd.read_csv(iowa_file_path)\n\ny = home_data.SalePrice\nfeatures = ['MSSubClass', 'LotArea', 'OverallQual', 'OverallCond', 'YearBuilt', 'YearRemodAdd', '1stFlrSF', '2ndFlrSF', 'LowQualFinSF', 'GrLivArea', 'FullBath', 'HalfBath', 'BedroomAbvGr', 'KitchenAbvGr', 'TotRmsAbvGrd', 'Fireplaces', 'WoodDeckSF', 'OpenPorchSF', 'EnclosedPorch', '3SsnPorch', 'ScreenPorch', 'PoolArea', 'MiscVal', 'MoSold', 'YrSold']\nX = home_data[features]\n\n# Split into testing and training data\ntrain_X, valid_X, train_y, valid_y = train_test_split(X, y, random_state=1)\n\n# Scale the data\nscaler = StandardScaler()\ntrain_X_scaled = scaler.fit_transform(train_X)\nvalid_X_scaled = scaler.transform(valid_X)\n\n# Convert to torch tensors\ndef to_tensor(x):\n    return torch.tensor(x, dtype=torch.float32).to(DEVICE)\n\ntrain_X_t = to_tensor(train_X_scaled)\ntrain_y_t = to_tensor(train_y.values.reshape(-1, 1))\nvalid_X_t = to_tensor(valid_X_scaled)\nvalid_y_t = to_tensor(valid_y.values.reshape(-1, 1))\n\n# Model definition\nclass HousePriceModel(nn.Module):\n    def __init__(self, input_dim):\n        super(HousePriceModel, self).__init__()\n        self.net = nn.Sequential(\n            nn.Linear(input_dim, 64),\n            nn.ReLU(),\n            nn.Linear(64, 32),\n            nn.ReLU(),\n            nn.Linear(32, 1)\n        )\n    def forward(self, x):\n        return self.net(x)\n\nmodel = HousePriceModel(len(features)).to(DEVICE)\ncriterion = nn.L1Loss()\noptimizer = optim.Adam(model.parameters(), lr=0.01)\n\n# Training loop\nmodel.train()\nfor epoch in range(1000):\n    optimizer.zero_grad()\n    preds = model(train_X_t)\n    loss = criterion(preds, train_y_t)\n    loss.backward()\n    optimizer.step()\n\n# Evaluation\nmodel.eval()\nwith torch.no_grad():\n    train_preds = model(train_X_t).cpu().numpy()\n    valid_preds = model(valid_X_t).cpu().numpy()\n\ntrain_mae = mean_absolute_error(train_y, train_preds)\nvalid_mae = mean_absolute_error(valid_y, valid_preds)\n\nprint(\"Train MAE: {:,.0f}\".format(train_mae))\nprint(\"Validation MAE: {:,.0f}\".format(valid_mae))\n\n# Submission\ntest_data = pd.read_csv('test.csv')\ntest_X = test_data[features]\ntest_X_scaled = scaler.transform(test_X)\ntest_X_t = to_tensor(test_X_scaled)\n\nwith torch.no_grad():\n    test_preds = model(test_X_t).cpu().numpy()\n\noutput = pd.DataFrame({'Id': test_data.Id, 'SalePrice': test_preds.flatten()})\noutput.to_csv('submission.csv', index=False)\nEOF\n"]
[119.849396, "o", "cat << 'EOF' > train.py\r\n\u001b[?2004l\r"]
[119.849444, "o", "\u001b[?2004h> "]
[119.849537, "o", "import pandas as pd\r\n\u001b[?2004l\r\u001b[?2004h> import torch\r\n\u001b[?2004l\r\u001b[?2004h"]
[119.849576, "o", "> import torch.nn as nn\r\n\u001b[?2004l\r"]
[119.849624, "o", "\u001b[?2004h> "]
[119.849659, "o", "import torch.optim as optim\r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.849703, "o", "import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.849754, "o", "from sklearn.model_selection import train_test_split\r\n\u001b[?2004l\r"]
[119.849797, "o", "\u001b[?2004h> "]
[119.849838, "o", "from sklearn.metrics import mean_absolute_error\r\n\u001b[?2004l\r"]
[119.849882, "o", "\u001b[?2004h> "]
[119.849919, "o", "from sklearn.preprocessing import StandardScaler\r\n\u001b[?2004l\r\u001b[?2004h"]
[119.849955, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[119.850006, "o", "> # Resolve the compute device\r\n"]
[119.850052, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[119.850092, "o", "DEVICE = ('cuda' if torch.cuda.is_available()\r\n\u001b[?2004l\r\u001b[?2004h"]
[119.850123, "o", "> "]
[119.850169, "o", "          else 'mps' if torch.backends.mps.is_available() else 'cpu')\r\n\u001b[?2004l\r"]
[119.850211, "o", "\u001b[?2004h> "]
[119.850241, "o", "print('DEVICE=', DEVICE)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[119.850282, "o", "\u001b[?2004h> "]
[119.850323, "o", "# Load the data\r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.85036, "o", "iowa_file_path = 'train.csv'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.8504, "o", "home_data = pd.read_csv(iowa_file_path)\r\n\u001b[?2004l\r"]
[119.850439, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[119.850478, "o", "> y = home_data.SalePrice\r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.850875, "o", "features = ['MSSubClass', 'LotArea', 'OverallQual', 'OverallCond', 'YearBuilt', 'YearRemodAdd', '1stFlrSF', '2ndFlrSF', 'LowQualFinSF', 'GrLivArea', 'FullBath', 'HalfBath', 'BedroomAbvGr', 'KitchenAbvGr', 'TotRmsAbvGrd', 'Fireplaces', 'WoodDeckSF', 'OpenPorchSF', 'EnclosedPorch', '3SsnPorch', 'ScreenPorch', 'PoolArea', 'MiscVal', 'MoSold', 'YrSold']\r\n\u001b[?2004l\r"]
[119.850922, "o", "\u001b[?2004h> "]
[119.851055, "o", "X = home_data[features]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.851087, "o", "# Split into testing and training data\r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.851136, "o", "train_X, valid_X, train_y, valid_y = train_test_split(X, y, random_state=1)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[119.851165, "o", "\u001b[?2004h> # Scale the data\r\n\u001b[?2004l\r"]
[119.851529, "o", "\u001b[?2004h> scaler = StandardScaler()\r\n\u001b[?2004l\r\u001b[?2004h> train_X_scaled = scaler.fit_transform(train_X)\r\n\u001b[?2004l\r\u001b[?2004h"]
[119.85157, "o", "> "]
[119.851617, "o", "valid_X_scaled = scaler.transform(valid_X)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[119.851654, "o", "> "]
[119.851682, "o", "# Convert to torch tensors\r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.851716, "o", "def to_tensor(x):\r\n\u001b[?2004l\r\u001b[?2004h"]
[119.851871, "o", "> "]
[119.851903, "o", "    return torch.tensor(x, dtype=torch.float32).to(DEVICE)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> train_X_t = to_tensor(train_X_scaled)"]
[119.851945, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[119.851982, "o", "> "]
[119.85208, "o", "train_y_t = to_tensor(train_y.values.reshape(-1, 1))\r\n\u001b[?2004l\r"]
[119.85211, "o", "\u001b[?2004h> valid_X_t = to_tensor(valid_X_scaled)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.852174, "o", "valid_y_t = to_tensor(valid_y.values.reshape(-1, 1))"]
[119.852217, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[119.852259, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[119.852287, "o", "> # Model definition\r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.85234, "o", "class HousePriceModel(nn.Module):\r\n\u001b[?2004l\r\u001b[?2004h"]
[119.85236, "o", "> "]
[119.852406, "o", "    def __init__(self, input_dim):\r\n\u001b[?2004l\r\u001b[?2004h"]
[119.852445, "o", "> "]
[119.8525, "o", "        super(HousePriceModel, self).__init__()\r\n\u001b[?2004l\r"]
[119.852538, "o", "\u001b[?2004h> "]
[119.852573, "o", "        self.net = nn.Sequential(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.852632, "o", "            nn.Linear(input_dim, 64),\r\n\u001b[?2004l\r"]
[119.852674, "o", "\u001b[?2004h> "]
[119.852705, "o", "            nn.ReLU(),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.852735, "o", "            nn.Linear(64, 32),\r\n\u001b[?2004l\r"]
[119.852778, "o", "\u001b[?2004h> "]
[119.852863, "o", "            nn.ReLU(),\r\n\u001b[?2004l\r"]
[119.852903, "o", "\u001b[?2004h> "]
[119.852942, "o", "            nn.Linear(32, 1)\r\n\u001b[?2004l\r"]
[119.852989, "o", "\u001b[?2004h>         )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.853088, "o", "    def forward(self, x):\r\n\u001b[?2004l\r"]
[119.853118, "o", "\u001b[?2004h>         return self.net(x)\r\n"]
[119.853157, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[119.853186, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.853231, "o", "model = HousePriceModel(len(features)).to(DEVICE)\r\n\u001b[?2004l\r"]
[119.853268, "o", "\u001b[?2004h> "]
[119.8533, "o", "criterion = nn.L1Loss()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.853358, "o", "optimizer = optim.Adam(model.parameters(), lr=0.01)\r\n\u001b[?2004l\r"]
[119.853394, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.853434, "o", "# Training loop\r\n\u001b[?2004l\r\u001b[?2004h"]
[119.853471, "o", "> model.train()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.853517, "o", "for epoch in range(1000):\r\n\u001b[?2004l\r"]
[119.853546, "o", "\u001b[?2004h>     optimizer.zero_grad()"]
[119.854479, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[119.854526, "o", ">     preds = model(train_X_t)\r\n\u001b[?2004l\r"]
[119.854566, "o", "\u001b[?2004h> "]
[119.854596, "o", "    loss = criterion(preds, train_y_t)\r\n\u001b[?2004l\r"]
[119.854634, "o", "\u001b[?2004h>     loss.backward()\r\n\u001b[?2004l\r"]
[119.854669, "o", "\u001b[?2004h> "]
[119.854707, "o", "    optimizer.step()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.854737, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> # Evaluation\r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.854775, "o", "model.eval()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.854811, "o", "with torch.no_grad():\r\n\u001b[?2004l\r"]
[119.854857, "o", "\u001b[?2004h> "]
[119.854889, "o", "    train_preds = model(train_X_t).cpu().numpy()\r\n\u001b[?2004l\r"]
[119.854919, "o", "\u001b[?2004h> "]
[119.854963, "o", "    valid_preds = model(valid_X_t).cpu().numpy()\r\n\u001b[?2004l\r"]
[119.854994, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[119.85504, "o", "> "]
[119.855083, "o", "train_mae = mean_absolute_error(train_y, train_preds)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.855161, "o", "valid_mae = mean_absolute_error(valid_y, valid_preds)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.85522, "o", "print(\"Train MAE: {:,.0f}\".format(train_mae))\r\n\u001b[?2004l\r"]
[119.855236, "o", "\u001b[?2004h> "]
[119.855297, "o", "print(\"Validation MAE: {:,.0f}\".format(valid_mae))\r\n\u001b[?2004l\r"]
[119.855314, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[119.855329, "o", "> "]
[119.855351, "o", "# Submission\r\n\u001b[?2004l\r"]
[119.855431, "o", "\u001b[?2004h> "]
[119.855479, "o", "test_data = pd.read_csv('test.csv')\r\n\u001b[?2004l\r\u001b[?2004h> test_X = test_data[features]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.855534, "o", "test_X_scaled = scaler.transform(test_X)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.855653, "o", "test_X_t = to_tensor(test_X_scaled)\r\n\u001b[?2004l\r\u001b[?2004h"]
[119.855684, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> with torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.855765, "o", "    test_preds = model(test_X_t).cpu().numpy()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.855802, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[119.855839, "o", "output = pd.DataFrame({'Id': test_data.Id, 'SalePrice': test_preds.flatten()})\r\n\u001b[?2004l\r"]
[119.855907, "o", "\u001b[?2004h> output.to_csv('submission.csv', index=False)\r\n\u001b[?2004l\r"]
[119.855943, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[119.860959, "o", "\u001b[?2004hroot@772c084bef53:/workspace# "]
[119.954756, "i", "python3 train.py\n"]
[119.954897, "o", "python3 train.py\r\n\u001b[?2004l\r"]
