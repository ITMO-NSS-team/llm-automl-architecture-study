[108.229111, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> import torch\r\n\u001b[?2004l\r\u001b[?2004h> import torch.nn as nn\r\n\u001b[?2004l\r\u001b[?2004h> import torch.optim as optim\r\n\u001b[?2004l\r\u001b[?2004h> from sklearn.model_selection import train_test_split\r\n\u001b[?2004l\r\u001b[?2004h> from sklearn.metrics import mean_absolute_error\r\n\u001b[?2004l\r\u001b[?2004h> from sklearn.preprocessing import StandardScaler\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Resolve the compute device\r\n\u001b[?2004l\r\u001b[?2004h> DEVICE = ('cuda' if torch.cuda.is_available()\r\n\u001b[?2004l\r\u001b[?2004h>           else 'mps' if torch.backends.mps.is_available() else 'cpu')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.22913, "i", "poch in range(1000):\n    optimizer.zero_grad()\n    preds = model(train_X_t)\n    loss = criterion(preds, train_y_t)\n    loss.backward()\n    optimizer.step()\n\n# Evaluation\nmodel.eval()\nwith torch.no_grad():\n    train_preds = model(train_X_t).cpu().numpy()\n    valid_preds = model(valid_X_t).cpu().numpy()\n\ntrain_mae = mean_absolute_error(train_y, train_preds)\nvalid_mae = mean_absolute_error(valid_y, valid_preds)\n\nprint(\"Train MAE: {:,.0f}\".format(train_mae))\nprint(\"Validation MAE: {:,.0f}\".format(valid_mae))\n\n# Submission\ntest_data = pd.read_csv('test.csv')\ntest_X = test_data[features]\ntest_X_scaled = scaler.transform(test_X)\ntest_X_t = to_tensor(test_X_scaled)\n\nwith torch.no_grad():\n    test_preds = model(test_X_t).cpu().numpy()\n\noutput = pd.DataFrame({'Id': test_data.Id, 'SalePrice': test_preds.flatten()})\noutput.to_csv('submission.csv', index=False)\nEOF\n"]
