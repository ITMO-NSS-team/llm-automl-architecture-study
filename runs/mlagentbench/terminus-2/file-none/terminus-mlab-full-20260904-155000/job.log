Sending keys: ["cat << 'EOF' > train.py\nimport os\nimport numpy as np\nimport pandas as pd\nimport torch\nimport torch.nn as nn\n\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\nclass SimpleCNN(nn.Module):\n    def __init__(self):\n        super().__init__()\n        self.net = nn.Sequential(\n            nn.Conv2d(6, 16, 3, padding=1),\n            nn.ReLU(),\n            nn.Conv2d(16, 16, 3, padding=1),\n            nn.ReLU(),\n            nn.Conv2d(16, 1, 1)\n        )\n\n    def forward(self, x):\n        return self.net(x)\n\ndef get_data(rec_dir):\n    b11 = np.load(f'{rec_dir}/band_11.npy').astype(np.float32)\n    b14 = np.load(f'{rec_dir}/band_14.npy').astype(np.float32)\n    b15 = np.load(f'{rec_dir}/band_15.npy').astype(np.float32)\n    center = np.stack([b11[..., 1], b14[..., 1], b15[..., 1]], axis=0)\n    diff = np.stack([b11[..., 1]-b11[..., 0], b14[..., 1]-b14[..., 0], b15[..., 1]-b15[..., 0]], axis=0)\n    x = np.concatenate([center, diff], axis=0)\n    x = (x - x.mean()) / (x.std() + 1e-6)\n    return x\n\ndef rle(mask):\n    flat = mask.reshape(-1)\n    if flat.sum() == 0: return ''\n    d = np.diff(np.concatenate([[0], flat, [0]]))\n    starts, ends = np.where(d == 1)[0], np.where(d == -1)[0]\n    return ' '.join(f'{s} {e - s}' for s, e in zip(starts, ends))\n\ntrain_ids = sorted(os.listdir('train'))\ntest_ids = sorted(os.listdir('test'))\n\nmodel = SimpleCNN().to(DEVICE)\nopt = torch.optim.Adam(model.parameters(), lr=1e-3)\nlossf = nn.BCEWithLogitsLoss()\n\nepochs = 1\nfor epoch in range(epochs):\n    model.train()\n    total_loss = 0\n    for rid in train_ids:\n        x = torch.tensor(get_data(f'train/{rid}')).unsqueeze(0).to(DEVICE)\n        m = np.load(f'train/{rid}/human_pixel_masks.npy').astype(np.float32).squeeze()\n        y = torch.tensor(m).unsqueeze(0).unsqueeze(1).to(DEVICE)\n        opt.zero_grad()\n        pred = model(x)\n        loss = lossf(pred, y)\n        loss.backward()\n        opt.step()\n        total_loss += loss.item()\n    print(f'epoch {epoch} loss {total_loss/len(train_ids):.4f}')\n\nmodel.eval()\nrows = []\nwith torch.no_grad():\n    for rid in test_ids:\n        x = torch.tensor(get_data(f'test/{rid}')).unsqueeze(0).to(DEVICE)\n        pred = torch.sigmoid(model(x)).squeeze().cpu().numpy() > 0.5\n        rows.append({'record_id': rid, 'rle': rle(pred.astype(np.uint8))})\n\npd.DataFrame(rows).to_csv('submission.csv', index=False)\nprint('wrote submission.csv')\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
