Sending keys: ["cat << 'EOF' > train.py\nimport ast, numpy as np, pandas as pd, torch, torch.nn as nn\nfrom torch.utils.data import Dataset, DataLoader\nfrom PIL import Image\nimport torchvision.models as models, torchvision.transforms as transforms\n\nDEVICE = ('cuda' if torch.cuda.is_available() else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\nSIZE, N_CLASSES, BATCH_SIZE, EPOCHS, LR = 64, 290, 32, 1, 1e-4\n\nclass FathomDataset(Dataset):\n    def __init__(self, ids, labels=None, transform=None):\n        self.ids, self.labels, self.transform = ids, labels, transform\n    def __len__(self): return len(self.ids)\n    def __getitem__(self, idx):\n        img_id = self.ids[idx]\n        img = None\n        for ext in ('.png', '.jpg', '.jpeg'):\n            try:\n                img = Image.open(f'images/{img_id}{ext}').convert('RGB').resize((SIZE, SIZE))\n                break\n            except: continue\n        if img is None: img = Image.new('RGB', (SIZE, SIZE), (0, 0, 0))\n        if self.transform: img = self.transform(img)\n        if self.labels is not None:\n            label = torch.zeros(N_CLASSES)\n            try:\n                for c in ast.literal_eval(str(self.labels[idx])): label[int(float(c))] = 1.0\n            except: pass\n            return img, label\n        return img\n\ntrans = transforms.Compose([transforms.ToTensor(), transforms.Normalize([0.485, 0.456, 0.406], [0.229, 0.224, 0.225])])\ntrain_df, test_df = pd.read_csv('train.csv'), pd.read_csv('test.csv')\n train_loader = DataLoader(FathomDataset(train_df['id'].values, train_df['categories'].values, trans), batch_size=BATCH_SIZE, shuffle=True)\n\nmodel = models.resnet18(pretrained=True)\nmodel.fc = nn.Linear(model.fc.in_features, N_CLASSES)\nmodel = model.to(DEVICE)\noptimizer, criterion = torch.optim.Adam(model.parameters(), lr=LR), nn.BCEWithLogitsLoss()\n\nfor epoch in range(EPOCHS):\n    model.train()\n    for images, labels in train_loader:\n        images, labels = images.to(DEVICE), labels.to(DEVICE)\n        optimizer.zero_grad()\n        loss = criterion(model(images), labels)\n        loss.backward()\n        optimizer.step()\n    print(f'Epoch {epoch+1} done')\n\nmodel.eval()\nall_logits = []\nwith torch.no_grad():\n    for img in DataLoader(FathomDataset(test_df['id'].values, transform=trans), batch_size=BATCH_SIZE):\n        all_logits.append(model(img.to(DEVICE)).cpu().numpy())\n\nprobs = torch.sigmoid(torch.tensor(np.vstack(all_logits))).numpy()\nthresholds = np.clip(np.percentile(probs, 95, axis=0), 0.001, 0.5)\nall_preds = [sorted(np.where(p > thresholds)[0].tolist()) for p in probs]\n\npred_matrix = np.array([[1 if i in p else 0 for i in range(N_CLASSES)] for p in all_preds])\ndistinct_counts = [len(np.unique(pred_matrix[:, i])) for i in range(N_CLASSES)]\nprint('Distinct values per column:', distinct_counts)\n\npd.DataFrame({'id': test_df['id'], 'categories': [str(p) for p in all_preds]}).to_csv('submission.csv', index=False)\nprint('wrote submission.csv')\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
