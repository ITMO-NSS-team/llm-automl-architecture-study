    nn.ReLU(),\n            nn.Linear(32, 1)\n        )\n    def forward(self, x):\n        return self.net(x)\n\nmodel = HousePriceModel(len(features)).to(DEVICE)\ncriterion = nn.L1Loss()\noptimizer = optim.Adam(model.parameters(), lr=0.01)\n\n# Training loop\nfor epoch in range(1001):\n    model.train()\n    optimizer.zero_grad()\n    outputs = model(train_X_tensor)\n    loss = criterion(outputs, train_y_tensor)\n    loss.backward()\n    optimizer.step()\n    if epoch % 200 == 0:\n        print(f"Epoch {epoch}, Loss: {loss.item():.4f}")\n        sys.stdout.flush()\n\n# Evaluation\nmodel.eval()\nwith torch.no_grad():\n    train_preds = model(train_X_tensor).cpu().numpy()\n    valid_preds = model(valid_X_tensor).cpu().numpy()\n\ntrain_mae = mean_absolute_error(train_y_raw, train_preds)\nvalid_mae = mean_absolute_error(valid_y_raw, valid_preds)\n\nprint("Train MAE: {:,.0f}".format(train_mae))\nprint("Validation MAE: {:,.0f}".format(valid_mae))\n\ntest_data = pd.read_csv(\'test.csv\')\ntest_X = test_data[features]\ntest_X_scaled = scaler.transform(test_X)\ntest_X_tensor = torch.tensor(test_X_scaled, dtype=torch.float32).to(DEVICE)\n\nwith torch.no_grad():\n    test_preds = model(test_X_tensor).cpu().numpy()\n\noutput = pd.DataFrame({\'Id\': test_data.Id, \'SalePrice\': test_preds})\noutput.to_csv(\'submission.csv\', index=False)\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
