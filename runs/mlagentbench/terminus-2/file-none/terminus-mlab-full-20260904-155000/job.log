h.tensor(scaler.fit_transform(X_train_df), dtype=torch.float32).to(DEVICE)\nY_train = torch.tensor(TargetY_train, dtype=torch.float32).unsqueeze(1).to(DEVICE)\n\nX_val = torch.tensor(scaler.transform(X_val_df), dtype=torch.float32).to(DEVICE)\nY_val = torch.tensor(TargetY_val, dtype=torch.float32).unsqueeze(1).to(DEVICE)\n\n# Model\nclass SimpleMLP(nn.Module):\n    def __init__(self, input_dim):\n        super(SimpleMLP, self).__init__()\n        self.net = nn.Sequential(\n            nn.Linear(input_dim, 64),\n            nn.ReLU(),\n            nn.Linear(64, 32),\n            nn.ReLU(),\n            nn.Linear(32, 1),\n            nn.Sigmoid()\n        )\n    def forward(self, x):\n        return self.net(x)\n\nmodel = SimpleMLP(X_train.shape[1]).to(DEVICE)\ncriterion = nn.BCELoss()\noptimizer = optim.Adam(model.parameters(), lr=0.001)\n\n# Training\nmodel.train()\nfor epoch in range(100):\n    optimizer.zero_grad()\n    outputs = model(X_train)\n    loss = criterion(outputs, Y_train)\n    loss.backward()\n    optimizer.step()\n\n# Evaluation\nmodel.eval()\nwith torch.no_grad():\n    train_preds = (model(X_train) > 0.5).float()\n    val_preds = (model(X_val) > 0.5).float()\n    \n    train_accuracy = accuracy_score(Y_train.cpu(), train_preds.cpu())\n    val_accuracy = accuracy_score(Y_val.cpu(), val_preds.cpu())\n\nprint(f"Train Accuracy: {train_accuracy}")\nprint(f"Validation Accuracy: {val_accuracy}")\n\n# Prediction for test set\nX_test_raw = preprocess_data(full_test, is_test=True, train_cols=columns)\nX_test = torch.tensor(scaler.transform(X_test_raw), dtype=torch.float32).to(DEVICE)\n\nmodel.eval()\nwith torch.no_grad():\n    test_preds = (model(X_test) > 0.5).float().cpu().numpy().flatten()\n\nsubmission = pd.DataFrame({\n    \'PassengerId\': full_test[\'PassengerId\'],\n    \'Transported\': (test_preds == 1)\n})\nsubmission.to_csv(\'submission.csv\', index=False)\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
