Sending keys: ['cat << \'EOF\' > train.py\nimport numpy as np\nimport pandas as pd\nimport torch\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.feature_extraction.text import TfidfVectorizer\nfrom sklearn.linear_model import LinearRegression\n\n# Hardware resolution snippet\nDEVICE = (\'cuda\' if torch.cuda.is_available()\n          else \'mps\' if torch.backends.mps.is_available() else \'cpu\')\nprint(\'DEVICE=\', DEVICE)\n\nDIMENSIONS = ["cohesion", "syntax", "vocabulary", "phraseology", "grammar", "conventions"]\nSEED = 42\n\ndef compute_metrics_for_regression(y_test, y_test_pred):\n    metrics = {}\n    for i, task in enumerate(DIMENSIONS):\n        rmse = np.sqrt(((y_test[:, i] - y_test_pred[:, i]) ** 2).mean())\n        metrics[f"rmse_{task}"] = rmse\n    return metrics\n\nif __name__ == \'__main__\':\n    train_df = pd.read_csv(\'train.csv\')\n    X = train_df[\'full_text\'].fillna(\'\').tolist()\n    y = np.array([train_df[d].values for d in DIMENSIONS]).T\n\n    X_train, X_valid, y_train, y_valid = train_test_split(X, y, test_size=0.10, random_state=SEED)\n\n    tfidf = TfidfVectorizer(max_features=5000, stop_words=\'english\')\n    X_train_tfidf = tfidf.fit_transform(X_train)\n    X_valid_tfidf = tfidf.transform(X_valid)\n\n    model = LinearRegression()\n    model.fit(X_train_tfidf, y_train)\n\n    y_valid_pred = model.predict(X_valid_tfidf)\n    metrics = compute_metrics_for_regression(y_valid, y_valid_pred)\n    print(metrics)\n    print("final MCRMSE on validation set: ", np.mean(list(metrics.values())))\n\n    test_df = pd.read_csv(\'test.csv\')\n    X_test_tfidf = tfidf.transform(test_df[\'full_text\'].fillna(\'\').tolist())\n    y_test_pred = model.predict(X_test_tfidf)\n    \n    out = pd.DataFrame(y_test_pred, columns=DIMENSIONS)\n    out.insert(0, \'text_id\', test_df[\'text_id\'])\n    out.to_csv(\'submission.csv\', index=False)\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
