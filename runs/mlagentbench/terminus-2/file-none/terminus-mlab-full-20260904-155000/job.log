Sending keys: ['cat << \'EOF\' > train.py\nimport pandas as pd\nimport torch\nimport torch.nn as nn\nimport torch.optim as optim\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.metrics import mean_absolute_error\nfrom sklearn.preprocessing import StandardScaler\n\n# Resolve the compute device\nDEVICE = (\'cuda\' if torch.cuda.is_available()\n          else \'mps\' if torch.backends.mps.is_available() else \'cpu\')\nprint(\'DEVICE=\', DEVICE)\n\n# Load the data\niowa_file_path = \'train.csv\'\nhome_data = pd.read_csv(iowa_file_path)\n\ny = home_data.SalePrice\nfeatures = [\'MSSubClass\', \'LotArea\', \'OverallQual\', \'OverallCond\', \'YearBuilt\', \'YearRemodAdd\', \'1stFlrSF\', \'2ndFlrSF\', \'LowQualFinSF\', \'GrLivArea\', \'FullBath\', \'HalfBath\', \'BedroomAbvGr\', \'KitchenAbvGr\', \'TotRmsAbvGrd\', \'Fireplaces\', \'WoodDeckSF\', \'OpenPorchSF\', \'EnclosedPorch\', \'3SsnPorch\', \'ScreenPorch\', \'PoolArea\', \'MiscVal\', \'MoSold\', \'YrSold\']\nX = home_data[features]\n\n# Split into testing and training data\ntrain_X, valid_X, train_y, valid_y = train_test_split(X, y, random_state=1)\n\n# Scale the data (Crucial for Neural Networks)\nscaler = StandardScaler()\ntrain_X_scaled = scaler.fit_transform(train_X)\nvalid_X_scaled = scaler.transform(valid_X)\n\n# Convert to torch tensors\nimport numpy as np\n\ndef to_tensor(x):\n    return torch.tensor(x, dtype=torch.float32).to(DEVICE)\n\n train_X_t = to_tensor(train_X_scaled)\n train_y_t = to_tensor(train_y.values.reshape(-1, 1))\n valid_X_t = to_tensor(valid_X_scaled)\n valid_y_t = to_tensor(valid_y.values.reshape(-1, 1))\n\n# Model definition\nclass HousePriceModel(nn.Module):\n    def __init__(self, input_dim):\n        super(HousePriceModel, self).__init__()\n        self.net = nn.Sequential(\n            nn.Linear(input_dim, 64),\n            nn.ReLU(),\n            nn.Linear(64, 32),\n            nn.ReLU(),\n            nn.Linear(32, 1)\n        )\n    def forward(self, x):\n        return self.net(x)\n\nmodel = HousePriceModel(len(features)).to(DEVICE)\ncriterion = nn.L1Loss()\noptimizer = optim.Adam(model.parameters(), lr=0.01)\n\n# Training loop\nmodel.train()\nfor epoch in range(1000):\n    optimizer.zero_grad()\n    preds = model(train_X_t)\n    loss = criterion(preds, train_y_t)\n    loss.backward()\n    optimizer.step()\n\n# Evaluation\nmodel.eval()\nwith torch.no_grad():\n    train_preds = model(train_X_t).cpu().numpy()\n    valid_preds = model(valid_X_t).cpu().numpy()\n\ntrain_mae = mean_absolute_error(train_y, train_preds)\nvalid_mae = mean_absolute_error(valid_y, valid_preds)\n\nprint("Train MAE: {:,.0f}".format(train_mae))\nprint("Validation MAE: {:,.0f}".format(valid_mae))\n\n# Submission\ntest_data = pd.read_csv(\'test.csv\')\ntest_X = test_data[features]\ntest_X_scaled = scaler.transform(test_X)\ntest_X_t = to_tensor(test_X_scaled)\n\nwith torch.no_grad():\n    test_preds = model(test_X_t).cpu().numpy()\n\noutput = pd.DataFrame({\'Id\': test_data.Id, \'SalePrice\': test_preds.flatten()})\noutput.to_csv(\'submission.csv\', index=False)\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
