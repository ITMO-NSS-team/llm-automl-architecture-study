Sending keys: ["cat <<EOF > train.py\nimport ast\nimport numpy as np\nimport pandas as pd\nimport torch\nimport torch.nn as nn\nfrom PIL import Image\nfrom torchvision import models, transforms\n\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\nSIZE = 64\nN_CLASSES = 290\nBATCH_SIZE = 32\nEPOCH = 1 \n\ndef load(ids):\n    out = []\n    for i in ids:\n        for ext in ('.png', '.jpg', '.jpeg'):\n            p = f'images/{i}{ext}'\n            try:\n                out.append(np.asarray(Image.open(p).convert('RGB').resize((SIZE, SIZE)),\n                                      dtype=np.float32) / 255.0)\n                break\n            except FileNotFoundError:\n                continue\n        else:\n            out.append(np.zeros((SIZE, SIZE, 3), dtype=np.float32))\n    return np.stack(out)\n\ntrain_df = pd.read_csv('train.csv')\ntest_df = pd.read_csv('test.csv')\n\nX = torch.tensor(load(train_df['id'].values)).permute(0, 3, 1, 2).to(DEVICE)\nY = torch.zeros(len(train_df), N_CLASSES).to(DEVICE)\nfor r, cats in enumerate(train_df['categories']):\n    try:\n        c_list = ast.literal_eval(str(cats))\n        for c in c_list:\n            if 0 <= int(c) < N_CLASSES:\n                Y[r, int(c)] = 1.0\n    except:\n        pass\n\nmodel = models.resnet18(weights='IMAGENET1K_V1')\nmodel.fc = nn.Linear(model.fc.in_features, N_CLASSES)\nmodel = model.to(DEVICE)\n\nopt = torch.optim.Adam(model.parameters(), lr=1e-4)\nlossf = nn.BCEWithLogitsLoss()\n\nfor epoch in range(EPOCH):\n    model.train()\n    total_loss = 0\n    for i in range(0, len(X), BATCH_SIZE):\n        xb, yb = X[i:i + BATCH_SIZE], Y[i:i + BATCH_SIZE]\n        opt.zero_grad()\n        out = model(xb)\n        loss = lossf(out, yb)\n        loss.backward()\n        opt.step()\n        total_loss += loss.item()\n    print(f'epoch {epoch} loss {total_loss / (len(X)//BATCH_SIZE + 1):.4f}')\n\nXte = torch.tensor(load(test_df['id'].values)).permute(0, 3, 1, 2).to(DEVICE)\nmodel.eval()\n\nwith torch.no_grad():\n    pred_logits = model(Xte)\n    pred_matrix = torch.sigmoid(pred_logits).cpu().numpy()\n\ndistinct_counts = []\nfor col in range(N_CLASSES):\n    distinct_counts.append(len(np.unique(pred_matrix[:, col])))\n\nprint('Min distinct values per column:', min(distinct_counts))\n\nrows = []\nfor r in pred_matrix:\n    preds = np.where(r > 0.5)[0].tolist()\n    rows.append(preds)\n\npd.DataFrame({'id': test_df['id'], 'categories': [str(r) for r in rows]}).to_csv('submission.csv', index=False)\nprint('wrote submission.csv')\nEOF\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
