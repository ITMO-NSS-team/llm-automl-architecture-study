ler.transform(X_val_df), dtype=torch.float32).to(DEVICE)\nY_val = torch.tensor(TargetY_val, dtype=torch.float32).unsqueeze(1).to(DEVICE)\nmodel = nn.Linear(X_train.shape[1], 1).to(DEVICE)\ncriterion = nn.BCEWithLogitsLoss()\noptimizer = optim.Adam(model.parameters(), lr=0.01, weight_decay=0.01)\nmodel.train()\nfor epoch in range(200):\n    optimizer.zero_grad()\n    outputs = model(X_train)\n    loss = criterion(outputs, Y_train)\n    loss.backward()\n    optimizer.step()\nmodel.eval()\nwith torch.no_grad():\n    train_logits = model(X_train)\n    train_preds = (torch.sigmoid(train_logits) > 0.5).float()\n    val_logits = model(X_val)\n    val_preds = (torch.sigmoid(val_logits) > 0.5).float()\n    train_accuracy = accuracy_score(Y_train.cpu(), train_preds.cpu())\n    val_accuracy = accuracy_score(Y_val.cpu(), val_preds.cpu())\nprint(f"Train Accuracy: {train_accuracy}")\nprint(f"Validation Accuracy: {val_accuracy}")\nX_test_raw = preprocess_data(full_test, is_test=True, train_cols=columns)\nX_test = torch.tensor(scaler.transform(X_test_raw), dtype=torch.float32).to(DEVICE)\nmodel.eval()\nwith torch.no_grad():\n    test_logits = model(X_test)\n    test_preds = (torch.sigmoid(test_logits) > 0.5).float().cpu().numpy().flatten()\nsubmission = pd.DataFrame({\'PassengerId\': full_test[\'PassengerId\'], \'Transported\': (test_preds == 1)})\nsubmission.to_csv(\'submission.csv\', index=False)\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
