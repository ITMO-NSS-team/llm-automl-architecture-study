Sending keys: ["cat << 'EOF' > train.py\nimport numpy as np\nimport pandas as pd\nimport torch\nimport torch.nn as nn\nimport torch.optim as optim\nfrom torch.utils.data import DataLoader, TensorDataset\nfrom sklearn.preprocessing import StandardScaler\n\n# REQUIRED Hardware Device Resolution\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\nTARGETS = ['updrs_1', 'updrs_2', 'updrs_3', 'updrs_4']\n\ndef smapep1(y_true, y_pred):\n    y_true = np.asarray(y_true, dtype=float) + 1\n    y_pred = np.clip(np.asarray(y_pred, dtype=float), 0, None) + 1\n    denom = (np.abs(y_true) + np.abs(y_pred)) / 2\n    return 100 * np.mean(np.abs(y_true - y_pred) / denom)\n\n# Load data\nclinical = pd.read_csv('train_clinical_data.csv')\ntest = pd.read_csv('test.csv')\n\n# Prepare training data\n# We use visit_month as the feature\n# We need to handle NaNs in targets by training per target or filtering\n\n# Scaler for the feature\nscaler_X = StandardScaler()\nX_train_raw = clinical[['visit_month']].values\nX_train_scaled = scaler_X.fit_transform(X_train_raw)\n\nX_test_raw = test[['visit_month']].values\nX_test_scaled = scaler_X.transform(X_test_raw)\n\n# Model architecture\nclass ParkinsonModel(nn.Module):\n    def __init__(self):\n        super(ParkinsonModel, self).__init__()\n        self.net = nn.Sequential(\n            nn.Linear(1, 64),\n            nn.ReLU(),\n            nn.Linear(64, 64),\n            nn.ReLU(),\n            nn.Linear(64, 4)\n        )\n    def forward(self, x):\n        return self.net(x)\n\nmodel = ParkinsonModel().to(DEVICE)\noptimizer = optim.Adam(model.parameters(), lr=0.01)\ncriterion = nn.MSELoss()\n\n# Combine targets for multi-output training\n# Note: we must handle NaNs. We'll fill them with the mean for the loss function or mask them.\n# For simplicity, we'll fill NaNs with the mean of each column for training\nclinical_filled = clinical[TARGETS].fillna(clinical[TARGETS].mean())\ny_train_tensor = torch.tensor(clinical_filled.values, dtype=torch.float32).to(DEVICE)\nX_train_tensor = torch.tensor(X_train_scaled, dtype=torch.float32).to(DEVICE)\n\n# Training loop\ndataset = TensorDataset(X_train_tensor, y_train_tensor)\nloader = DataLoader(dataset, batch_size=32, shuffle=True)\n\nmodel.train()\nfor epoch in range(200):\n    for batch_x, batch_y in loader:\n        optimizer.zero_grad()\n        outputs = model(batch_x)\n        loss = criterion(outputs, batch_y)\n        loss.backward()\n        optimizer.step()\n\n# Prediction\nmodel.eval()\nwith torch.no_grad():\n    X_test_tensor = torch.tensor(X_test_scaled, dtype=torch.float32).to(DEVICE)\n    predictions = model(X_test_tensor).cpu().numpy()\n\n# Ensure predictions are non-negative\npredictions = np.clip(predictions, 0, None)\n\n# Create submission\nsub_df = pd.DataFrame(predictions, columns=TARGETS)\nsub_df['visit_id'] = test['visit_id']\nsub_df = sub_df[['visit_id'] + TARGETS]\n\n# Valid submission check: non-collapse\nfor col in TARGETS:\n    distinct_count = sub_df[col].nunique()\n    print(f'{col} distinct values: {distinct_count}')\n    if distinct_count < 10:\n        print(f'WARNING: {col} has collapsed!')\n\nsub_df.to_csv('submission.csv', index=False)\nprint('wrote submission.csv')\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
