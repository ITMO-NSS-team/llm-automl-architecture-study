Sending keys: ['cat << \'EOF\' > train.py\nimport pandas as pd\nimport numpy as np\nimport torch\nimport torch.nn as nn\nimport torch.optim as optim\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.preprocessing import StandardScaler\n\n# Device selection\nDEVICE = (\'cuda\' if torch.cuda.is_available()\n          else \'mps\' if torch.backends.mps.is_available() else \'cpu\')\nprint(\'DEVICE=\', DEVICE)\n\ndef preprocess(df):\n    # Cabin splitting\n    df[[\'Deck\', \'Cabin_num\', \'Side\']] = df[\'Cabin\'].str.split(\'/\', expand=True)\n    df = df.drop(\'Cabin\', axis=1)\n    \n    # Handling missing values\n    num_cols = df.select_dtypes(include=[\'float64\', \'int64\']).columns\n    cat_cols = df.select_dtypes(include=[\'object\', \'bool\']).columns\n    \n    for col in num_cols:\n        df[col] = df[col].fillna(df[col].median())\n    \n    for col in cat_cols:\n        df[col] = df[col].fillna(\'Unknown\')\n        \n    # Encoding\n    df = pd.get_dummies(df, columns=[c for c in cat_cols if c != \'PassengerId\'])\n    return df\n\n# Load data\ntrain_df_raw = pd.read_csv(\'train.csv\')\ntest_df_raw = pd.read_csv(\'test.csv\')\n\n# Separate target\ny = train_df_raw[\'Transported\'].astype(int).values\nX_raw = train_df_raw.drop(\'Transported\', axis=1)\n\n# Preprocess train and test\n# Combine for consistent dummy encoding\nall_data = pd.concat([X_raw, test_df_raw])\nall_processed = preprocess(all_data)\n\n# Separate again\nX_processed = all_processed.iloc[:len(train_df_raw)].drop(\'PassengerId\', axis=1)\ntest_processed = all_processed.iloc[len(train_df_raw):].drop(\'PassengerId\', axis=1)\n\n# Split train/val\nX_train, X_val, y_train, y_val = train_test_split(X_processed, y, test_size=0.2, random_state=42)\n\n# Scaling\nscaler = StandardScaler()\nX_train_scaled = scaler.fit_transform(X_train)\nX_val_scaled = scaler.transform(X_val)\ntest_scaled = scaler.transform(test_processed)\n\n# Convert to Tensors\nX_train_t = torch.tensor(X_train_scaled, dtype=torch.float32).to(DEVICE)\ny_train_t = torch.tensor(y_train, dtype=torch.float32).unsqueeze(1).to(DEVICE)\n\nX_val_t = torch.tensor(X_val_scaled, dtype=torch.float32).to(DEVICE)\ny_val_t = torch.tensor(y_val, dtype=torch.float32).unsqueeze(1).to(DEVICE)\n\n# Model\nclass TitanicModel(nn.Module):\n    def __init__(self, input_dim):\n        super(TitanicModel, self).__init__()\n        self.net = nn.Sequential(\n            nn.Linear(input_dim, 64),\n            nn.ReLU(),\n            nn.Linear(64, 32),\n            nn.ReLU(),\n            nn.Linear(32, 1),\n            nn.Sigmoid()\n        )\n    def forward(self, x):\n        return self.net(x)\n\nmodel = TitanicModel(X_train.shape[1]).to(DEVICE)\ncriterion = nn.BCELoss()\noptimizer = optim.Adam(model.parameters(), lr=0.001)\n\n# Training loop\nmodel.train()\nfor epoch in range(100):\n    optimizer.zero_grad()\n    outputs = model(X_train_t)\n    loss = criterion(outputs, y_train_t)\n    loss.backward()\n    optimizer.step()\n\n# Evaluation\nmodel.eval()\nwith torch.no_grad():\n    val_preds = model(X_val_t)\n    val_acc = ((val_preds > 0.5).float() == y_val_t).float().mean().item()\n    train_preds = model(X_train_t)\n    train_acc = ((train_preds > 0.5).float() == y_train_t).float().mean().item()\n\nprint(f"Train Accuracy: {train_acc}")\nprint(f"Validation Accuracy: {val_acc}")\n\n# Submission\nX_test_t = torch.tensor(test_scaled, dtype=torch.float32).to(DEVICE)\nwith torch.no_grad():\n    test_outputs = model(X_test_t)\n    test_preds = (test_outputs > 0.5).float().cpu().numpy().astype(int)\n\npd.DataFrame({\'PassengerId\': test_df_raw.PassengerId, \'Transported\': test_preds.flatten()}).to_csv(\'submission.csv\', index=False)\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
