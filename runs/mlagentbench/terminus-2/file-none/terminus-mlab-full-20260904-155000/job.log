Sending keys: ['cat <<EOF > train.py\nimport pandas as pd\nimport numpy as np\nimport torch\nimport torch.nn as nn\nimport torch.optim as optim\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.metrics import mean_absolute_error\nfrom sklearn.preprocessing import StandardScaler\n\n# Resolve the compute device\nDEVICE = (\'cuda\' if torch.cuda.is_available()\n          else \'mps\' if torch.backends.mps.is_available() else \'cpu\')\nprint(\'DEVICE=\', DEVICE)\n\n# Load data\niowa_file_path = \'train.csv\'\nhome_data = pd.read_csv(iowa_file_path)\ny = home_data.SalePrice\n\nfeatures = [\'MSSubClass\', \'LotArea\', \'OverallQual\', \'OverallCond\', \'YearBuilt\', \'YearRemodAdd\', \'1stFlrSF\', \'2ndFlrSF\', \'LowQualFinSF\', \'GrLivArea\', \'FullBath\', \n \'HalfBath\', \'BedroomAbvGr\', \'KitchenAbvGr\', \'TotRmsAbvGrd\', \'Fireplaces\', \'WoodDeckSF\', \'OpenPorchSF\', \'EnclosedPorch\', \'3SsnPorch\', \'ScreenPorch\', \'PoolArea\', \n \'MiscVal\', \'MoSold\', \'YrSold\']\n\nX = home_data[features]\n\n# Split\ntrain_X, valid_X, train_y, valid_y = train_test_split(X, y, random_state=1)\n\n# Scaling\nscaler = StandardScaler()\ntrain_X_scaled = scaler.fit_transform(train_X)\nvalid_X_scaled = scaler.transform(valid_X)\n\n# Convert to tensors\ntrain_X_tensor = torch.tensor(train_X_scaled, dtype=torch.float32).to(DEVICE)\ntrain_y_tensor = torch.tensor(train_y.values, dtype=torch.float32).view(-1, 1).to(DEVICE)\nvalid_X_tensor = torch.tensor(valid_X_scaled, dtype=torch.float32).to(DEVICE)\nvalid_y_tensor = torch.tensor(valid_y.values, dtype=torch.float32).view(-1, 1).to(DEVICE)\n\n# Define Model\nclass HousePriceModel(nn.Module):\n    def __init__(self, input_dim):\n        super(HousePriceModel, self).__init__()\n        self.net = nn.Sequential(\n            nn.Linear(input_dim, 64),\n            nn.ReLU(),\n            nn.Linear(64, 32),\n            nn.ReLU(),\n            nn.Linear(32, 1)\n        )\n    \n    def forward(self, x):\n        return self.net(x)\n\nmodel = HousePriceModel(len(features)).to(DEVICE)\ncriterion = nn.L1Loss() # MAE\noptimizer = optim.Adam(model.parameters(), lr=0.01)\n\n# Training loop\nmodel.train()\nfor epoch in range(1000):\n    optimizer.zero_grad()\n    outputs = model(train_X_tensor)\n    loss = criterion(outputs, train_y_tensor)\n    loss.backward()\n    optimizer.step()\n\n# Evaluation\nmodel.eval()\nwith torch.no_grad():\n    train_preds = model(train_X_tensor).cpu().numpy()\n    valid_preds = model(valid_X_tensor).cpu().numpy()\n\ntrain_mae = mean_absolute_error(train_y, train_preds)\nvalid_mae = mean_absolute_error(valid_y, valid_preds)\n\nprint("Train MAE: {:,.0f}".format(train_mae))\nprint("Validation MAE: {:,.0f}".format(valid_mae))\n\n# Test Predictions\ntest_data = pd.read_csv(\'test.csv\')\ntest_X = test_data[features]\ntest_X_scaled = scaler.transform(test_X)\ntest_X_tensor = torch.tensor(test_X_scaled, dtype=torch.float32).to(DEVICE)\n\nmodel.eval()\nwith torch.no_grad():\n    test_preds = model(test_X_tensor).cpu().numpy()\n\noutput = pd.DataFrame({\'Id\': test_data.Id, \n                       \'SalePrice\': test_preds.flatten()})\noutput.to_csv(\'submission.csv\', index=False)\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
