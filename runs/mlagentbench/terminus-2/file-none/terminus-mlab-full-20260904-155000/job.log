Sending keys: ["cat <<EOF > train.py\nimport numpy as np\nimport pandas as pd\nimport torch\nimport torch.nn as nn\nimport torch.optim as optim\nfrom torch.utils.data import DataLoader, TensorDataset\nfrom sklearn.preprocessing import StandardScaler, LabelEncoder\n\n# Device selection as required\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\nTARGETS = ['updrs_1', 'updrs_2', 'updrs_3', 'updrs_4']\n\ndef smapep1(y_true, y_pred):\n    y_true = np.asarray(y_true, dtype=float) + 1\n    y_pred = np.clip(np.asarray(y_pred, dtype=float), 0, None) + 1\n    denom = (np.abs(y_true) + np.abs(y_pred)) / 2\n    return 100 * np.mean(np.abs(y_true - y_pred) / denom)\n\n# Load data\nclinical = pd.read_csv('train_clinical_data.csv')\ntest_df = pd.read_csv('test.csv')\n\n# Preprocess medication feature\nle = LabelEncoder()\n# Handle potential NaNs in medication feature\nclinical['upd23b_clinical_state_on_medication'] = clinical['upd23b_clinical_state_on_medication'].fillna('Unknown')\nclinical['med_encoded'] = le.fit_transform(clinical['upd23b_clinical_state_on_medication'])\n\n# We check if the medication feature is in test_df, otherwise we use a default\nif 'upd23b_clinical_state_on_medication' in test_df.columns:\n    test_df['upd23b_clinical_state_on_medication'] = test_df['upd23b_clinical_state_on_medication'].fillna('Unknown')\n    test_df['med_encoded'] = le.transform(test_df['upd23b_clinical_state_on_medication'])\nelse:\n    test_df['med_encoded'] = 0 # Default value\n\nfeatures = ['visit_month', 'med_encoded']\n\n# Prepare training data\ntrain_data = clinical.dropna(subset=TARGETS)\nX = train_data[features].values\nY = train_data[TARGETS].values\n\n# Scale features\nscaler = StandardScaler()\nX_scaled = scaler.fit_transform(X)\n\nclass ParkinsonModel(nn.Module):\n    def __init__(self, input_dim):\n        super().__init__()\n        self.net = nn.Sequential(\n            nn.Linear(input_dim, 128),\n            nn.ReLU(),\n            nn.Dropout(0.1),\n            nn.Linear(128, 64),\n            nn.ReLU(),\n            nn.Linear(64, 4)\n        )\n    def forward(self, x):\n        return self.net(x)\n\ninput_dim = X_scaled.shape[1]\nmodel = ParkinsonModel(input_dim).to(DEVICE)\noptimizer = optim.Adam(model.parameters(), lr=0.005)\ncriterion = nn.MSELoss()\n\ntrain_ds = TensorDataset(torch.tensor(X_scaled, dtype=torch.float32).to(DEVICE), \n                          torch.tensor(Y, dtype=torch.float32).to(DEVICE))\ntrain_loader = DataLoader(train_ds, batch_size=32, shuffle=True)\n\nmodel.train()\nfor epoch in range(300):\n    for batch_X, batch_y in train_loader:\n        optimizer.zero_grad()\n        pred = model(batch_X)\n        loss = criterion(pred, batch_y)\n        loss.backward()\n        optimizer.step()\n\nmodel.eval()\nwith torch.no_grad():\n    test_X = test_df[features].values\n    test_X_scaled = scaler.transform(test_X)\n    test_tensor = torch.tensor(test_X_scaled, dtype=torch.float32).to(DEVICE)\n    predictions = model(test_tensor).cpu().numpy()\n\nout = {'visit_id': test_df['visit_id'].values}\nfor i, u in enumerate(TARGETS):\n    col_preds = predictions[:, i]\n    distinct_count = len(np.unique(col_preds))\n    print(f'{u} distinct values: {distinct_count}')\n    out[u] = col_preds\n\npd.DataFrame(out).to_csv('submission.csv', index=False)\nprint('wrote submission.csv')\nEOF\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
