Sending keys: ["cat << 'EOF' > train.py\nimport os\nimport numpy as np\nimport pandas as pd\nimport torch\nimport torch.nn as nn\nimport torch.nn.functional as F\nfrom torch.utils.data import Dataset, DataLoader\n\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\nclass ContrailDataset(Dataset):\n    def __init__(self, ids, root='train', is_test=False):\n        self.ids = ids\n        self.root = root\n        self.is_test = is_test\n\n    def __len__(self):\n        return len(self.ids)\n\n    def __getitem__(self, idx):\n        rid = self.ids[idx]\n        rec_dir = os.path.join(self.root, rid)\n        \n        # Bands 11, 14, 15 as used in the starter script\n        b11 = np.load(f'{rec_dir}/band_11.npy').astype(np.float32)\n        b14 = np.load(f'{rec_dir}/band_14.npy').astype(np.float32)\n        b15 = np.load(f'{rec_dir}/band_15.npy').astype(np.float32)\n        \n        # Labeled frame is at index 1 since shape is (256, 256, 3)\n        x = np.stack([b11[..., 1], b14[..., 1], b15[..., 1]], axis=0)\n        \n        # Simple normalization\n        x = (x - x.mean()) / (x.std() + 1e-6)\n        x = torch.tensor(x)\n\n        if self.is_test:\n            return rid, x\n        \n        m = np.load(f'{rec_dir}/human_pixel_masks.npy').astype(np.float32).squeeze()\n        y = torch.tensor(m)\n        return x, y\n\nclass SimpleConvNet(nn.Module):\n    def __init__(self):\n        super().__init__()\n        self.net = nn.Sequential(\n            nn.Conv2d(3, 16, 3, padding=1),\n            nn.ReLU(),\n            nn.Conv2d(16, 16, 3, padding=1),\n            nn.ReLU(),\n            nn.Conv2d(16, 1, 1)\n        )\n    def forward(self, x):\n        return self.net(x)\n\ntrain_ids = sorted(os.listdir('train'))\ntest_ids = sorted(os.listdir('test'))\n\n# Split for validation\nsplit = int(0.9 * len(train_ids))\ntrain_set = ContrailDataset(train_ids[:split])\nval_set = ContrailDataset(train_ids[split:], root='train')\n\ntrain_loader = DataLoader(train_set, batch_size=8, shuffle=True)\nval_loader = DataLoader(val_set, batch_size=8)\n\nmodel = SimpleConvNet().to(DEVICE)\nopt = torch.optim.Adam(model.parameters(), lr=1e-3)\nlossf = nn.BCEWithLogitsLoss()\n\nepochs = 3\nfor epoch in range(epochs):\n    model.train()\n    total_loss = 0\n    for x, y in train_loader:\n        x, y = x.to(DEVICE), y.to(DEVICE)\n        opt.zero_grad()\n        pred = model(x)\n        loss = lossf(pred, y)\n        loss.backward()\n        opt.step()\n        total_loss += loss.item()\n    print(f'epoch {epoch} loss {total_loss/len(train_loader):.4f}')\n\ndef rle(mask):\n    flat = mask.reshape(-1)\n    if flat.sum() == 0:\n        return ''\n    d = np.diff(np.concatenate([[0], flat, [0]]))\n    starts, ends = np.where(d == 1)[0], np.where(d == -1)[0]\n    return ' '.join(f'{s} {e - s}' for s, e in zip(starts, ends))\n\nmodel.eval()\nrows = []\nwith torch.no_grad():\n    for rid in test_ids:\n        rec_dir = f'test/{rid}'\n        b11 = np.load(f'{rec_dir}/band_11.npy').astype(np.float32)\n        b14 = np.load(f'{rec_dir}/band_14.npy').astype(np.float32)\n        b15 = np.load(f'{rec_dir}/band_15.npy').astype(np.float32)\n        x = np.stack([b11[..., 1], b14[..., 1], b15[..., 1]], axis=0)\n        x = (x - x.mean()) / (x.std() + 1e-6)\n        x = torch.tensor(x).unsqueeze(0).to(DEVICE)\n        pred = torch.sigmoid(model(x)).squeeze().cpu().numpy() > 0.5\n        rows.append({'record_id': rid, 'rle': rle(pred.astype(np.uint8))})\n\npd.DataFrame(rows).to_csv('submission.csv', index=False)\nprint('wrote submission.csv')\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
