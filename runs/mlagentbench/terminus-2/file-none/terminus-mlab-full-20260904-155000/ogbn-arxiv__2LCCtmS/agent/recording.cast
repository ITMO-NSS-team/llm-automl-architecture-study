[70.821386, "i", "cat <<EOF > train.py\nimport numpy as np\nimport pandas as pd\nimport torch\nimport torch.nn as nn\nimport torch.nn.functional as F\nfrom torch_geometric.nn import SAGEConv\n\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\nfeat = np.load('node_features.npy').astype(np.float32)\nedges_np = np.load('edges.npy')\ntr = pd.read_csv('train.csv')\nte = pd.read_csv('test.csv')\n\nx = torch.tensor(feat, dtype=torch.float)\n\n# Ensure edge_index is [2, E]\nif edges_np.shape[0] != 2:\n    edge_index = torch.tensor(edges_np, dtype=torch.long).t().contiguous()\nelse:\n    edge_index = torch.tensor(edges_np, dtype=torch.long).contiguous()\n\ny = torch.full((feat.shape[0],), -1, dtype=torch.long)\ny[tr['id'].values] = torch.tensor(tr['label'].values.copy(), dtype=torch.long)\n\ntrain_mask = torch.tensor(tr['id'].values, dtype=torch.long)\n\nclass SAGE(nn.Module):\n    def __init__(self, in_dim, hidden, out_dim):\n        super().__init__()\n        self.conv1 = SAGEConv(in_dim, hidden)\n        self.conv2 = SAGEConv(hidden, out_dim)\n\n    def forward(self, x, edge_index):\n        x = self.conv1(x, edge_index)\n        x = F.relu(x)\n        x = F.dropout(x, p=0.2, training=self.training)\n        x = self.conv2(x, edge_index)\n        return x\n\nmodel = SAGE(feat.shape[1], 64, int(tr['label'].max()) + 1).to(DEVICE)\noptimizer = torch.optim.Adam(model.parameters(), lr=0.01, weight_decay=1e-4)\ncriterion = nn.CrossEntropyLoss()\n\nx_d = x.to(DEVICE)\nedge_index_d = edge_index.to(DEVICE)\ny_d = y.to(DEVICE)\n\nepochs = 10\nfor epoch in range(epochs):\n    model.train()\n    optimizer.zero_grad()\n    out = model(x_d, edge_index_d)\n    loss = criterion(out[train_mask], y_d[train_mask])\n    loss.backward()\n    optimizer.step()\n    print(f'epoch {epoch} loss {loss.item():.4f}')\n\nmodel.eval()\nwith torch.no_grad():\n    out = model(x_d, edge_index_d)\n    pred = out[torch.tensor(te['id'].values)].argmax(1).cpu().numpy()\n\npd.DataFrame({'id': te['id'].values, 'label': pred}).to_csv('submission.csv', index=False)\nprint('wrote submission.csv')\nEOF\n"]
