[9.500641, "o", "\u001b[?2004l\r"]
[9.501487, "o", "import numpy as np\r\nimport pandas as pd\r\nimport torch\r\nimport torch.nn as nn\r\nimport torch.nn.functional as F"]
[9.501561, "o", "\r\n\r\ndevice = ('cuda' if torch.cuda.is_available()\r\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\r\nprint('DEVICE=', device)\r\n\r\nfeat = np.load('node_features.npy').astype(np.float32)\r\nedges = np.load('edges.npy')            # the baseline below ignores the graph entirely\r\ntr = pd.read_csv('train.csv')\r\nte = pd.read_csv('test.csv')\r\n\r\nXtr = torch.tensor(feat[tr['id'].values])\r\nytr = torch.tensor(tr['label'].values, dtype=torch.long)\r\nXte = torch.tensor(feat[te['id'].values])\r\nn_classes = int(tr['label'].max()) + 1\r\n\r\n\r\nclass MLP(nn.Module):\r\n    def __init__(self, in_dim, hidden, out_dim, num_layers=2, dropout=0.0):\r\n        super().__init__()\r\n        self.lins = nn.ModuleList([nn.Linear(in_dim, hidden)])\r\n        for _ in range(num_layers - 2):\r\n            self.lins.append(nn.Linear(hidden, hidden))\r\n        self.lins.append(nn.Linear(hidden, out_dim))"]
[9.501588, "o", "\r\n        self.dropout = dropout\r\n\r\n    def forward(self, x):\r\n        for lin in self.lins[:-1]:\r\n            x = F.relu(lin(x))\r\n            x = F.dropout(x, p=self.dropout, training=self.training)\r\n        return self.lins[-1](x)\r\n\r\n\r\n# model = SAGE(feat.shape[1], 256, n_classes, num_layers=2)   # graph model, unused\r\nmodel = MLP(feat.shape[1], hidden=16, out_dim=n_classes, num_layers=2).to(device)\r\noptimizer = torch.optim.Adam(model.parameters(), lr=1)\r\ncriterion = nn.CrossEntropyLoss()\r\n\r\nepochs = 4\r\nXtr_d, ytr_d = Xtr.to(device), ytr.to(device)\r\nfor epoch in range(epochs):\r\n"]
[9.501609, "o", "    model.train()\r\n    optimizer.zero_grad()\r\n    loss = criterion(model(Xtr_d), ytr_d)\r\n    loss.backward()\r\n    optimizer.step()\r\n    print(f'epoch {epoch} loss {loss.item():.4f}')\r\n\r\nmodel.eval()\r\n"]
[9.501628, "o", "with torch.no_grad():\r\n    pred = model(Xte.to(device)).argmax(1).cpu().numpy()\r\npd.DataFrame({'id': te['id'].values, 'label': pred}).to_csv('submission.csv', index=False)\r\nprint('wrote submission.csv')\r\n"]
