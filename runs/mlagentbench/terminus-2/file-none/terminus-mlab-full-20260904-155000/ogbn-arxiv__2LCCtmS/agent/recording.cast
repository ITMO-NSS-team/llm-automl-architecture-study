[70.822931, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.82299, "o", "edges_np = np.load('edges.npy')"]
[70.823063, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.823148, "o", "tr = pd.read_csv('train.csv')"]
[70.823191, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> te = pd.read_csv('test.csv')"]
[70.823298, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.823336, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> x = torch.tensor(feat, dtype=torch.float)"]
[70.823474, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.823509, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> # Ensure edge_index is [2, E]"]
[70.823604, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.823651, "o", "> if edges_np.shape[0] != 2:"]
[70.823765, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.823814, "o", ">     edge_index = torch.tensor(edges_np, dtype=torch.long).t().contiguous()"]
[70.823842, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.823896, "o", "> else:"]
[70.824012, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.824054, "o", ">     edge_index = torch.tensor(edges_np, dtype=torch.long).contiguous()"]
[70.82411, "o", "\r\n\u001b[?2004l\r"]
[70.824202, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[70.824251, "o", "> y = torch.full((feat.shape[0],), -1, dtype=torch.long)"]
[70.824369, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.824411, "o", "> y[tr['id'].values] = torch.tensor(tr['label'].values.copy(), dtype=torch.long)"]
[70.824461, "o", "\r\n\u001b[?2004l\r"]
[70.824524, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[70.824611, "o", "\u001b[?2004h> "]
[70.82464, "o", "train_mask = torch.tensor(tr['id'].values, dtype=torch.long)"]
[70.824709, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.824764, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.824806, "o", "> class SAGE(nn.Module):"]
[70.824889, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.82493, "o", "    def __init__(self, in_dim, hidden, out_dim):"]
[70.825, "o", "\r\n\u001b[?2004l\r"]
[70.8251, "o", "\u001b[?2004h>         super().__init__()"]
[70.82513, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>         self.conv1 = SAGEConv(in_dim, hidden)"]
[70.825235, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.825274, "o", ">         self.conv2 = SAGEConv(hidden, out_dim)"]
[70.825317, "o", "\r\n\u001b[?2004l\r"]
[70.825398, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[70.825457, "o", "\u001b[?2004h>     def forward(self, x, edge_index):"]
[70.825541, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.825593, "o", "        x = self.conv1(x, edge_index)"]
[70.82565, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.825755, "o", "        x = F.relu(x)"]
[70.825797, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>         x = F.dropout(x, p=0.2, training=self.training)"]
[70.825838, "o", "\r\n\u001b[?2004l\r"]
[70.825909, "o", "\u001b[?2004h> "]
[70.825977, "o", "        x = self.conv2(x, edge_index)"]
[70.826024, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>         return x"]
[70.82615, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.826179, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> model = SAGE(feat.shape[1], 64, int(tr['label'].max()) + 1).to(DEVICE)"]
[70.826234, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.826362, "o", "optimizer = torch.optim.Adam(model.parameters(), lr=0.01, weight_decay=1e-4)\r\n"]
[70.826434, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[70.826493, "o", "criterion = nn.CrossEntropyLoss()"]
[70.826554, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[70.826644, "o", "> x_d = x.to(DEVICE)"]
[70.826687, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> edge_index_d = edge_index.to(DEVICE)"]
[70.82674, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.826795, "o", "> y_d = y.to(DEVICE)"]
[70.826861, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[70.826925, "o", "> epochs = 10\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.827, "o", "for epoch in range(epochs):"]
[70.827072, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     model.train()"]
[70.827121, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     optimizer.zero_grad()"]
[70.827191, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.827243, "o", ">     out = model(x_d, edge_index_d)"]
[70.827334, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.827363, "o", ">     loss = criterion(out[train_mask], y_d[train_mask])"]
[70.827446, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.827529, "o", "    loss.backward()"]
[70.827579, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     optimizer.step()\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.827661, "o", "> "]
[70.827706, "o", "    print(f'epoch {epoch} loss {loss.item():.4f}')"]
[70.827774, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.827822, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> model.eval()"]
[70.82788, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.827962, "o", "with torch.no_grad():"]
[70.828103, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     out = model(x_d, edge_index_d)"]
[70.828147, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     pred = out[torch.tensor(te['id'].values)].argmax(1).cpu().numpy()"]
[70.828188, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.828236, "o", "> \r\n\u001b[?2004l\r"]
[70.828369, "o", "\u001b[?2004h> "]
[70.828411, "o", "pd.DataFrame({'id': te['id'].values, 'label': pred}).to_csv('submission.csv', index=False)"]
[70.828446, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.828538, "o", "> "]
[70.828585, "o", "print('wrote submission.csv')"]
[70.828803, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> EOF"]
[70.82886, "o", "\r\n\u001b[?2004l\r"]
