[63.503167, "o", ">             text, "]
[63.503285, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.503358, "o", "            None, "]
[63.503468, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.50356, "o", "            add_special_tokens=True, "]
[63.503724, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.503823, "o", ">             max_length=self.max_len, "]
