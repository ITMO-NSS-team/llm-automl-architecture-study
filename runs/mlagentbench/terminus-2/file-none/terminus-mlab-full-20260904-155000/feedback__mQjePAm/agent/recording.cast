[63.506473, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def compute_metrics_for_regression(y_test, y_test_pred):"]
[63.506564, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.506682, "o", "> "]
[63.506858, "o", "    metrics = {}"]
[63.506928, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     for i, task in enumerate(DIMENSIONS):"]
[63.507117, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.507204, "o", ">         rmse = np.sqrt(((y_test[:, i] - y_test_pred[:, i]) ** 2).mean())"]
[63.5073, "o", "\r\n\u001b[?2004l\r"]
[63.507467, "o", "\u001b[?2004h> "]
[63.507574, "o", "        metrics[f\"rmse_{task}\"] = rmse"]
[63.507692, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.507758, "o", ">     return metrics"]
[63.507961, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.508036, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> def train_model(X_train, y_train, X_valid, y_valid):"]
[63.508259, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.508337, "o", ">     tokenizer = AutoTokenizer.from_pretrained(MODEL_NAME)"]
[63.508625, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.508699, "o", ">     model = AutoModelForSequenceClassification.from_pretrained(MODEL_NAME, num_labels=len(DIMENSIONS))"]
[63.5088, "o", "\r\n\u001b[?2004l\r"]
[63.508919, "o", "\u001b[?2004h"]
[63.509005, "o", ">     model.to(DEVICE)"]
[63.509261, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.509333, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h>     train_dataset = EssayDataset(X_train, y_train, tokenizer, MAX_LEN)"]
[63.509424, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.509647, "o", "> "]
[63.50973, "o", "    valid_dataset = EssayDataset(X_valid, y_valid, tokenizer, MAX_LEN)"]
[63.509799, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.509907, "o", "> "]
[63.510109, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[63.510217, "o", ">     train_loader = DataLoader(train_dataset, batch_size=BATCH_SIZE, shuffle=True)"]
[63.510439, "o", "\r\n\u001b[?2004l\r"]
[63.510545, "o", "\u001b[?2004h>     valid_loader = DataLoader(valid_dataset, batch_size=BATCH_SIZE)"]
[63.510617, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.510701, "o", ">     "]
[63.510764, "o", "\r\n"]
[63.510931, "o", "\u001b[?2004l\r\u001b[?2004h"]
[63.511014, "o", ">     optimizer = AdamW(model.parameters(), lr=LEARNING_RATE)"]
[63.511108, "o", "\r\n\u001b[?2004l\r"]
[63.511189, "o", "\u001b[?2004h"]
[63.511317, "o", "> "]
[63.511439, "o", "    criterion = torch.nn.MSELoss()"]
[63.511517, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n"]
[63.511634, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[63.511815, "o", "    model.train()"]
[63.512171, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     for epoch in range(EPOCHS):\r\n\u001b[?2004l\r\u001b[?2004h>         for batch in train_loader:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.512335, "o", "            optimizer.zero_grad()\r\n\u001b[?2004l\r\u001b[?2004h>             input_ids = batch['input_ids'].to(DEVICE)\r\n\u001b[?2004l\r\u001b[?2004h>             attention_mask = batch['attention_mask'].to(DEVICE)"]
[63.512474, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.512628, "o", "            labels = batch['labels'].to(DEVICE)\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.512913, "o", "            outputs = model(input_ids, attention_mask=attention_mask)\r\n\u001b[?2004l\r\u001b[?2004h>             logits = outputs.logits\r\n\u001b[?2004l\r"]
[63.513049, "o", "\u001b[?2004h>             loss = criterion(logits, labels)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.513175, "o", "            loss.backward()\r\n\u001b[?2004l\r\u001b[?2004h>             optimizer.step()"]
[63.513356, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.513481, "o", "        print(f\"Epoch {epoch+1}/{EPOCHS} complete\")\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.513623, "o", "    return (model, tokenizer)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.513746, "o", "def predict(model_tuple, X):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.513878, "o", "    model, tokenizer = model_tuple\r\n\u001b[?2004l\r\u001b[?2004h>     model.eval()\r\n"]
[63.514009, "o", "\u001b[?2004l\r\u001b[?2004h>     tokenizer = tokenizer\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[63.514136, "o", "\u001b[?2004h>     predictions = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.514291, "o", "    with torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.514426, "o", "        for i in range(0, len(X), BATCH_SIZE):\r\n\u001b[?2004l\r\u001b[?2004h>             batch_texts = X[i:i+BATCH_SIZE]"]
[63.514567, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.514806, "o", "            inputs = tokenizer(batch_texts, padding=True, truncation=True, max_length=MAX_LEN, return_tensors=\"pt\").to(DEVICE)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.514936, "o", "            outputs = model(**inputs)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.515063, "o", "            predictions.append(outputs.logits.cpu().numpy())\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.515229, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h>     return np.vstack(predictions)\r\n\u001b[?2004l\r"]
[63.515361, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> if __name__ == '__main__':\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.515501, "o", ">     train_df = pd.read_csv('train.csv')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.515626, "o", "    X = list(train_df['full_text'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.515745, "o", "    y = np.array([train_df[d].values for d in DIMENSIONS]).T\r\n"]
[63.515842, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.516011, "o", "    X_train, X_valid, y_train, y_valid = train_test_split(X, y, test_size=0.10, random_state=SEED)\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.516074, "o", ">     \r\n\u001b[?2004l\r"]
[63.516142, "o", "\u001b[?2004h> "]
[63.516297, "o", "    model_tuple = train_model(X_train, y_train, X_valid, y_valid)\r\n\u001b[?2004l\r"]
[63.51636, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.516427, "o", "    y_valid_pred = predict(model_tuple, X_valid)"]
[63.516496, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.516559, "o", "> "]
[63.516669, "o", "    metrics = compute_metrics_for_regression(y_valid, y_valid_pred)"]
[63.516747, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.516818, "o", "    print(metrics)\r\n\u001b[?2004l\r"]
[63.516898, "o", "\u001b[?2004h> "]
[63.517017, "o", "    print(\"final MCRMSE on validation set: \", np.mean(list(metrics.values())))\r\n\u001b[?2004l\r"]
[63.517051, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[63.51708, "o", "> "]
[63.517188, "o", "    test_df = pd.read_csv('test.csv')\r\n"]
[63.51723, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[63.517437, "o", "    y_test_pred = predict(model_tuple, list(test_df['full_text']))\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.51762, "o", "> "]
[63.517698, "o", "    out = pd.DataFrame(y_test_pred, columns=DIMENSIONS)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.517732, "o", "    out.insert(0, 'text_id', test_df['text_id'])\r\n"]
[63.517762, "o", "\u001b[?2004l\r\u001b[?2004h> "]
