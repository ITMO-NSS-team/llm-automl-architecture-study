[63.505464, "o", "            'attention_mask': inputs['attention_mask'].flatten(),"]
[63.505569, "o", "\r\n"]
[63.505654, "o", "\u001b[?2004l\r"]
[63.505887, "o", "\u001b[?2004h> "]
[63.505984, "o", "            'labels': torch.tensor(self.labels[item], dtype=torch.float)"]
