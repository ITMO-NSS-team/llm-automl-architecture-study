[63.500609, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.500679, "o", "    def __init__(self, texts, labels, tokenizer, max_len):"]
[63.500828, "o", "\r\n\u001b[?2004l\r"]
[63.500898, "o", "\u001b[?2004h>         self.texts = texts"]
[63.501027, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.501125, "o", ">         self.labels = labels"]
[63.501243, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.501317, "o", "        self.tokenizer = tokenizer"]
[63.501415, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.501556, "o", "> "]
[63.501625, "o", "        self.max_len = max_len"]
[63.501806, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.501874, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h>     def __len__(self):"]
[63.501991, "o", "\r\n\u001b[?2004l\r"]
[63.502071, "o", "\u001b[?2004h>         return len(self.texts)"]
[63.502171, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.502333, "o", "> \r\n"]
