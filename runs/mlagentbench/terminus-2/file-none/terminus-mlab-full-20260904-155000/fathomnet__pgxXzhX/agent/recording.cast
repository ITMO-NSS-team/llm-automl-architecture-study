[52.184472, "o", "\u001b[?2004l\r\u001b[?2004h"]
[52.184495, "o", ">             nn.Conv2d(3, 32, 3, padding=1), nn.BatchNorm2d(32), nn.ReLU(),"]
[52.184528, "o", "\r\n"]
[52.184575, "o", "\u001b[?2004l\r"]
[52.184689, "o", "\u001b[?2004h"]
[52.184709, "o", ">             nn.Conv2d(32, 32, 3, padding=1), nn.BatchNorm2d(32), nn.ReLU(),"]
[52.184741, "o", "\r\n"]
[52.18478, "o", "\u001b[?2004l\r"]
[52.184942, "o", "\u001b[?2004h"]
[52.18503, "o", ">             nn.MaxPool2d(2),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.185124, "o", "            nn.Conv2d(32, 64, 3, padding=1), nn.BatchNorm2d(64), nn.ReLU(),\r\n\u001b[?2004l\r"]
[52.185217, "o", "\u001b[?2004h> "]
[52.185275, "o", "            nn.Conv2d(64, 64, 3, padding=1), nn.BatchNorm2d(64), nn.ReLU(),\r\n\u001b[?2004l\r"]
[52.185341, "o", "\u001b[?2004h> "]
[52.185381, "o", "            nn.MaxPool2d(2),"]
[52.185503, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.185549, "o", ">             nn.Conv2d(64, 128, 3, padding=1), nn.BatchNorm2d(128), nn.ReLU(),"]
[52.185594, "o", "\r\n\u001b[?2004l\r"]
[52.185711, "o", "\u001b[?2004h> "]
[52.185773, "o", "            nn.Conv2d(128, 128, 3, padding=1), nn.BatchNorm2d(128), nn.ReLU(),"]
[52.185819, "o", "\r\n\u001b[?2004l\r"]
[52.185902, "o", "\u001b[?2004h> "]
[52.185935, "o", "            nn.AdaptiveAvgPool2d(1)"]
[52.186003, "o", "\r\n\u001b[?2004l\r"]
[52.186049, "o", "\u001b[?2004h>         )"]
[52.186124, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.186157, "o", "        self.fc = nn.Linear(128, N_CLASSES)"]
[52.186223, "o", "\r\n\u001b[?2004l\r"]
[52.186288, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[52.186355, "o", ">     def forward(self, x):\r\n\u001b[?2004l\r"]
[52.186415, "o", "\u001b[?2004h> "]
[52.186456, "o", "        x = self.conv(x)"]
[52.186518, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.186558, "o", ">         x = torch.flatten(x, 1)"]
[52.186628, "o", "\r\n\u001b[?2004l\r"]
[52.186656, "o", "\u001b[?2004h>         return self.fc(x)"]
[52.18672, "o", "\r\n\u001b[?2004l\r"]
[52.186811, "o", "\u001b[?2004h> "]
[52.186845, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> train_df = pd.read_csv('train.csv')"]
[52.186939, "o", "\r\n\u001b[?2004l\r"]
[52.186976, "o", "\u001b[?2004h> test_df = pd.read_csv('test.csv')"]
[52.187016, "o", "\r\n"]
[52.187061, "o", "\u001b[?2004l\r\u001b[?2004h"]
[52.187132, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[52.187168, "o", "> Y = np.zeros((len(train_df), N_CLASSES))"]
[52.187208, "o", "\r\n"]
[52.187306, "o", "\u001b[?2004l\r\u001b[?2004h"]
[52.187345, "o", "> for r, cats in enumerate(train_df['categories']):"]
[52.187382, "o", "\r\n"]
[52.187433, "o", "\u001b[?2004l\r"]
[52.187489, "o", "\u001b[?2004h>     try:"]
[52.187571, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.18761, "o", "        for c in ast.literal_eval(str(cats)):"]
[52.187659, "o", "\r\n\u001b[?2004l\r"]
[52.187739, "o", "\u001b[?2004h> "]
[52.187784, "o", "            if 0 <= int(c) < N_CLASSES:"]
[52.187871, "o", "\r\n\u001b[?2004l\r"]
[52.187921, "o", "\u001b[?2004h>                 Y[r, int(c)] = 1.0"]
[52.187973, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.188019, "o", ">     except:"]
[52.188064, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.188119, "o", "        pass"]
[52.188203, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[52.188251, "o", "> train_ds = FathomDataset(train_df, labels=Y)"]
[52.188367, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.188382, "o", "> train_loader = DataLoader(train_ds, batch_size=BATCH_SIZE, shuffle=True)"]
[52.188422, "o", "\r\n"]
[52.188456, "o", "\u001b[?2004l\r"]
[52.18849, "o", "\u001b[?2004h"]
[52.188533, "o", "> \r\n"]
[52.188597, "o", "\u001b[?2004l\r\u001b[?2004h"]
[52.188621, "o", "> model = SimpleCNN().to(DEVICE)"]
[52.188654, "o", "\r\n"]
[52.18882, "o", "\u001b[?2004l\r"]
[52.188857, "o", "\u001b[?2004h> opt = torch.optim.AdamW(model.parameters(), lr=LR, weight_decay=1e-4)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.18891, "o", "lossf = nn.BCEWithLogitsLoss()"]
[52.18895, "o", "\r\n"]
[52.188978, "o", "\u001b[?2004l\r"]
[52.189012, "o", "\u001b[?2004h"]
[52.189042, "o", "> "]
[52.189079, "o", "\r\n"]
[52.189116, "o", "\u001b[?2004l\r"]
[52.189214, "o", "\u001b[?2004h"]
[52.189272, "o", "> for epoch in range(EPOCHS):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.189323, "o", "    model.train()"]
[52.189375, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     total_loss = 0"]
[52.189469, "o", "\r\n\u001b[?2004l\r"]
[52.189508, "o", "\u001b[?2004h>     for xb, yb in train_loader:"]
[52.189611, "o", "\r\n\u001b[?2004l\r"]
[52.189649, "o", "\u001b[?2004h>         xb, yb = xb.to(DEVICE), yb.to(DEVICE)"]
[52.189725, "o", "\r\n"]
[52.189786, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[52.189829, "o", "        opt.zero_grad()"]
[52.189881, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.189911, "o", ">         out = model(xb)"]
[52.189992, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.19003, "o", ">         loss = lossf(out, yb)"]
[52.190073, "o", "\r\n"]
[52.190131, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[52.19017, "o", "        loss.backward()"]
[52.190226, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.190258, "o", ">         opt.step()"]
[52.190352, "o", "\r\n\u001b[?2004l\r"]
[52.190398, "o", "\u001b[?2004h>         total_loss += loss.item()\r\n\u001b[?2004l\r"]
[52.190517, "o", "\u001b[?2004h> "]
[52.190552, "o", "    print(f'epoch {epoch+1}/{EPOCHS} loss {total_loss/len(train_loader):.4f}')"]
[52.190589, "o", "\r\n"]
[52.19062, "o", "\u001b[?2004l\r"]
[52.190664, "o", "\u001b[?2004h"]
[52.190726, "o", "> "]
[52.19079, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.190826, "o", "> test_ds = FathomDataset(test_df)"]
[52.190951, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.190983, "o", "> test_loader = DataLoader(test_ds, batch_size=BATCH_SIZE, shuffle=False)"]
[52.191014, "o", "\r\n\u001b[?2004l\r"]
[52.19106, "o", "\u001b[?2004h"]
[52.191137, "o", "> \r\n\u001b[?2004l\r"]
[52.191177, "o", "\u001b[?2004h> model.eval()"]
[52.191229, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.191275, "o", "> all_probs = []"]
[52.191333, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.191403, "o", "all_ids = []\r\n\u001b[?2004l\r"]
[52.191437, "o", "\u001b[?2004h> with torch.no_grad():"]
[52.191515, "o", "\r\n\u001b[?2004l\r"]
[52.191553, "o", "\u001b[?2004h>     for xb, ids in test_loader:"]
[52.191632, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.191666, "o", ">         xb = xb.to(DEVICE)"]
[52.191774, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.191812, "o", ">         p = torch.sigmoid(model(xb)).cpu().numpy()"]
[52.191863, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.191943, "o", "        all_probs.append(p)\r\n"]
[52.192015, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[52.192061, "o", "        all_ids.extend(ids)"]
[52.192144, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.192177, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> all_probs = np.vstack(all_probs)"]
[52.192227, "o", "\r\n\u001b[?2004l\r"]
[52.192314, "o", "\u001b[?2004h> "]
[52.192356, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> for col in range(N_CLASSES):"]
[52.192476, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.192516, "o", ">     distinct_vals = len(np.unique(all_probs[:, col]))"]
[52.192555, "o", "\r\n"]
[52.19261, "o", "\u001b[?2004l\r\u001b[?2004h"]
[52.19264, "o", ">     if distinct_vals < 10:"]
[52.192707, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[52.192815, "o", "> "]
[52.192854, "o", "        print(f'Warning: Column {col} has only {distinct_vals} distinct values')"]
[52.192893, "o", "\r\n\u001b[?2004l\r"]
[52.192921, "o", "\u001b[?2004h"]
[52.192982, "o", "> \r\n"]
[52.193021, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[52.19308, "o", "predictions = []"]
[52.193128, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.193179, "o", "for r in all_probs:"]
[52.193248, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[52.193287, "o", "    indices = np.where(r > 0.2)[0].tolist()"]
[52.193396, "o", "\r\n\u001b[?2004l\r"]
[52.19343, "o", "\u001b[?2004h>     predictions.append(sorted(indices))"]
[52.193469, "o", "\r\n\u001b[?2004l\r"]
[52.193517, "o", "\u001b[?2004h"]
[52.193657, "o", "> \r\n"]
[52.193677, "o", "\u001b[?2004l\r\u001b[?2004h> submission = pd.DataFrame({'id': all_ids, 'categories': [str(r) for r in predictions]})"]
[52.19382, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
