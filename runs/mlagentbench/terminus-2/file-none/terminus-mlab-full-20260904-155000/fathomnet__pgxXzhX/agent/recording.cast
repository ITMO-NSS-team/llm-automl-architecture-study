[29.558691, "o", "\u001b[?2004hroot@94b27447cb53:/workspace# "]
[52.176738, "i", "cat << 'EOF' > train.py\nimport ast\nimport numpy as np\nimport pandas as pd\nimport torch\nimport torch.nn as nn\nimport torch.nn.functional as F\nfrom torch.utils.data import Dataset, DataLoader\nfrom PIL import Image\n\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\nSIZE = 64\nN_CLASSES = 290\nBATCH_SIZE = 64\nEPOCHS = 10\nLR = 1e-3\n\nclass FathomDataset(Dataset):\n    def __init__(self, df, img_dir='images', labels=None):\n        self.df = df\n        self.img_dir = img_dir\n        self.labels = labels\n\n    def __len__(self):\n        return len(self.df)\n\n    def __getitem__(self, idx):\n        img_id = self.df.iloc[idx]['id']\n        label = None\n        if self.labels is not None:\n            label = self.labels[idx]\n            \n        img_path = None\n        for ext in ('.png', '.jpg', '.jpeg'):\n            p = f'{self.img_dir}/{img_id}{ext}'\n            try:\n                img = Image.open(p).convert('RGB').resize((SIZE, SIZE))\n                img_path = p\n                break\n            except FileNotFoundError:\n                continue\n        \n        if img_path is None:\n            img_array = np.zeros((SIZE, SIZE, 3), dtype=np.float32)\n        else:\n            img_array = np.asarray(img, dtype=np.float32) / 255.0\n            \n        img_tensor = torch.tensor(img_array).permute(2, 0, 1)\n        \n        if label is not None:\n            return img_tensor, torch.tensor(label, dtype=torch.float32)\n        return img_tensor, img_id\n\nclass SimpleCNN(nn.Module):\n    def __init__(self):\n        super().__init__()\n        self.conv = nn.Sequential(\n            nn.Conv2d(3, 32, 3, padding=1), nn.BatchNorm2d(32), nn.ReLU(),\n            nn.Conv2d(32, 32, 3, padding=1), nn.BatchNorm2d(32), nn.ReLU(),\n            nn.MaxPool2d(2),\n            nn.Conv2d(32, 64, 3, padding=1), nn.BatchNorm2d(64), nn.ReLU(),\n            nn.Conv2d(64, 64, 3, padding=1), nn.BatchNorm2d(64), nn.ReLU(),\n            nn.MaxPool2d(2),\n            nn.Conv2d(64, 128, 3, padding=1), nn.BatchNorm2d(128), nn.ReLU(),\n            nn.Conv2d(128, 128, 3, padding=1), nn.BatchNorm2d(128), nn.ReLU(),\n            nn.AdaptiveAvgPool2d(1)\n        )\n        self.fc = nn.Linear(128, N_CLASSES)\n\n    def forward(self, x):\n        x = self.conv(x)\n        x = torch.flatten(x, 1)\n        return self.fc(x)\n\ntrain_df = pd.read_csv('train.csv')\ntest_df = pd.read_csv('test.csv')\n\nY = np.zeros((len(train_df), N_CLASSES))\nfor r, cats in enumerate(train_df['categories']):\n    try:\n        for c in ast.literal_eval(str(cats)):\n            if 0 <= int(c) < N_CLASSES:\n                Y[r, int(c)] = 1.0\n    except:\n        pass\n\ntrain_ds = FathomDataset(train_df, labels=Y)\ntrain_loader = DataLoader(train_ds, batch_size=BATCH_SIZE, shuffle=True)\n\nmodel = SimpleCNN().to(DEVICE)\nopt = torch.optim.AdamW(model.parameters(), lr=LR, weight_decay=1e-4)\nlossf = nn.BCEWithLogitsLoss()\n\nfor epoch in range(EPOCHS):\n    model.train()\n    total_loss = 0\n    for xb, yb in train_loader:\n        xb, yb = xb.to(DEVICE), yb.to(DEVICE)\n        opt.zero_grad()\n        out = model(xb)\n        loss = lossf(out, yb)\n        loss.backward()\n        opt.step()\n        total_loss += loss.item()\n    print(f'epoch {epoch+1}/{EPOCHS} loss {total_loss/len(train_loader):.4f}')\n\ntest_ds = FathomDataset(test_df)\ntest_loader = DataLoader(test_ds, batch_size=BATCH_SIZE, shuffle=False)\n\nmodel.eval()\nall_probs = []\nall_ids = []\nwith torch.no_grad():\n    for xb, ids in test_loader:\n        xb = xb.to(DEVICE)\n        p = torch.sigmoid(model(xb)).cpu().numpy()\n        all_probs.append(p)\n        all_ids.extend(ids)\n\nall_probs = np.vstack(all_probs)\n\nfor col in range(N_CLASSES):\n    distinct_vals = len(np.unique(all_probs[:, col]))\n    if distinct_vals < 10:\n        print(f'Warning: Column {col} has only {distinct_vals} distinct values')\n\npredictions = []\nfor r in all_probs:\n    indices = np.where(r > 0.2)[0].tolist()\n    predictions.append(sorted(indices))\n\nsubmission = pd.DataFrame({'id': all_ids, 'categories': [str(r) for r in predic"]
[52.176903, "i", "tions]})\nsubmission.to_csv('submission.csv', index=False)\nprint('wrote submission.csv')\nEOF\n"]
[52.177173, "o", "cat << 'EOF' > train.py"]
