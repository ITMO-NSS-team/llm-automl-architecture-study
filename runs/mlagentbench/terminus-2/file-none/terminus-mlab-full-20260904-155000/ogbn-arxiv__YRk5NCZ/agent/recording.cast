[70.60661, "o", "\u001b[?2004l\r\u001b[?2004h"]
[70.60668, "o", "> "]
[70.606738, "o", "class ImprovedMLP(nn.Module):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.60679, "o", "    def __init__(self, in_dim, hidden, out_dim):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.606835, "o", "        super().__init__()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.606866, "o", "        self.net = nn.Sequential(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.606925, "o", "            nn.Linear(in_dim, hidden),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.606971, "o", "            nn.ReLU(),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.607016, "o", "            nn.Dropout(0.2),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.607058, "o", "            nn.Linear(hidden, hidden),\r\n\u001b[?2004l\r"]
[70.607101, "o", "\u001b[?2004h> "]
[70.607155, "o", "            nn.ReLU(),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.607202, "o", "            nn.Dropout(0.2),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.607351, "o", "            nn.Linear(hidden, out_dim)\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.607382, "o", ">         )\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.607459, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.607516, "o", "    def forward(self, x):\r\n\u001b[?2004l\r\u001b[?2004h>         return self.net(x)\r\n\u001b[?2004l\r"]
[70.607564, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.607635, "o", "model = ImprovedMLP(feat.shape[1], hidden=256, out_dim=n_classes).to(DEVICE)"]
[70.608401, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> optimizer = torch.optim.Adam(model.parameters(), lr=0.001)\r\n\u001b[?2004l\r\u001b[?2004h> criterion = nn.CrossEntropyLoss()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> epochs = 10\r\n\u001b[?2004l\r\u001b[?2004h> Xtr_d, ytr_d = Xtr.to(DEVICE), ytr.to(DEVICE)\r\n\u001b[?2004l\r\u001b[?2004h> for epoch in range(epochs):\r\n\u001b[?2004l\r\u001b[?2004h>     model.train()\r\n\u001b[?2004l\r\u001b[?2004h>     optimizer.zero_grad()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.608519, "o", "    out = model(Xtr_d)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.608581, "o", "    loss = criterion(out, ytr_d)\r\n\u001b[?2004l\r\u001b[?2004h>     loss.backward()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.608653, "o", "    optimizer.step()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.608722, "o", "    print(f'epoch {epoch} loss {loss.item():.4f}')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[70.608782, "o", "\u001b[?2004l\r\u001b[?2004h> model.eval()\r\n\u001b[?2004l\r\u001b[?2004h> with torch.no_grad():"]
[70.60883, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.608873, "o", "    pred = model(Xte.to(DEVICE)).argmax(1).cpu().numpy()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.608994, "o", "pd.DataFrame({'id': te['id'].values, 'label': pred}).to_csv('submission.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h"]
[70.609041, "o", "> "]
[70.609361, "o", "print('wrote submission.csv')\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
