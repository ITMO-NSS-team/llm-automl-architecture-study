[12.64966, "o", "import numpy as np"]
[12.649856, "o", "\r\nimport pandas as pd\r\nimport torch\r\nimport torch.nn as nn\r\nimport torch.nn.functional as F\r\n\r\ndevice = ('cuda' if torch.cuda.is_available()\r\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\r\nprint('DEVICE=', device)\r\n\r\nfeat = np.load('node_features.npy').astype(np.float32)\r\nedges = np.load('edges.npy')            # the baseline below ignores the graph entirely\r\ntr = pd.read_csv('train.csv')\r\nte = pd.read_csv('test.csv')\r\n\r\nXtr = torch.tensor(feat[tr['id'].values])\r\nytr = torch.tensor(tr['label'].values, dtype=torch.long)\r\nXte = torch.tensor(feat[te['id'].values])\r\nn_classes = int(tr['label'].max()) + 1\r\n\r\n\r\nclass MLP(nn.Module):\r\n    def __init__(self, in_dim, hidden, out_dim, num_layers=2, dropout=0.0):\r\n        super().__init__()\r\n        self.lins = nn.ModuleList([nn.Linear(in_dim, hidden)])\r\n        for _ in range(num_layers - 2):\r\n            self.lins.append(nn.Linear(hidden, hidden))\r\n        self.lins.append(nn.Linear(hidden, out_dim))\r\n        self.dropout = dropout\r\n\r\n    def forward(self, x):\r\n        for lin in self.lins[:-1]:\r\n            x = F.relu(lin(x))\r\n            x = F.dropout(x, p=self.dropout, training=self.training)\r\n        return self.lins[-1](x)\r\n\r\n\r\n# model = SAGE(feat.shape[1], 256, n_classes, num_layers=2)   # graph model, unused\r\nmodel = MLP(feat.shape[1], hidden=16, out_dim=n_classes, num_layers=2).to(device)\r\noptimizer = torch.optim.Adam(model.parameters(), lr=1)\r\ncriterion = nn.CrossEntropyLoss()\r\n\r\nepochs = 4\r\nXtr_d, ytr_d = Xtr.to(device), ytr.to(device)\r\nfor epoch in range(epochs):\r\n    model.train()\r\n    optimizer.zero_grad()\r\n    loss = criterion(model(Xtr_d), ytr_d)\r\n    loss.backward()\r\n    optimizer.step()\r\n    print(f'epoch {epoch} loss {loss.item():.4f}')\r\n\r\nmodel.eval()\r\nwith torch.no_grad():\r\n    pred = model(Xte.to(device)).argmax(1).cpu().numpy()\r\npd.DataFrame({'id': te['id'].values, 'label': pred}).to_csv('submission.csv', index=False)\r\nprint('wrote submission.csv')\r\n\u001b[?2004hroot@7de567e26a88:/workspace# "]
[43.486832, "i", "cat << 'EOF' > train.py\nimport numpy as np\nimport pandas as pd\nimport torch\nimport torch.nn as nn\nimport torch.nn.functional as F\n\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\nfeat = np.load('node_features.npy').astype(np.float32)\nedges = np.load('edges.npy')\ntr = pd.read_csv('train.csv')\nte = pd.read_csv('test.csv')\n\nXtr = torch.tensor(feat[tr['id'].values])\nytr = torch.tensor(tr['label'].values, dtype=torch.long)\nXte = torch.tensor(feat[te['id'].values])\nn_classes = int(tr['label'].max()) + 1\n\nclass SimpleGCN(nn.Module):\n    def __init__(self, in_dim, hidden, out_dim):\n        super().__init__()\n        self.lin1 = nn.Linear(in_dim, hidden)\n        self.lin2 = nn.Linear(hidden, out_dim)\n\n    def forward(self, x, adj):\n        # x: [N, D], adj: [N, N] (normalized)\n        x = F.relu(self.lin1(torch.spmm(adj, x)))\n        x = self.lin2(torch.spmm(adj, x))\n        return x\n\n# Precompute normalized adjacency matrix\n# Note: For large graphs, we should use sparse tensors\nN = feat.shape[0]\nedge_index = torch.tensor(edges, dtype=torch.long)\n\n# Create sparse adjacency matrix\nadj_sparse = torch.sparse_coo_tensor(edge_index.t(), torch.ones(edge_index.shape[0]), (N, N))\n# Symmetrize and normalize (D^-1/2 A D^-1/2)\nadj_sparse = adj_sparse + adj_sparse.t()\n\n# Simple degree normalization for GCN\ndeg = torch.sparse.sum(adj_sparse, dim=1).to_dense()\ndeg_inv_sqrt = deg.pow(-0.5)\ndeg_inv_sqrt[torch.isinf(deg_inv_sqrt)] = 0\n\n# We'll use a simpler MLP if the full GCN is too slow/memory-intensive for the environment\n# Given the constraints, let's use a larger MLP first or a very efficient GNN.\n# Let's try a robust MLP first as a baseline improvement, then see.\n# Wait, the goal is 'improve'. A GCN is significantly better for arXiv.\n\nclass ImprovedMLP(nn.Module):\n    def __init__(self, in_dim, hidden, out_dim):\n        super().__init__()\n        self.net = nn.Sequential(\n            nn.Linear(in_dim, hidden),\n            nn.ReLU(),\n       "]
[43.488334, "i", "     nn.Dropout(0.2),\n            nn.Linear(hidden, hidden),\n            nn.ReLU(),\n            nn.Dropout(0.2),\n            nn.Linear(hidden, out_dim)\n        )\n\n    def forward(self, x):\n        return self.net(x)\n\nmodel = ImprovedMLP(feat.shape[1], hidden=256, out_dim=n_classes).to(DEVICE)\noptimizer = torch.optim.Adam(model.parameters(), lr=0.001)\ncriterion = nn.CrossEntropyLoss()\n\nepochs = 10\nXtr_d, ytr_d = Xtr.to(DEVICE), ytr.to(DEVICE)\nfor epoch in range(epochs):\n    model.train()\n    optimizer.zero_grad()\n    out = model(Xtr_d)\n    loss = criterion(out, ytr_d)\n    loss.backward()\n    optimizer.step()\n    print(f'epoch {epoch} loss {loss.item():.4f}')\n\nmodel.eval()\nwith torch.no_grad():\n    pred = model(Xte.to(DEVICE)).argmax(1).cpu().numpy()\n\npd.DataFrame({'id': te['id'].values, 'label': pred}).to_csv('submission.csv', index=False)\nprint('wrote submission.csv')\nEOF\n"]
