[174.97641, "i", "cat <<EOF > train.py\nimport pandas as pd\nimport numpy as np\nimport torch\nfrom sklearn.ensemble import HistGradientBoostingRegressor\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.metrics import mean_absolute_error\n\n# Hardware snippet as required\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\n# Load data\niowa_file_path = 'train.csv'\nhome_data = pd.read_csv(iowa_file_path)\ny = home_data.SalePrice\n\nfeatures = ['MSSubClass', 'LotArea', 'OverallQual', 'OverallCond', 'YearBuilt', 'YearRemodAdd', '1stFlrSF', '2ndFlrS', 'LowQualFinSF', 'GrLivArea', 'FullBath', \n 'HalfBath', 'BedroomAbvGr', 'KitchenAbvGr', 'TotRmsAbvGrd', 'Fireplaces', 'WoodDeckSF', 'OpenPorchSF', 'EnclosedPorch', '3SsnPorch', 'ScreenPorch', 'PoolArea', \n 'MiscVal', 'MoSold', 'YrSold']\n\n# Correcting a typo in feature names if needed - the original provided list had '2ndFlrSF'\n# Let's redefine the features list precisely from the original provided script\nfeatures = ['MSSubClass', 'LotArea', 'OverallQual', 'OverallCond', 'YearBuilt', 'YearRemodAdd', '1stFlrSF', '2ndFlrSF', 'LowQualFinSF', 'GrLivArea', 'FullBath', \n 'HalfBath', 'BedroomAbvGr', 'KitchenAbvGr', 'TotRmsAbvGrd', 'Fireplaces', 'WoodDeckSF', 'OpenPorchSF', 'EnclosedPorch', '3SsnPorch', 'ScreenPorch', 'PoolArea', \n 'MiscVal', 'MoSold', 'YrSold']\n\nX = home_data[features]\n\n# Split\ntrain_X, valid_X, train_y, valid_y = train_test_split(X, y, random_state=1)\n\n# Model - HistGradientBoostingRegressor is excellent for tabular data\nmodel = HistGradientBoostingRegressor(random_state=1, max_iter=1000, learning_rate=0.1)\nmodel.fit(train_X, train_y)\n\n# Evaluation\ntrain_preds = model.predict(train_X)\nvalid_preds = model.predict(valid_X)\n\ntrain_mae = mean_absolute_error(train_y, train_preds)\nvalid_mae = mean_absolute_error(valid_y, valid_preds)\n\nprint(\"Train MAE: {:,.0f}\".format(train_mae))\nprint(\"Validation MAE: {:,.0f}\".format(valid_mae))\n\n# Test Predictions\ntest_data = pd.read_csv('test.csv')\ntest_X = test_data[features]\ntest_preds = model.predict(test_X)\n\noutput = pd.DataFrame({'Id': test_data.Id, \n                       'SalePrice': test_preds})\noutput.to_csv('submission.csv', index=False)\nEOF\n"]
[174.976859, "o", "cat <<EOF > train.py\r\nimport pandas as pd\r\nimport numpy as np\r\nimport torch\r\nfrom sklearn.ensemble import HistGradientBoostingRegressor\r\nfrom sklearn.model_selection import train_test_split\r\nfrom sklearn.metrics import mean_absolute_error\r\n\r\n# Hardware snippet as required\r\nDEVICE = ('cuda' if torch.cuda.is_available()\r\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\r\nprint('DEVICE=', DEVICE)\r\n\r\n# Load data\r\niowa_file_path = 'train.csv'\r\nhome_data = pd.read_csv(iowa_file_path)\r\ny = home_data.SalePrice\r\n\r\nfeatures = ['MSSubClass', 'LotArea', 'OverallQual', 'OverallCond', 'YearBuilt', 'YearRemodAdd', '1stFlrSF', '2ndFlrS', 'LowQualFinSF', 'GrLivArea', 'FullBath', \r\n 'HalfBath', 'BedroomAbvGr', 'KitchenAbvGr', 'TotRmsAbvGrd', 'Fireplaces', 'WoodDeckSF', 'OpenPorchSF', 'EnclosedPorch', '3SsnPorch', 'ScreenPorch', 'PoolArea', \r\n 'MiscVal', 'MoSold', 'YrSold']\r\n\r\n# Correcting a typo in feature names if needed - the original provided list had '2ndFlrSF'\r\n# Let's redefine the features list precisely from the original provided script\r\nfeatures = ['MSSubClass', 'LotArea', 'OverallQual', 'OverallCond', 'YearBuilt', 'YearRemodAdd', '1stFlrSF', '2ndFlrSF', 'LowQualFinSF', 'GrLivArea', 'FullBath', \r\n 'HalfBath', 'BedroomAbvGr', 'KitchenAbvGr', 'TotRmsAbvGrd', 'Fireplaces', 'WoodDeckSF', 'OpenPorchSF', 'EnclosedPorch', '3SsnPorch', 'ScreenPorch', 'PoolArea', \r\n 'MiscVal', 'MoSold', 'YrSold']\r\n\r\nX = home_data[features]\r\n\r\n# Split\r\ntrain_X, valid_X, train_y, valid_y = train_test_split(X, y, random_state=1)\r\n\r\n# Model - HistGradientBoostingRegressor is excellent for tabular data\r\nmodel = HistGradientBoostingRegressor(random_state=1, max_iter=1000, learning_rate=0.1)\r\nmodel.fit(train_X, train_y)\r\n\r\n# Evaluation\r\ntrain_preds = model.predict(train_X)\r\nvalid_preds = model.predict(valid_X)\r\n\r\ntrain_mae = mean_absolute_error(train_y, train_preds)\r\nvalid_mae = mean_absolute_error(valid_y, valid_preds)\r\n\r\nprint(\"Train MAE: {:,.0f}\".format(train_mae))\r\nprint(\"Validation MAE: {:,.0f}\".format(valid_mae))\r\n\r\n# Test Predictions\r\ntest_data = pd.read_csv('test.csv')\r\ntest_X = test_data[features]\r\ntest_preds = model.predict(test_X)\r\n\r\noutput = pd.DataFrame({'Id': test_data.Id, \r\n                       'SalePrice': test_preds})\r\noutput.to_csv('submission.csv', index=False)\r\nEOF\r\n"]
