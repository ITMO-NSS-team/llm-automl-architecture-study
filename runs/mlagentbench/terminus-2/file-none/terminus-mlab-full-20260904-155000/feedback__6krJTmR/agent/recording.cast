[3.510808, "o", "cat train.py\r\n\u001b[?2004l\r"]
[3.512865, "o", "import numpy as np\r\nimport pandas as pd\r\nfrom sklearn.model_selection import train_test_split\r\n\r\n"]
[3.514437, "o", "DIMENSIONS = [\"cohesion\", \"syntax\", \"vocabulary\", \"phraseology\", \"grammar\", \"conventions\"]\r\nSEED = 42\r\n\r\n\r\ndef compute_metrics_for_regression(y_test, y_test_pred):\r\n    metrics = {}\r\n    for i, task in enumerate(DIMENSIONS):\r\n        rmse = np.sqrt(((y_test[:, i] - y_test_pred[:, i]) ** 2).mean())\r\n        metrics[f\"rmse_{task}\"] = rmse\r\n    return metrics\r\n\r\n\r\ndef train_model(X_train, y_train, X_valid, y_valid):\r\n    # TODO. define and train the model\r\n    model = None\r\n    return model\r\n\r\n\r\ndef predict(model, X):\r\n    # TODO. predict the model\r\n    y_pred = np.random.rand(len(X), len(DIMENSIONS))\r\n    return y_pred\r\n\r\n\r\nif __name__ == '__main__':\r\n    train_df = pd.read_csv('train.csv')\r\n    X = list(train_df['full_text'])\r\n    y = np.array([train_df[d].values for d in DIMENSIONS]).T\r\n\r\n    X_train, X_valid, y_train, y_valid = train_test_split(X, y, test_size=0.10, random_state=SEED)\r\n    model = train_model(X_train, y_train, X_valid, y_valid)\r\n\r\n    y_valid_pred = predict(model, X_valid)\r\n    metrics = compute_metrics_for_regression(y_valid, y_valid_pred)\r\n    print(metrics)\r\n    print(\"final MCRMSE on validation set: \", np.mean(list(metrics.values())))\r\n\r\n    test_df = pd.read_csv('test.csv')\r\n    y_test_pred = predict(model, list(test_df['full_text']))\r\n    out = pd.DataFrame(y_test_pred, columns=DIMENSIONS)\r\n    out.insert(0, 'text_id', test_df['text_id'])\r\n    out.to_csv('submission.csv', index=False)\r\n"]
[3.514635, "o", "\u001b[?2004hroot@92d3ac56fb44:/workspace# "]
[16.891037, "i", "cat task_descriptor.txt\n"]
[16.891716, "o", "cat task_descriptor.txt\r\n\u001b[?2004l\r"]
[16.894255, "o", "Dataset Description\r\nThe dataset presented here (the ELLIPSE corpus) comprises argumentative essays written by 8th-12th grade English Language Learners (ELLs). The essays have been scored according to six analytic measures: cohesion, syntax, vocabulary, phraseology, grammar, and conventions.\r\n\r\n"]
[16.894385, "o", "Each measure represents a component of proficiency in essay writing, with greater scores corresponding to greater proficiency in that measure. The scores range from 1.0 to 5.0 in increments of 0.5. Your task is to predict the score of each of the six measures for the essays given in the test set.\r\n\r\nFile and Field Information\r\ntrain.csv - The training set, comprising the full_text of each essay, identified by a unique text_id. The essays are also given a score for each of the seven analytic measures above: cohesion, etc. These analytic measures comprise the target for the competition.\r\ntest.csv - For the test data we give only the full_text of an essay together with its text_id.\r\nsample_submission.csv - A submission file in the correct format. See the evaluation_details.txt for details.\r\n"]
[16.894606, "o", "\u001b[?2004h"]
[16.894684, "o", "root@92d3ac56fb44:/workspace# "]
