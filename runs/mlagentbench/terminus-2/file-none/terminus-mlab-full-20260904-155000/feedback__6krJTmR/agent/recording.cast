[63.312694, "o", "            outputs = model(input_ids, attention_mask=attention_mask)\r\n\u001b[?2004l\r\u001b[?2004h>             loss = criterion(outputs.logits, targets)\r\n\u001b[?2004l\r\u001b[?2004h>             loss.backward()"]
