[7.730062, "o", "import pandas as pd\r\nfrom sklearn.linear_model import LogisticRegression\r\n\r\n\r\ndef create_new_dataframe(data, column_names):\r\n    new_data = {}\r\n    for column in column_names:\r\n        if column in data.columns:\r\n"]
[7.730131, "o", "            new_data[column] = data[column]\r\n        else:\r\n            new_data[column] = pd.Series(0, index=data.index)\r\n    return pd.DataFrame(new_data)\r\n\r\n\r\ndf = pd.read_csv(\"train.csv\")\r\nnum_examples = df.shape[0]\r\ndf = df.sample(frac=1, random_state=1)\r\ntrain_data = df[0:int(0.8 * num_examples)]\r\nval_data = df[int(0.8 * num_examples) + 1:]\r\n\r\nfor part in (train_data, val_data):\r\n    part[[\"Deck\", \"Cabin_num\", \"Side\"]] = part[\"Cabin\"].str.split(\"/\", expand=True)\r\ntrain_data = train_data.drop('Cabin', axis=1)\r\nval_data = val_data.drop('Cabin', axis=1)\r\n\r\nTargetY = train_data[\"Transported\"]\r\nTargetY_test = val_data[\"Transported\"]"]
[7.730165, "o", "\r\n\r\nselectColumns = [\"Deck\", \"Cabin_num\", \"Side\"]\r\nResourceX = pd.get_dummies(train_data[selectColumns])\r\nResourceX_test = pd.get_dummies(val_data[selectColumns])\r\n\r\n# ***********************************************\r\n# In this part of the code, write and train the model on the above dataset to perform the task.\r\n# This part should populate the variable train_accuracy and val_accuracy\r\n# ***********************************************\r\n\r\n\r\n# ***********************************************\r\n# End of the main training module\r\n# ***********************************************\r\n\r\nprint(f\"Train Accuracy: {train_accuracy}\")\r\nprint(f\"Validation Accuracy: {val_accuracy}\")\r\n\r\ntest_data = pd.read_csv('test.csv')\r\ntest_data[[\"Deck\", \"Cabin_num\", \"Side\"]] = test_data[\"Cabin\"].str.split(\"/\", expand=True)\r\ntest_data = test_data.drop('Cabin', axis=1)\r\n\r\ntest_X = pd.get_dummies(test_data[selectColumns])\r\ntest_X = test_X.reindex(columns=ResourceX.columns, fill_value=0)\r\n\r\ntest_preds = model.predict(test_X)\r\npd.DataFrame({'PassengerId': test_data.PassengerId,\r\n              'Transported': test_preds}).to_csv('submission.csv', index=False)\r\n"]
