[176.028142, "o", "X_raw = train_df_raw.drop('Transported', axis=1)\r\n\u001b[?2004l\r"]
[176.028203, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[176.028272, "o", "# Preprocess train and test\r\n\u001b[?2004l\r\u001b[?2004h"]
[176.028338, "o", "> "]
[176.028399, "o", "all_data = pd.concat([X_raw, test_df_raw])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[176.028461, "o", "all_processed = preprocess(all_data)\r\n\u001b[?2004l\r\u001b[?2004h"]
[176.02851, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> # Separate again\r\n\u001b[?2004l\r"]
[176.028573, "o", "\u001b[?2004h> "]
[176.028691, "o", "X_processed = all_processed.iloc[:len(train_df_raw)].drop('PassengerId', axis=1)\r\n\u001b[?2004l\r"]
[176.028768, "o", "\u001b[?2004h> "]
[176.028859, "o", "test_processed = all_processed.iloc[len(train_df_raw):].drop('PassengerId', axis=1)\r\n\u001b[?2004l\r"]
[176.028924, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[176.02901, "o", "> # Split train/val\r\n\u001b[?2004l\r\u001b[?2004h> "]
[176.029162, "o", "X_train, X_val, y_train, y_val = train_test_split(X_processed, y, test_size=0.2, random_state=42)\r\n\u001b[?2004l\r"]
[176.029224, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[176.029287, "o", "> # Scaling\r\n\u001b[?2004l\r\u001b[?2004h> "]
[176.029324, "o", "scaler = StandardScaler()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[176.029415, "o", "X_train_scaled = scaler.fit_transform(X_train)\r\n\u001b[?2004l\r"]
[176.029482, "o", "\u001b[?2004h> "]
[176.029546, "o", "X_val_scaled = scaler.transform(X_val)\r\n\u001b[?2004l\r\u001b[?2004h"]
[176.029614, "o", "> "]
[176.029683, "o", "test_scaled = scaler.transform(test_processed)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[176.029746, "o", "> # Convert to Tensors\r\n\u001b[?2004l\r\u001b[?2004h"]
[176.02982, "o", "> "]
[176.02987, "o", "X_train_t = torch.tensor(X_train_scaled, dtype=torch.float32).to(DEVICE)\r\n\u001b[?2004l\r"]
[176.029948, "o", "\u001b[?2004h> "]
[176.030054, "o", "y_train_t = torch.tensor(y_train, dtype=torch.float32).unsqueeze(1).to(DEVICE)\r\n\u001b[?2004l\r"]
[176.030109, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[176.030241, "o", "X_val_t = torch.tensor(X_val_scaled, dtype=torch.float32).to(DEVICE)\r\n\u001b[?2004l\r"]
[176.030302, "o", "\u001b[?2004h> "]
[176.030384, "o", "y_val_t = torch.tensor(y_val, dtype=torch.float32).unsqueeze(1).to(DEVICE)\r\n\u001b[?2004l\r"]
[176.030441, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[176.030511, "o", "> # Model with Dropout\r\n\u001b[?2004l\r"]
[176.030579, "o", "\u001b[?2004h> class TitanicModel(nn.Module):\r\n"]
[176.030616, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[176.030701, "o", "    def __init__(self, input_dim):\r\n\u001b[?2004l\r"]
[176.030772, "o", "\u001b[?2004h> "]
[176.030843, "o", "        super(TitanicModel, self).__init__()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[176.03091, "o", "        self.net = nn.Sequential(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[176.03099, "o", "            nn.Linear(input_dim, 64),\r\n\u001b[?2004l\r"]
[176.031065, "o", "\u001b[?2004h>             nn.ReLU(),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[176.031134, "o", "            nn.Dropout(0.3),\r\n\u001b[?2004l\r"]
[176.031196, "o", "\u001b[?2004h> "]
[176.031266, "o", "            nn.Linear(64, 32),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[176.031333, "o", "            nn.ReLU(),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[176.031395, "o", "            nn.Dropout(0.2),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[176.031461, "o", "            nn.Linear(32, 1),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[176.031513, "o", "            nn.Sigmoid()\r\n\u001b[?2004l\r\u001b[?2004h>         )\r\n"]
[176.031583, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[176.031651, "o", "    def forward(self, x):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[176.031719, "o", "        return self.net(x)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[176.031794, "o", "\u001b[?2004h> "]
[176.031857, "o", "model = TitanicModel(X_train.shape[1]).to(DEVICE)\r\n\u001b[?2004l\r"]
[176.031926, "o", "\u001b[?2004h> criterion = nn.BCELoss()\r\n"]
[176.031989, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[176.032077, "o", "optimizer = optim.Adam(model.parameters(), lr=0.001, weight_decay=1e-4)\r\n\u001b[?2004l\r"]
[176.032146, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[176.032216, "o", "# Training loop\r\n\u001b[?2004l\r\u001b[?2004h> model.train()"]
[176.032279, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> for epoch in range(150):"]
[176.032349, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[176.032412, "o", "    optimizer.zero_grad()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[176.032481, "o", "    outputs = model(X_train_t)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[176.032544, "o", "    loss = criterion(outputs, y_train_t)\r\n\u001b[?2004l\r"]
[176.032613, "o", "\u001b[?2004h>     loss.backward()\r\n\u001b[?2004l\r"]
[176.032674, "o", "\u001b[?2004h>     optimizer.step()\r\n\u001b[?2004l\r\u001b[?2004h"]
[176.032743, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> # Evaluation\r\n\u001b[?2004l\r"]
[176.032819, "o", "\u001b[?2004h> model.eval()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[176.03289, "o", "with torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[176.032952, "o", "    val_preds = model(X_val_t)\r\n\u001b[?2004l\r\u001b[?2004h"]
[176.033039, "o", "> "]
[176.033096, "o", "    val_acc = ((val_preds > 0.5).float() == y_val_t).float().mean().item()\r\n\u001b[?2004l\r\u001b[?2004h"]
[176.033172, "o", "> "]
[176.033235, "o", "    train_preds = model(X_train_t)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[176.033361, "o", "    train_acc = ((train_preds > 0.5).float() == y_train_t).float().mean().item()\r\n\u001b[?2004l\r"]
[176.033423, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[176.033476, "o", "print(f\"Train Accuracy: {train_acc}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[176.033548, "o", "> "]
[176.033616, "o", "print(f\"Validation Accuracy: {val_acc}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[176.033671, "o", "> # Submission\r\n\u001b[?2004l\r\u001b[?2004h"]
[176.03374, "o", "> "]
[176.033815, "o", "X_test_t = torch.tensor(test_scaled, dtype=torch.float32).to(DEVICE)\r\n\u001b[?2004l\r"]
[176.033878, "o", "\u001b[?2004h> "]
[176.033948, "o", "with torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[176.034023, "o", "    test_outputs = model(X_test_t)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[176.034123, "o", "    test_preds = (test_outputs > 0.5).float().cpu().numpy().astype(int)\r\n\u001b[?2004l\r"]
[176.034184, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[176.034263, "o", "> "]
[176.034431, "o", "pd.DataFrame({'PassengerId': test_df_raw.PassengerId, 'Transported': test_preds.flatten()}).to_csv('submission.csv', index=False)"]
[176.034496, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
