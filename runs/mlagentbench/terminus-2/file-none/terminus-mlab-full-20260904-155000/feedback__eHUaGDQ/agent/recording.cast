[5459.414779, "o", "            outputs = model(input_ids, attention_mask=attention_mask)\r\n\u001b[?2004l\r\u001b[?2004h"]
[5459.414842, "o", "> "]
[5459.414945, "o", "            loss = torch.nn.MSELoss()(outputs.logits, labels)\r\n\u001b[?2004l\r\u001b[?2004h"]
[5459.415003, "o", "> "]
[5459.41505, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[5459.415134, "o", "            loss.backward()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5459.415192, "o", "            optimizer.step()\r\n\u001b[?2004l\r\u001b[?2004h"]
[5459.41526, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[5459.415317, "o", "    return (model, tokenizer)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5459.415389, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5459.415449, "o", "def predict(model_tuple, X):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5459.41551, "o", "    model, tokenizer = model_tuple\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5459.41557, "o", "    model.eval()\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[5459.415616, "o", "\u001b[?2004h> "]
[5459.415679, "o", "    preds = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5459.415709, "o", "    with torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h"]
[5459.415739, "o", "> "]
[5459.415844, "o", "        for i in range(0, len(X), BATCH_SIZE):\r\n\u001b[?2004l\r\u001b[?2004h"]
[5459.415899, "o", "> "]
[5459.415971, "o", "            batch_texts = X[i:i+BATCH_SIZE]\r\n\u001b[?2004l\r\u001b[?2004h"]
[5459.416028, "o", "> "]
[5459.416288, "o", "            inputs = tokenizer(batch_texts, padding=True, truncation=True, max_length=MAX_LEN, return_tensors=\"pt\").to(DEVICE)\r\n\u001b[?2004l\r\u001b[?2004h"]
[5459.416342, "o", "> "]
[5459.416401, "o", "            outputs = model(**inputs)\r\n\u001b[?2004l\r\u001b[?2004h"]
[5459.416427, "o", "> "]
[5459.416551, "o", "            preds.append(outputs.logits.cpu().numpy())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5459.416613, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[5459.41669, "o", "    return np.vstack(preds)\r\n\u001b[?2004l\r"]
[5459.416739, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[5459.416797, "o", "if __name__ == '__main__':\r\n\u001b[?2004l\r\u001b[?2004h"]
[5459.416854, "o", "> "]
[5459.416915, "o", "    train_df = pd.read_csv('train.csv')\r\n\u001b[?2004l\r\u001b[?2004h"]
[5459.416978, "o", "> "]
[5459.417035, "o", "    X = list(train_df['full_text'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5459.417189, "o", "    y = np.array([train_df[d].values for d in DIMENSIONS]).T\r\n\u001b[?2004l\r"]
[5459.41724, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[5459.417471, "o", "    X_train, X_valid, y_train, y_valid = train_test_split(X, y, test_size=0.10, random_state=SEED)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5459.417646, "o", "    model_tuple = train_model(X_train, y_train, X_valid, y_valid)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[5459.417705, "o", "\u001b[?2004h> "]
[5459.417788, "o", "    y_valid_pred = predict(model_tuple, X_valid)\r\n\u001b[?2004l\r\u001b[?2004h"]
[5459.417843, "o", "> "]
[5459.417979, "o", "    metrics = compute_metrics_for_regression(y_valid, y_valid_pred)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[5459.418052, "o", "    print(metrics)\r\n\u001b[?2004l\r\u001b[?2004h"]
[5459.418121, "o", "> "]
[5459.418245, "o", "    print(\"final MCRMSE on validation set: \", np.mean(list(metrics.values())))\r\n\u001b[?2004l\r\u001b[?2004h"]
[5459.418273, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[5459.418374, "o", "    test_df = pd.read_csv('test.csv')\r\n\u001b[?2004l\r\u001b[?2004h"]
[5459.418431, "o", "> "]
[5459.418552, "o", "    y_test_pred = predict(model_tuple, list(test_df['full_text']))\r\n\u001b[?2004l\r\u001b[?2004h"]
[5459.418597, "o", "> "]
[5459.418702, "o", "    out = pd.DataFrame(y_test_pred, columns=DIMENSIONS)\r\n\u001b[?2004l\r\u001b[?2004h"]
[5459.418751, "o", "> "]
[5459.418837, "o", "    out.insert(0, 'text_id', test_df['text_id'])\r\n\u001b[?2004l\r\u001b[?2004h"]
[5459.418894, "o", "> "]
[5459.418968, "o", "    out.to_csv('submission.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h"]
[5459.419018, "o", "> EOF\r\n\u001b[?2004l\r"]
[5459.422955, "o", "\u001b[?2004hroot@3220800786cf:/workspace# "]
[5459.423034, "o", "python3 train.py\r\n\u001b[?2004l\r"]
