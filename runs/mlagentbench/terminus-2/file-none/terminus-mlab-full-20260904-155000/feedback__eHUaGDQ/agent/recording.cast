[45.241345, "o", "> from sklearn.model_selection import train_test_split"]
[45.241526, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[45.241556, "o", "> from transformers import AutoTokenizer, AutoModelForSequenceClassification, get_linear_schedule_withwarmup"]
[45.241583, "o", "\r\n"]
[45.241676, "o", "\u001b[?2004l\r\u001b[?2004h"]
[45.241752, "o", "> \r\n\u001b[?2004l\r"]
[45.241851, "o", "\u001b[?2004h> "]
[45.241907, "o", "DEVICE = ('cuda' if torch.cuda.is_available()"]
[45.242016, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[45.242083, "o", ">           else 'mps' if torch.backends.mps.is_available() else 'cpu')"]
