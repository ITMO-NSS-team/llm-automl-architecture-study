[846.659233, "i", "cat << 'EOF' > train.py\nimport numpy as np\nimport pandas as pd\nimport torch\nfrom torch.utils.data import DataLoader, Dataset\nfrom torch.optim import AdamW\nfrom sklearn.model_selection import train_test_split\nfrom transformers import AutoTokenizer, AutoModelForSequenceClassification\n\nDEVICE = ('cuda' if torch.cuda.is_available() else 'mps' if torch.backends.mps.is_available() else 'cpu')\nDIMENSIONS = [\"cohesion\", \"syntax\", \"vocabulary\", \"phraseology\", \"grammar\", \"conventions\"]\nSEED = 42\nMODEL_NAME = 'distilbert-base-uncased'\nMAX_LEN = 128\nBATCH_SIZE = 8\nEPOCHS = 1\nLEARNING_RATE = 5e-5\n\nclass EssayDataset(Dataset):\n    def __init__(self, texts, labels, tokenizer, max_len):\n        self.texts = texts\n        self.labels = labels\n        self.tokenizer = tokenizer\n        self.max_len = max_len\n    def __len__(self): return len(self.texts)\n    def __getitem__(self, idx):\n        inputs = self.tokenizer.encode_plus(str(self.texts[idx]), None, add_special_tokens=True, max_length=self.max_len, padding='max_length', truncation=True, return_tensors='pt')\n        return {'input_ids': inputs['input_ids'].flatten(), 'attention_mask': inputs['attention_mask'].flatten(), 'labels': torch.tensor(self.labels[idx], dtype=torch.float)}\n\ndef compute_metrics_for_regression(y_test, y_test_pred):\n    return {f\"rmse_{task}\": np.sqrt(((y_test[:, i] - y_test_pred[:, i]) ** 2).mean()) for i, task in enumerate(DIMENSIONS)}\n\ndef train_model(X_train, y_train, X_valid, y_valid):\n    tokenizer = AutoTokenizer.from_pretrained(MODEL_NAME)\n    model = AutoModelForSequenceClassification.from_pretrained(MODEL_NAME, num_labels=len(DIMENSIONS)).to(DEVICE)\n    train_loader = DataLoader(EssayDataset(X_train, y_train, tokenizer, MAX_LEN), batch_size=BATCH_SIZE, shuffle=True)\n    optimizer = AdamW(model.parameters(), lr=LEARNING_RATE)\n    model.train()\n    for epoch in range(EPOCHS):\n        for batch in train_loader:\n            optimizer.zero_grad()\n            outputs = model(batch['input_ids'].to(DEVICE), attention_mask=batch['attention_mask'].to(DEVI"]
[846.662299, "i", "CE))\n            loss = torch.nn.MSELoss()(outputs.logits, batch['labels'].to(DEVICE))\n            loss.backward()\n            optimizer.step()\n    return (model, tokenizer)\n\ndef predict(model_tuple, X):\n    model, tokenizer = model_tuple\n    model.eval()\n    preds = []\n    with torch.no_grad():\n        for i in range(0, len(X), BATCH_SIZE):\n            inputs = tokenizer(X[i:i+BATCH_SIZE], padding=True, truncation=True, max_length=MAX_LEN, return_tensors=\"pt\").to(DEVICE)\n            preds.append(model(**inputs).logits.cpu().numpy())\n    return np.vstack(preds)\n\nif __name__ == '__main__':\n    train_df = pd.read_csv('train.csv')\n    X, y = list(train_df['full_text']), np.array([train_df[d].values for d in DIMENSIONS]).T\n    X_train, X_valid, y_train, y_valid = train_test_split(X, y, test_size=0.10, random_state=SEED)\n    model_tuple = train_model(X_train, y_train, X_valid, y_valid)\n    y_valid_pred = predict(model_tuple, X_valid)\n    print(compute_metrics_for_regression(y_valid, y_valid_pred))\n    test_df = pd.read_csv('test.csv')\n    y_test_pred = predict(model_tuple, list(test_df['full_text']))\n    out = pd.DataFrame(y_test_pred, columns=DIMENSIONS)\n    out.insert(0, 'text_id', test_df['text_id'])\n    out.to_csv('submission.csv', index=False)\nEOF\n"]
