[546.785197, "i", "cat << 'EOF' > train.py\nimport numpy as np\nimport pandas as pd\nimport torch\nfrom torch.utils.data import DataLoader, Dataset\nfrom torch.optim import AdamW\nfrom sklearn.model_selection import train_test_split\nfrom transformers import AutoTokenizer, AutoModelForSequenceClassification\n\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\nDIMENSIONS = [\"cohesion\", \"syntax\", \"vocabulary\", \"phraseology\", \"grammar\", \"conventions\"]\nSEED = 42\nMODEL_NAME = 'distilbert-base-uncased'\nMAX_LEN = 128\nBATCH_SIZE = 8\nEPOCHS = 1\nLEARNING_RATE = 5e-5\n\nclass EssayDataset(Dataset):\n    def __init__(self, texts, labels, tokenizer, max_len):\n        self.texts = texts\n        self.labels = labels\n        self.tokenizer = tokenizer\n        self.max_len = max_len\n\n    def __len__(self):\n        return len(self.texts)\n\n    def __getitem__(self, idx):\n        text = str(self.texts[idx])\n        inputs = self.tokenizer.encode_plus(\n            text, \n            None, \n            add_special_tokens=True, \n            max_length=self.max_len, \n            padding='max_length', \n            truncation=True, \n            return_tensors='pt'\n        )\n        return {\n            'input_ids': inputs['input_ids'].flatten(),\n            'attention_mask': inputs['attention_mask'].flatten(),\n            'labels': torch.tensor(self.labels[idx], dtype=torch.float)\n        }\n\ndef compute_metrics_for_regression(y_test, y_test_pred):\n    metrics = {}\n    for i, task in enumerate(DIMENSIONS):\n        rmse = np.sqrt(((y_test[:, i] - y_test_pred[:, i]) ** 2).mean())\n        metrics[f\"rmse_{task}\"] = rmse\n    return metrics\n\ndef train_model(X_train, y_train, X_valid, y_valid):\n    tokenizer = AutoTokenizer.from_pretrained(MODEL_NAME)\n    model = AutoModelForSequenceClassification.from_pretrained(MODEL_NAME, num_labels=len(DIMENSIONS))\n    model.to(DEVICE)\n\n    train_dataset = EssayDataset(X_train, y_train, tokenizer, MAX_LEN)\n    valid_dataset = EssayDataset(X_valid, y"]
[546.785514, "o", "cat << 'EOF' > train.py\r\nimport numpy as np\r\nimport pandas as pd\r\nimport torch\r\nfrom torch.utils.data import DataLoader, Dataset\r\nfrom torch.optim import AdamW\r\nfrom sklearn.model_selection import train_test_split\r\nfrom transformers import AutoTokenizer, AutoModelForSequenceClassification\r\n\r\nDEVICE = ('cuda' if torch.cuda.is_available()\r\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\r\nprint('DEVICE=', DEVICE)\r\n\r\nDIMENSIONS = [\"cohesion\", \"syntax\", \"vocabulary\", \"phraseology\", \"grammar\", \"conventions\"]\r\nSEED = 42\r\nMODEL_NAME = 'distilbert-base-uncased'\r\nMAX_LEN = 128\r\nBATCH_SIZE = 8\r\nEPOCHS = 1\r\nLEARNING_RATE = 5e-5\r\n\r\nclass EssayDataset(Dataset):\r\n    def __init__(self, texts, labels, tokenizer, max_len):\r\n        self.texts = texts\r\n        self.labels = labels\r\n        self.tokenizer = tokenizer\r\n        self.max_len = max_len\r\n\r\n    def __len__(self):\r\n        return len(self.texts)\r\n\r\n    def __getitem__(self, idx):\r\n        text = str(self.texts[idx])\r\n        inputs = self.tokenizer.encode_plus(\r\n            text, \r\n            None, \r\n            add_special_tokens=True, \r\n            max_length=self.max_len, \r\n            padding='max_length', \r\n            truncation=True, \r\n            return_tensors='pt'\r\n        )\r\n        return {\r\n            'input_ids': inputs['input_ids'].flatten(),\r\n            'attention_mask': inputs['attention_mask'].flatten(),\r\n            'labels': torch.tensor(self.labels[idx], dtype=torch.float)\r\n        }\r\n\r\ndef compute_metrics_for_regression(y_test, y_test_pred):\r\n    metrics = {}\r\n    for i, task in enumerate(DIMENSIONS):\r\n        rmse = np.sqrt(((y_test[:, i] - y_test_pred[:, i]) ** 2).mean())\r\n        metrics[f\"rmse_{task}\"] = rmse\r\n    return metrics\r\n\r\ndef train_model(X_train, y_train, X_valid, y_valid):\r\n    tokenizer = AutoTokenizer.from_pretrained(MODEL_NAME)\r\n    model = AutoModelForSequenceClassification.from_pretrained(MODEL_NAME, num_labels=len(DIMENSIONS))\r\n    model.to(DEVICE)\r\n\r\n    train_dataset = EssayDataset(X_train, y_train, tokenizer, MAX_LEN)\r\n    valid_dataset = EssayDataset(X_valid, y"]
[546.785616, "i", "_valid, tokenizer, MAX_LEN)\n    \n    train_loader = DataLoader(train_dataset, batch_size=BATCH_SIZE, shuffle=True)\n    valid_loader = DataLoader(valid_dataset, batch_size=BATCH_SIZE)\n\n    optimizer = AdamW(model.parameters(), lr=LEARNING_RATE)\n    \n    model.train()\n    for epoch in range(EPOCHS):\n        for batch in train_loader:\n            optimizer.zero_grad()\n            input_ids = batch['input_ids'].to(DEVICE)\n            attention_mask = batch['attention_mask'].to(DEVICE)\n            labels = batch['labels'].to(DEVICE)\n            \n            outputs = model(input_ids, attention_mask=attention_mask)\n            loss = torch.nn.MSELoss()(outputs.logits, labels)\n            \n            loss.backward()\n            optimizer.step()\n\n    return (model, tokenizer)\n\ndef predict(model_tuple, X):\n    model, tokenizer = model_tuple\n    model.eval()\n    \n    preds = []\n    with torch.no_grad():\n        for i in range(0, len(X), BATCH_SIZE):\n            batch_texts = X[i:i+BATCH_SIZE]\n            inputs = tokenizer(batch_texts, padding=True, truncation=True, max_length=MAX_LEN, return_tensors=\"pt\").to(DEVICE)\n            outputs = model(**inputs)\n            preds.append(outputs.logits.cpu().numpy())\n            \n    return np.vstack(preds)\n\nif __name__ == '__main__':\n    train_df = pd.read_csv('train.csv')\n    X = list(train_df['full_text'])\n    y = np.array([train_df[d].values for d in DIMENSIONS]).T\n\n    X_train, X_valid, y_train, y_valid = train_test_split(X, y, test_size=0.10, random_state=SEED)\n    model_tuple = train_model(X_train, y_train, X_valid, y_valid)\n\n    y_valid_pred = predict(model_tuple, X_valid)\n    metrics = compute_metrics_for_regression(y_valid, y_valid_pred)\n    print(metrics)\n    print(\"final MCRMSE on validation set: \", np.mean(list(metrics.values())))\n\n    test_df = pd.read_csv('test.csv')\n    y_test_pred = predict(model_tuple, list(test_df['full_text']))\n    out = pd.DataFrame(y_test_pred, columns=DIMENSIONS)\n    out.insert(0, 'text_id', test_df['text_id'])\n    out.to_csv('submission.csv"]
[546.785847, "o", "_valid, tokenizer, MAX_LEN)\r\n    \r\n    train_loader = DataLoader(train_dataset, batch_size=BATCH_SIZE, shuffle=True)\r\n    valid_loader = DataLoader(valid_dataset, batch_size=BATCH_SIZE)\r\n\r\n    optimizer = AdamW(model.parameters(), lr=LEARNING_RATE)\r\n    \r\n    model.train()\r\n    for epoch in range(EPOCHS):\r\n        for batch in train_loader:\r\n            optimizer.zero_grad()\r\n            input_ids = batch['input_ids'].to(DEVICE)\r\n            attention_mask = batch['attention_mask'].to(DEVICE)\r\n            labels = batch['labels'].to(DEVICE)\r\n            \r\n            outputs = model(input_ids, attention_mask=attention_mask)\r\n            loss = torch.nn.MSELoss()(outputs.logits, labels)\r\n            \r\n            loss.backward()\r\n            optimizer.step()\r\n\r\n    return (model, tokenizer)\r\n\r\ndef predict(model_tuple, X):\r\n    model, tokenizer = model_tuple\r\n    model.eval()\r\n    \r\n    preds = []\r\n    with torch.no_grad():\r\n        for i in range(0, len(X), BATCH_SIZE):\r\n            batch_texts = X[i:i+BATCH_SIZE]\r\n            inputs = tokenizer(batch_texts, padding=True, truncation=True, max_length=MAX_LEN, return_tensors=\"pt\").to(DEVICE)\r\n            outputs = model(**inputs)\r\n            preds.append(outputs.logits.cpu().numpy())\r\n            \r\n    return np.vstack(preds)\r\n\r\nif __name__ == '__main__':\r\n    train_df = pd.read_csv('train.csv')\r\n    X = list(train_df['full_text'])\r\n    y = np.array([train_df[d].values for d in DIMENSIONS]).T\r\n\r\n    X_train, X_valid, y_train, y_valid = train_test_split(X, y, test_size=0.10, random_state=SEED)\r\n    model_tuple = train_model(X_train, y_train, X_valid, y_valid)\r\n\r\n    y_valid_pred = predict(model_tuple, X_valid)\r\n    metrics = compute_metrics_for_regression(y_valid, y_valid_pred)\r\n    print(metrics)\r\n    print(\"final MCRMSE on validation set: \", np.mean(list(metrics.values())))\r\n\r\n    test_df = pd.read_csv('test.csv')\r\n    y_tes"]
