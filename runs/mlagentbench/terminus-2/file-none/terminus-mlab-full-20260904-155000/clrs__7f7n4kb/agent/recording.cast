[100.090861, "i", "cat <<EOF > train.py\nimport numpy as np\nimport pandas as pd\nimport torch\nimport torch.nn as nn\n\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\ntr = np.load('train.npz')\nte = np.load('test.npz')\nA_tr, Pi_tr = tr['A'].astype(np.float32), tr['Pi'].astype(np.int64)\nA_te = te['A'].astype(np.float32)\nN_tr, N_te = A_tr.shape[1], A_te.shape[1]\n\nepochs = 20\n\nclass ImprovedModel(nn.Module):\n    def __init__(self, hidden=64):\n        super().__init__()\n        self.net = nn.Sequential(\n            nn.Linear(3, hidden),\n            nn.ReLU(),\n            nn.Linear(hidden, hidden),\n            nn.ReLU(),\n            nn.Linear(hidden, 1)\n        )\n\n    def forward(self, A):\n        B, N, _ = A.shape\n        # A is (B, N, N)\n        # We want features for each (i, j, k)\n        # ik: A[b, i, k], kj: A[b, k, j]\n        ik = A.unsqueeze(2).expand(B, N, N, N) # (B, i, j, k)\n        kj = A.unsqueeze(1).transpose(2, 3).expand(B, N, N, N) # (B, i, j, k)\n        \n        # The baseline had an error in transpose/expand logic for kj\n        # Let's fix it: we want A[b, k, j]\n        # A is (B, N, N). A[b, k, j] means k is the 2nd dim, j is 3rd.\n        # To get (B, i, j, k), we can do:\n        # A_expanded = A.unsqueeze(1) # (B, 1, N, N) -> (B, i, k, j)\n        # kj = A_expanded.expand(B, N, N, N) # (B, i, k, j)\n        # Wait, the original Baseline code: \n        # ik = A.unsqueeze(2).expand(B, N, N, N) -> A[b, i, k] expanded over j\n        # kj = A.unsqueeze(1).transpose(2, 3).expand(B, N, N, N) -> \n        #   A.unsqueeze(1) is (B, 1, N, N) -> A[b, k, j]\n        #   transpose(2, 3) makes it (B, 1, N, N) - wait, no.\n        \n        # Let's redo the feature extraction cleanly:\n        # We need A[b, i, k] and A[b, k, j] for all i, j, k\n        # A: (B, N, N)\n        # i_idx = torch.arange(N).view(N, 1, 1)\n        # j_idx = torch.arange(N).view(1, N, 1)\n        # k_idx = torch.arange(N).view(1, 1, N)\n        # This is too memory intensive.\n        \n        # Alternative: Use broadcasting\n        # A[b, i, k] -> A.unsqueeze(2) is (B, N, 1, N). Broadcast to (B, N, N, N)\n        # A[b, k, j] -> A.unsqueeze(1) is (B, 1, N, N). Broadcast to (B, N, N, N)\n        \n        ik = A.unsqueeze(2) # (B, N, 1, N) -> A[b, i, k]\n        kj = A.unsqueeze(1) # (B, 1, N, N) -> A[b, k, j]\n        \n        # Now ik is (B, N, 1, N), kj is (B, 1, N, N)\n        # To get (B, N, N, N) where dims are (batch, i, j, k):\n        # ik_feat: (B, N, 1, N) broadcast to (B, N, N, N) -> A[b, i, k]\n        # kj_feat: (B, 1, N, N) broadcast to (B, N, N, N) -> A[b, k, j]\n        \n        ik_feat = ik.expand(B, N, N, N)\n        kj_feat = kj.expand(B, N, N, N)\n        sum_feat = ik_feat + kj_feat\n        \n        feat = torch.stack([ik_feat, kj_feat, sum_feat], dim=-1) # (B, N, N, N, 3)\n        return self.net(feat).squeeze(-1)\n\nmodel = ImprovedModel().to(DEVICE)\nopt = torch.optim.Adam(model.parameters(), lr=1e-3)\nlossf = nn.CrossEntropyLoss()\n\nX, Y = torch.tensor(A_tr), torch.tensor(Pi_tr)\nfor epoch in range(epochs):\n    model.train()\n    perm = torch.randperm(len(X))\n    total, nb = 0.0, 0\n    for i in range(0, len(X), 32):\n        idx = perm[i:i + 32]\n        xb, yb = X[idx].to(DEVICE), Y[idx].to(DEVICE)\n        opt.zero_grad()\n        logits = model(xb)                            # (B, N, N, N)\n        loss = lossf(logits.reshape(-1, N_tr), yb.reshape(-1))\n        loss.backward()\n        opt.step()\n        total += loss.item(); nb += 1\n    print(f'epoch {epoch} loss {total / max(nb, 1):.4f}')\n\nmodel.eval()\nrows = []\nwith torch.no_grad():\n    for g in range(len(A_te)):\n        pred = model(torch.tensor(A_te[g:g + 1]).to(DEVICE)).argmax(-1)[0].cpu().numpy()\n        for r in range(N_te):\n            rows.append({'graph_id': g, 'row': r, \n                         'pointers': ' '.join(str(int(v)) for v in pred[r])})\npd.DataFrame(rows).to_csv('submission.csv', index=False)\nprint('wrote submission.csv')\nEOF\n"]
[100.096337, "o", "cat <<EOF > train.py\r\nimport numpy as np\r\nimport pandas as pd\r\nimport torch\r\nimport torch.nn as nn\r\n\r\nDEVICE = ('cuda' if torch.cuda.is_available()\r\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\r\nprint('DEVICE=', DEVICE)\r\n\r\ntr = np.load('train.npz')\r\nte = np.load('test.npz')\r\nA_tr, Pi_tr = tr['A'].astype(np.float32), tr['Pi'].astype(np.int64)\r\nA_te = te['A'].astype(np.float32)\r\nN_tr, N_te = A_tr.shape[1], A_te.shape[1]\r\n\r\nepochs = 20\r\n\r\nclass ImprovedModel(nn.Module):\r\n    def __init__(self, hidden=64):\r\n        super().__init__()\r\n        self.net = nn.Sequential(\r\n            nn.Linear(3, hidden),\r\n            nn.ReLU(),\r\n            nn.Linear(hidden, hidden),\r\n            nn.ReLU(),\r\n            nn.Linear(hidden, 1)\r\n        )\r\n\r\n    def forward(self, A):\r\n        B, N, _ = A.shape\r\n        # A is (B, N, N)\r\n        # We want features for each (i, j, k)\r\n        # ik: A[b, i, k], kj: A[b, k, j]\r\n        ik = A.unsqueeze(2).expand(B, N, N, N) # (B, i, j, k)\r\n        kj = A.unsqueeze(1).transpose(2, 3).expand(B, N, N, N) # (B, i, j, k)\r\n        \r\n        # The baseline had an error in transpose/expand logic for kj\r\n        # Let's fix it: we want A[b, k, j]\r\n        # A is (B, N, N). A[b, k, j] means k is the 2nd dim, j is 3rd.\r\n        # To get (B, i, j, k), we can do:\r\n        # A_expanded = A.unsqueeze(1) # (B, 1, N, N) -> (B, i, k, j)\r\n        # kj = A_expanded.expand(B, N, N, N) # (B, i, k, j)\r\n        # Wait, the original Baseline code: \r\n        # ik = A.unsqueeze(2).expand(B, N, N, N) -> A[b, i, k] expanded over j\r\n        # kj = A.unsqueeze(1).transpose(2, 3).expand(B, N, N, N) -> \r\n        #   A.unsqueeze(1) is (B, 1, N, N) -> A[b, k, j]\r\n        #   transpose(2, 3) makes it (B, 1, N, N) - wait, no.\r\n        \r\n        # Let's redo the feature extraction cleanly:\r\n        # We need A[b, i, k] and A[b, k, j] for all i, j, k\r\n        # A: (B, N, N)\r\n        # i_idx = torch.arange(N).view(N, 1, 1)\r\n        # j_idx = torch.arange(N).view(1, N, 1)\r\n        # k_idx = torch.arange(N).view(1, 1, N)\r\n        # This is too memory intensive.\r\n        \r\n        # Alternative: Use broadcasting\r\n        # A[b, i, k] -> A.unsqueeze(2) is (B, N, 1, N). Broadcast to (B, N, N, N)\r\n        # A[b, k, j] -> A.unsqueeze(1) is (B, 1, N, N). Broadcast to (B, N, N, N)\r\n        \r\n        ik = A.unsqueeze(2) # (B, N, 1, N) -> A[b, i, k]\r\n        kj = A.unsqueeze(1) # (B, 1, N, N) -> A[b, k, j]\r\n        \r\n        # Now ik is (B, N, 1, N), kj is (B, 1, N, N)\r\n        # To get (B, N, N, N) where dims are (batch, i, j, k):\r\n        # ik_feat: (B, N, 1, N) broadcast to (B, N, N, N) -> A[b, i, k]\r\n        # kj_feat: (B, 1, N, N) broadcast to (B, N, N, N) -> A[b, k, j]\r\n        \r\n        ik_feat = ik.expand(B, N, N, N)\r\n        kj_feat = kj.expand(B, N, N, N)\r\n        sum_feat = ik_feat + kj_feat\r\n        \r\n        feat = torch.stack([ik_feat, kj_feat, sum_feat], dim=-1) # (B, N, N, N, 3)\r\n        return self.net(feat).squeeze(-1)\r\n\r\nmodel = ImprovedModel().to(DEVICE)\r\nopt = torch.optim.Adam(model.parameters(), lr=1e-3)\r\nlossf = nn.CrossEntropyLoss()\r\n\r\nX, Y = torch.tensor(A_tr), torch.tensor(Pi_tr)\r\nfor epoch in range(epochs):\r\n    model.train()\r\n    perm = torch.randperm(len(X))\r\n    total, nb = 0.0, 0\r\n    for i in range(0, len(X), 32):\r\n        idx = perm[i:i + 32]\r\n        xb, yb = X[idx].to(DEVICE), Y[idx].to(DEVICE)\r\n        opt.zero_grad()\r\n        logits = model(xb)                            # (B, N, N, N)\r\n        loss = lossf(logits.reshape(-1, N_tr), yb.reshape(-1))\r\n        loss.backward()\r\n        opt.step()\r\n        total += loss.item(); nb += 1\r\n    print(f'epoch {epoch} loss {total / max(nb, 1):.4f}')\r\n\r\nmodel.eval()\r\nrows = []\r\nwith torch.no_grad():\r\n    for g in range(len(A_te)):\r\n        pred = model(torch.tensor(A_te[g:g + 1]).to(DEVICE)).argmax(-1)[0].cpu().numpy()\r\n        for r in range(N_te):\r\n            rows.append({'graph_id': g, 'row': r, \r\n                         'pointers': ' '.join(str(int(v)) for v in pred[r])})\r\npd.DataFrame(rows).to_csv('submission.csv', index=False)\r\nprint('wrote su"]
