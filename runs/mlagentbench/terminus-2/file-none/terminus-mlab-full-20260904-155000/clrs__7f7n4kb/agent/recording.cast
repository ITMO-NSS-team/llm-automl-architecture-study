[812.7868, "o", "\u001b[?2004h> "]
[812.786897, "o", "            nn.ReLU(),\r\n\u001b[?2004l\r"]
[812.786915, "o", "\u001b[?2004h> "]
[812.787051, "o", "            nn.Linear(hidden, 1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[812.787073, "o", "> "]
[812.787123, "o", "        )\r\n\u001b[?2004l\r"]
[812.787139, "o", "\u001b[?2004h"]
[812.787158, "o", "> "]
[812.787232, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[812.78735, "o", "    def forward(self, A):\r\n\u001b[?2004l\r"]
[812.78738, "o", "\u001b[?2004h"]
[812.787398, "o", "> "]
[812.787512, "o", "        B, N, _ = A.shape\r\n\u001b[?2004l\r"]
[812.787545, "o", "\u001b[?2004h> "]
[812.787643, "o", "        # A is (B, N, N)\r\n\u001b[?2004l\r"]
[812.787665, "o", "\u001b[?2004h> "]
[812.787826, "o", "        # We want features for each (i, j, k)\r\n\u001b[?2004l\r"]
[812.787859, "o", "\u001b[?2004h> "]
[812.788011, "o", "        # ik: A[b, i, k], kj: A[b, k, j]\r\n\u001b[?2004l\r"]
[812.788032, "o", "\u001b[?2004h> "]
[812.788226, "o", "        ik = A.unsqueeze(2).expand(B, N, N, N) # (B, i, j, k)\r\n\u001b[?2004l\r"]
[812.788246, "o", "\u001b[?2004h> "]
[812.788497, "o", "        kj = A.unsqueeze(1).transpose(2, 3).expand(B, N, N, N) # (B, i, j, k)\r\n\u001b[?2004l\r"]
[812.788533, "o", "\u001b[?2004h> "]
[812.788561, "o", "        \r\n"]
[812.788605, "o", "\u001b[?2004l\r"]
[812.788623, "o", "\u001b[?2004h> "]
[812.788864, "o", "        # The baseline had an error in transpose/expand logic for kj\r\n\u001b[?2004l\r"]
[812.788899, "o", "\u001b[?2004h> "]
[812.78904, "o", "        # Let's fix it: we want A[b, k, j]\r\n\u001b[?2004l\r"]
[812.78906, "o", "\u001b[?2004h> "]
[812.789279, "o", "        # A is (B, N, N). A[b, k, j] means k is the 2nd dim, j is 3rd.\r\n\u001b[?2004l\r"]
[812.789323, "o", "\u001b[?2004h> "]
[812.789466, "o", "        # To get (B, i, j, k), we can do:\r\n\u001b[?2004l\r"]
[812.789504, "o", "\u001b[?2004h> "]
[812.78971, "o", "        # A_expanded = A.unsqueeze(1) # (B, 1, N, N) -> (B, i, k, j)\r\n\u001b[?2004l\r"]
[812.789743, "o", "\u001b[?2004h> "]
[812.78992, "o", "        # kj = A_expanded.expand(B, N, N, N) # (B, i, k, j)\r\n\u001b[?2004l\r"]
[812.789948, "o", "\u001b[?2004h> "]
[812.79009, "o", "        # Wait, the original Baseline code: \r\n\u001b[?2004l\r"]
[812.790117, "o", "\u001b[?2004h> "]
[812.790343, "o", "        # ik = A.unsqueeze(2).expand(B, N, N, N) -> A[b, i, k] expanded over j\r\n\u001b[?2004l\r"]
[812.790375, "o", "\u001b[?2004h> "]
[812.790571, "o", "        # kj = A.unsqueeze(1).transpose(2, 3).expand(B, N, N, N) -> \r\n\u001b[?2004l\r"]
[812.79061, "o", "\u001b[?2004h> "]
[812.790799, "o", "        #   A.unsqueeze(1) is (B, 1, N, N) -> A[b, k, j]\r\n\u001b[?2004l\r"]
[812.79082, "o", "\u001b[?2004h> "]
[812.791016, "o", "        #   transpose(2, 3) makes it (B, 1, N, N) - wait, no.\r\n\u001b[?2004l\r"]
[812.791035, "o", "\u001b[?2004h> "]
[812.791097, "o", "        \r\n\u001b[?2004l\r"]
[812.791112, "o", "\u001b[?2004h"]
[812.791129, "o", "> "]
[812.791331, "o", "        # Let's redo the feature extraction cleanly:\r\n\u001b[?2004l\r"]
[812.791362, "o", "\u001b[?2004h> "]
[812.791541, "o", "        # We need A[b, i, k] and A[b, k, j] for all i, j, k\r\n\u001b[?2004l\r"]
[812.791557, "o", "\u001b[?2004h> "]
[812.791669, "o", "        # A: (B, N, N)\r\n\u001b[?2004l\r"]
[812.791704, "o", "\u001b[?2004h> "]
[812.791852, "o", "        # i_idx = torch.arange(N).view(N, 1, 1)\r\n\u001b[?2004l\r"]
[812.791878, "o", "\u001b[?2004h> "]
[812.792027, "o", "        # j_idx = torch.arange(N).view(1, N, 1)\r\n\u001b[?2004l\r"]
[812.792053, "o", "\u001b[?2004h> "]
[812.792201, "o", "        # k_idx = torch.arange(N).view(1, 1, N)\r\n\u001b[?2004l\r"]
[812.792229, "o", "\u001b[?2004h> "]
[812.792367, "o", "        # This is too memory intensive.\r\n\u001b[?2004l\r"]
[812.792407, "o", "\u001b[?2004h> "]
[812.792434, "o", "        \r\n\u001b[?2004l\r"]
[812.792447, "o", "\u001b[?2004h"]
[812.792496, "o", "> "]
[812.792652, "o", "        # Alternative: Use broadcasting\r\n\u001b[?2004l\r"]
[812.79269, "o", "\u001b[?2004h> "]
[812.792925, "o", "        # A[b, i, k] -> A.unsqueeze(2) is (B, N, 1, N). Broadcast to (B, N, N, N)\r\n\u001b[?2004l\r"]
[812.792942, "o", "\u001b[?2004h> "]
[812.793194, "o", "        # A[b, k, j] -> A.unsqueeze(1) is (B, 1, N, N). Broadcast to (B, N, N, N)\r\n\u001b[?2004l\r"]
[812.793222, "o", "\u001b[?2004h> "]
[812.793271, "o", "        \r\n\u001b[?2004l\r"]
[812.79329, "o", "\u001b[?2004h"]
[812.793319, "o", "> "]
[812.793527, "o", "        ik = A.unsqueeze(2) # (B, N, 1, N) -> A[b, i, k]\r\n\u001b[?2004l\r"]
[812.793561, "o", "\u001b[?2004h> "]
[812.79375, "o", "        kj = A.unsqueeze(1) # (B, 1, N, N) -> A[b, k, j]\r\n\u001b[?2004l\r\u001b[?2004h"]
[812.793768, "o", "> "]
[812.793818, "o", "        \r\n\u001b[?2004l\r"]
[812.793835, "o", "\u001b[?2004h> "]
[812.794023, "o", "        # Now ik is (B, N, 1, N), kj is (B, 1, N, N)\r\n\u001b[?2004l\r"]
[812.794051, "o", "\u001b[?2004h> "]
[812.794233, "o", "        # To get (B, N, N, N) where dims are (batch, i, j, k):\r\n\u001b[?2004l\r"]
[812.794254, "o", "\u001b[?2004h> "]
[812.794426, "o", "        # ik_feat: (B, N, 1, N) broadcast to (B, N, N, N) -> A[b, i, k]\r\n\u001b[?2004l\r"]
[812.794444, "o", "\u001b[?2004h> "]
[812.794544, "o", "        # kj_feat: (B, 1, N, N) broadcast to (B, N, N, N) -> A[b, k, j]"]
[812.794589, "o", "\r\n\u001b[?2004l\r"]
[812.794626, "o", "\u001b[?2004h> "]
[812.794673, "o", "        "]
[812.794709, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[812.79473, "o", "> "]
[812.794801, "o", "        ik_feat = ik.expand(B, N, N, N)"]
[812.794848, "o", "\r\n\u001b[?2004l\r"]
[812.794864, "o", "\u001b[?2004h> "]
[812.794932, "o", "        kj_feat = kj.expand(B, N, N, N)"]
[812.794965, "o", "\r\n"]
[812.794985, "o", "\u001b[?2004l\r"]
[812.795003, "o", "\u001b[?2004h> "]
[812.795086, "o", "        sum_feat = ik_feat + kj_feat"]
[812.79511, "o", "\r\n\u001b[?2004l\r"]
[812.795154, "o", "\u001b[?2004h"]
[812.79517, "o", ">         "]
[812.795215, "o", "\r\n\u001b[?2004l\r"]
[812.795231, "o", "\u001b[?2004h"]
[812.795248, "o", "> "]
[812.795384, "o", "        feat = torch.stack([ik_feat, kj_feat, sum_feat], dim=-1) # (B, N, N, N, 3)"]
[812.795439, "o", "\r\n\u001b[?2004l\r"]
[812.795473, "o", "\u001b[?2004h> "]
[812.795556, "o", "        return self.net(feat).squeeze(-1)\r\n\u001b[?2004l\r"]
[812.795577, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[812.795616, "o", "\u001b[?2004h"]
[812.795632, "o", "> "]
[812.795693, "o", "model = ImprovedModel().to(DEVICE)"]
[812.795754, "o", "\r\n\u001b[?2004l\r"]
[812.795787, "o", "\u001b[?2004h"]
[812.795804, "o", "> "]
[812.795884, "o", "opt = torch.optim.Adam(model.parameters(), lr=1e-3)"]
[812.79593, "o", "\r\n\u001b[?2004l\r"]
[812.795946, "o", "\u001b[?2004h> "]
[812.796003, "o", "lossf = nn.CrossEntropyLoss()"]
[812.79606, "o", "\r\n\u001b[?2004l\r"]
[812.7961, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[812.796121, "o", "> "]
[812.796222, "o", "X, Y = torch.tensor(A_tr), torch.tensor(Pi_tr)\r\n\u001b[?2004l\r"]
[812.796238, "o", "\u001b[?2004h> "]
[812.79629, "o", "for epoch in range(epochs):"]
[812.79633, "o", "\r\n"]
[812.796347, "o", "\u001b[?2004l\r\u001b[?2004h"]
[812.796367, "o", "> "]
[812.796429, "o", "    model.train()\r\n\u001b[?2004l\r"]
[812.796446, "o", "\u001b[?2004h"]
[812.796471, "o", "> "]
[812.796542, "o", "    perm = torch.randperm(len(X))"]
[812.796589, "o", "\r\n\u001b[?2004l\r"]
[812.796605, "o", "\u001b[?2004h> "]
[812.796663, "o", "    total, nb = 0.0, 0"]
[812.796705, "o", "\r\n\u001b[?2004l\r"]
[812.796727, "o", "\u001b[?2004h> "]
[812.796788, "o", "    for i in range(0, len(X), 32):"]
[812.796838, "o", "\r\n\u001b[?2004l\r"]
[812.796854, "o", "\u001b[?2004h> "]
[812.796914, "o", "        idx = perm[i:i + 32]"]
[812.796944, "o", "\r\n\u001b[?2004l\r"]
[812.79696, "o", "\u001b[?2004h"]
[812.796995, "o", "> "]
[812.797076, "o", "        xb, yb = X[idx].to(DEVICE), Y[idx].to(DEVICE)"]
[812.797123, "o", "\r\n\u001b[?2004l\r"]
[812.797139, "o", "\u001b[?2004h> "]
[812.797189, "o", "        opt.zero_grad()"]
[812.797221, "o", "\r\n\u001b[?2004l\r"]
[812.797254, "o", "\u001b[?2004h"]
[812.79727, "o", "> "]
[812.797406, "o", "        logits = model(xb)                            # (B, N, N, N)\r\n\u001b[?2004l\r"]
[812.797426, "o", "\u001b[?2004h> "]
[812.79752, "o", "        loss = lossf(logits.reshape(-1, N_tr), yb.reshape(-1))"]
[812.797564, "o", "\r\n\u001b[?2004l\r"]
[812.797598, "o", "\u001b[?2004h> "]
[812.797652, "o", "        loss.backward()"]
[812.797695, "o", "\r\n\u001b[?2004l\r"]
[812.797716, "o", "\u001b[?2004h> "]
[812.797773, "o", "        opt.step()\r\n"]
[812.797808, "o", "\u001b[?2004l\r"]
[812.797825, "o", "\u001b[?2004h> "]
[812.797903, "o", "        total += loss.item(); nb += 1"]
[812.797947, "o", "\r\n\u001b[?2004l\r"]
[812.797962, "o", "\u001b[?2004h> "]
[812.798051, "o", "    print(f'epoch {epoch} loss {total / max(nb, 1):.4f}')"]
[812.798093, "o", "\r\n\u001b[?2004l\r"]
[812.798132, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[812.798167, "o", "\u001b[?2004h"]
[812.798183, "o", "> "]
[812.798214, "o", "model.eval()\r\n"]
[812.798233, "o", "\u001b[?2004l\r"]
[812.798267, "o", "\u001b[?2004h"]
[812.798282, "o", "> "]
[812.79831, "o", "rows = []\r\n"]
[812.798392, "o", "\u001b[?2004l\r\u001b[?2004h"]
[812.798409, "o", "> "]
[812.798428, "o", "with torch.no_grad():"]
[812.798484, "o", "\r\n\u001b[?2004l\r"]
[812.798531, "o", "\u001b[?2004h"]
[812.798547, "o", "> "]
[812.798583, "o", "    for g in range(len(A_te)):"]
[812.798661, "o", "\r\n\u001b[?2004l\r"]
[812.798683, "o", "\u001b[?2004h> "]
[812.798802, "o", "        pred = model(torch.tensor(A_te[g:g + 1]).to(DEVICE)).argmax(-1)[0].cpu().numpy()"]
[812.79886, "o", "\r\n\u001b[?2004l\r"]
[812.798898, "o", "\u001b[?2004h> "]
[812.798969, "o", "        for r in range(N_te):"]
[812.79899, "o", "\r\n\u001b[?2004l\r"]
[812.799008, "o", "\u001b[?2004h> "]
[812.799106, "o", "            rows.append({'graph_id': g, 'row': r, "]
[812.799154, "o", "\r\n\u001b[?2004l\r"]
[812.799175, "o", "\u001b[?2004h> "]
[812.79929, "o", "                         'pointers': ' '.join(str(int(v)) for v in pred[r])})"]
[812.799345, "o", "\r\n\u001b[?2004l\r"]
[812.799379, "o", "\u001b[?2004h> "]
[812.799479, "o", "pd.DataFrame(rows).to_csv('submission.csv', index=False)\r\n\u001b[?2004l\r"]
[812.799517, "o", "\u001b[?2004h> "]
[812.799599, "o", "print('wrote submission.csv')\r\n\u001b[?2004l\r\u001b[?2004h"]
[812.799633, "o", "> EOF\r\n"]
