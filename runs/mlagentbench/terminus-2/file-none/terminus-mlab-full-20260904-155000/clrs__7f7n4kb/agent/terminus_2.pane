cat <<EOF > train.py
import numpy as np
import pandas as pd
import torch
import torch.nn as nn

DEVICE = ('cuda' if torch.cuda.is_available()
          else 'mps' if torch.backends.mps.is_available() else 'cpu')
print('DEVICE=', DEVICE)

tr = np.load('train.npz')
te = np.load('test.npz')
A_tr, Pi_tr = tr['A'].astype(np.float32), tr['Pi'].astype(np.int64)
A_te = te['A'].astype(np.float32)
N_tr, N_te = A_tr.shape[1], A_te.shape[1]

epochs = 20

class ImprovedModel(nn.Module):
    def __init__(self, hidden=64):
        super().__init__()
        self.net = nn.Sequential(
            nn.Linear(3, hidden),
            nn.ReLU(),
            nn.Linear(hidden, hidden),
            nn.ReLU(),
            nn.Linear(hidden, 1)
        )

    def forward(self, A):
        B, N, _ = A.shape
        # A is (B, N, N)
        # We want features for each (i, j, k)
        # ik: A[b, i, k], kj: A[b, k, j]
        ik = A.unsqueeze(2).expand(B, N, N, N) # (B, i, j, k)
        kj = A.unsqueeze(1).transpose(2, 3).expand(B, N, N, N) # (B, i, j, k)
        
        # The baseline had an error in transpose/expand logic for kj
        # Let's fix it: we want A[b, k, j]
        # A is (B, N, N). A[b, k, j] means k is the 2nd dim, j is 3rd.
        # To get (B, i, j, k), we can do:
        # A_expanded = A.unsqueeze(1) # (B, 1, N, N) -> (B, i, k, j)
        # kj = A_expanded.expand(B, N, N, N) # (B, i, k, j)
        # Wait, the original Baseline code: 
        # ik = A.unsqueeze(2).expand(B, N, N, N) -> A[b, i, k] expanded over j
        # kj = A.unsqueeze(1).transpose(2, 3).expand(B, N, N, N) -> 
        #   A.unsqueeze(1) is (B, 1, N, N) -> A[b, k, j]
        #   transpose(2, 3) makes it (B, 1, N, N) - wait, no.
        
        # Let's redo the feature extraction cleanly:
        # We need A[b, i, k] and A[b, k, j] for all i, j, k
        # A: (B, N, N)
        # i_idx = torch.arange(N).view(N, 1, 1)
        # j_idx = torch.arange(N).view(1, N, 1)
        # k_idx = torch.arange(N).view(1, 1, N)
        # This is too memory intensive.
        
        # Alternative: Use broadcasting
        # A[b, i, k] -> A.unsqueeze(2) is (B, N, 1, N). Broadcast to (B, N, N, N)
        # A[b, k, j] -> A.unsqueeze(1) is (B, 1, N, N). Broadcast to (B, N, N, N)
        
        ik = A.unsqueeze(2) # (B, N, 1, N) -> A[b, i, k]
        kj = A.unsqueeze(1) # (B, 1, N, N) -> A[b, k, j]
        
        # Now ik is (B, N, 1, N), kj is (B, 1, N, N)
        # To get (B, N, N, N) where dims are (batch, i, j, k):
        # ik_feat: (B, N, 1, N) broadcast to (B, N, N, N) -> A[b, i, k]
        # kj_feat: (B, 1, N, N) broadcast to (B, N, N, N) -> A[b, k, j]
        
        ik_feat = ik.expand(B, N, N, N)
        kj_feat = kj.expand(B, N, N, N)
        sum_feat = ik_feat + kj_feat
        
        feat = torch.stack([ik_feat, kj_feat, sum_feat], dim=-1) # (B, N, N, N, 3)
        return self.net(feat).squeeze(-1)

model = ImprovedModel().to(DEVICE)
opt = torch.optim.Adam(model.parameters(), lr=1e-3)
lossf = nn.CrossEntropyLoss()

X, Y = torch.tensor(A_tr), torch.tensor(Pi_tr)
for epoch in range(epochs):
    model.train()
    perm = torch.randperm(len(X))
    total, nb = 0.0, 0
    for i in range(0, len(X), 32):
        idx = perm[i:i + 32]
        xb, yb = X[idx].to(DEVICE), Y[idx].to(DEVICE)
        opt.zero_grad()
        logits = model(xb)                            # (B, N, N, N)
        loss = lossf(logits.reshape(-1, N_tr), yb.reshape(-1))
        loss.backward()
        opt.step()
        total += loss.item(); nb += 1
    print(f'epoch {epoch} loss {total / max(nb, 1):.4f}')

model.eval()
rows = []
with torch.no_grad():
    for g in range(len(A_te)):
        pred = model(torch.tensor(A_te[g:g + 1]).to(DEVICE)).argmax(-1)[0].cpu().numpy()
        for r in range(N_te):
            rows.append({'graph_id': g, 'row': r, 
                         'pointers': ' '.join(str(int(v)) for v in pred[r])})
pd.DataFrame(rows).to_csv('submission.csv', index=False)
print('wrote submission.csv')
