[160.70952, "o", "    total_loss = 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[160.709636, "o", ">     for x, y in train_loader:"]
[160.709697, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>         x, y = x.to(DEVICE), y.to(DEVICE)"]
[160.70977, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[160.709863, "o", ">         opt.zero_grad()"]
[160.70991, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>         pred = model(x)"]
[160.709981, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.710058, "o", "        loss = lossf(pred, y)"]
[160.710112, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>         loss.backward()"]
[160.710166, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.710239, "o", "        opt.step()\r\n\u001b[?2004l\r\u001b[?2004h"]
[160.710288, "o", ">         total_loss += loss.item()"]
[160.710399, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.710444, "o", "    print(f'epoch {epoch} loss {total_loss/len(train_loader):.4f}')"]
[160.710508, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[160.710565, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.710629, "o", "def rle(mask):\r\n\u001b[?2004l\r\u001b[?2004h"]
[160.710693, "o", ">     flat = mask.reshape(-1)"]
[160.710759, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.710833, "o", "    if flat.sum() == 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.710923, "o", "        return ''\r\n\u001b[?2004l\r\u001b[?2004h"]
[160.710979, "o", ">     d = np.diff(np.concatenate([[0], flat, [0]]))"]
[160.711069, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.711126, "o", "    starts, ends = np.where(d == 1)[0], np.where(d == -1)[0]"]
[160.711222, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.711276, "o", "    return ' '.join(f'{s} {e - s}' for s, e in zip(starts, ends))"]
[160.71132, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[160.711374, "o", "\u001b[?2004h> "]
[160.711437, "o", "model.eval()\r\n\u001b[?2004l\r\u001b[?2004h"]
[160.711497, "o", "> rows = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.711573, "o", "with torch.no_grad():"]
[160.711619, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     for rid in test_ids:"]
[160.711684, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.711735, "o", "        rec_dir = f'test/{rid}'"]
[160.711854, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[160.711905, "o", "        b11 = np.load(f'{rec_dir}/band_11.npy').astype(np.float32)"]
[160.712014, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[160.712058, "o", ">         b14 = np.load(f'{rec_dir}/band_14.npy').astype(np.float32)"]
[160.712173, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[160.712217, "o", ">         b15 = np.load(f'{rec_dir}/band_15.npy').astype(np.float32)"]
[160.71226, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[160.712356, "o", "> "]
[160.712385, "o", "        x = np.stack([b11[..., 1], b14[..., 1], b15[..., 1]], axis=0)"]
[160.71241, "o", "\r\n"]
[160.71255, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[160.712605, "o", "        x = (x - x.mean()) / (x.std() + 1e-6)"]
[160.712695, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[160.712741, "o", ">         x = torch.tensor(x).unsqueeze(0).to(DEVICE)"]
[160.712856, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[160.71292, "o", ">         pred = torch.sigmoid(model(x)).squeeze().cpu().numpy() > 0.5"]
[160.713054, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[160.713085, "o", ">         rows.append({'record_id': rid, 'rle': rle(pred.astype(np.uint8))})"]
[160.713109, "o", "\r\n"]
[160.713252, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[160.713296, "o", "\u001b[?2004h> pd.DataFrame(rows).to_csv('submission.csv', index=False)"]
[160.713362, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[160.713457, "o", "> "]
[160.713665, "o", "print('wrote submission.csv')\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
