[160.705393, "o", "        \r\n\u001b[?2004l\r"]
[160.705507, "o", "\u001b[?2004h>         # Simple normalization"]
[160.705568, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>         x = (x - x.mean()) / (x.std() + 1e-6)"]
