[160.718396, "o", "root@b24d8579ac9b:/workspace# "]
[160.810433, "i", "python3 train.py\n"]
[160.813016, "o", "python3 train.py\r\n\u001b[?2004l\r"]
[161.799563, "o", "DEVICE= cpu\r\n"]
[163.052913, "o", "Traceback (most recent call last):\r\n  File \"/workspace/train.py\", line 81, in <module>\r\n    loss = lossf(pred, y)\r\n           ^^^^^^^^^^^^^^\r\n  File \"/usr/local/lib/python3.12/site-packages/torch/nn/modules/module.py\", line 1511, in _wrapped_call_impl\r\n"]
[163.057491, "o", "    return self._call_impl(*args, **kwargs)\r\n           ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\r\n  File \"/usr/local/lib/python3.12/site-packages/torch/nn/modules/module.py\", line 1520, in _call_impl\r\n    return forward_call(*args, **kwargs)\r\n           ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\r\n  File \"/usr/local/lib/python3.12/site-packages/torch/nn/modules/loss.py\", line 725, in forward\r\n"]
[163.072487, "o", "    return F.binary_cross_entropy_with_logits(input, target,\r\n           ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\r\n  File \"/usr/local/lib/python3.12/site-packages/torch/nn/functional.py\", line 3197, in binary_cross_entropy_with_logits\r\n    raise ValueError(f\"Target size ({target.size()}) must be the same as input size ({input.size()})\")\r\nValueError: Target size (torch.Size([8, 256, 256])) must be the same as input size (torch.Size([8, 1, 256, 256]))\r\n"]
[163.482794, "o", "\u001b[?2004hroot@b24d8579ac9b:/workspace# "]
[257.80377, "i", "cat << 'EOF' > train.py\nimport os\nimport numpy as np\nimport pandas as pd\nimport torch\nimport torch.nn as nn\nimport torch.nn.functional as F\nfrom torch.utils.data import Dataset, DataLoader\n\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\nclass ContrailDataset(Dataset):\n    def __init__(self, ids, root='train', is_test=False):\n        self.ids = ids\n        self.root = root\n        self.is_test = is_test\n\n    def __len__(self):\n        return len(self.ids)\n\n    def __getitem__(self, idx):\n        rid = self.ids[idx]\n        rec_dir = os.path.join(self.root, rid)\n        \n        b11 = np.load(f'{rec_dir}/band_11.npy').astype(np.float32)\n        b14 = np.load(f'{rec_dir}/band_14.npy').astype(np.float32)\n        b15 = np.load(f'{rec_dir}/band_15.npy').astype(np.float32)\n        \n        x = np.stack([b11[..., 1], b14[..., 1], b15[..., 1]], axis=0)\n        x = (x - x.mean()) / (x.std() + 1e-6)\n        x = torch.tensor(x)\n\n        if self.is_test:\n            return rid, x\n        \n        m = np.load(f'{rec_dir}/human_pixel_masks.npy').astype(np.float32).squeeze()\n        y = torch.tensor(m)\n        return x, y\n\nclass SimpleConvNet(nn.Module):\n    def __init__(self):\n        super().__init__()\n        self.net = nn.Sequential(\n            nn.Conv2d(3, 16, 3, padding=1),\n            nn.ReLU(),\n            nn.Conv2d(16, 16, 3, padding=1),\n            nn.ReLU(),\n            nn.Conv2d(16, 1, 1)\n        )\n    def forward(self, x):\n        return self.net(x)\n\ntrain_ids = sorted(os.listdir('train'))\ntest_ids = sorted(os.listdir('test'))\n\nsplit = int(0.9 * len(train_ids))\ntrain_set = ContrailDataset(train_ids[:split])\nval_set = ContrailDataset(train_ids[split:], root='train')\n\ntrain_loader = DataLoader(train_set, batch_size=8, shuffle=True)\nval_loader = DataLoader(val_set, batch_size=8)\n\nmodel = SimpleConvNet().to(DEVICE)\nopt = torch.optim.Adam(model.parameters(), lr=1e-3)\nlossf = nn.BCEWithLogitsLoss()\n\nepochs = 3\nfor epoch in range(epochs):\n    model.train()\n    total_loss = 0\n    for x, y in train_loader:\n        x, y = x.to(DEVICE), y.to(DEVICE)\n        opt.zero_grad()\n        pred = model(x).squeeze(1)\n        loss = lossf(pred, y)\n        loss.backward()\n        opt.step()\n        total_loss += loss.item()\n    print(f'epoch {epoch} loss {total_loss/len(train_loader):.4f}')\n\ndef rle(mask):\n    flat = mask.reshape(-1)\n    if flat.sum() == 0:\n        return ''\n    d = np.diff(np.concatenate([[0], flat, [0]]))\n    starts, ends = np.where(d == 1)[0], np.where(d == -1)[0]\n    return ' '.join(f'{s} {e - s}' for s, e in zip(starts, ends))\n\nmodel.eval()\nrows = []\nwith torch.no_grad():\n    for rid in test_ids:\n        rec_dir = f'test/{rid}'\n        b11 = np.load(f'{rec_dir}/band_11.npy').astype(np.float32)\n        b14 = np.load(f'{rec_dir}/band_14.npy').astype(np.float32)\n        b15 = np.load(f'{rec_dir}/band_15.npy').astype(np.float32)\n        x = np.stack([b11[..., 1], b14[..., 1], b15[..., 1]], axis=0)\n        x = (x - x.mean()) / (x.std() + 1e-6)\n        x = torch.tensor(x).unsqueeze(0).to(DEVICE)\n        pred = torch.sigmoid(model(x)).squeeze().cpu().numpy() > 0.5\n        rows.append({'record_id': rid, 'rle': rle(pred.astype(np.uint8))})\n\npd.DataFrame(rows).to_csv('submission.csv', index=False)\nprint('wrote submission.csv')\nEOF\n"]
[257.804122, "o", "cat << 'EOF' > train.py\r\n\u001b[?2004l\r"]
[257.804201, "o", "\u001b[?2004h> import os"]
[257.804264, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np"]
[257.804335, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[257.804399, "o", "import pandas as pd\r\n\u001b[?2004l\r\u001b[?2004h> "]
[257.804474, "o", "import torch\r\n\u001b[?2004l\r\u001b[?2004h"]
[257.804567, "o", "> import torch.nn as nn"]
[257.804745, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> import torch.nn.functional as F"]
[257.804825, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> from torch.utils.data import Dataset, DataLoader\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[257.804948, "o", "DEVICE = ('cuda' if torch.cuda.is_available()\r\n"]
[257.804989, "o", "\u001b[?2004l\r\u001b[?2004h>           else 'mps' if torch.backends.mps.is_available() else 'cpu')"]
[257.805016, "o", "\r\n"]
[257.805123, "o", "\u001b[?2004l\r\u001b[?2004h> print('DEVICE=', DEVICE)"]
[257.805169, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[257.805237, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[257.805288, "o", "class ContrailDataset(Dataset):"]
[257.805392, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[257.805439, "o", "    def __init__(self, ids, root='train', is_test=False):"]
[257.805533, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>         self.ids = ids"]
[257.805599, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[257.805673, "o", "        self.root = root\r\n"]
[257.805741, "o", "\u001b[?2004l\r\u001b[?2004h>         self.is_test = is_test"]
[257.805801, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[257.805883, "o", ">     def __len__(self):"]
[257.805932, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>         return len(self.ids)"]
[257.806012, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[257.806067, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     def __getitem__(self, idx):"]
[257.806141, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[257.806237, "o", ">         rid = self.ids[idx]"]
[257.806299, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>         rec_dir = os.path.join(self.root, rid)"]
[257.806458, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>         "]
[257.806532, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[257.806577, "o", "        b11 = np.load(f'{rec_dir}/band_11.npy').astype(np.float32)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[257.80676, "o", "        b14 = np.load(f'{rec_dir}/band_14.npy').astype(np.float32)\r\n"]
[257.806808, "o", "\u001b[?2004l\r\u001b[?2004h>         b15 = np.load(f'{rec_dir}/band_15.npy').astype(np.float32)"]
[257.806837, "o", "\r\n\u001b[?2004l\r"]
[257.806911, "o", "\u001b[?2004h"]
[257.807016, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[257.807082, "o", "        x = np.stack([b11[..., 1], b14[..., 1], b15[..., 1]], axis=0)"]
[257.807131, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[257.807239, "o", "        x = (x - x.mean()) / (x.std() + 1e-6)\r\n"]
[257.807348, "o", "\u001b[?2004l\r\u001b[?2004h>         x = torch.tensor(x)"]
[257.807427, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>         if self.is_test:"]
[257.807629, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>             return rid, x"]
[257.807709, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         m = np.load(f'{rec_dir}/human_pixel_masks.npy').astype(np.float32).squeeze()\r\n\u001b[?2004l\r\u001b[?2004h"]
[257.807779, "o", ">         y = torch.tensor(m)"]
[257.807838, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>         return x, y"]
[257.807915, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[257.807966, "o", "\u001b[?2004h> class SimpleConvNet(nn.Module):"]
[257.808025, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[257.808106, "o", ">     def __init__(self):"]
[257.808194, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>         super().__init__()"]
[257.808241, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>         self.net = nn.Sequential("]
[257.808328, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[257.808377, "o", ">             nn.Conv2d(3, 16, 3, padding=1),"]
[257.808436, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[257.80854, "o", ">             nn.ReLU(),"]
[257.80861, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>             nn.Conv2d(16, 16, 3, padding=1),"]
[257.808663, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[257.808744, "o", "            nn.ReLU(),\r\n\u001b[?2004l\r\u001b[?2004h"]
[257.808801, "o", ">             nn.Conv2d(16, 1, 1)"]
[257.808873, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>         )"]
[257.80893, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     def forward(self, x):"]
[257.808999, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[257.809055, "o", ">         return self.net(x)\r\n"]
[257.809127, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[257.80918, "o", "train_ids = sorted(os.listdir('train'))"]
[257.809252, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[257.809295, "o", "test_ids = sorted(os.listdir('test'))"]
[257.809389, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[257.809427, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> split = int(0.9 * len(train_ids))"]
[257.809535, "o", "\r\n\u001b[?2004l\r"]
[257.809559, "o", "\u001b[?2004h> train_set = ContrailDataset(train_ids[:split])"]
[257.809578, "o", "\r\n"]
[257.809714, "o", "\u001b[?2004l\r"]
[257.809766, "o", "\u001b[?2004h> val_set = ContrailDataset(train_ids[split:], root='train')\r\n\u001b[?2004l\r"]
[257.80988, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[257.809929, "o", "\u001b[?2004h> train_loader = DataLoader(train_set, batch_size=8, shuffle=True)"]
[257.809955, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[257.810051, "o", "> "]
[257.810099, "o", "val_loader = DataLoader(val_set, batch_size=8)"]
[257.810189, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[257.810237, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> model = SimpleConvNet().to(DEVICE)"]
[257.810327, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[257.810372, "o", "opt = torch.optim.Adam(model.parameters(), lr=1e-3)"]
[257.810455, "o", "\r\n\u001b[?2004l\r"]
[257.810504, "o", "\u001b[?2004h> lossf = nn.BCEWithLogitsLoss()"]
[257.810593, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[257.810651, "o", "\u001b[?2004l\r\u001b[?2004h> epochs = 3\r\n\u001b[?2004l\r\u001b[?2004h> "]
[257.810721, "o", "for epoch in range(epochs):"]
[257.810774, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     model.train()"]
[257.810828, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[257.810905, "o", "    total_loss = 0"]
[257.810966, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     for x, y in train_loader:"]
[257.811032, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[257.811086, "o", "        x, y = x.to(DEVICE), y.to(DEVICE)"]
[257.811139, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[257.811224, "o", "        opt.zero_grad()\r\n"]
[257.811277, "o", "\u001b[?2004l\r\u001b[?2004h>         pred = model(x).squeeze(1)"]
[257.81134, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[257.811386, "o", "        loss = lossf(pred, y)"]
[257.811459, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[257.811529, "o", "        loss.backward()\r\n\u001b[?2004l\r"]
[257.811612, "o", "\u001b[?2004h>         opt.step()"]
[257.811661, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>         total_loss += loss.item()"]
[257.811775, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[257.811822, "o", ">     print(f'epoch {epoch} loss {total_loss/len(train_loader):.4f}')"]
[257.811896, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[257.811933, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> def rle(mask):"]
[257.811995, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[257.812058, "o", ">     flat = mask.reshape(-1)"]
[257.812131, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[257.81219, "o", "    if flat.sum() == 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[257.812277, "o", "        return ''\r\n\u001b[?2004l\r\u001b[?2004h"]
[257.812333, "o", ">     d = np.diff(np.concatenate([[0], flat, [0]]))"]
[257.812421, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[257.812491, "o", "    starts, ends = np.where(d == 1)[0], np.where(d == -1)[0]"]
[257.812598, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[257.81266, "o", "    return ' '.join(f'{s} {e - s}' for s, e in zip(starts, ends))"]
[257.812713, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[257.812774, "o", "\u001b[?2004h> "]
[257.812834, "o", "model.eval()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[257.812888, "o", "rows = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[257.812966, "o", "with torch.no_grad():"]
[257.813006, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     for rid in test_ids:"]
[257.813078, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[257.813127, "o", ">         rec_dir = f'test/{rid}'"]
[257.813232, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[257.813278, "o", "        b11 = np.load(f'{rec_dir}/band_11.npy').astype(np.float32)"]
[257.813388, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[257.813428, "o", ">         b14 = np.load(f'{rec_dir}/band_14.npy').astype(np.float32)"]
[257.813503, "o", "\r\n\u001b[?2004l\r"]
[257.813588, "o", "\u001b[?2004h> "]
[257.813623, "o", "        b15 = np.load(f'{rec_dir}/band_15.npy').astype(np.float32)"]
[257.813754, "o", "\r\n"]
[257.813814, "o", "\u001b[?2004l\r\u001b[?2004h>         x = np.stack([b11[..., 1], b14[..., 1], b15[..., 1]], axis=0)"]
[257.813843, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[257.813926, "o", "        x = (x - x.mean()) / (x.std() + 1e-6)"]
[257.814014, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[257.814069, "o", ">         x = torch.tensor(x).unsqueeze(0).to(DEVICE)"]
[257.814167, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[257.81422, "o", "        pred = torch.sigmoid(model(x)).squeeze().cpu().numpy() > 0.5"]
[257.81425, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[257.814375, "o", "        rows.append({'record_id': rid, 'rle': rle(pred.astype(np.uint8))})"]
[257.814488, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[257.814551, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> pd.DataFrame(rows).to_csv('submission.csv', index=False)"]
[257.814602, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[257.814668, "o", "print('wrote submission.csv')\r\n"]
[257.814898, "o", "\u001b[?2004l\r\u001b[?2004h> EOF"]
[257.814962, "o", "\r\n\u001b[?2004l\r"]
