[160.704774, "o", "> "]
[160.704803, "o", "        b15 = np.load(f'{rec_dir}/band_15.npy').astype(np.float32)"]
[160.704842, "o", "\r\n"]
[160.705013, "o", "\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[160.705058, "o", "\u001b[?2004h>         # Labeled frame is at index 1 since shape is (256, 256, 3)"]
[160.705115, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[160.705209, "o", "> "]
[160.705266, "o", "        x = np.stack([b11[..., 1], b14[..., 1], b15[..., 1]], axis=0)"]
