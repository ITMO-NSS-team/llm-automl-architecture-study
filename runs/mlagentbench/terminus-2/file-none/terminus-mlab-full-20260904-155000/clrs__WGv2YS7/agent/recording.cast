[555.788335, "o", "DEVICE= cpu\r\n"]
[599.905065, "i", "cat <<EOF > train_improved.py\nimport numpy as np\nimport pandas as pd\nimport torch\nimport torch.nn as nn\nimport torch.nn.functional as F\n\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\ntr = np.load('train.npz')\nte = np.load('test.npz')\nA_tr, Pi_tr = tr['A'].astype(np.float32), tr['Pi'].astype(np.int64)\nA_te = te['A'].astype(np.float32)\nN_tr, N_te = A_tr.shape[1], A_te.shape[1]\n\nclass ImprovedModel(nn.Module):\n    def __init__(self, hidden=64):\n        super().__init__()\n        self.net = nn.Sequential(\n            nn.Linear(3, hidden),\n            nn.ReLU(),\n            nn.Linear(hidden, hidden),\n            nn.ReLU(),\n            nn.Linear(hidden, 1)\n        )\n\n    def forward(self, A):\n        B, N, _ = A.shape\n        a_ij = A.unsqueeze(-1).expand(B, N, N, N)\n        a_ik = A.unsqueeze(2).expand(B, N, N, N)\n        a_kj = A.transpose(1, 2).unsqueeze(1).expand(B, N, N, N)\n        feat = torch.stack([a_ij, a_ik, a_kj], dim=-1)\n        return self.net(feat).squeeze(-1)\n\nmodel = ImprovedModel().to(DEVICE)\nopt = torch.optim.Adam(model.parameters(), lr=1e-3)\nlossf = nn.CrossEntropyLoss()\n\nX, Y = torch.tensor(A_tr), torch.tensor(Pi_tr)\nepochs = 20\nfor epoch in range(epochs):\n    model.train()\n    perm = torch.randperm(len(X))\n    total, nb = 0.0, 0\n    for i in range(0, len(X), 32):\n        idx = perm[i:i + 32]\n        xb, yb = X[idx].to(DEVICE), Y[idx].to(DEVICE)\n        opt.zero_grad()\n        logits = model(xb)\n        loss = lossf(logits.reshape(-1, N_tr), yb.reshape(-1))\n        loss.backward()\n        opt.step()\n        total += loss.item(); nb += 1\n    print(f'epoch {epoch} loss {total / max(nb, 1):.4f}')\n\nmodel.eval()\nrows = []\nwith torch.no_grad():\n    for g in range(len(A_te)):\n        pred = model(torch.tensor(A_te[g:g + 1]).to(DEVICE)).argmax(-1)[0].cpu().numpy()\n        for r in range(N_te):\n            rows.append({'graph_id': g, 'row': r, 'pointers': ' '.join(str(int(v)) for v in pred[r])})\npd.DataFrame(rows).to_csv('submission.csv', index=False)\nprint('wrote submission.csv')\nEOF\n"]
[599.90929, "o", "cat <<EOF > train_improved.py\r\nimport numpy as np\r\nimport pandas as pd\r\nimport torch\r\nimport torch.nn as nn\r\nimport torch.nn.functional as F\r\n\r\nDEVICE = ('cuda' if torch.cuda.is_available()\r\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\r\nprint('DEVICE=', DEVICE)\r\n\r\ntr = np.load('train.npz')\r\nte = np.load('test.npz')\r\nA_tr, Pi_tr = tr['A'].astype(np.float32), tr['Pi'].astype(np.int64)\r\nA_te = te['A'].astype(np.float32)\r\nN_tr, N_te = A_tr.shape[1], A_te.shape[1]\r\n\r\nclass ImprovedModel(nn.Module):\r\n    def __init__(self, hidden=64):\r\n        super().__init__()\r\n        self.net = nn.Sequential(\r\n            nn.Linear(3, hidden),\r\n            nn.ReLU(),\r\n            nn.Linear(hidden, hidden),\r\n            nn.ReLU(),\r\n            nn.Linear(hidden, 1)\r\n        )\r\n\r\n    def forward(self, A):\r\n        B, N, _ = A.shape\r\n        a_ij = A.unsqueeze(-1).expand(B, N, N, N)\r\n        a_ik = A.unsqueeze(2).expand(B, N, N, N)\r\n        a_kj = A.transpose(1, 2).unsqueeze(1).expand(B, N, N, N)\r\n        feat = torch.stack([a_ij, a_ik, a_kj], dim=-1)\r\n        return self.net(feat).squeeze(-1)\r\n\r\nmodel = ImprovedModel().to(DEVICE)\r\nopt = torch.optim.Adam(model.parameters(), lr=1e-3)\r\nlossf = nn.CrossEntropyLoss()\r\n\r\nX, Y = torch.tensor(A_tr), torch.tensor(Pi_tr)\r\nepochs = 20\r\nfor epoch in range(epochs):\r\n    model.train()\r\n    perm = torch.randperm(len(X))\r\n    total, nb = 0.0, 0\r\n    for i in range(0, len(X), 32):\r\n        idx = perm[i:i + 32]\r\n        xb, yb = X[idx].to(DEVICE), Y[idx].to(DEVICE)\r\n        opt.zero_grad()\r\n        logits = model(xb)\r\n        loss = lossf(logits.reshape(-1, N_tr), yb.reshape(-1))\r\n        loss.backward()\r\n        opt.step()\r\n        total += loss.item(); nb += 1\r\n    print(f'epoch {epoch} loss {total / max(nb, 1):.4f}')\r\n\r\nmodel.eval()\r\nrows = []\r\nwith torch.no_grad():\r\n    for g in range(len(A_te)):\r\n        pred = model(torch.tensor(A_te[g:g + 1]).to(DEVICE)).argmax(-1)[0].cpu().numpy()\r\n        for r in range(N_te):\r\n            rows.append({'graph_id': g, 'row': r, 'pointers': ' '.join(str(int(v)) for v in pred[r])})\r\npd.DataFrame(rows).to_csv('submission.csv', index=False)\r\nprint('wrote submission.csv')\r\nEOF\r\n"]
