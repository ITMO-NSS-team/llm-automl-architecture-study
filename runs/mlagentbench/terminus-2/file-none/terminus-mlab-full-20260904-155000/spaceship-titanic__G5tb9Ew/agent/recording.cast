[110.282705, "o", "\u001b[?2004h> "]
[110.28282, "o", "        print(f\"Epoch {epoch+1}/100, Train Loss: {loss.item():.4f}, Val Loss: {val_loss.item():.4f}\")"]
[110.282864, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.282899, "o", "        model.train()\r\n\u001b[?2004l\r"]
