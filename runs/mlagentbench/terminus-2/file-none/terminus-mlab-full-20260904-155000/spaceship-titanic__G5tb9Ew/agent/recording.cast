[352.440174, "o", "model = nn.Linear(X_train.shape[1], 1).to(DEVICE)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[352.440271, "o", "criterion = nn.BCEWithLogitsLoss()\r\n\u001b[?2004l\r\u001b[?2004h"]
[352.440326, "o", "> "]
[352.440456, "o", "optimizer = optim.Adam(model.parameters(), lr=0.01, weight_decay=0.01)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[352.44051, "o", "model.train()\r\n\u001b[?2004l\r\u001b[?2004h"]
[352.440535, "o", "> "]
[352.440604, "o", "for epoch in range(200):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[352.440654, "o", "    optimizer.zero_grad()\r\n\u001b[?2004l\r"]
[352.440679, "o", "\u001b[?2004h> "]
[352.440742, "o", "    outputs = model(X_train)\r\n\u001b[?2004l\r\u001b[?2004h"]
[352.44079, "o", "> "]
[352.440869, "o", "    loss = criterion(outputs, Y_train)\r\n\u001b[?2004l\r"]
[352.440912, "o", "\u001b[?2004h> "]
[352.44094, "o", "    loss.backward()\r\n\u001b[?2004l\r"]
[352.440968, "o", "\u001b[?2004h> "]
[352.44106, "o", "    optimizer.step()\r\n\u001b[?2004l\r\u001b[?2004h> model.eval()\r\n\u001b[?2004l\r\u001b[?2004h"]
[352.441102, "o", "> "]
[352.441153, "o", "with torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[352.441233, "o", "    train_logits = model(X_train)\r\n\u001b[?2004l\r"]
[352.441284, "o", "\u001b[?2004h> "]
[352.441398, "o", "    train_preds = (torch.sigmoid(train_logits) > 0.5).float()\r\n\u001b[?2004l\r"]
[352.441445, "o", "\u001b[?2004h> "]
[352.441511, "o", "    val_logits = model(X_val)\r\n\u001b[?2004l\r\u001b[?2004h"]
[352.441564, "o", "> "]
[352.441644, "o", "    val_preds = (torch.sigmoid(val_logits) > 0.5).float()\r\n\u001b[?2004l\r"]
[352.441691, "o", "\u001b[?2004h> "]
[352.441745, "o", "    train_accuracy = accuracy_score(Y_train.cpu(), train_preds.cpu())\r\n\u001b[?2004l\r"]
[352.441803, "o", "\u001b[?2004h> "]
[352.441848, "o", "    val_accuracy = accuracy_score(Y_val.cpu(), val_preds.cpu())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[352.441903, "o", "print(f\"Train Accuracy: {train_accuracy}\")\r\n\u001b[?2004l\r"]
[352.44196, "o", "\u001b[?2004h> "]
[352.442015, "o", "print(f\"Validation Accuracy: {val_accuracy}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[352.442067, "o", "X_test_raw = preprocess_data(full_test, is_test=True, train_cols=columns)\r\n\u001b[?2004l\r"]
[352.442135, "o", "\u001b[?2004h> "]
[352.442188, "o", "X_test = torch.tensor(scaler.transform(X_test_raw), dtype=torch.float32).to(DEVICE)\r\n\u001b[?2004l\r\u001b[?2004h"]
[352.442236, "o", "> model.eval()\r\n\u001b[?2004l\r"]
[352.442294, "o", "\u001b[?2004h> with torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[352.442347, "o", "    test_logits = model(X_test)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[352.442416, "o", "    test_preds = (torch.sigmoid(test_logits) > 0.5).float().cpu().numpy().flatten()\r\n\u001b[?2004l\r\u001b[?2004h"]
[352.442463, "o", "> "]
[352.442544, "o", "submission = pd.DataFrame({'PassengerId': full_test['PassengerId'], 'Transported': (test_preds == 1)})\r\n\u001b[?2004l\r"]
[352.442589, "o", "\u001b[?2004h> "]
[352.442644, "o", "submission.to_csv('submission.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h"]
[352.442692, "o", "> EOF\r\n\u001b[?2004l\r"]
