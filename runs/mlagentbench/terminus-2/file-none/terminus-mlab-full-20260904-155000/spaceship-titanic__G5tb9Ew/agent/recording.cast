[110.281138, "o", "> "]
[110.28118, "o", "            nn.Sigmoid()\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.281216, "o", ">         )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.281252, "o", "    def forward(self, x):"]
