[295.353924, "o", "def preprocess_data(df, is_test=False, train_cols=None):\r\n\u001b[?2004l\r\u001b[?2004h>     df = df.copy()\r\n\u001b[?2004l\r\u001b[?2004h>     df[['Deck', 'Cabin_num', 'Side']] = df['Cabin'].str.split('/', expand=True)\r\n\u001b[?2004l\r\u001b[?2004h>     df = df.drop('Cabin', axis=1)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     num_cols = df.select_dtypes(include=[np.number]).columns\r\n\u001b[?2004l\r\u001b[?2004h>     cat_cols = df.select_dtypes(include=['object', 'bool']).columns\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     for col in num_cols:\r\n\u001b[?2004l\r\u001b[?2004h>         df[col] = df[col].fillna(df[col].median())\r\n\u001b[?2004l\r\u001b[?2004h>     for col in cat_cols:\r\n\u001b[?2004l\r\u001b[?2004h>         df[col] = df[col].fillna('Unknown')\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     df = pd.get_dummies(df)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     if is_test and train_cols is not None:\r\n\u001b[?2004l\r\u001b[?2004h>         df = df.reindex(columns=train_cols, fill_value=0)\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h>     return df\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> full_train = pd.read_csv(\"train.csv\")\r\n\u001b[?2004l\r\u001b[?2004h> full_test = pd.read_csv(\"test.csv\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> train_df = full_train.sample(frac=1, random_state=1)\r\n\u001b[?2004l\r\u001b[?2004h> num_examples = len(train_df)\r\n\u001b[?2004l\r\u001b[?2004h> train_data_raw = train_df[0:int(0.8 * num_examples)].copy()\r\n\u001b[?2004l\r\u001b[?2004h> val_data_raw = train_df[int(0.8 * num_examples):].copy()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> TargetY_train = train_data_raw['Transported'].astype(int).values\r\n\u001b[?2004l\r\u001b[?2004h> TargetY_val = val_data_raw['Transported'].astype(int).values\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> train_data_raw = train_data_raw.drop('Transported', axis=1)\r\n\u001b[?2004l\r\u001b[?2004h> val_data_raw = val_data_raw.drop('Transported', axis=1)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> X_train_df = preprocess_data(train_data_raw)\r\n\u001b[?2004l\r\u001b[?2004h> columns = X_train_df.columns\r\n\u001b[?2004l\r\u001b[?2004h> X_val_df = preprocess_data(val_data_raw, is_test=True, train_cols=columns)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> scaler = StandardScaler()\r\n\u001b[?2004l\r\u001b[?2004h> X_train = torch.tensor(scaler.fit_transform(X_train_df), dtype=torch.float32).to(DEVICE)\r\n\u001b[?2004l\r\u001b[?2004h> Y_train = torch.tensor(TargetY_train, dtype=torch.float32).unsqueeze(1).to(DEVICE)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> X_val = torch.tensor(scaler.transform(X_val_df), dtype=torch.float32).to(DEVICE)\r\n\u001b[?2004l\r\u001b[?2004h> Y_val = torch.tensor(TargetY_val, dtype=torch.float32).unsqueeze(1).to(DEVICE)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Use a simple Linear model to avoid overfitting\r\n\u001b[?2004l\r\u001b[?2004h> model = nn.Linear(X_train.shape[1], 1).to(DEVICE)\r\n\u001b[?2004l\r\u001b[?2004h> # Activation added during forward pass for binary classification\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> criterion = nn.BCEWithLogitsLoss()\r\n\u001b[?2004l\r\u001b[?2004h> optimizer = optim.Adam(model.parameters(), lr=0.01, weight_decay=0.01)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> model.train()\r\n\u001b[?2004l\r\u001b[?2004h> for epoch in range(200):\r\n\u001b[?2004l\r\u001b[?2004h>     optimizer.zero_grad()\r\n\u001b[?2004l\r\u001b[?2004h>     outputs = model(X_train)\r\n\u001b[?2004l\r\u001b[?2004h>     loss = criterion(outputs, Y_train)\r\n\u001b[?2004l\r\u001b[?2004h>     loss.backward()\r\n\u001b[?2004l\r\u001b[?2004h>     optimizer.step()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> model.eval()\r\n\u001b[?2004l\r\u001b[?2004h> with torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h>     train_logits = model(X_train)\r\n\u001b[?2004l\r\u001b[?2004h>     train_preds = (torch.sigmoid(train_logits) > 0.5).float()\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     val_logits = model(X_val)\r\n\u001b[?2004l\r\u001b[?2004h>     val_preds = (torch.sigmoid(val_logits) > 0.5).float()\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     train_accuracy = accuracy_score(Y_train.cpu(), train_preds.cpu())\r\n\u001b[?2004l\r\u001b[?2004h>     val_accuracy = accuracy_score(Y_val.cpu(), val_preds.cpu())\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(f\"Train Accuracy: {train_accuracy}\")\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"Validation Accuracy: {val_accuracy}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> X_test_raw = preprocess_data(full_test, is_t"]
[295.353965, "o", "est=True, train_cols=columns)\r\n\u001b[?2004l\r\u001b[?2004h> X_test = torch.tensor(scaler.transform(X_test_raw), dtype=torch.float32).to(DEVICE)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> model.eval()\r\n\u001b[?2004l\r\u001b[?2004h> with torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h>     test_logits = model(X_test)\r\n\u001b[?2004l\r\u001b[?2004h>     test_preds = (torch.sigmoid(test_logits) > 0.5).float().cpu().numpy().flatten()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> submission = pd.DataFrame({\r\n\u001b[?2004l\r\u001b[?2004h>     'PassengerId': full_test['PassengerId'],\r\n\u001b[?2004l\r\u001b[?2004h>     'Transported': (test_preds == 1)\r\n\u001b[?2004l\r\u001b[?2004h> })\r\n\u001b[?2004l\r\u001b[?2004h> submission.to_csv('submission.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h> "]
