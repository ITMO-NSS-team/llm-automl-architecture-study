[110.280255, "o", "class RegularizedMLP(nn.Module):"]
[110.280298, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.28033, "o", ">     def __init__(self, input_dim):"]
[110.28037, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.280409, "o", "> "]
