[243.682686, "o", "\u001b[?2004hroot@863dbe401cd3:/workspace# cat << 'EOF' > train.py\r\n\u001b[?2004l\r\u001b[?2004h> import pandas as pd\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> import torch\r\n\u001b[?2004l\r\u001b[?2004h> import torch.nn as nn\r\n\u001b[?2004l\r\u001b[?2004h> import torch.optim as optim\r\n\u001b[?2004l\r\u001b[?2004h> from sklearn.preprocessing import StandardScaler\r\n\u001b[?2004l\r\u001b[?2004h> from sklearn.metrics import accuracy_score\r\n\u001b[?2004l\r\u001b[?2004h> import copy\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> DEVICE = ('cuda' if torch.cuda.is_available()\r\n\u001b[?2004l\r\u001b[?2004h>           else 'mps' if torch.backends.mps.is_available() else 'cpu')\r\n\u001b[?2004l\r\u001b[?2004h> print('DEVICE=', DEVICE)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def preprocess_data(df, is_test=False, train_cols=None):\r\n\u001b[?2004l\r\u001b[?2004h>     df = df.copy()\r\n\u001b[?2004l\r\u001b[?2004h>     df[['Deck', 'Cabin_num', 'Side']] = df['Cabin'].str.split('/', expand=True)\r\n\u001b[?2004l\r\u001b[?2004h>     df = df.drop('Cabin', axis=1)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[243.683033, "o", "    num_cols = df.select_dtypes(include=[np.number]).columns\r\n\u001b[?2004l\r\u001b[?2004h>     cat_cols = df.select_dtypes(include=['object', 'bool']).columns\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     for col in num_cols:\r\n\u001b[?2004l\r\u001b[?2004h>         df[col] = df[col].fillna(df[col].median())\r\n\u001b[?2004l\r\u001b[?2004h>     for col in cat_cols:\r\n\u001b[?2004l\r\u001b[?2004h>         df[col] = df[col].fillna('Unknown')\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     df = pd.get_dummies(df)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     if is_test and train_cols is not None:\r\n\u001b[?2004l\r\u001b[?2004h>         df = df.reindex(columns=train_cols, fill_value=0)\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h>     return df\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> full_train = pd.read_csv(\"train.csv\")\r\n\u001b[?2004l\r\u001b[?2004h> full_test = pd.read_csv(\"test.csv\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> train_df = full_train.sample(frac=1, random_state=1)\r\n\u001b[?2004l\r\u001b[?2004h> num_examples = len(train_df)\r\n\u001b[?2004l\r\u001b[?2004h> train_data_raw = train_df[0:int(0.8 * num_examples)].copy()\r\n\u001b[?2004l\r\u001b[?2004h> val_data_raw = train_df[int(0.8 * num_examples):].copy()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> TargetY_train = train_data_raw['Transported'].astype(int).values\r\n\u001b[?2004l\r\u001b[?2004h> TargetY_val = val_data_raw['Transported'].astype(int).values\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[243.683156, "o", "train_data_raw = train_data_raw.drop('Transported', axis=1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[243.683291, "o", "val_data_raw = val_data_raw.drop('Transported', axis=1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[243.683337, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[243.683435, "o", "X_train_df = preprocess_data(train_data_raw)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[243.68351, "o", "columns = X_train_df.columns\r\n\u001b[?2004l\r"]
[243.683548, "o", "\u001b[?2004h> "]
[243.683705, "o", "X_val_df = preprocess_data(val_data_raw, is_test=True, train_cols=columns)\r\n\u001b[?2004l\r\u001b[?2004h"]
[243.683741, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[243.683798, "o", "scaler = StandardScaler()\r\n\u001b[?2004l\r"]
[243.683837, "o", "\u001b[?2004h> "]
[243.684024, "o", "X_train = torch.tensor(scaler.fit_transform(X_train_df), dtype=torch.float32).to(DEVICE)\r\n\u001b[?2004l\r"]
[243.68406, "o", "\u001b[?2004h> "]
[243.684239, "o", "Y_train = torch.tensor(TargetY_train, dtype=torch.float32).unsqueeze(1).to(DEVICE)\r\n\u001b[?2004l\r"]
[243.684277, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[243.68446, "o", "X_val = torch.tensor(scaler.transform(X_val_df), dtype=torch.float32).to(DEVICE)\r\n\u001b[?2004l\r"]
[243.684496, "o", "\u001b[?2004h> "]
[243.684659, "o", "Y_val = torch.tensor(TargetY_val, dtype=torch.float32).unsqueeze(1).to(DEVICE)\r\n\u001b[?2004l\r"]
[243.684692, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[243.684763, "o", "class SimpleNet(nn.Module):\r\n\u001b[?2004l\r"]
[243.684807, "o", "\u001b[?2004h> "]
[243.684861, "o", "    def __init__(self, input_dim):\r\n\u001b[?2004l\r"]
[243.684896, "o", "\u001b[?2004h> "]
[243.684979, "o", "        super(SimpleNet, self).__init__()\r\n\u001b[?2004l\r"]
[243.685016, "o", "\u001b[?2004h> "]
[243.685075, "o", "        self.net = nn.Sequential(\r\n\u001b[?2004l\r"]
[243.685114, "o", "\u001b[?2004h> "]
[243.685185, "o", "            nn.Linear(input_dim, 32),\r\n\u001b[?2004l\r"]
[243.685222, "o", "\u001b[?2004h> "]
[243.68527, "o", "            nn.ReLU(),\r\n\u001b[?2004l\r"]
[243.685311, "o", "\u001b[?2004h> "]
[243.68535, "o", "            nn.Dropout(0.5),\r\n\u001b[?2004l\r"]
[243.68539, "o", "\u001b[?2004h> "]
[243.68543, "o", "            nn.Linear(32, 1),\r\n\u001b[?2004l\r"]
[243.685462, "o", "\u001b[?2004h> "]
[243.685511, "o", "            nn.Sigmoid()\r\n\u001b[?2004l\r\u001b[?2004h"]
[243.685543, "o", "> "]
[243.685579, "o", "        )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[243.685626, "o", "    def forward(self, x):\r\n\u001b[?2004l\r"]
[243.685661, "o", "\u001b[?2004h> "]
[243.685707, "o", "        return self.net(x)\r\n\u001b[?2004l\r"]
[243.685742, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[243.685785, "o", "> "]
[243.685856, "o", "model = SimpleNet(X_train.shape[1]).to(DEVICE)\r\n\u001b[?2004l\r"]
[243.685889, "o", "\u001b[?2004h> "]
[243.685932, "o", "criterion = nn.BCELoss()\r\n\u001b[?2004l\r"]
[243.685966, "o", "\u001b[?2004h> "]
[243.686125, "o", "optimizer = optim.Adam(model.parameters(), lr=0.0005, weight_decay=1e-3)\r\n\u001b[?2004l\r"]
[243.686165, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[243.686226, "o", "best_val_loss = float('inf')\r\n\u001b[?2004l\r"]
[243.686262, "o", "\u001b[?2004h> "]
[243.686308, "o", "best_model_state = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[243.686345, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[243.68638, "o", "model.train()\r\n\u001b[?2004l\r"]
[243.686417, "o", "\u001b[?2004h> "]
[243.686453, "o", "for epoch in range(100):\r\n\u001b[?2004l\r"]
[243.686483, "o", "\u001b[?2004h> "]
[243.686531, "o", "    optimizer.zero_grad()\r\n\u001b[?2004l\r"]
[243.68657, "o", "\u001b[?2004h> "]
[243.686608, "o", "    outputs = model(X_train)\r\n\u001b[?2004l\r"]
[243.686644, "o", "\u001b[?2004h> "]
[243.686712, "o", "    loss = criterion(outputs, Y_train)\r\n\u001b[?2004l\r"]
[243.686746, "o", "\u001b[?2004h> "]
[243.686789, "o", "    loss.backward()\r\n\u001b[?2004l\r"]
[243.68683, "o", "\u001b[?2004h> "]
[243.686869, "o", "    optimizer.step()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[243.686916, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[243.686956, "o", "    model.eval()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[243.687009, "o", "    with torch.no_grad():\r\n\u001b[?2004l\r"]
[243.687046, "o", "\u001b[?2004h> "]
[243.687099, "o", "        val_out = model(X_val)\r\n\u001b[?2004l\r"]
[243.687143, "o", "\u001b[?2004h> "]
[243.687226, "o", "        val_loss = criterion(val_out, Y_val)\r\n\u001b[?2004l\r"]
[243.687264, "o", "\u001b[?2004h> "]
[243.687332, "o", "        if val_loss < best_val_loss:\r\n\u001b[?2004l\r"]
[243.687368, "o", "\u001b[?2004h> "]
[243.687439, "o", "            best_val_loss = val_loss\r\n\u001b[?2004l\r"]
[243.687461, "o", "\u001b[?2004h> "]
[243.687609, "o", "            best_model_state = copy.deepcopy(model.state_dict())\r\n\u001b[?2004l\r"]
[243.687646, "o", "\u001b[?2004h> "]
[243.687682, "o", "    model.train()\r\n\u001b[?2004l\r\u001b[?2004h"]
[243.687719, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[243.68779, "o", "    if (epoch + 1) % 20 == 0:\r\n\u001b[?2004l\r\u001b[?2004h"]
[243.687828, "o", "> "]
[243.688048, "o", "        print(f\"Epoch {epoch+1}/100, Train Loss: {loss.item():.4f}, Val Loss: {val_loss.item():.4f}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[243.688084, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[243.688176, "o", "model.load_state_dict(best_model_state)\r\n\u001b[?2004l\r"]
[243.688213, "o", "\u001b[?2004h> "]
[243.688251, "o", "model.eval()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[243.688295, "o", "with torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h"]
[243.688331, "o", "> "]
[243.688422, "o", "    train_preds = (model(X_train) > 0.5).float()\r\n\u001b[?2004l\r"]
[243.688458, "o", "\u001b[?2004h> "]
[243.688545, "o", "    val_preds = (model(X_val) > 0.5).float()\r\n\u001b[?2004l\r"]
[243.688581, "o", "\u001b[?2004h> "]
[243.688723, "o", "    train_accuracy = accuracy_score(Y_train.cpu(), train_preds.cpu())\r\n\u001b[?2004l\r"]
[243.688755, "o", "\u001b[?2004h> "]
[243.688901, "o", "    val_accuracy = accuracy_score(Y_val.cpu(), val_preds.cpu())\r\n\u001b[?2004l\r\u001b[?2004h"]
[243.688939, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[243.689029, "o", "print(f\"Train Accuracy: {train_accuracy}\")\r\n\u001b[?2004l\r"]
[243.689061, "o", "\u001b[?2004h> "]
[243.689161, "o", "print(f\"Validation Accuracy: {val_accuracy}\")\r\n\u001b[?2004l\r"]
[243.6892, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[243.689237, "o", "> "]
[243.689368, "o", "X_test_raw = preprocess_data(full_test, is_test=True, train_cols=columns)\r\n\u001b[?2004l\r"]
[243.689406, "o", "\u001b[?2004h> "]
[243.68958, "o", "X_test = torch.tensor(scaler.transform(X_test_raw), dtype=torch.float32).to(DEVICE)\r\n\u001b[?2004l\r"]
[243.689617, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[243.68965, "o", "> model.eval()\r\n"]
[243.689685, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[243.689721, "o", "with torch.no_grad():\r\n\u001b[?2004l\r"]
[243.689768, "o", "\u001b[?2004h> "]
[243.6899, "o", "    test_preds = (model(X_test) > 0.5).float().cpu().numpy().flatten()\r\n\u001b[?2004l\r"]
[243.689942, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[243.690003, "o", "submission = pd.DataFrame({\r\n\u001b[?2004l\r"]
[243.69004, "o", "\u001b[?2004h> "]
[243.690129, "o", "    'PassengerId': full_test['PassengerId'],\r\n\u001b[?2004l\r"]
[243.690168, "o", "\u001b[?2004h> "]
[243.690234, "o", "    'Transported': (test_preds == 1)\r\n\u001b[?2004l\r"]
[243.690271, "o", "\u001b[?2004h> })\r\n\u001b[?2004l\r"]
[243.690308, "o", "\u001b[?2004h> "]
[243.69039, "o", "submission.to_csv('submission.csv', index=False)\r\n\u001b[?2004l\r"]
