[55.900007, "o", "\u001b[?2004hroot@02cfda238912:/workspace# "]
[105.450973, "i", "cat << 'EOF' > train.py\nimport os\nimport numpy as np\nimport pandas as pd\nimport torch\nimport torch.nn as nn\nimport torch.nn.functional as F\n\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\nclass UNet(nn.Module):\n    def __init__(self):\n        super().__init__()\n        self.enc1 = self.conv_block(6, 32)\n        self.enc2 = self.conv_block(32, 64)\n        self.enc3 = self.conv_block(64, 128)\n        self.pool = nn.MaxPool2d(2)\n        self.up2 = nn.ConvTranspose2d(128, 64, 2, stride=2)\n        self.dec2 = self.conv_block(128, 64)\n        self.up1 = nn.ConvTranspose2d(64, 32, 2, stride=2)\n        self.dec1 = self.conv_block(64, 32)\n        self.final = nn.Conv2d(32, 1, 1)\n\n    def conv_block(self, in_ch, out_ch):\n        return nn.Sequential(\n            nn.Conv2d(in_ch, out_ch, 3, padding=1),\n            nn.BatchNorm2d(out_ch),\n            nn.ReLU(inplace=True),\n            nn.Conv2d(out_ch, out_ch, 3, padding=1),\n            nn.BatchNorm2d(out_ch),\n            nn.ReLU(inplace=True)\n        )\n\n    def forward(self, x):\n        s1 = self.enc1(x)\n        s2 = self.enc2(self.pool(s1))\n        s3 = self.enc3(self.pool(s2))\n        \n        x = self.up2(s3)\n        x = torch.cat([x, s2], dim=1)\n        x = self.dec2(x)\n        \n        x = self.up1(x)\n        x = torch.cat([x, s1], dim=1)\n        x = self.dec1(x)\n        \n        return self.final(x)\n\ndef get_data(rec_dir):\n    b11 = np.load(f'{rec_dir}/band_11.npy').astype(np.float32)\n    b14 = np.load(f'{rec_dir}/band_14.npy').astype(np.float32)\n    b15 = np.load(f'{rec_dir}/band_15.npy').astype(np.float32)\n    \n    # Center frame\n    center = np.stack([b11[..., 1], b14[..., 1], b15[..., 1]], axis=0)\n    # Temporal diff (Center - Before)\n    diff = np.stack([b11[..., 1]-b11[..., 0], b14[..., 1]-b14[..., 0], b15[..., 1]-b15[..., 0]], axis=0)\n    \n    x = np.concatenate([center, diff], axis=0)\n    x = (x - x.mean()) / (x.std() + 1e-6)\n    return x\n\ndef rle(mask):\n    flat = mask.reshape(-1)\n    if flat.sum() == 0:\n        return ''\n    d = np.diff(np.concatenate([[0], flat, [0]]))\n    starts, ends = np.where(d == 1)[0], np.where(d == -1)[0]\n    return ' '.join(f'{s} {e - s}' for s, e in zip(starts, ends))\n\ntrain_ids = sorted(os.listdir('train'))\ntest_ids = sorted(os.listdir('test'))\n\nmodel = UNet().to(DEVICE)\nopt = torch.optim.Adam(model.parameters(), lr=1e-3)\nlossf = nn.BCEWithLogitsLoss()\n\nepochs = 3\nfor epoch in range(epochs):\n    model.train()\n    total_loss = 0\n    for rid in train_ids:\n        x = torch.tensor(get_data(f'train/{rid}')).unsqueeze(0).to(DEVICE)\n        m = np.load(f'train/{rid}/human_pixel_masks.npy').astype(np.float32).squeeze()\n        y = torch.tensor(m).unsqueeze(0).unsqueeze(1).to(DEVICE)\n        \n        opt.zero_grad()\n        pred = model(x)\n        loss = lossf(pred, y)\n        loss.backward()\n        opt.step()\n        total_loss += loss.item()\n    print(f'epoch {epoch} loss {total_loss/len(train_ids):.4f}')\n\nmodel.eval()\nrows = []\nwith torch.no_grad():\n    for rid in test_ids:\n        x = torch.tensor(get_data(f'test/{rid}')).unsqueeze(0).to(DEVICE)\n        pred = torch.sigmoid(model(x)).squeeze().cpu().numpy() > 0.5\n        rows.append({'record_id': rid, 'rle': rle(pred.astype(np.uint8))})\n\npd.DataFrame(rows).to_csv('submission.csv', index=False)\nprint('wrote submission.csv')\nEOF\n"]
[105.451577, "o", "cat << 'EOF' > train.py"]
