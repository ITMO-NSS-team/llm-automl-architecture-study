cat <<EOF > train.py
import ast
import numpy as np
import pandas as pd
import torch
import torch.nn as nn
from PIL import Image
from torchvision import models, transforms

DEVICE = ('cuda' if torch.cuda.is_available()
          else 'mps' if torch.backends.mps.is_available() else 'cpu')
print('DEVICE=', DEVICE)

SIZE = 64
N_CLASSES = 290
BATCH_SIZE = 32
EPOCH = 1 

def load(ids):
    out = []
    for i in ids:
        for ext in ('.png', '.jpg', '.jpeg'):
            p = f'images/{i}{ext}'
            try:
                out.append(np.asarray(Image.open(p).convert('RGB').resize((SIZE, SIZE)),
                                      dtype=np.float32) / 255.0)
                break
            except FileNotFoundError:
                continue
        else:
            out.append(np.zeros((SIZE, SIZE, 3), dtype=np.float32))
    return np.stack(out)

train_df = pd.read_csv('train.csv')
test_df = pd.read_csv('test.csv')

X = torch.tensor(load(train_df['id'].values)).permute(0, 3, 1, 2).to(DEVICE)
Y = torch.zeros(len(train_df), N_CLASSES).to(DEVICE)
for r, cats in enumerate(train_df['categories']):
    try:
        c_list = ast.literal_eval(str(cats))
        for c in c_list:
            if 0 <= int(c) < N_CLASSES:
                Y[r, int(c)] = 1.0
    except:
        pass

model = models.resnet18(weights='IMAGENET1K_V1')
model.fc = nn.Linear(model.fc.in_features, N_CLASSES)
model = model.to(DEVICE)

opt = torch.optim.Adam(model.parameters(), lr=1e-4)
lossf = nn.BCEWithLogitsLoss()

for epoch in range(EPOCH):
    model.train()
    total_loss = 0
    for i in range(0, len(X), BATCH_SIZE):
        xb, yb = X[i:i + BATCH_SIZE], Y[i:i + BATCH_SIZE]
        opt.zero_grad()
        out = model(xb)
        loss = lossf(out, yb)
        loss.backward()
        opt.step()
        total_loss += loss.item()
    print(f'epoch {epoch} loss {total_loss / (len(X)//BATCH_SIZE + 1):.4f}')

Xte = torch.tensor(load(test_df['id'].values)).permute(0, 3, 1, 2).to(DEVICE)
model.eval()

with torch.no_grad():
    pred_logits = model(Xte)
    pred_matrix = torch.sigmoid(pred_logits).cpu().numpy()

distinct_counts = []
for col in range(N_CLASSES):
    distinct_counts.append(len(np.unique(pred_matrix[:, col])))

print('Min distinct values per column:', min(distinct_counts))

rows = []
for r in pred_matrix:
    preds = np.where(r > 0.5)[0].tolist()
    rows.append(preds)

pd.DataFrame({'id': test_df['id'], 'categories': [str(r) for r in rows]}).to_csv('submission.csv', index=False)
print('wrote submission.csv')
