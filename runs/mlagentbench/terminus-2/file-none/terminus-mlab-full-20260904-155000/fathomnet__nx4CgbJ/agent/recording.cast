[4563.405809, "o", "model = models.resnet18(weights='IMAGENET1K_V1')\r\n\u001b[?2004l\r"]
[4563.405849, "o", "\u001b[?2004h> "]
[4563.405892, "o", "model.fc = nn.Linear(model.fc.in_features, N_CLASSES)\r\n\u001b[?2004l\r"]
[4563.405947, "o", "\u001b[?2004h> model = model.to(DEVICE)\r\n"]
[4563.405994, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4563.406037, "o", "opt = torch.optim.Adam(model.parameters(), lr=1e-4)\r\n\u001b[?2004l\r"]
[4563.406076, "o", "\u001b[?2004h> "]
[4563.406104, "o", "lossf = nn.BCEWithLogitsLoss()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[4563.406146, "o", "> "]
[4563.406177, "o", "for epoch in range(EPOCH):\r\n\u001b[?2004l\r\u001b[?2004h>     model.train()"]
[4563.406219, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4563.406255, "o", "    total_loss = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4563.4063, "o", "    for i in range(0, len(X), BATCH_SIZE):\r\n\u001b[?2004l\r"]
[4563.406328, "o", "\u001b[?2004h> "]
[4563.40637, "o", "        xb, yb = X[i:i + BATCH_SIZE], Y[i:i + BATCH_SIZE]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4563.406415, "o", "        opt.zero_grad()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4563.406455, "o", "        out = model(xb)\r\n\u001b[?2004l\r"]
[4563.406495, "o", "\u001b[?2004h> "]
[4563.406523, "o", "        loss = lossf(out, yb)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4563.406581, "o", "        loss.backward()\r\n\u001b[?2004l\r\u001b[?2004h"]
[4563.40662, "o", ">         opt.step()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4563.406648, "o", "        total_loss += loss.item()\r\n\u001b[?2004l\r\u001b[?2004h"]
[4563.40669, "o", "> "]
[4563.406734, "o", "    print(f'epoch {epoch} loss {total_loss / (len(X)//BATCH_SIZE + 1):.4f}')\r\n\u001b[?2004l\r"]
[4563.406777, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4563.406849, "o", "Xte = torch.tensor(load(test_df['id'].values)).permute(0, 3, 1, 2).to(DEVICE)\r\n\u001b[?2004l\r"]
[4563.40689, "o", "\u001b[?2004h> model.eval()\r\n\u001b[?2004l\r"]
[4563.406946, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4563.406985, "o", "with torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4563.407013, "o", "    pred_logits = model(Xte)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4563.407073, "o", "    pred_matrix = torch.sigmoid(pred_logits).cpu().numpy()\r\n\u001b[?2004l\r"]
[4563.407115, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4563.407155, "o", "distinct_counts = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4563.407183, "o", "for col in range(N_CLASSES):\r\n\u001b[?2004l\r"]
[4563.40723, "o", "\u001b[?2004h> "]
[4563.407266, "o", "    distinct_counts.append(len(np.unique(pred_matrix[:, col])))\r\n\u001b[?2004l\r"]
[4563.407309, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4563.407365, "o", "print('Min distinct values per column:', min(distinct_counts))\r\n\u001b[?2004l\r"]
[4563.407406, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4563.407446, "o", "rows = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4563.407474, "o", "for r in pred_matrix:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[4563.407519, "o", "    preds = np.where(r > 0.5)[0].tolist()\r\n\u001b[?2004l\r"]
[4563.407567, "o", "\u001b[?2004h> "]
[4563.407596, "o", "    rows.append(preds)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[4563.407709, "o", "pd.DataFrame({'id': test_df['id'], 'categories': [str(r) for r in rows]}).to_csv('submission.csv', index=False)\r\n\u001b[?2004l\r"]
[4563.407739, "o", "\u001b[?2004h> "]
[4563.407784, "o", "print('wrote submission.csv')\r\n\u001b[?2004l\r"]
[4563.407822, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[4563.408918, "o", "\u001b[?2004hroot@03a00f52ee6b:/workspace# "]
[4563.408968, "o", "python3 train.py\r\n\u001b[?2004l\r"]
[4565.051095, "o", "DEVICE= cpu\r\n"]
[4858.713099, "o", "epoch 0 loss 0.3805\r\n"]
[4872.378096, "o", "Min distinct values per column: 449\r\n"]
[4872.385071, "o", "wrote submission.csv\r\n"]
