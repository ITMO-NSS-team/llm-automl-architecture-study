[22.525967, "o", "id,categories\r\nc7f56fc4-a75d-4be6-828a-c7ff64cfc1a2,\"[52.0, 246.0]\"\r\nea980963-1ed8-42c0-a0ea-cd2815143017,[10.0]\r\n66ebb2a2-b922-4921-94a9-bc505ea2c66c,[37.0]\r\n18562d9e-0c39-47d6-a1a9-e68abb821fd9,\"[37.0, 51.0, 160.0, 224.0]\"\r\ne5271691-cd81-47a3-a37a-3272d72a3897,\"[37.0, 61.0, 116.0]\"\r\n1a11b43d-53e2-4e29-8185-498a466a5b10,\"[3.0, 51.0, 88.0]\"\r\n1da5720f-93e0-4e67-a89d-c0f6384780ab,[37.0]\r\n7a6d1aa3-96d9-442e-8bb8-354b3975b9d2,\"[1.0, 10.0, 51.0]\"\r\n9b02aabb-311d-4428-bf69-a8b321af529c,[10.0]\r\n2de29989-6be2-4924-bc4f-e7504ada9ae8,\"[1.0, 52.0]\"\r\n07629244-7227-4b94-a58a-01fee7b1092a,\"[1.0, 214.0]\"\r\n5b5b7482-221a-4564-9fd7-706afc1869e1,\"[16.0, 37.0, 52.0, 142.0]\"\r\n0d0c757d-48f8-421e-9d22-98980726f5e9,[51.0]\r\na20f9ea1-3016-4af0-9e31-bfc147705aff,\"[51.0, 69.0, 119.0, 146.0]\"\r\nfe44ec61-2552-4cca-9699-b0cbe4980d3d,\"[1.0, 52.0, 146.0, 211.0]\"\r\n25ad169c-9f10-45fd-8c60-bef192e7fbf0,\"[37.0, 51.0]\"\r\n5c6d81d1-971a-42ba-b351-5ff130b2c8bf,\"[37.0, 66.0]\"\r\nf47835a6-279b-4a66-a49a-c86922f13dbc,[36.0]\r\nb6e22f95-1c65-4185-b66f-c0c2f0f6eef2,\"[51.0, 160.0]\"\r\n\u001b[?2004hroot@03a00f52ee6b:/workspace# "]
[35.160062, "i", "cat <<EOF > train.py\nimport ast\nimport numpy as np\nimport pandas as pd\nimport torch\nimport torch.nn as nn\nfrom PIL import Image\nfrom torchvision import models, transforms\n\n# REQUIRED Hardware Device Selection\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\nSIZE = 64\nN_CLASSES = 290\nBATCH_SIZE = 32\nEPOCH = 10 \n\ndef load(ids):\n    out = []\n    for i in ids:\n        for ext in ('.png', '.jpg', '.jpeg'):\n            p = f'images/{i}{ext}'\n            try:\n                out.append(np.asarray(Image.open(p).convert('RGB').resize((SIZE, SIZE)),\n                                      dtype=np.float32) / 255.0)\n                break\n            except FileNotFoundError:\n                continue\n        else:\n            out.append(np.zeros((SIZE, SIZE, 3), dtype=np.float32))\n    return np.stack(out)\n\ntrain_df = pd.read_csv('train.csv')\ntest_df = pd.read_csv('test.csv')\n\nX = torch.tensor(load(train_df['id'].values)).permute(0, 3, 1, 2).to(DEVICE)\nY = torch.zeros(len(train_df), N_CLASSES).to(DEVICE)\nfor r, cats in enumerate(train_df['categories']):\n    try:\n        c_list = ast.literal_eval(str(cats))\n        for c in c_list:\n            if 0 <= int(c) < N_CLASSES:\n                Y[r, int(c)] = 1.0\n    except:\n        pass\n\nmodel = models.resnet18(weights='IMAGENET1K_V1')\nmodel.fc = nn.Linear(model.fc.in_features, N_CLASSES)\nmodel = model.to(DEVICE)\n\nopt = torch.optim.Adam(model.parameters(), lr=1e-4)\nlossf = nn.BCEWithLogitsLoss()\n\nfor epoch in range(EPOCH):\n    model.train()\n    total_loss = 0\n    for i in range(0, len(X), BATCH_SIZE):\n        xb, yb = X[i:i + BATCH_SIZE], Y[i:i + BATCH_SIZE]\n        opt.zero_grad()\n        out = model(xb)\n        loss = lossf(out, yb)\n        loss.backward()\n        opt.step()\n        total_loss += loss.item()\n    print(f'epoch {epoch} loss {total_loss / (len(X)//BATCH_SIZE + 1):.4f}')\n\nXte = torch.tensor(load(test_df['id'].values)).permute(0, 3, 1, 2).to(DEVICE)\nmodel.eval()\n\nwith torch.no_grad():\n    # Prediction matrix for collapse check\n    pred_logits = model(Xte)\n    pred_matrix = torch.sigmoid(pred_logits).cpu().numpy()\n\ndistinct_counts = []\nfor col in range(N_CLASSES):\n    distinct_counts.append(len(np.unique(pred_matrix[:, col])))\n\nprint('Min distinct values per column:', min(distinct_counts))\nif any(c < 10 for c in distinct_counts):\n    print('WARNING: Model may have collapsed!')\n\nrows = []\nfor r in pred_matrix:\n    preds = np.where(r > 0.5)[0].tolist()\n    rows.append(preds)\n\npd.DataFrame({'id': test_df['id'], 'categories': [str(r) for r in rows]}).to_csv('submission.csv', index=False)\nprint('wrote submission.csv')\nEOF\n"]
[35.160252, "o", "cat <<EOF > train.py\r\n"]
