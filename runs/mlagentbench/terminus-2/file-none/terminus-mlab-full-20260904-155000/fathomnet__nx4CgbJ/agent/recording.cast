[436.012503, "i", "cat <<EOF > train.py\nimport ast\nimport numpy as np\nimport pandas as pd\nimport torch\nimport torch.nn as nn\nfrom PIL import Image\nfrom torchvision import models, transforms\n\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\nSIZE = 64\nN_CLASSES = 290\nBATCH_SIZE = 32\nEPOCH = 1 \n\ndef load(ids):\n    out = []\n    for i in ids:\n        for ext in ('.png', '.jpg', '.jpeg'):\n            p = f'images/{i}{ext}'\n            try:\n                out.append(np.asarray(Image.open(p).convert('RGB').resize((SIZE, SIZE)),\n                                      dtype=np.float32) / 255.0)\n                break\n            except FileNotFoundError:\n                continue\n        else:\n            out.append(np.zeros((SIZE, SIZE, 3), dtype=np.float32))\n    return np.stack(out)\n\ntrain_df = pd.read_csv('train.csv')\ntest_df = pd.read_csv('test.csv')\n\nX = torch.tensor(load(train_df['id'].values)).permute(0, 3, 1, 2).to(DEVICE)\nY = torch.zeros(len(train_df), N_CLASSES).to(DEVICE)\nfor r, cats in enumerate(train_df['categories']):\n    try:\n        c_list = ast.literal_eval(str(cats))\n        for c in c_list:\n            if 0 <= int(c) < N_CLASSES:\n                Y[r, int(c)] = 1.0\n    except:\n        pass\n\nmodel = models.resnet18(weights='IMAGENET1K_V1')\nmodel.fc = nn.Linear(model.fc.in_features, N_CLASSES)\nmodel = model.to(DEVICE)\n\nopt = torch.optim.Adam(model.parameters(), lr=1e-4)\nlossf = nn.BCEWithLogitsLoss()\n\nfor epoch in range(EPOCH):\n    model.train()\n    total_loss = 0\n    for i in range(0, len(X), BATCH_SIZE):\n        xb, yb = X[i:i + BATCH_SIZE], Y[i:i + BATCH_SIZE]\n        opt.zero_grad()\n        out = model(xb)\n        loss = lossf(out, yb)\n        loss.backward()\n        opt.step()\n        total_loss += loss.item()\n    print(f'epoch {epoch} loss {total_loss / (len(X)//BATCH_SIZE + 1):.4f}')\n\nXte = torch.tensor(load(test_df['id'].values)).permute(0, 3, 1, 2).to(DEVICE)\nmodel.eval()\n\nwith torch.no_grad():\n    pred_logits = model(Xte)\n    pred_matrix = torch.sigmoid(pred_logits).cpu().numpy()\n\ndistinct_counts = []\nfor col in range(N_CLASSES):\n    distinct_counts.append(len(np.unique(pred_matrix[:, col])))\n\nprint('Min distinct values per column:', min(distinct_counts))\n\nrows = []\nfor r in pred_matrix:\n    preds = np.where(r > 0.5)[0].tolist()\n    rows.append(preds)\n\npd.DataFrame({'id': test_df['id'], 'categories': [str(r) for r in rows]}).to_csv('submission.csv', index=False)\nprint('wrote submission.csv')\nEOF\n"]
[436.012772, "o", "cat <<EOF > train.py\r\nimport ast\r\nimport numpy as np\r\nimport pandas as pd\r\nimport torch\r\nimport torch.nn as nn\r\nfrom PIL import Image\r\nfrom torchvision import models, transforms\r\n\r\nDEVICE = ('cuda' if torch.cuda.is_available()\r\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\r\nprint('DEVICE=', DEVICE)\r\n\r\nSIZE = 64\r\nN_CLASSES = 290\r\nBATCH_SIZE = 32\r\nEPOCH = 1 \r\n\r\ndef load(ids):\r\n    out = []\r\n    for i in ids:\r\n        for ext in ('.png', '.jpg', '.jpeg'):\r\n            p = f'images/{i}{ext}'\r\n            try:\r\n                out.append(np.asarray(Image.open(p).convert('RGB').resize((SIZE, SIZE)),\r\n                                      dtype=np.float32) / 255.0)\r\n                break\r\n            except FileNotFoundError:\r\n                continue\r\n        else:\r\n            out.append(np.zeros((SIZE, SIZE, 3), dtype=np.float32))\r\n    return np.stack(out)\r\n\r\ntrain_df = pd.read_csv('train.csv')\r\ntest_df = pd.read_csv('test.csv')\r\n\r\nX = torch.tensor(load(train_df['id'].values)).permute(0, 3, 1, 2).to(DEVICE)\r\nY = torch.zeros(len(train_df), N_CLASSES).to(DEVICE)\r\nfor r, cats in enumerate(train_df['categories']):\r\n    try:\r\n        c_list = ast.literal_eval(str(cats))\r\n        for c in c_list:\r\n            if 0 <= int(c) < N_CLASSES:\r\n                Y[r, int(c)] = 1.0\r\n    except:\r\n        pass\r\n\r\nmodel = models.resnet18(weights='IMAGENET1K_V1')\r\nmodel.fc = nn.Linear(model.fc.in_features, N_CLASSES)\r\nmodel = model.to(DEVICE)\r\n\r\nopt = torch.optim.Adam(model.parameters(), lr=1e-4)\r\nlossf = nn.BCEWithLogitsLoss()\r\n\r\nfor epoch in range(EPOCH):\r\n    model.train()\r\n    total_loss = 0\r\n    for i in range(0, len(X), BATCH_SIZE):\r\n        xb, yb = X[i:i + BATCH_SIZE], Y[i:i + BATCH_SIZE]\r\n        opt.zero_grad()\r\n        out = model(xb)\r\n        loss = lossf(out, yb)\r\n        loss.backward()\r\n        opt.step()\r\n        total_loss += loss.item()\r\n    print(f'epoch {epoch} loss {total_loss / (len(X)//BATCH_SIZE + 1):.4f}')\r\n\r\nXte = torch.tensor(load(test_df['id'].values)).permute(0, 3, 1, 2).to(DEVICE)\r\nmodel.eval()\r\n\r\nwith torch.no_grad():\r\n    pred_logits = model(Xte)\r\n    pred_matrix = torch.sigmoid(pred_logits).cpu().numpy()\r\n\r\ndistinct_counts = []\r\nfor col in range(N_CLASSES):\r\n    distinct_counts.append(len(np.unique(pred_matrix[:, col])))\r\n\r\nprint('Min distinct values per column:', min(distinct_counts))\r\n\r\nrows = []\r\nfor r in pred_matrix:\r\n    preds = np.where(r > 0.5)[0].tolist()\r\n    rows.append(preds)\r\n\r\npd.DataFrame({'id': test_df['id'], 'categories': [str(r) for r in rows]}).to_csv('submission.csv', index=False)\r\nprint('wrote submission.csv')\r\nEOF\r\n"]
