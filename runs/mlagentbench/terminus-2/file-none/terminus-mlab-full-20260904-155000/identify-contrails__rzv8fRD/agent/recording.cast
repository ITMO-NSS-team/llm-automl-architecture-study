[78.652741, "o", "        e1 = self.enc1(x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.652797, "o", "        e2 = self.enc2(self.pool(e1))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.652884, "o", "        e3 = self.enc3(self.pool(e2))\r\n\u001b[?2004l\r"]
[78.652962, "o", "\u001b[?2004h> "]
[78.653022, "o", "        d2 = self.up2(e3)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.65309, "o", "        d2 = torch.cat([d2, e2], dim=1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.653144, "o", "        d2 = self.dec2(d2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.653216, "o", "        d1 = self.up1(d2)\r\n\u001b[?2004l\r"]
[78.653274, "o", "\u001b[?2004h> "]
[78.653342, "o", "        d1 = torch.cat([d1, e1], dim=1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.653418, "o", "        d1 = self.dec1(d1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.653478, "o", "        return self.final(d1)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[78.653544, "o", "\u001b[?2004h> def rle(mask):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.653632, "o", "    flat = mask.reshape(-1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.653712, "o", "    if flat.sum() == 0:\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.653744, "o", ">         return ''\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.653849, "o", "    d = np.diff(np.concatenate([[0], flat, [0]]))\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.653908, "o", "> "]
[78.653981, "o", "    starts, ends = np.where(d == 1)[0], np.where(d == -1)[0]\r\n\u001b[?2004l\r"]
[78.654041, "o", "\u001b[?2004h> "]
[78.654127, "o", "    return ' '.join(f'{s} {e - s}' for s, e in zip(starts, ends))\r\n\u001b[?2004l\r"]
[78.654181, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[78.654249, "o", "> train_ids = sorted(os.listdir('train'))\r\n\u001b[?2004l\r"]
[78.654301, "o", "\u001b[?2004h> "]
[78.654365, "o", "test_ids = sorted(os.listdir('test'))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[78.654423, "o", "\u001b[?2004h> "]
[78.654488, "o", "split = int(0.9 * len(train_ids))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.654597, "o", "train_set = ContrailDataset('train', train_ids[:split])\r\n\u001b[?2004l\r"]
[78.654655, "o", "\u001b[?2004h> "]
[78.654729, "o", "val_set = ContrailDataset('train', train_ids[split:])\r\n\u001b[?2004l\r"]
[78.654813, "o", "\u001b[?2004h> "]
[78.65487, "o", "train_loader = DataLoader(train_set, batch_size=4, shuffle=True)\r\n\u001b[?2004l\r"]
[78.654898, "o", "\u001b[?2004h> "]
[78.654996, "o", "val_loader = DataLoader(val_set, batch_size=4)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.655054, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.655124, "o", "model = SimpleUNet().to(DEVICE)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.655213, "o", "opt = torch.optim.Adam(model.parameters(), lr=1e-3)\r\n\u001b[?2004l\r"]
[78.655271, "o", "\u001b[?2004h> "]
[78.655335, "o", "criterion = nn.BCEWithLogitsLoss()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.655392, "o", "epochs = 3\r\n\u001b[?2004l\r"]
[78.655458, "o", "\u001b[?2004h> for epoch in range(epochs):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.655533, "o", "    model.train()\r\n\u001b[?2004l\r"]
[78.655617, "o", "\u001b[?2004h>     train_loss = 0\r\n\u001b[?2004l\r"]
[78.655672, "o", "\u001b[?2004h>     for x, y in train_loader:\r\n\u001b[?2004l\r"]
[78.655738, "o", "\u001b[?2004h> "]
[78.655803, "o", "        x, y = x.to(DEVICE), y.to(DEVICE)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.65588, "o", "        opt.zero_grad()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.655935, "o", "        pred = model(x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.655996, "o", "        loss = criterion(pred, y)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.656076, "o", "        loss.backward()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.656149, "o", "        opt.step()\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.656224, "o", "> "]
[78.65627, "o", "        train_loss += loss.item()\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.656295, "o", "    model.eval()\r\n\u001b[?2004l\r"]
[78.656319, "o", "\u001b[?2004h> "]
[78.656421, "o", "    val_loss = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.656497, "o", "    with torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.65657, "o", "        for x, y in val_loader:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.656653, "o", "            x, y = x.to(DEVICE), y.to(DEVICE)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.656768, "o", "            val_loss += criterion(model(x), y).item()\r\n\u001b[?2004l\r"]
[78.656827, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[78.656909, "o", "\u001b[?2004h> "]
[78.657069, "o", "    print(f'Epoch {epoch+1}/{epochs} - Train Loss: {train_loss/len(train_loader):.4f} - Val Loss: {val_loss/len(val_loader):.4f}')\r\n\u001b[?2004l\r"]
[78.657137, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[78.657204, "o", "> "]
[78.65726, "o", "test_set = ContrailDataset('test', test_ids, is_test=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.657328, "o", "> "]
[78.65739, "o", "test_loader = DataLoader(test_set, batch_size=4)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[78.657457, "o", "\u001b[?2004l\r\u001b[?2004h> model.eval()\r\n\u001b[?2004l\r\u001b[?2004h> rows = []\r\n\u001b[?2004l\r"]
[78.657509, "o", "\u001b[?2004h> "]
[78.657589, "o", "with torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.657648, "o", "    for rid, x in test_loader:\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.657714, "o", ">         x = x.to(DEVICE)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.657814, "o", "        preds = torch.sigmoid(model(x)).cpu().numpy()\r\n\u001b[?2004l\r"]
[78.657878, "o", "\u001b[?2004h> "]
[78.657948, "o", "        for i in range(len(rid)):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.65804, "o", "            mask = (preds[i, 0] > 0.5).astype(np.uint8)\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.658095, "o", "> "]
[78.658176, "o", "            rows.append({'record_id': rid[i], 'rle': rle(mask)})\r\n\u001b[?2004l\r"]
[78.658201, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[78.658225, "o", "> "]
[78.658342, "o", "pd.DataFrame(rows).to_csv('submission.csv', index=False)\r\n\u001b[?2004l\r"]
[78.658398, "o", "\u001b[?2004h> "]
[78.658466, "o", "print('wrote submission.csv')\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
