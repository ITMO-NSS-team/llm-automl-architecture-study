[297.878752, "i", "cat <<'EOF' > train.py\nimport os\nimport numpy as np\nimport pandas as pd\nimport torch\nimport torch.nn as nn\nimport torch.nn.functional as F\nfrom torch.utils.data import Dataset, DataLoader\n\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\nclass ContrailDataset(Dataset):\n    def __init__(self, root_dir, ids, is_test=False):\n        self.root_dir = root_dir\n        self.ids = ids\n        self.is_test = is_test\n\n    def __len__(self):\n        return len(self.ids)\n\n    def __getitem__(self, idx):\n        rid = self.ids[idx]\n        rec_dir = os.path.join(self.root_dir, rid)\n        \n        try:\n            b11 = np.load(f'{rec_dir}/band_11.npy').astype(np.float32)\n            b14 = np.load(f'{rec_dir}/band_14.npy').astype(np.float32)\n            b15 = np.load(f'{rec_dir}/band_15.npy').astype(np.float32)\n            \n            # Use middle frame\n            t_idx = b11.shape[-1] // 2\n            x = np.stack([b11[..., t_idx], b14[..., t_idx], b15[..., t_idx]], axis=0)\n            x = (x - x.mean()) / (x.std() + 1e-6)\n            x = torch.from_numpy(x)\n            \n            if self.is_test:\n                return rid, x\n            \n            m = np.load(f'{rec_dir}/human_pixel_masks.npy').astype(np.float32).squeeze()\n            y = torch.from_numpy(m).unsqueeze(0)\n            return x, y\n        except Exception as e:\n            print(f\"Error loading {rid}: {e}\")\n            # Return dummy data in case of corruption to avoid crashing\n            x = torch.zeros((3, 256, 256))\n            if self.is_test: return rid, x\n            return x, torch.zeros((1, 256, 256))\n\nclass SimpleUNet(nn.Module):\n    def __init__(self):\n        super().__init__()\n        self.enc1 = self.conv_block(3, 16)\n        self.enc2 = self.conv_block(16, 32)\n        self.enc3 = self.conv_block(32, 64)\n        self.pool = nn.MaxPool2d(2)\n        self.up2 = nn.ConvTranspose2d(64, 32, 2, stride=2)\n        self.dec2 = self.conv_block(64, 32)\n        self.up1 = nn.ConvTranspose2d(32, 16, 2, stride=2)\n        self.dec1 = self.conv_block(32, 16)\n        self.final = nn.Conv2d(16, 1, 1)\n\n    def conv_block(self, in_ch, out_ch):\n        return nn.Sequential(\n            nn.Conv2d(in_ch, out_ch, 3, padding=1),\n            nn.ReLU(inplace=True),\n            nn.Conv2d(out_ch, out_ch, 3, padding=1),\n            nn.ReLU(inplace=True)\n        )\n\n    def forward(self, x):\n        e1 = self.enc1(x)\n        e2 = self.enc2(self.pool(e1))\n        e3 = self.enc3(self.pool(e2))\n        d2 = self.up2(e3)\n        d2 = torch.cat([d2, e2], dim=1)\n        d2 = self.dec2(d2)\n        d1 = self.up1(d2)\n        d1 = torch.cat([d1, e1], dim=1)\n        d1 = self.dec1(d1)\n        return self.final(d1)\n\ndef rle(mask):\n    flat = mask.reshape(-1)\n    if flat.sum() == 0:\n        return ''\n    d = np.diff(np.concatenate([[0], flat, [0]]))\n    starts, ends = np.where(d == 1)[0], np.where(d == -1)[0]\n    return ' '.join(f'{s} {e - s}' for s, e in zip(starts, ends))\n\ntrain_ids = sorted(os.listdir('train'))\ntest_ids = sorted(os.listdir('test'))\n\nsplit = int(0.9 * len(train_ids))\ntrain_set = ContrailDataset('train', train_ids[:split])\nval_set = ContrailDataset('train', train_ids[split:])\ntrain_loader = DataLoader(train_set, batch_size=4, shuffle=True)\nval_loader = DataLoader(val_set, batch_size=4)\n\nmodel = SimpleUNet().to(DEVICE)\nopt = torch.optim.Adam(model.parameters(), lr=1e-3)\ncriterion = nn.BCEWithLogitsLoss()\n\nepochs = 3\nfor epoch in range(epochs):\n    model.train()\n    train_loss = 0\n    for x, y in train_loader:\n        x, y = x.to(DEVICE), y.to(DEVICE)\n        opt.zero_grad()\n        pred = model(x)\n        loss = criterion(pred, y)\n        loss.backward()\n        opt.step()\n        train_loss += loss.item()\n    \n    model.eval()\n    val_loss = 0\n    with torch.no_grad():\n        for x, y in val_loader:\n            x, y = x.to(DEVICE), y.to(DEVICE)\n            val_loss += criterion(model(x), y).item()\n    \n    print(f'Epoch {epoch+1}/{epochs} - Train Loss: {train_loss/len(train_loader"]
[297.878825, "i", "):.4f} - Val Loss: {val_loss/len(val_loader):.4f}')\n\ntest_set = ContrailDataset('test', test_ids, is_test=True)\ntest_loader = DataLoader(test_set, batch_size=4)\n\nmodel.eval()\nrows = []\nwith torch.no_grad():\n    for rid, x in test_loader:\n        x = x.to(DEVICE)\n        preds = torch.sigmoid(model(x)).cpu().numpy()\n        for i in range(len(rid)):\n            mask = (preds[i, 0] > 0.5).astype(np.uint8)\n            rows.append({'record_id': rid[i], 'rle': rle(mask)})\n\npd.DataFrame(rows).to_csv('submission.csv', index=False)\nprint('wrote submission.csv')\nEOF\n"]
