[297.881313, "o", "\u001b[?2004h>           else 'mps' if torch.backends.mps.is_available() else 'cpu')\r\n\u001b[?2004l\r\u001b[?2004h> print('DEVICE=', DEVICE)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> class ContrailDataset(Dataset):\r\n\u001b[?2004l\r\u001b[?2004h>     def __init__(self, root_dir, ids, is_test=False):\r\n\u001b[?2004l\r\u001b[?2004h>         self.root_dir = root_dir\r\n\u001b[?2004l\r\u001b[?2004h>         self.ids = ids\r\n\u001b[?2004l\r\u001b[?2004h>         self.is_test = is_test\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     def __len__(self):\r\n\u001b[?2004l\r\u001b[?2004h>         return len(self.ids)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[297.881377, "o", "    def __getitem__(self, idx):"]
[297.881684, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>         rid = self.ids[idx]\r\n\u001b[?2004l\r\u001b[?2004h>         rec_dir = os.path.join(self.root_dir, rid)\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         try:\r\n\u001b[?2004l\r\u001b[?2004h>             b11 = np.load(f'{rec_dir}/band_11.npy').astype(np.float32)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[297.881791, "o", "            b14 = np.load(f'{rec_dir}/band_14.npy').astype(np.float32)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[297.881881, "o", "            b15 = np.load(f'{rec_dir}/band_15.npy').astype(np.float32)\r\n\u001b[?2004l\r\u001b[?2004h"]
[297.881932, "o", ">             \r\n\u001b[?2004l\r\u001b[?2004h> "]
[297.881978, "o", "            # Use middle frame\r\n\u001b[?2004l\r"]
[297.882027, "o", "\u001b[?2004h> "]
[297.88208, "o", "            t_idx = b11.shape[-1] // 2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[297.882179, "o", "            x = np.stack([b11[..., t_idx], b14[..., t_idx], b15[..., t_idx]], axis=0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[297.882226, "o", "> "]
[297.882275, "o", "            x = (x - x.mean()) / (x.std() + 1e-6)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[297.88232, "o", "            x = torch.from_numpy(x)\r\n\u001b[?2004l\r"]
[297.882369, "o", "\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h> "]
[297.882429, "o", "            if self.is_test:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[297.882483, "o", "                return rid, x\r\n\u001b[?2004l\r\u001b[?2004h> "]
[297.882532, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[297.882636, "o", "            m = np.load(f'{rec_dir}/human_pixel_masks.npy').astype(np.float32).squeeze()\r\n\u001b[?2004l\r\u001b[?2004h"]
[297.882691, "o", "> "]
[297.882744, "o", "            y = torch.from_numpy(m).unsqueeze(0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[297.882793, "o", ">             return x, y\r\n\u001b[?2004l\r\u001b[?2004h> "]
[297.88284, "o", "        except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h"]
[297.882891, "o", "> "]
[297.882941, "o", "            print(f\"Error loading {rid}: {e}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[297.883001, "o", "            # Return dummy data in case of corruption to avoid crashing\r\n\u001b[?2004l\r\u001b[?2004h"]
[297.883048, "o", "> "]
[297.883095, "o", "            x = torch.zeros((3, 256, 256))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[297.883147, "o", "            if self.is_test: return rid, x\r\n\u001b[?2004l\r"]
[297.883195, "o", "\u001b[?2004h>             return x, torch.zeros((1, 256, 256))"]
[297.883251, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[297.883298, "o", "class SimpleUNet(nn.Module):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[297.883345, "o", "    def __init__(self):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[297.883392, "o", "        super().__init__()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[297.883439, "o", "        self.enc1 = self.conv_block(3, 16)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[297.883508, "o", "        self.enc2 = self.conv_block(16, 32)\r\n\u001b[?2004l\r\u001b[?2004h"]
[297.883558, "o", "> "]
[297.883656, "o", "        self.enc3 = self.conv_block(32, 64)\r\n\u001b[?2004l\r\u001b[?2004h>         self.pool = nn.MaxPool2d(2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[297.883729, "o", "        self.up2 = nn.ConvTranspose2d(64, 32, 2, stride=2)\r\n\u001b[?2004l\r"]
[297.883775, "o", "\u001b[?2004h> "]
[297.883827, "o", "        self.dec2 = self.conv_block(64, 32)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[297.883891, "o", "        self.up1 = nn.ConvTranspose2d(32, 16, 2, stride=2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[297.883957, "o", "        self.dec1 = self.conv_block(32, 16)\r\n\u001b[?2004l\r\u001b[?2004h"]
[297.884003, "o", "> "]
[297.884052, "o", "        self.final = nn.Conv2d(16, 1, 1)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[297.884103, "o", "    def conv_block(self, in_ch, out_ch):\r\n\u001b[?2004l\r\u001b[?2004h"]
[297.884158, "o", ">         return nn.Sequential(\r\n\u001b[?2004l\r"]
[297.884204, "o", "\u001b[?2004h> "]
[297.884253, "o", "            nn.Conv2d(in_ch, out_ch, 3, padding=1),\r\n\u001b[?2004l\r\u001b[?2004h"]
[297.884301, "o", ">             nn.ReLU(inplace=True),"]
[297.884356, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[297.884402, "o", "            nn.Conv2d(out_ch, out_ch, 3, padding=1),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[297.884451, "o", "            nn.ReLU(inplace=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[297.884499, "o", ">         )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[297.884554, "o", "    def forward(self, x):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[297.884607, "o", "        e1 = self.enc1(x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[297.88467, "o", "        e2 = self.enc2(self.pool(e1))\r\n\u001b[?2004l\r\u001b[?2004h"]
[297.884726, "o", ">         e3 = self.enc3(self.pool(e2))\r\n\u001b[?2004l\r\u001b[?2004h"]
[297.884775, "o", ">         d2 = self.up2(e3)\r\n\u001b[?2004l\r\u001b[?2004h"]
[297.884825, "o", "> "]
[297.884871, "o", "        d2 = torch.cat([d2, e2], dim=1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[297.884932, "o", "        d2 = self.dec2(d2)\r\n\u001b[?2004l\r\u001b[?2004h>         d1 = self.up1(d2)\r\n\u001b[?2004l\r"]
[297.884986, "o", "\u001b[?2004h> "]
[297.885036, "o", "        d1 = torch.cat([d1, e1], dim=1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[297.885085, "o", "        d1 = self.dec1(d1)\r\n\u001b[?2004l\r\u001b[?2004h>         return self.final(d1)\r\n"]
[297.885134, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def rle(mask):"]
[297.885182, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[297.885228, "o", "    flat = mask.reshape(-1)\r\n\u001b[?2004l\r\u001b[?2004h>     if flat.sum() == 0:\r\n"]
[297.885276, "o", "\u001b[?2004l\r\u001b[?2004h>         return ''\r\n\u001b[?2004l\r"]
[297.885321, "o", "\u001b[?2004h> "]
[297.885388, "o", "    d = np.diff(np.concatenate([[0], flat, [0]]))\r\n\u001b[?2004l\r"]
[297.885437, "o", "\u001b[?2004h>     starts, ends = np.where(d == 1)[0], np.where(d == -1)[0]\r\n"]
[297.885486, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[297.885547, "o", "    return ' '.join(f'{s} {e - s}' for s, e in zip(starts, ends))\r\n\u001b[?2004l\r\u001b[?2004h"]
[297.885602, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[297.885654, "o", "train_ids = sorted(os.listdir('train'))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[297.885708, "o", "test_ids = sorted(os.listdir('test'))\r\n\u001b[?2004l\r\u001b[?2004h"]
[297.885765, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[297.885813, "o", "split = int(0.9 * len(train_ids))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[297.885866, "o", "train_set = ContrailDataset('train', train_ids[:split])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[297.885945, "o", "val_set = ContrailDataset('train', train_ids[split:])\r\n\u001b[?2004l\r\u001b[?2004h"]
[297.885993, "o", "> "]
[297.886047, "o", "train_loader = DataLoader(train_set, batch_size=4, shuffle=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[297.88611, "o", "val_loader = DataLoader(val_set, batch_size=4)\r\n\u001b[?2004l\r\u001b[?2004h"]
[297.886159, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[297.886207, "o", "model = SimpleUNet().to(DEVICE)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[297.886263, "o", "opt = torch.optim.Adam(model.parameters(), lr=1e-3)\r\n\u001b[?2004l\r\u001b[?2004h"]
[297.88631, "o", "> criterion = nn.BCEWithLogitsLoss()"]
[297.886359, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[297.886406, "o", "epochs = 3\r\n\u001b[?2004l\r\u001b[?2004h> "]
[297.886459, "o", "for epoch in range(epochs):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[297.886507, "o", "    model.train()\r\n\u001b[?2004l\r\u001b[?2004h>     train_loss = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[297.886563, "o", "    for x, y in train_loader:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[297.886632, "o", "        x, y = x.to(DEVICE), y.to(DEVICE)\r\n\u001b[?2004l\r\u001b[?2004h"]
[297.886697, "o", ">         opt.zero_grad()"]
[297.886742, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>         pred = model(x)\r\n\u001b[?2004l\r"]
[297.886791, "o", "\u001b[?2004h>         loss = criterion(pred, y)\r\n\u001b[?2004l\r"]
[297.886838, "o", "\u001b[?2004h> "]
[297.886887, "o", "        loss.backward()\r\n\u001b[?2004l\r\u001b[?2004h>         opt.step()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[297.88694, "o", "        train_loss += loss.item()\r\n\u001b[?2004l\r\u001b[?2004h"]
[297.886992, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h>     model.eval()\r\n\u001b[?2004l\r"]
[297.887039, "o", "\u001b[?2004h>     val_loss = 0\r\n\u001b[?2004l\r"]
[297.887088, "o", "\u001b[?2004h> "]
[297.887138, "o", "    with torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h"]
[297.887191, "o", ">         for x, y in val_loader:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[297.88725, "o", "            x, y = x.to(DEVICE), y.to(DEVICE)\r\n\u001b[?2004l\r\u001b[?2004h"]
[297.887305, "o", "> "]
[297.887352, "o", "            val_loss += criterion(model(x), y).item()\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[297.887408, "o", "\u001b[?2004h> "]
[297.887528, "o", "    print(f'Epoch {epoch+1}/{epochs} - Train Loss: {train_loss/len(train_loader):.4f} - Val Loss: {val_loss/len(val_loader):.4f}')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[297.887596, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[297.887648, "o", "test_set = ContrailDataset('test', test_ids, is_test=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[297.887699, "o", "> "]
[297.887775, "o", "test_loader = DataLoader(test_set, batch_size=4)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> model.eval()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[297.887828, "o", "rows = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[297.887879, "o", "with torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[297.887927, "o", "    for rid, x in test_loader:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[297.887972, "o", "        x = x.to(DEVICE)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[297.888026, "o", "        preds = torch.sigmoid(model(x)).cpu().numpy()\r\n\u001b[?2004l\r\u001b[?2004h"]
[297.888072, "o", ">         for i in range(len(rid)):\r\n\u001b[?2004l\r"]
[297.888121, "o", "\u001b[?2004h> "]
[297.888167, "o", "            mask = (preds[i, 0] > 0.5).astype(np.uint8)\r\n\u001b[?2004l\r\u001b[?2004h"]
[297.888219, "o", "> "]
[297.888272, "o", "            rows.append({'record_id': rid[i], 'rle': rle(mask)})\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[297.888324, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[297.888369, "o", "pd.DataFrame(rows).to_csv('submission.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h"]
[297.888421, "o", "> "]
[297.888466, "o", "print('wrote submission.csv')\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[297.889558, "o", "\u001b[?2004hroot@2c5c968541ec:/workspace# "]
[298.016459, "i", "python3 train.py\n"]
[298.016798, "o", "python3 train.py\r\n\u001b[?2004l\r"]
