[9.069508, "o", "import ast\r\nimport numpy as np\r\n"]
[9.069574, "o", "import pandas as pd\r\nimport torch\r\nimport torch.nn as nn\r\nfrom PIL import Image\r\n\r\ndevice = ('cuda' if torch.cuda.is_available()\r\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\r\nprint('DEVICE=', device)\r\n\r\nSIZE = 64\r\nN_CLASSES = 290\r\nBATCH_SIZE = 32\r\nEPOCH = 1                       # the original starter also trains for a single epoch\r\n\r\n\r\ndef load(ids):"]
[9.069664, "o", "\r\n    out = []\r\n    for i in ids:\r\n        for ext in ('.png', '.jpg', '.jpeg'):\r\n            p = f'images/{i}{ext}'\r\n            try:\r\n                out.append(np.asarray(Image.open(p).convert('RGB').resize((SIZE, SIZE)),\r\n                                      dtype=np.float32) / 255.0)\r\n                break\r\n            except FileNotFoundError:\r\n                continue\r\n        else:\r\n            out.append(np.zeros((SIZE, SIZE, 3), dtype=np.float32))\r\n    return np.stack(out)\r\n\r\n\r\ntrain = pd.read_csv('train.csv')\r\ntest = pd.read_csv('test.csv')\r\nX = torch.tensor(load(train['id'].values)).permute(0, 3, 1, 2)\r\nY = torch.zeros(len(train), N_CLASSES)\r\nfor r, cats in enumerate(train['categories']):\r\n    for c in ast.literal_eval(str(cats)):\r\n        if 0 <= int(c) < N_CLASSES:\r\n            Y[r, int(c)] = 1.0\r\n\r\nmodel = nn.Sequential(\r\n    nn.Conv2d(3, 16, 3, padding=1), nn.ReLU(), nn.MaxPool2d(2),\r\n    nn.Flatten(), nn.Linear(16 * (SIZE // 2) ** 2, N_CLASSES)).to(device)\r\nopt = torch.optim.Adam(model.parameters(), lr=1e-3)\r\nlossf = nn.BCEWithLogitsLoss()\r\n\r\nfor epoch in range(EPOCH):\r\n    model.train()"]
[9.069764, "o", "\r\n    for i in range(0, len(X), BATCH_SIZE):\r\n        xb, yb = X[i:i + BATCH_SIZE].to(device), Y[i:i + BATCH_SIZE].to(device)\r\n        opt.zero_grad()\r\n        loss = lossf(model(xb), yb)\r\n        loss.backward()\r\n        opt.step()\r\n    print(f'epoch {epoch} loss {loss.item():.4f}')\r\n\r\nXte = torch.tensor(load(test['id'].values)).permute(0, 3, 1, 2)\r\nmodel.eval()\r\nrows = []\r\nwith torch.no_grad():\r\n    for i in range(0, len(Xte), BATCH_SIZE):\r\n        p = torch.sigmoid(model(Xte[i:i + BATCH_SIZE].to(device))).cpu().numpy()\r\n        for r in p:\r\n            rows.append(sorted(np.where(r > 0.5)[0].tolist()))\r\npd.DataFrame({'id': test['id'], 'categories': [str(r) for r in rows]}).to_csv('submission.csv', index=False)\r\nprint('wrote submission.csv')\r\n"]
