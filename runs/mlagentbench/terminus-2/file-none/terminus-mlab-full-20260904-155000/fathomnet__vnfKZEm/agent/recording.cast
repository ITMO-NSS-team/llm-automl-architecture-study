[6519.899275, "o", "\u001b[?2004hroot@103d752e1de6:/workspace# C-c"]
[6519.899574, "o", "\r\n\u001b[?2004l\r"]
[6519.89968, "o", "bash: C-c: command not found\r\n"]
[6519.899826, "o", "\u001b[?2004hroot@103d752e1de6:/workspace# "]
[6519.899894, "o", "cat << 'EOF' > train.py\r\n\u001b[?2004l\r"]
[6519.899943, "o", "\u001b[?2004h> "]
[6519.900082, "o", "import ast\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6519.900148, "o", "import pandas as pd\r\n\u001b[?2004l\r\u001b[?2004h> import torch\r\n\u001b[?2004l\r"]
[6519.9002, "o", "\u001b[?2004h> "]
[6519.900287, "o", "import torch.nn as nn\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6519.900359, "o", "from torch.utils.data import Dataset, DataLoader\r\n\u001b[?2004l\r"]
[6519.900419, "o", "\u001b[?2004h> "]
[6519.900471, "o", "from PIL import Image\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6519.900543, "o", "import torchvision.models as models\r\n\u001b[?2004l\r"]
[6519.900596, "o", "\u001b[?2004h> "]
[6519.90068, "o", "import torchvision.transforms as transforms\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[6519.900724, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[6519.900778, "o", "# Hardware resolution snippet\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6519.900825, "o", "DEVICE = ('cuda' if torch.cuda.is_available()\r\n\u001b[?2004l\r\u001b[?2004h"]
[6519.900874, "o", "> "]
[6519.900934, "o", "          else 'mps' if torch.backends.mps.is_available() else 'cpu')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6519.900981, "o", "print('DEVICE=', DEVICE)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[6519.901039, "o", "\u001b[?2004l\r\u001b[?2004h> SIZE = 64\r\n\u001b[?2004l\r\u001b[?2004h"]
[6519.901089, "o", "> N_CLASSES = 290\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6519.901137, "o", "BATCH_SIZE = 32\r\n\u001b[?2004l\r\u001b[?2004h> EPOCHS = 2\r\n\u001b[?2004l\r"]
[6519.901191, "o", "\u001b[?2004h> LR = 1e-4\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[6519.901265, "o", "\u001b[?2004h> "]
[6519.901326, "o", "class FathomDataset(Dataset):\r\n\u001b[?2004l\r\u001b[?2004h>     def __init__(self, ids, labels=None, transform=None):\r\n\u001b[?2004l\r\u001b[?2004h"]
[6519.901398, "o", ">         self.ids = ids\r\n\u001b[?2004l\r"]
[6519.901454, "o", "\u001b[?2004h>         self.labels = labels\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6519.901502, "o", "        self.transform = transform\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[6519.901548, "o", "\u001b[?2004h>     def __len__(self):\r\n\u001b[?2004l\r"]
[6519.901591, "o", "\u001b[?2004h>         return len(self.ids)\r\n"]
[6519.90165, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[6519.901707, "o", "    def __getitem__(self, idx):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6519.901778, "o", "        img_id = self.ids[idx]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6519.901833, "o", "        img = None\r\n\u001b[?2004l\r\u001b[?2004h>         for ext in ('.png', '.jpg', '.jpeg'):\r\n\u001b[?2004l\r"]
[6519.901895, "o", "\u001b[?2004h> "]
[6519.901981, "o", "            p = f'images/{img_id}{ext}'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6519.901997, "o", "            try:\r\n\u001b[?2004l\r\u001b[?2004h>                 img = Image.open(p).convert('RGB')\r\n\u001b[?2004l\r"]
[6519.902061, "o", "\u001b[?2004h> "]
[6519.902125, "o", "                break\r\n\u001b[?2004l\r\u001b[?2004h>             except FileNotFoundError:\r\n\u001b[?2004l\r"]
[6519.902187, "o", "\u001b[?2004h>                 continue\r\n\u001b[?2004l\r"]
[6519.902241, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[6519.902291, "o", "        if img is None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6519.90234, "o", "            img = Image.new('RGB', (SIZE, SIZE), (0, 0, 0))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6519.902391, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6519.902443, "o", "            img = img.resize((SIZE, SIZE))\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r"]
[6519.902491, "o", "\u001b[?2004h> "]
[6519.902542, "o", "        if self.transform:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6519.90259, "o", "            img = self.transform(img)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6519.902649, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[6519.902711, "o", "        if self.labels is not None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6519.902762, "o", "            label = torch.zeros(N_CLASSES)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6519.90281, "o", "            cats = ast.literal_eval(str(self.labels[idx]))\r\n\u001b[?2004l\r"]
[6519.902857, "o", "\u001b[?2004h>             for c in cats:\r\n"]
[6519.902909, "o", "\u001b[?2004l\r\u001b[?2004h>                 cid = int(float(c))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6519.902954, "o", "                if 0 <= cid < N_CLASSES:\r\n\u001b[?2004l\r"]
[6519.903009, "o", "\u001b[?2004h> "]
[6519.903057, "o", "                    label[cid] = 1.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6519.903113, "o", "            return img, label\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6519.903152, "o", "        return img\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[6519.903209, "o", "# Transforms\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6519.903255, "o", "train_transform = transforms.Compose([\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6519.903305, "o", "    transforms.ToTensor(),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6519.903365, "o", "    transforms.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225])\r\n\u001b[?2004l\r"]
[6519.903418, "o", "\u001b[?2004h> ])\r\n\u001b[?2004l\r"]
[6519.903468, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> test_transform = transforms.Compose([\r\n\u001b[?2004l\r"]
[6519.903516, "o", "\u001b[?2004h> "]
[6519.903564, "o", "    transforms.ToTensor(),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6519.903617, "o", "    transforms.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225])\r\n\u001b[?2004l\r"]
[6519.903691, "o", "\u001b[?2004h> ])\r\n\u001b[?2004l\r"]
[6519.903743, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[6519.903796, "o", "train_df = pd.read_csv('train.csv')\r\n\u001b[?2004l\r\u001b[?2004h> test_df = pd.read_csv('test.csv')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[6519.903842, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[6519.903922, "o", "train_ds = FathomDataset(train_df['id'].values, train_df['categories'].values, transform=train_transform)\r\n\u001b[?2004l\r"]
[6519.903985, "o", "\u001b[?2004h> "]
[6519.904035, "o", "train_loader = DataLoader(train_ds, batch_size=BATCH_SIZE, shuffle=True)\r\n\u001b[?2004l\r"]
[6519.904083, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[6519.904132, "o", "model = models.resnet18(pretrained=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6519.904189, "o", "model.fc = nn.Linear(model.fc.in_features, N_CLASSES)\r\n\u001b[?2004l\r"]
[6519.904237, "o", "\u001b[?2004h> "]
[6519.904287, "o", "model = model.to(DEVICE)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[6519.904337, "o", "optimizer = torch.optim.Adam(model.parameters(), lr=LR)\r\n\u001b[?2004l\r"]
[6519.90438, "o", "\u001b[?2004h> "]
[6519.904428, "o", "criterion = nn.BCEWithLogitsLoss()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[6519.904466, "o", "\u001b[?2004h> for epoch in range(EPOCHS):\r\n\u001b[?2004l\r"]
[6519.904519, "o", "\u001b[?2004h>     model.train()\r\n\u001b[?2004l\r"]
[6519.904569, "o", "\u001b[?2004h>     running_loss = 0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6519.90461, "o", "    for images, labels in train_loader:\r\n\u001b[?2004l\r"]
[6519.904673, "o", "\u001b[?2004h> "]
[6519.904734, "o", "        images, labels = images.to(DEVICE), labels.to(DEVICE)\r\n\u001b[?2004l\r"]
[6519.904828, "o", "\u001b[?2004h>         optimizer.zero_grad()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6519.904845, "o", "        outputs = model(images)\r\n\u001b[?2004l\r\u001b[?2004h>         loss = criterion(outputs, labels)"]
[6519.904875, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[6519.904983, "o", ">         loss.backward()\r\n\u001b[?2004l\r"]
[6519.905012, "o", "\u001b[?2004h>         optimizer.step()\r\n\u001b[?2004l\r\u001b[?2004h>         running_loss += loss.item()\r\n\u001b[?2004l\r"]
[6519.90506, "o", "\u001b[?2004h> "]
[6519.905135, "o", "    print(f'Epoch {epoch+1}/{EPOCHS}, Loss: {running_loss/len(train_loader):.4f}')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[6519.905165, "o", "\u001b[?2004l\r\u001b[?2004h> # Inference\r\n\u001b[?2004l\r"]
[6519.90522, "o", "\u001b[?2004h> "]
[6519.905273, "o", "test_ds = FathomDataset(test_df['id'].values, transform=test_transform)\r\n\u001b[?2004l\r"]
[6519.90532, "o", "\u001b[?2004h> "]
[6519.90537, "o", "test_loader = DataLoader(test_ds, batch_size=BATCH_SIZE, shuffle=False)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[6519.905397, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[6519.905452, "o", "model.eval()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6519.90549, "o", "all_preds = []\r\n\u001b[?2004l\r\u001b[?2004h> with torch.no_grad():\r\n\u001b[?2004l\r"]
[6519.905542, "o", "\u001b[?2004h> "]
[6519.905594, "o", "    for images in test_loader:\r\n\u001b[?2004l\r\u001b[?2004h>         images = images.to(DEVICE)"]
[6519.905665, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6519.905725, "o", "        logits = model(images)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6519.9058, "o", "        probs = torch.sigmoid(logits).cpu().numpy()\r\n\u001b[?2004l\r"]
[6519.90585, "o", "\u001b[?2004h> "]
[6519.905905, "o", "        for p in probs:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6519.905952, "o", "            # Use a threshold of 0.5\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6519.905999, "o", "            pred_cats = np.where(p > 0.5)[0].tolist()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6519.906051, "o", "            all_preds.append(sorted(pred_cats))\r\n\u001b[?2004l\r"]
[6519.9061, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[6519.90615, "o", "# Check for collapse\r\n\u001b[?2004l\r\u001b[?2004h> "]
[6519.906225, "o", "pred_matrix = np.array([[1 if i in p else 0 for i in range(N_CLASSES)] for p in all_preds])\r\n\u001b[?2004l\r"]
[6519.906276, "o", "\u001b[?2004h> "]
[6519.90633, "o", "distinct_counts = [len(np.unique(pred_matrix[:, i])) for i in range(N_CLASSES)]\r\n\u001b[?2004l\r"]
[6519.906378, "o", "\u001b[?2004h> "]
[6519.906437, "o", "print('Distinct values per column:', distinct_counts)\r\n\u001b[?2004l\r"]
[6519.906474, "o", "\u001b[?2004h> "]
[6519.906527, "o", "if any(c < 10 for c in distinct_counts):\r\n\u001b[?2004l\r\u001b[?2004h> "]
