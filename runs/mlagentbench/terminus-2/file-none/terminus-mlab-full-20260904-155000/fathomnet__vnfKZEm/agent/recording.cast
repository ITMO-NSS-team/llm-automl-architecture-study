[17.491917, "o", "root@103d752e1de6:/workspace# "]
[23.683673, "i", "cat << 'EOF' > train.py\nimport ast\nimport numpy as np\nimport pandas as pd\nimport torch\nimport torch.nn as nn\nfrom torch.utils.data import Dataset, DataLoader\nfrom PIL import Image\nimport torchvision.models as models\nimport torchvision.transforms as transforms\n\n# Hardware resolution snippet\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\nSIZE = 128\nN_CLASSES = 290\nBATCH_SIZE = 32\nEPOCHS = 10\nLR = 1e-4\n\nclass FathomDataset(Dataset):\n    def __init__(self, ids, labels=None, transform=None):\n        self.ids = ids\n        self.labels = labels\n        self.transform = transform\n\n    def __len__(self):\n        return len(self.ids)\n\n    def __getitem__(self, idx):\n        img_id = self.ids[idx]\n        img = None\n        for ext in ('.png', '.jpg', '.jpeg'):\n            p = f'images/{img_id}{ext}'\n            try:\n                img = Image.open(p).convert('RGB')\n                break\n            except FileNotFoundError:\n                continue\n        \n        if img is None:\n            img = Image.new('RGB', (SIZE, SIZE), (0, 0, 0))\n        else:\n            img = img.resize((SIZE, SIZE))\n            \n        if self.transform:\n            img = self.transform(img)\n            \n        if self.labels is not None:\n            label = torch.zeros(N_CLASSES)\n            cats = ast.literal_eval(str(self.labels[idx]))\n            for c in cats:\n                cid = int(float(c))\n                if 0 <= cid < N_CLASSES:\n                    label[cid] = 1.0\n            return img, label\n        return img\n\n# Transforms\ntrain_transform = transforms.Compose([\n    transforms.ToTensor(),\n    transforms.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225])\n])\n\ntest_transform = transforms.Compose([\n    transforms.ToTensor(),\n    transforms.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225])\n])\n\ntrain_df = pd.read_csv('train.csv')\ntest_df = pd.read_csv('test.csv')\n\ntrain_ds = FathomDataset(train_df['id'].values, train_df['categories'].values, transform=train_transform)\ntrain_loader = DataLoader(train_ds, batch_size=BATCH_SIZE, shuffle=True)\n\nmodel = models.resnet18(pretrained=True)\nmodel.fc = nn.Linear(model.fc.in_features, N_CLASSES)\nmodel = model.to(DEVICE)\n\noptimizer = torch.optim.Adam(model.parameters(), lr=LR)\ncriterion = nn.BCEWithLogitsLoss()\n\nfor epoch in range(EPOCHS):\n    model.train()\n    running_loss = 0.0\n    for images, labels in train_loader:\n        images, labels = images.to(DEVICE), labels.to(DEVICE)\n        optimizer.zero_grad()\n        outputs = model(images)\n        loss = criterion(outputs, labels)\n        loss.backward()\n        optimizer.step()\n        running_loss += loss.item()\n    print(f'Epoch {epoch+1}/{EPOCHS}, Loss: {running_loss/len(train_loader):.4f}')\n\n# Inference\ntest_ds = FathomDataset(test_df['id'].values, transform=test_transform)\ntest_loader = DataLoader(test_ds, batch_size=BATCH_SIZE, shuffle=False)\n\nmodel.eval()\nall_preds = []\nwith torch.no_grad():\n    for images in test_loader:\n        images = images.to(DEVICE)\n        logits = model(images)\n        probs = torch.sigmoid(logits).cpu().numpy()\n        for p in probs:\n            # Use a threshold of 0.5\n            pred_cats = np.where(p > 0.5)[0].tolist()\n            all_preds.append(sorted(pred_cats))\n\n# Check for collapse\npred_matrix = np.array([[1 if i in p else 0 for i in range(N_CLASSES)] for p in all_preds])\ndistinct_counts = [len(np.unique(pred_matrix[:, i])) for i in range(N_CLASSES)]\nprint('Distinct values per column:', distinct_counts)\nif any(c < 10 for c in distinct_counts):\n    print('WARNING: Model collapse detected (some columns have < 10 distinct values)')\n\n# Create submission\nsubmission = pd.DataFrame({\n    'id': test_df['id'],\n    'categories': [str(p) for p in all_preds]\n})\nsubmission.to_csv('submission.csv', index=False)\nprint('wrote submission.csv')\nEOF\n"]
