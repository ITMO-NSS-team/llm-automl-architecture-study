[32.356154, "i", "cat << 'EOF' > baseline.py\nimport pandas as pd\nfrom sklearn.metrics import roc_auc_score\n\ndef run_baseline():\n    val = pd.read_csv('/app/data/val.csv')\n    target = val['target']\n    \n    # Trivial baseline: training mean (or val mean for a quick check)\n    train = pd.read_csv('/app/data/train.csv')\n    mean_val = train['target'].mean()\n    \n    # Predicting the mean for all samples\n    preds = [mean_val] * len(target)\n    score = roc_auc_score(target, preds)\n    \n    # Note: ROC-AUC for a constant predictor is usually 0.5\n    # But let's check the distribution\n    print(f\"TRAIN_MEAN={mean_val}\")\n    print(f\"BASELINE_ROC_AUC={score}\")\n\nif __name__ == '__main__':\n    run_baseline()\nEOF\n"]
[32.356769, "o", "cat << 'EOF' > baseline.py"]
