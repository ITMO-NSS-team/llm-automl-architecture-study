[32.956497, "o", "\u001b[?2004hroot@9ce4e76fe47b:/workspace# python3 baseline.py\r\n\u001b[?2004l\r"]
[36.971182, "o", "TRAIN_MEAN=0.18878833808844508\r\nBASELINE_ROC_AUC=0.5\r\n"]
[37.154138, "o", "\u001b[?2004hroot@9ce4e76fe47b:/workspace# "]
[45.088638, "i", "cat << 'EOF' > baseline.py\nimport pandas as pd\nimport numpy as np\nfrom sklearn.metrics import roc_auc_score\n\ndef run_baseline():\n    try:\n        val = pd.read_csv('/app/data/val.csv')\n        target = val['target']\n        train = pd.read_csv('/app/data/train.csv')\n        mean_val = train['target'].mean()\n        # Constant prediction\n        preds = np.full(len(target), mean_val)\n        # roc_auc_score might fail if only one class is present in preds\n        # but conceptually it is 0.5\n        try:\n            score = roc_auc_score(target, preds)\n        except ValueError:\n            score = 0.5\n        print(f\"TRAIN_MEAN={mean_val}\")\n        print(f\"BASELINE_ROC_AUC={score}\")\n    except Exception as e:\n        print(f\"Error: {e}\")\n\nif __name__ == '__main__':\n    run_baseline()\nEOF\n"]
