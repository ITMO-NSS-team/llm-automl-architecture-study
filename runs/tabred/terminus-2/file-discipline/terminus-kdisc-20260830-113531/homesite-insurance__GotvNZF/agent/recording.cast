[72.106152, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[72.106243, "o", ">         'boosting_type': 'gbdt',"]
[72.106289, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>         'random_state': 42,"]
[72.106367, "o", "\r\n\u001b[?2004l\r"]
[72.106403, "o", "\u001b[?2004h>         'learning_rate': 0.05,"]
[72.106485, "o", "\r\n"]
[72.106534, "o", "\u001b[?2004l\r\u001b[?2004h>         'num_leaves': 31,"]
[72.106609, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.106654, "o", "        'feature_fraction': 0.8,"]
[72.106729, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[72.106782, "o", ">         'bagging_fraction': 0.8,"]
[72.106856, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[72.106898, "o", ">         'bagging_freq': 5,"]
[72.106956, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[72.107048, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[72.107101, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h>     # Train with early stopping"]
[72.107188, "o", "\r\n"]
[72.107263, "o", "\u001b[?2004l\r\u001b[?2004h>     model = lgb.train("]
[72.107314, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>         params,"]
[72.107387, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.107451, "o", "        train_data,\r\n\u001b[?2004l\r\u001b[?2004h"]
[72.107496, "o", ">         num_boost_round=2000,"]
[72.107588, "o", "\r\n\u001b[?2004l\r"]
[72.107636, "o", "\u001b[?2004h>         valid_sets=[train_data, val_data],"]
[72.107728, "o", "\r\n\u001b[?2004l\r"]
[72.107756, "o", "\u001b[?2004h>         valid_names=['train', 'valid'],"]
[72.107921, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[72.107971, "o", ">         callbacks=[lgb.early_stopping(stopping_rounds=100), lgb.log_evaluation(period=100)]"]
[72.108024, "o", "\r\n"]
[72.108114, "o", "\u001b[?2004l\r\u001b[?2004h"]
[72.108166, "o", ">     )\r\n\u001b[?2004l\r"]
[72.108259, "o", "\u001b[?2004h> \r\n"]
[72.108307, "o", "\u001b[?2004l\r\u001b[?2004h>     # Predict and evaluate"]
[72.108388, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.108431, "o", "    val_preds = model.predict(X_val)"]
[72.10852, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[72.108577, "o", ">     score = roc_auc_score(y_val, val_preds)"]
[72.108651, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[72.108696, "o", ">     print(f\"VALIDATION_SCORE={score}\")"]
[72.108786, "o", "\r\n\u001b[?2004l\r"]
[72.108824, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     if score <= 0.5:"]
[72.108937, "o", "\r\n\u001b[?2004l\r"]
[72.108985, "o", "\u001b[?2004h>         print(\"Model failed to beat trivial baseline!\")"]
[72.109133, "o", "\r\n\u001b[?2004l\r"]
[72.109177, "o", "\u001b[?2004h>         # In this case, we'll still proceed but the prompt warns against it."]
[72.109202, "o", "\r\n"]
[72.109333, "o", "\u001b[?2004l\r\u001b[?2004h"]
[72.109384, "o", ">         # For a real submission we'd try a different model."]
[72.109434, "o", "\r\n\u001b[?2004l\r"]
[72.109535, "o", "\u001b[?2004h"]
[72.109586, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h>     # Generate test predictions"]
[72.109655, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.109705, "o", "    test_preds = model.predict(X_test)"]
[72.109793, "o", "\r\n\u001b[?2004l\r"]
[72.10984, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Sanity check"]
[72.109962, "o", "\r\n\u001b[?2004l\r"]
[72.110011, "o", "\u001b[?2004h>     if np.isnan(test_preds).any() or np.isinf(test_preds).any():"]
[72.110136, "o", "\r\n"]
[72.110182, "o", "\u001b[?2004l\r\u001b[?2004h>         print(\"Error: Non-finite predictions detected!\")"]
[72.110238, "o", "\r\n\u001b[?2004l\r"]
[72.110323, "o", "\u001b[?2004h"]
[72.11038, "o", ">         test_preds = np.nan_to_num(test_preds)"]
[72.110505, "o", "\r\n\u001b[?2004l\r"]
[72.110526, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     submission = pd.DataFrame({'target': test_preds})"]
[72.110564, "o", "\r\n"]
[72.11068, "o", "\u001b[?2004l\r\u001b[?2004h>     submission.to_csv('/app/predictions.csv', index=False)"]
[72.110743, "o", "\r\n"]
[72.110833, "o", "\u001b[?2004l\r\u001b[?2004h"]
[72.110879, "o", ">     print(\"Predictions saved to /app/predictions.csv\")"]
[72.110919, "o", "\r\n\u001b[?2004l\r"]
[72.110972, "o", "\u001b[?2004h"]
[72.111048, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.11113, "o", "if __name__ == '__main__':"]
[72.111192, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     solve()"]
