[?2004l[?2004h>           else 'mps' if torch.backends.mps.is_available() else 'cpu')
[?2004l[?2004h> print('DEVICE=', DEVICE)
[?2004l[?2004h> 
[?2004l[?2004h> def solve():
[?2004l[?2004h>     # Load schema
[?2004l[?2004h>     with open('/app/data/schema.json', 'r') as f:
[?2004l[?2004h>         schema = json.load(f)
[?2004l[?2004h>     
[?2004l[?2004h>     features = schema['feature_columns']
[?2004l[?2004h>     target_col = schema['target_column']
[?2004l[?2004h>     
[?2004l[?2004h>     # Load data
[?2004l[?2004h>     train_df = pd.read_csv('/app/data/train.csv')
[?2004l[?2004h>     val_df = pd.read_csv('/app/data/val.csv')
[?2004l[?2004h>     test_df = pd.read_csv('/app/data/test.csv')
[?2004l[?2004h>     
[?2004l[?2004h>     X_train = train_df[features]
[?2004l[?2004h>     y_train = train_df[target_col]
[?2004l[?2004h>     X_val = val_df[features]
[?2004l[?2004h>     y_val = val_df[target_col]
[?2004l[?2004h>     X_test = test_df[features]
[?2004l[?2004h>     
[?2004l[?2004h>     # Identify categorical features
[?2004l[?2004h>     cat_features = [col for col in features if col.startswith('cat_') or col.startswith('bin_')]
[?2004l[?2004h>     for col in cat_features:
[?2004l[?2004h>         X_train[col] = X_train[col].astype('category')
[?2004l[?2004h>         X_val[col] = X_val[col].astype('category')
[?2004l[?2004h>         X_test[col] = X_test[col].astype('category')
[?2004l[?2004h> 
[?2004l[?2004h>     # LightGBM Dataset
[?2004l[?2004h>     train_data = lgb.Dataset(X_train, label=y_train)
[?2004l[?2004h>     val_data = lgb.Dataset(X_val, label=y_val, reference=train_data)
[?2004l[?2004h> 
[?2004l[?2004h>     params = {
[?2004l[?2004h>         'objective': 'binary',
[?2004l[?2004h>         'metric': 'auc',
[?2004l[?2004h>         'verbosity': -1,
[?2004l[?2004h>         'boosting_type': 'gbdt',
[?2004l[?2004h>         'random_state': 42,
[?2004l[?2004h>         'learning_rate': 0.05,
[?2004l[?2004h>         'num_leaves': 31,
[?2004l[?2004h>         'feature_fraction': 0.8,
[?2004l[?2004h>         'bagging_fraction': 0.8,
[?2004l[?2004h>         'bagging_freq': 5,
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     # Train with early stopping
[?2004l[?2004h>     model = lgb.train(
[?2004l[?2004h>         params,
[?2004l[?2004h>         train_data,
[?2004l[?2004h>         num_boost_round=2000,
[?2004l[?2004h>         valid_sets=[train_data, val_data],
[?2004l[?2004h>         valid_names=['train', 'valid'],
[?2004l[?2004h>         callbacks=[lgb.early_stopping(stopping_rounds=100), lgb.log_evaluation(period=100)]
[?2004l[?2004h>     )
[?2004l[?2004h> 
[?2004l[?2004h>     # Predict and evaluate
[?2004l[?2004h>     val_preds = model.predict(X_val)
[?2004l[?2004h>     score = roc_auc_score(y_val, val_preds)
[?2004l[?2004h>     print(f"VALIDATION_SCORE={score}")
[?2004l[?2004h> 
[?2004l[?2004h>     if score <= 0.5:
[?2004l[?2004h>         print("Model failed to beat trivial baseline!")
[?2004l[?2004h>         # In this case, we'll still proceed but the prompt warns against it.
[?2004l[?2004h>         # For a real submission we'd try a different model.
[?2004l[?2004h> 
[?2004l[?2004h>     # Generate test predictions
[?2004l[?2004h>     test_preds = model.predict(X_test)
[?2004l[?2004h>     
[?2004l[?2004h>     # Sanity check
