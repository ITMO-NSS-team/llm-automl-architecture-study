[?2004hroot@9ce4e76fe47b:/workspace# cat << 'EOF' > baseline.py
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from sklearn.metrics import roc_auc_score
[?2004l[?2004h> 
[?2004l[?2004h> def run_baseline():
[?2004l[?2004h>     try:
[?2004l[?2004h>         val = pd.read_csv('/app/data/val.csv')
[?2004l[?2004h>         target = val['target']
[?2004l[?2004h>         train = pd.read_csv('/app/data/train.csv')
[?2004l[?2004h>         mean_val = train['target'].mean()
[?2004l[?2004h>         # Constant prediction
[?2004l[?2004h>         preds = np.full(len(target), mean_val)
[?2004l[?2004h>         # roc_auc_score might fail if only one class is present in preds
[?2004l[?2004h>         # but conceptually it is 0.5
[?2004l[?2004h>         try:
[?2004l[?2004h>             score = roc_auc_score(target, preds)
[?2004l[?2004h>         except ValueError:
[?2004l[?2004h>             score = 0.5
[?2004l[?2004h>         print(f"TRAIN_MEAN={mean_val}")
[?2004l[?2004h>         print(f"BASELINE_ROC_AUC={score}")
[?2004l[?2004h>     except Exception as e:
[?2004l[?2004h>         print(f"Error: {e}")
[?2004l[?2004h> 
[?2004l[?2004h> if __name__ == '__main__':
[?2004l[?2004h>     run_baseline()
[?2004l[?2004h> EOF
