[?2004l[?2004h> # Final check for degenerate predictions
[?2004l[?2004h> if np.all(np.isclose(test_preds, test_preds[0])):
[?2004l[?2004h>     print('WARNING: Degenerate predictions detected!')
[?2004l[?2004h> 
