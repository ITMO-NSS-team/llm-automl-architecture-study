[?2004hroot@ae51ec4fbc11:/workspace# cat << 'EOF' > solution.py
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import torch
[?2004l[?2004h> from sklearn.metrics import roc_auc_score
[?2004l[?2004h> from lightgbm import LGBMClassifier
[?2004l[?2004h> import joblib
[?2004l[?2004h> 
[?2004l[?2004h> # REQUIRED Hardware Resolution
[?2004l[?2004h> DEVICE = ('cuda' if torch.cuda.is_available()
[?2004l[?2004h>           else 'mps' if torch.backends.mps.is_available() else 'cpu')
[?2004l[?2004h> print('DEVICE=', DEVICE)
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h> print('Loading data...')
[?2004l[?2004h> train = pd.read_csv('/app/data/train.csv')
[?2004l[?2004h> val = pd.read_csv('/app/data/val.csv')
[?2004l[?2004h> test = pd.read_csv('/app/data/test.csv')
[?2004l[?2004h> 
[?2004l[?2004h> X_train = train.drop(columns=['target'])
[?2004l[?2004h> y_train = train['target']
[?2004l[?2004h> X_val = val.drop(columns=['target'])
[?2004l[?2004h> y_val = val['target']
[?2004l[?2004h> X_test = test
[?2004l[?2004h> 
[?2004l[?2004h> # Trivial Baseline
[?2004l[?2004h> mean_train = y_train.mean()
[?2004l[?2004h> trivial_preds = np.full(len(y_val), mean_train)
[?2004l[?2004h> trivial_score = roc_auc_score(y_val, trivial_preds)
[?2004l[?2004h> print(f'TRIVIAL_SCORE={trivial_score}')
[?2004l[?2004h> 
[?2004l[?2004h> # Preprocessing
[?2004l[?2004h> # LightGBM handles NaNs automatically, but we'll ensure data types are correct
[?2004l[?2004h> # Fill NaNs for safety or if using other models
[?2004l[?2004h> num_cols = [c for c in X_train.columns if c.startswith('num_')]
[?2004l[?2004h> bin_cols = [c for c in X_train.columns if c.startswith('bin_')]
[?2004l[?2004h> 
[?2004l[?2004h> # Training Model
[?2004l[?2004h> print('Training model...')
[?2004l[?2004h> model = LGBMClassifier(n_estimators=1000, learning_rate=0.05, random_state=42)
[?2004l[?2004h> model.fit(
[?2004l[?2004h>     X_train, y_train,
[?2004l[?2004h>     eval_set=[(X_val, y_val)],
[?2004l[?2004h>     eval_metric='auc',
[?2004l[?2004h>     callbacks=[torch.optim.lr_scheduler.StepLR if False else None] # Not needed for LGBM
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> # Use early stopping logic (LGBM has internal early stopping if configured)
[?2004l[?2004h> # Since I'm using a simpler API here, I'll just fit and then use best_iteration
[?2004l[?2004h> # Let's refine the fit call with early stopping
[?2004l[?2004h> from lightgbm import early_stopping
[?2004l[?2004h> model = LGBMClassifier(n_estimators=2000, learning_rate=0.05, random_state=42)
[?2004l[?2004h> model.fit(
[?2004l[?2004h>     X_train, y_train,
[?2004l[?2004h>     eval_set=[(X_val, y_val)],
[?2004l[?2004h>     eval_metric='auc',
[?2004l[?2004h>     callbacks=[early_stopping(stopping_rounds=50)]
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> # Validation score
[?2004l[?2004h> val_preds = model.predict_proba(X_val)[:, 1]
[?2004l[?2004h> val_score = roc_auc_score(y_val, val_preds)
[?2004l[?2004h> print(f'VALIDATION_SCORE={val_score}')
[?2004l[?2004h> 
[?2004l[?2004h> # Sanity check vs baseline
[?2004l[?2004h> if val_score <= trivial_score:
[?2004l[?2004h>     print('Model failed to beat baseline. Using baseline predictions.')
[?2004l[?2004h>     test_preds = np.full(len(X_test), mean_train)
[?2004l[?2004h> else:
[?2004l[?2004h>     print('Model beat baseline!')
[?2004l[?2004h>     test_preds = model.predict_proba(X_test)[:, 1]
[?2004l[?2004h> 
[?2004l[?2004h> # Final check for degenerate predictions
[?2004l[?2004h> if np.all(test_preds == test_preds[0]):
[?2004l[?2004h>     print('WARNING: Degenerate predictions detected!')
[?2004l[?2004h> 
[?2004l[?2004h> # Save predictions
[?2004l[?2004h> submission = pd.DataFrame({'target': test_preds})
[?2004l[?2004h> submission.to_csv('/app/predictions.csv', index=False)
[?2004l[?2004h> print('Predictions saved to /app/predictions.csv')
