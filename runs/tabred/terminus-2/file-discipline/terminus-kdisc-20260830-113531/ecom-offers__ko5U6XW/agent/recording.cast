[33.585321, "o", "root@ae51ec4fbc11:/workspace# "]
[33.696216, "i", "cat << 'EOF' > solution.py\nimport pandas as pd\nimport numpy as np\nimport torch\nfrom sklearn.metrics import roc_auc_score\nfrom lightgbm import LGBMClassifier\nimport joblib\n\n# REQUIRED Hardware Resolution\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\n# Load data\nprint('Loading data...')\ntrain = pd.read_csv('/app/data/train.csv')\nval = pd.read_csv('/app/data/val.csv')\ntest = pd.read_csv('/app/data/test.csv')\n\nX_train = train.drop(columns=['target'])\ny_train = train['target']\nX_val = val.drop(columns=['target'])\ny_val = val['target']\nX_test = test\n\n# Trivial Baseline\nmean_train = y_train.mean()\ntrivial_preds = np.full(len(y_val), mean_train)\ntrivial_score = roc_auc_score(y_val, trivial_preds)\nprint(f'TRIVIAL_SCORE={trivial_score}')\n\n# Preprocessing\n# LightGBM handles NaNs automatically, but we'll ensure data types are correct\n# Fill NaNs for safety or if using other models\nnum_cols = [c for c in X_train.columns if c.startswith('num_')]\nbin_cols = [c for c in X_train.columns if c.startswith('bin_')]\n\n# Training Model\nprint('Training model...')\nmodel = LGBMClassifier(n_estimators=1000, learning_rate=0.05, random_state=42)\nmodel.fit(\n    X_train, y_train,\n    eval_set=[(X_val, y_val)],\n    eval_metric='auc',\n    callbacks=[torch.optim.lr_scheduler.StepLR if False else None] # Not needed for LGBM\n)\n\n# Use early stopping logic (LGBM has internal early stopping if configured)\n# Since I'm using a simpler API here, I'll just fit and then use best_iteration\n# Let's refine the fit call with early stopping\nfrom lightgbm import early_stopping\nmodel = LGBMClassifier(n_estimators=2000, learning_rate=0.05, random_state=42)\nmodel.fit(\n    X_train, y_train,\n    eval_set=[(X_val, y_val)],\n    eval_metric='auc',\n    callbacks=[early_stopping(stopping_rounds=50)]\n)\n\n# Validation score\nval_preds = model.predict_proba(X_val)[:, 1]\nval_score = roc_auc_score(y_val, val_preds)\nprint(f'VALIDATION_SCORE={val_score}')\n\n# Sanity check vs baseline\nif val_score <= trivial_score:\n    print('Model failed to beat baseline. Using baseline predictions.')\n    test_preds = np.full(len(X_test), mean_train)\nelse:\n    print('Model beat baseline!')\n    test_preds = model.predict_proba(X_test)[:, 1]\n\n# Final check for degenerate predictions\nif np.all(test_preds == test_preds[0]):\n    print('WARNING: Degenerate predictions detected!')\n\n# Save predictions\nsubmission = pd.DataFrame({'target': test_preds})\nsubmission.to_csv('/app/predictions.csv', index=False)\nprint('Predictions saved to /app/predictions.csv')\nEOF\n"]
[33.696568, "o", "cat << 'EOF' > solution.py"]
