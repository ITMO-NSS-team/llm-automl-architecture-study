[65.726162, "i", "cat << 'EOF' > solution.py\nimport pandas as pd\nimport numpy as np\nimport torch\nfrom sklearn.metrics import roc_auc_score\nfrom lightgbm import LGBMClassifier, early_stopping\nimport joblib\n\n# REQUIRED Hardware Resolution\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\n# Load data\nprint('Loading data...')\ntrain = pd.read_csv('/app/data/train.csv')\nval = pd.read_csv('/app/data/val.csv')\ntest = pd.read_csv('/app/data/test.csv')\n\nX_train = train.drop(columns=['target'])\ny_train = train['target']\nX_val = val.drop(columns=['target'])\ny_val = val['target']\nX_test = test\n\n# Trivial Baseline\nmean_train = y_train.mean()\ntrivial_preds = np.full(len(y_val), mean_train)\ntrivial_score = roc_auc_score(y_val, trivial_preds)\nprint(f'TRIVIAL_SCORE={trivial_score}')\n\n# Training Model\nprint('Training model...')n\n# Use a larger budget and early stopping for convergence\nmodel = LGBMClassifier(\n    n_estimators=5000, \n    learning_rate=0.02, \n    random_state=42, \n    importance_type='split',\n    n_jobs=-1\n)\n\nmodel.fit(\n    X_train, y_train,\n    eval_set=[(X_val, y_val)],\n    eval_metric='auc',\n    callbacks=[early_stopping(stopping_rounds=100)]\n)\n\n# Validation score\nval_preds = model.predict_proba(X_val)[:, 1]\nval_score = roc_auc_score(y_val, val_preds)\nprint(f'VALIDATION_SCORE={val_score}')\n\n# Sanity check vs baseline\nif val_score <= trivial_score:\n    print('Model failed to beat baseline. Using baseline predictions.')\n    test_preds = np.full(len(X_test), mean_train)\nelse:\n    print('Model beat baseline!')\n    test_preds = model.predict_proba(X_test)[:, 1]\n\n# Final check for degenerate predictions\nif np.all(np.isclose(test_preds, test_preds[0])):\n    print('WARNING: Degenerate predictions detected!')\n\n# Save predictions\nsubmission = pd.DataFrame({'target': test_preds})\nsubmission.to_csv('/app/predictions.csv', index=False)\nprint('Predictions saved to /app/predictions.csv')\nEOF\n"]
