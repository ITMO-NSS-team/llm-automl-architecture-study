[84.504186, "o", "    'seed': 42\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.504269, "o", "# Training with early stopping\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.504523, "o", "model = lgb.train(\r\n\u001b[?2004l\r\u001b[?2004h>     params,\r\n\u001b[?2004l\r\u001b[?2004h>     dtrain,\r\n\u001b[?2004l\r\u001b[?2004h>     num_boost_round=5000,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.504618, "o", "    valid_sets=[dtrain, val_set],\r\n\u001b[?2004l\r\u001b[?2004h"]
[84.504684, "o", ">     valid_names=['train', 'val'],\r\n\u001b[?2004l\r"]
[84.504744, "o", "\u001b[?2004h> "]
[84.504911, "o", "    callbacks=[lgb.early_stopping(stopping_rounds=100), lgb.log_evaluation(period=100)]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.504972, "o", ")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[84.505033, "o", "> # Validation score\r\n\u001b[?2004l\r"]
[84.5051, "o", "\u001b[?2004h> "]
[84.505161, "o", "val_preds = model.predict(X_val)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.505256, "o", "val_score = roc_auc_score(y_val, val_preds)\r\n\u001b[?2004l\r\u001b[?2004h"]
[84.505314, "o", "> "]
[84.505391, "o", "print(f'VALIDATION_SCORE={val_score}')\r\n\u001b[?2004l\r"]
[84.50546, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.505528, "o", "# Trivial baseline comparison\r\n\u001b[?2004l\r\u001b[?2004h"]
[84.505589, "o", "> train_mean = y_train.mean()\r\n\u001b[?2004l\r\u001b[?2004h"]
[84.505627, "o", "> "]
[84.505725, "o", "trivial_preds = np.full(len(y_val), train_mean)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.50584, "o", "trivial_score = roc_auc_score(y_val, trivial_preds)"]
[84.506925, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> print(f'TRIVIAL_BASELINE_SCORE={trivial_score}')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Predictions for test set\r\n\u001b[?2004l\r\u001b[?2004h> test_preds = model.predict(X_test)\r\n\u001b[?2004l\r\u001b[?2004h> submission = pd.DataFrame({'target': test_preds})\r\n\u001b[?2004l\r\u001b[?2004h> submission.to_csv('/app/predictions.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h> print('Predictions saved to /app/predictions.csv')\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[84.510543, "o", "\u001b[?2004hroot@e3aa924bed0d:/workspace# "]
[84.510625, "o", "python3 train_model.py\r\n\u001b[?2004l\r"]
