[32.216113, "i", "cat << 'EOF' > baseline.py\nimport pandas as pd\nfrom sklearn.metrics import roc_auc_score\n\ntrain = pd.read_csv('/app/data/train.csv')\nval = pd.read_csv('/app/data/val.csv')\n\ntrain_mean = train['target'].mean()\nval_preds = [train_mean] * len(val)\n\nscore = roc_auc_score(val['target'], val_preds)\nprint(f'TRIVIAL_BASELINE_SCORE={score}')\nprint(f'TRAIN_MEAN={train_mean}')\nEOF\n"]
[32.216681, "o", "cat << 'EOF' > baseline.py\r\n\u001b[?2004l\r"]
[32.216868, "o", "\u001b[?2004h> import pandas as pd"]
