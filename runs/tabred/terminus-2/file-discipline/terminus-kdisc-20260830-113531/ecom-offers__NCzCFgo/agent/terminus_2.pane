[?2004lcat << 'EOF' > train_model.py
import pandas as pd
import numpy as np
import lightgbm as lgb
from sklearn.metrics import roc_auc_score
import torch

# REQUIRED DEVICE RESOLUTION
DEVICE = ('cuda' if torch.cuda.is_available()
          else 'mps' if torch.backends.mps.is_available() else 'cpu')
print('DEVICE=', DEVICE)

# Load data
train = pd.read_csv('/app/data/train.csv')
val = pd.read_csv('/app/data/val.csv')
test = pd.read_csv('/app/data/test.csv')

X_train = train.drop('target', axis=1)
y_train = train['target']
X_val = val.drop('target', axis=1)
y_val = val['target']
X_test = test

# Use LightGBM
# LightGBM handles NaNs automatically
dtrain = lgb.Dataset(X_train, label=y_train)
val_set = lgb.Dataset(X_val, label=y_val, reference=dtrain)

params = {
    'objective': 'binary',
    'metric': 'auc',
    'boosting_type': 'gbdt',
    'learning_rate': 0.05,
    'num_leaves': 31,
    'feature_fraction': 0.8,
    'bagging_fraction': 0.8,
    'bagging_freq': 5,
    'verbose': -1,
    'seed': 42
}

# Training with early stopping
model = lgb.train(
    params,
    dtrain,
    num_boost_round=5000,
    valid_sets=[dtrain, val_set],
    valid_names=['train', 'val'],
    callbacks=[lgb.early_stopping(stopping_rounds=100), lgb.log_evaluation(period=100)]
)

# Validation score
val_preds = model.predict(X_val)
val_score = roc_auc_score(y_val, val_preds)
print(f'VALIDATION_SCORE={val_score}')

# Trivial baseline comparison
train_mean = y_train.mean()
trivial_preds = np.full(len(y_val), train_mean)
trivial_score = roc_auc_score(y_val, trivial_preds)
print(f'TRIVIAL_BASELINE_SCORE={trivial_score}')

# Predictions for test set
test_preds = model.predict(X_test)
submission = pd.DataFrame({'target': test_preds})
submission.to_csv('/app/predictions.csv', index=False)
print('Predictions saved to /app/predictions.csv')
EOF
python3 train_model.py
TRIVIAL_BASELINE_SCORE=0.5
TRAIN_MEAN=0.23012410715102294
