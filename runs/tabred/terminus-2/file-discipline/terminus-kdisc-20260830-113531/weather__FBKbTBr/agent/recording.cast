[7.6896, "o", "752.452942,25.202858,297.959442,298.197906,5.70074463,298.197906,303.898651,268.117249,284.641785,290.744324,295.534241,295.87085,2.5,2.25,5.62500334,7.25,2.625,1.5,0.0187999997,0,3.05819988,0,0,0,0,-0.563098133,-0.762908936,4.69220591,8.70292091,4.59823322,3.5411315,0.426388562,0.975689709,0.557055652,3.37749028,3.0723145,2.71435237,100568.93,100685.109,100691.852,60.7823486,5859.26855,3129.67603,1478.75879,747.595093,44,24,0,0,22.8500004,-2.60538327e-05,1.199,0,18,93.8000031,51.3332062,0,750.188843,-0.00599511713,24.9693241,-77.4723587,-68.7446518,-52.7696915,-39.6279678,-29.6778164,-22.0890255,-15.5379086,-9.82999229,-63.749382,-4.90411997,-1.24948728,2.97319937,7.45723867,-74.9700851,11.2152958,14.3552799,17.1152592,18.9933109,21.2733707,22.3733463,23.5633488,24.2170963,23.8976994,5.54193115,23.8976994,29.4396305,0,100,0,19.8999996,-0.302563488,0.461403817,0.551759124,11.9613352,4,5,1,0,0,7,1,1,1,25\r\n756.409302,21.976429,294.596466,294.754211,0.668518066,294.754211,295.422729,267.498566,282.647125,288.055573,290.555573,293.070618,1.625,1.375,6.125,3.625,2,0,0.0161000006,0,18.4281502,0,0,0,9.99999975e-06,-2.39447927,-2.78985286,5.74580383,-4.69300842,-12.3676147,-10.1965761,4.54975605,5.29183054,-8.60689735,-9.82093239,1.35527647,10.9185305,99968.1094,99856.6406,101582.867,137.139496,5879.80127,3168.28564,1530.95874,809.537476,100,84,0.0248667393,0,20.9889164,7.65700679e-05,1.574,0,78,96.5999985,51.0197563,0.125,736.977051,-0.104122072,20.4693241,-74.9744034,-66.6284409,-54.7314682,-41.7469101,-30.1746883,-22.1068172,-15.4500179,-9.72998619,-65.0446854,-5.41998911,-1.51590574,2.08474112,6.04940176,-69.7630081,8.40938759,10.3984318,12.4713383,15.3109989,17.2410221,18.2829533,19.4029484,20.9529362,21.4970951,-0.03125,21.4970951,21.4658451,0,58.0999985,93.5,5.80000019,-1.35087156,1.08354247,1.73173845,37.9900551,42,5,1,0,0,7,1,1,1,23\r\n"]
