[7.689706, "o", "root@1cabeb3b53c5:/workspace# "]
[45.528323, "i", "cat << 'EOF' > solution.py\nimport torch\nimport pandas as pd\nimport numpy as np\nfrom sklearn.metrics import mean_squared_error\nfrom sklearn.preprocessing import StandardScaler\nimport torch.nn as nn\nfrom torch.utils.data import DataLoader, TensorDataset\nimport time\n\n# 1. Device Resolution\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\n# 2. Budget Allocation\nprint('Budget Allocation: Exploration: 30m, Training: 2h, Improvement: 1h, Finalization: 30m')\n\n# 3. Data Loading\ntrain_df = pd.read_csv('/app/data/train.csv')\nval_df = pd.read_csv('/app/data/val.csv')\ntest_df = pd.read_csv('/app/data/test.csv')\n\nX_train = train_df.drop(columns=['target'])\ny_train = train_df['target']\nX_val = val_df.drop(columns=['target'])\ny_val = val_df['target']\nX_test = test_df.copy()\n\n# 4. Trivial Baseline\ntrain_median = y_train.median()\nbaseline_preds = np.full(len(y_val), train_median)\nbaseline_rmse = np.sqrt(mean_squared_error(y_val, baseline_preds))\nprint(f'TRIVIAL_BASELINE_SCORE={baseline_rmse}')\n\n# 5. Preprocessing\n# Simple imputation: fill nan with median\nnumeric_cols = [c for c in X_train.columns if c.startswith('num_')]\nbinary_cols = [c for c in X_train.columns if c.startswith('bin_')]\n\nfor col in numeric_cols:\n    median_val = X_train[col].median()\n    X_train[col] = X_train[col].fillna(median_val)\n    X_val[col] = X_val[col].fillna(median_val)\n    X_test[col] = X_test[col].fillna(median_val)\n\nscaler = StandardScaler()\nX_train_scaled = scaler.fit_transform(X_train)\nX_val_scaled = scaler.transform(X_val)\nX_test_scaled = scaler.transform(X_test)\n\n# Convert to tensors\nX_train_t = torch.tensor(X_train_scaled, dtype=torch.float32).to(DEVICE)\ny_train_t = torch.tensor(y_train.values, dtype=torch.float32).unsqueeze(1).to(DEVICE)\nX_val_t = torch.tensor(X_val_scaled, dtype=torch.float32).to(DEVICE)\ny_val_t = torch.tensor(y_val.values, dtype=torch.float32).unsqueeze(1).to(DEVICE)\n\n# 6. Model Definition\nclass TabModel(nn.Module):\n    def __init__(self, input_dim):\n        super().__init__()\n        self.net = nn.Sequential(\n            nn.Linear(input_dim, 256),\n            nn.ReLU(),\n            nn.Dropout(0.1),\n            nn.Linear(256, 128),\n            nn.ReLU(),\n            nn.Dropout(0.1),\n            nn.Linear(128, 64),\n            nn.ReLU(),\n            nn.Linear(64, 1)\n        )\n    def forward(self, x):\n        return self.net(x)\n\nmodel = TabModel(X_train.shape[1]).to(DEVICE)\noptimizer = torch.optim.Adam(model.parameters(), lr=0.001)\ncriterion = nn.MSELoss()\n\n# 7. Training with Early Stopping\nBATCH_SIZE = 1024\ntrain_loader = DataLoader(TensorDataset(X_train_t, y_train_t), batch_size=BATCH_SIZE, shuffle=True)\n\nbest_rmse = float('inf')\npatience = 10\ncounter = 0\nepochs = 200\n\nfor epoch in range(epochs):\n    model.train()\n    for batch_x, batch_y in train_loader:\n        optimizer.zero_grad()\n        pred = model(batch_x)\n        loss = criterion(pred, batch_y)\n        loss.backward()\n        optimizer.step()\n    \n    model.eval()\n    with torch.no_grad():\n        val_pred = model(X_val_t)\n        val_rmse = np.sqrt(mean_squared_error(y_val_t.cpu().numpy(), val_pred.cpu().numpy()))\n    \n    if val_rmse < best_rmse:\n        best_rmse = val_rmse\n        torch.save(model.state_dict(), 'best_model.pt')\n        counter = 0\n    else:\n        counter += 1\n    \n    if epoch % 10 == 0:\n        print(f'Epoch {epoch}: VAL_RMSE={val_rmse:.4f}')\n    \n    if counter >= patience:\n        print(f'Early stopping at epoch {epoch}')\n        break\n\nprint(f'VALIDATION_SCORE={best_rmse}')\n\n# 8. Final Submission\nmodel.load_state_dict(torch.load('best_model.pt'))\nmodel.eval()\nwith torch.no_grad():\n    X_test_t = torch.tensor(X_test_scaled, dtype=torch.float32).to(DEVICE)\n    test_preds = model(X_test_t).cpu().numpy()\n\nsubmission = pd.DataFrame({'target': test_preds.flatten()})\nsubmission.to_csv('/app/predictions.csv', index=False)\nprint('Submission saved to /app/predictions.csv')\nEOF\n"]
