[45.532279, "o", "> baseline_preds = np.full(len(y_val), train_median)"]
[45.532299, "o", "\r\n"]
[45.532331, "o", "\u001b[?2004l\r"]
[45.532429, "o", "\u001b[?2004h"]
[45.532444, "o", "> baseline_rmse = np.sqrt(mean_squared_error(y_val, baseline_preds))"]
[45.532479, "o", "\r\n"]
[45.532528, "o", "\u001b[?2004l\r"]
[45.532605, "o", "\u001b[?2004h"]
[45.53262, "o", "> print(f'TRIVIAL_BASELINE_SCORE={baseline_rmse}')"]
[45.53264, "o", "\r\n"]
[45.532662, "o", "\u001b[?2004l\r"]
[45.532719, "o", "\u001b[?2004h> "]
[45.532769, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[45.532798, "o", "> # 5. Preprocessing"]
[45.532869, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[45.532884, "o", "> # Simple imputation: fill nan with median"]
[45.532904, "o", "\r\n"]
[45.532936, "o", "\u001b[?2004l\r"]
[45.533033, "o", "\u001b[?2004h"]
[45.533062, "o", "> numeric_cols = [c for c in X_train.columns if c.startswith('num_')]"]
[45.533086, "o", "\r\n"]
[45.533106, "o", "\u001b[?2004l\r"]
[45.533139, "o", "\u001b[?2004h"]
[45.533229, "o", "> "]
[45.533243, "o", "binary_cols = [c for c in X_train.columns if c.startswith('bin_')]"]
[45.533264, "o", "\r\n"]
[45.533293, "o", "\u001b[?2004l\r"]
[45.533321, "o", "\u001b[?2004h"]
[45.533364, "o", "> \r\n"]
[45.53341, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[45.533426, "o", "for col in numeric_cols:"]
[45.533468, "o", "\r\n"]
[45.533544, "o", "\u001b[?2004l\r\u001b[?2004h"]
[45.533565, "o", ">     median_val = X_train[col].median()"]
[45.533588, "o", "\r\n"]
[45.533677, "o", "\u001b[?2004l\r"]
[45.53371, "o", "\u001b[?2004h>     X_train[col] = X_train[col].fillna(median_val)"]
[45.533733, "o", "\r\n"]
[45.533769, "o", "\u001b[?2004l\r"]
[45.533839, "o", "\u001b[?2004h> "]
[45.533858, "o", "    X_val[col] = X_val[col].fillna(median_val)"]
[45.533881, "o", "\r\n"]
[45.533911, "o", "\u001b[?2004l\r"]
[45.533988, "o", "\u001b[?2004h"]
[45.534003, "o", ">     X_test[col] = X_test[col].fillna(median_val)"]
[45.534025, "o", "\r\n"]
[45.534052, "o", "\u001b[?2004l\r"]
[45.534143, "o", "\u001b[?2004h> "]
[45.534166, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> scaler = StandardScaler()"]
[45.534198, "o", "\r\n"]
[45.53427, "o", "\u001b[?2004l\r\u001b[?2004h"]
[45.534284, "o", "> X_train_scaled = scaler.fit_transform(X_train)"]
[45.534304, "o", "\r\n"]
[45.534323, "o", "\u001b[?2004l\r"]
[45.534406, "o", "\u001b[?2004h"]
[45.534423, "o", "> X_val_scaled = scaler.transform(X_val)"]
[45.534445, "o", "\r\n"]
[45.534556, "o", "\u001b[?2004l\r"]
[45.534573, "o", "\u001b[?2004h> X_test_scaled = scaler.transform(X_test)"]
[45.534594, "o", "\r\n"]
[45.534616, "o", "\u001b[?2004l\r"]
[45.534656, "o", "\u001b[?2004h"]
[45.534713, "o", "> \r\n"]
[45.534733, "o", "\u001b[?2004l\r\u001b[?2004h> # Convert to tensors"]
[45.534767, "o", "\r\n"]
[45.534864, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[45.534879, "o", "X_train_t = torch.tensor(X_train_scaled, dtype=torch.float32).to(DEVICE)"]
[45.534898, "o", "\r\n"]
[45.53492, "o", "\u001b[?2004l\r"]
[45.534953, "o", "\u001b[?2004h"]
[45.53508, "o", "> "]
[45.535098, "o", "y_train_t = torch.tensor(y_train.values, dtype=torch.float32).unsqueeze(1).to(DEVICE)"]
[45.53512, "o", "\r\n"]
[45.535141, "o", "\u001b[?2004l\r"]
[45.535169, "o", "\u001b[?2004h"]
[45.535201, "o", "> "]
[45.53531, "o", "X_val_t = torch.tensor(X_val_scaled, dtype=torch.float32).to(DEVICE)"]
[45.535424, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[45.535442, "o", "> y_val_t = torch.tensor(y_val.values, dtype=torch.float32).unsqueeze(1).to(DEVICE)"]
[45.53547, "o", "\r\n"]
[45.535497, "o", "\u001b[?2004l\r"]
[45.535523, "o", "\u001b[?2004h"]
[45.535557, "o", "> "]
[45.535613, "o", "\r\n\u001b[?2004l\r"]
[45.535628, "o", "\u001b[?2004h> # 6. Model Definition"]
[45.535659, "o", "\r\n"]
[45.535711, "o", "\u001b[?2004l\r\u001b[?2004h"]
[45.535727, "o", "> class TabModel(nn.Module):"]
[45.535758, "o", "\r\n"]
[45.535824, "o", "\u001b[?2004l\r\u001b[?2004h"]
[45.535843, "o", ">     def __init__(self, input_dim):"]
[45.535866, "o", "\r\n"]
[45.535932, "o", "\u001b[?2004l\r\u001b[?2004h"]
[45.535951, "o", ">         super().__init__()"]
[45.535982, "o", "\r\n"]
[45.53604, "o", "\u001b[?2004l\r\u001b[?2004h"]
[45.536072, "o", ">         self.net = nn.Sequential("]
[45.536105, "o", "\r\n"]
[45.536171, "o", "\u001b[?2004l\r\u001b[?2004h"]
[45.536185, "o", ">             nn.Linear(input_dim, 256),"]
[45.536206, "o", "\r\n"]
[45.536237, "o", "\u001b[?2004l\r"]
[45.536286, "o", "\u001b[?2004h"]
[45.536304, "o", ">             nn.ReLU(),"]
[45.536341, "o", "\r\n"]
[45.536393, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[45.536407, "o", "            nn.Dropout(0.1),"]
[45.536438, "o", "\r\n"]
[45.536518, "o", "\u001b[?2004l\r\u001b[?2004h"]
[45.536535, "o", ">             nn.Linear(256, 128),"]
[45.536562, "o", "\r\n"]
[45.536619, "o", "\u001b[?2004l\r"]
[45.536634, "o", "\u001b[?2004h>             nn.ReLU(),"]
[45.536656, "o", "\r\n"]
[45.536718, "o", "\u001b[?2004l\r"]
[45.536732, "o", "\u001b[?2004h>             nn.Dropout(0.1),"]
[45.536754, "o", "\r\n"]
[45.536795, "o", "\u001b[?2004l\r"]
[45.53685, "o", "\u001b[?2004h> "]
[45.536867, "o", "            nn.Linear(128, 64),"]
[45.536899, "o", "\r\n"]
[45.536946, "o", "\u001b[?2004l\r\u001b[?2004h"]
[45.536962, "o", ">             nn.ReLU(),"]
[45.537035, "o", "\r\n"]
[45.53706, "o", "\u001b[?2004l\r\u001b[?2004h>             nn.Linear(64, 1)"]
[45.537108, "o", "\r\n"]
[45.537138, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[45.537164, "o", "        )"]
[45.537214, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[45.537229, "o", ">     def forward(self, x):"]
[45.53726, "o", "\r\n"]
[45.537315, "o", "\u001b[?2004l\r\u001b[?2004h"]
[45.537336, "o", ">         return self.net(x)"]
[45.537374, "o", "\r\n"]
[45.537406, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[45.537489, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.537507, "o", "model = TabModel(X_train.shape[1]).to(DEVICE)"]
[45.537528, "o", "\r\n"]
[45.537569, "o", "\u001b[?2004l\r"]
[45.537656, "o", "\u001b[?2004h"]
[45.537672, "o", "> optimizer = torch.optim.Adam(model.parameters(), lr=0.001)"]
[45.537692, "o", "\r\n"]
[45.537712, "o", "\u001b[?2004l\r"]
[45.537737, "o", "\u001b[?2004h"]
[45.53779, "o", "> "]
[45.537809, "o", "criterion = nn.MSELoss()"]
[45.537842, "o", "\r\n"]
[45.537881, "o", "\u001b[?2004l\r\u001b[?2004h"]
[45.537937, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.537952, "o", "# 7. Training with Early Stopping"]
[45.537974, "o", "\r\n"]
[45.538009, "o", "\u001b[?2004l\r\u001b[?2004h"]
[45.538075, "o", "> "]
[45.538103, "o", "BATCH_SIZE = 1024"]
[45.538134, "o", "\r\n"]
[45.538264, "o", "\u001b[?2004l\r\u001b[?2004h"]
[45.53828, "o", "> train_loader = DataLoader(TensorDataset(X_train_t, y_train_t), batch_size=BATCH_SIZE, shuffle=True)"]
[45.538304, "o", "\r\n"]
[45.538324, "o", "\u001b[?2004l\r"]
[45.538352, "o", "\u001b[?2004h"]
[45.538377, "o", "> "]
[45.538401, "o", "\r\n"]
[45.538422, "o", "\u001b[?2004l\r"]
[45.538503, "o", "\u001b[?2004h> "]
[45.538534, "o", "best_rmse = float('inf')"]
[45.538568, "o", "\r\n"]
[45.538609, "o", "\u001b[?2004l\r\u001b[?2004h"]
[45.538638, "o", "> patience = 10"]
[45.538679, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[45.538705, "o", "> counter = 0"]
[45.53874, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[45.538754, "o", "> epochs = 200"]
[45.538806, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[45.538864, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[45.538882, "o", "> for epoch in range(epochs):"]
[45.538913, "o", "\r\n"]
[45.538955, "o", "\u001b[?2004l\r\u001b[?2004h"]
[45.53897, "o", ">     model.train()"]
[45.53901, "o", "\r\n\u001b[?2004l\r"]
[45.53908, "o", "\u001b[?2004h> "]
[45.539101, "o", "    for batch_x, batch_y in train_loader:"]
[45.539123, "o", "\r\n"]
[45.539158, "o", "\u001b[?2004l\r"]
[45.539209, "o", "\u001b[?2004h> "]
[45.539227, "o", "        optimizer.zero_grad()"]
[45.539256, "o", "\r\n"]
[45.53931, "o", "\u001b[?2004l\r\u001b[?2004h"]
[45.539328, "o", ">         pred = model(batch_x)"]
[45.53935, "o", "\r\n"]
[45.539429, "o", "\u001b[?2004l\r\u001b[?2004h"]
[45.539443, "o", ">         loss = criterion(pred, batch_y)"]
[45.539471, "o", "\r\n"]
[45.539513, "o", "\u001b[?2004l\r"]
[45.539559, "o", "\u001b[?2004h> "]
[45.53958, "o", "        loss.backward()"]
[45.539646, "o", "\r\n\u001b[?2004l\r"]
[45.539662, "o", "\u001b[?2004h>         optimizer.step()"]
[45.539694, "o", "\r\n"]
[45.539722, "o", "\u001b[?2004l\r\u001b[?2004h"]
[45.539756, "o", ">     "]
[45.539792, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.539813, "o", "    model.eval()"]
[45.539873, "o", "\r\n\u001b[?2004l\r"]
[45.539889, "o", "\u001b[?2004h>     with torch.no_grad():"]
[45.53992, "o", "\r\n"]
[45.539979, "o", "\u001b[?2004l\r\u001b[?2004h"]
[45.539994, "o", ">         val_pred = model(X_val_t)"]
[45.540014, "o", "\r\n"]
[45.540055, "o", "\u001b[?2004l\r"]
[45.540185, "o", "\u001b[?2004h"]
[45.540205, "o", ">         val_rmse = np.sqrt(mean_squared_error(y_val_t.cpu().numpy(), val_pred.cpu().numpy()))"]
[45.540231, "o", "\r\n"]
[45.540254, "o", "\u001b[?2004l\r"]
[45.540284, "o", "\u001b[?2004h"]
[45.540313, "o", "> "]
[45.540359, "o", "    "]
[45.540419, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.540442, "o", "    if val_rmse < best_rmse:"]
[45.540521, "o", "\r\n\u001b[?2004l\r"]
[45.540547, "o", "\u001b[?2004h>         best_rmse = val_rmse"]
[45.54057, "o", "\r\n"]
[45.540603, "o", "\u001b[?2004l\r\u001b[?2004h"]
[45.540688, "o", "> "]
[45.540705, "o", "        torch.save(model.state_dict(), 'best_model.pt')"]
[45.540728, "o", "\r\n"]
[45.54075, "o", "\u001b[?2004l\r"]
[45.540805, "o", "\u001b[?2004h> "]
[45.540822, "o", "        counter = 0"]
[45.540871, "o", "\r\n\u001b[?2004l\r"]
[45.540912, "o", "\u001b[?2004h>     else:"]
[45.540954, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.540969, "o", "        counter += 1"]
[45.541003, "o", "\r\n\u001b[?2004l\r"]
[45.541039, "o", "\u001b[?2004h> "]
[45.541095, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[45.541111, "o", ">     if epoch % 10 == 0:"]
[45.541215, "o", "\r\n\u001b[?2004l\r"]
[45.54123, "o", "\u001b[?2004h>         print(f'Epoch {epoch}: VAL_RMSE={val_rmse:.4f}')"]
[45.54125, "o", "\r\n"]
[45.541271, "o", "\u001b[?2004l\r"]
[45.541298, "o", "\u001b[?2004h"]
[45.54134, "o", ">     "]
[45.541394, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[45.541415, "o", ">     if counter >= patience:"]
[45.541447, "o", "\r\n"]
[45.541541, "o", "\u001b[?2004l\r\u001b[?2004h"]
[45.541557, "o", ">         print(f'Early stopping at epoch {epoch}')"]
[45.541577, "o", "\r\n"]
[45.541597, "o", "\u001b[?2004l\r"]
[45.541646, "o", "\u001b[?2004h> "]
[45.541676, "o", "        break"]
[45.54171, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[45.541776, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[45.541792, "o", "> print(f'VALIDATION_SCORE={best_rmse}')"]
[45.541813, "o", "\r\n"]
[45.541842, "o", "\u001b[?2004l\r"]
[45.541874, "o", "\u001b[?2004h"]
[45.541925, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[45.541964, "o", "> # 8. Final Submission"]
[45.542045, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[45.542138, "o", "> model.load_state_dict(torch.load('best_model.pt'))"]
[45.54217, "o", "\r\n"]
[45.542206, "o", "\u001b[?2004l\r\u001b[?2004h"]
[45.542222, "o", "> model.eval()"]
[45.542281, "o", "\r\n"]
[45.542296, "o", "\u001b[?2004l\r\u001b[?2004h> with torch.no_grad():"]
