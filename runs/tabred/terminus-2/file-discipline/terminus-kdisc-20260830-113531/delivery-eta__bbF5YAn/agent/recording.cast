[363.220801, "i", "cat << 'EOF' > train_xgb.py\nimport pandas as pd\nimport numpy as np\nimport xgboost as xgb\nfrom sklearn.metrics import mean_squared_error\n\n# Load data\ntrain = pd.read_csv('/app/data/train.csv')\nval = pd.read_csv('/app/data/val.csv')\ntest = pd.read_csv('/app/data/test.csv')\n\nnum_cols = [c for c in train.columns if c.startswith('num_')]\nbin_cols = [c for c in train.columns if c.startswith('bin_')]\ncat_cols = [c for c in train.columns if c.startswith('cat_')]\n\n# Preprocess categorical: simply cast to category for XGBoost\nfor col in cat_cols:\n    train[col] = train[col].astype('category')\n    val[col] = val[col].astype('category')\n    test[col] = test[col].astype('category')\n\n# Split features and target\nX_train = train[num_cols + bin_cols + cat_cols]\ny_train = train['target']\nX_val = val[num_cols + bin_cols + cat_cols]\ny_val = val['target']\nX_test = test[num_cols + bin_cols + cat_cols]\n\n# XGBoost model with categorical support\nmodel = xgb.XGBRegressor(\n    n_estimators=1000,\n    learning_rate=0.05,\n    max_depth=6,\n    tree_method='hist',\n    enable_categorical=True,\n    early_stopping_rounds=50,\n    eval_metric='rmse'\n)\n\nmodel.fit(\n    X_train, y_train,\n    eval_set=[(X_val, y_val)],\n    verbose=100\n)\n\nval_preds = model.predict(X_val)\nrmse = np.sqrt(mean_squared_error(y_val, val_preds))\nprint(f'VALIDATION_SCORE={rmse}')\n\n# Generate predictions\ntest_preds = model.predict(X_test)\npreds_df = pd.DataFrame({'target': test_preds})\npreds_df.to_csv('/app/predictions.csv', index=False)\nprint('Predictions saved to /app/predictions.csv')\nEOF\n"]
[363.223081, "o", "cat << 'EOF' > train_xgb.py\r\nimport pandas as pd\r\nimport numpy as np\r\nimport xgboost as xgb\r\nfrom sklearn.metrics import mean_squared_error\r\n\r\n# Load data\r\ntrain = pd.read_csv('/app/data/train.csv')\r\nval = pd.read_csv('/app/data/val.csv')\r\ntest = pd.read_csv('/app/data/test.csv')\r\n\r\nnum_cols = [c for c in train.columns if c.startswith('num_')]\r\nbin_cols = [c for c in train.columns if c.startswith('bin_')]\r\ncat_cols = [c for c in train.columns if c.startswith('cat_')]\r\n\r\n# Preprocess categorical: simply cast to category for XGBoost\r\nfor col in cat_cols:\r\n    train[col] = train[col].astype('category')\r\n    val[col] = val[col].astype('category')\r\n    test[col] = test[col].astype('category')\r\n\r\n# Split features and target\r\nX_train = train[num_cols + bin_cols + cat_cols]\r\ny_train = train['target']\r\nX_val = val[num_cols + bin_cols + cat_cols]\r\ny_val = val['target']\r\nX_test = test[num_cols + bin_cols + cat_cols]\r\n\r\n# XGBoost model with categorical support\r\nmodel = xgb.XGBRegressor(\r\n    n_estimators=1000,\r\n    learning_rate=0.05,\r\n    max_depth=6,\r\n    tree_method='hist',\r\n    enable_categorical=True,\r\n    early_stopping_rounds=50,\r\n    eval_metric='rmse'\r\n)\r\n\r\nmodel.fit(\r\n    X_train, y_train,\r\n    eval_set=[(X_val, y_val)],\r\n    verbose=100\r\n)\r\n\r\nval_preds = model.predict(X_val)\r\nrmse = np.sqrt(mean_squared_error(y_val, val_preds))\r\nprint(f'VALIDATION_SCORE={rmse}')\r\n\r\n# Generate predictions\r\ntest_preds = model.predict(X_test)\r\npreds_df = pd.DataFrame({'target': test_preds})\r\npreds_df.to_csv('/app/predictions.csv', index=False)\r\nprint('Predictions saved to /app/predictions.csv')\r\nEOF\r\n"]
