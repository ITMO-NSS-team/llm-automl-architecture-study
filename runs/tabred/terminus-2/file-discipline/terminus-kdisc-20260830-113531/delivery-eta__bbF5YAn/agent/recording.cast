[997.277844, "i", "cat << 'EOF' > train_fast_lgbm.py\nimport pandas as pd\nimport numpy as np\nimport lightgbm as lgb\nfrom sklearn.metrics import mean_squared_error\nfrom sklearn.preprocessing import LabelEncoder\n\nprint('Loading data...')\ntrain = pd.read_csv('/app/data/train.csv')\nval = pd.read_csv('/app/data/val.csv')\ntest = pd.read_csv('/app/data/test.csv')\n\nnum_cols = [c for c in train.columns if c.startswith('num_')]\nbin_cols = [c for c in train.columns if c.startswith('bin_')]\ncat_cols = [c for c in train.columns if c.startswith('cat_')]\n\nprint('Preprocessing...')\nfor col in cat_cols:\n    le = LabelEncoder()\n    train[col] = le.fit_transform(train[col].astype(str))\n    val[col] = le.transform(val[col].astype(str))\n    test[col] = le.transform(test[col].astype(str))\n\n# Use a sample of training data to speed up significantly\ntrain_sample = train.sample(frac=0.2, random_state=42)\nX_train = train_sample[num_cols + bin_cols + cat_cols]\ny_train = train_sample['target']\nX_val = val[num_cols + bin_cols + cat_cols]\ny_val = val['target']\nX_test = test[num_cols + bin_cols + cat_cols]\n\nprint('Training Fast LightGBM...')\nmodel = lgb.LGBMRegressor(\n    n_estimators=200,\n    learning_rate=0.1,\n    max_depth=5,\n    n_jobs=-1\n)\n\nmodel.fit(\n    X_train, y_train,\n    eval_set=[(X_val, y_val)],\n    callbacks=[lgb.early_stopping(stopping_rounds=20), lgb.log_evaluation(period=50)]\n)\n\nval_preds = model.predict(X_val)\nrmse = np.sqrt(mean_squared_error(y_val, val_preds))\nprint(f'VALIDATION_SCORE={rmse}')\n\nprint('Generating predictions...')\ntest_preds = model.predict(X_test)\npreds_df = pd.DataFrame({'target': test_preds})\npreds_df.to_csv('/app/predictions.csv', index=False)\nprint('Predictions saved to /app/predictions.csv')\nEOF\n"]
[997.417129, "i", "python3 train_fast_lgbm.py\n"]
[1057.430497, "i", "wc -l /app/predictions.csv\n"]
[1069.726133, "i", "cat << 'EOF' > train_fast_lgbm.py\nimport pandas as pd\nimport numpy as np\nimport lightgbm as lgb\nfrom sklearn.metrics import mean_squared_error\nfrom sklearn.preprocessing import LabelEncoder\n\nprint('Loading data...')\ntrain = pd.read_csv('/app/data/train.csv')\nval = pd.read_csv('/app/data/val.csv')\ntest = pd.read_csv('/app/data/test.csv')\n\nnum_cols = [c for c in train.columns if c.startswith('num_')]\nbin_cols = [c for c in train.columns if c.startswith('bin_')]\ncat_cols = [c for c in train.columns if c.startswith('cat_')]\n\nprint('Preprocessing...')\nfor col in cat_cols:\n    le = LabelEncoder()\n    train[col] = le.fit_transform(train[col].astype(str))\n    val[col] = le.transform(val[col].astype(str))\n    test[col] = le.transform(test[col].astype(str))\n\ntrain_sample = train.sample(frac=0.2, random_state=42)\nX_train = train_sample[num_cols + bin_cols + cat_cols]\ny_train = train_sample['target']\nX_val = val[num_cols + bin_cols + cat_cols]\ny_val = val['target']\nX_test = test[num_cols + bin_cols + cat_cols]\n\nprint('Training Fast LightGBM...')\nmodel = lgb.LGBMRegressor(\n    n_estimators=200,\n    learning_rate=0.1,\n    max_depth=5,\n    n_jobs=-1\n)\n\nmodel.fit(\n    X_train, y_train,\n    eval_set=[(X_val, y_val)],\n    callbacks=[lgb.early_stopping(stopping_rounds=20), lgb.log_evaluation(period=50)]\n)\n\nval_preds = model.predict(X_val)\nrmse = np.sqrt(mean_squared_error(y_val, val_preds))\nprint(f'VALIDATION_SCORE={rmse}')\n\nprint('Generating predictions...')\ntest_preds = model.predict(X_test)\npreds_df = pd.DataFrame({'target': test_preds})\npreds_df.to_csv('/app/predictions.csv', index=False)\nprint('Predictions saved to /app/predictions.csv')\nEOF\n"]
[1069.890121, "i", "python3 train_fast_lgbm.py\n"]
