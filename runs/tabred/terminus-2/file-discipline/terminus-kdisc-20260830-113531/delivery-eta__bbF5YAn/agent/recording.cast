[30.861394, "i", "cat << 'EOF' > baseline.py\nimport pandas as pd\nimport numpy as np\nfrom sklearn.metrics import mean_squared_error\n\ntrain = pd.read_csv('/app/data/train.csv')\nval = pd.read_csv('/app/data/val.csv')\n\nmedian_val = train['target'].median()\nval_preds = np.full(len(val), median_val)\nrmse = np.sqrt(mean_squared_error(val['target'], val_preds))\n\nprint(f'TRIVIAL_BASELINE_MEDIAN={median_val}')\nprint(f'VALIDATION_SCORE={rmse}')\nEOF\n"]
