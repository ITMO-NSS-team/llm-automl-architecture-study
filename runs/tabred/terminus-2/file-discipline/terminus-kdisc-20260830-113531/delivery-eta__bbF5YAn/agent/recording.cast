[84.949456, "o", "> "]
[84.9495, "o", "if __name__ == '__main__':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.949581, "o", "    X_train, y_train, X_val, y_val, num_cols, bin_cols, cat_cols, cat_mappings, scaler = preprocess()\r\n\u001b[?2004l\r"]
[84.949613, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[84.949649, "o", "\u001b[?2004h> "]
[84.949678, "o", "    train_ds = TabularDataset(X_train, y_train)\r\n\u001b[?2004l\r"]
[84.949718, "o", "\u001b[?2004h> "]
[84.949762, "o", "    val_ds = TabularDataset(X_val, y_val)\r\n\u001b[?2004l\r"]
[84.949797, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.94985, "o", "    train_loader = DataLoader(train_ds, batch_size=1024, shuffle=True)\r\n\u001b[?2004l\r"]
[84.949885, "o", "\u001b[?2004h> "]
[84.949929, "o", "    val_loader = DataLoader(val_ds, batch_size=1024)\r\n\u001b[?2004l\r"]
[84.949957, "o", "\u001b[?2004h>     \r\n"]
[84.950001, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[84.950083, "o", "    model = TabularModel(len(num_cols) + len(bin_cols) + len(cat_cols), []).to(DEVICE)\r\n\u001b[?2004l\r"]
[84.950116, "o", "\u001b[?2004h> "]
[84.950152, "o", "    criterion = nn.MSELoss()\r\n\u001b[?2004l\r\u001b[?2004h"]
[84.950195, "o", "> "]
[84.950222, "o", "    optimizer = optim.Adam(model.parameters(), lr=1e-3)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.950326, "o", "    scheduler = optim.lr_scheduler.ReduceLROnPlateau(optimizer, 'min', patience=5, factor=0.5)\r\n\u001b[?2004l\r"]
[84.950357, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[84.950385, "o", "\u001b[?2004h> "]
[84.950426, "o", "    best_rmse = float('inf')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.95047, "o", "    patience_counter = 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[84.950507, "o", ">     best_epoch = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.950551, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.950579, "o", "    for epoch in range(1, 201):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.950608, "o", "        model.train()\r\n\u001b[?2004l\r\u001b[?2004h"]
[84.950647, "o", ">         train_loss = 0\r\n"]
[84.950689, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[84.950717, "o", "        for xb, yb in train_loader:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.950769, "o", "            xb, yb = xb.to(DEVICE), yb.to(DEVICE)\r\n\u001b[?2004l\r"]
[84.950797, "o", "\u001b[?2004h> "]
[84.95083, "o", "            optimizer.zero_grad()\r\n\u001b[?2004l\r\u001b[?2004h"]
[84.950858, "o", "> "]
[84.950914, "o", "            pred = model(xb)\r\n\u001b[?2004l\r\u001b[?2004h"]
[84.950942, "o", ">             loss = criterion(pred, yb)\r\n\u001b[?2004l\r\u001b[?2004h"]
[84.950975, "o", "> "]
[84.95101, "o", "            loss.backward()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.951069, "o", "            optimizer.step()\r\n\u001b[?2004l\r"]
[84.951098, "o", "\u001b[?2004h>             train_loss += loss.item()\r\n\u001b[?2004l\r"]
[84.951127, "o", "\u001b[?2004h> "]
[84.951161, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.951205, "o", "        model.eval()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.951232, "o", "        val_preds = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.951259, "o", "        val_targets = []\r\n\u001b[?2004l\r"]
[84.951294, "o", "\u001b[?2004h> "]
[84.951338, "o", "        with torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.951373, "o", "            for xb, yb in val_loader:\r\n\u001b[?2004l\r\u001b[?2004h"]
[84.951416, "o", "> "]
[84.951452, "o", "                xb, yb = xb.to(DEVICE), yb.to(DEVICE)\r\n\u001b[?2004l\r\u001b[?2004h"]
[84.951495, "o", "> "]
[84.951523, "o", "                val_preds.append(model(xb).cpu().numpy())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.951586, "o", "                val_targets.append(yb.cpu().numpy())\r\n\u001b[?2004l\r\u001b[?2004h"]
[84.951622, "o", ">         \r\n"]
[84.95165, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[84.951683, "o", "        val_preds = np.concatenate(val_preds)\r\n\u001b[?2004l\r\u001b[?2004h"]
[84.951709, "o", "> "]
[84.951748, "o", "        val_targets = np.concatenate(val_targets)\r\n\u001b[?2004l\r"]
[84.951762, "o", "\u001b[?2004h> "]
[84.951842, "o", "        rmse = np.sqrt(mean_squared_error(val_targets, val_preds))\r\n\u001b[?2004l\r"]
[84.951885, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[84.951908, "o", "\u001b[?2004h> "]
[84.95195, "o", "        scheduler.step(rmse)\r\n\u001b[?2004l\r\u001b[?2004h"]
[84.95197, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.951992, "o", "        if rmse < best_rmse:\r\n\u001b[?2004l\r"]
[84.952018, "o", "\u001b[?2004h> "]
[84.952051, "o", "            best_rmse = rmse\r\n\u001b[?2004l\r"]
[84.952134, "o", "\u001b[?2004h> "]
[84.952169, "o", "            torch.save(model.state_dict(), 'best_model.pth')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.952194, "o", "            patience_counter = 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[84.95224, "o", "> "]
[84.952261, "o", "            best_epoch = epoch\r\n\u001b[?2004l\r\u001b[?2004h>         else:\r\n\u001b[?2004l\r"]
[84.952316, "o", "\u001b[?2004h> "]
[84.952337, "o", "            patience_counter += 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.952384, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h"]
[84.952415, "o", ">         if epoch % 10 == 0:\r\n\u001b[?2004l\r\u001b[?2004h"]
[84.952446, "o", "> "]
[84.952506, "o", "            print(f'Epoch {epoch} - VAL_RMSE: {rmse:.4f} - Best: {best_rmse:.4f}')\r\n\u001b[?2004l\r"]
[84.952521, "o", "\u001b[?2004h> "]
[84.952562, "o", "            \r\n\u001b[?2004l\r"]
[84.95259, "o", "\u001b[?2004h> "]
[84.952623, "o", "        if patience_counter >= 20:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.952667, "o", "            print(f'Early stopping at epoch {epoch}')\r\n\u001b[?2004l\r"]
[84.95269, "o", "\u001b[?2004h> "]
[84.952733, "o", "            break\r\n\u001b[?2004l\r\u001b[?2004h"]
[84.952754, "o", ">             \r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.952801, "o", "    print(f'VALIDATION_SCORE={best_rmse}')\r\n\u001b[?2004l\r"]
[84.952836, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[84.953824, "o", "\u001b[?2004hroot@f74d86cabb00:/workspace# "]
