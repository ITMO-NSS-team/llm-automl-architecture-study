cat << 'EOF' > train_xgb.py
import pandas as pd
import numpy as np
import xgboost as xgb
from sklearn.metrics import mean_squared_error

# Load data
train = pd.read_csv('/app/data/train.csv')
val = pd.read_csv('/app/data/val.csv')
test = pd.read_csv('/app/data/test.csv')

num_cols = [c for c in train.columns if c.startswith('num_')]
bin_cols = [c for c in train.columns if c.startswith('bin_')]
cat_cols = [c for c in train.columns if c.startswith('cat_')]

# Preprocess categorical: simply cast to category for XGBoost
for col in cat_cols:
    train[col] = train[col].astype('category')
    val[col] = val[col].astype('category')
    test[col] = test[col].astype('category')

# Split features and target
X_train = train[num_cols + bin_cols + cat_cols]
y_train = train['target']
X_val = val[num_cols + bin_cols + cat_cols]
y_val = val['target']
X_test = test[num_cols + bin_cols + cat_cols]

# XGBoost model with categorical support
model = xgb.XGBRegressor(
    n_estimators=1000,
    learning_rate=0.05,
    max_depth=6,
    tree_method='hist',
    enable_categorical=True,
    early_stopping_rounds=50,
    eval_metric='rmse'
)

model.fit(
    X_train, y_train,
    eval_set=[(X_val, y_val)],
    verbose=100
)

val_preds = model.predict(X_val)
rmse = np.sqrt(mean_squared_error(y_val, val_preds))
print(f'VALIDATION_SCORE={rmse}')

# Generate predictions
test_preds = model.predict(X_test)
preds_df = pd.DataFrame({'target': test_preds})
preds_df.to_csv('/app/predictions.csv', index=False)
print('Predictions saved to /app/predictions.csv')
EOF
python3 train_xgb.py
ls -l /app/predictions.csv
ps aux | grep train_xgb.py
pkill -f train_xgb.py
cat << 'EOF' > train_lgbm.py
import pandas as pd
import numpy as np
import lightgbm as lgb
from sklearn.metrics import mean_squared_error
from sklearn.preprocessing import LabelEncoder

print('Loading data...')
train = pd.read_csv('/app/data/train.csv')
val = pd.read_csv('/app/data/val.csv')
test = pd.read_csv('/app/data/test.csv')

num_cols = [c for c in train.columns if c.startswith('num_')]
bin_cols = [c for c in train.columns if c.startswith('bin_')]
cat_cols = [c for c in train.columns if c.startswith('cat_')]

print('Preprocessing...')
for col in cat_cols:
    le = LabelEncoder()
    train[col] = le.fit_transform(train[col].astype(str))
    val[col] = le.transform(val[col].astype(str))
    test[col] = le.transform(test[col].astype(str))

X_train = train[num_cols + bin_cols + cat_cols]
y_train = train['target']
X_val = val[num_cols + bin_cols + cat_cols]
y_val = val['target']
X_test = test[num_cols + bin_cols + cat_cols]

print('Training LightGBM...')
model = lgb.LGBMRegressor(
    n_estimators=1000,
    learning_rate=0.05,
    max_depth=7,
    num_leaves=63,
    importance_type='gain',
    n_jobs=-1
)

model.fit(
    X_train, y_train,
    eval_set=[(X_val, y_val)],
    callbacks=[lgb.early_stopping(stopping_rounds=50), lgb.log_evaluation(period=100)]
)

val_preds = model.predict(X_val)
rmse = np.sqrt(mean_squared_error(y_val, val_preds))
print(f'VALIDATION_SCORE={rmse}')

print('Generating predictions...')
test_preds = model.predict(X_test)
preds_df = pd.DataFrame({'target': test_preds})
preds_df.to_csv('/app/predictions.csv', index=False)
print('Predictions saved to /app/predictions.csv')
EOF
python3 train_lgbm.py
ls -l /app/predictions.csv
ps aux | grep train_lgbm.py
pkill -9 -f train_lgbm.py
