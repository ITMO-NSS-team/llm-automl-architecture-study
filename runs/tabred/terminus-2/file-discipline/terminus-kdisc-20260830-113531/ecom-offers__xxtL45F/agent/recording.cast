[1484.074165, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1484.074208, "o", "X_val = val_df.drop('target', axis=1)\r\n\u001b[?2004l\r"]
[1484.074242, "o", "\u001b[?2004h> "]
[1484.074281, "o", "y_val = val_df['target'].astype(int)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[1484.074297, "o", "> "]
[1484.074339, "o", "print('Training XGBoost...')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1484.074354, "o", "model = XGBClassifier(\r\n\u001b[?2004l\r\u001b[?2004h"]
[1484.074399, "o", "> "]
[1484.074441, "o", "    n_estimators=1000,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1484.074474, "o", "    learning_rate=0.05,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1484.07449, "o", "    max_depth=6,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1484.074543, "o", "    subsample=0.8,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1484.074584, "o", "    colsample_bytree=0.8,\r\n\u001b[?2004l\r"]
[1484.07463, "o", "\u001b[?2004h>     n_jobs=-1,\r\n\u001b[?2004l\r"]
[1484.07467, "o", "\u001b[?2004h>     random_state=42,\r\n\u001b[?2004l\r"]
[1484.074712, "o", "\u001b[?2004h>     eval_metric='auc',\r\n\u001b[?2004l\r"]
[1484.074728, "o", "\u001b[?2004h> "]
[1484.074763, "o", "    early_stopping_rounds=50\r\n\u001b[?2004l\r"]
[1484.074814, "o", "\u001b[?2004h> )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1484.074848, "o", "\u001b[?2004h> model.fit(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1484.07489, "o", "    X_train, y_train,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1484.07492, "o", "    eval_set=[(X_val, y_val)],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1484.074962, "o", "    verbose=10\r\n\u001b[?2004l\r\u001b[?2004h> )\r\n\u001b[?2004l\r"]
[1484.07501, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1484.075067, "o", "val_preds = model.predict_proba(X_val)[:, 1]\r\n\u001b[?2004l\r\u001b[?2004h> "]
