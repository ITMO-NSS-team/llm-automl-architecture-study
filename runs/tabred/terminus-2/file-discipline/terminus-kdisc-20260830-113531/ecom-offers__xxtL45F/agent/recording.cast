[19.470817, "i", "cat << 'EOF' > baseline.py\nimport pandas as pd\nfrom sklearn.metrics import roc_auc_score\nimport numpy as np\n\ntrain = pd.read_csv('/app/data/train.csv')\nval = pd.read_csv('/app/data/val.csv')\n\ntrain_mean = train['target'].mean()\nval_target = val['target']\nval_preds = np.full(len(val_target), train_mean)\n\nbaseline_score = roc_auc_score(val_target, val_preds)\nprint(f'Trivial baseline (mean): {baseline_score}')\n\n# Also check most frequent class baseline\nmost_freq = train['target'].mode()[0]\nval_preds_mode = np.full(len(val_target), most_freq)\nmode_score = roc_auc_score(val_target, val_preds_mode)\nprint(f'Trivial baseline (mode): {mode_score}')\nEOF\n"]
[19.475015, "o", "cat << 'EOF' > baseline.py\r\n\u001b[?2004l\r"]
[19.47505, "o", "\u001b[?2004h> import pandas as pd\r\n\u001b[?2004l\r\u001b[?2004h> from sklearn.metrics import roc_auc_score\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> train = pd.read_csv('/app/data/train.csv')\r\n\u001b[?2004l\r\u001b[?2004h> val = pd.read_csv('/app/data/val.csv')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> train_mean = train['target'].mean()\r\n\u001b[?2004l\r\u001b[?2004h> val_target = val['target']\r\n\u001b[?2004l\r\u001b[?2004h> val_preds = np.full(len(val_target), train_mean)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> baseline_score = roc_auc_score(val_target, val_preds)\r\n\u001b[?2004l\r\u001b[?2004h> print(f'Trivial baseline (mean): {baseline_score}')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Also check most frequent class baseline\r\n\u001b[?2004l\r\u001b[?2004h> most_freq = train['target'].mode()[0]\r\n\u001b[?2004l\r\u001b[?2004h> val_preds_mode = np.full(len(val_target), most_freq)\r\n\u001b[?2004l\r\u001b[?2004h> mode_score = roc_auc_score(val_target, val_preds_mode)\r\n\u001b[?2004l\r\u001b[?2004h> print(f'Trivial baseline (mode): {mode_score}')\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
