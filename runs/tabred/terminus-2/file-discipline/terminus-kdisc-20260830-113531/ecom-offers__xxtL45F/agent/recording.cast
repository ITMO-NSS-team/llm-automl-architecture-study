[53.224686, "o", "\r\n"]
[53.224705, "o", "\u001b[?2004l\r"]
[53.224734, "o", "\u001b[?2004h"]
[53.224762, "o", "> "]
[53.224806, "o", "# Let's do it properly"]
[53.224826, "o", "\r\n"]
[53.22486, "o", "\u001b[?2004l\r"]
[53.224914, "o", "\u001b[?2004h> "]
[53.224928, "o", "for i in range(X_train.shape[1]):"]
[53.224947, "o", "\r\n"]
[53.225031, "o", "\u001b[?2004l\r"]
[53.225058, "o", "\u001b[?2004h>     mask = np.isnan(X_train[:, i])"]
[53.225078, "o", "\r\n"]
[53.225112, "o", "\u001b[?2004l\r\u001b[?2004h"]
[53.225175, "o", "> "]
[53.225189, "o", "    X_train[mask, i] = median_values[i]"]
[53.225213, "o", "\r\n"]
[53.225255, "o", "\u001b[?2004l\r\u001b[?2004h"]
[53.225281, "o", ">     "]
[53.225337, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[53.22535, "o", "> for i in range(X_val.shape[1]):"]
[53.225367, "o", "\r\n"]
[53.225393, "o", "\u001b[?2004l\r"]
[53.225457, "o", "\u001b[?2004h"]
[53.225484, "o", ">     mask = np.isnan(X_val[:, i])"]
[53.225516, "o", "\r\n"]
[53.225582, "o", "\u001b[?2004l\r\u001b[?2004h"]
[53.225596, "o", ">     X_val[mask, i] = median_values[i]"]
[53.225615, "o", "\r\n"]
[53.225652, "o", "\u001b[?2004l\r"]
[53.225689, "o", "\u001b[?2004h> "]
[53.225742, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.225761, "o", "scaler = StandardScaler()"]
[53.225834, "o", "\r\n\u001b[?2004l\r"]
[53.225847, "o", "\u001b[?2004h> X_train = scaler.fit_transform(X_train)"]
[53.225865, "o", "\r\n"]
[53.225883, "o", "\u001b[?2004l\r"]
[53.225948, "o", "\u001b[?2004h"]
[53.225967, "o", "> X_val = scaler.transform(X_val)"]
[53.225987, "o", "\r\n"]
[53.226043, "o", "\u001b[?2004l\r\u001b[?2004h"]
[53.226078, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[53.226104, "o", "> # Tensors"]
[53.226199, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[53.226214, "o", "> X_train_t = torch.tensor(X_train, dtype=torch.float32).to(DEVICE)"]
[53.226237, "o", "\r\n"]
[53.22626, "o", "\u001b[?2004l\r"]
[53.226284, "o", "\u001b[?2004h"]
[53.226391, "o", "> "]
[53.226403, "o", "y_train_t = torch.tensor(y_train, dtype=torch.float32).unsqueeze(1).to(DEVICE)"]
[53.226419, "o", "\r\n"]
[53.226441, "o", "\u001b[?2004l\r"]
[53.226468, "o", "\u001b[?2004h"]
[53.226488, "o", "> "]
[53.226574, "o", "X_val_t = torch.tensor(X_val, dtype=torch.float32).to(DEVICE)"]
[53.226607, "o", "\r\n\u001b[?2004l\r"]
[53.226703, "o", "\u001b[?2004h> "]
[53.226716, "o", "y_val_t = torch.tensor(y_val, dtype=torch.float32).unsqueeze(1).to(DEVICE)"]
[53.226733, "o", "\r\n"]
[53.226755, "o", "\u001b[?2004l\r"]
[53.226779, "o", "\u001b[?2004h"]
[53.226801, "o", "> "]
[53.226864, "o", "\r\n\u001b[?2004l\r"]
[53.226878, "o", "\u001b[?2004h> batch_size = 1024"]
[53.226909, "o", "\r\n\u001b[?2004l\r"]
[53.227011, "o", "\u001b[?2004h> "]
[53.227066, "o", "train_loader = DataLoader(TensorDataset(X_train_t, y_train_t), batch_size=batch_size, shuffle=True)"]
[53.227086, "o", "\r\n"]
[53.227106, "o", "\u001b[?2004l\r"]
[53.227132, "o", "\u001b[?2004h"]
[53.22716, "o", "> "]
[53.22721, "o", "\r\n\u001b[?2004l\r"]
[53.227272, "o", "\u001b[?2004h> # Model\r\n"]
[53.227296, "o", "\u001b[?2004l\r\u001b[?2004h> class SimpleMLP(nn.Module):"]
[53.227326, "o", "\r\n"]
[53.227387, "o", "\u001b[?2004l\r\u001b[?2004h"]
[53.227402, "o", ">     def __init__(self, input_dim):"]
[53.227429, "o", "\r\n"]
[53.227462, "o", "\u001b[?2004l\r\u001b[?2004h"]
[53.227508, "o", "> "]
[53.227528, "o", "        super().__init__()"]
[53.227562, "o", "\r\n\u001b[?2004l\r"]
[53.227617, "o", "\u001b[?2004h> "]
[53.227631, "o", "        self.net = nn.Sequential("]
[53.227649, "o", "\r\n"]
[53.227726, "o", "\u001b[?2004l\r\u001b[?2004h"]
[53.22774, "o", ">             nn.Linear(input_dim, 128),"]
[53.227763, "o", "\r\n"]
[53.227792, "o", "\u001b[?2004l\r"]
[53.22784, "o", "\u001b[?2004h"]
[53.22786, "o", ">             nn.ReLU(),"]
[53.227895, "o", "\r\n\u001b[?2004l\r"]
[53.227951, "o", "\u001b[?2004h> "]
[53.227965, "o", "            nn.BatchNorm1d(128),"]
[53.227999, "o", "\r\n"]
[53.228063, "o", "\u001b[?2004l\r\u001b[?2004h"]
[53.228078, "o", ">             nn.Linear(128, 64),"]
[53.228106, "o", "\r\n"]
[53.228153, "o", "\u001b[?2004l\r\u001b[?2004h"]
[53.228166, "o", ">             nn.ReLU(),"]
[53.228197, "o", "\r\n"]
[53.228261, "o", "\u001b[?2004l\r\u001b[?2004h"]
[53.228276, "o", ">             nn.BatchNorm1d(64),"]
[53.228297, "o", "\r\n"]
[53.228328, "o", "\u001b[?2004l\r\u001b[?2004h"]
[53.228378, "o", "> "]
[53.228392, "o", "            nn.Linear(64, 1),"]
[53.228429, "o", "\r\n"]
[53.228483, "o", "\u001b[?2004l\r\u001b[?2004h"]
[53.228501, "o", ">             nn.Sigmoid()"]
[53.228534, "o", "\r\n"]
[53.228561, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[53.228587, "o", "        )"]
[53.228637, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[53.22865, "o", ">     def forward(self, x):"]
[53.228682, "o", "\r\n"]
[53.228733, "o", "\u001b[?2004l\r\u001b[?2004h"]
[53.22875, "o", ">         return self.net(x)"]
[53.22879, "o", "\r\n"]
[53.228823, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[53.228894, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.228908, "o", "model = SimpleMLP(X_train.shape[1]).to(DEVICE)"]
[53.228934, "o", "\r\n"]
[53.228964, "o", "\u001b[?2004l\r"]
[53.22905, "o", "\u001b[?2004h"]
[53.229066, "o", "> optimizer = optim.Adam(model.parameters(), lr=0.001)"]
[53.229084, "o", "\r\n"]
[53.229104, "o", "\u001b[?2004l\r"]
[53.229129, "o", "\u001b[?2004h"]
[53.229183, "o", "> criterion = nn.BCELoss()"]
[53.229202, "o", "\r\n"]
[53.229264, "o", "\u001b[?2004l\r\u001b[?2004h"]
[53.2293, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.229326, "o", "best_val_auc = 0"]
[53.229363, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[53.229377, "o", "> patience = 20"]
[53.229439, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[53.229472, "o", "> epochs = 200"]
[53.229509, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[53.229526, "o", "> counter = 0"]
[53.229556, "o", "\r\n\u001b[?2004l\r"]
[53.22962, "o", "\u001b[?2004h> \r\n"]
[53.229633, "o", "\u001b[?2004l\r\u001b[?2004h> for epoch in range(epochs):"]
[53.229655, "o", "\r\n"]
[53.229687, "o", "\u001b[?2004l\r\u001b[?2004h"]
[53.229724, "o", "> "]
[53.229742, "o", "    model.train()"]
[53.229794, "o", "\r\n\u001b[?2004l\r"]
[53.22981, "o", "\u001b[?2004h>     train_loss = 0"]
[53.229844, "o", "\r\n"]
[53.229915, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[53.229933, "o", "    for batch_x, batch_y in train_loader:"]
[53.229971, "o", "\r\n"]
[53.230033, "o", "\u001b[?2004l\r\u001b[?2004h"]
[53.230048, "o", ">         optimizer.zero_grad()"]
[53.230067, "o", "\r\n"]
[53.230097, "o", "\u001b[?2004l\r"]
[53.230158, "o", "\u001b[?2004h"]
[53.230173, "o", ">         outputs = model(batch_x)"]
[53.230193, "o", "\r\n"]
[53.230225, "o", "\u001b[?2004l\r\u001b[?2004h"]
[53.23029, "o", "> "]
[53.230304, "o", "        loss = criterion(outputs, batch_y)"]
[53.230324, "o", "\r\n"]
[53.230363, "o", "\u001b[?2004l\r"]
[53.230408, "o", "\u001b[?2004h> "]
[53.230427, "o", "        loss.backward()"]
[53.2305, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[53.230513, "o", ">         optimizer.step()"]
[53.230541, "o", "\r\n"]
[53.230599, "o", "\u001b[?2004l\r\u001b[?2004h"]
[53.230617, "o", ">         train_loss += loss.item()"]
[53.230637, "o", "\r\n"]
[53.230671, "o", "\u001b[?2004l\r"]
[53.230704, "o", "\u001b[?2004h> "]
[53.230744, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[53.230758, "o", ">     model.eval()"]
[53.230792, "o", "\r\n"]
[53.230841, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[53.230857, "o", "    with torch.no_grad():"]
[53.230891, "o", "\r\n\u001b[?2004l\r"]
[53.230962, "o", "\u001b[?2004h> "]
[53.230976, "o", "        val_preds = model(X_val_t).cpu().numpy()"]
[53.230998, "o", "\r\n"]
[53.231032, "o", "\u001b[?2004l\r"]
[53.231117, "o", "\u001b[?2004h"]
[53.231131, "o", ">         val_auc = roc_auc_score(y_val, val_preds)"]
[53.23115, "o", "\r\n"]
[53.231169, "o", "\u001b[?2004l\r"]
[53.231206, "o", "\u001b[?2004h> "]
[53.231238, "o", "    "]
[53.231301, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.231332, "o", "    if val_auc > best_val_auc:"]
[53.231388, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[53.231405, "o", ">         best_val_auc = val_auc"]
[53.231433, "o", "\r\n"]
[53.231526, "o", "\u001b[?2004l\r"]
[53.231542, "o", "\u001b[?2004h>         torch.save(model.state_dict(), 'best_model.pt')"]
[53.231566, "o", "\r\n"]
[53.231589, "o", "\u001b[?2004l\r"]
[53.231645, "o", "\u001b[?2004h"]
[53.231659, "o", ">         counter = 0"]
[53.231686, "o", "\r\n"]
[53.231719, "o", "\u001b[?2004l\r\u001b[?2004h"]
[53.231744, "o", ">     else:"]
[53.231787, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[53.231806, "o", ">         counter += 1"]
[53.231842, "o", "\r\n"]
[53.231875, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[53.231929, "o", "        \r\n\u001b[?2004l\r"]
[53.231943, "o", "\u001b[?2004h>     if epoch % 10 == 0:"]
[53.231966, "o", "\r\n"]
[53.232063, "o", "\u001b[?2004l\r"]
[53.232086, "o", "\u001b[?2004h>         print(f'Epoch {epoch}: val_auc={val_auc:.4f}')"]
[53.232106, "o", "\r\n"]
[53.232126, "o", "\u001b[?2004l\r"]
[53.232151, "o", "\u001b[?2004h"]
[53.232191, "o", ">     "]
[53.232243, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[53.232257, "o", ">     if counter >= patience:"]
[53.23228, "o", "\r\n"]
[53.23237, "o", "\u001b[?2004l\r\u001b[?2004h"]
[53.232385, "o", ">         print(f'Early stopping at epoch {epoch}')"]
[53.232404, "o", "\r\n"]
[53.232423, "o", "\u001b[?2004l\r"]
[53.232477, "o", "\u001b[?2004h"]
[53.232492, "o", ">         break"]
[53.232541, "o", "\r\n\u001b[?2004l\r"]
[53.232614, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[53.232628, "o", "> print(f'VALIDATION_SCORE={best_val_auc}')"]
[53.232646, "o", "\r\n"]
[53.232663, "o", "\u001b[?2004l\r"]
[53.2327, "o", "\u001b[?2004h> "]
[53.232917, "o", "EOF"]
[53.232942, "o", "\r\n\u001b[?2004l\r"]
[53.234725, "o", "\u001b[?2004h"]
[53.234809, "o", "root@c6e497d4bbe9:/workspace# "]
[53.340364, "i", "python3 train_model.py\n"]
[53.340789, "o", "python3 train_model.py"]
[53.340822, "o", "\r\n\u001b[?2004l\r"]
[55.551617, "o", "DEVICE= cpu\r\n"]
[134.506029, "o", "Epoch 0: val_auc=0.6225\r\n"]
[388.843538, "i", "pkill -f train_model.py\n"]
[388.844338, "o", "pkill -f train_model.py\r\n"]
[389.044086, "i", "cat << 'EOF' > train_xgboost.py\nimport pandas as pd\nimport numpy as np\nimport torch\nfrom xgboost import XGBClassifier\nfrom sklearn.metrics import roc_auc_score\n\n# REQUIRED: Hardware resolution\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\n# Data Loading\ntrain_df = pd.read_csv('/app/data/train.csv')\nval_df = pd.read_csv('/app/data/val.csv')\ntest_df = pd.read_csv('/app/data/test.csv')\n\nX_train = train_df.drop('target', axis=1)\ny_train = train_df['target']\n\nX_val = val_df.drop('target', axis=1)\ny_val = val_df['target']\n\n# XGBoost handles NaNs automatically\nmodel = XGBClassifier(\n    n_estimators=1000,\n    learning_rate=0.05,\n    max_depth=6,\n    subsample=0.8,\n    colsample_bytree=0.8,\n    n_jobs=-1,\n    random_state=42,\n    eval_metric='auc',\n    early_stopping_rounds=50\n)\n\nmodel.fit(\n    X_train, y_train,\n    eval_set=[(X_val, y_val)],\n    verbose=10\n)\n\nval_preds = model.predict_proba(X_val)[:, 1]\nval_auc = roc_auc_score(y_val, val_preds)\nprint(f'VALIDATION_SCORE={val_auc}')\n\ntest_preds = model.predict_proba(test_df)[:, 1]\npreds_df = pd.DataFrame({'target': test_preds})\npreds_df.to_csv('/app/predictions.csv', index=False)\nprint('Predictions saved to /app/predictions.csv')\nEOF\n"]
[389.045163, "o", "cat << 'EOF' > train_xgboost.py\r\nimport pandas as pd\r\nimport numpy as np\r\nimport torch\r\nfrom xgboost import XGBClassifier\r\nfrom sklearn.metrics import roc_auc_score\r\n\r\n# REQUIRED: Hardware resolution\r\nDEVICE = ('cuda' if torch.cuda.is_available()\r\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\r\nprint('DEVICE=', DEVICE)\r\n\r\n# Data Loading\r\ntrain_df = pd.read_csv('/app/data/train.csv')\r\nval_df = pd.read_csv('/app/data/val.csv')\r\ntest_df = pd.read_csv('/app/data/test.csv')\r\n\r\nX_train = train_df.drop('target', axis=1)\r\ny_train = train_df['target']\r\n\r\nX_val = val_df.drop('target', axis=1)\r\ny_val = val_df['target']\r\n\r\n# XGBoost handles NaNs automatically\r\nmodel = XGBClassifier(\r\n    n_estimators=1000,\r\n    learning_rate=0.05,\r\n    max_depth=6,\r\n    subsample=0.8,\r\n    colsample_bytree=0.8,\r\n    n_jobs=-1,\r\n    random_state=42,\r\n    eval_metric='auc',\r\n    early_stopping_rounds=50\r\n)\r\n\r\nmodel.fit(\r\n    X_train, y_train,\r\n    eval_set=[(X_val, y_val)],\r\n    verbose=10\r\n)\r\n\r\nval_preds = model.predict_proba(X_val)[:, 1]\r\nval_auc = roc_auc_score(y_val, val_preds)\r\nprint(f'VALIDATION_SCORE={val_auc}')\r\n\r\ntest_preds = model.predict_proba(test_df)[:, 1]\r\npreds_df = pd.DataFrame({'target': test_preds})\r\npreds_df.to_csv('/app/predictions.csv', index=False)\r\nprint('Predictions saved to /app/predictions.csv')\r\nEOF\r\n"]
[389.274093, "i", "python3 train_xgboost.py\n"]
[389.274289, "o", "python3 train_xgboost.py\r\n"]
[648.338844, "i", "ps aux | grep train_xgboost.py\n"]
