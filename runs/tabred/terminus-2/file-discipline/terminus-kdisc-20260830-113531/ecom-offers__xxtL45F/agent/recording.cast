[941.687464, "i", "cat << 'EOF' > train_xgboost_fast.py\nimport pandas as pd\nimport numpy as np\nimport torch\nfrom xgboost import XGBClassifier\nfrom sklearn.metrics import roc_auc_score\n\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\nprint('Loading data...')\ntrain_df = pd.read_csv('/app/data/train.csv')\nval_df = pd.read_csv('/app/data/val.csv')\ntest_df = pd.read_csv('/app/data/test.csv')\n\nX_train = train_df.drop('target', axis=1)\ny_train = train_df['target'].astype(int)\n\nX_val = val_df.drop('target', axis=1)\ny_val = val_df['target'].astype(int)\n\nprint('Training Fast XGBoost...')\nmodel = XGBClassifier(\n    n_estimators=200,\n    learning_rate=0.1,\n    max_depth=4,\n    n_jobs=-1,\n    random_state=42,\n    eval_metric='auc',\n    early_stopping_rounds=20\n)\n\nmodel.fit(\n    X_train, y_train,\n    eval_set=[(X_val, y_val)],\n    verbose=20\n)\n\nval_preds = model.predict_proba(X_val)[:, 1]\nval_auc = roc_auc_score(y_val, val_preds)\nprint(f'VALIDATION_SCORE={val_auc}')\n\ntest_preds = model.predict_proba(test_df)[:, 1]\npreds_df = pd.DataFrame({'target': test_preds})\npreds_df.to_csv('/app/predictions.csv', index=False)\nprint('Predictions saved to /app/predictions.csv')\nEOF\n"]
[941.687622, "o", "cat << 'EOF' > train_xgboost_fast.py\r\nimport pandas as pd\r\nimport numpy as np\r\nimport torch\r\nfrom xgboost import XGBClassifier\r\nfrom sklearn.metrics import roc_auc_score\r\n\r\nDEVICE = ('cuda' if torch.cuda.is_available()\r\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\r\nprint('DEVICE=', DEVICE)\r\n\r\nprint('Loading data...')\r\ntrain_df = pd.read_csv('/app/data/train.csv')\r\nval_df = pd.read_csv('/app/data/val.csv')\r\ntest_df = pd.read_csv('/app/data/test.csv')\r\n\r\nX_train = train_df.drop('target', axis=1)\r\ny_train = train_df['target'].astype(int)\r\n\r\nX_val = val_df.drop('target', axis=1)\r\ny_val = val_df['target'].astype(int)\r\n\r\nprint('Training Fast XGBoost...')\r\nmodel = XGBClassifier(\r\n    n_estimators=200,\r\n    learning_rate=0.1,\r\n    max_depth=4,\r\n    n_jobs=-1,\r\n    random_state=42,\r\n    eval_metric='auc',\r\n    early_stopping_rounds=20\r\n)\r\n\r\nmodel.fit(\r\n    X_train, y_train,\r\n    eval_set=[(X_val, y_val)],\r\n    verbose=20\r\n)\r\n\r\nval_preds = model.predict_proba(X_val)[:, 1]\r\nval_auc = roc_auc_score(y_val, val_preds)\r\nprint(f'VALIDATION_SCORE={val_auc}')\r\n\r\ntest_preds = model.predict_proba(test_df)[:, 1]\r\npreds_df = pd.DataFrame({'target': test_preds})\r\npreds_df.to_csv('/app/predictions.csv', index=False)\r\nprint('Predictions saved to /app/predictions.csv')\r\nEOF\r\n"]
[941.833109, "i", "python3 -u train_xgboost_fast.py\n"]
