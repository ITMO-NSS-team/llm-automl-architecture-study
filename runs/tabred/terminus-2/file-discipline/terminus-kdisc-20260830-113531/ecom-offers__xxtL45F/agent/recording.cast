[648.507687, "o", "ls -l /app/predictions.csv\r\n"]
[663.386123, "i", "cat << 'EOF' > train_xgboost.py\nimport pandas as pd\nimport numpy as np\nimport torch\nfrom xgboost import XGBClassifier\nfrom sklearn.metrics import roc_auc_score\nimport sys\n\n# REQUIRED: Hardware resolution\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\nprint('Loading data...')\ntrain_df = pd.read_csv('/app/data/train.csv')\nval_df = pd.read_csv('/app/data/val.csv')\ntest_df = pd.read_csv('/app/data/test.csv')\nprint('Data loaded.')\n\nX_train = train_df.drop('target', axis=1)\ny_train = train_df['target'].astype(int)\n\nX_val = val_df.drop('target', axis=1)\ny_val = val_df['target'].astype(int)\n\nprint('Training XGBoost...')\nmodel = XGBClassifier(\n    n_estimators=1000,\n    learning_rate=0.05,\n    max_depth=6,\n    subsample=0.8,\n    colsample_bytree=0.8,\n    n_jobs=-1,\n    random_state=42,\n    eval_metric='auc',\n    early_stopping_rounds=50\n)\n\nmodel.fit(\n    X_train, y_train,\n    eval_set=[(X_val, y_val)],\n    verbose=10\n)\n\nval_preds = model.predict_proba(X_val)[:, 1]\nval_auc = roc_auc_score(y_val, val_preds)\nprint(f'VALIDATION_SCORE={val_auc}')\n\ntest_preds = model.predict_proba(test_df)[:, 1]\npreds_df = pd.DataFrame({'target': test_preds})\npreds_df.to_csv('/app/predictions.csv', index=False)\nprint('Predictions saved to /app/predictions.csv')\nEOF\n"]
[663.388114, "o", "cat << 'EOF' > train_xgboost.py\r\nimport pandas as pd\r\nimport numpy as np\r\nimport torch\r\nfrom xgboost import XGBClassifier\r\nfrom sklearn.metrics import roc_auc_score\r\nimport sys\r\n\r\n# REQUIRED: Hardware resolution\r\nDEVICE = ('cuda' if torch.cuda.is_available()\r\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\r\nprint('DEVICE=', DEVICE)\r\n\r\nprint('Loading data...')\r\ntrain_df = pd.read_csv('/app/data/train.csv')\r\nval_df = pd.read_csv('/app/data/val.csv')\r\ntest_df = pd.read_csv('/app/data/test.csv')\r\nprint('Data loaded.')\r\n\r\nX_train = train_df.drop('target', axis=1)\r\ny_train = train_df['target'].astype(int)\r\n\r\nX_val = val_df.drop('target', axis=1)\r\ny_val = val_df['target'].astype(int)\r\n\r\nprint('Training XGBoost...')\r\nmodel = XGBClassifier(\r\n    n_estimators=1000,\r\n    learning_rate=0.05,\r\n    max_depth=6,\r\n    subsample=0.8,\r\n    colsample_bytree=0.8,\r\n    n_jobs=-1,\r\n    random_state=42,\r\n    eval_metric='auc',\r\n    early_stopping_rounds=50\r\n)\r\n\r\nmodel.fit(\r\n    X_train, y_train,\r\n    eval_set=[(X_val, y_val)],\r\n    verbose=10\r\n)\r\n\r\nval_preds = model.predict_proba(X_val)[:, 1]\r\nval_auc = roc_auc_score(y_val, val_preds)\r\nprint(f'VALIDATION_SCORE={val_auc}')\r\n\r\ntest_preds = model.predict_proba(test_df)[:, 1]\r\npreds_df = pd.DataFrame({'target': test_preds})\r\npreds_df.to_csv('/app/predictions.csv', index=False)\r\nprint('Predictions saved to /app/predictions.csv')\r\nEOF\r\n"]
[663.538516, "i", "python3 -u train_xgboost.py\n"]
