[21.545163, "o", "\u001b[?2004hroot@c6e497d4bbe9:/workspace# "]
[53.220624, "i", "cat << 'EOF' > train_model.py\nimport pandas as pd\nimport numpy as np\nimport torch\nimport torch.nn as nn\nimport torch.optim as optim\nfrom torch.utils.data import DataLoader, TensorDataset\nfrom sklearn.metrics import roc_auc_score\nfrom sklearn.preprocessing import StandardScaler\nimport os\n\n# REQUIRED: Hardware resolution\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\n# Data Loading\ntrain_df = pd.read_csv('/app/data/train.csv')\nval_df = pd.read_csv('/app/data/val.csv')\n\nX_train = train_df.drop('target', axis=1).values\ny_train = train_df['target'].values\nX_val = val_df.drop('target', axis=1).values\ny_val = val_df['target'].values\n\n# Preprocessing\n# Fill NaNs with median from training set\nmedian_values = np.nanmedian(X_train, axis=0)\nX_train = np.nan_to_num(X_train, nan=np.nan)\n# We need to be careful with nan_to_num; it replaces nan with 0 by default if nan=np.nan is used incorrectly\n# Let's do it properly\nfor i in range(X_train.shape[1]):\n    mask = np.isnan(X_train[:, i])\n    X_train[mask, i] = median_values[i]\n    \nfor i in range(X_val.shape[1]):\n    mask = np.isnan(X_val[:, i])\n    X_val[mask, i] = median_values[i]\n\nscaler = StandardScaler()\nX_train = scaler.fit_transform(X_train)\nX_val = scaler.transform(X_val)\n\n# Tensors\nX_train_t = torch.tensor(X_train, dtype=torch.float32).to(DEVICE)\ny_train_t = torch.tensor(y_train, dtype=torch.float32).unsqueeze(1).to(DEVICE)\nX_val_t = torch.tensor(X_val, dtype=torch.float32).to(DEVICE)\ny_val_t = torch.tensor(y_val, dtype=torch.float32).unsqueeze(1).to(DEVICE)\n\nbatch_size = 1024\ntrain_loader = DataLoader(TensorDataset(X_train_t, y_train_t), batch_size=batch_size, shuffle=True)\n\n# Model\nclass SimpleMLP(nn.Module):\n    def __init__(self, input_dim):\n        super().__init__()\n        self.net = nn.Sequential(\n            nn.Linear(input_dim, 128),\n            nn.ReLU(),\n            nn.BatchNorm1d(128),\n            nn.Linear(128, 64),\n            nn.ReLU(),\n            nn.BatchNorm1d(64),\n            nn.Linear(64, 1),\n            nn.Sigmoid()\n        )\n    def forward(self, x):\n        return self.net(x)\n\nmodel = SimpleMLP(X_train.shape[1]).to(DEVICE)\noptimizer = optim.Adam(model.parameters(), lr=0.001)\ncriterion = nn.BCELoss()\n\nbest_val_auc = 0\npatience = 20\nepochs = 200\ncounter = 0\n\nfor epoch in range(epochs):\n    model.train()\n    train_loss = 0\n    for batch_x, batch_y in train_loader:\n        optimizer.zero_grad()\n        outputs = model(batch_x)\n        loss = criterion(outputs, batch_y)\n        loss.backward()\n        optimizer.step()\n        train_loss += loss.item()\n    \n    model.eval()\n    with torch.no_grad():\n        val_preds = model(X_val_t).cpu().numpy()\n        val_auc = roc_auc_score(y_val, val_preds)\n    \n    if val_auc > best_val_auc:\n        best_val_auc = val_auc\n        torch.save(model.state_dict(), 'best_model.pt')\n        counter = 0\n    else:\n        counter += 1\n        \n    if epoch % 10 == 0:\n        print(f'Epoch {epoch}: val_auc={val_auc:.4f}')\n    \n    if counter >= patience:\n        print(f'Early stopping at epoch {epoch}')\n        break\n\nprint(f'VALIDATION_SCORE={best_val_auc}')\nEOF\n"]
[53.221341, "o", "cat << 'EOF' > train_model.py"]
