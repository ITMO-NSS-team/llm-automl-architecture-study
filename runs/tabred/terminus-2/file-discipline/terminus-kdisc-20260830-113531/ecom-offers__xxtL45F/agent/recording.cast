[1504.699534, "o", "\u001b[?2004hroot@c6e497d4bbe9:/workspace# ls -l /app/predictions.csv\r\n\u001b[?2004l\r-rw-r--r-- 1 root root 290302 Aug 30 13:13 /app/predictions.csv\r\n\u001b[?2004hroot@c6e497d4bbe9:/workspace# pkill -f train_xgboost.py\r\n\u001b[?2004l\rbash: pkill: command not found\r\n\u001b[?2004hroot@c6e497d4bbe9:/workspace# cat << 'EOF' > train_xgboost_fast.py\r\n\u001b[?2004l\r\u001b[?2004h> import pandas as pd\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> import torch\r\n\u001b[?2004l\r\u001b[?2004h> from xgboost import XGBClassifier\r\n\u001b[?2004l\r\u001b[?2004h> from sklearn.metrics import roc_auc_score\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> DEVICE = ('cuda' if torch.cuda.is_available()\r\n\u001b[?2004l\r\u001b[?2004h>           else 'mps' if torch.backends.mps.is_available() else 'cpu')\r\n\u001b[?2004l\r\u001b[?2004h> print('DEVICE=', DEVICE)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print('Loading data...')\r\n\u001b[?2004l\r\u001b[?2004h> train_df = pd.read_csv('/app/data/train.csv')\r\n\u001b[?2004l\r\u001b[?2004h> val_df = pd.read_csv('/app/data/val.csv')\r\n\u001b[?2004l\r\u001b[?2004h> test_df = pd.read_csv('/app/data/test.csv')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> X_train = train_df.drop('target', axis=1)\r\n\u001b[?2004l\r\u001b[?2004h> y_train = train_df['target'].astype(int)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> X_val = val_df.drop('target', axis=1)\r\n\u001b[?2004l\r\u001b[?2004h> y_val = val_df['target'].astype(int)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print('Training Fast XGBoost...')\r\n\u001b[?2004l\r\u001b[?2004h> model = XGBClassifier(\r\n\u001b[?2004l\r\u001b[?2004h>     n_estimators=200,\r\n\u001b[?2004l\r\u001b[?2004h>     learning_rate=0.1,\r\n\u001b[?2004l\r\u001b[?2004h>     max_depth=4,\r\n\u001b[?2004l\r\u001b[?2004h>     n_jobs=-1,\r\n\u001b[?2004l\r\u001b[?2004h>     random_state=42,\r\n\u001b[?2004l\r\u001b[?2004h>     eval_metric='auc',\r\n\u001b[?2004l\r\u001b[?2004h>     early_stopping_rounds=20\r\n\u001b[?2004l\r\u001b[?2004h> )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> model.fit(\r\n\u001b[?2004l\r\u001b[?2004h>     X_train, y_train,\r\n\u001b[?2004l\r\u001b[?2004h>     eval_set=[(X_val, y_val)],\r\n\u001b[?2004l\r\u001b[?2004h>     verbose=20\r\n\u001b[?2004l\r\u001b[?2004h> )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> val_preds = model.predict_proba(X_val)[:, 1]\r\n\u001b[?2004l\r\u001b[?2004h> val_auc = roc_auc_score(y_val, val_preds)\r\n\u001b[?2004l\r\u001b[?2004h> print(f'VALIDATION_SCORE={val_auc}')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> test_preds = model.predict_proba(test_df)[:, 1]\r\n\u001b[?2004l\r\u001b[?2004h> preds_df = pd.DataFrame({'target': test_preds})\r\n\u001b[?2004l\r\u001b[?2004h> preds_df.to_csv('/app/predictions.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h> print('Predictions saved to /app/predictions.csv')\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
