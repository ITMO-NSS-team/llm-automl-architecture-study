[?2004l[?2004h> y_val = val_df['target'].values
[?2004l[?2004h> 
[?2004l[?2004h> # Preprocessing
[?2004l[?2004h> # Fill NaNs with median from training set
[?2004l[?2004h> median_values = np.nanmedian(X_train, axis=0)
[?2004l[?2004h> X_train = np.nan_to_num(X_train, nan=np.nan)
[?2004l[?2004h> # We need to be careful with nan_to_num; it replaces nan with 0 by default if nan=np.nan is used incorrectly
[?2004l[?2004h> # Let's do it properly
[?2004l[?2004h> for i in range(X_train.shape[1]):
[?2004l[?2004h>     mask = np.isnan(X_train[:, i])
[?2004l[?2004h>     X_train[mask, i] = median_values[i]
[?2004l[?2004h>     
[?2004l[?2004h> for i in range(X_val.shape[1]):
[?2004l[?2004h>     mask = np.isnan(X_val[:, i])
[?2004l[?2004h>     X_val[mask, i] = median_values[i]
[?2004l[?2004h> 
[?2004l[?2004h> scaler = StandardScaler()
[?2004l[?2004h> X_train = scaler.fit_transform(X_train)
[?2004l[?2004h> X_val = scaler.transform(X_val)
[?2004l[?2004h> 
[?2004l[?2004h> # Tensors
[?2004l[?2004h> X_train_t = torch.tensor(X_train, dtype=torch.float32).to(DEVICE)
[?2004l[?2004h> y_train_t = torch.tensor(y_train, dtype=torch.float32).unsqueeze(1).to(DEVICE)
[?2004l[?2004h> X_val_t = torch.tensor(X_val, dtype=torch.float32).to(DEVICE)
[?2004l[?2004h> y_val_t = torch.tensor(y_val, dtype=torch.float32).unsqueeze(1).to(DEVICE)
[?2004l[?2004h> 
[?2004l[?2004h> batch_size = 1024
[?2004l[?2004h> train_loader = DataLoader(TensorDataset(X_train_t, y_train_t), batch_size=batch_size, shuffle=True)
[?2004l[?2004h> 
[?2004l[?2004h> # Model
[?2004l[?2004h> class SimpleMLP(nn.Module):
[?2004l[?2004h>     def __init__(self, input_dim):
[?2004l[?2004h>         super().__init__()
[?2004l[?2004h>         self.net = nn.Sequential(
[?2004l[?2004h>             nn.Linear(input_dim, 128),
[?2004l[?2004h>             nn.ReLU(),
[?2004l[?2004h>             nn.BatchNorm1d(128),
[?2004l[?2004h>             nn.Linear(128, 64),
[?2004l[?2004h>             nn.ReLU(),
[?2004l[?2004h>             nn.BatchNorm1d(64),
[?2004l[?2004h>             nn.Linear(64, 1),
[?2004l[?2004h>             nn.Sigmoid()
[?2004l[?2004h>         )
[?2004l[?2004h>     def forward(self, x):
[?2004l[?2004h>         return self.net(x)
[?2004l[?2004h> 
[?2004l[?2004h> model = SimpleMLP(X_train.shape[1]).to(DEVICE)
[?2004l[?2004h> optimizer = optim.Adam(model.parameters(), lr=0.001)
[?2004l[?2004h> criterion = nn.BCELoss()
[?2004l[?2004h> 
[?2004l[?2004h> best_val_auc = 0
[?2004l[?2004h> patience = 20
[?2004l[?2004h> epochs = 200
[?2004l[?2004h> counter = 0
[?2004l[?2004h> 
[?2004l[?2004h> for epoch in range(epochs):
[?2004l[?2004h>     model.train()
[?2004l[?2004h>     train_loss = 0
[?2004l[?2004h>     for batch_x, batch_y in train_loader:
[?2004l[?2004h>         optimizer.zero_grad()
[?2004l[?2004h>         outputs = model(batch_x)
[?2004l[?2004h>         loss = criterion(outputs, batch_y)
[?2004l[?2004h>         loss.backward()
[?2004l[?2004h>         optimizer.step()
[?2004l[?2004h>         train_loss += loss.item()
[?2004l[?2004h>     
[?2004l[?2004h>     model.eval()
[?2004l[?2004h>     with torch.no_grad():
[?2004l[?2004h>         val_preds = model(X_val_t).cpu().numpy()
[?2004l[?2004h>         val_auc = roc_auc_score(y_val, val_preds)
