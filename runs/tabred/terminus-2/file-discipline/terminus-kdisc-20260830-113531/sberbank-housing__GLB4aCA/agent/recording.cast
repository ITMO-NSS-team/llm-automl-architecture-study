[370.917087, "i", "cat << 'EOF' > train_catboost.py\nimport pandas as pd\nimport numpy as np\nfrom catboost import CatBoostRegressor, Pool\nfrom sklearn.metrics import mean_squared_error\n\n# Load data\ntrain_df = pd.read_csv('/app/data/train.csv')\nval_df = pd.read_csv('/app/data/val.csv')\n\nX_train = train_df.drop('target', axis=1)\ny_train = train_df['target']\nX_val = val_df.drop('target', axis=1)\ny_val = val_df['target']\n\n# Identify categorical features\ncat_cols = [c for c in X_train.columns if c.startswith('cat_')]\n\n# CatBoost handles NaNs and categoricals natively\n# We just need to specify the categorical feature indices\ncat_indices = [X_train.columns.get_loc(c) for c in cat_cols]\n\nmodel = CatBoostRegressor(\n    iterations=2000,\n    learning_rate=0.05,\n    depth=6,\n    l2_leaf_reg=3,\n    eval_metric='RMSE',\n    random_seed=42,\n    verbose=100\n)\n\nmodel.fit(\n    X_train,\n    y_train,\n    eval_set=(X_val, y_val),\n    early_stopping_rounds=50,\n    cat_features=cat_indices\n)\n\n# Best model prediction\nval_preds = model.predict(X_val)\nrmse = np.sqrt(mean_squared_error(y_val, val_preds))\nprint(f'VALIDATION_SCORE={rmse}')\nmodel.save_model('best_model.cbegin')\nEOF\n"]
[370.917591, "o", "cat << 'EOF' > train_catboost.py\r\nimport pandas as pd\r\nimport numpy as np\r\nfrom catboost import CatBoostRegressor, Pool\r\nfrom sklearn.metrics import mean_squared_error\r\n\r\n# Load data\r\ntrain_df = pd.read_csv('/app/data/train.csv')\r\nval_df = pd.read_csv('/app/data/val.csv')\r\n\r\nX_train = train_df.drop('target', axis=1)\r\ny_train = train_df['target']\r\nX_val = val_df.drop('target', axis=1)\r\ny_val = val_df['target']\r\n\r\n# Identify categorical features\r\ncat_cols = [c for c in X_train.columns if c.startswith('cat_')]\r\n\r\n# CatBoost handles NaNs and categoricals natively\r\n# We just need to specify the categorical feature indices\r\ncat_indices = [X_train.columns.get_loc(c) for c in cat_cols]\r\n\r\nmodel = CatBoostRegressor(\r\n    iterations=2000,\r\n    learning_rate=0.05,\r\n    depth=6,\r\n    l2_leaf_reg=3,\r\n    eval_metric='RMSE',\r\n    random_seed=42,\r\n    verbose=100\r\n)\r\n\r\nmodel.fit(\r\n    X_train,\r\n    y_train,\r\n    eval_set=(X_val, y_val),\r\n    early_stopping_rounds=50,\r\n    cat_features=cat_indices\r\n)\r\n\r\n# Best model prediction\r\nval_preds = model.predict(X_val)\r\nrmse = np.sqrt(mean_squared_error(y_val, val_preds))\r\nprint(f'VALIDATION_SCORE={rmse}')\r\nmodel.save_model('best_model.cbegin')\r\nEOF\r\n"]
