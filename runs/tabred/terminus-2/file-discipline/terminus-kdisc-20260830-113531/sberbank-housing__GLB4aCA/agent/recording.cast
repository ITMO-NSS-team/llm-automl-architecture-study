[20.57385, "o", "\r\n\u001b[?2004l\r"]
[20.573933, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[20.574046, "o", "> median_target = train['target'].median()"]
[20.574123, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> val_preds = np.full(len(val), median_target)"]
[20.574202, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[20.574302, "o", "rmse = np.sqrt(mean_squared_error(val['target'], val_preds))"]
[20.574357, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[20.57444, "o", "print(f'TRAIN_MEDIAN={median_target}')\r\n\u001b[?2004l\r\u001b[?2004h"]
[20.574498, "o", "> print(f'BASELINE_VALIDATION_SCORE={rmse}')"]
[20.574722, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
