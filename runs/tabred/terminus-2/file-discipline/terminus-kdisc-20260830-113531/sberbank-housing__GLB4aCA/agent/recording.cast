[14.240826, "i", "python3 -c \"import pandas as pd\nimport numpy as np\nfrom sklearn.metrics import mean_squared_error\n\ntrain = pd.read_csv('/app/data/train.csv')\nval = pd.read_csv('/app/data/val.csv')\n\nmedian_target = train['target'].median()\nval_preds = np.full(len(val), median_target)\nrmse = np.sqrt(mean_squared_error(val['target'], val_preds))\n\nprint(f'TRAIN_MEDIAN={median_target}')\nprint(f'BASELINE_VALIDATION_SCORE={rmse}')\n\"\n"]
