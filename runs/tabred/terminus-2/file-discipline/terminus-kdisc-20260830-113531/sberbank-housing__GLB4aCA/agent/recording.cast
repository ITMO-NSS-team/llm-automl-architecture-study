[1002.587032, "i", "cat << 'EOF' > predict_baseline.py\nimport pandas as pd\nimport numpy as np\n\ntrain = pd.read_csv('/app/data/train.csv')\ntest = pd.read_csv('/app/data/test.csv')\n\nmedian_target = train['target'].median()\npredictions = np.full(len(test), median_target)\n\nsubmission = pd.DataFrame({'target': predictions})\nsubmission.to_csv('/app/predictions.csv', index=False)\nprint('Predictions based on training median saved to /app/predictions.csv')\nEOF\n"]
[1002.587285, "o", "cat << 'EOF' > predict_baseline.py\r\nimport pandas as pd\r\nimport numpy as np\r\n\r\ntrain = pd.read_csv('/app/data/train.csv')\r\ntest = pd.read_csv('/app/data/test.csv')\r\n\r\nmedian_target = train['target'].median()\r\npredictions = np.full(len(test), median_target)\r\n\r\nsubmission = pd.DataFrame({'target': predictions})\r\nsubmission.to_csv('/app/predictions.csv', index=False)\r\nprint('Predictions based on training median saved to /app/predictions.csv')\r\nEOF\r\n"]
