[20.581192, "o", "root@ca651dcac05c:/workspace# "]
[20.692732, "i", "python3 baseline.py\n"]
[20.693052, "o", "python3 baseline.py\r\n"]
[20.694063, "o", "\u001b[?2004l\r"]
[22.233598, "o", "TRAIN_MEDIAN=11.8383474\r\nBASELINE_VALIDATION_SCORE=0.3876076720129878\r\n"]
[22.367119, "o", "\u001b[?2004hroot@ca651dcac05c:/workspace# "]
[44.580114, "i", "cat << 'EOF' > train.py\nimport torch\nimport torch.nn as nn\nimport torch.optim as optim\nfrom torch.utils.data import DataLoader, TensorDataset\nimport pandas as pd\nimport numpy as np\nfrom sklearn.preprocessing import StandardScaler, OneHotEncoder\nfrom sklearn.metrics import mean_squared_error\n\n# Hardware resolve as REQUIRED\nimport torch\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\n# Budget allocation\nprint('Budget: Exploration (done), Training (2h), Improvement (1h), Finalization (30m)')\n\n# Data loading\ntrain_df = pd.read_csv('/app/data/train.csv')\nval_df = pd.read_csv('/app/data/val.csv')\n\nX_train_raw = train_df.drop('target', axis=1)\ny_train = train_df['target'].values\nX_val_raw = val_df.drop('target', axis=1)\ny_val = val_df['target'].values\n\n# Identify feature types\nnum_cols = [c for c in X_train_raw.columns if c.startswith('num_')]\nbin_cols = [c for c in X_train_raw.columns if c.startswith('bin_')]\ncat_cols = [c for c in X_train_raw.columns if c.startswith('cat_')]\n\n# Preprocessing\nscaler = StandardScaler()\nX_train_num = scaler.fit_transform(X_train_raw[num_cols].fillna(X_train_raw[num_cols].median()))\nX_val_num = scaler.transform(X_val_raw[num_cols].fillna(X_train_raw[num_cols].median()))\n\n# Binary columns are already 0/1\nX_train_bin = X_train_raw[bin_cols].fillna(0).values\nX_val_bin = X_val_raw[bin_cols].fillna(0).values\n\n# Categorical columns\nencoder = OneHotEncoder(sparse_output=False, handle_unknown='ignore')\nX_train_cat = encoder.fit_transform(X_train_raw[cat_cols].fillna('nan'))\nX_val_cat = encoder.transform(X_val_raw[cat_cols].fillna('nan'))\n\n# Combine\nX_train = np.hstack([X_train_num, X_train_bin, X_train_cat])\nX_val = np.hstack([X_val_num, X_val_bin, X_val_cat])\n\n# Convert to tensors\nX_train_t = torch.tensor(X_train, dtype=torch.float32).to(DEVICE)\ny_train_t = torch.tensor(y_train, dtype=torch.float32).to(DEVICE).view(-1, 1)\nX_val_t = torch.tensor(X_val, dtype=torch.float32).to(DEVICE)\ny_val_t = torch.tensor(y_val, dtype=torch.float32).to(DEVICE).view(-1, 1)\n\n# Dataset\ntrain_ds = TensorDataset(X_train_t, y_train_t)\ntrain_loader = DataLoader(train_ds, batch_size=256, shuffle=True)\n\n# Model\nclass MLP(nn.Module):\n    def __init__(self, input_dim):\n        super().__init__()\n        self.net = nn.Sequential(\n            nn.Linear(input_dim, 256),\n            nn.ReLU(),\n            nn.Dropout(0.1),\n            nn.Linear(256, 128),\n            nn.ReLU(),\n            nn.Dropout(0.1),\n            nn.Linear(128, 64),\n            nn.ReLU(),\n            nn.Linear(64, 1)\n        )\n    def forward(self, x):\n        return self.net(x)\n\nmodel = MLP(X_train.shape[1]).to(DEVICE)\ncriterion = nn.MSELoss()\noptimizer = optim.Adam(model.parameters(), lr=0.001)\n\n# Training loop\nbest_rmse = float('inf')\npatience = 20\ncounter = 0\nepochs = 500\n\nfor epoch in range(epochs):\n    model.train()\n    train_loss = 0\n    for bx, by in train_loader:\n        optimizer.zero_grad()\n        pred = model(bx)\n        loss = criterion(pred, by)\n        loss.backward()\n        optimizer.step()\n        train_loss += loss.item()\n    \n    model.eval()\n    with torch.no_grad():\n        val_pred = model(X_val_t)\n        val_rmse = np.sqrt(mean_squared_error(y_val, val_pred.cpu().numpy()))\n    \n    if val_rmse < best_rmse:\n        best_rmse = val_rmse\n        torch.save(model.state_dict(), 'best_model.pt')\n        counter = 0\n    else:\n        counter += 1\n        \n    if counter >= patience:\n        print(f'Early stopping at epoch {epoch}')\n        break\n\nprint(f'VALIDATION_SCORE={best_rmse}')\nEOF\n"]
[44.580559, "o", "cat << 'EOF' > train.py"]
