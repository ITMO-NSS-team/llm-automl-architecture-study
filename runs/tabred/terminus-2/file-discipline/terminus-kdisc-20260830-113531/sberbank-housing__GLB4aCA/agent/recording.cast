[862.791545, "i", "cat << 'EOF' > train_catboost.py\nimport pandas as pd\nimport numpy as np\nfrom catboost import CatBoostRegressor\nfrom sklearn.metrics import mean_squared_error\nimport sys\n\nprint('START: Loading data...', flush=True)\ntrain_df = pd.read_csv('/app/data/train.csv')\nval_df = pd.read_csv('/app/data/val.csv')\n\nX_train = train_df.drop('target', axis=1)\ny_train = train_df['target']\nX_val = val_df.drop('target', axis=1)\ny_val = val_df['target']\n\ncat_cols = [c for c in X_train.columns if c.startswith('cat_')]\ncat_indices = [X_train.columns.get_loc(c) for c in cat_cols]\n\nprint('START: Training CatBoost...', flush=True)\nmodel = CatBoostRegressor(\n    iterations=200,\n    learning_rate=0.1,\n    depth=6,\n    eval_metric='RMSE',\n    random_seed=42,\n    verbose=10\n)\n\nmodel.fit(\n    X_train,\n    y_train,\n    eval_set=(X_val, y_val),\n    early_stopping_rounds=20,\n    cat_features=cat_indices\n)\n\nval_preds = model.predict(X_val)\nrmse = np.sqrt(mean_squared_error(y_val, val_preds))\nprint(f'VALIDATION_SCORE={rmse}', flush=True)\nmodel.save_model('best_model.cbegin')\nprint('FINISH: Model saved.', flush=True)\nEOF\n"]
[862.793514, "o", "cat << 'EOF' > train_catboost.py\r\nimport pandas as pd\r\nimport numpy as np\r\nfrom catboost import CatBoostRegressor\r\nfrom sklearn.metrics import mean_squared_error\r\nimport sys\r\n\r\nprint('START: Loading data...', flush=True)\r\ntrain_df = pd.read_csv('/app/data/train.csv')\r\nval_df = pd.read_csv('/app/data/val.csv')\r\n\r\nX_train = train_df.drop('target', axis=1)\r\ny_train = train_df['target']\r\nX_val = val_df.drop('target', axis=1)\r\ny_val = val_df['target']\r\n\r\ncat_cols = [c for c in X_train.columns if c.startswith('cat_')]\r\ncat_indices = [X_train.columns.get_loc(c) for c in cat_cols]\r\n\r\nprint('START: Training CatBoost...', flush=True)\r\nmodel = CatBoostRegressor(\r\n    iterations=200,\r\n    learning_rate=0.1,\r\n    depth=6,\r\n    eval_metric='RMSE',\r\n    random_seed=42,\r\n    verbose=10\r\n)\r\n\r\nmodel.fit(\r\n    X_train,\r\n    y_train,\r\n    eval_set=(X_val, y_val),\r\n    early_stopping_rounds=20,\r\n    cat_features=cat_indices\r\n)\r\n\r\nval_preds = model.predict(X_val)\r\nrmse = np.sqrt(mean_squared_error(y_val, val_preds))\r\nprint(f'VALIDATION_SCORE={rmse}', flush=True)\r\nmodel.save_model('best_model.cbegin')\r\nprint('FINISH: Model saved.', flush=True)\r\nEOF\r\n"]
