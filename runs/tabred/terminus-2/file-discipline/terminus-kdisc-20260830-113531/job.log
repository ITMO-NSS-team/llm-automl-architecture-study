e.transform(X_val[col].astype(str))\n        X_test[col] = le.transform(X_test[col].astype(str))\n        \n    # Binary: Just ensure they are float\n    X_train[bin_cols] = X_train[bin_cols].astype(np.float32)\n    X_val[bin_cols] = X_val[bin_cols].astype(np.float32)\n    X_test[bin_cols] = X_test[bin_cols].astype(np.float32)\n    \n    return X_train.values.astype(np.float32), X_val.values.astype(np.float32), X_test.values.astype(np.float32), y_train, y_val\n\nclass TabularModel(nn.Module):\n    def __init__(self, input_dim):\n        super().__init__()\n        self.net = nn.Sequential(\n            nn.Linear(input_dim, 256),\n            nn.ReLU(),\n            nn.BatchNorm1d(256),\n            nn.Dropout(0.2),\n            nn.Linear(256, 128),\n            nn.ReLU(),\n            nn.BatchNorm1d(128),\n            nn.Dropout(0.2),\n            nn.Linear(128, 64),\n            nn.ReLU(),\n            nn.Linear(64, 1),\n            nn.Sigmoid()\n        )\n    def forward(self, x):\n        return self.net(x)\n\ndef train():\n    train_df, val_df, test_df = load_data()\n    X_train, X_val, X_test, y_train, y_val = preprocess(train_df, val_df, test_df)\n    \n    # Trivial Baseline\n    train_mean = np.mean(y_train)\n    baseline_preds = np.full_like(y_val, train_mean)\n    baseline_score = roc_auc_score(y_val, baseline_preds)\n    print(f'TRIVIAL_BASELINE_SCORE={baseline_score}')\n\n    # DataLoaders\n    train_ds = TensorDataset(torch.tensor(X_train), torch.tensor(y_train).view(-1, 1))\n    val_ds = TensorDataset(torch.tensor(X_val), torch.tensor(y_val).view(-1, 1))\n    train_loader = DataLoader(train_ds, batch_size=1024, shuffle=True)\n    val_loader = DataLoader(val_ds, batch_size=1024, shuffle=False)\n\n    model = TabularModel(X_train.shape[1]).to(DEVICE)\n    criterion = nn.BCELoss()\n    optimizer = optim.Adam(model.parameters(), lr=1e-3)\n    \n    best_score = 0\n    patience = 10\n    no_improve = 0\n    epochs = 200\n    \n    for epoch in range(epochs):\n        model.train()\n        for xb, yb in train_loader:\n            xb, yb = xb.to(DEVICE), yb.to(DEVICE)\n            optimizer.zero_grad()\n            pred = model(xb)\n            loss = criterion(pred, yb)\n            loss.backward()\n            optimizer.step()\n        \n        model.eval()\n        val_preds = []\n        with torch.no_grad():\n            for xb, yb in val_loader:\n                xb = xb.to(DEVICE)\n                val_preds.extend(model(xb).cpu().numpy().flatten())\n        \n        score = roc_auc_score(y_val, val_preds)\n        print(f'Epoch {epoch+1}/{epochs}, VALIDATION_SCORE={score}')\n        \n        if score > best_score:\n            best_score = score\n            torch.save(model.state_dict(), 'best_model.pt')\n            no_improve = 0\n        else:\n            no_improve += 1\n            \n        if no_improve >= patience:\n            print('Early stopping triggered')\n            break\n\n    print(f'FINAL_VALIDATION_SCORE={best_score}')\n    \n    # Final predictions\n    model.load_state_dict(torch.load('best_model.pt'))\n    model.eval()\n    test_tensor = torch.tensor(X_test).to(DEVICE)\n    with torch.no_grad():\n        test_preds = model(test_tensor).cpu().numpy().flatten()\n    \n    pd.DataFrame({'target': test_preds}).to_csv('/app/predictions.csv', index=False)\n    print('Predictions saved to /app/predictions.csv')\n\nif __name__ == '__main__':\n    train()\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
