x_val_raw[col] = le.transform(x_val_raw[col].astype(str))\n    x_test_raw[col] = le.transform(x_test_raw[col].astype(str))\n\n# Scale numerical features\nscaler = StandardScaler()\nx_train_scaled = scaler.fit_transform(x_train_raw[num_cols])\nx_val_scaled = scaler.transform(x_val_raw[num_cols])\nx_test_scaled = scaler.transform(x_test_raw[num_cols])\n\n# Combine all features\ndef combine_feats(num, bin_df, cat_df):\n    return np.hstack([num, bin_df.values, cat_df.values])\n\nX_train = combine_feats(x_train_scaled, x_train_raw[bin_cols + cat_cols], pd.DataFrame())\n# Wait, the logic above is slightly wrong, I already encoded cats in x_train_raw\nX_train = np.hstack([x_train_scaled, x_train_raw[bin_cols].values, x_train_raw[cat_cols].values])\nX_val = np.hstack([x_val_scaled, x_val_raw[bin_cols].values, x_val_raw[cat_cols].values])\nX_test = np.hstack([x_test_scaled, x_test_raw[bin_cols].values, x_test_raw[cat_cols].values])\n\n# Convert to torch tensors\nX_train_t = torch.tensor(X_train, dtype=torch.float32).to(DEVICE)\ny_train_t = torch.tensor(y_train, dtype=torch.float32).unsqueeze(1).to(DEVICE)\nX_val_t = torch.tensor(X_val, dtype=torch.float32).to(DEVICE)\ny_val_t = torch.tensor(y_val, dtype=torch.float32).unsqueeze(1).to(DEVICE)\nX_test_t = torch.tensor(X_test, dtype=torch.float32).to(DEVICE)\n\n# Model\nclass TabNetSimple(nn.Module):\n    def __init__(self, input_dim):\n        super().__init__()\n        self.net = nn.Sequential(\n            nn.Linear(input_dim, 256),\n            nn.ReLU(),\n            nn.Dropout(0.1),\n            nn.Linear(256, 128),\n            nn.ReLU(),\n            nn.Dropout(0.1),\n            nn.Linear(128, 64),\n            nn.ReLU(),\n            nn.Linear(64, 1)\n        )\n    def forward(self, x):\n        return self.net(x)\n\nmodel = TabNetSimple(X_train.shape[1]).to(DEVICE)\noptimizer = torch.optim.Adam(model.parameters(), lr=0.001)\ncriterion = nn.MSELoss()\n\n# Training loop with early stopping\nepochs = 500\npatience = 20\nbest_val_rmse = float('inf')\nbest_model_state = None\n\ntrain_loader = DataLoader(TensorDataset(X_train_t, y_train_t), batch_size=256, shuffle=True)\n\nprint('Training...')\nfor epoch in range(epochs):\n    model.train()\n    train_loss = 0\n    for batch_x, batch_y in train_loader:\n        optimizer.zero_grad()\n        pred = model(batch_x)\n        loss = criterion(pred, batch_y)\n        loss.backward()\n        optimizer.step()\n        train_loss += loss.item()\n    \n    model.eval()\n    with torch.no_grad():\n        val_pred_t = model(X_val_t)\n        val_pred = val_pred_t.cpu().numpy()\n        current_val_rmse = rmse(y_val, val_pred)\n    \n    if current_val_rmse < best_val_rmse:\n        best_val_rmse = current_val_rmse\n        best_model_state = model.state_dict()\n        counter = 0\n    else:\n        counter += 1\n    \n    if epoch % 10 == 0:\n        print(f'Epoch {epoch}: Val RMSE = {current_val_rmse:.4f}')\n    \n    if counter >= patience:\n        print(f'Early stopping at epoch {epoch}')\n        break\n\nprint(f'VALIDATION_SCORE={best_val_rmse}')\n\n# Final Prediction\nmodel.load_state_dict(best_model_state)\nmodel.eval()\nwith torch.no_grad():\n    test_preds = model(X_test_t).cpu().numpy().flatten()\n\n# Sanity Check\nif np.any(np.isnan(test_preds)) or np.any(np.isinf(test_preds)):\n    print('Degenerate predictions detected! Using baseline instead.')\n    test_preds = np.full(len(test_preds), np.median(y_train))\n\nsubmission = pd.DataFrame({'target': test_preds})\nsubmission.to_csv('/app/predictions.csv', index=False)\nprint('Submission saved to /app/predictions.csv')\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
