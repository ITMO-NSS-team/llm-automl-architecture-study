Sending keys: ["cat << 'EOF' > train.py\nimport torch\nimport torch.nn as nn\nimport torch.optim as optim\nfrom torch.utils.data import DataLoader, Dataset\nimport pandas as pd\nimport numpy as np\nfrom sklearn.preprocessing import StandardScaler, LabelEncoder\nfrom sklearn.metrics import mean_squared_error\nimport json\n\n# HARDWARE REQUIREMENT\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\nclass TabularDataset(Dataset):\n    def __init__(self, X, y=None):\n        self.X = torch.tensor(X, dtype=torch.float32)\n        self.y = torch.tensor(y, dtype=torch.float32).unsqueeze(1) if y is not None else None\n\n    def __len__(self):\n        return len(self.X)\n\n    def __getitem__(self, idx):\n        if self.y is not None:\n            return self.X[idx], self.y[idx]\n        return self.X[idx]\n\ndef preprocess():\n    train = pd.read_csv('/app/data/train.csv')\n    val = pd.read_csv('/app/data/val.csv')\n    \n    num_cols = [c for c in train.columns if c.startswith('num_')]\n    bin_cols = [c for c in train.columns if c.startswith('bin_')]\n    cat_cols = [c for c in train.columns if c.startswith('cat_')]\n    \n    # Numerical\n    num_means = train[num_cols].mean()\n    train[num_cols] = train[num_cols].fillna(num_means)\n    val[num_cols] = val[num_cols].fillna(num_means)\n    \n    scaler = StandardScaler()\n    train[num_cols] = scaler.fit_transform(train[num_cols])\n    val[num_cols] = scaler.transform(val[num_cols])\n    \n    # Categorical\n    cat_mappings = {}\n    for col in cat_cols:\n        le = LabelEncoder()\n        train[col] = le.fit_transform(train[col].astype(str))\n        val[col] = le.transform(val[col].astype(str))\n        cat_mappings[col] = le\n        \n    # Target\n    y_train = train['target'].values\n    y_val = val['target'].values\n    \n    X_train = train[num_cols + bin_cols + cat_cols].values\n    X_val = val[num_cols + bin_cols + cat_cols].values\n    \n    return X_train, y_train, X_val, y_val, num_cols, bin_cols, cat_cols, cat_mappings, scaler\n\nclass TabularModel(nn.Module):\n    def __init__(self, num_cont, cat_cols_sizes):\n        super().__init__()\n        # Simple MLP for this task\n        self.net = nn.Sequential(\n            nn.Linear(num_cont, 256),\n            nn.ReLU(),\n            nn.BatchNorm1d(256),\n            nn.Linear(256, 128),\n            nn.ReLU(),\n            nn.BatchNorm1d(128),\n            nn.Linear(128, 64),\n            nn.ReLU(),\n            nn.Linear(64, 1)\n        )\n\n    def forward(self, x):\n        return self.net(x)\n\nif __name__ == '__main__':\n    X_train, y_train, X_val, y_val, num_cols, bin_cols, cat_cols, cat_mappings, scaler = preprocess()\n    \n    train_ds = TabularDataset(X_train, y_train)\n    val_ds = TabularDataset(X_val, y_val)\n    \n    train_loader = DataLoader(train_ds, batch_size=1024, shuffle=True)\n    val_loader = DataLoader(val_ds, batch_size=1024)\n    \n    model = TabularModel(len(num_cols) + len(bin_cols) + len(cat_cols), []).to(DEVICE)\n    criterion = nn.MSELoss()\n    optimizer = optim.Adam(model.parameters(), lr=1e-3)\n    scheduler = optim.lr_scheduler.ReduceLROnPlateau(optimizer, 'min', patience=5, factor=0.5)\n    \n    best_rmse = float('inf')\n    patience_counter = 0\n    best_epoch = 0\n    \n    for epoch in range(1, 201):\n        model.train()\n        train_loss = 0\n        for xb, yb in train_loader:\n            xb, yb = xb.to(DEVICE), yb.to(DEVICE)\n            optimizer.zero_grad()\n            pred = model(xb)\n            loss = criterion(pred, yb)\n            loss.backward()\n            optimizer.step()\n            train_loss += loss.item()\n        \n        model.eval()\n        val_preds = []\n        val_targets = []\n        with torch.no_grad():\n            for xb, yb in val_loader:\n                xb, yb = xb.to(DEVICE), yb.to(DEVICE)\n                val_preds.append(model(xb).cpu().numpy())\n                val_targets.append(yb.cpu().numpy())\n        \n        val_preds = np.concatenate(val_preds)\n        val_targets = np.concatenate(val_targets)\n        rmse = np.sqrt(mean_squared_error(val_targets, val_preds))\n        \n        scheduler.step(rmse)\n        \n        if rmse < best_rmse:\n            best_rmse = rmse\n            torch.save(model.state_dict(), 'best_model.pth')\n            patience_counter = 0\n            best_epoch = epoch\n        else:\n            patience_counter += 1\n            \n        if epoch % 10 == 0:\n            print(f'Epoch {epoch} - VAL_RMSE: {rmse:.4f} - Best: {best_rmse:.4f}')\n            \n        if patience_counter >= 20:\n            print(f'Early stopping at epoch {epoch}')\n            break\n            \n    print(f'VALIDATION_SCORE={best_rmse}')\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
