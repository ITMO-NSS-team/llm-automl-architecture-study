Sending keys: ["cat << 'EOF' > solution.py\nimport pandas as pd\nimport numpy as np\nfrom sklearn.metrics import mean_squared_error\nimport torch\nfrom catboost import CatBoostRegressor\n\n# REQUIRED hardware resolution\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\n# Budget allocation\nprint('Budget: Exploration (10m), Training (1h), Finalization (10m)')\n\n# Load data\ntrain_df = pd.read_csv('/app/data/train.csv')\nval_df = pd.read_csv('/app/data/val.csv')\ntest_df = pd.read_csv('/app/data/test.csv')\n\nX_train = train_df.drop('target', axis=1)\ny_train = train_df['target']\nX_val = val_df.drop('target', axis=1)\ny_val = val_df['target']\n\n# Identify feature types\ncat_features = [col for col in X_train.columns if col.startswith('cat_') or col.startswith('bin_')]\n\n# Trivial Baseline\ntrain_median = y_train.median()\nbaseline_preds = np.full(len(y_val), train_median)\nbaseline_rmse = np.sqrt(mean_squared_error(y_val, baseline_preds))\nprint(f'TRIVIAL_BASELINE_SCORE={baseline_rmse}')\n\n# Model Training\nmodel = CatBoostRegressor(\n    iterations=2000,\n    learning_rate=0.05,\n    depth=6,\n    loss_function='RMSE',\n    eval_metric='RMSE',\n    task_type='GPU' if DEVICE == 'cuda' else 'CPU',\n    random_seed=42,\n    verbose=100\n)\n\nmodel.fit(\n    X_train, y_train,\n    eval_set=(X_val, y_val),\n    cat_features=cat_features,\n    early_stopping_rounds=100\n)\n\n# Validation\nval_preds = model.predict(X_val)\nval_rmse = np.sqrt(mean_squared_error(y_val, val_preds))\nprint(f'VALIDATION_SCORE={val_rmse}')\n\nif val_rmse >= baseline_rmse:\n    print('Model failed to beat baseline. Using baseline instead.')\nelse:\n    print('Model beat baseline!')\n\n# Final Predictions\nif val_rmse < baseline_rmse:\n    test_preds = model.predict(test_df)\nelse:\n    test_preds = np.full(len(test_df), train_median)\n\nsubmission = pd.DataFrame({'target': test_preds})\nsubmission