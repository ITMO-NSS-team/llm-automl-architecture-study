Sending keys: ['cat << \'EOF\' > solution.py\nimport pandas as pd\nimport numpy as np\nimport torch\nfrom lightgbm import LGBMClassifier, early_stopping, log_evaluation\nfrom sklearn.metrics import roc_auc_score\nimport json\n\n# Hardware resolution - REQUIRED\nDEVICE = (\'cuda\' if torch.cuda.is_available()\n          else \'mps\' if torch.backends.mps.is_available() else \'cpu\')\nprint(\'DEVICE=\', DEVICE)\n\n# Load schema\nwith open(\'/app/data/schema.json\', \'r\') as f:\n    schema = json.load(f)\n\nnum_cols = [c for c in schema[\'feature_columns\'] if c.startswith(\'num_\')]\nbin_cols = [c for c in schema[\'feature_columns\'] if c.startswith(\'bin_\')]\ncat_cols = [c for c in schema[\'feature_columns\'] if c.startswith(\'cat_\')]\n\n# Load data\nprint("Loading data...")\ntrain_df = pd.read_csv(\'/app/data/train.csv\')\nval_df = pd.read_csv(\'/app/data/val.csv\')\ntest_df = pd.read_csv(\'/app/data/test.csv\')\n\nX_train = train_df[schema[\'feature_columns\']].copy()\ny_train = train_df[\'target\']\n\nX_val = val_df[schema[\'feature_columns\']].copy()\ny_val = val_df[\'target\']\n\nX_test = test_df[schema[\'feature_columns\']].copy()\n\n# Preprocessing\nprint("Preprocessing...")\nmedians = X_train[num_cols].median()\nX_train[num_cols] = X_train[num_cols].fillna(medians)\nX_val[num_cols] = X_val[num_cols].fillna(medians)\nX_test[num_cols] = X_test[num_cols].fillna(medians)\n\nfor col in cat_cols:\n    X_train[col] = X_train[col].astype(\'category\')\n    X_val[col] = X_val[col].astype(\'category\')\n    X_test[col] = X_test[col].astype(\'category\')\n\n# Trivial Baseline\ntrain_mean = y_train.mean()\ntrivial_preds = np.full(len(y_val), train_mean)\ntry:\n    trivial_score = roc_auc_score(y_val, trivial_preds)\nexcept ValueError:\n    trivial_score = 0.5\nprint(f"TRIVIAL_BASELINE_MEAN={train_mean}")\nprint(f"TRIVIAL_SCORE={trivial_score}")\n\n# Model Training\nprint("Training model...")\nmodel = LGBMClassifier(\n    n_estimators=2000,\n    learning_rate=0.05,\n    num_leaves=31,\n    colsample_bytree=0.8,\n    subsample=0.8,\n    n_jobs=-1,\n    random_state=42\n)\n\nmodel.fit(\n    X_train, y_train,\n    eval_set=[(X_val, y_val)],\n    eval_metric=\'auc\',\n    callbacks=[early_stopping(stopping_rounds=100), log_evaluation(period=100)]\n)\n\nval_preds = model.predict_proba(X_val)[:, 1]\nval_score = roc_auc_score(y_val, val_preds)\nprint(f"VALIDATION_SCORE={val_score}")\n\nif val_score <= trivial_score:\n    print("Model did not beat trivial baseline. Using trivial predictions.")\n    test_preds = np.full(len(X_test), train_mean)\nelse:\n    print("Model beat trivial baseline.")\n    test_preds = model.predict_proba(X_test)[:, 1]\n\n# Submission\nsubmission = pd.DataFrame({\'target\': test_preds})\nsubmission.to_csv(\'/app/predictions.csv\', index=False)\nprint("Submission saved to /app/predictions.csv")\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
