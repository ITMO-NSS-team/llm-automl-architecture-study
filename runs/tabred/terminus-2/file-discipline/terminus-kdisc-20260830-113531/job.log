Sending keys: ["cat << 'EOF' > train_catboost.py\nimport pandas as pd\nimport numpy as np\nfrom catboost import CatBoostRegressor, Pool\nfrom sklearn.metrics import mean_squared_error\n\n# Load data\ntrain_df = pd.read_csv('/app/data/train.csv')\nval_df = pd.read_csv('/app/data/val.csv')\n\nX_train = train_df.drop('target', axis=1)\ny_train = train_df['target']\nX_val = val_df.drop('target', axis=1)\ny_val = val_df['target']\n\n# Identify categorical features\ncat_cols = [c for c in X_train.columns if c.startswith('cat_')]\n\n# CatBoost handles NaNs and categoricals natively\n# We just need to specify the categorical feature indices\ncat_indices = [X_train.columns.get_loc(c) for c in cat_cols]\n\nmodel = CatBoostRegressor(\n    iterations=2000,\n    learning_rate=0.05,\n    depth=6,\n    l2_leaf_reg=3,\n    eval_metric='RMSE',\n    random_seed=42,\n    verbose=100\n)\n\nmodel.fit(\n    X_train,\n    y_train,\n    eval_set=(X_val, y_val),\n    early_stopping_rounds=50,\n    cat_features=cat_indices\n)\n\n# Best model prediction\nval_preds = model.predict(X_val)\nrmse = np.sqrt(mean_squared_error(y_val, val_preds))\nprint(f'VALIDATION_SCORE={rmse}')\nmodel.save_model('best_model.cbegin')\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
