Sending keys: ["cat << 'EOF' > solution.py\nimport pandas as pd\nimport numpy as np\nimport torch\nimport torch.nn as nn\nimport torch.optim as optim\nfrom torch.utils.data import DataLoader, TensorDataset\nfrom sklearn.preprocessing import StandardScaler, LabelEncoder\nfrom sklearn.metrics import mean_squared_error\n\n# Hardware resolution\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\n# Budget allocation\nprint('BUDGET: Training 2h, Finalization 30m')\n\n# Load data\nprint('Loading data...')\ntrain_df = pd.read_csv('/app/data/train.csv')\nval_df = pd.read_csv('/app/data/val.csv')\ntest_df = pd.read_csv('/app/data/test.csv')\n\ntarget_col = 'target'\nnum_cols = [c for c in train_df.columns if c.startswith('num_')]\ncat_cols = [c for c in train_df.columns if c.startswith('cat_')]\n\n# Trivial baseline\ntrain_mean = train_df[target_col].mean()\nval_baseline_rmse = np.sqrt(mean_squared_error(val_df[target_col], np.full(len(val_df), train_mean)))\nprint(f'TRIVIAL_BASELINE_RMSE={val_baseline_rmse}')\n\n# Preprocessing\nscaler = StandardScaler()\nfill_values = train_df[num_cols].mean()\ntrain_num = scaler.fit_transform(train_df[num_cols].fillna(fill_values))\nval_num = scaler.transform(val_df[num_cols].fillna(fill_values))\ntest_num = scaler.transform(test_df[num_cols].fillna(fill_values))\n\ncat_encoders = {}\ntrain_cat = np.zeros((len(train_df), len(cat_cols)))\nval_cat = np.zeros((len(val_df), len(cat_cols)))\ntest_cat = np.zeros((len(test_df), len(cat_cols)))\n\nfor i, col in enumerate(cat_cols):\n    le = LabelEncoder()\n    all_cats = pd.concat([train_df[col], val_df[col], test_df[col]]).astype(str)\n    le.fit(all_cats)\n    cat_encoders[col] = le\n    train_cat[:, i] = le.transform(train_df[col].astype(str))\n    val_cat[:, i] = le.transform(val_df[col].astype(str))\n    test_cat[:, i] = le.transform(test_df[col].astype(str))\n\nX_train = np.hstack([train_num, train_cat])\ny_train = train_df[target_col].values\nX_val = np.hstack([val_num, val_cat])\ny_val = val_df[target_col].values\nX_test = np.hstack([test_num, test_cat])\n\nX_train = torch.tensor(X_train, dtype=torch.float32).to(DEVICE)\ny_train = torch.tensor(y_train, dtype=torch.float32).unsqueeze(1).to(DEVICE)\nX_val = torch.tensor(X_val, dtype=torch.float32).to(DEVICE)\ny_val = torch.tensor(y_val, dtype=torch.float32).unsqueeze(1).to(DEVICE)\nX_test = torch.tensor(X_test, dtype=torch.float32).to(DEVICE)\n\ntrain_ds = TensorDataset(X_train, y_train)\ntrain_loader = DataLoader(train_ds, batch_size=4096, shuffle=True)\n\nclass TabularModel(nn.Module):\n    def __init__(self, input_dim):\n        super().__init__()\n        self.net = nn.Sequential(\n            nn.Linear(input_dim, 128),\n            nn.ReLU(),\n            nn.Linear(128, 64),\n            nn.ReLU(),\n            nn.Linear(64, 1)\n        )\n    def forward(self, x):\n        return self.net(x)\n\nmodel = TabularModel(X_train.shape[1]).to(DEVICE)\noptimizer = optim.Adam(model.parameters(), lr=0.001)\ncriterion = nn.MSELoss()\n\nbest_val_rmse = float('inf')\nbest_model_state = None\npatience = 10\ncounter = 0\nepochs = 100\n\nprint('Starting training...')\nfor epoch in range(epochs):\n    model.train()\n    for xb, yb in train_loader:\n        optimizer.zero_grad()\n        pred = model(xb)\n        loss = criterion(pred, yb)\n        loss.backward()\n        optimizer.step()\n    \n    model.eval()\n    with torch.no_grad():\n        val_pred = model(X_val)\n        val_rmse = torch.sqrt(criterion(val_pred, y_val)).item()\n    \n    if val_rmse < best_val_rmse:\n        best_val_rmse = val_rmse\n        best_model_state = model.state_dict()\n        counter = 0\n    else:\n        counter += 1\n    \n    if epoch % 5 == 0:\n        print(f'Epoch {epoch}: Val RMSE = {val_rmse:.4f}')\n    \n    if counter >= patience:\n        print(f'Early stopping at epoch {epoch}')\n        break\n\nprint(f'VALIDATION_SCORE={best_val_rmse}')\n\nmodel.load_state_dict(best_model_state)\nmodel.eval()\nwith torch.no_grad():\n    test_preds = model(X_test).cpu().numpy().flatten()\n\npd.DataFrame({'target': test_preds}).to_csv('/app/predictions.csv', index=False)\nprint('Predictions saved to /app/predictions.csv')\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
