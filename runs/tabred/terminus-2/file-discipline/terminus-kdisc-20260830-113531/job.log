l)[:, 1]\nval_score = roc_auc_score(y_val, val_preds)\nprint(f'VALIDATION_SCORE={val_score}')\n\n# Sanity check vs baseline\nif val_score <= trivial_score:\n    print('Model failed to beat baseline. Using baseline predictions.')\n    test_preds = np.full(len(X_test), mean_train)\nelse:\n    print('Model beat baseline!')\n    test_preds = model.predict_proba(X_test)[:, 1]\n\n# Final check for degenerate predictions\nif np.all(test_preds == test_preds[0]):\n    print('WARNING: Degenerate predictions detected!')\n\n# Save predictions\nsubmission = pd.DataFrame({'target': test_preds})\nsubmission.to_csv('/app/predictions.csv', index=False)\nprint('Predictions saved to /app/predictions.csv')\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
