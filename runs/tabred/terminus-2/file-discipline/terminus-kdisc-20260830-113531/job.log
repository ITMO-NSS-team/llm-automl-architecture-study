Sending keys: ["cat << 'EOF' > train_model.py\nimport pandas as pd\nimport numpy as np\nimport json\nimport torch\nfrom catboost import CatBoostClassifier, Pool\nfrom sklearn.metrics import roc_auc_score\n\n# HARDWARE RESOLUTION\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\n# Load schema\nwith open('/app/data/schema.json', 'r') as f:\n    schema = json.load(f)\n\nfeature_cols = schema['feature_columns']\ncat_cols = [c for c in feature_cols if c.startswith('cat_')]\nnum_cols = [c for c in feature_cols if c.startswith('num_') or c.startswith('bin_')]\n\n# Load data\nprint('Loading data...')\ntrain_df = pd.read_csv('/app/data/train.csv')\nval_df = pd.read_csv('/app/data/val.csv')\ntest_df = pd.read_csv('/app/data/test.csv')\n\nX_train = train_df[feature_cols]\ny_train = train_df['target']\nX_val = val_df[feature_cols]\ny_val = val_df['target']\n\n# Fill NaNs for categorical columns to avoid issues (CatBoost can handle them but consistency helps)\nfor col in cat_cols:\n    X_train[col] = X_train[col].fillna('nan').astype(str)\n    X_val[col] = X_val[col].fillna('nan').astype(str)\n\n# Since we have a strong imbalance (3%), we can try scale_pos_weight\npos_weight = (len(y_train) - sum(y_train)) / sum(y_train)\n\nmodel = CatBoostClassifier(\n    iterations=2000,\n    learning_rate=0.05,\n    depth=6,\n    eval_metric='AUC',\n    task_type='GPU' if DEVICE == 'cuda' else 'CPU',\n    scale_pos_weight=pos_weight,\n    random_seed=42,\n    verbose=100\n)\n\nmodel.fit(\n    X_train, y_train,\n    eval_set=(X_val, y_val),\n    early_stopping_rounds=100,\n    cat_features=cat_cols\n)\n\npreds = model.predict_proba(X_val)[:, 1]\nscore = roc_auc_score(y_val, preds)\nprint(f'VALIDATION_SCORE={score}')\n\n# Save the best model\nmodel.save_model('best_model.bin')\n\n# Predict on test\ntest_preds = model.predict_proba(test_df[feature_cols])[:, 1]\npreds_df = pd.DataFrame({'target': test_preds})\npreds_df.to_csv('/app/predictions.csv', index=False)\nprint('Predictions saved to /app/predictions.csv')\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
