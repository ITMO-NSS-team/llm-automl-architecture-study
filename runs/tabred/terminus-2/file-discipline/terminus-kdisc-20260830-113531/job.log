Sending keys: ["cat << 'EOF' > solution.py\nimport pandas as pd\nimport numpy as np\nimport torch\nimport torch.nn as nn\nimport torch.optim as optim\nfrom torch.utils.data import DataLoader, TensorDataset\nfrom sklearn.metrics import mean_squared_error\nfrom sklearn.preprocessing import StandardScaler, LabelEncoder\nimport time\n\n# 1. Device Resolution\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\n# Budget Allocation\nprint('BUDGET: Exploration: 30m, Training: 2h, Finalization: 30m')\n\ndef rmse(y_true, y_pred):\n    return np.sqrt(mean_squared_error(y_true, y_pred))\n\n# Load data\nprint('Loading data...')\ntrain_df = pd.read_csv('/app/data/train.csv')\nval_df = pd.read_csv('/app/data/val.csv')\ntest_df = pd.read_csv('/app/data/test.csv')\n\n# Separate target\ntrain_x = train_df.drop(columns=['target'])\ntrain_y = train_df['target'].values\nval_x = val_df.drop(columns=['target'])\nval_y = val_df['target'].values\n\n# Trivial Baseline\ntrain_mean = np.mean(train_y)\ntrivial_score = rmse(val_y, np.full_like(val_y, train_mean))\nprint(f'TRIVIAL_SCORE={trivial_score}')\n\n# Preprocessing\nprint('Preprocessing...')\n# Identify features\nnum_cols = [c for c in train_x.columns if c.startswith('num_')]\ncat_cols = [c for c in train_x.columns if c.startswith('cat_')]\n\n# Numerical: Fill NaNs with median and scale\nfor col in num_cols:\n    median_val = train_x[col].median()\n    train_x[col] = train_x[col].fillna(median_val)\n    val_x[col] = val_x[col].fillna(median_val)\n    test_df[col] = test_df[col].fillna(median_val)\n\nscaler = StandardScaler()\ntrain_x[num_cols] = scaler.fit_transform(train_x[num_cols])\nval_x[num_cols] = scaler.transform(val_x[num_cols])\ntest_df[num_cols] = scaler.transform(test_df[num_cols])\n\n# Categorical: Label Encoding\nfor col in cat_cols:\n    le = LabelEncoder()\n    train_x[col] = le.fit_transform(train_x[col].astype(str))\n    val_x[col] = le.transform(val_x[col].astype(str))\n    test_df[col] = le.transform(test_df[col].astype(str))\n\n# Convert to Tensors\nX_train = torch.tensor(train_x.values, dtype=torch.float32).to(DEVICE)\nY_train = torch.tensor(train_y, dtype=torch.float32).unsqueeze(1).to(DEVICE)\nX_val = torch.tensor(val_x.values, dtype=torch.float32).to(DEVICE)\nY_val = torch.tensor(val_y, dtype=torch.float32).unsqueeze(1).to(DEVICE)\n\n# Model\nclass TabularModel(nn.Module):\n    def __init__(self, input_dim):\n        super().__init__()\n        self.net = nn.Sequential(\n            nn.Linear(input_dim, 256),\n            nn.ReLU(),\n            nn.Dropout(0.1),\n            nn.Linear(256, 128),\n            nn.ReLU(),\n            nn.Dropout(0.1),\n            nn.Linear(128, 64),\n            nn.ReLU(),\n            nn.Linear(64, 1)\n        )\n    def forward(self, x):\n        return self.net(x)\n\nmodel = TabularModel(X_train.shape[1]).to(DEVICE)\ncriterion = nn.MSELoss()\noptimizer = optim.Adam(model.parameters(), lr=0.001)\n\n# Training\ntrain_loader = DataLoader(TensorDataset(X_train, Y_train), batch_size=1024, shuffle=True)\n\nbest_val_rmse = float('inf')\npatience = 15\ncounter = 0\n\nprint('Starting training...')\nfor epoch in range(200):\n    model.train()\n    for batch_x, batch_y in train_loader:\n        optimizer.zero_grad()\n        pred = model(batch_x)\n        loss = criterion(pred, batch_y)\n        loss.backward()\n        optimizer.step()\n    \n    model.eval()\n    with torch.no_grad():\n        val_pred = model(X_val)\n        val_rmse_val = np.sqrt(criterion(val_pred, Y_val).item())\n    \n    if val_rmse_val < best_val_rmse:\n        best_val_rmse = val_rmse_val\n        torch.save(model.state_dict(), 'best_model.pth')\n        counter = 0\n    else:\n        counter += 1\n    \n    if epoch % 10 == 0:\n        print(f'Epoch {epoch}: Val RMSE = {val_rmse_val:.4f}')\n    \n    if counter >= patience:\n        print(f'Early stopping at epoch {epoch}')\n        break\n\nprint(f'VALIDATION_SCORE={best_val_rmse}')\n\n# Final Predictions\nmodel.load_state_dict(torch.load('best_model.pth'))\nmodel.eval()\nwith torch.no_grad():\n    X_test = torch.tensor(test_df.values, dtype=torch.float32).to(DEVICE)\n    test_preds = model(X_test).cpu().numpy().flatten()\n\npd.DataFrame({'target': test_preds}).to_csv('/app/predictions.csv', index=False)\nprint('Predictions saved to /app/predictions.csv')\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
