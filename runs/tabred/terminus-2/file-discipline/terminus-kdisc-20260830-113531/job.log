Sending keys: ["cat <<EOF > train_model.py\nimport pandas as pd\nimport numpy as np\nimport torch\nimport torch.nn as nn\nimport torch.optim as optim\nfrom torch.utils.data import DataLoader, TensorDataset\nfrom sklearn.metrics import roc_auc_score\nfrom sklearn.preprocessing import StandardScaler\nimport json\nimport os\n\n# Hardware - REQUIRED snippet\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\n# Load data\ntrain_df = pd.read_csv('/app/data/train.csv')\nval_df = pd.read_csv('/app/data/val.csv')\ntest_df = pd.read_csv('/app/data/test.csv')\n\nnum_cols = [c for c in train_df.columns if c.startswith('num_')]\nbin_cols = [c for c in train_df.columns if c.startswith('bin_')]\ncat_cols = [c for c in train_df.columns if c.startswith('cat_')]\n\n# Preprocessing\nnum_medians = train_df[num_cols].median().fillna(0)\n\ndef preprocess(df, scaler=None, medians=None):\n    num_data = df[num_cols].fillna(medians)\n    if scaler is None:\n        scaler = StandardScaler()\n        num_scaled = scaler.fit_transform(num_data)\n    else:\n        num_scaled = scaler.transform(num_data)\n    bin_data = df[bin_cols].fillna(0).astype(float).values\n    cat_data = df[cat_cols].fillna(-1).astype(int).values\n    return num_scaled, bin_data, cat_data, scaler\n\nx_train_num, x_train_bin, x_train_cat_raw, scaler = preprocess(train_df, medians=num_medians)\nx_val_num, x_val_bin, x_val_cat_raw, _ = preprocess(val_df, scaler=scaler, medians=num_medians)\nx_test_num, x_test_bin, x_test_cat_raw, _ = preprocess(test_df, scaler=scaler, medians=num_medians)\n\ny_train_np = train_df['target'].values.astype(np.float32)\ny_val_np = val_df['target'].values.astype(np.float32)\n\n# Calculate pos_weight using numpy array\npos_sum = np.sum(y_train_np)\npos_weight = torch.tensor([(len(y_train_np) - pos_sum) / pos_sum], dtype=torch.float32).to(DEVICE)\n\n# Tensors\nx_train_num = torch.tensor(x_train_num, dtype=torch.float32)\nx_train_bin = torch.tensor(x_train_bin, dtype=torch.float32)\ny_train = torch.tensor(y_train_np, dtype=torch.float32)\n\nx_val_num = torch.tensor(x_val_num, dtype=torch.float32)\nx_val_bin = torch.tensor(x_val_bin, dtype=torch.float32)\ny_val = torch.tensor(y_val_np, dtype=torch.float32)\n\nx_test_num = torch.tensor(x_test_num, dtype=torch.float32)\nx_test_bin = torch.tensor(x_test_bin, dtype=torch.float32)\n\n# Determine category dimensions and handle OOV\ncat_dims = []\nfor col in cat_cols:\n    max_val = int(train_df[col].max())\n    cat_dims.append(max_val + 1 if max_val >= 0 else 1)\n\ndef fix_cat(df):\n    for col in cat_cols:\n        mv = int(train_df[col].max())\n        df[col] = df[col].clip(upper=mv).fillna(-1).astype(int)\n    return torch.tensor(df[cat_cols].values, dtype=torch.long)\n\nx_train_cat = fix_cat(train_df.copy())\nx_val_cat = fix_cat(val_df.copy())\nx_test_cat = fix_cat(test_df.copy())\n\n# Model\nclass TabNet(nn.Module):\n    def __init__(self, cat_dims):\n        super().__init__()\n        self.embeddings = nn.ModuleList([nn.Embedding(dim, 8) for dim in cat_dims])\n        num_feat_dim = len(num_cols) + len(bin_cols) + len(cat_dims) * 8\n        self.mlp = nn.Sequential(\n            nn.Linear(num_feat_dim, 256),\n            nn.ReLU(),\n            nn.Dropout(0.1),\n            nn.Linear(256, 128),\n            nn.ReLU(),\n            nn.Dropout(0.1),\n            nn.Linear(128, 1)\n        )\n    def forward(self, x_num, x_bin, x_cat):\n        cat_emb = [emb(x_cat[:, i]) for i, emb in enumerate(self.embeddings)]\n        x = torch.cat([x_num, x_bin, *cat_emb], dim=1)\n        return self.mlp(x)\n\nmodel = TabNet(cat_dims).to(DEVICE)\noptimizer = optim.Adam(model.parameters(), lr=1e-3)\ncriterion = nn.BCEWithLogitsLoss(pos_weight=pos_weight)\n\n# DataLoaders\ntrain_ds = TensorDataset(x_train_num, x_train_bin, x_train_cat, y_train)\ntrain_loader = DataLoader(train_ds, batch_size=1024, shuffle=True)\n\n# Training\nbest_val_score = -1\nbest_model_path = 'best_model.pt'\npatience = 15\nepochs = 200\nno_improve = 0\n\nfor epoch in range(epochs):\n    model.train()\n    train_loss = 0\n    for bn, bb, bc, bt in train_loader:\n        bn, bb, bc, bt = bn.to(DEVICE), bb.to(DEVICE), bc.to(DEVICE), bt.to(DEVICE).unsqueeze(1)\n        optimizer.zero_grad()\n        out = model(bn, bb, bc)\n        loss = criterion(out, bt)\n        loss.backward()\n        optimizer.step()\n        train_loss += loss.item()\n    \n    model.eval()\n    with torch.no_grad():\n        v_num, v_bin, v_cat = x_val_num.to(DEVICE), x_val_bin.to(DEVICE), x_val_cat.to(DEVICE)\n        v_out = torch.sigmoid(model(v_num, v_bin, v_cat)).cpu().numpy()\n        val_score = roc_auc_score(y_val_np, v_out)\n    \n    print(f'Epoch {epoch+1}/{epochs} | Loss: {train_loss/len(train_loader):.4f} | VAL_SCORE={val_score:.4f}')\n    \n    if val_score > best_val_score:\n        best_val_score = val_score\n        torch.save(model.state_dict(), best_model_path)\n        no_improve = 0\n    else:\n        no_improve += 1\n    if no_improve >= patience:\n        print('Early stopping')\n        break\n\nprint(f'VALIDATION_SCORE={best_val_score}')\n\nmodel.load_state_dict(torch.load(best_model_path))\nmodel.eval()\nwith torch.no_grad():\n    t_num, t_bin, t_cat = x_test_num.to(DEVICE), x_test_bin.to(DEVICE), x_test_cat.to(DEVICE)\n    t_out = torch.sigmoid(model(t_num, t_bin, t_cat)).cpu().numpy()\n\npreds_df = pd.DataFrame({'target': t_out})\npreds_df.to_csv('/app/predictions.csv', index=False)\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
