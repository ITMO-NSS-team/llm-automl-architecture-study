Sending keys: ["cat << 'EOF' > train_model.py\nimport pandas as pd\nimport numpy as np\nimport lightgbm as lgb\nfrom sklearn.metrics import roc_auc_score\nimport torch\n\n# REQUIRED DEVICE RESOLUTION\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\n# Load data\ntrain = pd.read_csv('/app/data/train.csv')\nval = pd.read_csv('/app/data/val.csv')\ntest = pd.read_csv('/app/data/test.csv')\n\nX_train = train.drop('target', axis=1)\ny_train = train['target']\nX_val = val.drop('target', axis=1)\ny_val = val['target']\nX_test = test\n\n# Use LightGBM\n# LightGBM handles NaNs automatically\ndtrain = lgb.Dataset(X_train, label=y_train)\nval_set = lgb.Dataset(X_val, label=y_val, reference=dtrain)\n\nparams = {\n    'objective': 'binary',\n    'metric': 'auc',\n    'boosting_type': 'gbdt',\n    'learning_rate': 0.05,\n    'num_leaves': 31,\n    'feature_fraction': 0.8,\n    'bagging_fraction': 0.8,\n    'bagging_freq': 5,\n    'verbose': -1,\n    'seed': 42\n}\n\n# Training with early stopping\nmodel = lgb.train(\n    params,\n    dtrain,\n    num_boost_round=5000,\n    valid_sets=[dtrain, val_set],\n    valid_names=['train', 'val'],\n    callbacks=[lgb.early_stopping(stopping_rounds=100), lgb.log_evaluation(period=100)]\n)\n\n# Validation score\nval_preds = model.predict(X_val)\nval_score = roc_auc_score(y_val, val_preds)\nprint(f'VALIDATION_SCORE={val_score}')\n\n# Trivial baseline comparison\ntrain_mean = y_train.mean()\ntrivial_preds = np.full(len(y_val), train_mean)\ntrivial_score = roc_auc_score(y_val, trivial_preds)\nprint(f'TRIVIAL_BASELINE_SCORE={trivial_score}')\n\n# Predictions for test set\ntest_preds = model.predict(X_test)\nsubmission = pd.DataFrame({'target': test_preds})\nsubmission.to_csv('/app/predictions.csv', index=False)\nprint('Predictions saved to /app/predictions.csv')\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
