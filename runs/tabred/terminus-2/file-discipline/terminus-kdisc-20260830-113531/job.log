Sending keys: ["cat << 'EOF' > train_model.py\nimport pandas as pd\nimport numpy as np\nimport lightgbm as lgb\nfrom sklearn.metrics import mean_squared_error\nimport json\n\ndef main():\n    # Load schema to get feature names\n    with open('/app/data/schema.json', 'r') as f:\n        schema = json.load(f)\n    features = schema['feature_columns']\n\n    # Load data\n    train = pd.read_csv('/app/data/train.csv')\n    val = pd.read_csv('/app/data/val.csv')\n    test = pd.read_csv('/app/data/test.csv')\n\n    X_train = train[features]\n    y_train = train['target']\n    X_val = val[features]\n    y_val = val['target']\n    X_test = test[features]\n\n    # LightGBM dataset\n    train_data = lgb.Dataset(X_train, label=y_train)\n    val_data = lgb.Dataset(X_val, label=y_val, reference=train_data)\n\n    params = {\n        'objective': 'regression',\n        'metric': 'rmse',\n        'verbosity': -1,\n        'boosting_type': 'gbdt',\n        'random_state': 42,\n        'learning_rate': 0.05,\n        'num_leaves': 31,\n        'feature_fraction': 0.8,\n        'bagging_fraction': 0.8,\n        'bagging_freq': 5\n    }\n\n    # Train with early stopping\n    model = lgb.train(\n        params,\n        train_data,\n        num_boost_round=10000,\n        valid_sets=[val_data],\n        callbacks=[lgb.early_stopping(stopping_rounds=100), lgb.log_evaluation(period=100)]\n    )\n\n    # Predict on validation set\n    val_preds = model.predict(X_val)\n    rmse = np.sqrt(mean_squared_error(y_val, val_preds))\n    print(f'VALIDATION_SCORE={rmse}')\n\n    # Save best model\n    model.save_model('lgb_model.txt')\n\n    # Predict on test set\n    test_preds = model.predict(X_test)\n    submission = pd.DataFrame({'target': test_preds})\n    submission.to_csv('/app/predictions.csv', index=False)\n    print('Predictions saved to /app/predictions.csv')\n\nif __name__ == '__main__':\n    main()\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
