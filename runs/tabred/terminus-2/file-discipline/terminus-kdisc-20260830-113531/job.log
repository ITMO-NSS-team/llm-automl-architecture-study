l)\n    val_rmse = np.sqrt(mean_squared_error(y_val, preds_val))\n    print(f\'VALIDATION_SCORE={val_rmse:.4f}\')\n\n    if val_rmse < baseline_rmse:\n        print("Model beat baseline. Generating predictions...")\n        preds_test = model.predict(X_test)\n        submission = pd.DataFrame({\'target\': preds_test})\n        submission.to_csv(\'/app/predictions.csv\', index=False)\n        print("Predictions saved to /app/predictions.csv")\n    else:\n        print("Model did not beat baseline. Using baseline for submission.")\n        baseline_test = np.full(len(X_test), y_train.median())\n        submission = pd.DataFrame({\'target\': baseline_test})\n        submission.to_csv(\'/app/predictions.csv\', index=False)\n        print("Baseline predictions saved to /app/predictions.csv")\n\nif __name__ == \'__main__\':\n    main()\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
