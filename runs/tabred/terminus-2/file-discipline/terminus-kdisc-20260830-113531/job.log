Sending keys: ["cat << 'EOF' > solution.py\nimport pandas as pd\nimport numpy as np\nimport torch\nimport torch.nn as nn\nimport torch.optim as optim\nfrom torch.utils.data import DataLoader, TensorDataset\nfrom sklearn.metrics import roc_auc_score\nfrom sklearn.preprocessing import StandardScaler, LabelEncoder\nimport json\nimport os\n\n# Resolve compute device - REQUIRED SNIPPET\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\n# Time Budget Allocation\nprint('Budget: Exploration 30m, Training 2h, Finalization 30m')\n\ndef load_data():\n    with open('/app/data/schema.json', 'r') as f:\n        schema = json.load(f)\n    \n    train = pd.read_csv('/app/data/train.csv')\n    val = pd.read_csv('/app/data/val.csv')\n    test = pd.read_csv('/app/data/test.csv')\n    \n    return train, val, test, schema\n\ndef preprocess(df, schema, encoders=None, scaler=None, is_train=True):\n    num_cols = [c for c in schema['feature_columns'] if c.startswith('num_')]\n    bin_cols = [c for c in schema['feature_columns'] if c.startswith('bin_')]\n    cat_cols = [c for c in schema['feature_columns'] if c.startswith('cat_')]\n    \n    # Numerical\n    df_num = df[num_cols].fillna(df[num_cols].median() if is_train else 0)\n    if is_train:\n        scaler = StandardScaler()\n        df_num_scaled = scaler.fit_transform(df_num)\n    else:\n        df_num_scaled = scaler.transform(df_num)\n    \n    # Binary\n    df_bin = df[bin_cols].fillna(0).values\n    \n    # Categorical\n    df_cat = df[cat_cols].fillna(-1).astype(int)\n    if is_train and encoders is None:\n        encoders = {}\n        for col in cat_cols:\n            le = LabelEncoder()\n            df_cat[col] = le.fit_transform(df_cat[col].astype(str))\n            encoders[col] = le\n    elif encoders is not None:\n        for col in cat_cols:\n            le = encoders[col]\n            mapping = {val: i for i, val in enumerate(le.classes_)}\n            df_cat[col] = df_cat[col].astype(str).map(mapping).fillna(-1).astype(int)\n    \n    X = np.hstack([df_num_scaled, df_bin, df_cat.values]).astype('float32')\n    y = df['target'].values.astype('float32') if 'target' in df.columns else None\n    \n    return torch.tensor(X), torch.tensor(y) if y is not None else None, encoders, scaler, cat_cols\n\nclass TabularModel(nn.Module):\n    def __init__(self, input_dim):\n        super().__init__()\n        self.net = nn.Sequential(\n            nn.Linear(input_dim, 128),\n            nn.ReLU(),\n            nn.Dropout(0.1),\n            nn.Linear(128, 64),\n            nn.ReLU(),\n            nn.Dropout(0.1),\n            nn.Linear(64, 1),\n            nn.Sigmoid()\n        )\n    \n    def forward(self, x):\n        return self.net(x)\n\ndef main():\n    train_df, val_df, test_df, schema = load_data()\n    \n    # Trivial Baseline\n    train_mean = train_df['target'].mean()\n    val_baseline_preds = np.full(len(val_df), train_mean)\n    baseline_score = roc_auc_score(val_df['target'], val_baseline_preds)\n    print(f'TRIVIAL_BASELINE_MEAN={train_mean:.4f}')\n    print(f'TRIVIAL_BASELINE_SCORE={baseline_score:.4f}')\n\n    X_train_raw, y_train_raw, encoders, scaler, cat_cols = preprocess(train_df, schema)\n    X_val_raw, y_val_raw, _, _, _ = preprocess(val_df, schema, encoders, scaler, is_train=False)\n    \n    X_train = X_train_raw.to(DEVICE)\n    y_train = y_train_raw.to(DEVICE).unsqueeze(1)\n    X_val = X_val_raw.to(DEVICE)\n    y_val = y_val_raw.to(DEVICE).unsqueeze(1)\n    \n    dataset = TensorDataset(X_train, y_train)\n    loader = DataLoader(dataset, batch_size=1024, shuffle=True)\n    \n    model = TabularModel(X_train.shape[1]).to(DEVICE)\n    criterion = nn.BCELoss()\n    optimizer = optim.Adam(model.parameters(), lr=0.001)\n    \n    best_val_score = 0\n    patience = 15\n    counter = 0\n    \n    for epoch in range(200):\n        model.train()\n        for batch_x, batch_y in loader:\n            optimizer.zero_grad()\n            out = model(batch_x)\n            loss = criterion(out, batch_y)\n            loss.backward()\n            optimizer.step()\n        \n        model.eval()\n        with torch.no_grad():\n            val_preds = model(X_val).cpu().numpy()\n            score = roc_auc_score(y_val.cpu().numpy(), val_preds)\n            \n        if score > best_val_score:\n            best_val_score = score\n            torch.save(model.state_dict(), 'best_model.pt')\n            counter = 0\n        else:\n            counter += 1\n            \n        if epoch % 10 == 0:\n            print(f'Epoch {epoch} VALIDATION_SCORE={score:.4f}')\n            \n        if counter >= patience:\n            print(f'Early stopping at epoch {epoch}')\n            break\n            \n    print(f'FINAL_VALIDATION_SCORE={best_val_score:.4f}')\n    \n    # Predictions\n    model.load_state_dict(torch.load('best_model.pt'))\n    model.eval()\n    X_test_raw, _, _, _, _ = preprocess(test_df, schema, encoders, scaler, is_train=False)\n    X_test = X_test_raw.to(DEVICE)\n    \n    with torch.no_grad():\n        test_preds = model(X_test).cpu().numpy()\n    \n    pd.DataFrame({'target': test_preds}).to_csv('/app/predictions.csv', index=False)\n    print('Predictions saved to /app/predictions.csv')\n\nif __name__ == '__main__':\n    main()\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
