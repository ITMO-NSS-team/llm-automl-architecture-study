Sending keys: ["cat << 'EOF' > solution.py\nimport pandas as pd\nimport numpy as np\nimport torch\nimport torch.nn as nn\nimport torch.optim as optim\nfrom torch.utils.data import DataLoader, TensorDataset\nfrom sklearn.metrics import mean_squared_error\nimport os\n\n# REQUIRED DEVICE RESOLUTION\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\n# Load data\ntrain_df = pd.read_csv('/app/data/train.csv')\nval_df = pd.read_csv('/app/data/val.csv')\ntest_df = pd.read_csv('/app/data/test.csv')\n\ntarget_col = 'target'\nfeatures = [c for c in train_df.columns if c != target_col]\n\n# Trivial Baseline\ntrain_mean = train_df[target_col].mean()\nval_targets = val_df[target_col].values\nbaseline_preds = np.full(len(val_targets), train_mean)\nbaseline_rmse = np.sqrt(mean_squared_error(val_targets, baseline_preds))\nprint(f'TRIVIAL_BASELINE_MEAN={train_mean}')\nprint(f'TRIVIAL_BASELINE_SCORE={baseline_rmse}')\n\n# Preprocessing\n# Fill NaNs with median\nmedians = train_df[features].median()\ntrain_df[features] = train_df[features].fillna(medians)\nval_df[features] = val_df[features].fillna(medians)\ntest_df[features] = test_df[features].fillna(medians)\n\n# Normalize numerical features\nnum_features = [f for f in features if f.startswith('num_')]\nnum_means = train_df[num_features].mean()\nnum_stds = train_df[num_features].std().replace(0, 1)\n\ntrain_df[num_features] = (train_df[num_features] - num_means) / num_stds\nval_df[num_features] = (val_df[num_features] - num_means) / num_stds\ntest_df[num_features] = (test_df[num_features] - num_means) / num_stds\n\n# Convert to tensors\nX_train = torch.tensor(train_df[features].values, dtype=torch.float32).to(DEVICE)\ny_train = torch.tensor(train_df[target_col].values, dtype=torch.float32).unsqueeze(1).to(DEVICE)\n\nX_val = torch.tensor(val_df[features].values, dtype=torch.float32).to(DEVICE)\ny_val = torch.tensor(val_df[target_col].values, dtype=torch.float32).unsqueeze(1).to(DEVICE)\n\nX_test = torch.tensor(test_df[features].values, dtype=torch.float32).to(DEVICE)\n\n# Model\nclass WeatherNet(nn.Module):\n    def __init__(self, input_dim):\n        super(WeatherNet, self).__init__()\n        self.net = nn.Sequential(\n            nn.Linear(input_dim, 128),\n            nn.ReLU(),\n            nn.Linear(128, 64),\n            nn.ReLU(),\n            nn.Linear(64, 32),\n            nn.ReLU(),\n            nn.Linear(32, 1)\n        )\n    def forward(self, x):\n        return self.net(x)\n\nmodel = WeatherNet(len(features)).to(DEVICE)\ncriterion = nn.MSELoss()\noptimizer = optim.Adam(model.parameters(), lr=0.001)\n\n# Training\nC_train = DataLoader(TensorDataset(X_train, y_train), batch_size=1024, shuffle=True)\n\nepochs = 200\npatience = 15\nbest_val_rmse = float('inf')\ncounter = 0\n\nfor epoch in range(epochs):\n    model.train()\n    train_loss = 0\n    for batch_x, batch_y in C_train:\n        optimizer.zero_grad()\n        preds = model(batch_x)\n        loss = criterion(preds, batch_y)\n        loss.backward()\n        optimizer.step()\n        train_loss += loss.item()\n    \n    model.eval()\n    with torch.no_grad():\n        val_preds = model(X_val)\n        val_rmse = torch.sqrt(criterion(val_preds, y_val)).item()\n    \n    if val_rmse < best_val_rmse:\n        best_val_rmse = val_rmse\n        torch.save(model.state_dict(), 'best_model.pth')\n        counter = 0\n    else:\n        counter += 1\n    \n    if (epoch + 1) % 10 == 0:\n        print(f'Epoch {epoch+1}/{epochs}, Val RMSE: {val_rmse:.4f}')\n    \n    if counter >= patience:\n        print(f'Early stopping at epoch {epoch+1}')\n        break\n\nprint(f'VALIDATION_SCORE={best_val_rmse}')\n\n# Final Predictions\nmodel.load_state_dict(torch.load('best_model.pth'))\nmodel.eval()\nwith torch.no_grad():\n    test_preds = model(X_test).cpu().numpy().flatten()\n\nsubmission = pd.DataFrame({'target': test_preds})\nsubmission.to_csv('/app/predictions.csv', index=False)\nprint('Predictions saved to /app/predictions.csv')\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
