Sending keys: ["cat << 'EOF' > solution_bg.py\nimport torch\nimport pandas as pd\nimport numpy as np\nfrom sklearn.metrics import mean_squared_error\nfrom sklearn.preprocessing import StandardScaler\nimport torch.nn as nn\nfrom torch.utils.data import DataLoader, TensorDataset\nimport sys\n\n# Device Resolution\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint(f'DEVICE={DEVICE}', flush=True)\n\ntry:\n    train_df = pd.read_csv('/app/data/train.csv')\n    val_df = pd.read_csv('/app/data/val.csv')\n    test_df = pd.read_csv('/app/data/test.csv')\n\n    X_train = train_df.drop(columns=['target'])\n    y_train = train_df['target']\n    X_val = val_df.drop(columns=['target'])\n    y_val = val_df['target']\n    X_test = test_df.copy()\n\n    train_median = y_train.median()\n    baseline_preds = np.full(len(y_val), train_median)\n    baseline_rmse = np.sqrt(mean_squared_error(y_val, baseline_preds))\n    print(f'TRIVIAL_BASELINE_SCORE={baseline_rmse}', flush=True)\n\n    numeric_cols = [c for c in X_train.columns if c.startswith('num_')]\n    for col in numeric_cols:\n        m = X_train[col].median()\n        X_train[col] = X_train[col].fillna(m)\n        X_val[col] = X_val[col].fillna(m)\n        X_test[col] = X_test[col].fillna(m)\n\n    scaler = StandardScaler()\n    X_train_scaled = scaler.fit_transform(X_train)\n    X_val_scaled = scaler.transform(X_val)\n    X_test_scaled = scaler.transform(X_test)\n\n    X_train_t = torch.tensor(X_train_scaled, dtype=torch.float32).to(DEVICE)\n    y_train_t = torch.tensor(y_train.values, dtype=torch.float32).unsqueeze(1).to(DEVICE)\n    X_val_t = torch.tensor(X_val_scaled, dtype=torch.float32).to(DEVICE)\n    y_val_t = torch.tensor(y_val.values, dtype=torch.float32).unsqueeze(1).to(DEVICE)\n\n    class TabModel(nn.Module):\n        def __init__(self, input_dim):\n            super().__init__()\n            self.net = nn.Sequential(\n                nn.Linear(input_dim, 128), nn.ReLU(),\n                nn.Linear(128, 64), nn.ReLU(),\n                nn.Linear(64, 1)\n            )\n        def forward(self, x): return self.net(x)\n\n    model = TabModel(X_train.shape[1]).to(DEVICE)\n    optimizer = torch.optim.Adam(model.parameters(), lr=0.001)\n    criterion = nn.MSELoss()\n\n    train_loader = DataLoader(TensorDataset(X_train_t, y_train_t), batch_size=1024, shuffle=True)\n\n    best_rmse = float('inf')\n    patience, counter = 10, 0\n\n    for epoch in range(100):\n        model.train()\n        for bx, by in train_loader:\n            optimizer.zero_grad()\n            loss = criterion(model(bx), by)\n            loss.backward()\n            optimizer.step()\n        \n        model.eval()\n        with torch.no_grad():\n            v_pred = model(X_val_t)\n            v_rmse = np.sqrt(mean_squared_error(y_val_t.cpu().numpy(), v_pred.cpu().numpy()))\n        \n        if v_rmse < best_rmse:\n            best_rmse = v_rmse\n            torch.save(model.state_dict(), 'best_model_bg.pt')\n            counter = 0\n        else:\n            counter += 1\n        \n        if epoch % 10 == 0:\n            print(f'Epoch {epoch}: VAL_RMSE={v_rmse:.4f}', flush=True)\n        if counter >= patience: break\n\n    print(f'VALIDATION_SCORE={best_rmse}', flush=True)\n    model.load_state_dict(torch.load('best_model_bg.pt'))\n    model.eval()\n    with torch.no_grad():\n        X_test_t = torch.tensor(X_test_scaled, dtype=torch.float32).to(DEVICE)\n        test_preds = model(X_test_t).cpu().numpy()\n\n    pd.DataFrame({'target': test_preds.flatten()}).to_csv('/app/predictions.csv', index=False)\n    print('DONE', flush=True)\nexcept Exception as e:\n    print(f'ERROR: {e}', flush=True)\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
