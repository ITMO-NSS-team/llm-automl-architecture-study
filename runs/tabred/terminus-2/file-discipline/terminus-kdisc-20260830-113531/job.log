l_score = roc_auc_score(y_val, val_preds)\n    print(f'VALIDATION_SCORE={val_score}')\n\n    if val_score <= baseline_score:\n        print('Model did not beat baseline, using baseline predictions')\n        test_preds = np.full(len(X_test), train_mean)\n    else:\n        print('Model beat baseline!')\n        test_preds = model.predict(X_test)\n\n    pd.DataFrame({'target': test_preds}).to_csv('/app/predictions.csv', index=False)\n    print('Predictions saved to /app/predictions.csv')\n\nif __name__ == '__main__':\n    train()\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
