Sending keys: ["cat << 'EOF' > train_xgb.py\nimport pandas as pd\nimport numpy as np\nimport xgboost as xgb\nfrom sklearn.metrics import mean_squared_error\n\n# Load data\ntrain = pd.read_csv('/app/data/train.csv')\nval = pd.read_csv('/app/data/val.csv')\ntest = pd.read_csv('/app/data/test.csv')\n\nnum_cols = [c for c in train.columns if c.startswith('num_')]\nbin_cols = [c for c in train.columns if c.startswith('bin_')]\ncat_cols = [c for c in train.columns if c.startswith('cat_')]\n\n# Preprocess categorical: simply cast to category for XGBoost\nfor col in cat_cols:\n    train[col] = train[col].astype('category')\n    val[col] = val[col].astype('category')\n    test[col] = test[col].astype('category')\n\n# Split features and target\nX_train = train[num_cols + bin_cols + cat_cols]\ny_train = train['target']\nX_val = val[num_cols + bin_cols + cat_cols]\ny_val = val['target']\nX_test = test[num_cols + bin_cols + cat_cols]\n\n# XGBoost model with categorical support\nmodel = xgb.XGBRegressor(\n    n_estimators=1000,\n    learning_rate=0.05,\n    max_depth=6,\n    tree_method='hist',\n    enable_categorical=True,\n    early_stopping_rounds=50,\n    eval_metric='rmse'\n)\n\nmodel.fit(\n    X_train, y_train,\n    eval_set=[(X_val, y_val)],\n    verbose=100\n)\n\nval_preds = model.predict(X_val)\nrmse = np.sqrt(mean_squared_error(y_val, val_preds))\nprint(f'VALIDATION_SCORE={rmse}')\n\n# Generate predictions\ntest_preds = model.predict(X_test)\npreds_df = pd.DataFrame({'target': test_preds})\npreds_df.to_csv('/app/predictions.csv', index=False)\nprint('Predictions saved to /app/predictions.csv')\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
