Sending keys: ['cat << \'EOF\' > train_lgbm.py\nimport pandas as pd\nimport numpy as np\nimport lightgbm as lgb\nfrom sklearn.metrics import mean_squared_error\n\n# Resolve device (for logging purposes as required)\nimport torch\nDEVICE = (\'cuda\' if torch.cuda.is_available()\n          else \'mps\' if torch.backends.mps.is_available() else \'cpu\')\nprint(\'DEVICE=\', DEVICE)\n\ndef load_and_preprocess():\n    train_df = pd.read_csv(\'/app/data/train.csv\')\n    val_df = pd.read_csv(\'/app/data/val.csv\')\n    test_df = pd.read_csv(\'/app/data/test.csv\')\n\n    target_col = \'target\'\n    features = [c for c in train_df.columns if c != target_col]\n\n    X_train = train_df[features]\n    y_train = train_df[target_col]\n    X_val = val_df[features]\n    y_val = val_df[target_col]\n    X_test = test_df\n\n    return X_train, y_train, X_val, y_val, X_test\n\ndef train():\n    X_train, y_train, X_val, y_val, X_test = load_and_preprocess()\n\n    model = lgb.LGBMRegressor(\n        n_estimators=1000,\n        learning_rate=0.05,\n        num_leaves=31,\n        max_depth=-1,\n        n_jobs=-1,\n        random_state=42\n    )\n\n    model.fit(\n        X_train, y_train,\n        eval_set=[(X_val, y_val)],\n        eval_metric=\'rmse\',\n        callbacks=[lgb.early_stopping(stopping_rounds=50)]\n    )\n\n    val_preds = model.predict(X_val)\n    rmse = np.sqrt(mean_squared_error(y_val, val_preds))\n    print(f"VALIDATION_SCORE={rmse}")\n\n    # Save model for final prediction\n    model.booster_.save_model(\'best_model.txt\')\n\n    # Generate predictions for test set\n    test_preds = model.predict(X_test)\n    predictions = pd.DataFrame({\'target\': test_preds})\n    predictions.to_csv(\'/app/predictions.csv\', index=False)\n    print("Predictions saved to /app/predictions.csv")\n\nif __name__ == "__main__":\n    train()\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
