Sending keys: ["cat << 'EOF' > solution.py\nimport pandas as pd\nimport numpy as np\nimport torch\nimport lightgbm as lgb\nfrom sklearn.metrics import mean_squared_error\nfrom sklearn.preprocessing import LabelEncoder\n\n# 1. Device Resolution (REQUIRED)\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\nprint('BUDGET: Exploration: 10m, Training: 30m, Finalization: 10m')\n\ndef rmse(y_true, y_pred):\n    return np.sqrt(mean_squared_error(y_true, y_pred))\n\nprint('Loading data...')\n# Use float32 to save memory\ntrain_df = pd.read_csv('/app/data/train.csv', engine='c').astype({col: 'float32' for col in pd.read_csv('/app/data/train.csv', nrows=1).columns if 'num_' in col})\nval_df = pd.read_csv('/app/data/val.csv', engine='c').astype({col: 'float32' for col in pd.read_csv('/app/data/val.csv', nrows=1).columns if 'num_' in col})\ntest_df = pd.read_csv('/app/data/test.csv', engine='c').astype({col: 'float32' for col in pd.read_csv('/app/data/test.csv', nrows=1).columns if 'num_' in col})\n\ntrain_x = train_df.drop(columns=['target'])\ntrain_y = train_df['target'].values\nval_x = val_df.drop(columns=['target'])\nval_y = val_df['target'].values\n\ntrain_mean = np.mean(train_y)\ntrivial_score = rmse(val_y, np.full_like(val_y, train_mean))\nprint(f'TRIVIAL_SCORE={trivial_score}')\n\nprint('Preprocessing...')\nnum_cols = [c for c in train_x.columns if c.startswith('num_')]\ncat_cols = [c for c in train_x.columns if c.startswith('cat_')]\n\nfor col in num_cols:\n    median_val = train_x[col].median()\n    train_x[col] = train_x[col].fillna(median_val)\n    val_x[col] = val_x[col].fillna(median_val)\n    test_df[col] = test_df[col].fillna(median_val)\n\nfor col in cat_cols:\n    le = LabelEncoder()\n    train_x[col] = le.fit_transform(train_x[col].astype(str))\n    val_x[col] = le.transform(val_x[col].astype(str))\n    test_df[col] = le.transform(test_df[col].astype(str))\n\nprint('Training LightGBM model...')\ndtrain = lgb.Dataset(train_x, label=train_y)\nval_data = lgb.Dataset(val_x, label=val_y, reference=dtrain)\n\nparams = {\n    'objective': 'regression',\n    'metric': 'rmse',\n    'verbosity': -1,\n    'boosting_type': 'gbdt',\n    'random_state': 42,\n    'learning_rate': 0.05,\n    'num_leaves': 31,\n    'feature_fraction': 0.8,\n    'bagging_fraction': 0.8,\n    'bagging_freq': 5\n}\n\nmodel = lgb.train(\n    params,\n    dtrain,\n    num_boost_round=2000,\n    valid_sets=[val_data],\n    callbacks=[lgb.early_stopping(stopping_rounds=50)]\n)\n\nval_preds = model.predict(val_x)\nval_score = rmse(val_y, val_preds)\nprint(f'VALIDATION_SCORE={val_score}')\n\nif val_score >= trivial_score:\n    print('Model failed to beat trivial baseline, using mean instead.')\n    test_preds = np.full(len(test_df), train_mean)\nelse:\n    print('Model beat trivial baseline!')\n    test_preds = model.predict(test_df)\n\npd.DataFrame({'target': test_preds}).to_csv('/app/predictions.csv', index=False)\nprint('Predictions saved to /app/predictions.csv')\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
