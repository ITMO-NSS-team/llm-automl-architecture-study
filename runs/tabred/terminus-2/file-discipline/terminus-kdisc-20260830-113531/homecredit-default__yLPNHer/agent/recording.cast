[2490.672378, "i", "cat <<EOF > generate_preds.py\nimport pandas as pd\nimport numpy as np\nimport torch\nimport torch.nn as nn\nfrom sklearn.preprocessing import StandardScaler\n\nDEVICE = ('cuda' if torch.cuda.is_available() else 'mps' if torch.backends.mps.is_available() else 'cpu')\n\ntrain_df = pd.read_csv('/app/data/train.csv')\ntest_df = pd.read_csv('/app/data/test.csv')\n\nnum_cols = [c for c in train_df.columns if c.startswith('num_')]\nbin_cols = [c for c in train_df.columns if c.startswith('bin_')]\ncat_cols = [c for c in train_df.columns if c.startswith('cat_')]\n\nnum_medians = train_df[num_cols].median().fillna(0)\n\n# We need the scaler. Since we didn't save it, we must re-fit on train_df\nnum_train_data = train_df[num_cols].fillna(num_medians)\nscaler = StandardScaler().fit(num_train_data)\n\n# Preprocess test data\nnum_test_data = test_df[num_cols].fillna(num_medians)\nnum_scaled = scaler.transform(num_test_data)\nbin_data = test_df[bin_cols].fillna(0).astype(float).values\n\n# Fix categorical data OOV\nfor col in cat_cols:\n    mv = int(train_df[col].max())\n    test_df[col] = test_df[col].clip(upper=mv).fillna(-1).astype(int)\ncat_data = torch.tensor(test_df[cat_cols].values, dtype=torch.long)\n\nx_num = torch.tensor(num_scaled, dtype=torch.float32).to(DEVICE)\nx_bin = torch.tensor(bin_data, dtype=torch.float32).to(DEVICE)\nx_cat = cat_data.to(DEVICE)\n\n# Re-define Model\nclass TabNet(nn.Module):\n    def __init__(self, cat_dims):\n        super().__init__()\n        self.embeddings = nn.ModuleList([nn.Embedding(dim, 8) for dim in cat_dims])\n        num_feat_dim = len(num_cols) + len(bin_cols) + len(cat_dims) * 8\n        self.mlp = nn.Sequential(\n            nn.Linear(num_feat_dim, 256),\n            nn.ReLU(),\n            nn.Dropout(0.1),\n            nn.Linear(256, 128),\n            nn.ReLU(),\n            nn.Dropout(0.1),\n            nn.Linear(128, 1)\n        )\n    def forward(self, x_num, x_bin, x_cat):\n        cat_emb = [emb(x_cat[:, i]) for i, emb in enumerate(self.embeddings)]\n        x = torch.cat([x_num, x_bin, *cat_emb], dim=1)\n        return self.mlp(x)\n\ncat_dims = []\nfor col in cat_cols:\n    m = int(train_df[col].max())\n    cat_dims.append(m + 1 if m >= 0 else 1)\n\nmodel = TabNet(cat_dims).to(DEVICE)\nmodel.load_state_dict(torch.load('best_model.pt'))\nmodel.eval()\n\nwith torch.no_grad():\n    out = torch.sigmoid(model(x_num, x_bin, x_cat)).cpu().numpy()\n\n# Flatten to avoid the 1D error\npreds_df = pd.DataFrame({'target': out.flatten()})\npreds_df.to_csv('/app/predictions.csv', index=False)\nEOF\n"]
