[448.034872, "o", "        torch.save(model.state_dict(), best_model_path)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[448.034935, "o", "        no_improve = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[448.035016, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h>         no_improve += 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[448.035092, "o", "    if no_improve >= patience:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[448.035156, "o", "        print('Early stopping')\r\n\u001b[?2004l\r\u001b[?2004h>         break\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[448.035234, "o", "print(f'VALIDATION_SCORE={best_val_score}')\r\n\u001b[?2004l\r\u001b[?2004h"]
[448.035318, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> model.load_state_dict(torch.load(best_model_path))\r\n\u001b[?2004l\r"]
[448.035388, "o", "\u001b[?2004h> model.eval()\r\n\u001b[?2004l\r\u001b[?2004h> with torch.no_grad():\r\n\u001b[?2004l\r"]
[448.035465, "o", "\u001b[?2004h> "]
[448.035542, "o", "    t_num, t_bin, t_cat = x_test_num.to(DEVICE), x_test_bin.to(DEVICE), x_test_cat.to(DEVICE)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[448.035607, "o", "    t_out = torch.sigmoid(model(t_num, t_bin, t_cat)).cpu().numpy()\r\n\u001b[?2004l\r\u001b[?2004h"]
[448.035676, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[448.035762, "o", "preds_df = pd.DataFrame({'target': t_out})\r\n\u001b[?2004l\r\u001b[?2004h> "]
[448.035829, "o", "preds_df.to_csv('/app/predictions.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
