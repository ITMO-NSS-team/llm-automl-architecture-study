[318.229208, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[318.229256, "o", "\u001b[?2004h> "]
[318.229288, "o", "# Class Weights\r\n\u001b[?2004l\r\u001b[?2004h> "]
[318.229354, "o", "pos_sum = np.sum(y_train)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[318.229516, "o", "pos_weight = torch.tensor([(len(y_train) - pos_sum) / pos_sum], dtype=torch.float32).to(DEVICE)\r\n\u001b[?2004l\r"]
[318.229559, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[318.229616, "o", "\u001b[?2004h> # Model\r\n\u001b[?2004l\r"]
[318.229672, "o", "\u001b[?2004h> "]
[318.229725, "o", "class TabNet(nn.Module):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[318.229791, "o", "    def __init__(self, cat_dims):\r\n\u001b[?2004l\r\u001b[?2004h"]
[318.229859, "o", ">         super().__init__()\r\n"]
[318.229914, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[318.230009, "o", "        self.embeddings = nn.ModuleList([nn.Embedding(dim, 8) for dim in cat_dims])\r\n\u001b[?2004l\r"]
[318.230053, "o", "\u001b[?2004h> "]
[318.230166, "o", "        num_feat_dim = len(num_cols) + len(bin_cols) + len(cat_dims) * 8\r\n\u001b[?2004l\r"]
[318.230207, "o", "\u001b[?2004h> "]
[318.230259, "o", "        self.mlp = nn.Sequential(\r\n\u001b[?2004l\r"]
[318.230317, "o", "\u001b[?2004h> "]
[318.230365, "o", "            nn.Linear(num_feat_dim, 256),\r\n\u001b[?2004l\r"]
[318.230413, "o", "\u001b[?2004h> "]
[318.230473, "o", "            nn.ReLU(),\r\n\u001b[?2004l\r\u001b[?2004h"]
[318.230521, "o", ">             nn.Dropout(0.1),"]
[318.230575, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[318.230625, "o", "            nn.Linear(256, 128),\r\n\u001b[?2004l\r\u001b[?2004h"]
[318.230676, "o", ">             nn.ReLU(),"]
[318.230723, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[318.230757, "o", "            nn.Dropout(0.1),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[318.230834, "o", "            nn.Linear(128, 1)\r\n\u001b[?2004l\r"]
[318.230882, "o", "\u001b[?2004h> "]
[318.230936, "o", "        )\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[318.23099, "o", "\u001b[?2004h> "]
[318.23104, "o", "    def forward(self, x_num, x_bin, x_cat):\r\n\u001b[?2004l\r"]
[318.231088, "o", "\u001b[?2004h> "]
[318.231181, "o", "        cat_emb = [emb(x_cat[:, i]) for i, emb in enumerate(self.embeddings)]\r\n\u001b[?2004l\r"]
[318.231227, "o", "\u001b[?2004h> "]
[318.231302, "o", "        x = torch.cat([x_num, x_bin, *cat_emb], dim=1)\r\n\u001b[?2004l\r"]
[318.231345, "o", "\u001b[?2004h> "]
[318.23139, "o", "        return self.mlp(x)\r\n\u001b[?2004l\r\u001b[?2004h"]
[318.23144, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[318.231496, "o", "> "]
[318.231545, "o", "# Determine category dimensions\r\n\u001b[?2004l\r\u001b[?2004h> "]
[318.231594, "o", "cat_dims = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[318.231649, "o", "for col in cat_cols:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[318.231728, "o", "    # Use max from train, but ensure it's at least 0\r\n\u001b[?2004l\r"]
[318.231803, "o", "\u001b[?2004h> "]
[318.231871, "o", "    m = int(train_df[col].max())\r\n\u001b[?2004l\r\u001b[?2004h"]
[318.231923, "o", "> "]
[318.23197, "o", "    cat_dims.append(m + 1 if m >= 0 else 1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[318.232022, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[318.232092, "o", "# Adjust embeddings for potential out-of-bounds in val/test\r\n\u001b[?2004l\r"]
[318.232139, "o", "\u001b[?2004h> "]
[318.232251, "o", "# For simplicity, we will clip the categorical values to the training max\r\n\u001b[?2004l\r"]
[318.232293, "o", "\u001b[?2004h> "]
[318.23234, "o", "for col in cat_cols:\r\n\u001b[?2004l\r"]
[318.232398, "o", "\u001b[?2004h> "]
[318.232453, "o", "    max_val = int(train_df[col].max())\r\n\u001b[?2004l\r\u001b[?2004h"]
[318.232503, "o", ">     if max_val >= 0:\r\n\u001b[?2004l\r"]
[318.232557, "o", "\u001b[?2004h> "]
[318.232646, "o", "        val_df[col] = val_df[col].clip(upper=max_val).fillna(-1).astype(int)\r\n\u001b[?2004l\r"]
[318.232689, "o", "\u001b[?2004h> "]
[318.232848, "o", "        test_df[col] = test_df[col].clip(upper=max_val).fillna(-1).astype(int)\r\n\u001b[?2004l\r"]
[318.232897, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[318.232945, "o", "\u001b[?2004h> "]
[318.233007, "o", "# Recalculate processed categorical tensors after clipping\r\n\u001b[?2004l\r"]
[318.23307, "o", "\u001b[?2004h> "]
[318.23315, "o", "# We need to re-run preprocess or just manually fix the tensors\r\n\u001b[?2004l\r"]
[318.233195, "o", "\u001b[?2004h> "]
[318.233248, "o", "def get_cat_tensor(df):\r\n\u001b[?2004l\r"]
[318.233298, "o", "\u001b[?2004h> "]
[318.233398, "o", "    return torch.tensor(df[cat_cols].fillna(-1).astype(int).values, dtype=torch.long)\r\n\u001b[?2004l\r"]
[318.233443, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[318.233496, "o", "\u001b[?2004h> "]
[318.233557, "o", "x_train_cat = get_cat_tensor(train_df)\r\n\u001b[?2004l\r"]
[318.233618, "o", "\u001b[?2004h> "]
[318.233673, "o", "x_val_cat = get_cat_tensor(val_df)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[318.233723, "o", "x_test_cat = get_cat_tensor(test_df)\r\n\u001b[?2004l\r"]
[318.233787, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[318.233838, "o", "model = TabNet(cat_dims).to(DEVICE)\r\n\u001b[?2004l\r\u001b[?2004h"]
[318.233891, "o", "> "]
[318.233949, "o", "optimizer = optim.Adam(model.parameters(), lr=1e-3)\r\n\u001b[?2004l\r"]
[318.233991, "o", "\u001b[?2004h> "]
[318.234075, "o", "criterion = nn.BCEWithLogitsLoss(pos_weight=pos_weight)\r\n\u001b[?2004l\r"]
[318.234131, "o", "\u001b[?2004h> \r\n"]
[318.234181, "o", "\u001b[?2004l\r\u001b[?2004h> # DataLoaders\r\n\u001b[?2004l\r"]
[318.23424, "o", "\u001b[?2004h> "]
[318.234312, "o", "train_ds = TensorDataset(x_train_num, x_train_bin, x_train_cat, y_train)\r\n\u001b[?2004l\r"]
[318.23436, "o", "\u001b[?2004h> "]
[318.234459, "o", "train_loader = DataLoader(train_ds, batch_size=1024, shuffle=True)\r\n\u001b[?2004l\r"]
[318.234512, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[318.234561, "o", "\u001b[?2004h> # Training loop\r\n\u001b[?2004l\r"]
[318.234618, "o", "\u001b[?2004h> "]
[318.234665, "o", "best_val_score = -1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[318.234721, "o", "best_model_path = 'best_model.pt'\r\n\u001b[?2004l\r"]
[318.234787, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[318.234847, "o", "patience = 15\r\n\u001b[?2004l\r\u001b[?2004h> epochs = 200\r\n"]
[318.234899, "o", "\u001b[?2004l\r\u001b[?2004h> no_improve = 0"]
[318.234955, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[318.235, "o", "for epoch in range(epochs):\r\n\u001b[?2004l\r\u001b[?2004h"]
[318.235048, "o", "> "]
[318.235099, "o", "    model.train()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[318.235131, "o", "    train_loss = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[318.235205, "o", "    for bn, bb, bc, bt in train_loader:\r\n\u001b[?2004l\r"]
[318.235253, "o", "\u001b[?2004h> "]
[318.235403, "o", "        bn, bb, bc, bt = bn.to(DEVICE), bb.to(DEVICE), bc.to(DEVICE), bt.to(DEVICE).unsqueeze(1)\r\n\u001b[?2004l\r"]
[318.235464, "o", "\u001b[?2004h> "]
[318.235515, "o", "        optimizer.zero_grad()\r\n\u001b[?2004l\r"]
[318.235563, "o", "\u001b[?2004h> "]
[318.235612, "o", "        out = model(bn, bb, bc)\r\n\u001b[?2004l\r"]
[318.23566, "o", "\u001b[?2004h> "]
[318.235715, "o", "        loss = criterion(out, bt)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[318.235776, "o", "        loss.backward()\r\n\u001b[?2004l\r"]
[318.235839, "o", "\u001b[?2004h> "]
[318.235893, "o", "        optimizer.step()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[318.235944, "o", "        train_loss += loss.item()\r\n\u001b[?2004l\r\u001b[?2004h"]
[318.235992, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[318.236041, "o", "    model.eval()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[318.236085, "o", "    with torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h"]
[318.236136, "o", "> "]
[318.236273, "o", "        v_num, v_bin, v_cat = x_val_num.to(DEVICE), x_val_bin.to(DEVICE), x_val_cat.to(DEVICE)\r\n\u001b[?2004l\r"]
[318.236346, "o", "\u001b[?2004h> "]
[318.23643, "o", "        v_out = torch.sigmoid(model(v_num, v_bin, v_cat)).cpu().numpy()\r\n\u001b[?2004l\r"]
[318.236476, "o", "\u001b[?2004h> "]
[318.236544, "o", "        val_score = roc_auc_score(y_val, v_out)\r\n\u001b[?2004l\r"]
[318.236587, "o", "\u001b[?2004h> "]
[318.236636, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[318.236812, "o", "    print(f'Epoch {epoch+1}/{epochs} | Loss: {train_loss/len(train_loader):.4f} | VAL_SCORE={val_score:.4f}')\r\n\u001b[?2004l\r"]
[318.236875, "o", "\u001b[?2004h> "]
[318.236926, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[318.23698, "o", "    if val_score > best_val_score:\r\n\u001b[?2004l\r\u001b[?2004h"]
[318.23703, "o", "> "]
[318.237088, "o", "        best_val_score = val_score\r\n\u001b[?2004l\r\u001b[?2004h> "]
[318.237158, "o", "        torch.save(model.state_dict(), best_model_path)\r\n\u001b[?2004l\r"]
[318.237205, "o", "\u001b[?2004h> "]
[318.237253, "o", "        no_improve = 0\r\n\u001b[?2004l\r"]
[318.237305, "o", "\u001b[?2004h>     else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[318.23736, "o", ">         no_improve += 1\r\n\u001b[?2004l\r"]
[318.237411, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[318.237458, "o", "\u001b[?2004h> "]
[318.237507, "o", "    if no_improve >= patience:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[318.237555, "o", "        print('Early stopping')\r\n\u001b[?2004l\r"]
[318.237603, "o", "\u001b[?2004h> "]
[318.237652, "o", "        break\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[318.237701, "o", "\u001b[?2004h> "]
[318.237761, "o", "print(f'VALIDATION_SCORE={best_val_score}')\r\n\u001b[?2004l\r"]
[318.237815, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[318.237873, "o", "# Final Prediction\r\n\u001b[?2004l\r\u001b[?2004h> "]
[318.23795, "o", "model.load_state_dict(torch.load(best_model_path))\r\n\u001b[?2004l\r"]
[318.237994, "o", "\u001b[?2004h> "]
[318.238048, "o", "model.eval()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[318.238102, "o", "with torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h"]
[318.238165, "o", "> "]
[318.238263, "o", "    t_num, t_bin, t_cat = x_test_num.to(DEVICE), x_test_bin.to(DEVICE), x_test_cat.to(DEVICE)\r\n\u001b[?2004l\r"]
[318.238307, "o", "\u001b[?2004h> "]
[318.23841, "o", "    t_out = torch.sigmoid(model(t_num, t_bin, t_cat)).cpu().numpy()\r\n\u001b[?2004l\r"]
[318.238454, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[318.238502, "o", "\u001b[?2004h> "]
[318.238551, "o", "preds_df = pd.DataFrame({'target': t_out})\r\n\u001b[?2004l\r"]
[318.238614, "o", "\u001b[?2004h> "]
[318.238666, "o", "preds_df.to_csv('/app/predictions.csv', index=False)\r\n\u001b[?2004l\r"]
[318.238718, "o", "\u001b[?2004h> EOF"]
[318.238779, "o", "\r\n\u001b[?2004l\r"]
[318.240592, "o", "\u001b[?2004h"]
[318.241804, "o", "root@13b6adf924ce:/workspace# "]
[318.374638, "i", "python3 train_model.py\n"]
[318.380808, "o", "python3 train_model.py\r\n\u001b[?2004l\r"]
[320.424859, "o", "DEVICE= cpu\r\n"]
[340.858792, "o", "Traceback (most recent call last):\r\n  File \"/workspace/train_model.py\", line 67, in <module>\r\n    pos_sum = np.sum(y_train)\r\n"]
[340.859093, "o", "              ^^^^^^^^^^^^^^^\r\n  File \"/usr/local/lib/python3.12/site-packages/numpy/_core/fromnumeric.py\", line 2463, in sum\r\n"]
[340.863784, "o", "    return _wrapreduction(\r\n           ^^^^^^^^^^^^^^^\r\n  File \"/usr/local/lib/python3.12/site-packages/numpy/_core/fromnumeric.py\", line 81, in _wrapreduction\r\n    return reduction(axis=axis, out=out, **passkwargs)\r\n           ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\r\nTypeError: sum() got an unexpected keyword argument 'axis'\r\n"]
[341.593243, "o", "\u001b[?2004hroot@13b6adf924ce:/workspace# "]
[448.021301, "i", "cat <<EOF > train_model.py\nimport pandas as pd\nimport numpy as np\nimport torch\nimport torch.nn as nn\nimport torch.optim as optim\nfrom torch.utils.data import DataLoader, TensorDataset\nfrom sklearn.metrics import roc_auc_score\nfrom sklearn.preprocessing import StandardScaler\nimport json\nimport os\n\n# Hardware - REQUIRED snippet\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\n# Load data\ntrain_df = pd.read_csv('/app/data/train.csv')\nval_df = pd.read_csv('/app/data/val.csv')\ntest_df = pd.read_csv('/app/data/test.csv')\n\nnum_cols = [c for c in train_df.columns if c.startswith('num_')]\nbin_cols = [c for c in train_df.columns if c.startswith('bin_')]\ncat_cols = [c for c in train_df.columns if c.startswith('cat_')]\n\n# Preprocessing\nnum_medians = train_df[num_cols].median().fillna(0)\n\ndef preprocess(df, scaler=None, medians=None):\n    num_data = df[num_cols].fillna(medians)\n    if scaler is None:\n        scaler = StandardScaler()\n        num_scaled = scaler.fit_transform(num_data)\n    else:\n        num_scaled = scaler.transform(num_data)\n    bin_data = df[bin_cols].fillna(0).astype(float).values\n    cat_data = df[cat_cols].fillna(-1).astype(int).values\n    return num_scaled, bin_data, cat_data, scaler\n\nx_train_num, x_train_bin, x_train_cat_raw, scaler = preprocess(train_df, medians=num_medians)\nx_val_num, x_val_bin, x_val_cat_raw, _ = preprocess(val_df, scaler=scaler, medians=num_medians)\nx_test_num, x_test_bin, x_test_cat_raw, _ = preprocess(test_df, scaler=scaler, medians=num_medians)\n\ny_train_np = train_df['target'].values.astype(np.float32)\ny_val_np = val_df['target'].values.astype(np.float32)\n\n# Calculate pos_weight using numpy array\npos_sum = np.sum(y_train_np)\npos_weight = torch.tensor([(len(y_train_np) - pos_sum) / pos_sum], dtype=torch.float32).to(DEVICE)\n\n# Tensors\nx_train_num = torch.tensor(x_train_num, dtype=torch.float32)\nx_train_bin = torch.tensor(x_train_bin, dtype=torch.float32)\ny_train = torch.tensor(y_train_np, dtype=torch.float32)\n\nx_val_num = torch.tensor(x_val_num, dtype=torch.float32)\nx_val_bin = torch.tensor(x_val_bin, dtype=torch.float32)\ny_val = torch.tensor(y_val_np, dtype=torch.float32)\n\nx_test_num = torch.tensor(x_test_num, dtype=torch.float32)\nx_test_bin = torch.tensor(x_test_bin, dtype=torch.float32)\n\n# Determine category dimensions and handle OOV\ncat_dims = []\nfor col in cat_cols:\n    max_val = int(train_df[col].max())\n    cat_dims.append(max_val + 1 if max_val >= 0 else 1)\n\ndef fix_cat(df):\n    for col in cat_cols:\n        mv = int(train_df[col].max())\n        df[col] = df[col].clip(upper=mv).fillna(-1).astype(int)\n    return torch.tensor(df[cat_cols].values, dtype=torch.long)\n\nx_train_cat = fix_cat(train_df.copy())\nx_val_cat = fix_cat(val_df.copy())\nx_test_cat = fix_cat(test_df.copy())\n\n# Model\nclass TabNet(nn.Module):\n    def __init__(self, cat_dims):\n        super().__init__()\n        self.embeddings = nn.ModuleList([nn.Embedding(dim, 8) for dim in cat_dims])\n        num_feat_dim = len(num_cols) + len(bin_cols) + len(cat_dims) * 8\n        self.mlp = nn.Sequential(\n            nn.Linear(num_feat_dim, 256),\n            nn.ReLU(),\n            nn.Dropout(0.1),\n            nn.Linear(256, 128),\n            nn.ReLU(),\n            nn.Dropout(0.1),\n            nn.Linear(128, 1)\n        )\n    def forward(self, x_num, x_bin, x_cat):\n        cat_emb = [emb(x_cat[:, i]) for i, emb in enumerate(self.embeddings)]\n        x = torch.cat([x_num, x_bin, *cat_emb], dim=1)\n        return self.mlp(x)\n\nmodel = TabNet(cat_dims).to(DEVICE)\noptimizer = optim.Adam(model.parameters(), lr=1e-3)\ncriterion = nn.BCEWithLogitsLoss(pos_weight=pos_weight)\n\n# DataLoaders\ntrain_ds = TensorDataset(x_train_num, x_train_bin, x_train_cat, y_train)\ntrain_loader = DataLoader(train_ds, batch_size=1024, shuffle=True)\n\n# Training\nbest_val_score = -1\nbest_model_path = 'best_model.pt'\npatience = 15\nepochs = 200\nno_improve = 0\n\nfor epoch in range(epochs):\n    model.train()\n    train_loss = 0\n    for bn, bb, bc, bt in train_loader:\n        bn, bb, bc, "]
[448.021651, "i", "bt = bn.to(DEVICE), bb.to(DEVICE), bc.to(DEVICE), bt.to(DEVICE).unsqueeze(1)\n        optimizer.zero_grad()\n        out = model(bn, bb, bc)\n        loss = criterion(out, bt)\n        loss.backward()\n        optimizer.step()\n        train_loss += loss.item()\n    \n    model.eval()\n    with torch.no_grad():\n        v_num, v_bin, v_cat = x_val_num.to(DEVICE), x_val_bin.to(DEVICE), x_val_cat.to(DEVICE)\n        v_out = torch.sigmoid(model(v_num, v_bin, v_cat)).cpu().numpy()\n        val_score = roc_auc_score(y_val_np, v_out)\n    \n    print(f'Epoch {epoch+1}/{epochs} | Loss: {train_loss/len(train_loader):.4f} | VAL_SCORE={val_score:.4f}')\n    \n    if val_score > best_val_score:\n        best_val_score = val_score\n        torch.save(model.state_dict(), best_model_path)\n        no_improve = 0\n    else:\n        no_improve += 1\n    if no_improve >= patience:\n        print('Early stopping')\n        break\n\nprint(f'VALIDATION_SCORE={best_val_score}')\n\nmodel.load_state_dict(torch.load(best_model_path))\nmodel.eval()\nwith torch.no_grad():\n    t_num, t_bin, t_cat = x_test_num.to(DEVICE), x_test_bin.to(DEVICE), x_test_cat.to(DEVICE)\n    t_out = torch.sigmoid(model(t_num, t_bin, t_cat)).cpu().numpy()\n\npreds_df = pd.DataFrame({'target': t_out})\npreds_df.to_csv('/app/predictions.csv', index=False)\nEOF\n"]
[448.022639, "o", "cat <<EOF > train_model.py\r\n\u001b[?2004l\r\u001b[?2004h> import pandas as pd\r\n\u001b[?2004l\r"]
[448.022803, "o", "\u001b[?2004h> "]
[448.023165, "o", "import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> import torch\r\n\u001b[?2004l\r"]
[448.023265, "o", "\u001b[?2004h"]
[448.023318, "o", "> "]
[448.024806, "o", "import torch.nn as nn\r\n\u001b[?2004l\r\u001b[?2004h> import torch.optim as optim\r\n\u001b[?2004l\r\u001b[?2004h> from torch.utils.data import DataLoader, TensorDataset\r\n\u001b[?2004l\r\u001b[?2004h> from sklearn.metrics import roc_auc_score\r\n\u001b[?2004l\r\u001b[?2004h> from sklearn.preprocessing import StandardScaler\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> import os\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Hardware - REQUIRED snippet\r\n\u001b[?2004l\r\u001b[?2004h> DEVICE = ('cuda' if torch.cuda.is_available()\r\n\u001b[?2004l\r\u001b[?2004h>           else 'mps' if torch.backends.mps.is_available() else 'cpu')\r\n\u001b[?2004l\r\u001b[?2004h> print('DEVICE=', DEVICE)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[448.02491, "o", "      optimizer.zero_grad()\r\n        out = model(bn, bb, bc)\r\n        loss = criterion(out, bt)\r\n        loss.backward()\r\n        optimizer.step()\r\n        train_loss += loss.item()\r\n    \r\n    model.eval()\r\n    with torch.no_grad():\r\n        v_num, v_bin, v_cat = x_val_num.to(DEVICE), x_val_bin.to(DEVICE), x_val_cat.to(DEVICE)\r\n        v_out = torch.sigmoid(model(v_num, v_bin, v_cat)).cpu().numpy()"]
[448.026319, "o", "\u001b[?2004h> "]
[448.026407, "o", "# Load data\r\n\u001b[?2004l\r\u001b[?2004h"]
[448.026435, "o", "> "]
[448.026657, "o", "train_df = pd.read_csv('/app/data/train.csv')\r\n\u001b[?2004l\r\u001b[?2004h"]
[448.026681, "o", "> "]
[448.02687, "o", "val_df = pd.read_csv('/app/data/val.csv')\r\n\u001b[?2004l\r\u001b[?2004h"]
[448.026895, "o", "> "]
[448.027062, "o", "test_df = pd.read_csv('/app/data/test.csv')\r\n\u001b[?2004l\r\u001b[?2004h"]
[448.027087, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[448.027259, "o", "num_cols = [c for c in train_df.columns if c.startswith('num_')]\r\n\u001b[?2004l\r\u001b[?2004h"]
[448.027316, "o", "> "]
[448.027432, "o", "bin_cols = [c for c in train_df.columns if c.startswith('bin_')]\r\n\u001b[?2004l\r\u001b[?2004h"]
[448.027492, "o", "> "]
[448.02761, "o", "cat_cols = [c for c in train_df.columns if c.startswith('cat_')]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[448.027674, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[448.02776, "o", "# Preprocessing\r\n\u001b[?2004l\r\u001b[?2004h> "]
[448.027826, "o", "num_medians = train_df[num_cols].median().fillna(0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[448.027889, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[448.027981, "o", "def preprocess(df, scaler=None, medians=None):\r\n\u001b[?2004l\r\u001b[?2004h"]
[448.028043, "o", "> "]
[448.028117, "o", "    num_data = df[num_cols].fillna(medians)\r\n\u001b[?2004l\r\u001b[?2004h"]
[448.028179, "o", "> "]
[448.028254, "o", "    if scaler is None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[448.028338, "o", "        scaler = StandardScaler()\r\n\u001b[?2004l\r"]
[448.028397, "o", "\u001b[?2004h> "]
[448.028459, "o", "        num_scaled = scaler.fit_transform(num_data)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[448.028521, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[448.028617, "o", "        num_scaled = scaler.transform(num_data)\r\n\u001b[?2004l\r"]
[448.028694, "o", "\u001b[?2004h> "]
[448.028795, "o", "    bin_data = df[bin_cols].fillna(0).astype(float).values\r\n\u001b[?2004l\r"]
[448.028856, "o", "\u001b[?2004h> "]
[448.028953, "o", "    cat_data = df[cat_cols].fillna(-1).astype(int).values\r\n\u001b[?2004l\r\u001b[?2004h"]
[448.029019, "o", "> "]
[448.029084, "o", "    return num_scaled, bin_data, cat_data, scaler\r\n\u001b[?2004l\r\u001b[?2004h"]
[448.029116, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[448.029231, "o", "x_train_num, x_train_bin, x_train_cat_raw, scaler = preprocess(train_df, medians=num_medians)\r\n\u001b[?2004l\r\u001b[?2004h"]
[448.029297, "o", "> "]
[448.029366, "o", "x_val_num, x_val_bin, x_val_cat_raw, _ = preprocess(val_df, scaler=scaler, medians=num_medians)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[448.029481, "o", "x_test_num, x_test_bin, x_test_cat_raw, _ = preprocess(test_df, scaler=scaler, medians=num_medians)\r\n\u001b[?2004l\r\u001b[?2004h"]
[448.029543, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
