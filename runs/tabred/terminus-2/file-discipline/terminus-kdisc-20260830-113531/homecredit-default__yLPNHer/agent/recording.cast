[448.029751, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[448.029817, "o", "# Calculate pos_weight using numpy array\r\n\u001b[?2004l\r\u001b[?2004h> "]
[448.029891, "o", "pos_sum = np.sum(y_train_np)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[448.029955, "o", "pos_weight = torch.tensor([(len(y_train_np) - pos_sum) / pos_sum], dtype=torch.float32).to(DEVICE)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[448.030034, "o", "# Tensors\r\n\u001b[?2004l\r\u001b[?2004h> "]
