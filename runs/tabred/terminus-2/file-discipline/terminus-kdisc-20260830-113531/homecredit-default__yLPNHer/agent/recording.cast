[91.732896, "i", "cat <<EOF > baseline.py\nimport pandas as pd\nfrom sklearn.metrics import roc_auc_score\nimport numpy as np\n\ntrain = pd.read_csv('/app/data/train.csv')\nval = pd.read_csv('/app/data/val.csv')\ntrain_mean = train['target'].mean()\nval_preds = np.full(len(val), train_mean)\ntry:\n    score = roc_auc_score(val['target'], val_preds)\nexcept ValueError:\n    score = 0.5\nprint(f'TRIVIAL_BASELINE_SCORE={score}')\nprint(f'TRAIN_MEAN={train_mean}')\nEOF\n"]
[91.733847, "o", "cat <<EOF > baseline.py\r\n\u001b[?2004l\r\u001b[?2004h> import pandas as pd\r\n\u001b[?2004l\r\u001b[?2004h> from sklearn.metrics import roc_auc_score\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> train = pd.read_csv('/app/data/train.csv')\r\n\u001b[?2004l\r\u001b[?2004h> val = pd.read_csv('/app/data/val.csv')\r\n\u001b[?2004l\r\u001b[?2004h> train_mean = train['target'].mean()\r\n\u001b[?2004l\r\u001b[?2004h> val_preds = np.full(len(val), train_mean)\r\n\u001b[?2004l\r"]
[91.734284, "o", "\u001b[?2004h> try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.734438, "o", "    score = roc_auc_score(val['target'], val_preds)\r\n\u001b[?2004l\r\u001b[?2004h> except ValueError:\r\n\u001b[?2004l\r\u001b[?2004h>     score = 0.5\r\n\u001b[?2004l\r\u001b[?2004h> print(f'TRIVIAL_BASELINE_SCORE={score}')\r\n\u001b[?2004l\r\u001b[?2004h> print(f'TRAIN_MEAN={train_mean}')\r\n\u001b[?2004l\r\u001b[?2004h"]
