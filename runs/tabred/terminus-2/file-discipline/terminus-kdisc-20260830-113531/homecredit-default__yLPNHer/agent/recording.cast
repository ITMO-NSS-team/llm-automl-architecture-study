[56.181552, "i", "python3 -c \"import pandas as pd\nfrom sklearn.metrics import roc_auc_score\nimport numpy as np\n\ntrain = pd.read_csv('/app/data/train.csv')\nval = pd.read_csv('/app/data/val.csv')\ntrain_mean = train['target'].mean()\nval_preds = np.full(len(val), train_mean)\ntry:\n    score = roc_auc_score(val['target'], val_preds)\nexcept ValueError:\n    score = 0.5\nprint(f'TRIVIAL_BASELINE_SCORE={score}')\nprint(f'TRAIN_MEAN={train_mean}')\"\n"]
