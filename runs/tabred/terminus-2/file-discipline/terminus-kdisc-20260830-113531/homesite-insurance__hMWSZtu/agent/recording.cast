[170.322641, "o", ">     df_cat = df[cat_cols].fillna(-1).astype(int)"]
[170.322775, "o", "\r\n"]
[170.322825, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[170.322899, "o", "    if is_train and encoders is None:\r\n"]
[170.322982, "o", "\u001b[?2004l\r\u001b[?2004h"]
[170.323019, "o", ">         encoders = {}\r\n\u001b[?2004l\r\u001b[?2004h"]
[170.323078, "o", "> "]
[170.323157, "o", "        for col in cat_cols:\r\n"]
[170.323206, "o", "\u001b[?2004l\r\u001b[?2004h>             le = LabelEncoder()"]
[170.323315, "o", "\r\n\u001b[?2004l\r"]
[170.323337, "o", "\u001b[?2004h>             df_cat[col] = le.fit_transform(df_cat[col].astype(str))"]
[170.323398, "o", "\r\n"]
[170.32344, "o", "\u001b[?2004l\r\u001b[?2004h"]
[170.323486, "o", "> "]
[170.32355, "o", "            encoders[col] = le"]
[170.323621, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[170.323681, "o", ">     elif encoders is not None:"]
[170.32378, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[170.32385, "o", ">         for col in cat_cols:\r\n\u001b[?2004l\r\u001b[?2004h"]
[170.323893, "o", ">             le = encoders[col]"]
[170.324004, "o", "\r\n\u001b[?2004l\r"]
[170.324047, "o", "\u001b[?2004h>             mapping = {val: i for i, val in enumerate(le.classes_)}"]
[170.324087, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[170.324293, "o", "> "]
[170.324337, "o", "            df_cat[col] = df_cat[col].astype(str).map(mapping).fillna(-1).astype(int)"]
[170.324385, "o", "\r\n\u001b[?2004l\r"]
[170.324422, "o", "\u001b[?2004h"]
[170.324462, "o", ">     "]
[170.324505, "o", "\r\n\u001b[?2004l\r"]
[170.324618, "o", "\u001b[?2004h"]
[170.324669, "o", ">     X = np.hstack([df_num_scaled, df_bin, df_cat.values]).astype('float32')"]
[170.324733, "o", "\r\n"]
[170.324857, "o", "\u001b[?2004l\r\u001b[?2004h"]
[170.3249, "o", ">     y = df['target'].values.astype('float32') if 'target' in df.columns else None"]
[170.32494, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[170.324985, "o", "> "]
[170.325025, "o", "    "]
[170.325067, "o", "\r\n\u001b[?2004l\r"]
[170.325215, "o", "\u001b[?2004h> "]
[170.325255, "o", "    return torch.tensor(X), torch.tensor(y) if y is not None else None, encoders, scaler, cat_cols"]
[170.325299, "o", "\r\n\u001b[?2004l\r"]
[170.325343, "o", "\u001b[?2004h"]
[170.325374, "o", "> \r\n\u001b[?2004l\r"]
[170.325452, "o", "\u001b[?2004h> "]
[170.325494, "o", "class TabularModel(nn.Module):"]
[170.325539, "o", "\r\n\u001b[?2004l\r"]
[170.325611, "o", "\u001b[?2004h"]
[170.325666, "o", ">     def __init__(self, input_dim):"]
[170.325738, "o", "\r\n\u001b[?2004l\r"]
[170.325786, "o", "\u001b[?2004h>         super().__init__()"]
[170.325827, "o", "\r\n\u001b[?2004l\r"]
[170.325872, "o", "\u001b[?2004h"]
[170.32593, "o", "> "]
[170.325973, "o", "        self.net = nn.Sequential("]
[170.32608, "o", "\r\n"]
[170.326126, "o", "\u001b[?2004l\r\u001b[?2004h>             nn.Linear(input_dim, 128),"]
[170.326194, "o", "\r\n\u001b[?2004l\r"]
[170.326233, "o", "\u001b[?2004h>             nn.ReLU(),"]
[170.326303, "o", "\r\n\u001b[?2004l\r"]
[170.326344, "o", "\u001b[?2004h>             nn.Dropout(0.1),"]
[170.326418, "o", "\r\n\u001b[?2004l\r"]
[170.326463, "o", "\u001b[?2004h>             nn.Linear(128, 64),"]
[170.326525, "o", "\r\n\u001b[?2004l\r"]
[170.326565, "o", "\u001b[?2004h>             nn.ReLU(),"]
[170.32663, "o", "\r\n\u001b[?2004l\r"]
[170.326686, "o", "\u001b[?2004h>             nn.Dropout(0.1),"]
[170.326798, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[170.326867, "o", ">             nn.Linear(64, 1),\r\n\u001b[?2004l\r\u001b[?2004h"]
[170.326945, "o", ">             nn.Sigmoid()\r\n\u001b[?2004l\r"]
[170.327005, "o", "\u001b[?2004h>         )"]
[170.327078, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n"]
[170.327122, "o", "\u001b[?2004l\r\u001b[?2004h>     def forward(self, x):"]
[170.327183, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[170.327233, "o", ">         return self.net(x)"]
[170.327276, "o", "\r\n\u001b[?2004l\r"]
[170.327327, "o", "\u001b[?2004h"]
[170.327376, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[170.327413, "o", "> def main():"]
[170.327498, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[170.327541, "o", ">     train_df, val_df, test_df, schema = load_data()"]
[170.327582, "o", "\r\n\u001b[?2004l\r"]
[170.327625, "o", "\u001b[?2004h"]
[170.327672, "o", "> "]
[170.327731, "o", "    \r\n\u001b[?2004l\r"]
[170.327787, "o", "\u001b[?2004h> "]
[170.327841, "o", "    # Trivial Baseline"]
[170.327919, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.327964, "o", "    train_mean = train_df['target'].mean()"]
[170.32806, "o", "\r\n\u001b[?2004l\r"]
[170.328108, "o", "\u001b[?2004h>     val_baseline_preds = np.full(len(val_df), train_mean)"]
[170.328148, "o", "\r\n\u001b[?2004l\r"]
[170.328188, "o", "\u001b[?2004h"]
[170.328227, "o", "> "]
[170.328339, "o", "    baseline_score = roc_auc_score(val_df['target'], val_baseline_preds)"]
[170.328436, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[170.328478, "o", ">     print(f'TRIVIAL_BASELINE_MEAN={train_mean:.4f}')"]
[170.328515, "o", "\r\n\u001b[?2004l\r"]
[170.328602, "o", "\u001b[?2004h> "]
[170.328643, "o", "    print(f'TRIVIAL_BASELINE_SCORE={baseline_score:.4f}')"]
[170.328704, "o", "\r\n\u001b[?2004l\r"]
[170.328763, "o", "\u001b[?2004h"]
[170.328903, "o", "> \r\n\u001b[?2004l\r"]
[170.328945, "o", "\u001b[?2004h>     X_train_raw, y_train_raw, encoders, scaler, cat_cols = preprocess(train_df, schema)"]
[170.328987, "o", "\r\n\u001b[?2004l\r"]
[170.329027, "o", "\u001b[?2004h"]
[170.329152, "o", "> "]
[170.329192, "o", "    X_val_raw, y_val_raw, _, _, _ = preprocess(val_df, schema, encoders, scaler, is_train=False)"]
[170.329241, "o", "\r\n\u001b[?2004l\r"]
[170.32928, "o", "\u001b[?2004h"]
[170.329321, "o", "> "]
[170.329364, "o", "    \r\n\u001b[?2004l\r"]
[170.329637, "o", "\u001b[?2004h"]
[170.329743, "o", ">     X_train = X_train_raw.to(DEVICE)"]
[170.329808, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[170.329885, "o", "> "]
[170.329929, "o", "    y_train = y_train_raw.to(DEVICE).unsqueeze(1)"]
[170.330035, "o", "\r\n\u001b[?2004l\r"]
[170.330079, "o", "\u001b[?2004h> "]
[170.330126, "o", "    X_val = X_val_raw.to(DEVICE)\r\n"]
[170.330191, "o", "\u001b[?2004l\r\u001b[?2004h"]
[170.330261, "o", "> "]
[170.330325, "o", "    y_val = y_val_raw.to(DEVICE).unsqueeze(1)\r\n"]
[170.330388, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[170.330501, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h>     dataset = TensorDataset(X_train, y_train)"]
[170.330569, "o", "\r\n\u001b[?2004l\r"]
[170.330638, "o", "\u001b[?2004h"]
[170.330707, "o", "> "]
[170.330789, "o", "    loader = DataLoader(dataset, batch_size=1024, shuffle=True)"]
[170.330838, "o", "\r\n\u001b[?2004l\r"]
[170.33091, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.331025, "o", "    model = TabularModel(X_train.shape[1]).to(DEVICE)\r\n"]
[170.331085, "o", "\u001b[?2004l\r\u001b[?2004h"]
[170.331137, "o", "> "]
[170.331207, "o", "    criterion = nn.BCELoss()"]
[170.331301, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.331352, "o", "    optimizer = optim.Adam(model.parameters(), lr=0.001)"]
[170.331395, "o", "\r\n"]
[170.331443, "o", "\u001b[?2004l\r"]
[170.331505, "o", "\u001b[?2004h"]
[170.331564, "o", ">     "]
[170.331665, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.331765, "o", "    best_val_score = 0\r\n\u001b[?2004l\r\u001b[?2004h>     patience = 15"]
[170.331805, "o", "\r\n\u001b[?2004l\r"]
[170.331865, "o", "\u001b[?2004h> "]
[170.331922, "o", "    counter = 0"]
[170.331971, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.332064, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h>     for epoch in range(200):"]
[170.332107, "o", "\r\n\u001b[?2004l\r"]
[170.332172, "o", "\u001b[?2004h"]
[170.332233, "o", ">         model.train()"]
[170.332291, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[170.332332, "o", "> "]
[170.332417, "o", "        for batch_x, batch_y in loader:\r\n"]
[170.332516, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[170.332592, "o", "            optimizer.zero_grad()\r\n\u001b[?2004l\r"]
[170.332637, "o", "\u001b[?2004h> "]
[170.332768, "o", "            out = model(batch_x)\r\n\u001b[?2004l\r"]
[170.332825, "o", "\u001b[?2004h>             loss = criterion(out, batch_y)"]
[170.332897, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[170.332941, "o", ">             loss.backward()"]
[170.332987, "o", "\r\n"]
[170.33308, "o", "\u001b[?2004l\r\u001b[?2004h>             optimizer.step()"]
[170.333128, "o", "\r\n\u001b[?2004l\r"]
[170.333179, "o", "\u001b[?2004h> "]
[170.333261, "o", "        \r\n"]
[170.333306, "o", "\u001b[?2004l\r\u001b[?2004h>         model.eval()"]
[170.333394, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>         with torch.no_grad():"]
[170.333438, "o", "\r\n\u001b[?2004l\r"]
[170.333525, "o", "\u001b[?2004h>             val_preds = model(X_val).cpu().numpy()"]
[170.333568, "o", "\r\n"]
[170.333626, "o", "\u001b[?2004l\r"]
[170.333703, "o", "\u001b[?2004h> "]
[170.333793, "o", "            score = roc_auc_score(y_val.cpu().numpy(), val_preds)"]
[170.333841, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[170.33388, "o", ">             "]
[170.333951, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[170.333994, "o", ">         if score > best_val_score:"]
[170.334035, "o", "\r\n"]
[170.334112, "o", "\u001b[?2004l\r\u001b[?2004h>             best_val_score = score"]
[170.334152, "o", "\r\n\u001b[?2004l\r"]
[170.33421, "o", "\u001b[?2004h"]
[170.334298, "o", "> "]
[170.334337, "o", "            torch.save(model.state_dict(), 'best_model.pt')"]
[170.334379, "o", "\r\n\u001b[?2004l\r"]
[170.334417, "o", "\u001b[?2004h"]
[170.334458, "o", "> "]
[170.334516, "o", "            counter = 0"]
[170.334568, "o", "\r\n\u001b[?2004l\r"]
[170.334611, "o", "\u001b[?2004h>         else:"]
[170.334682, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[170.334748, "o", ">             counter += 1"]
[170.334794, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.334871, "o", "            "]
[170.33492, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>         if epoch % 10 == 0:"]
[170.335027, "o", "\r\n\u001b[?2004l\r"]
[170.335066, "o", "\u001b[?2004h>             print(f'Epoch {epoch} VALIDATION_SCORE={score:.4f}')"]
[170.335104, "o", "\r\n"]
[170.335156, "o", "\u001b[?2004l\r"]
[170.3352, "o", "\u001b[?2004h"]
[170.335248, "o", "> "]
[170.33533, "o", "            \r\n"]
[170.33537, "o", "\u001b[?2004l\r\u001b[?2004h>         if counter >= patience:"]
[170.335465, "o", "\r\n\u001b[?2004l\r"]
[170.335519, "o", "\u001b[?2004h>             print(f'Early stopping at epoch {epoch}')"]
[170.335559, "o", "\r\n\u001b[?2004l\r"]
[170.335601, "o", "\u001b[?2004h> "]
[170.335637, "o", "            break"]
[170.335719, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[170.335762, "o", ">             "]
[170.33588, "o", "\r\n\u001b[?2004l\r"]
[170.335982, "o", "\u001b[?2004h"]
[170.336044, "o", ">     print(f'FINAL_VALIDATION_SCORE={best_val_score:.4f}')"]
[170.336085, "o", "\r\n\u001b[?2004l\r"]
[170.336132, "o", "\u001b[?2004h"]
[170.336221, "o", ">     "]
[170.336262, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     # Predictions"]
[170.336301, "o", "\r\n\u001b[?2004l\r"]
[170.336386, "o", "\u001b[?2004h> "]
[170.336426, "o", "    model.load_state_dict(torch.load('best_model.pt'))"]
[170.336468, "o", "\r\n\u001b[?2004l\r"]
[170.336532, "o", "\u001b[?2004h> "]
[170.336591, "o", "    model.eval()\r\n\u001b[?2004l\r"]
[170.336747, "o", "\u001b[?2004h"]
[170.336796, "o", "> "]
[170.336842, "o", "    X_test_raw, _, _, _, _ = preprocess(test_df, schema, encoders, scaler, is_train=False)"]
[170.336896, "o", "\r\n\u001b[?2004l\r"]
[170.336988, "o", "\u001b[?2004h"]
[170.33703, "o", ">     X_test = X_test_raw.to(DEVICE)"]
[170.33707, "o", "\r\n\u001b[?2004l\r"]
[170.337116, "o", "\u001b[?2004h> "]
[170.337191, "o", "    "]
[170.337234, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     with torch.no_grad():"]
[170.337362, "o", "\r\n\u001b[?2004l\r"]
[170.337425, "o", "\u001b[?2004h>         test_preds = model(X_test).cpu().numpy()\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[170.337478, "o", "\u001b[?2004h> "]
[170.337543, "o", "    pd.DataFrame({'target': test_preds}).to_csv('/app/predictions.csv', index=False)"]
[170.337589, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[170.337683, "o", ">     print('Predictions saved to /app/predictions.csv')"]
[170.337721, "o", "\r\n"]
[170.337772, "o", "\u001b[?2004l\r\u001b[?2004h"]
[170.337831, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[170.337876, "o", "> "]
[170.337897, "o", "if __name__ == '__main__':"]
[170.337952, "o", "\r\n"]
[170.337989, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[170.33824, "o", "    main()\r\n\u001b[?2004l\r\u001b[?2004h> EOF"]
