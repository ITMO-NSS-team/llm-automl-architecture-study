[79.141055, "o", "num_features = [f for f in features if f.startswith('num_')]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.141161, "o", "num_means = train_df[num_features].mean()\r\n\u001b[?2004l\r\u001b[?2004h> num_stds = train_df[num_features].std().replace(0, 1)\r\n\u001b[?2004l\r"]
[79.141241, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> train_df[num_features] = (train_df[num_features] - num_means) / num_stds"]
[79.141332, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.141432, "o", "val_df[num_features] = (val_df[num_features] - num_means) / num_stds\r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.141537, "o", "test_df[num_features] = (test_df[num_features] - num_means) / num_stds\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Convert to tensors\r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.141635, "o", "X_train = torch.tensor(train_df[features].values, dtype=torch.float32).to(DEVICE)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.141736, "o", "y_train = torch.tensor(train_df[target_col].values, dtype=torch.float32).unsqueeze(1).to(DEVICE)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.141839, "o", "X_val = torch.tensor(val_df[features].values, dtype=torch.float32).to(DEVICE)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.141971, "o", "y_val = torch.tensor(val_df[target_col].values, dtype=torch.float32).unsqueeze(1).to(DEVICE)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.142058, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.142151, "o", "X_test = torch.tensor(test_df[features].values, dtype=torch.float32).to(DEVICE)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.142243, "o", "# Model\r\n\u001b[?2004l\r\u001b[?2004h> class WeatherNet(nn.Module):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.142288, "o", "    def __init__(self, input_dim):\r\n\u001b[?2004l\r\u001b[?2004h>         super(WeatherNet, self).__init__()\r\n\u001b[?2004l\r"]
[79.142384, "o", "\u001b[?2004h>         self.net = nn.Sequential(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.142472, "o", "            nn.Linear(input_dim, 128),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.142542, "o", "            nn.ReLU(),\r\n\u001b[?2004l\r\u001b[?2004h>             nn.Linear(128, 64),\r\n\u001b[?2004l\r\u001b[?2004h>             nn.ReLU(),\r\n\u001b[?2004l\r"]
[79.14258, "o", "\u001b[?2004h> "]
[79.142669, "o", "            nn.Linear(64, 32),\r\n\u001b[?2004l\r\u001b[?2004h>             nn.ReLU(),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.142713, "o", "            nn.Linear(32, 1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.142761, "o", "        )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.142801, "o", "    def forward(self, x):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.142933, "o", "        return self.net(x)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[79.143021, "o", "\u001b[?2004h> model = WeatherNet(len(features)).to(DEVICE)\r\n\u001b[?2004l\r\u001b[?2004h> criterion = nn.MSELoss()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.143096, "o", "optimizer = optim.Adam(model.parameters(), lr=0.001)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Training"]
[79.143142, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.143255, "o", "C_train = DataLoader(TensorDataset(X_train, y_train), batch_size=1024, shuffle=True)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> epochs = 200\r\n\u001b[?2004l\r"]
[79.143376, "o", "\u001b[?2004h> patience = 15\r\n\u001b[?2004l\r\u001b[?2004h> best_val_rmse = float('inf')\r\n\u001b[?2004l\r"]
[79.143452, "o", "\u001b[?2004h> counter = 0\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> for epoch in range(epochs):\r\n\u001b[?2004l\r\u001b[?2004h"]
[79.14353, "o", ">     model.train()\r\n\u001b[?2004l\r\u001b[?2004h>     train_loss = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.143592, "o", "    for batch_x, batch_y in C_train:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.143638, "o", "        optimizer.zero_grad()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.143681, "o", "        preds = model(batch_x)\r\n\u001b[?2004l\r"]
[79.143725, "o", "\u001b[?2004h> "]
[79.14377, "o", "        loss = criterion(preds, batch_y)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.143822, "o", "        loss.backward()\r\n\u001b[?2004l\r\u001b[?2004h>         optimizer.step()\r\n"]
[79.143844, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[79.144115, "o", "        train_loss += loss.item()\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     model.eval()\r\n\u001b[?2004l\r\u001b[?2004h>     with torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h>         val_preds = model(X_val)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.144188, "o", "        val_rmse = torch.sqrt(criterion(val_preds, y_val)).item()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.144228, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.144275, "o", "    if val_rmse < best_val_rmse:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.144313, "o", "        best_val_rmse = val_rmse\r\n\u001b[?2004l\r"]
[79.144352, "o", "\u001b[?2004h> "]
[79.144413, "o", "        torch.save(model.state_dict(), 'best_model.pth')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.144454, "o", "        counter = 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[79.144494, "o", ">     else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.14454, "o", "        counter += 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.144579, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h>     if (epoch + 1) % 10 == 0:\r\n"]
[79.144627, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[79.1447, "o", "        print(f'Epoch {epoch+1}/{epochs}, Val RMSE: {val_rmse:.4f}')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.144752, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.144788, "o", "    if counter >= patience:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.144849, "o", "        print(f'Early stopping at epoch {epoch+1}')"]
[79.145583, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>         break\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(f'VALIDATION_SCORE={best_val_rmse}')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Final Predictions\r\n\u001b[?2004l\r\u001b[?2004h> model.load_state_dict(torch.load('best_model.pth'))\r\n\u001b[?2004l\r\u001b[?2004h> model.eval()\r\n\u001b[?2004l\r\u001b[?2004h> with torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h>     test_preds = model(X_test).cpu().numpy().flatten()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> submission = pd.DataFrame({'target': test_preds})\r\n\u001b[?2004l\r\u001b[?2004h> submission.to_csv('/app/predictions.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h> print('Predictions saved to /app/predictions.csv')\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
