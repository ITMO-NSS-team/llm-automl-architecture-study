[47.337762, "i", "cat << 'EOF' > baseline.py\nimport pandas as pd\nimport numpy as np\nfrom sklearn.metrics import mean_squared_error\n\ntrain = pd.read_csv('/app/data/train.csv')\nval = pd.read_csv('/app/data/val.csv')\n\nmean_target = train['target'].mean()\nval_preds = np.full(len(val), mean_target)\nrmse = np.sqrt(mean_squared_error(val['target'], val_preds))\n\nprint(f'TRAIN_MEAN={mean_target}')\nprint(f'BASELINE_VALIDATION_SCORE={rmse}')\nEOF\n"]
[47.338355, "o", "cat << 'EOF' > baseline.py\r\n\u001b[?2004l\r\u001b[?2004h> import pandas as pd\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.338549, "o", "import numpy as np"]
[47.338748, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
