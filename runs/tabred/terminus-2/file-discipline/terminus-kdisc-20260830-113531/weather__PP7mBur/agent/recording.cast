[908.629718, "i", "cat << 'EOF' > train_final.py\nimport torch\nimport torch.nn as nn\nimport torch.optim as optim\nimport pandas as pd\nimport numpy as np\nfrom torch.utils.data import DataLoader, TensorDataset\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.metrics import mean_squared_error\n\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\ndef load_data():\n    train_df = pd.read_csv('/app/data/train.csv')\n    val_df = pd.read_csv('/app/data/val.csv')\n    test_df = pd.read_csv('/app/data/test.csv')\n    \n    target_col = 'target'\n    features = [c for c in train_df.columns if c != target_col]\n    \n    X_train = train_df[features].values\n    y_train = train_df[target_col].values\n    X_val = val_df[features].values\n    y_val = val_df[target_col].values\n    X_test = test_df.values\n    \n    # Simple Fill NaNs\n    median_vals = np.nanmedian(X_train, axis=0)\n    X_train = np.nan_to_num(X_train, nan=median_vals)\n    X_val = np.nan_to_num(X_val, nan=median_vals)\n    X_test = np.nan_to_num(X_test, nan=median_vals)\n    \n    scaler = StandardScaler()\n    X_train = scaler.fit_transform(X_train)\n    X_val = scaler.transform(X_val)\n    X_test = scaler.transform(X_test)\n    \n    return X_train, y_train, X_val, y_val, X_test\n\nclass SmallMLP(nn.Module):\n    def __init__(self, input_dim):\n        super().__init__()\n        self.net = nn.Sequential(\n            nn.Linear(input_dim, 64),\n            nn.ReLU(),\n            nn.Linear(64, 1)\n        )\n    def forward(self, x):\n        return self.net(x)\n\ndef run():\n    X_train, y_train, X_val, y_val, X_test = load_data()\n    \n    X_train_t = torch.tensor(X_train, dtype=torch.float32).to(DEVICE)\n    y_train_t = torch.tensor(y_train, dtype=torch.float32).unsqueeze(1).to(DEVICE)\n    X_val_t = torch.tensor(X_val, dtype=torch.float32).to(DEVICE)\n    y_val_t = torch.tensor(y_val, dtype=torch.float32).unsqueeze(1).to(DEVICE)\n    \n    loader = DataLoader(TensorDataset(X_train_t, y_train_t), batch_size=2048, shuff"]
[908.630076, "o", "cat << 'EOF' > train_final.py\r\nimport torch\r\nimport torch.nn as nn\r\nimport torch.optim as optim\r\nimport pandas as pd\r\nimport numpy as np\r\nfrom torch.utils.data import DataLoader, TensorDataset\r\nfrom sklearn.preprocessing import StandardScaler\r\nfrom sklearn.metrics import mean_squared_error\r\n\r\nDEVICE = ('cuda' if torch.cuda.is_available()\r\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\r\nprint('DEVICE=', DEVICE)\r\n\r\ndef load_data():\r\n    train_df = pd.read_csv('/app/data/train.csv')\r\n    val_df = pd.read_csv('/app/data/val.csv')\r\n    test_df = pd.read_csv('/app/data/test.csv')\r\n    \r\n    target_col = 'target'\r\n    features = [c for c in train_df.columns if c != target_col]\r\n    \r\n    X_train = train_df[features].values\r\n    y_train = train_df[target_col].values\r\n    X_val = val_df[features].values\r\n    y_val = val_df[target_col].values\r\n    X_test = test_df.values\r\n    \r\n    # Simple Fill NaNs\r\n    median_vals = np.nanmedian(X_train, axis=0)\r\n    X_train = np.nan_to_num(X_train, nan=median_vals)\r\n    X_val = np.nan_to_num(X_val, nan=median_vals)\r\n    X_test = np.nan_to_num(X_test, nan=median_vals)\r\n    \r\n    scaler = StandardScaler()\r\n    X_train = scaler.fit_transform(X_train)\r\n    X_val = scaler.transform(X_val)\r\n    X_test = scaler.transform(X_test)\r\n    \r\n    return X_train, y_train, X_val, y_val, X_test\r\n\r\nclass SmallMLP(nn.Module):\r\n    def __init__(self, input_dim):\r\n        super().__init__()\r\n        self.net = nn.Sequential(\r\n            nn.Linear(input_dim, 64),\r\n            nn.ReLU(),\r\n            nn.Linear(64, 1)\r\n        )\r\n    def forward(self, x):\r\n        return self.net(x)\r\n\r\ndef run():\r\n    X_train, y_train, X_val, y_val, X_test = load_data()\r\n    \r\n    X_train_t = torch.tensor(X_train, dtype=torch.float32).to(DEVICE)\r\n    y_train_t = torch.tensor(y_train, dtype=torch.float32).unsqueeze(1).to(DEVICE)\r\n    X_val_t = torch.tensor(X_val, dtype=torch.float32).to(DEVICE)\r\n    y_val_t = torch.tensor(y_val, dtype=torch.float32).unsqueeze(1).to(DEVICE)\r\n    \r\n    loader = DataLoader(TensorDataset(X_train_t, y_train_t), batch_size=2048, shuff"]
[908.630292, "i", "le=True)\n    \n    model = SmallMLP(X_train.shape[1]).to(DEVICE)\n    optimizer = optim.Adam(model.parameters(), lr=0.001)\n    criterion = nn.MSELoss()\n    \n    best_rmse = float('inf')\n    \n    for epoch in range(20):\n        model.train()\n        for bx, by in loader:\n            optimizer.zero_grad()\n            loss = criterion(model(bx), by)\n            loss.backward()\n            optimizer.step()\n            \n        model.eval()\n        with torch.no_grad():\n            preds = model(X_val_t).cpu().numpy()\n            rmse = np.sqrt(mean_squared_error(y_val, preds))\n            if rmse < best_rmse:\n                best_rmse = rmse\n                torch.save(model.state_dict(), 'best_model.pt')\n        \n        print(f\"Epoch {epoch} | RMSE: {rmse:.4f}\")\n\n    print(f\"VALIDATION_SCORE={best_rmse}\")\n    \n    # Final Predictions\n    model.load_state_dict(torch.load('best_model.pt'))\n    model.eval()\n    with torch.no_grad():\n        X_test_t = torch.tensor(X_test, dtype=torch.float32).to(DEVICE)\n        test_preds = model(X_test_t).cpu().numpy()\n        \n    pd.DataFrame({'target': test_preds.flatten()}).to_csv('/app/predictions.csv', index=False)\n    print(\"Predictions saved.\")\n\nif __name__ == \"__main__\":\n    run()\nEOF\n"]
