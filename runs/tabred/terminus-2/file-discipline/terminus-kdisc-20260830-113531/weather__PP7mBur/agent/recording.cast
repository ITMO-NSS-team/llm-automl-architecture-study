[1511.051437, "i", "python3 -c \"import torch, torch.nn as nn, torch.optim as optim, pandas as pd, numpy as np; from torch.utils.data import DataLoader, TensorDataset; from sklearn.preprocessing import StandardScaler; from sklearn.metrics import mean_squared_error; DEVICE='cpu'; print('DEVICE=', DEVICE); train=pd.read_csv('/app/data/train.csv'); val=pd.read_csv('/app/data/val.csv'); test=pd.read_csv('/app/data/test.csv'); feat=[c for c in train.columns if c!='target']; X_tr, y_tr = train[feat].values, train['target'].values; X_v, y_v = val[feat].values, val['target'].values; X_te=test.values; m=np.nanmedian(X_tr, axis=0); X_tr=np.nan_to_num(X_tr, nan=m); X_v=np.nan_to_num(X_v, nan=m); X_te=np.nan_to_num(X_te, nan=m); sc=StandardScaler(); X_tr=sc.fit_transform(X_tr); X_v=sc.transform(X_v); X_te=sc.transform(X_te); Xt=torch.tensor(X_tr, dtype=torch.float32); yt=torch.tensor(y_tr, dtype=torch.float32).unsqueeze(1); Xv=torch.tensor(X_v, dtype=torch.float32); loader=DataLoader(TensorDataset(Xt, yt), batch_size=2048, shuffle=True); model=nn.Sequential(nn.Linear(len(feat), 64), nn.ReLU(), nn.Linear(64, 1)); opt=optim.Adam(model.parameters(), lr=0.001); crit=nn.MSELoss(); best=float('inf'); for e in range(10): model.train(); [ (opt.zero_grad(), crit(model(bx), by).backward(), opt.step()) for bx, by in loader ]; model.eval(); with torch.no_grad(): p=model(Xv).numpy(); rmse=np.sqrt(mean_squared_error(y_v, p)); best=min(best, rmse); print(f'Epoch {e} RMSE: {rmse:.4f}'); print(f'VALIDATION_SCORE={best}'); model.eval(); with torch.no_grad(): res=model(torch.tensor(X_te, dtype=torch.float32)).numpy(); pd.DataFrame({'target': res.flatten()}).to_csv('/app/predictions.csv', index=False); print('Done.')\"\n"]
