[1435.108967, "i", "echo \"    best = float('inf')\"\n"]
[1435.307537, "i", "echo \"    for e in range(10):\"\n"]
[1435.497264, "i", "echo \"        model.train()\"\n"]
[1435.86928, "i", "echo \"        for bx, by in loader: opt.zero_grad(); crit(model(bx), by).backward(); opt.step()\"\n"]
[1436.154937, "i", "echo \"        model.eval()\"\n"]
[1436.403248, "i", "echo \"        with torch.no_grad():\"\n"]
[1436.546661, "i", "echo \"            p = model(Xv).cpu().numpy()\"\n"]
[1436.664254, "i", "echo \"            rmse = np.sqrt(mean_squared_error(y_v, p))\"\n"]
[1436.809104, "i", "echo \"            if rmse < best: best = rmse; torch.save(model.state_dict(), 'best.pt')\"\n"]
[1436.929367, "i", "echo \"    print(f'VALIDATION_SCORE={best}')\"\n"]
