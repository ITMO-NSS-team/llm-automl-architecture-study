[2117.511493, "i", "cat << 'EOF' > predict.py\nimport torch\nimport torch.nn as nn\nimport pandas as pd\nimport numpy as np\nfrom sklearn.preprocessing import StandardScaler\n\nDEVICE = 'cpu'\nclass SmallMLP(nn.Module):\n    def __init__(self, input_dim):\n        super().__init__()\n        self.net = nn.Sequential(nn.Linear(input_dim, 64), nn.ReLU(), nn.Linear(64, 1))\n    def forward(self, x): return self.net(x)\n\ndef run():\n    train_df = pd.read_csv('/app/data/train.csv')\n    test_df = pd.read_csv('/app/data/test.csv')\n    feat = [c for c in train_df.columns if c != 'target']\n    X_tr = train_df[feat].values\n    X_te = test_df.values\n    m = np.nanmedian(X_tr, axis=0)\n    X_te = np.nan_to_num(X_te, nan=m)\n    sc = StandardScaler().fit(X_tr)\n    X_te = sc.transform(X_te)\n    model = SmallMLP(len(feat)).to(DEVICE)\n    model.load_state_dict(torch.load('best_model.pt'))\n    model.eval()\n    with torch.no_grad():\n        X_te_t = torch.tensor(X_te, dtype=torch.float32).to(DEVICE)\n        res = model(X_te_t).cpu().numpy()\n    pd.DataFrame({'target': res.flatten()}).to_csv('/app/predictions.csv', index=False)\n    print('Predictions successfully saved.')\n\nif __name__ == '__main__':\n    run()\nEOF\n"]
[2117.692413, "i", "python3 predict.py\n"]
[2118.632273, "i", "ls -l /app/predictions.csv\n"]
