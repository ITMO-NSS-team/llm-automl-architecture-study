[32.413232, "i", "cat << 'EOF' > baseline.py\nimport pandas as pd\nimport numpy as np\nfrom sklearn.metrics import roc_auc_score\nimport sys\n\nprint(\"Loading data...\", flush=True)\n train = pd.read_csv('/app/data/train.csv')\n print(\"Train loaded.\", flush=True)\n val = pd.read_csv('/app/data/val.csv')\n print(\"Val loaded.\", flush=True)\n\ntarget_col = 'target'\n train_mean = train[target_col].mean()\n\nval_true = val[target_col].values\nval_preds = np.full(len(val), train_mean)\n\nprint(f'TRAINING_MEAN={train_mean}', flush=True)\n\ntry:\n    score = roc_auc_score(val_true, val_preds)\nexcept Exception as e:\n    print(f'Error calculating ROC-AUC: {e}', flush=True)\n    score = 0.5\n\nprint(f'TRIVIAL_BASELINE_SCORE={score}', flush=True)\nEOF\n"]
[32.413691, "o", "cat << 'EOF' > baseline.py\r\nimport pandas as pd\r\nimport numpy as np\r\nfrom sklearn.metrics import roc_auc_score\r\nimport sys\r\n\r\nprint(\"Loading data...\", flush=True)\r\n train = pd.read_csv('/app/data/train.csv')\r\n print(\"Train loaded.\", flush=True)\r\n val = pd.read_csv('/app/data/val.csv')\r\n print(\"Val loaded.\", flush=True)\r\n\r\ntarget_col = 'target'\r\n train_mean = train[target_col].mean()\r\n\r\nval_true = val[target_col].values\r\nval_preds = np.full(len(val), train_mean)\r\n\r\nprint(f'TRAINING_MEAN={train_mean}', flush=True)\r\n\r\ntry:\r\n    score = roc_auc_score(val_true, val_preds)\r\nexcept Exception as e:\r\n    print(f'Error calculating ROC-AUC: {e}', flush=True)\r\n    score = 0.5\r\n\r\nprint(f'TRIVIAL_BASELINE_SCORE={score}', flush=True)\r\nEOF\r\n"]
