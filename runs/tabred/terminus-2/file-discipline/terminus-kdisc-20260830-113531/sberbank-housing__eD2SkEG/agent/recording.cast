[58.081101, "i", "cat << 'EOF' > solution.py\nimport pandas as pd\nimport numpy as np\nimport torch\nimport torch.nn as nn\nfrom torch.utils.data import DataLoader, TensorDataset\nfrom sklearn.metrics import mean_squared_error\nfrom sklearn.preprocessing import StandardScaler, LabelEncoder\nimport json\n\n# 1. Hardware Resolution\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\n# Time budget allocation\nprint('Budget Allocation: Exploration: 0.1h, Training: 1h, Finalization: 0.1h')\n\ndef rmse(y_true, y_pred):\n    return np.sqrt(mean_squared_error(y_true, y_pred))\n\n# Load data\nprint('Loading data...')\ntrain_df = pd.read_csv('/app/data/train.csv')\nval_df = pd.read_csv('/app/data/val.csv')\ntest_df = pd.read_csv('/app/data/test.csv')\n\nx_train_raw = train_df.drop(columns=['target'])\ny_train = train_df['target'].values\nx_val_raw = val_df.drop(columns=['target'])\ny_val = val_df['target'].values\nx_test_raw = test_df\n\n# Trivial Baseline\nbaseline_val = np.full(len(y_val), np.median(y_train))\nbaseline_score = rmse(y_val, baseline_val)\nprint(f'TRIVIAL_BASELINE_SCORE={baseline_score}')\n\n# Preprocessing\nprint('Preprocessing...')\nnum_cols = [c for c in x_train_raw.columns if c.startswith('num_')]\nbin_cols = [c for c in x_train_raw.columns if c.startswith('bin_')]\ncat_cols = [c for c in x_train_raw.columns if c.startswith('cat_')]\n\n# Numerical: Fill NaN with median\nfor col in num_cols:\n    median_val = x_train_raw[col].median()\n    x_train_raw[col] = x_train_raw[col].fillna(median_val)\n    x_val_raw[col] = x_val_raw[col].fillna(median_val)\n    x_test_raw[col] = x_test_raw[col].fillna(median_val)\n\n# Categorical: Label Encoding\nfor col in cat_cols:\n    le = LabelEncoder()\n    combined = pd.concat([x_train_raw[col], x_val_raw[col], x_test_raw[col]])\n    le.fit(combined.astype(str))\n    x_train_raw[col] = le.transform(x_train_raw[col].astype(str))\n    x_val_raw[col] = le.transform(x_val_raw[col].astype(str))\n    x_test_raw[col] = le.transform(x_test_raw[col].astype(str))\n\n# Scale numerical features\nscaler = StandardScaler()\nx_train_scaled = scaler.fit_transform(x_train_raw[num_cols])\nx_val_scaled = scaler.transform(x_val_raw[num_cols])\nx_test_scaled = scaler.transform(x_test_raw[num_cols])\n\n# Combine all features\ndef combine_feats(num, bin_df, cat_df):\n    return np.hstack([num, bin_df.values, cat_df.values])\n\nX_train = combine_feats(x_train_scaled, x_train_raw[bin_cols + cat_cols], pd.DataFrame())\n# Wait, the logic above is slightly wrong, I already encoded cats in x_train_raw\nX_train = np.hstack([x_train_scaled, x_train_raw[bin_cols].values, x_train_raw[cat_cols].values])\nX_val = np.hstack([x_val_scaled, x_val_raw[bin_cols].values, x_val_raw[cat_cols].values])\nX_test = np.hstack([x_test_scaled, x_test_raw[bin_cols].values, x_test_raw[cat_cols].values])\n\n# Convert to torch tensors\nX_train_t = torch.tensor(X_train, dtype=torch.float32).to(DEVICE)\ny_train_t = torch.tensor(y_train, dtype=torch.float32).unsqueeze(1).to(DEVICE)\nX_val_t = torch.tensor(X_val, dtype=torch.float32).to(DEVICE)\ny_val_t = torch.tensor(y_val, dtype=torch.float32).unsqueeze(1).to(DEVICE)\nX_test_t = torch.tensor(X_test, dtype=torch.float32).to(DEVICE)\n\n# Model\nclass TabNetSimple(nn.Module):\n    def __init__(self, input_dim):\n        super().__init__()\n        self.net = nn.Sequential(\n            nn.Linear(input_dim, 256),\n            nn.ReLU(),\n            nn.Dropout(0.1),\n            nn.Linear(256, 128),\n            nn.ReLU(),\n            nn.Dropout(0.1),\n            nn.Linear(128, 64),\n            nn.ReLU(),\n            nn.Linear(64, 1)\n        )\n    def forward(self, x):\n        return self.net(x)\n\nmodel = TabNetSimple(X_train.shape[1]).to(DEVICE)\noptimizer = torch.optim.Adam(model.parameters(), lr=0.001)\ncriterion = nn.MSELoss()\n\n# Training loop with early stopping\nepochs = 500\npatience = 20\nbest_val_rmse = float('inf')\nbest_model_state = None\n\ntrain_loader = DataLoader(TensorDataset(X_train_t, y_train_t), batch_size=256, shuffle=True)\n\nprint('Training...')\nfor epoch in range(epochs):\n    model.train()\n"]
[58.081158, "i", "    train_loss = 0\n    for batch_x, batch_y in train_loader:\n        optimizer.zero_grad()\n        pred = model(batch_x)\n        loss = criterion(pred, batch_y)\n        loss.backward()\n        optimizer.step()\n        train_loss += loss.item()\n    \n    model.eval()\n    with torch.no_grad():\n        val_pred_t = model(X_val_t)\n        val_pred = val_pred_t.cpu().numpy()\n        current_val_rmse = rmse(y_val, val_pred)\n    \n    if current_val_rmse < best_val_rmse:\n        best_val_rmse = current_val_rmse\n        best_model_state = model.state_dict()\n        counter = 0\n    else:\n        counter += 1\n    \n    if epoch % 10 == 0:\n        print(f'Epoch {epoch}: Val RMSE = {current_val_rmse:.4f}')\n    \n    if counter >= patience:\n        print(f'Early stopping at epoch {epoch}')\n        break\n\nprint(f'VALIDATION_SCORE={best_val_rmse}')\n\n# Final Prediction\nmodel.load_state_dict(best_model_state)\nmodel.eval()\nwith torch.no_grad():\n    test_preds = model(X_test_t).cpu().numpy().flatten()\n\n# Sanity Check\nif np.any(np.isnan(test_preds)) or np.any(np.isinf(test_preds)):\n    print('Degenerate predictions detected! Using baseline instead.')\n    test_preds = np.full(len(test_preds), np.median(y_train))\n\nsubmission = pd.DataFrame({'target': test_preds})\nsubmission.to_csv('/app/predictions.csv', index=False)\nprint('Submission saved to /app/predictions.csv')\nEOF\n"]
