[346.747702, "i", "cat << 'EOF' > solution.py\nimport pandas as pd\nimport numpy as np\nimport torch\nfrom catboost import CatBoostRegressor\nfrom sklearn.metrics import mean_squared_error\n\n# Hardware Resolution\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\nprint('Budget Allocation: Exploration: 0.1h, Training: 0.5h, Finalization: 0.1h')\n\ndef rmse(y_true, y_pred):\n    return np.sqrt(mean_squared_error(y_true, y_pred))\n\n# Load data\nprint('Loading data...')\ntrain_df = pd.read_csv('/app/data/train.csv')\nval_df = pd.read_csv('/app/data/val.csv')\ntest_df = pd.read_csv('/app/data/test.csv')\n\nx_train = train_df.drop(columns=['target'])\ny_train = train_df['target']\nx_val = val_df.drop(columns=['target'])\ny_val = val_df['target']\nx_test = test_df\n\n# Trivial Baseline\nbaseline_val = np.full(len(y_val), np.median(y_train))\nbaseline_score = rmse(y_val, baseline_val)\nprint(f'TRIVIAL_BASELINE_SCORE={baseline_score}')\n\n# Identify feature types\nnum_cols = [c for c in x_train.columns if c.startswith('num_')]\nbin_cols = [c for c in x_train.columns if c.startswith('bin_')]\ncat_cols = [c for c in x_train.columns if c.startswith('cat_')]\n\n# Ensure categoricals are treated as strings for CatBoost\nfor col in cat_cols:\n    x_train[col] = x_train[col].astype(str)\n    x_val[col] = x_val[col].astype(str)\n    x_test[col] = x_test[col].astype(str)\n\n# Initialize CatBoostRegressor\nmodel = CatBoostRegressor(\n    iterations=2000,\n    learning_rate=0.05,\n    depth=6,\n    eval_metric='RMSE',\n    random_seed=42,\n    task_type='CPU' if DEVICE == 'cpu' else 'GPU',\n    verbose=100\n)\n\nprint('Training...')\nmodel.fit(\n    x_train, y_train,\n    eval_set=(x_val, y_val),\n    cat_features=cat_cols,\n    early_stopping_rounds=50,\n    use_best_model=True\n)\n\n# Validate\nval_preds = model.predict(x_val)\nval_score = rmse(y_val, val_preds)\nprint(f'VALIDATION_SCORE={val_score}')\n\nif val_score < baseline_score:\n    print('Model beats baseline!')\n    test_preds = model.predict(x_test)\nelse:\n    print('Model failed to beat baseline, using baseline predictions.')\n    test_preds = np.full(len(x_test), np.median(y_train))\n\n# Final Submission\nsubmission = pd.DataFrame({'target': test_preds})\nsubmission.to_csv('/app/predictions.csv', index=False)\nprint('Submission saved to /app/predictions.csv')\nEOF\n"]
