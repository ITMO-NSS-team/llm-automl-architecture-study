[?2004hroot@851787b7b099:/workspace# cat << 'EOF' > solution.py
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import torch
[?2004l[?2004h> import torch.nn as nn
[?2004l[?2004h> from torch.utils.data import DataLoader, TensorDataset
[?2004l[?2004h> from sklearn.metrics import mean_squared_error
[?2004l[?2004h> from sklearn.preprocessing import StandardScaler, LabelEncoder
[?2004l[?2004h> import json
[?2004l[?2004h> 
[?2004l[?2004h> # 1. Hardware Resolution
[?2004l[?2004h> DEVICE = ('cuda' if torch.cuda.is_available()
[?2004l[?2004h>           else 'mps' if torch.backends.mps.is_available() else 'cpu')
[?2004l[?2004h> print('DEVICE=', DEVICE)
[?2004l[?2004h> 
[?2004l[?2004h> # Time budget allocation
[?2004l[?2004h> print('Budget Allocation: Exploration: 0.1h, Training: 1h, Finalization: 0.1h')
[?2004l[?2004h> 
[?2004l[?2004h> def rmse(y_true, y_pred):
[?2004l[?2004h>     return np.sqrt(mean_squared_error(y_true, y_pred))
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h> print('Loading data...')
[?2004l[?2004h> train_df = pd.read_csv('/app/data/train.csv')
[?2004l[?2004h> val_df = pd.read_csv('/app/data/val.csv')
[?2004l[?2004h> test_df = pd.read_csv('/app/data/test.csv')
[?2004l[?2004h> 
[?2004l[?2004h> x_train_raw = train_df.drop(columns=['target'])
[?2004l[?2004h> y_train = train_df['target'].values
[?2004l[?2004h> x_val_raw = val_df.drop(columns=['target'])
[?2004l[?2004h> y_val = val_df['target'].values
[?2004l[?2004h> x_test_raw = test_df
[?2004l[?2004h> 
[?2004l[?2004h> # Trivial Baseline
[?2004l[?2004h> baseline_val = np.full(len(y_val), np.median(y_train))
[?2004l[?2004h> baseline_score = rmse(y_val, baseline_val)
[?2004l[?2004h> print(f'TRIVIAL_BASELINE_SCORE={baseline_score}')
[?2004l[?2004h> 
[?2004l[?2004h> # Preprocessing
[?2004l[?2004h> print('Preprocessing...')
[?2004l[?2004h> num_cols = [c for c in x_train_raw.columns if c.startswith('num_')]
[?2004l[?2004h> bin_cols = [c for c in x_train_raw.columns if c.startswith('bin_')]
[?2004l[?2004h> cat_cols = [c for c in x_train_raw.columns if c.startswith('cat_')]
[?2004l[?2004h> 
[?2004l[?2004h> # Numerical: Fill NaN with median
[?2004l[?2004h> for col in num_cols:
[?2004l[?2004h>     median_val = x_train_raw[col].median()
[?2004l[?2004h>     x_train_raw[col] = x_train_raw[col].fillna(median_val)
[?2004l[?2004h>     x_val_raw[col] = x_val_raw[col].fillna(median_val)
[?2004l[?2004h>     x_test_raw[col] = x_test_raw[col].fillna(median_val)
[?2004l[?2004h> 
[?2004l[?2004h> # Categorical: Label Encoding
[?2004l[?2004h> for col in cat_cols:
[?2004l[?2004h>     le = LabelEncoder()
[?2004l[?2004h>     combined = pd.concat([x_train_raw[col], x_val_raw[col], x_test_raw[col]])
[?2004l[?2004h>     le.fit(combined.astype(str))
[?2004l[?2004h>     x_train_raw[col] = le.transform(x_train_raw[col].astype(str))
[?2004l[?2004h>     x_val_raw[col] = le.transform(x_val_raw[col].astype(str))
[?2004l[?2004h>     x_test_raw[col] = le.transform(x_test_raw[col].astype(str))
[?2004l[?2004h> 
[?2004l[?2004h> # Scale numerical features
[?2004l[?2004h> scaler = StandardScaler()
[?2004l[?2004h> x_train_scaled = scaler.fit_transform(x_train_raw[num_cols])
[?2004l[?2004h> x_val_scaled = scaler.transform(x_val_raw[num_cols])
[?2004l[?2004h> x_test_scaled = scaler.transform(x_test_raw[num_cols])
[?2004l[?2004h> 
[?2004l[?2004h> # Combine all features
[?2004l[?2004h> def combine_feats(num, bin_df, cat_df):
[?2004l[?2004h>     return np.hstack([num, bin_df.values, cat_df.values])
[?2004l[?2004h> 
[?2004l[?2004h> X_train = combine_feats(x_train_scaled, x_train_raw[bin_cols + cat_cols], pd.DataFrame())
[?2004l[?2004h> # Wait, the logic above is slightly wrong, I already encoded cats in x_train_raw
[?2004l[?2004h> X_train = np.hstack([x_train_scaled, x_train_raw[bin_cols].values, x_train_raw[cat_cols].values])
[?2004l[?2004h> X_val = np.hstack([x_val_scaled, x_val_raw[bin_cols].values, x_val_raw[cat_cols].values])
[?2004l[?2004h> X_test = np.hstack([x_test_scaled, x_test_raw[bin_cols].values, x_test_raw[cat_cols].values])
[?2004l[?2004h> 
[?2004l[?2004h> # Convert to torch tensors
[?2004l[?2004h> X_train_t = torch.tensor(X_train, dtype=torch.float32).to(DEVICE)
[?2004l[?2004h> y_train_t = torch.tensor(y_train, dtype=torch.float32).unsqueeze(1).to(DEVICE)
[?2004l[?2004h> X_val_t = torch.tensor(X_val, dtype=torch.float32).to(DEVICE)
[?2004l[?2004h> y_val_t = torch.tensor(y_val, dtype=torch.float32).unsqueeze(1).to(DEVICE)
[?2004l[?2004h> X_test_t = torch.tensor(X_test, dtype=torch.float32).to(DEVICE)
[?2004l[?2004h> 
[?2004l[?2004h> # Model
[?2004l[?2004h> class TabNetSimple(nn.Module):
[?2004l[?2004h>     def __init__(self, input_dim):
[?2004l[?2004h>         super().__init__()
[?2004l[?2004h>         self.net = nn.Sequential(
[?2004l[?2004h>             nn.Linear(input_dim, 256),
[?2004l[?2004h>             nn.ReLU(),
[?2004l[?2004h>             nn.Dropout(0.1),
[?2004l[?2004h>             nn.Linear(256, 128),
[?2004l[?2004h>             nn.ReLU(),
[?2004l[?2004h>             nn.Dropout(0.1),
[?2004l[?2004h>             nn.Linear(128, 64),
[?2004l[?2004h>             nn.ReLU(),
[?2004l[?2004h>             nn.Linear(64, 1)
[?2004l[?2004h>         )
[?2004l[?2004h>     def forward(self, x):
[?2004l[?2004h>         return self.net(x)
[?2004l[?2004h> 
[?2004l[?2004h> model = TabNetSimple(X_train.shape[1]).to(DEVICE)
[?2004l[?2004h> optimizer = torch.optim.Adam(model.parameters(), lr=0.001)
[?2004l[?2004h> criterion = nn.MSELoss()
[?2004l[?2004h> 
[?2004l[?2004h> # Training loop with early stopping
[?2004l[?2004h> epochs = 500
[?2004l[?2004h> patience = 20
[?2004l[?2004h> best_val_rmse = float('inf')
[?2004l[?2004h> best_model_state = None
[?2004l[?2004h> 
[?2004l[?2004h> train_loader = DataLoader(TensorDataset(X_train_t, y_train_t), batch_size=256, shuffle=True)
[?2004l[?2004h> 
[?2004l[?2004h> print('Training...')
[?2004l[?2004h> for epoch in range(epochs):
[?2004l[?2004h>     model.train()
[?2004l[?2004h>     train_loss = 0
[?2004l[?2004h>     for batch_x, batch_y in train_loader:
[?2004l[?2004h>         optimizer.zero_grad()
[?2004l[?2004h>         pred = model(batch_x)
[?2004l[?2004h>         loss = criterion(pred, batch_y)
[?2004l[?2004h>         loss.backward()
[?2004l[?2004h>         optimizer.step()
[?2004l[?2004h>         train_loss += loss.item()
[?2004l[?2004h>     
[?2004l[?2004h>     model.eval()
[?2004l[?2004h>     with torch.no_grad():
[?2004l[?2004h>         val_pred_t = model(X_val_t)
[?2004l[?2004h>         val_pred = val_pred_t.cpu().numpy()
[?2004l[?2004h>         current_val_rmse = rmse(y_val, val_pred)
[?2004l[?2004h>     
[?2004l[?2004h>     if current_val_rmse < best_val_rmse:
[?2004l[?2004h>         best_val_rmse = current_val_rmse
[?2004l[?2004h>         best_model_state = model.state_dict()
[?2004l[?2004h>         counter = 0
[?2004l[?2004h>     else:
[?2004l[?2004h>         counter += 1
[?2004l[?2004h>     
[?2004l[?2004h>     if epoch % 10 == 0:
[?2004l[?2004h>         print(f'Epoch {epoch}: Val RMSE = {current_val_rmse:.4f}')
[?2004l[?2004h>     
[?2004l[?2004h>     if counter >= patience:
[?2004l[?2004h>         print(f'Early stopping at epoch {epoch}')
[?2004l[?2004h>         break
[?2004l[?2004h> 
[?2004l[?2004h> print(f'VALIDATION_SCORE={best_val_rmse}')
[?2004l[?2004h> 
[?2004l[?2004h> # Final Prediction
[?2004l[?2004h> model.load_state_dict(best_model_state)
[?2004l[?2004h> model.eval()
[?2004l[?2004h> with torch.no_grad():
[?2004l[?2004h>     test_preds = model(X_test_t).cpu().numpy().flatten()
[?2004l[?2004h> 
[?2004l[?2004h> # Sanity Check
[?2004l[?2004h> if np.any(np.isnan(test_preds)) or np.any(np.isinf(test_preds)):
[?2004l[?2004h>     print('Degenerate predictions detected! Using baseline instead.')
[?2004l[?2004h>     test_preds = np.full(len(test_preds), np.median(y_train))
[?2004l[?2004h> 
[?2004l[?2004h> submission = pd.DataFrame({'target': test_preds})
[?2004l[?2004h> submission.to_csv('/app/predictions.csv', index=False)
[?2004l[?2004h> print('Submission saved to /app/predictions.csv')
