[?2004hroot@e7c827d5f7fe:/workspace# cat << 'EOF' > train.py
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import lightgbm as lgb
[?2004l[?2004h> from sklearn.metrics import mean_squared_error
[?2004l[?2004h> import torch
[?2004l[?2004h> import joblib
[?2004l[?2004h> 
[?2004l[?2004h> # REQUIRED HARDWARE RESOLUTION
[?2004l[?2004h> DEVICE = ('cuda' if torch.cuda.is_available()
[?2004l[?2004h>           else 'mps' if torch.backends.mps.is_available() else 'cpu')
[?2004l[?2004h> print('DEVICE=', DEVICE)
[?2004l[?2004h> 
[?2004l[?2004h> def rmse(y_true, y_pred):
[?2004l[?2004h>     return np.sqrt(mean_squared_error(y_true, y_pred))
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h> print('Loading data...')
[?2004l[?2004h> train_df = pd.read_csv('/app/data/train.csv')
[?2004l[?2004h> val_df = pd.read_csv('/app/data/val.csv')
[?2004l[?2004h> test_df = pd.read_csv('/app/data/test.csv')
[?2004l[?2004h> 
[?2004l[?2004h> X_train = train_df.drop(columns=['target'])
[?2004l[?2004h> y_train = train_df['target']
[?2004l[?2004h> X_val = val_df.drop(columns=['target'])
[?2004l[?2004h> y_val = val_df['target']
[?2004l[?2004h> 
[?2004l[?2004h> # Identify categorical features
[?2004l[?2004h> cat_features = [col for col in X_train.columns if col.startswith('cat_')]
[?2004l[?2004h> bin_features = [col for col in X_train.columns if col.startswith('bin_')]
[?2004l[?2004h> 
[?2004l[?2004h> # Convert categorical to 'category' dtype for LightGBM
[?2004l[?2004h> for col in cat_features + bin_features:
[?2004l[?2004h>     X_train[col] = X_train[col].astype('category')
[?2004l[?2004h>     X_val[col] = X_val[col].astype('category')
[?2004l[?2004h>     test_df[col] = test_df[col].astype('category')
[?2004l[?2004h> 
[?2004l[?2004h> # LightGBM model
[?2004l[?2004h> model = lgb.LGBMRegressor(
[?2004l[?2004h>     n_estimators=10000,
[?2004l[?2004h>     learning_rate=0.05,
[?2004l[?2004h>     num_leaves=31,
[?2004l[?2004h>     objective='regression',
[?2004l[?2004h>     metric='rmse',
[?2004l[?2004h>     random_state=42,
[?2004l[?2004h>     device=DEVICE if DEVICE != 'mps' else 'cpu' # LightGBM doesn't support mps officially
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> print('Training model...')
[?2004l[?2004h> model.fit(
[?2004l[?2004h>     X_train, y_train,
[?2004l[?2004h>     eval_set=[(X_val, y_val)],
[?2004l[?2004h>     eval_metric='rmse',
[?2004l[?2004h>     callbacks=[lgb.early_stopping(stopping_rounds=100), lgb.log_evaluation(period=100)]
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> # Evaluation
[?2004l[?2004h> preds_val = model.predict(X_val)
[?2004l[?2004h> score = rmse(y_val, preds_val)
[?2004l[?2004h> print(f'VALIDATION_SCORE={score}')
[?2004l[?2004h> 
[?2004l[?2004h> # Save best model
[?2004l[?2004h> joblib.dump(model, 'best_model.pkl')
[?2004l[?2004h> 
[?2004l[?2004h> # Generate test predictions
[?2004l[?2004h> print('Generating test predictions...')
[?2004l[?2004h> preds_test = model.predict(test_df)
[?2004l[?2004h> submission = pd.DataFrame({'target': preds_test})
[?2004l[?2004h> submission.to_csv('/app/predictions.csv', index=False)
[?2004l[?2004h> print('Predictions saved to /app/predictions.csv')
[?2004l[?2004h> EOF
