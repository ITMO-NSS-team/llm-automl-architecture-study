[?2004hroot@e7c827d5f7fe:/workspace# python3 -c "import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from sklearn.metrics import mean_squared_error
[?2004l[?2004h> 
[?2004l[?2004h> train = pd.read_csv('/app/data/train.csv')
[?2004l[?2004h> val = pd.read_csv('/app/data/val.csv')
[?2004l[?2004h> 
[?2004l[?2004h> median_target = train['target'].median()
[?2004l[?2004h> val_preds = np.full(len(val), median_target)
[?2004l[?2004h> rmse = np.sqrt(mean_squared_error(val['target'], val_preds))
[?2004l[?2004h> 
[?2004l[?2004h> print(f'TRAIN_MEDIAN={median_target}')
