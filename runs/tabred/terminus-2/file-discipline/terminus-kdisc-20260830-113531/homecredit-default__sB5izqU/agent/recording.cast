[318.414694, "i", "cat << 'EOF' > train_lgbm.py\nimport pandas as pd\nimport numpy as np\nimport lightgbm as lgb\nfrom sklearn.metrics import roc_auc_score\nfrom sklearn.preprocessing import LabelEncoder\n\ndef train():\n    print('Loading data...')\n    train_df = pd.read_csv('/app/data/train.csv')\n    val_df = pd.read_csv('/app/data/val.csv')\n    test_df = pd.read_csv('/app/data/test.csv')\n\n    y_train = train_df['target']\n    y_val = val_df['target']\n    X_train = train_df.drop(columns=['target'])\n    X_val = val_df.drop(columns=['target'])\n    X_test = test_df\n\n    # Handle categorical features\n    cat_cols = [c for c in X_train.columns if c.startswith('cat_')]\n    for col in cat_cols:\n        le = LabelEncoder()\n        all_vals = pd.concat([X_train[col], X_val[col], X_test[col]]).astype(str)\n        le.fit(all_vals)\n        X_train[col] = le.transform(X_train[col].astype(str))\n        X_val[col] = le.transform(X_val[col].astype(str))\n        X_test[col] = le.transform(X_test[col].astype(str))\n\n    # Trivial Baseline\n    train_mean = y_train.mean()\n    baseline_preds = np.full(len(y_val), train_mean)\n    baseline_score = roc_auc_score(y_val, baseline_preds)\n    print(f'TRIVIAL_BASELINE_SCORE={baseline_score}')\n\n    # LightGBM Dataset\n    train_data = lgb.Dataset(X_train, label=y_train)\n    val_data = lgb.Dataset(X_val, label=y_val, reference=train_data)\n\n    params = {\n        'objective': 'binary',\n        'metric': 'auc',\n        'boosting_type': 'gbdt',\n        'learning_rate': 0.05,\n        'num_leaves': 31,\n        'feature_fraction': 0.8,\n        'bagging_fraction': 0.8,\n        'bagging_freq': 5,\n        'verbose': -1,\n        'n_jobs': -1\n    }\n\n    print('Training LightGBM...')\n    model = lgb.train(\n        params,\n        train_data,\n        num_boost_round=1000,\n        valid_sets=[val_data],\n        callbacks=[lgb.early_stopping(stopping_rounds=50)]\n    )\n\n    val_preds = model.predict(X_val)\n    val_score = roc_auc_score(y_val, val_preds)\n    print(f'VALIDATION_SCORE={val_score}')\n\n    if val_score <= baseline_score:\n        print('Model did not beat baseline, using baseline predictions')\n        test_preds = np.full(len(X_test), train_mean)\n    else:\n        print('Model beat baseline!')\n        test_preds = model.predict(X_test)\n\n    pd.DataFrame({'target': test_preds}).to_csv('/app/predictions.csv', index=False)\n    print('Predictions saved to /app/predictions.csv')\n\nif __name__ == '__main__':\n    train()\nEOF\n"]
[318.415185, "o", "cat << 'EOF' > train_lgbm.py\r\nimport pandas as pd\r\nimport numpy as np\r\nimport lightgbm as lgb\r\nfrom sklearn.metrics import roc_auc_score\r\nfrom sklearn.preprocessing import LabelEncoder\r\n\r\ndef train():\r\n    print('Loading data...')\r\n    train_df = pd.read_csv('/app/data/train.csv')\r\n    val_df = pd.read_csv('/app/data/val.csv')\r\n    test_df = pd.read_csv('/app/data/test.csv')\r\n\r\n    y_train = train_df['target']\r\n    y_val = val_df['target']\r\n    X_train = train_df.drop(columns=['target'])\r\n    X_val = val_df.drop(columns=['target'])\r\n    X_test = test_df\r\n\r\n    # Handle categorical features\r\n    cat_cols = [c for c in X_train.columns if c.startswith('cat_')]\r\n    for col in cat_cols:\r\n        le = LabelEncoder()\r\n        all_vals = pd.concat([X_train[col], X_val[col], X_test[col]]).astype(str)\r\n        le.fit(all_vals)\r\n        X_train[col] = le.transform(X_train[col].astype(str))\r\n        X_val[col] = le.transform(X_val[col].astype(str))\r\n        X_test[col] = le.transform(X_test[col].astype(str))\r\n\r\n    # Trivial Baseline\r\n    train_mean = y_train.mean()\r\n    baseline_preds = np.full(len(y_val), train_mean)\r\n    baseline_score = roc_auc_score(y_val, baseline_preds)\r\n    print(f'TRIVIAL_BASELINE_SCORE={baseline_score}')\r\n\r\n    # LightGBM Dataset\r\n    train_data = lgb.Dataset(X_train, label=y_train)\r\n    val_data = lgb.Dataset(X_val, label=y_val, reference=train_data)\r\n\r\n    params = {\r\n        'objective': 'binary',\r\n        'metric': 'auc',\r\n        'boosting_type': 'gbdt',\r\n        'learning_rate': 0.05,\r\n        'num_leaves': 31,\r\n        'feature_fraction': 0.8,\r\n        'bagging_fraction': 0.8,\r\n        'bagging_freq': 5,\r\n        'verbose': -1,\r\n        'n_jobs': -1\r\n    }\r\n\r\n    print('Training LightGBM...')\r\n    model = lgb.train(\r\n        params,\r\n        train_data,\r\n        num_boost_round=1000,\r\n        valid_sets=[val_data],\r\n        callbacks=[lgb.early_stopping(stopping_rounds=50)]\r\n    )\r\n\r\n    val_preds = model.predict(X_val)\r\n    val_score = roc_auc_score(y_val, val_preds)\r\n    print(f'VALIDATION_SCORE={val_score}')\r\n\r\n    if val_score <= baseline_score:\r\n        print('Model did not beat baseline, using baseline predictions')\r\n        test_preds = np.full(len(X_test), train_mean)\r\n    else:\r\n        print('Model beat baseline!')\r\n        test_preds = model.predict(X_test)\r\n\r\n    pd.DataFrame({'target': test_preds}).to_csv('/app/predictions.csv', index=False)\r\n    print('Predictions saved to /app/predictions.csv')\r\n\r\nif __name__ == '__main__':\r\n    train()\r\nEOF\r\n"]
