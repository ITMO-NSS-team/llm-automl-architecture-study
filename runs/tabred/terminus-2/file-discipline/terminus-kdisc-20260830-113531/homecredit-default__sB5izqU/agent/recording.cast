[100.143713, "o", "\u001b[?2004hroot@dffb7f5aec7f:/workspace# "]
[165.357095, "i", "cat << 'EOF' > train_model.py\nimport pandas as pd\nimport numpy as np\nimport torch\nimport torch.nn as nn\nimport torch.optim as optim\nfrom torch.utils.data import DataLoader, TensorDataset\nfrom sklearn.metrics import roc_auc_score\nfrom sklearn.preprocessing import StandardScaler, LabelEncoder\nimport time\n\n# Hardware resolution\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\ndef load_data():\n    train = pd.read_csv('/app/data/train.csv')\n    val = pd.read_csv('/app/data/val.csv')\n    test = pd.read_csv('/app/data/test.csv')\n    return train, val, test\n\ndef preprocess(train, val, test):\n    num_cols = [c for c in train.columns if c.startswith('num_')]\n    bin_cols = [c for c in train.columns if c.startswith('bin_')]\n    cat_cols = [c for c in train.columns if c.startswith('cat_')]\n    \n    # Target\n    y_train = train['target'].values.astype(np.float32)\n    y_val = val['target'].values.astype(np.float32)\n    \n    X_train = train.drop(columns=['target'])\n    X_val = val.drop(columns=['target'])\n    X_test = test\n    \n    # Numerical: Median filling and scaling\n    for col in num_cols:\n        median = train[col].median()\n        if np.isnan(median):\n            median = 0.0\n        X_train[col] = X_train[col].fillna(median)\n        X_val[col] = X_val[col].fillna(median)\n        X_test[col] = X_test[col].fillna(median)\n    \n    scaler = StandardScaler()\n    X_train[num_cols] = scaler.fit_transform(X_train[num_cols])\n    X_val[num_cols] = scaler.transform(X_val[num_cols])\n    X_test[num_cols] = scaler.transform(X_test[num_cols])\n    \n    # Handle NaNs produced by StandardScaler (zero variance columns)\n    X_train = X_train.fillna(0)\n    X_val = X_val.fillna(0)\n    X_test = X_test.fillna(0)\n    \n    # Categorical: Label encoding\n    for col in cat_cols:\n        le = LabelEncoder()\n        all_vals = pd.concat([X_train[col], X_val[col], X_test[col]]).astype(str)\n        le.fit(all_vals)\n        X_train[col] = le.transform(X_train"]
[165.357488, "o", "cat << 'EOF' > train_model.py\r\n"]
[165.357551, "o", "\u001b[?2004l\r"]
[165.357587, "i", "[col].astype(str))\n        X_val[col] = le.transform(X_val[col].astype(str))\n        X_test[col] = le.transform(X_test[col].astype(str))\n        \n    # Binary\n    X_train[bin_cols] = X_train[bin_cols].astype(np.float32)\n    X_val[bin_cols] = X_val[bin_cols].astype(np.float32)\n    X_test[bin_cols] = X_test[bin_cols].astype(np.float32)\n    \n    return X_train.values.astype(np.float32), X_val.values.astype(np.float32), X_test.values.astype(np.float32), y_train, y_val\n\nclass TabularModel(nn.Module):\n    def __init__(self, input_dim):\n        super().__init__()\n        self.net = nn.Sequential(\n            nn.Linear(input_dim, 256),\n            nn.ReLU(),\n            nn.BatchNorm1d(256),\n            nn.Dropout(0.2),\n            nn.Linear(256, 128),\n            nn.ReLU(),\n            nn.BatchNorm1d(128),\n            nn.Dropout(0.2),\n            nn.Linear(128, 64),\n            nn.ReLU(),\n            nn.Linear(64, 1)\n            # Removed Sigmoid for BCEWithLogitsLoss\n        )\n    def forward(self, x):\n        return self.net(x)\n\ndef train():\n    train_df, val_df, test_df = load_data()\n    X_train, X_val, X_test, y_train, y_val = preprocess(train_df, val_df, test_df)\n    \n    # Trivial Baseline\n    train_mean = np.mean(y_train)\n    baseline_preds = np.full_like(y_val, train_mean)\n    try:\n        baseline_score = roc_auc_score(y_val, baseline_preds)\n    except ValueError:\n        baseline_score = 0.5\n    print(f'TRIVIAL_BASELINE_SCORE={baseline_score}')\n\n    # DataLoaders\n    train_ds = TensorDataset(torch.tensor(X_train), torch.tensor(y_train).view(-1, 1))\n    val_ds = TensorDataset(torch.tensor(X_val), torch.tensor(y_val).view(-1, 1))\n    train_loader = DataLoader(train_ds, batch_size=1024, shuffle=True)\n    val_loader = DataLoader(val_ds, batch_size=1024, shuffle=False)\n\n    model = TabularModel(X_train.shape[1]).to(DEVICE)\n    criterion = nn.BCEWithLogitsLoss()\n    optimizer = optim.Adam(model.parameters(), lr=1e-3)\n    \n    best_score = 0\n    patience = 15\n    no_improve = 0\n    epochs = 200\n    \n    for epoch in r"]
[165.357626, "o", "\u001b[?2004h> import pandas as pd\r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.357689, "o", "import numpy as np\r\n\u001b[?2004l\r"]
[165.357743, "o", "\u001b[?2004h"]
[165.357782, "o", "> import torch\r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.357816, "i", "ange(epochs):\n        model.train()\n        for xb, yb in train_loader:\n            xb, yb = xb.to(DEVICE), yb.to(DEVICE)\n            optimizer.zero_grad()\n            pred = model(xb)\n            loss = criterion(pred, yb)\n            loss.backward()\n            optimizer.step()\n        \n        model.eval()\n        val_logits = []\n        with torch.no_grad():\n            for xb, _ in val_loader:\n                xb = xb.to(DEVICE)\n                val_logits.extend(model(xb).cpu().numpy().flatten())\n        \n        # Convert logits to probabilities for ROC-AUC\n        val_preds = 1 / (1 + np.exp(-np.array(val_logits)))\n        score = roc_auc_score(y_val, val_preds)\n        print(f'Epoch {epoch+1}/{epochs}, VALIDATION_SCORE={score}')\n        \n        if score > best_score:\n            best_score = score\n            torch.save(model.state_dict(), 'best_model.pt')\n            no_improve = 0\n        else:\n            no_improve += 1\n            \n        if no_improve >= patience:\n            print('Early stopping triggered')\n            break\n\n    print(f'FINAL_VALIDATION_SCORE={best_score}')\n    \n    # Final predictions\n    model.load_state_dict(torch.load('best_model.pt'))\n    model.eval()\n    test_tensor = torch.tensor(X_test).to(DEVICE)\n    with torch.no_grad():\n        test_logits = model(test_tensor).cpu().numpy().flatten()\n        test_preds = 1 / (1 + np.exp(-test_logits))\n    \n    pd.DataFrame({'target': test_preds}).to_csv('/app/predictions.csv', index=False)\n    print('Predictions saved to /app/predictions.csv')\n\nif __name__ == '__main__':\n    train()\nEOF\n"]
[165.35785, "o", "import torch.nn as nn\r\n\u001b[?2004l\r\u001b[?2004h"]
[165.357902, "o", "> "]
[165.357969, "o", "import torch.optim as optim\r\n\u001b[?2004l\r"]
[165.358004, "o", "\u001b[?2004h> "]
[165.358223, "o", "from torch.utils.data import DataLoader, TensorDataset\r\n\u001b[?2004l\r"]
[165.358269, "o", "\u001b[?2004h> "]
[165.358425, "o", "from sklearn.metrics import roc_auc_score\r\n\u001b[?2004l\r"]
[165.358474, "o", "\u001b[?2004h> "]
[165.358709, "o", "from sklearn.preprocessing import StandardScaler, LabelEncoder\r\n\u001b[?2004l\r"]
[165.358746, "o", "\u001b[?2004h> "]
[165.358798, "o", "import time\r\n\u001b[?2004l\r"]
[165.358833, "o", "\u001b[?2004h"]
[165.358871, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.358959, "o", "# Hardware resolution\r\n\u001b[?2004l\r"]
[165.35899, "o", "\u001b[?2004h> "]
[165.359177, "o", "DEVICE = ('cuda' if torch.cuda.is_available()\r\n\u001b[?2004l\r"]
[165.359219, "o", "\u001b[?2004h> "]
[165.35948, "o", "          else 'mps' if torch.backends.mps.is_available() else 'cpu')\r\n\u001b[?2004l\r"]
[165.359514, "o", "\u001b[?2004h> "]
[165.359608, "o", "print('DEVICE=', DEVICE)\r\n\u001b[?2004l\r"]
[165.359644, "o", "\u001b[?2004h"]
[165.359674, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.359756, "o", "def load_data():\r\n\u001b[?2004l\r"]
[165.359791, "o", "\u001b[?2004h"]
[165.35982, "o", "> "]
[165.360432, "o", "    train = pd.read_csv('/app/data/train.csv')\r\n\u001b[?2004l\r"]
[165.360471, "o", "\u001b[?2004h"]
[165.360499, "o", "> "]
[165.360827, "o", "    val = pd.read_csv('/app/data/val.csv')\r\n\u001b[?2004l\r"]
[165.36087, "o", "\u001b[?2004h> "]
[165.361027, "o", "    test = pd.read_csv('/app/data/test.csv')\r\n\u001b[?2004l\r"]
[165.361061, "o", "\u001b[?2004h> "]
[165.361182, "o", "    return train, val, test\r\n\u001b[?2004l\r"]
[165.36122, "o", "\u001b[?2004h> "]
[165.361251, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.361374, "o", "def preprocess(train, val, test):\r\n\u001b[?2004l\r"]
[165.361404, "o", "\u001b[?2004h> "]
[165.361835, "o", "    num_cols = [c for c in train.columns if c.startswith('num_')]\r\n\u001b[?2004l\r"]
[165.361855, "o", "\u001b[?2004h> "]
[165.362126, "o", "    bin_cols = [c for c in train.columns if c.startswith('bin_')]\r\n\u001b[?2004l\r"]
[165.362148, "o", "\u001b[?2004h> "]
[165.362812, "o", "    cat_cols = [c for c in train.columns if c.startswith('cat_')]\r\n\u001b[?2004l\r"]
[165.362829, "o", "\u001b[?2004h> "]
[165.362864, "o", "    \r\n\u001b[?2004l\r"]
[165.362884, "o", "\u001b[?2004h> "]
[165.362954, "o", "    # Target\r\n\u001b[?2004l\r"]
[165.363115, "o", "\u001b[?2004h> "]
[165.363211, "o", "    y_train = train['target'].values.astype(np.float32)\r\n\u001b[?2004l\r"]
[165.363247, "o", "\u001b[?2004h> "]
[165.363463, "o", "    y_val = val['target'].values.astype(np.float32)\r\n\u001b[?2004l\r"]
[165.363498, "o", "\u001b[?2004h"]
[165.363531, "o", "> "]
[165.363568, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.363744, "o", "    X_train = train.drop(columns=['target'])\r\n\u001b[?2004l\r"]
[165.363784, "o", "\u001b[?2004h> "]
[165.363935, "o", "    X_val = val.drop(columns=['target'])\r\n\u001b[?2004l\r"]
[165.363971, "o", "\u001b[?2004h> "]
[165.36404, "o", "    X_test = test\r\n\u001b[?2004l\r"]
[165.364077, "o", "\u001b[?2004h> "]
[165.364117, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.364297, "o", "    # Numerical: Median filling and scaling\r\n\u001b[?2004l\r"]
[165.364333, "o", "\u001b[?2004h> "]
[165.364421, "o", "    for col in num_cols:\r\n\u001b[?2004l\r"]
[165.364455, "o", "\u001b[?2004h> "]
[165.366741, "o", "        median = train[col].median()\r\n\u001b[?2004l\r\u001b[?2004h>         if np.isnan(median):\r\n\u001b[?2004l\r\u001b[?2004h>             median = 0.0\r\n\u001b[?2004l\r\u001b[?2004h>         X_train[col] = X_train[col].fillna(median)\r\n\u001b[?2004l\r\u001b[?2004h>         X_val[col] = X_val[col].fillna(median)\r\n\u001b[?2004l\r\u001b[?2004h>         X_test[col] = X_test[col].fillna(median)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.366836, "o", "    scaler = StandardScaler()\r\n\u001b[?2004l\r"]
[165.366877, "o", "\u001b[?2004h> "]
[165.367116, "o", "    X_train[num_cols] = scaler.fit_transform(X_train[num_cols])\r\n\u001b[?2004l\r"]
[165.367153, "o", "\u001b[?2004h> "]
[165.367362, "o", "    X_val[num_cols] = scaler.transform(X_val[num_cols])\r\n\u001b[?2004l\r"]
[165.3674, "o", "\u001b[?2004h> "]
[165.367524, "o", "    X_test[num_cols] = scaler.transform(X_test[num_cols])\r\n\u001b[?2004l\r"]
[165.367567, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[165.367605, "o", "\u001b[?2004h> "]
[165.367725, "o", "    # Handle NaNs produced by StandardScaler (zero variance columns)\r\n\u001b[?2004l\r"]
[165.367766, "o", "\u001b[?2004h> "]
[165.367817, "o", "    X_train = X_train.fillna(0)\r\n\u001b[?2004l\r"]
[165.367854, "o", "\u001b[?2004h> "]
[165.367899, "o", "    X_val = X_val.fillna(0)\r\n\u001b[?2004l\r"]
[165.367933, "o", "\u001b[?2004h> "]
[165.367984, "o", "    X_test = X_test.fillna(0)\r\n\u001b[?2004l\r"]
[165.368019, "o", "\u001b[?2004h> "]
[165.368054, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.368123, "o", "    # Categorical: Label encoding\r\n\u001b[?2004l\r"]
[165.368165, "o", "\u001b[?2004h> "]
[165.368201, "o", "    for col in cat_cols:\r\n\u001b[?2004l\r"]
[165.368236, "o", "\u001b[?2004h> "]
[165.368282, "o", "        le = LabelEncoder()\r\n\u001b[?2004l\r"]
[165.368311, "o", "\u001b[?2004h> "]
[165.368462, "o", "        all_vals = pd.concat([X_train[col], X_val[col], X_test[col]]).astype(str)\r\n\u001b[?2004l\r"]
[165.368497, "o", "\u001b[?2004h> "]
[165.368544, "o", "        le.fit(all_vals)\r\n\u001b[?2004l\r"]
[165.368577, "o", "\u001b[?2004h> "]
[165.368684, "o", "        X_train[col] = le.transform(X_train[col].astype(str))\r\n\u001b[?2004l\r"]
[165.368726, "o", "\u001b[?2004h> "]
[165.368831, "o", "        X_val[col] = le.transform(X_val[col].astype(str))\r\n\u001b[?2004l\r"]
[165.368865, "o", "\u001b[?2004h> "]
[165.368969, "o", "        X_test[col] = le.transform(X_test[col].astype(str))\r\n\u001b[?2004l\r"]
[165.369003, "o", "\u001b[?2004h> "]
[165.369032, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.369069, "o", "    # Binary\r\n\u001b[?2004l\r"]
[165.369114, "o", "\u001b[?2004h> "]
[165.369217, "o", "    X_train[bin_cols] = X_train[bin_cols].astype(np.float32)\r\n\u001b[?2004l\r"]
[165.369253, "o", "\u001b[?2004h> "]
[165.369363, "o", "    X_val[bin_cols] = X_val[bin_cols].astype(np.float32)\r\n\u001b[?2004l\r\u001b[?2004h"]
[165.369399, "o", "> "]
[165.369506, "o", "    X_test[bin_cols] = X_test[bin_cols].astype(np.float32)\r\n\u001b[?2004l\r\u001b[?2004h"]
[165.369541, "o", ">     \r\n"]
[165.369572, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[165.369803, "o", "    return X_train.values.astype(np.float32), X_val.values.astype(np.float32), X_test.values.astype(np.float32), y_train, y_val\r\n\u001b[?2004l\r"]
[165.369844, "o", "\u001b[?2004h> \r\n"]
[165.369875, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[165.36992, "o", "class TabularModel(nn.Module):\r\n\u001b[?2004l\r"]
[165.369952, "o", "\u001b[?2004h> "]
[165.370014, "o", "    def __init__(self, input_dim):\r\n\u001b[?2004l\r"]
[165.37005, "o", "\u001b[?2004h> "]
[165.370104, "o", "        super().__init__()\r\n\u001b[?2004l\r"]
[165.370142, "o", "\u001b[?2004h> "]
[165.3702, "o", "        self.net = nn.Sequential(\r\n\u001b[?2004l\r"]
[165.370235, "o", "\u001b[?2004h> "]
[165.370301, "o", "            nn.Linear(input_dim, 256),\r\n\u001b[?2004l\r"]
[165.370337, "o", "\u001b[?2004h> "]
[165.370379, "o", "            nn.ReLU(),\r\n\u001b[?2004l\r"]
[165.370411, "o", "\u001b[?2004h> "]
[165.370464, "o", "            nn.BatchNorm1d(256),\r\n\u001b[?2004l\r"]
[165.3705, "o", "\u001b[?2004h> "]
[165.370553, "o", "            nn.Dropout(0.2),\r\n\u001b[?2004l\r"]
[165.370587, "o", "\u001b[?2004h> "]
[165.370644, "o", "            nn.Linear(256, 128),\r\n\u001b[?2004l\r"]
[165.370676, "o", "\u001b[?2004h> "]
[165.370744, "o", "            nn.ReLU(),\r\n\u001b[?2004l\r"]
[165.370762, "o", "\u001b[?2004h> "]
[165.370842, "o", "            nn.BatchNorm1d(128),\r\n\u001b[?2004l\r"]
[165.370876, "o", "\u001b[?2004h> "]
[165.370926, "o", "            nn.Dropout(0.2),\r\n\u001b[?2004l\r"]
[165.370962, "o", "\u001b[?2004h> "]
[165.371016, "o", "            nn.Linear(128, 64),\r\n\u001b[?2004l\r"]
[165.371055, "o", "\u001b[?2004h> "]
[165.371095, "o", "            nn.ReLU(),\r\n\u001b[?2004l\r"]
[165.371131, "o", "\u001b[?2004h> "]
[165.371178, "o", "            nn.Linear(64, 1)\r\n\u001b[?2004l\r"]
[165.371214, "o", "\u001b[?2004h> "]
[165.371307, "o", "            # Removed Sigmoid for BCEWithLogitsLoss\r\n\u001b[?2004l\r"]
[165.371343, "o", "\u001b[?2004h> "]
[165.371373, "o", "        )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.371432, "o", "    def forward(self, x):\r\n\u001b[?2004l\r"]
[165.371466, "o", "\u001b[?2004h> "]
[165.371514, "o", "        return self.net(x)\r\n\u001b[?2004l\r"]
[165.371549, "o", "\u001b[?2004h> \r\n"]
[165.371582, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[165.371616, "o", "def train():\r\n\u001b[?2004l\r\u001b[?2004h"]
[165.371647, "o", "> "]
[165.37171, "o", "    train_df, val_df, test_df = load_data()\r\n\u001b[?2004l\r"]
[165.371754, "o", "\u001b[?2004h> "]
[165.371908, "o", "    X_train, X_val, X_test, y_train, y_val = preprocess(train_df, val_df, test_df)\r\n\u001b[?2004l\r"]
[165.371944, "o", "\u001b[?2004h> "]
[165.371975, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.372015, "o", "    # Trivial Baseline\r\n\u001b[?2004l\r"]
[165.37205, "o", "\u001b[?2004h> "]
[165.372112, "o", "    train_mean = np.mean(y_train)\r\n\u001b[?2004l\r"]
[165.37215, "o", "\u001b[?2004h> "]
[165.372242, "o", "    baseline_preds = np.full_like(y_val, train_mean)\r\n\u001b[?2004l\r"]
[165.372276, "o", "\u001b[?2004h> "]
[165.372308, "o", "    try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.372429, "o", "        baseline_score = roc_auc_score(y_val, baseline_preds)\r\n\u001b[?2004l\r"]
[165.372463, "o", "\u001b[?2004h> "]
[165.372505, "o", "    except ValueError:\r\n\u001b[?2004l\r"]
[165.372537, "o", "\u001b[?2004h> "]
[165.372594, "o", "        baseline_score = 0.5\r\n\u001b[?2004l\r"]
[165.372629, "o", "\u001b[?2004h> "]
[165.372721, "o", "    print(f'TRIVIAL_BASELINE_SCORE={baseline_score}')\r\n"]
[165.372767, "o", "\u001b[?2004l\r\u001b[?2004h"]
[165.372797, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.372834, "o", "    # DataLoaders\r\n\u001b[?2004l\r"]
[165.372865, "o", "\u001b[?2004h> "]
[165.373008, "o", "    train_ds = TensorDataset(torch.tensor(X_train), torch.tensor(y_train).view(-1, 1))\r\n\u001b[?2004l\r"]
[165.373045, "o", "\u001b[?2004h> "]
[165.373192, "o", "    val_ds = TensorDataset(torch.tensor(X_val), torch.tensor(y_val).view(-1, 1))\r\n\u001b[?2004l\r"]
[165.373226, "o", "\u001b[?2004h> "]
[165.373353, "o", "    train_loader = DataLoader(train_ds, batch_size=1024, shuffle=True)\r\n\u001b[?2004l\r"]
[165.373391, "o", "\u001b[?2004h> "]
[165.373505, "o", "    val_loader = DataLoader(val_ds, batch_size=1024, shuffle=False)\r\n\u001b[?2004l\r"]
[165.373544, "o", "\u001b[?2004h> \r\n"]
[165.373577, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[165.373668, "o", "    model = TabularModel(X_train.shape[1]).to(DEVICE)\r\n\u001b[?2004l\r"]
[165.373718, "o", "\u001b[?2004h> "]
[165.373781, "o", "    criterion = nn.BCEWithLogitsLoss()\r\n\u001b[?2004l\r"]
[165.373817, "o", "\u001b[?2004h> "]
[165.373916, "o", "    optimizer = optim.Adam(model.parameters(), lr=1e-3)\r\n\u001b[?2004l\r"]
[165.373957, "o", "\u001b[?2004h> "]
[165.37399, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.374029, "o", "    best_score = 0\r\n\u001b[?2004l\r"]
[165.374062, "o", "\u001b[?2004h> "]
[165.374103, "o", "    patience = 15\r\n\u001b[?2004l\r"]
[165.374137, "o", "\u001b[?2004h> "]
[165.37418, "o", "    no_improve = 0\r\n\u001b[?2004l\r"]
[165.374213, "o", "\u001b[?2004h> "]
[165.374255, "o", "    epochs = 200\r\n\u001b[?2004l\r"]
[165.374289, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.374363, "o", "    for epoch in range(epochs):\r\n\u001b[?2004l\r"]
[165.374397, "o", "\u001b[?2004h> "]
[165.374431, "o", "        model.train()\r\n\u001b[?2004l\r"]
[165.374469, "o", "\u001b[?2004h> "]
[165.374529, "o", "        for xb, yb in train_loader:\r\n\u001b[?2004l\r"]
[165.374563, "o", "\u001b[?2004h> "]
[165.374651, "o", "            xb, yb = xb.to(DEVICE), yb.to(DEVICE)\r\n\u001b[?2004l\r"]
[165.374684, "o", "\u001b[?2004h> "]
[165.374749, "o", "            optimizer.zero_grad()\r\n\u001b[?2004l\r"]
[165.374784, "o", "\u001b[?2004h> "]
[165.374834, "o", "            pred = model(xb)\r\n\u001b[?2004l\r"]
[165.374873, "o", "\u001b[?2004h> "]
[165.374938, "o", "            loss = criterion(pred, yb)\r\n\u001b[?2004l\r"]
[165.374978, "o", "\u001b[?2004h> "]
[165.375019, "o", "            loss.backward()\r\n\u001b[?2004l\r"]
[165.375061, "o", "\u001b[?2004h> "]
[165.375113, "o", "            optimizer.step()\r\n\u001b[?2004l\r"]
[165.375148, "o", "\u001b[?2004h> "]
[165.375182, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.375226, "o", "        model.eval()\r\n\u001b[?2004l\r"]
[165.375264, "o", "\u001b[?2004h> "]
[165.375301, "o", "        val_logits = []\r\n\u001b[?2004l\r"]
[165.375341, "o", "\u001b[?2004h> "]
[165.375387, "o", "        with torch.no_grad():\r\n\u001b[?2004l\r"]
[165.375421, "o", "\u001b[?2004h> "]
[165.375487, "o", "            for xb, _ in val_loader:\r\n\u001b[?2004l\r"]
[165.375525, "o", "\u001b[?2004h> "]
[165.375583, "o", "                xb = xb.to(DEVICE)\r\n\u001b[?2004l\r"]
[165.375619, "o", "\u001b[?2004h> "]
[165.375749, "o", "                val_logits.extend(model(xb).cpu().numpy().flatten())\r\n\u001b[?2004l\r"]
[165.375784, "o", "\u001b[?2004h> "]
[165.375828, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h"]
[165.375863, "o", "> "]
[165.375926, "o", "        # Convert logits to probabilities for ROC-AUC\r\n\u001b[?2004l\r"]
[165.375966, "o", "\u001b[?2004h> "]
[165.376069, "o", "        val_preds = 1 / (1 + np.exp(-np.array(val_logits)))\r\n\u001b[?2004l\r"]
[165.376111, "o", "\u001b[?2004h> "]
[165.376194, "o", "        score = roc_auc_score(y_val, val_preds)\r\n\u001b[?2004l\r"]
[165.376244, "o", "\u001b[?2004h> "]
[165.376358, "o", "        print(f'Epoch {epoch+1}/{epochs}, VALIDATION_SCORE={score}')\r\n\u001b[?2004l\r"]
[165.376399, "o", "\u001b[?2004h> "]
[165.376431, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.376492, "o", "        if score > best_score:\r\n\u001b[?2004l\r"]
[165.376533, "o", "\u001b[?2004h> "]
[165.376583, "o", "            best_score = score\r\n\u001b[?2004l\r"]
[165.376621, "o", "\u001b[?2004h> "]
[165.376727, "o", "            torch.save(model.state_dict(), 'best_model.pt')\r\n\u001b[?2004l\r"]
[165.376773, "o", "\u001b[?2004h> "]
[165.376816, "o", "            no_improve = 0\r\n\u001b[?2004l\r"]
[165.376854, "o", "\u001b[?2004h> "]
[165.376887, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.376951, "o", "            no_improve += 1\r\n\u001b[?2004l\r"]
[165.376994, "o", "\u001b[?2004h> "]
[165.377027, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.377105, "o", "        if no_improve >= patience:\r\n\u001b[?2004l\r"]
[165.377145, "o", "\u001b[?2004h> "]
[165.377224, "o", "            print('Early stopping triggered')\r\n\u001b[?2004l\r"]
[165.37726, "o", "\u001b[?2004h> "]
[165.377293, "o", "            break\r\n\u001b[?2004l\r\u001b[?2004h"]
[165.377327, "o", "> \r\n\u001b[?2004l\r"]
[165.377362, "o", "\u001b[?2004h> "]
[165.377434, "o", "    print(f'FINAL_VALIDATION_SCORE={best_score}')\r\n\u001b[?2004l\r"]
[165.37748, "o", "\u001b[?2004h> "]
[165.377513, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.377548, "o", "    # Final predictions\r\n\u001b[?2004l\r"]
[165.377586, "o", "\u001b[?2004h> "]
[165.377679, "o", "    model.load_state_dict(torch.load('best_model.pt'))\r\n\u001b[?2004l\r"]
[165.377723, "o", "\u001b[?2004h"]
[165.377763, "o", "> "]
[165.377796, "o", "    model.eval()\r\n\u001b[?2004l\r"]
[165.377836, "o", "\u001b[?2004h> "]
[165.377925, "o", "    test_tensor = torch.tensor(X_test).to(DEVICE)\r\n\u001b[?2004l\r"]
[165.37796, "o", "\u001b[?2004h> "]
[165.378005, "o", "    with torch.no_grad():\r\n\u001b[?2004l\r"]
[165.378044, "o", "\u001b[?2004h> "]
[165.37816, "o", "        test_logits = model(test_tensor).cpu().numpy().flatten()\r\n\u001b[?2004l\r"]
[165.378196, "o", "\u001b[?2004h> "]
[165.378286, "o", "        test_preds = 1 / (1 + np.exp(-test_logits))\r\n\u001b[?2004l\r"]
[165.378331, "o", "\u001b[?2004h> "]
[165.378364, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.378513, "o", "    pd.DataFrame({'target': test_preds}).to_csv('/app/predictions.csv', index=False)\r\n\u001b[?2004l\r"]
[165.378559, "o", "\u001b[?2004h> "]
[165.378651, "o", "    print('Predictions saved to /app/predictions.csv')\r\n\u001b[?2004l\r"]
[165.378692, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[165.378736, "o", "\u001b[?2004h> "]
