[58.491093, "o", "    for col in cat_cols:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.491157, "o", "        le = LabelEncoder()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.491211, "o", "        # Combine all to ensure all categories are covered\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.491283, "o", "        all_vals = pd.concat([X_train[col], X_val[col], X_test[col]]).astype(str)\r\n\u001b[?2004l\r\u001b[?2004h"]
[58.491325, "o", "> "]
[58.491374, "o", "        le.fit(all_vals)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.491429, "o", "        X_train[col] = le.transform(X_train[col].astype(str))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.491501, "o", "        X_val[col] = le.transform(X_val[col].astype(str))\r\n\u001b[?2004l\r\u001b[?2004h"]
[58.491549, "o", "> "]
[58.491599, "o", "        X_test[col] = le.transform(X_test[col].astype(str))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.49165, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.491724, "o", "    # Binary: Just ensure they are float\r\n\u001b[?2004l\r\u001b[?2004h"]
[58.491778, "o", "> "]
[58.491841, "o", "    X_train[bin_cols] = X_train[bin_cols].astype(np.float32)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.491897, "o", "    X_val[bin_cols] = X_val[bin_cols].astype(np.float32)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.491952, "o", "    X_test[bin_cols] = X_test[bin_cols].astype(np.float32)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[58.491996, "o", "\u001b[?2004h> "]
[58.492124, "o", "    return X_train.values.astype(np.float32), X_val.values.astype(np.float32), X_test.values.astype(np.float32), y_train, y_val\r\n\u001b[?2004l\r"]
[58.492183, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.492244, "o", "class TabularModel(nn.Module):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.492295, "o", "    def __init__(self, input_dim):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.492357, "o", "        super().__init__()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.492407, "o", "        self.net = nn.Sequential(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.492441, "o", "            nn.Linear(input_dim, 256),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.492505, "o", "            nn.ReLU(),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.49256, "o", "            nn.BatchNorm1d(256),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.492611, "o", "            nn.Dropout(0.2),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.492673, "o", "            nn.Linear(256, 128),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.492734, "o", "            nn.ReLU(),\r\n\u001b[?2004l\r\u001b[?2004h>             nn.BatchNorm1d(128),\r\n\u001b[?2004l\r"]
[58.492776, "o", "\u001b[?2004h>             nn.Dropout(0.2),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.492866, "o", "            nn.Linear(128, 64),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.492925, "o", "            nn.ReLU(),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.492984, "o", "            nn.Linear(64, 1),\r\n\u001b[?2004l\r\u001b[?2004h>             nn.Sigmoid()\r\n\u001b[?2004l\r"]
[58.493019, "o", "\u001b[?2004h>         )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.493094, "o", "    def forward(self, x):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.493146, "o", "        return self.net(x)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def train():\r\n\u001b[?2004l\r"]
[58.4932, "o", "\u001b[?2004h> "]
[58.493251, "o", "    train_df, val_df, test_df = load_data()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.493311, "o", "    X_train, X_val, X_test, y_train, y_val = preprocess(train_df, val_df, test_df)\r\n\u001b[?2004l\r\u001b[?2004h"]
[58.493364, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.493389, "o", "    # Trivial Baseline\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.493453, "o", "    train_mean = np.mean(y_train)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.493518, "o", "    baseline_preds = np.full_like(y_val, train_mean)\r\n\u001b[?2004l\r\u001b[?2004h"]
[58.493564, "o", "> "]
[58.493612, "o", "    baseline_score = roc_auc_score(y_val, baseline_preds)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.493688, "o", "    print(f'TRIVIAL_BASELINE_SCORE={baseline_score}')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.493745, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.493795, "o", "    # DataLoaders\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.493856, "o", "    train_ds = TensorDataset(torch.tensor(X_train), torch.tensor(y_train).view(-1, 1))\r\n\u001b[?2004l\r\u001b[?2004h"]
[58.493909, "o", "> "]
[58.493967, "o", "    val_ds = TensorDataset(torch.tensor(X_val), torch.tensor(y_val).view(-1, 1))\r\n\u001b[?2004l\r\u001b[?2004h"]
[58.494015, "o", "> "]
[58.494067, "o", "    train_loader = DataLoader(train_ds, batch_size=1024, shuffle=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[58.494124, "o", "> "]
[58.494169, "o", "    val_loader = DataLoader(val_ds, batch_size=1024, shuffle=False)\r\n\u001b[?2004l\r"]
[58.494222, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.494268, "o", "    model = TabularModel(X_train.shape[1]).to(DEVICE)\r\n\u001b[?2004l\r\u001b[?2004h"]
[58.494316, "o", "> "]
[58.494363, "o", "    criterion = nn.BCELoss()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.494412, "o", "    optimizer = optim.Adam(model.parameters(), lr=1e-3)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.494468, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.494524, "o", "    best_score = 0\r\n\u001b[?2004l\r\u001b[?2004h>     patience = 10\r\n\u001b[?2004l\r"]
[58.494576, "o", "\u001b[?2004h>     no_improve = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.494638, "o", "    epochs = 200\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.494688, "o", "    for epoch in range(epochs):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.494757, "o", "        model.train()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.494807, "o", "        for xb, yb in train_loader:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.494868, "o", "            xb, yb = xb.to(DEVICE), yb.to(DEVICE)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.494918, "o", "            optimizer.zero_grad()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.494979, "o", "            pred = model(xb)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.495026, "o", "            loss = criterion(pred, yb)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.495103, "o", "            loss.backward()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.495153, "o", "            optimizer.step()\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.495215, "o", "        model.eval()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.495264, "o", "        val_preds = []\r\n\u001b[?2004l\r\u001b[?2004h>         with torch.no_grad():\r\n\u001b[?2004l\r"]
[58.495334, "o", "\u001b[?2004h> "]
[58.495393, "o", "            for xb, yb in val_loader:\r\n\u001b[?2004l\r\u001b[?2004h>                 xb = xb.to(DEVICE)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.495462, "o", "                val_preds.extend(model(xb).cpu().numpy().flatten())\r\n\u001b[?2004l\r"]
[58.495509, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[58.495578, "o", "\u001b[?2004h> "]
[58.495627, "o", "        score = roc_auc_score(y_val, val_preds)"]
[58.49674, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[58.496794, "o", "> "]
[58.496841, "o", "        print(f'Epoch {epoch+1}/{epochs}, VALIDATION_SCORE={score}')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.496908, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.496969, "o", "        if score > best_score:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.497019, "o", "            best_score = score\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.497072, "o", "            torch.save(model.state_dict(), 'best_model.pt')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.497126, "o", "            no_improve = 0\r\n\u001b[?2004l\r"]
[58.497178, "o", "\u001b[?2004h>         else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.497229, "o", "            no_improve += 1\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r"]
[58.49729, "o", "\u001b[?2004h>         if no_improve >= patience:\r\n"]
[58.497339, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[58.497403, "o", "            print('Early stopping triggered')\r\n\u001b[?2004l\r\u001b[?2004h>             break\r\n"]
[58.497454, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.497517, "o", "    print(f'FINAL_VALIDATION_SCORE={best_score}')\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[58.497574, "o", "\u001b[?2004h>     # Final predictions\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.497625, "o", "    model.load_state_dict(torch.load('best_model.pt'))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.497673, "o", "    model.eval()\r\n\u001b[?2004l\r\u001b[?2004h"]
[58.497754, "o", "> "]
[58.497813, "o", "    test_tensor = torch.tensor(X_test).to(DEVICE)\r\n\u001b[?2004l\r\u001b[?2004h>     with torch.no_grad():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.49787, "o", "        test_preds = model(test_tensor).cpu().numpy().flatten()\r\n\u001b[?2004l\r\u001b[?2004h"]
[58.497919, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.498009, "o", "    pd.DataFrame({'target': test_preds}).to_csv('/app/predictions.csv', index=False)\r\n\u001b[?2004l\r"]
[58.498078, "o", "\u001b[?2004h> "]
[58.498142, "o", "    print('Predictions saved to /app/predictions.csv')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[58.498204, "o", "\u001b[?2004h> if __name__ == '__main__':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.498271, "o", "    train()\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[58.50311, "o", "\u001b[?2004hroot@dffb7f5aec7f:/workspace# "]
[58.655787, "i", "python3 train_model.py\n"]
[58.65604, "o", "python3 train_model.py\r\n\u001b[?2004l\r"]
[60.884837, "o", "DEVICE= cpu\r\n"]
