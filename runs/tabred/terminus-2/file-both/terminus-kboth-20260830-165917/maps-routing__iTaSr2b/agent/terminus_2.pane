import pandas as pd
import numpy as np
from sklearn.metrics import mean_squared_error
import torch
from lightautoml.automl.presets.tabular_presets import TabularAutoML
from lightautoml.tasks import Task
import time

# Hardware resolution - REQUIRED
DEVICE = ('cuda' if torch.cuda.is_available()
          else 'mps' if torch.backends.mps.is_available() else 'cpu')
print('DEVICE=', DEVICE)

# Budget allocation
print('BUDGET_ALLOCATION: Exploration: 0, Training: 600s, Finalization: 300s')

# Load data
train_df_full = pd.read_csv('/app/data/train.csv')
val_df = pd.read_csv('/app/data/val.csv')
test_df = pd.read_csv('/app/data/test.csv')

TARGET_COLUMN = 'target'

# Trivial Baseline
train_median = train_df_full[TARGET_COLUMN].median()
trivial_preds = np.full(len(val_df), train_median)
trivial_rmse = np.sqrt(mean_squared_error(val_df[TARGET_COLUMN], trivial_preds))
print(f'TRIVIAL_BASELINE_RMSE={trivial_rmse}')

# Sample training data to ensure completion
train_df = train_df_full.sample(n=20000, random_state=42)

# LightAutoML Setup
task = Task('reg')
roles = {'target': TARGET_COLUMN}
# Short timeout for the sampled data
automl = TabularAutoML(task=task, timeout=600)

# Fit
print('Starting LightAutoML training on sample...')
automl.fit_predict(train_df, roles=roles)

# Predict on validation set
val_preds = automl.predict(val_df).data.reshape(-1)
val_rmse = np.sqrt(mean_squared_error(val_df[TARGET_COLUMN], val_preds))
print(f'VALIDATION_SCORE={val_rmse}')
print('MODEL_USED=', type(automl).__name__)

if val_rmse < trivial_rmse:
    print('Model beat the trivial baseline!')
else:
    print('Model failed to beat trivial baseline, using trivial predictions for submission.')

# Test Predictions
test_preds = automl.preVALIDATION_SCORE=0.16198250592873922
MODEL_USED= TabularAutoML
