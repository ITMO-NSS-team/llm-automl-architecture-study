cat << 'EOF' > solution.py
import pandas as pd
import numpy as np
from sklearn.metrics import mean_squared_error
import torch
from lightautoml.automl.presets.tabular_presets import TabularAutoML
from lightautoml.tasks import Task
import time

# Hardware resolution - REQUIRED
DEVICE = ('cuda' if torch.cuda.is_available()
          else 'mps' if torch.backends.mps.is_available() else 'cpu')
print('DEVICE=', DEVICE)

# Budget allocation
print('BUDGET_ALLOCATION: Exploration: 0, Training: 1200s, Finalization: 600s')

# Load data
train_df = pd.read_csv('/app/data/train.csv')
val_df = pd.read_csv('/app/data/val.csv')
test_df = pd.read_csv('/app/data/test.csv')

TARGET_COLUMN = 'target'

# Trivial Baseline
train_median = train_df[TARGET_COLUMN].median()
trivial_preds = np.full(len(val_df), train_median)
trivial_rmse = np.sqrt(mean_squared_error(val_df[TARGET_COLUMN], trivial_preds))
print(f'TRIVIAL_BASELINE_RMSE={trivial_rmse}')

# LightAutoML Setup
task = Task('reg')
roles = {'target': TARGET_COLUMN}
# Using a shorter timeout to ensure completion while still training
automl = TabularAutoML(task=task, timeout=1200)

# Fit and predict
print('Starting LightAutoML training...')
automl.fit_predict(train_df, roles=roles)

# Predict on validation set
val_preds = automl.predict(val_df).data.reshape(-1)
val_rmse = np.sqrt(mean_squared_error(val_df[TARGET_COLUMN], val_preds))
print(f'VALIDATION_SCORE={val_rmse}')
print('MODEL_USED=', type(automl).__name__)

if val_rmse < trivial_rmse:
    print('Model beat the trivial baseline!')
else:
    print('Model failed to beat trivial baseline, using trivial predictions.')

# Test Predictions
test_preds = automl.predict(test_df).data.reshape(-1)

# Sanity check
if np.isnan(test_preds).any() or np.isinf(test_preds).any():
    print('WARNING: Non-finite predictions detected!')
    test_preds = np.nan_to_num(test_preds, nan=train_median, posinf=train_median, neginf=train_median)

# Save predictions
submission = pd.DataFrame({'target': test_preds})
submission.to_csv('/app/predictions.csv', index=False)
print('Predictions saved to /app/predictions.csv')
EOF
python3 solution.py
