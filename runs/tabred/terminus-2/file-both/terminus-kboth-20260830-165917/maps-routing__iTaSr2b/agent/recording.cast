[2777.669886, "o", "\u001b[?2004hroot@90512b6ce747:/workspace# cat << 'EOF' > solution.py\r\n\u001b[?2004l\r\u001b[?2004h> import pandas as pd\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> from sklearn.metrics import mean_squared_error\r\n\u001b[?2004l\r\u001b[?2004h> import torch\r\n\u001b[?2004l\r\u001b[?2004h> from lightautoml.automl.presets.tabular_presets import TabularAutoML\r\n\u001b[?2004l\r\u001b[?2004h> from lightautoml.tasks import Task\r\n\u001b[?2004l\r\u001b[?2004h> import time\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Hardware resolution - REQUIRED\r\n\u001b[?2004l\r\u001b[?2004h> DEVICE = ('cuda' if torch.cuda.is_available()\r\n\u001b[?2004l\r\u001b[?2004h>           else 'mps' if torch.backends.mps.is_available() else 'cpu')\r\n\u001b[?2004l\r\u001b[?2004h> print('DEVICE=', DEVICE)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Budget allocation\r\n\u001b[?2004l\r\u001b[?2004h> print('BUDGET_ALLOCATION: Exploration: 0, Training: 1200s, Finalization: 600s')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Load data\r\n\u001b[?2004l\r\u001b[?2004h> train_df = pd.read_csv('/app/data/train.csv')\r\n\u001b[?2004l\r\u001b[?2004h> val_df = pd.read_csv('/app/data/val.csv')\r\n\u001b[?2004l\r\u001b[?2004h> test_df = pd.read_csv('/app/data/test.csv')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> TARGET_COLUMN = 'target'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Trivial Baseline\r\n\u001b[?2004l\r\u001b[?2004h> train_median = train_df[TARGET_COLUMN].median()\r\n\u001b[?2004l\r\u001b[?2004h> trivial_preds = np.full(len(val_df), train_median)\r\n\u001b[?2004l\r\u001b[?2004h> trivial_rmse = np.sqrt(mean_squared_error(val_df[TARGET_COLUMN], trivial_preds))\r\n\u001b[?2004l\r\u001b[?2004h> print(f'TRIVIAL_BASELINE_RMSE={trivial_rmse}')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # LightAutoML Setup\r\n\u001b[?2004l\r\u001b[?2004h> task = Task('reg')\r\n\u001b[?2004l\r\u001b[?2004h> roles = {'target': TARGET_COLUMN}\r\n\u001b[?2004l\r\u001b[?2004h> # Using a shorter timeout to ensure completion while still training\r\n\u001b[?2004l\r\u001b[?2004h> automl = TabularAutoML(task=task, timeout=1200)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Fit and predict\r\n\u001b[?2004l\r\u001b[?2004h> print('Starting LightAutoML training...')\r\n\u001b[?2004l\r\u001b[?2004h> automl.fit_predict(train_df, roles=roles)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Predict on validation set\r\n\u001b[?2004l\r\u001b[?2004h> val_preds = automl.predict(val_df).data.reshape(-1)\r\n\u001b[?2004l\r\u001b[?2004h> val_rmse = np.sqrt(mean_squared_error(val_df[TARGET_COLUMN], val_preds))\r\n\u001b[?2004l\r\u001b[?2004h> print(f'VALIDATION_SCORE={val_rmse}')\r\n\u001b[?2004l\r\u001b[?2004h> print('MODEL_USED=', type(automl).__name__)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> if val_rmse < trivial_rmse:\r\n\u001b[?2004l\r\u001b[?2004h>     print('Model beat the trivial baseline!')\r\n\u001b[?2004l\r\u001b[?2004h> else:\r\n\u001b[?2004l\r\u001b[?2004h>     print('Model failed to beat trivial baseline, using trivial predictions.')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Test Predictions\r\n\u001b[?2004l\r\u001b[?2004h> test_preds = automl.predict(test_df).data.reshape(-1)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Sanity check\r\n\u001b[?2004l\r\u001b[?2004h> if np.isnan(test_preds).any() or np.isinf(test_preds).any():\r\n\u001b[?2004l\r\u001b[?2004h>     print('WARNING: Non-finite predictions detected!')\r\n\u001b[?2004l\r\u001b[?2004h>     test_preds = np.nan_to_num(test_preds, nan=train_median, posinf=train_median, neginf=train_median)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Save predictions\r\n\u001b[?2004l\r\u001b[?2004h> submission = pd.DataFrame({'target': test_preds})\r\n\u001b[?2004l\r\u001b[?2004h> submission.to_csv('/app/predictions.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h> print('Predictions saved to /app/predictions.csv')\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r  test_preds = np.full(len(test_df), train_median)\r\n\r\n# Sanity check\r\nif np.isnan(test_preds).any() or np.isinf(test_preds).any():\r\n    print('WARNING: Non-finite predictions detected!')\r\n    test_preds = np.nan_to_num(test_preds, nan=train_median, posinf=train_median, neginf=train_median)\r\n\r\n# Save predictions\r\nsubmission = pd.DataFrame({'target': test_preds})\r\nsubmission.to_csv('/app/predictions.csv', index=False)\r\nprint('Predictions saved to /app/predictions.csv')\r\nEOF\r\npython3 solution.py\r\ncat << 'EOF' > solution.py\r\nimport pandas as pd\r\nimport numpy as np\r\nfrom sklearn.metrics import mean_squared_error\r\nimport torch\r\nfrom lightautoml.automl.presets.tabular_pre"]
[2777.670209, "o", "sets import TabularAutoML\r\nfrom lightautoml.tasks import Task\r\nimport time\r\n\r\n# Hardware resolution - REQUIRED\r\nDEVICE = ('cuda' if torch.cuda.is_available()\r\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\r\nprint('DEVICE=', DEVICE)\r\n\r\n# Budget allocation\r\nprint('BUDGET_ALLOCATION: Exploration: 0, Training: 600s, Finalization: 300s')\r\n\r\n# Load data\r\ntrain_df_full = pd.read_csv('/app/data/train.csv')\r\nval_df = pd.read_csv('/app/data/val.csv')\r\ntest_df = pd.read_csv('/app/data/test.csv')\r\n\r\nTARGET_COLUMN = 'target'\r\n\r\n# Trivial Baseline\r\ntrain_median = train_df_full[TARGET_COLUMN].median()\r\ntrivial_preds = np.full(len(val_df), train_median)\r\ntrivial_rmse = np.sqrt(mean_squared_error(val_df[TARGET_COLUMN], trivial_preds))\r\nprint(f'TRIVIAL_BASELINE_RMSE={trivial_rmse}')\r\n\r\n# Sample training data to ensure completion\r\ntrain_df = train_df_full.sample(n=20000, random_state=42)\r\n\r\n# LightAutoML Setup\r\ntask = Task('reg')\r\nroles = {'target': TARGET_COLUMN}\r\n# Short timeout for the sampled data\r\nautoml = TabularAutoML(task=task, timeout=600)\r\n\r\n# Fit\r\nprint('Starting LightAutoML training on sample...')\r\nautoml.fit_predict(train_df, roles=roles)\r\n\r\n# Predict on validation set\r\nval_preds = automl.predict(val_df).data.reshape(-1)\r\nval_rmse = np.sqrt(mean_squared_error(val_df[TARGET_COLUMN], val_preds))\r\nprint(f'VALIDATION_SCORE={val_rmse}')\r\nprint('MODEL_USED=', type(automl).__name__)\r\n\r\nif val_rmse < trivial_rmse:\r\n    print('Model beat the trivial baseline!')\r\nelse:\r\n    "]
