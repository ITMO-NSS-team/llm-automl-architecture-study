[1034.503673, "i", "cat << 'EOF' > solution.py\nimport pandas as pd\nimport numpy as np\nfrom sklearn.metrics import mean_squared_error\nimport torch\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\nfrom lightautoml.tasks import Task\nimport time\n\n# Hardware resolution - REQUIRED\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\n# Budget allocation\nprint('BUDGET_ALLOCATION: Exploration: 0, Training: 600s, Finalization: 300s')\n\n# Load data\ntrain_df_full = pd.read_csv('/app/data/train.csv')\nval_df = pd.read_csv('/app/data/val.csv')\ntest_df = pd.read_csv('/app/data/test.csv')\n\nTARGET_COLUMN = 'target'\n\n# Trivial Baseline\ntrain_median = train_df_full[TARGET_COLUMN].median()\ntrivial_preds = np.full(len(val_df), train_median)\ntrivial_rmse = np.sqrt(mean_squared_error(val_df[TARGET_COLUMN], trivial_preds))\nprint(f'TRIVIAL_BASELINE_RMSE={trivial_rmse}')\n\n# Sample training data to ensure completion\ntrain_df = train_df_full.sample(n=20000, random_state=42)\n\n# LightAutoML Setup\ntask = Task('reg')\nroles = {'target': TARGET_COLUMN}\n# Short timeout for the sampled data\nautoml = TabularAutoML(task=task, timeout=600)\n\n# Fit\nprint('Starting LightAutoML training on sample...')\nautoml.fit_predict(train_df, roles=roles)\n\n# Predict on validation set\nval_preds = automl.predict(val_df).data.reshape(-1)\nval_rmse = np.sqrt(mean_squared_error(val_df[TARGET_COLUMN], val_preds))\nprint(f'VALIDATION_SCORE={val_rmse}')\nprint('MODEL_USED=', type(automl).__name__)\n\nif val_rmse < trivial_rmse:\n    print('Model beat the trivial baseline!')\nelse:\n    print('Model failed to beat trivial baseline, using trivial predictions for submission.')\n\n# Test Predictions\ntest_preds = automl.predict(test_df).data.reshape(-1)\n\n# If model failed to beat baseline, we use the trivial predictor for the final submission\nif val_rmse >= trivial_rmse:\n    test_preds = np.full(len(test_df), train_median)\n\n# Sanity check\nif np.isnan(test_preds).any() or np.isinf(test_preds).any():\n    print('WARNING: Non-finite predictions detected!')\n    test_preds = np.nan_to_num(test_preds, nan=train_median, posinf=train_median, neginf=train_median)\n\n# Save predictions\nsubmission = pd.DataFrame({'target': test_preds})\nsubmission.to_csv('/app/predictions.csv', index=False)\nprint('Predictions saved to /app/predictions.csv')\nEOF\n"]
