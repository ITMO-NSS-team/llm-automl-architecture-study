[404.312654, "i", "cat << 'EOF' > solve.py\nimport pandas as pd\nimport numpy as np\nfrom sklearn.metrics import roc_auc_score\nimport torch\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\nfrom lightautoml.tasks import Task\n\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\nprint('BUDGET_ALLOCATION: Exploration: 10min, Training: 1h, Validation/Finalization: 30min')\n\ntrain_df = pd.read_csv('/app/data/train.csv')\nval_df = pd.read_csv('/app/data/val.csv')\ntest_df = pd.read_csv('/app/data/test.csv')\n\nTARGET_COLUMN = 'target'\n\nbaseline_pred = np.full(len(val_df), train_df[TARGET_COLUMN].mean())\nbaseline_score = roc_auc_score(val_df[TARGET_COLUMN], baseline_pred)\nprint(f'TRIVIAL_BASELINE_SCORE={baseline_score}')\n\ntask = Task('binary')\nroles = {'target': TARGET_COLUMN}\n\n# Reduced timeout to 1200s (20 mins) to ensure we get results and can iterate\nautoml = TabularAutoML(task=task, timeout=1200)\n\nautoml.fit_predict(train_df, roles=roles)\n\nval_preds = automl.predict(val_df).data.reshape(-1)\nval_score = roc_auc_score(val_df[TARGET_COLUMN], val_preds)\nprint(f'VALIDATION_SCORE={val_score}')\n\npred = automl.predict(test_df).data.reshape(-1)\n\nsubmission = pd.DataFrame({'target': pred})\nsubmission.to_csv('/app/predictions.csv', index=False)\n\nprint('MODEL_USED=', type(automl).__name__)\nEOF\n"]
[404.313033, "o", "cat << 'EOF' > solve.py\r\nimport pandas as pd\r\nimport numpy as np\r\nfrom sklearn.metrics import roc_auc_score\r\nimport torch\r\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\r\nfrom lightautoml.tasks import Task\r\n\r\nDEVICE = ('cuda' if torch.cuda.is_available()\r\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\r\nprint('DEVICE=', DEVICE)\r\n\r\nprint('BUDGET_ALLOCATION: Exploration: 10min, Training: 1h, Validation/Finalization: 30min')\r\n\r\ntrain_df = pd.read_csv('/app/data/train.csv')\r\nval_df = pd.read_csv('/app/data/val.csv')\r\ntest_df = pd.read_csv('/app/data/test.csv')\r\n\r\nTARGET_COLUMN = 'target'\r\n\r\nbaseline_pred = np.full(len(val_df), train_df[TARGET_COLUMN].mean())\r\nbaseline_score = roc_auc_score(val_df[TARGET_COLUMN], baseline_pred)\r\nprint(f'TRIVIAL_BASELINE_SCORE={baseline_score}')\r\n\r\ntask = Task('binary')\r\nroles = {'target': TARGET_COLUMN}\r\n\r\n# Reduced timeout to 1200s (20 mins) to ensure we get results and can iterate\r\nautoml = TabularAutoML(task=task, timeout=1200)\r\n\r\nautoml.fit_predict(train_df, roles=roles)\r\n\r\nval_preds = automl.predict(val_df).data.reshape(-1)\r\nval_score = roc_auc_score(val_df[TARGET_COLUMN], val_preds)\r\nprint(f'VALIDATION_SCORE={val_score}')\r\n\r\npred = automl.predict(test_df).data.reshape(-1)\r\n\r\nsubmission = pd.DataFrame({'target': pred})\r\nsubmission.to_csv('/app/predictions.csv', index=False)\r\n\r\nprint('MODEL_USED=', type(automl).__name__)\r\nEOF\r\n"]
