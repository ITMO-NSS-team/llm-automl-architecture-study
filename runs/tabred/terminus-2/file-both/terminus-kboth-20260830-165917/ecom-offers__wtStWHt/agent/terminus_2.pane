cat << 'EOF' > solve.py
import pandas as pd
import numpy as np
from sklearn.metrics import roc_auc_score
import torch
from lightautoml.automl.presets.tabular_presets import TabularAutoML
from lightautoml.tasks import Task

DEVICE = ('cuda' if torch.cuda.is_available()
          else 'mps' if torch.backends.mps.is_available() else 'cpu')
print('DEVICE=', DEVICE)

print('BUDGET_ALLOCATION: Exploration: 10min, Training: 1h, Validation/Finalization: 30min')

train_df = pd.read_csv('/app/data/train.csv')
val_df = pd.read_csv('/app/data/val.csv')
test_df = pd.read_csv('/app/data/test.csv')

TARGET_COLUMN = 'target'

baseline_pred = np.full(len(val_df), train_df[TARGET_COLUMN].mean())
baseline_score = roc_auc_score(val_df[TARGET_COLUMN], baseline_pred)
print(f'TRIVIAL_BASELINE_SCORE={baseline_score}')

task = Task('binary')
roles = {'target': TARGET_COLUMN}

# Reduced timeout to 1200s (20 mins) to ensure we get results and can iterate
automl = TabularAutoML(task=task, timeout=1200)

automl.fit_predict(train_df, roles=roles)

val_preds = automl.predict(val_df).data.reshape(-1)
val_score = roc_auc_score(val_df[TARGET_COLUMN], val_preds)
print(f'VALIDATION_SCORE={val_score}')

pred = automl.predict(test_df).data.reshape(-1)

submission = pd.DataFrame({'target': pred})
submission.to_csv('/app/predictions.csv', index=False)

print('MODEL_USED=', type(automl).__name__)
EOF
python3 solve.py
C-c
cat << 'EOF' > solve.py
import pandas as pd
import numpy as np
from sklearn.metrics import roc_auc_score
import torch
import sys
from lightautoml.automl.presets.tabular_presets import TabularAutoML
from lightautoml.tasks import Task

# Hardware requirement
DEVICE = ('cuda' if torch.cuda.is_available()
          else 'mps' if torch.backends.mps.is_available() else 'cpu')
print('DEVICE=', DEVICE)
sys.stdout.flush()

print('BUDGET_ALLOCATION: Exploration: 10min, Training: 1h, Validation/Finalization: 30min')
sys.stdout.flush()

print('Loading data...')
 train_df = pd.read_csv('/app/data/train.csv')
 val_df = pd.read_csv('/app/data/val.csv')
 test_df = pd.read_csv('/app/data/test.csv')
print('Data loaded.')
sys.stdout.flush()

TARGET_COLUMN = 'target'

baseline_pred = np.full(len(val_df), train_df[TARGET_COLUMN].mean())
baseline_score = roc_auc_score(val_df[TARGET_COLUMN], baseline_pred)
print(f'TRIVIAL_BASELINE_SCORE={baseline_score}')
sys.stdout.flush()

task = Task('binary')
roles = {'target': TARGET_COLUMN}

print('Initializing LightAutoML...')
automl = TabularAutoML(task=task, timeout=1200)
sys.stdout.flush()

print('Fitting model (this may take a while)...')
sys.stdout.flush()
automl.fit_predict(train_df, roles=roles)
print('Fitting complete.')
sys.stdout.flush()

print('Predicting on validation set...')
val_preds = automl.predict(val_df).data.reshape(-1)
val_score = roc_auc_score(val_df[TARGET_COLUMN], val_preds)
print(f'VALIDATION_SCORE={val_score}')
sys.stdout.flush()

print('Predicting on test set...')
pred = automl.predict(test_df).data.reshape(-1)

submission = pd.DataFrame({'target': pred})
submission.to_csv('/app/predictions.csv', index=False)
print('Predictions saved to /app/predictions.csv')
sys.stdout.flush()

print('MODEL_USED=', type(automl).__name__)
sys.stdout.flush()
EOF
