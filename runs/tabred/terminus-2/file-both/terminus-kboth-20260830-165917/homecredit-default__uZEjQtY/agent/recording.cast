[3009.829388, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[3009.829435, "o", "> "]
[3009.829454, "o", "# Budget Allocation\r\n\u001b[?2004l\r"]
[3009.8295, "o", "\u001b[?2004h> "]
[3009.829706, "o", "print('BUDGET_ALLOCATION: Exploration: 5m, Training: 1h, Finalization: 15m', flush=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[3009.829747, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[3009.829766, "o", "> # Load Data\r\n"]
[3009.829815, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[3009.829894, "o", "print('Loading data...', flush=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[3009.829937, "o", "> "]
[3009.830026, "o", "train_df = pd.read_csv('/app/data/train.csv')\r\n\u001b[?2004l\r"]
[3009.830063, "o", "\u001b[?2004h> "]
[3009.830167, "o", "val_df = pd.read_csv('/app/data/val.csv')\r\n\u001b[?2004l\r"]
[3009.830204, "o", "\u001b[?2004h> "]
[3009.830324, "o", "test_df = pd.read_csv('/app/data/test.csv')\r\n\u001b[?2004l\r"]
[3009.830372, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[3009.830416, "o", "TARGET_COLUMN = 'target'\r\n\u001b[?2004l\r"]
[3009.830451, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[3009.830484, "o", "> "]
[3009.830525, "o", "# Trivial Baseline\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3009.830661, "o", "print('Calculating trivial baseline...', flush=True)\r\n\u001b[?2004l\r"]
[3009.830699, "o", "\u001b[?2004h> "]
[3009.830793, "o", "train_mean = train_df[TARGET_COLUMN].mean()\r\n\u001b[?2004l\r"]
[3009.830832, "o", "\u001b[?2004h> "]
[3009.830948, "o", "trivial_pred = np.full(len(val_df), train_mean)\r\n\u001b[?2004l\r"]
[3009.830987, "o", "\u001b[?2004h> "]
[3009.831182, "o", "baseline_score = roc_auc_score(val_df[TARGET_COLUMN], trivial_pred)\r\n\u001b[?2004l\r\u001b[?2004h"]
[3009.831238, "o", "> "]
[3009.831345, "o", "print(f'TRIVIAL_BASELINE_SCORE={baseline_score}', flush=True)\r\n\u001b[?2004l\r"]
[3009.831383, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[3009.83143, "o", "> "]
[3009.831476, "o", "# LightAutoML Setup\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3009.831519, "o", "task = Task('binary')\r\n\u001b[?2004l\r\u001b[?2004h"]
[3009.831566, "o", "> "]
[3009.831618, "o", "roles = {'target': TARGET_COLUMN}\r\n\u001b[?2004l\r"]
[3009.83165, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[3009.831687, "o", "\u001b[?2004h> "]
[3009.831802, "o", "# Budget: 1 hour to ensure convergence and completion\r\n\u001b[?2004l\r"]
[3009.831848, "o", "\u001b[?2004h> "]
[3009.831896, "o", "TIME_BUDGET_SECONDS = 3600\r\n\u001b[?2004l\r\u001b[?2004h> "]
[3009.832083, "o", "automl = TabularAutoML(task=task, timeout=TIME_BUDGET_SECONDS)\r\n\u001b[?2004l\r\u001b[?2004h"]
[3009.832131, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[3009.832223, "o", "print('Training LightAutoML...', flush=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[3009.832274, "o", "> "]
[3009.833946, "o", "start_time = time.time()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Per skeleton\r\n\u001b[?2004l\r\u001b[?2004h> automl.fit_predict(train_df, roles=roles)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Predict on validation set\r\n\u001b[?2004l\r\u001b[?2004h> val_preds_obj = automl.predict(val_df)\r\n\u001b[?2004l\r\u001b[?2004h> val_preds = val_preds_obj.data.reshape(-1)\r\n\u001b[?2004l\r\u001b[?2004h> val_score = roc_auc_score(val_df[TARGET_COLUMN], val_preds)\r\n\u001b[?2004l\r\u001b[?2004h> print(f'VALIDATION_SCORE={val_score}', flush=True)\r\n\u001b[?2004l\r\u001b[?2004h> print(f'MODEL_USED={type(automl).__name__}', flush=True)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> if val_score <= baseline_score:\r\n\u001b[?2004l\r\u001b[?2004h>     print('Model did not beat baseline. Using trivial baseline for submission.', flush=True)\r\n\u001b[?2004l\r\u001b[?2004h>     test_preds = np.full(len(test_df), train_mean)\r\n\u001b[?2004l\r\u001b[?2004h> else:\r\n\u001b[?2004l\r\u001b[?2004h>     print('Model beat baseline. Generating test predictions...', flush=True)\r\n\u001b[?2004l\r\u001b[?2004h>     test_preds_obj = automl.predict(test_df)\r\n\u001b[?2004l\r\u001b[?2004h>     test_preds = test_preds_obj.data.reshape(-1)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Final submission\r\n\u001b[?2004l\r\u001b[?2004h> submission = pd.DataFrame({'target': test_preds})\r\n\u001b[?2004l\r\u001b[?2004h> submission.to_csv('/app/predictions.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h> print('Submission saved to /app/predictions.csv', flush=True)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(f'Total training time: {time.time() - start_time:.2f} seconds', flush=True)\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r[TARGET_COLUMN], trivial_pred)\r\nprint(f'TRIVIAL_BASELINE_SCORE={baseline_score}', flush=True)\r\n\r\ntask = Task('binary')\r\nroles = {'target': TARGET_COLUMN}\r\nautoml = TabularAutoML(task=task, timeout=600)\r\n\r\nprint('Training...', flush=True)\r\nautoml.fit_predict(train_df, roles=roles)\r\n\r\nval_preds = automl.predict(val_df).data.reshape(-1)\r\nval_score = roc_auc_score(val_df[TARGET_COLUMN], val_preds)\r\nprint(f'VALIDATION_SCORE={val_score}', flush=True)\r\nprint(f'MODEL_USED={type(automl).__name__}', flush=True)\r\n\r\nif val_score <= baseline_score:\r\n    test_preds = np.full(len(test_df), train_mean)\r\nelse:\r\n    test_preds = automl.predict(test_df).data.reshape(-1)\r\n\r\nsubmission = pd.DataFrame({'target': test_preds})\r\nsubmission.to_csv('/app/predictions.csv', index=False)\r\nprint('Saved predictions.csv', flush=True)\r\nEOF\r\npython3 solution.py\r\n\r\n\r\n\r\nC-c\r\ncat << 'EOF' > solution.py\r\nimport pandas as pd\r\nimport numpy as np\r\nimport torch\r\nfrom sklearn.metrics import roc_auc_score\r\nfrom lightautoml.automl.presets.tabular_pr"]
