[435.873193, "i", "cat << 'EOF' > solution.py\nimport pandas as pd\nimport numpy as np\nimport torch\nfrom sklearn.metrics import roc_auc_score\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\nfrom lightautoml.tasks import Task\nimport time\nimport sys\n\n# Hardware Resolution\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint(f'DEVICE={DEVICE}', flush=True)\n\n# Budget Allocation\nprint('BUDGET_ALLOCATION: Exploration: 5m, Training: 1h, Finalization: 15m', flush=True)\n\n# Load Data\nprint('Loading data...', flush=True)\ntrain_df = pd.read_csv('/app/data/train.csv')\nval_df = pd.read_csv('/app/data/val.csv')\ntest_df = pd.read_csv('/app/data/test.csv')\n\nTARGET_COLUMN = 'target'\n\n# Trivial Baseline\nprint('Calculating trivial baseline...', flush=True)\ntrain_mean = train_df[TARGET_COLUMN].mean()\ntrivial_pred = np.full(len(val_df), train_mean)\nbaseline_score = roc_auc_score(val_df[TARGET_COLUMN], trivial_pred)\nprint(f'TRIVIAL_BASELINE_SCORE={baseline_score}', flush=True)\n\n# LightAutoML Setup\ntask = Task('binary')\nroles = {'target': TARGET_COLUMN}\n\n# Budget: 1 hour to ensure convergence and completion\nTIME_BUDGET_SECONDS = 3600\nautoml = TabularAutoML(task=task, timeout=TIME_BUDGET_SECONDS)\n\nprint('Training LightAutoML...', flush=True)\nstart_time = time.time()\n\n# Per skeleton\nautoml.fit_predict(train_df, roles=roles)\n\n# Predict on validation set\nval_preds_obj = automl.predict(val_df)\nval_preds = val_preds_obj.data.reshape(-1)\nval_score = roc_auc_score(val_df[TARGET_COLUMN], val_preds)\nprint(f'VALIDATION_SCORE={val_score}', flush=True)\nprint(f'MODEL_USED={type(automl).__name__}', flush=True)\n\nif val_score <= baseline_score:\n    print('Model did not beat baseline. Using trivial baseline for submission.', flush=True)\n    test_preds = np.full(len(test_df), train_mean)\nelse:\n    print('Model beat baseline. Generating test predictions...', flush=True)\n    test_preds_obj = automl.predict(test_df)\n    test_preds = test_preds_obj.data.reshape(-1)\n\n# Final submission\nsubmission = pd.DataFrame({'target': test_preds})\nsubmission.to_csv('/app/predictions.csv', index=False)\nprint('Submission saved to /app/predictions.csv', flush=True)\n\nprint(f'Total training time: {time.time() - start_time:.2f} seconds', flush=True)\nEOF\n"]
[435.873765, "o", "cat << 'EOF' > solution.py\r\nimport pandas as pd\r\nimport numpy as np\r\nimport torch\r\nfrom sklearn.metrics import roc_auc_score\r\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\r\nfrom lightautoml.tasks import Task\r\nimport time\r\nimport sys\r\n\r\n# Hardware Resolution\r\nDEVICE = ('cuda' if torch.cuda.is_available()\r\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\r\nprint(f'DEVICE={DEVICE}', flush=True)\r\n\r\n# Budget Allocation\r\nprint('BUDGET_ALLOCATION: Exploration: 5m, Training: 1h, Finalization: 15m', flush=True)\r\n\r\n# Load Data\r\nprint('Loading data...', flush=True)\r\ntrain_df = pd.read_csv('/app/data/train.csv')\r\nval_df = pd.read_csv('/app/data/val.csv')\r\ntest_df = pd.read_csv('/app/data/test.csv')\r\n\r\nTARGET_COLUMN = 'target'\r\n\r\n# Trivial Baseline\r\nprint('Calculating trivial baseline...', flush=True)\r\ntrain_mean = train_df[TARGET_COLUMN].mean()\r\ntrivial_pred = np.full(len(val_df), train_mean)\r\nbaseline_score = roc_auc_score(val_df[TARGET_COLUMN], trivial_pred)\r\nprint(f'TRIVIAL_BASELINE_SCORE={baseline_score}', flush=True)\r\n\r\n# LightAutoML Setup\r\ntask = Task('binary')\r\nroles = {'target': TARGET_COLUMN}\r\n\r\n# Budget: 1 hour to ensure convergence and completion\r\nTIME_BUDGET_SECONDS = 3600\r\nautoml = TabularAutoML(task=task, timeout=TIME_BUDGET_SECONDS)\r\n\r\nprint('Training LightAutoML...', flush=True)\r\nstart_time = time.time()\r\n\r\n# Per skeleton\r\nautoml.fit_predict(train_df, roles=roles)\r\n\r\n# Predict on validation set\r\nval_preds_obj = automl.predict(val_df)\r\nval_preds = val_preds_obj.data.reshape(-1)\r\nval_score = roc_auc_score(val_df[TARGET_COLUMN], val_preds)\r\nprint(f'VALIDATION_SCORE={val_score}', flush=True)\r\nprint(f'MODEL_USED={type(automl).__name__}', flush=True)\r\n\r\nif val_score <= baseline_score:\r\n    print('Model did not beat baseline. Using trivial baseline for submission.', flush=True)\r\n    test_preds = np.full(len(test_df), train_mean)\r\nelse:\r\n    print('Model beat baseline. Generating test predictions...', flush=True)\r\n    test_preds_obj = automl.predict(test_df)\r\n    test_preds = test_preds_obj.data.reshape(-1)\r\n\r\n# Final submission\r\nsubmission = pd.DataFrame({'target': test_preds})\r\nsubmission.to_csv('/app/predictions.csv', index=False)\r\nprint('Submission saved to /app/predictions.csv', flush=True)\r\n\r\nprint(f'Total training time: {time.time() - start_time:.2f} seconds', flush=True)\r\nEOF\r\n"]
