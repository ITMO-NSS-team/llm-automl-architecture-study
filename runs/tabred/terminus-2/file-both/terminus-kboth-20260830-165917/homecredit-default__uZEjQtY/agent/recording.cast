[34.612225, "i", "cat << 'EOF' > solution.py\nimport pandas as pd\nimport numpy as np\nimport torch\nfrom sklearn.metrics import roc_auc_score\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\nfrom lightautoml.tasks import Task\nimport time\n\n# Hardware Resolution\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\n# Budget Allocation\nprint('BUDGET_ALLOCATION: Exploration: 10m, Training: 2h, Finalization: 30m')\n\n# Load Data\nprint('Loading data...')\ntrain_df = pd.read_csv('/app/data/train.csv')\nval_df = pd.read_csv('/app/data/val.csv')\ntest_df = pd.read_csv('/app/data/test.csv')\n\nTARGET_COLUMN = 'target'\n\n# Trivial Baseline\nprint('Calculating trivial baseline...')\ntrivial_pred = np.full(len(val_df), train_df[TARGET_COLUMN].mean())\nbaseline_score = roc_auc_score(val_df[TARGET_COLUMN], trivial_pred)\nprint(f'TRIVIAL_BASELINE_SCORE={baseline_score}')\n\n# LightAutoML Setup\ntask = Task('binary')\nroles = {'target': TARGET_COLUMN}\n\n# Increase timeout for convergence\nTIME_BUDGET_SECONDS = 3600 * 2 # 2 hours\nautoml = TabularAutoML(task=task, timeout=TIME_BUDGET_SECONDS)\n\nprint('Training LightAutoML...')\nstart_time = time.time()\n# fit_predict handles internal validation\n# We provide train_df and the roles mapping\n# LightAutoML usually manages its own internal split if not provided,\n# but we should use our provided val_df for the final check.\n\n# Fit the model on train_df\nautoml.fit(train_df, roles=roles)\n\n# Predict on validation set\nval_preds = automl.predict(val_df).data.reshape(-1)\nval_score = roc_auc_score(val_df[TARGET_COLUMN], val_preds)\nprint(f'VALIDATION_SCORE={val_score}')\nprint('MODEL_USED=', type(automl).__name__)\n\nif val_score <= baseline_score:\n    print('Model did not beat baseline. Using trivial baseline for submission.')\n    test_preds = np.full(len(test_df), train_df[TARGET_COLUMN].mean())\nelse:\n    print('Model beat baseline. Generating test predictions...')\n    test_preds = automl.predict(test_df).data.reshape(-1)\n\n# Final submission\nsubmission = pd.DataFrame({'target': test_preds})\nsubmission.to_csv('/app/predictions.csv', index=False)\nprint('Submission saved to /app/predictions.csv')\n\nprint(f'Total training time: {time.time() - start_time:.2f} seconds')\nEOF\n"]
