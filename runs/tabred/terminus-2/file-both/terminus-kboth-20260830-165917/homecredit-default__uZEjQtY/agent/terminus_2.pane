cat << 'EOF' > solution.py
import pandas as pd
import numpy as np
import torch
from sklearn.metrics import roc_auc_score
from lightautoml.automl.presets.tabular_presets import TabularAutoML
from lightautoml.tasks import Task
import time
import sys

# Hardware Resolution
DEVICE = ('cuda' if torch.cuda.is_available()
          else 'mps' if torch.backends.mps.is_available() else 'cpu')
print(f'DEVICE={DEVICE}', flush=True)

# Budget Allocation
print('BUDGET_ALLOCATION: Exploration: 5m, Training: 1h, Finalization: 15m', flush=True)

# Load Data
print('Loading data...', flush=True)
train_df = pd.read_csv('/app/data/train.csv')
val_df = pd.read_csv('/app/data/val.csv')
test_df = pd.read_csv('/app/data/test.csv')

TARGET_COLUMN = 'target'

# Trivial Baseline
print('Calculating trivial baseline...', flush=True)
train_mean = train_df[TARGET_COLUMN].mean()
trivial_pred = np.full(len(val_df), train_mean)
baseline_score = roc_auc_score(val_df[TARGET_COLUMN], trivial_pred)
print(f'TRIVIAL_BASELINE_SCORE={baseline_score}', flush=True)

# LightAutoML Setup
task = Task('binary')
roles = {'target': TARGET_COLUMN}

# Budget: 1 hour to ensure convergence and completion
TIME_BUDGET_SECONDS = 3600
automl = TabularAutoML(task=task, timeout=TIME_BUDGET_SECONDS)

print('Training LightAutoML...', flush=True)
start_time = time.time()

# Per skeleton
automl.fit_predict(train_df, roles=roles)

# Predict on validation set
val_preds_obj = automl.predict(val_df)
val_preds = val_preds_obj.data.reshape(-1)
val_score = roc_auc_score(val_df[TARGET_COLUMN], val_preds)
print(f'VALIDATION_SCORE={val_score}', flush=True)
print(f'MODEL_USED={type(automl).__name__}', flush=True)

if val_score <= baseline_score:
    print('Model did not beat baseline. Using trivial baseline for submission.', flush=True)
    test_preds = np.full(len(test_df), train_mean)
else:
    print('Model beat baseline. Generating test predictions...', flush=True)
    test_preds_obj = automl.predict(test_df)
    test_preds = test_preds_obj.data.reshape(-1)

# Final submission
submission = pd.DataFrame({'target': test_preds})
submission.to_csv('/app/predictions.csv', index=False)
print('Submission saved to /app/predictions.csv', flush=True)

print(f'Total training time: {time.time() - start_time:.2f} seconds', flush=True)
EOF
