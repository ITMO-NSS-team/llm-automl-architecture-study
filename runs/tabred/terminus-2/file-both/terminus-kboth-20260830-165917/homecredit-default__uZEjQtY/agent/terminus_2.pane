[?2004hroot@ac1e119daf73:/workspace# cat << 'EOF' > solution.py
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import torch
[?2004l[?2004h> from sklearn.metrics import roc_auc_score
[?2004l[?2004h> from lightautoml.automl.presets.tabular_presets import TabularAutoML
[?2004l[?2004h> from lightautoml.tasks import Task
[?2004l[?2004h> import time
[?2004l[?2004h> 
[?2004l[?2004h> # Hardware Resolution
[?2004l[?2004h> DEVICE = ('cuda' if torch.cuda.is_available()
[?2004l[?2004h>           else 'mps' if torch.backends.mps.is_available() else 'cpu')
[?2004l[?2004h> print('DEVICE=', DEVICE)
[?2004l[?2004h> 
[?2004l[?2004h> # Budget Allocation
[?2004l[?2004h> print('BUDGET_ALLOCATION: Exploration: 10m, Training: 2h, Finalization: 30m')
[?2004l[?2004h> 
[?2004l[?2004h> # Load Data
[?2004l[?2004h> print('Loading data...')
[?2004l[?2004h> train_df = pd.read_csv('/app/data/train.csv')
[?2004l[?2004h> val_df = pd.read_csv('/app/data/val.csv')
[?2004l[?2004h> test_df = pd.read_csv('/app/data/test.csv')
[?2004l[?2004h> 
[?2004l[?2004h> TARGET_COLUMN = 'target'
[?2004l[?2004h> 
[?2004l[?2004h> # Trivial Baseline
[?2004l[?2004h> print('Calculating trivial baseline...')
[?2004l[?2004h> trivial_pred = np.full(len(val_df), train_df[TARGET_COLUMN].mean())
[?2004l[?2004h> baseline_score = roc_auc_score(val_df[TARGET_COLUMN], trivial_pred)
[?2004l[?2004h> print(f'TRIVIAL_BASELINE_SCORE={baseline_score}')
[?2004l[?2004h> 
[?2004l[?2004h> # LightAutoML Setup
[?2004l[?2004h> task = Task('binary')
[?2004l[?2004h> roles = {'target': TARGET_COLUMN}
[?2004l[?2004h> 
[?2004l[?2004h> # Increase timeout for convergence
[?2004l[?2004h> TIME_BUDGET_SECONDS = 3600 * 2 # 2 hours
[?2004l[?2004h> automl = TabularAutoML(task=task, timeout=TIME_BUDGET_SECONDS)
[?2004l[?2004h> 
[?2004l[?2004h> print('Training LightAutoML...')
[?2004l[?2004h> start_time = time.time()
[?2004l[?2004h> # fit_predict handles internal validation
[?2004l[?2004h> # We provide train_df and the roles mapping
[?2004l[?2004h> # LightAutoML usually manages its own internal split if not provided,
[?2004l[?2004h> # but we should use our provided val_df for the final check.
[?2004l[?2004h> 
[?2004l[?2004h> # Fit the model on train_df
[?2004l[?2004h> automl.fit(train_df, roles=roles)
[?2004l[?2004h> 
[?2004l[?2004h> # Predict on validation set
[?2004l[?2004h> val_preds = automl.predict(val_df).data.reshape(-1)
[?2004l[?2004h> val_score = roc_auc_score(val_df[TARGET_COLUMN], val_preds)
[?2004l[?2004h> print(f'VALIDATION_SCORE={val_score}')
[?2004l[?2004h> print('MODEL_USED=', type(automl).__name__)
[?2004l[?2004h> 
[?2004l[?2004h> if val_score <= baseline_score:
[?2004l[?2004h>     print('Model did not beat baseline. Using trivial baseline for submission.')
[?2004l[?2004h>     test_preds = np.full(len(test_df), train_df[TARGET_COLUMN].mean())
[?2004l[?2004h> else:
[?2004l[?2004h>     print('Model beat baseline. Generating test predictions...')
[?2004l[?2004h>     test_preds = automl.predict(test_df).data.reshape(-1)
[?2004l[?2004h> 
[?2004l[?2004h> # Final submission
[?2004l[?2004h> submission = pd.DataFrame({'target': test_preds})
[?2004l[?2004h> submission.to_csv('/app/predictions.csv', index=False)
[?2004l[?2004h> print('Submission saved to /app/predictions.csv')
[?2004l[?2004h> 
[?2004l[?2004h> print(f'Total training time: {time.time() - start_time:.2f} seconds')
[?2004l[?2004h> EOF
