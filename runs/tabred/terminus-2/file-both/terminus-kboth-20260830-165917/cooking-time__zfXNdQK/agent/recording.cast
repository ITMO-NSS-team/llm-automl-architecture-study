[16.837702, "o", "\u001b[?2004hroot@a42e8356ff94:/workspace# "]
[57.674991, "i", "cat << 'EOF' > solution.py\nimport pandas as pd\nimport numpy as np\nfrom sklearn.metrics import mean_squared_error\nimport torch\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\nfrom lightautoml.tasks import Task\n\n# Resolve device\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\n# Budget allocation\nprint('BUDGET_ALLOCATION: Exploration: 0.1h, Training: 1h, Finalization: 0.1h')\n\n# Load data\ntrain_df = pd.read_csv('/app/data/train.csv')\nval_df = pd.read_csv('/app/data/val.csv')\ntest_df = pd.read_csv('/app/data/test.csv')\n\nTARGET_COLUMN = 'target'\n\n# Trivial baseline: Median\nmedian_val = train_df[TARGET_COLUMN].median()\nbaseline_preds = np.full(len(val_df), median_val)\nbaseline_rmse = np.sqrt(mean_squared_error(val_df[TARGET_COLUMN], baseline_preds))\nprint(f'BASELINE_RMSE={baseline_rmse}')\n\n# LightAutoML Setup\ntask = Task('reg')\nroles = {'target': TARGET_COLUMN}\n# Giving it 3600 seconds (1 hour) for training\nautoml = TabularAutoML(task=task, timeout=3600)\n\n# Fit and predict on train (internally uses some split, but we can use val for validation)\n# We use fit_predict on train_df\noof = automl.fit_predict(train_df, roles=roles)\n\n# Validate on val_df\nval_preds = automl.predict(val_df).data.reshape(-1)\nval_rmse = np.sqrt(mean_squared_error(val_df[TARGET_COLUMN], val_preds))\nprint(f'VALIDATION_SCORE={val_rmse}')\n\nif val_rmse < baseline_rmse:\n    print('Model beats baseline. Proceeding to test predictions.')\nelse:\n    print('Model failed to beat baseline. Using baseline for submission.')\n    test_preds = np.full(len(test_df), median_val)\n\n# Final predictions\nif val_rmse < baseline_rmse:\n    test_preds = automl.predict(test_df).data.reshape(-1)\n\n# Save predictions\nsubmission = pd.DataFrame({'target': test_preds})\nsubmission.to_csv('/app/predictions.csv', index=False)\n\nprint('MODEL_USED=', type(automl).__name__)\nEOF\n"]
