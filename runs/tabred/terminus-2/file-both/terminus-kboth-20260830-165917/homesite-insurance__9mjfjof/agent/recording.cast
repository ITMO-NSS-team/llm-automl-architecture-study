[26.758135, "i", "cat << 'EOF' > solution.py\nimport pandas as pd\nimport numpy as np\nfrom sklearn.metrics import roc_auc_score\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\nfrom lightautoml.tasks import Task\nimport torch\n\n# Hardware resolution\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\n# Time budget allocation\nprint('BUDGET: Exploration: 0.5h, Training: 2h, Finalization: 0.5h')\n\n# Load data\ntrain_df = pd.read_csv('/app/data/train.csv')\nval_df = pd.read_csv('/app/data/val.csv')\ntest_df = pd.read_csv('/app/data/test.csv')\n\nTARGET_COLUMN = 'target'\n\n# Trivial Baseline\n# Predict the mean of the training target for all validation samples\nbaseline_pred = np.full(len(val_df), train_df[TARGET_COLUMN].mean())\nbaseline_score = roc_auc_score(val_df[TARGET_COLUMN], baseline_pred)\nprint(f'TRIVIAL_BASELINE_SCORE={baseline_score}')\n\n# LightAutoML Setup\ntask = Task('binary')\nroles = {'target': TARGET_COLUMN}\ntime_budget = 3600  # 1 hour for training\nautoml = TabularAutoML(task=task, timeout=time_budget)\n\n# Fit and predict on train/val for OOF\n# LightAutoML handles the internal validation if we provide roles\n# but we want to evaluate specifically on our provided val_df.\n# The fit_predict method trains on the provided df.\n\n# To properly validate on val_df, we fit on train_df and predict on val_df\nautoml.fit(train_df, roles=roles)\nval_preds = automl.predict(val_df).data.reshape(-1)\nval_score = roc_auc_score(val_df[TARGET_COLUMN], val_preds)\nprint(f'VALIDATION_SCORE={val_score}')\nprint('MODEL_USED=', type(automl).__name__)\n\nif val_score > baseline_score:\n    print('Model beats baseline. Generating test predictions...')\n    test_preds = automl.predict(test_df).data.reshape(-1)\n    submission = pd.DataFrame({'target': test_preds})\n    submission.to_csv('/app/predictions.csv', index=False)\n    print('Predictions saved to /app/predictions.csv')\nelse:\n    print('Model did not beat baseline. Using baseline predictions for submission.')\n    test_preds = np.full(len(test_df), train_df[TARGET_COLUMN].mean())\n    submission = pd.DataFrame({'target': test_preds})\n    submission.to_csv('/app/predictions.csv', index=False)\n    print('Baseline predictions saved to /app/predictions.csv')\n\nEOF\n"]
