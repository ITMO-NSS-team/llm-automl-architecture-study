[93.931309, "o", "Traceback (most recent call last):\r\n  File \"/workspace/solution.py\", line 37, in <module>\r\n    automl.fit(train_df, roles=roles)\r\n    ^^^^^^^^^^\r\nAttributeError: 'TabularAutoML' object has no attribute 'fit'\r\n"]
[97.996172, "o", "\u001b[?2004hroot@fa8934815848:/workspace# "]
[159.49892, "i", "cat << 'EOF' > solution.py\nimport pandas as pd\nimport numpy as np\nimport torch\nfrom sklearn.metrics import roc_auc_score\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\nfrom lightautoml.tasks import Task\n\n# 1. Resolve compute device\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\n# Load data\ntrain_df = pd.read_csv('/app/data/train.csv')\nval_df = pd.read_csv('/app/data/val.csv')\ntest_df = pd.read_csv('/app/data/test.csv')\n\nTARGET_COLUMN = 'target'\n\n# 2. Trivial Baseline\nval_target = val_df[TARGET_COLUMN]\ntrain_mean = train_df[TARGET_COLUMN].mean()\nbaseline_preds = np.full(len(val_target), train_mean)\nbaseline_score = roc_auc_score(val_target, baseline_preds)\nprint(f'BASELINE_SCORE={baseline_score}')\n\n# 3. LightAutoML\ntask = Task('binary')\nroles = {'target': TARGET_COLUMN}\n# Using a generous timeout for convergence\nautoml = TabularAutoML(task=task, timeout=3600)\n\n# Fit and predict using fit_predict as required by API\noof = automl.fit_predict(train_df, roles=roles)\n\n# Predict on validation set\nval_preds = automl.predict(val_df).data.reshape(-1)\nval_score = roc_auc_score(val_target, val_preds)\nprint(f'VALIDATION_SCORE={val_score}')\n\nif val_score <= baseline_score:\n    print('Model did not beat baseline! Using baseline for submission.')\n    test_preds = np.full(len(test_df), train_mean)\nelse:\n    # Predict on test set\n    test_preds = automl.predict(test_df).data.reshape(-1)\n\n# 4. Final Submission\nsubmission = pd.DataFrame({'target': test_preds})\nsubmission.to_csv('/app/predictions.csv', index=False)\n\nprint('MODEL_USED=', type(automl).__name__)\nEOF\n"]
