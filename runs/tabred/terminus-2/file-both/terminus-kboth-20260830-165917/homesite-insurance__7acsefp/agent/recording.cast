[453.226218, "i", "cat << 'EOF' > test_fast.py\nimport pandas as pd\nimport torch\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\nfrom lightautoml.tasks import Task\nprint('DEVICE=', 'cuda' if torch.cuda.is_available() else 'cpu')\ntrain_df = pd.read_csv('/app/data/train.csv').head(1000)\ntest_df = pd.read_csv('/app/data/test.csv').head(100)\nautoml = TabularAutoML(task=Task('binary'), timeout=10)\nautoml.fit_predict(train_df, roles={'target': 'target'})\nprint('MODEL_USED=', type(automl).__name__)\nEOF\n"]
[453.227015, "o", "cat << 'EOF' > test_fast.py\r\nimport pandas as pd\r\nimport torch\r\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\r\nfrom lightautoml.tasks import Task\r\nprint('DEVICE=', 'cuda' if torch.cuda.is_available() else 'cpu')\r\ntrain_df = pd.read_csv('/app/data/train.csv').head(1000)\r\ntest_df = pd.read_csv('/app/data/test.csv').head(100)\r\nautoml = TabularAutoML(task=Task('binary'), timeout=10)\r\nautoml.fit_predict(train_df, roles={'target': 'target'})\r\nprint('MODEL_USED=', type(automl).__name__)\r\nEOF\r\n"]
