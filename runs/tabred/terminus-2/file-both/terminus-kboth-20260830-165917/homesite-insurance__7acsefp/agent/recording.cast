[118.317653, "i", "cat << 'EOF' > train.py\nimport pandas as pd\nimport numpy as np\nfrom sklearn.metrics import roc_auc_score\nimport torch\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\nfrom lightautoml.tasks import Task\n\n# Hardware - REQUIRED\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\n# Budget Allocation\nprint('BUDGET_ALLOCATION: Exploration: 0, Training: 3600s, Finalization: 300s')\n\n# Load data\ntrain_df = pd.read_csv('/app/data/train.csv')\nval_df = pd.read_csv('/app/data/val.csv')\ntest_df = pd.read_csv('/app/data/test.csv')\n\nTARGET_COLUMN = 'target'\n\n# Trivial Baseline\nval_targets = val_df[TARGET_COLUMN].values\ntrivial_preds = np.full(len(val_targets), train_df[TARGET_COLUMN].mean())\ntrivial_score = roc_auc_score(val_targets, trivial_preds)\nprint(f'TRIVIAL_SCORE={trivial_score}')\n\n# LightAutoML - Follow skeleton exactly\ntask = Task('binary')\nroles = {'target': TARGET_COLUMN}\nautoml = TabularAutoML(task=task, timeout=3600)\n\n# Fit and get OOF predictions\noof = automl.fit_predict(train_df, roles=roles)\n\n# Validate\nval_preds = automl.predict(val_df).data.reshape(-1)\nval_score = roc_auc_score(val_targets, val_preds)\nprint(f'VALIDATION_SCORE={val_score}')\nprint('MODEL_USED=', type(automl).__name__)\n\n# Predictions for test set\ntest_preds = automl.predict(test_df).data.reshape(-1)\nsubmission = pd.DataFrame({'target': test_preds})\nsubmission.to_csv('/app/predictions.csv', index=False)\n\nprint('Submission saved to /app/predictions.csv')\nEOF\n"]
