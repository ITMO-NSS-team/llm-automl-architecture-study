[570.16007, "i", "cat << 'EOF' > train_final.py\nimport pandas as pd\nimport numpy as np\nimport torch\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\nfrom lightautoml.tasks import Task\n\nDEVICE = ('cuda' if torch.cuda.is_available() else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\ntrain_df = pd.read_csv('/app/data/train.csv')\nval_df = pd.read_csv('/app/data/val.csv')\ntest_df = pd.read_csv('/app/data/test.csv')\n\ntask = Task('binary')\nroles = {'target': 'target'}\nautoml = TabularAutoML(task=task, timeout=1800)\nautoml.fit_predict(train_df, roles=roles)\n\ntest_preds = automl.predict(test_df).data.reshape(-1)\npd.DataFrame({'target': test_preds}).to_csv('/app/predictions.csv', index=False)\nprint('MODEL_USED=TabularAutoML')\nEOF\n"]
[570.160285, "o", "cat << 'EOF' > train_final.py\r\nimport pandas as pd\r\nimport numpy as np\r\nimport torch\r\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\r\nfrom lightautoml.tasks import Task\r\n\r\nDEVICE = ('cuda' if torch.cuda.is_available() else 'mps' if torch.backends.mps.is_available() else 'cpu')\r\nprint('DEVICE=', DEVICE)\r\n\r\ntrain_df = pd.read_csv('/app/data/train.csv')\r\nval_df = pd.read_csv('/app/data/val.csv')\r\ntest_df = pd.read_csv('/app/data/test.csv')\r\n\r\ntask = Task('binary')\r\nroles = {'target': 'target'}\r\nautoml = TabularAutoML(task=task, timeout=1800)\r\nautoml.fit_predict(train_df, roles=roles)\r\n\r\ntest_preds = automl.predict(test_df).data.reshape(-1)\r\npd.DataFrame({'target': test_preds}).to_csv('/app/predictions.csv', index=False)\r\nprint('MODEL_USED=TabularAutoML')\r\nEOF\r\n"]
[570.293309, "i", "nohup python3 train_final.py > final.log 2>&1 &\n"]
