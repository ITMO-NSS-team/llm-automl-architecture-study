[2050.639161, "o", "\u001b[?2004hroot@118043fbc990:/workspace# cat << 'EOF' > solution.py\r\n\u001b[?2004l\r\u001b[?2004h> import pandas as pd\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> from sklearn.metrics import mean_squared_error\r\n\u001b[?2004l\r\u001b[?2004h> import torch\r\n\u001b[?2004l\r\u001b[?2004h> from lightautoml.automl.presets.tabular_presets import TabularAutoML\r\n\u001b[?2004l\r\u001b[?2004h> from lightautoml.tasks import Task\r\n\u001b[?2004l\r\u001b[?2004h> import sys\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Hardware resolution\r\n\u001b[?2004l\r\u001b[?2004h> DEVICE = ('cuda' if torch.cuda.is_available()\r\n\u001b[?2004l\r\u001b[?2004h>           else 'mps' if torch.backends.mps.is_available() else 'cpu')\r\n\u001b[?2004l\r\u001b[?2004h> print('DEVICE=', DEVICE)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Budget allocation\r\n\u001b[?2004l\r\u001b[?2004h> print('BUDGET_ALLOCATION: Exploration: 5m, Training: 25m, Finalization: 5m')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Load data\r\n\u001b[?2004l\r\u001b[?2004h> train_df = pd.read_csv('/app/data/train.csv')\r\n\u001b[?2004l\r\u001b[?2004h> val_df = pd.read_csv('/app/data/val.csv')\r\n\u001b[?2004l\r\u001b[?2004h> test_df = pd.read_csv('/app/data/test.csv')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> target_col = 'target'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Trivial Baseline\r\n\u001b[?2004l\r\u001b[?2004h> y_train = train_df[target_col]\r\n\u001b[?2004l\r\u001b[?2004h> y_val = val_df[target_col]\r\n\u001b[?2004l\r\u001b[?2004h> baseline_pred = np.full(shape=y_val.shape, fill_value=y_train.median())\r\n\u001b[?2004l\r\u001b[?2004h> baseline_rmse = np.sqrt(mean_squared_error(y_val, baseline_pred))"]
[2050.642126, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2050.642701, "o", "print(f'BASELINE_SCORE={baseline_rmse}')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # LightAutoML setup\r\n\u001b[?2004l\r\u001b[?2004h> task = Task('reg')\r\n\u001b[?2004l\r\u001b[?2004h> roles = {target_col: 'target'}\r\n\u001b[?2004l\r\u001b[?2004h> # Reduce timeout to 1800s (30m) to avoid excessive hanging\r\n\u001b[?2004l\r\u001b[?2004h> automl = TabularAutoML(task=task, timeout=1800)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print('Starting fit_predict...')\r\n\u001b[?2004l\r\u001b[?2004h> _ = automl.fit_predict(train_df, roles=roles)\r\n\u001b[?2004l\r\u001b[?2004h> print('fit_predict completed.')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Predict on validation set\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2050.643138, "o", "print('Predicting on validation set...')\r\n\u001b[?2004l\r\u001b[?2004h> val_preds = automl.predict(val_df).data.reshape(-1)\r\n\u001b[?2004l\r\u001b[?2004h> val_rmse = np.sqrt(mean_squared_error(y_val, val_preds))\r\n\u001b[?2004l\r\u001b[?2004h> print(f'VALIDATION_SCORE={val_rmse}')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Check if it beats baseline\r\n\u001b[?2004l\r\u001b[?2004h> if val_rmse < baseline_rmse:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2050.644142, "o", "    print('Model beat baseline. Proceeding to test predictions.')\r\n\u001b[?2004l\r\u001b[?2004h>     test_preds = automl.predict(test_df).data.reshape(-1)\r\n\u001b[?2004l\r\u001b[?2004h>     submission = pd.DataFrame({'target': test_preds})\r\n\u001b[?2004l\r\u001b[?2004h>     submission.to_csv('/app/predictions.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h> else:\r\n\u001b[?2004l\r\u001b[?2004h>     print('Model did not beat baseline. Using baseline for submission.')\r\n\u001b[?2004l\r\u001b[?2004h>     test_preds = np.full(shape=test_df.shape[0], fill_value=y_train.median())\r\n\u001b[?2004l\r\u001b[?2004h>     submission = pd.DataFrame({'target': test_preds})\r\n\u001b[?2004l\r\u001b[?2004h>     submission.to_csv('/app/predictions.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print('MODEL_USED=', type(automl).__name__)\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
