[14.163336, "o", "\u001b[?2004hroot@118043fbc990:/workspace# "]
[39.957382, "i", "cat << 'EOF' > solution.py\nimport pandas as pd\nimport numpy as np\nfrom sklearn.metrics import mean_squared_error\nimport torch\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\nfrom lightautoml.tasks import Task\n\n# Hardware resolution\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\n# Budget allocation\nprint('BUDGET_ALLOCATION: Exploration: 5m, Training: 50m, Finalization: 5m')\n\n# Load data\ntrain_df = pd.read_csv('/app/data/train.csv')\nval_df = pd.read_csv('/app/data/val.csv')\ntest_df = pd.read_csv('/app/data/test.csv')\n\ntarget_col = 'target'\nx_train = train_df.drop(columns=[target_col])\ny_train = train_df[target_col]\nx_val = val_df.drop(columns=[target_col])\ny_val = val_df[target_col]\n\n# Trivial Baseline\nbaseline_pred = np.full(shape=y_val.shape, fill_value=y_train.median())\nbaseline_rmse = np.sqrt(mean_squared_error(y_val, baseline_pred))\nprint(f'BASELINE_SCORE={baseline_rmse}')\n\n# LightAutoML setup\ntask = Task('reg')\nroles = {target_col: 'target'}\n# Budget for training - 3600 seconds (1 hour)\nautoml = TabularAutoML(task=task, timeout=3600)\n\n# Fit and predict on validation set\n# fit_predict returns the OOF predictions for the train set\n# We use fit to train, then predict for validation\nautoml.fit(train_df, roles=roles)\nval_preds = automl.predict(val_df).data.reshape(-1)\nval_rmse = np.sqrt(mean_squared_error(y_val, val_preds))\nprint(f'VALIDATION_SCORE={val_rmse}')\n\n# Check if it beats baseline\nif val_rmse < baseline_rmse:\n    print('Model beat baseline. Proceeding to test predictions.')\n    test_preds = automl.predict(test_df).data.reshape(-1)\n    submission = pd.DataFrame({'target': test_preds})\n    submission.to_csv('/app/predictions.csv', index=False)\nelse:\n    print('Model did not beat baseline. Using baseline for submission.')\n    test_preds = np.full(shape=test_df.shape[0], fill_value=y_train.median())\n    submission = pd.DataFrame({'target': test_preds})\n    submission.to_csv('/app/predictions.csv', index=False)\n\nprint('MODEL_USED=', type(automl).__name__)\nEOF\n"]
