[470.930827, "i", "cat << 'EOF' > solution.py\nimport pandas as pd\nimport numpy as np\nfrom sklearn.metrics import mean_squared_error\nimport torch\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\nfrom lightautoml.tasks import Task\n\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\ntrain_df = pd.read_csv('/app/data/train.csv')\nval_df = pd.read_csv('/app/data/val.csv')\ntest_df = pd.read_csv('/app/data/test.csv')\n\nTARGET_COLUMN = 'target'\n\ntrivial_val_preds = np.full(len(val_df), train_df[TARGET_COLUMN].median())\ntrivial_rmse = np.sqrt(mean_squared_error(val_df[TARGET_COLUMN], trivial_val_preds))\nprint(f'TRIVIAL_BASELINE_RMSE={trivial_rmse}')\n\ntask = Task('reg')\nroles = {'target': TARGET_COLUMN}\nautoml = TabularAutoML(task=task, timeout=600)\n\nautoml.fit_predict(train_df, roles=roles)\n\nval_preds = automl.predict(val_df).data.reshape(-1)\nval_rmse = np.sqrt(mean_squared_error(val_df[TARGET_COLUMN], val_preds))\nprint(f'VALIDATION_SCORE={val_rmse}')\nprint('MODEL_USED=', type(automl).__name__)\n\nif val_rmse < trivial_rmse:\n    print('Model beat baseline!')\n    test_preds = automl.predict(test_df).data.reshape(-1)\n    submission = pd.DataFrame({'target': test_preds})\n    submission.to_csv('/app/predictions.csv', index=False)\nelse:\n    print('Model did not beat baseline, using trivial predictor')\n    test_preds = np.full(len(test_df), train_df[TARGET_COLUMN].median())\n    submission = pd.DataFrame({'target': test_preds})\n    submission.to_csv('/app/predictions.csv', index=False)\nEOF\n"]
[470.931058, "o", "cat << 'EOF' > solution.py\r\nimport pandas as pd\r\nimport numpy as np\r\nfrom sklearn.metrics import mean_squared_error\r\nimport torch\r\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\r\nfrom lightautoml.tasks import Task\r\n\r\nDEVICE = ('cuda' if torch.cuda.is_available()\r\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\r\nprint('DEVICE=', DEVICE)\r\n\r\ntrain_df = pd.read_csv('/app/data/train.csv')\r\nval_df = pd.read_csv('/app/data/val.csv')\r\ntest_df = pd.read_csv('/app/data/test.csv')\r\n\r\nTARGET_COLUMN = 'target'\r\n\r\ntrivial_val_preds = np.full(len(val_df), train_df[TARGET_COLUMN].median())\r\ntrivial_rmse = np.sqrt(mean_squared_error(val_df[TARGET_COLUMN], trivial_val_preds))\r\nprint(f'TRIVIAL_BASELINE_RMSE={trivial_rmse}')\r\n\r\ntask = Task('reg')\r\nroles = {'target': TARGET_COLUMN}\r\nautoml = TabularAutoML(task=task, timeout=600)\r\n\r\nautoml.fit_predict(train_df, roles=roles)\r\n\r\nval_preds = automl.predict(val_df).data.reshape(-1)\r\nval_rmse = np.sqrt(mean_squared_error(val_df[TARGET_COLUMN], val_preds))\r\nprint(f'VALIDATION_SCORE={val_rmse}')\r\nprint('MODEL_USED=', type(automl).__name__)\r\n\r\nif val_rmse < trivial_rmse:\r\n    print('Model beat baseline!')\r\n    test_preds = automl.predict(test_df).data.reshape(-1)\r\n    submission = pd.DataFrame({'target': test_preds})\r\n    submission.to_csv('/app/predictions.csv', index=False)\r\nelse:\r\n    print('Model did not beat baseline, using trivial predictor')\r\n    test_preds = np.full(len(test_df), train_df[TARGET_COLUMN].median())\r\n    submission = pd.DataFrame({'target': test_preds})\r\n    submission.to_csv('/app/predictions.csv', index=False)\r\nEOF\r\n"]
