 \"num_94\",\r\n    \"num_95\",\r\n    \"num_96\",\r\n    \"num_97\",\r\n    \"num_98\",\r\n    \"num_99\",\r\n    \"num_100\",\r\n    \"num_101\",\r\n    \"num_102\",\r\n    \"num_103\",\r\n    \"num_104\",\r\n    \"num_105\",\r\n    \"num_106\",\r\n    \"num_107\",\r\n    \"num_108\",\r\n    \"num_109\",\r\n    \"num_110\",\r\n    \"num_111\",\r\n    \"num_112\",\r\n    \"num_113\",\r\n    \"num_114\",\r\n    \"num_115\",\r\n    \"num_116\",\r\n    \"num_117\",\r\n    \"num_118\",\r\n    \"num_119\",\r\n    \"num_120\",\r\n    \"num_121\",\r\n    \"num_122\",\r\n    \"num_123\",\r\n    \"num_124\",\r\n    \"num_125\",\r\n    \"num_126\",\r\n    \"num_127\",\r\n    \"num_128\",\r\n    \"num_129\",\r\n    \"num_130\",\r\n    \"num_131\",\r\n    \"num_132\",\r\n    \"num_133\",\r\n    \"num_134\",\r\n    \"num_135\",\r\n    \"num_136\",\r\n    \"num_137\",\r\n    \"num_138\",\r\n    \"num_139\",\r\n    \"num_140\",\r\n    \"num_141\",\r\n    \"num_142\",\r\n    \"num_143\",\r\n    \"num_144\",\r\n    \"num_145\",\r\n    \"num_146\",\r\n    \"num_147\",\r\n    \"num_148\",\r\n    \"num_149\",\r\n    \"num_150\",\r\n    \"num_151\",\r\n    \"num_152\",\r\n    \"num_153\",\r\n    \"num_154\",\r\n    \"num_155\",\r\n    \"num_156\",\r\n    \"num_157\",\r\n    \"num_158\",\r\n    \"num_159\",\r\n    \"num_160\",\r\n    \"num_161\",\r\n    \"num_162\",\r\n    \"num_163\",\r\n    \"num_164\",\r\n    \"num_165\",\r\n    \"num_166\",\r\n    \"num_167\",\r\n    \"num_168\",\r\n    \"num_169\",\r\n    \"num_170\",\r\n    \"num_171\",\r\n    \"num_172\",\r\n    \"num_173\",\r\n    \"num_174\",\r\n    \"num_175\",\r\n    \"num_176\",\r\n    \"num_177\",\r\n    \"num_178\",\r\n    \"num_179\",\r\n    \"num_180\",\r\n    \"num_181\",\r\n    \"num_182\",\r\n    \"num_183\",\r\n    \"num_184\",\r\n    \"num_185\",\r\n    \"bin_0\",\r\n    \"bin_1\",\r\n    \"bin_2\",\r\n    \"cat_0\",\r\n    \"cat_1\",\r\n    \"cat_2\"\r\n  ],\r\n  \"feature_counts\": {\r\n    \"num\": 186,\r\n    \"bin\": 3,\r\n    \"cat\": 3\r\n  },\r\n  \"split_sizes\": {\r\n    \"train\": 227087,\r\n    \"val\": 51251,\r\n    \"test\": 41648\r\n  },\r\n  \"excluded_arrays\": [\r\n    \"x_meta.npy\"\r\n  ]\r\n}\r\n"]
[19.872146, "o", "\u001b[?2004hroot@61e5d4b00731:/workspace# "]
[62.559704, "i", "cat << 'EOF' > solution.py\nimport torch\nimport pandas as pd\nimport numpy as np\nfrom sklearn.metrics import mean_squared_error\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\nfrom lightautoml.tasks import Task\n\n# Time budget allocation\nprint('BUDGET_ALLOCATION: Exploration: 10min, Training: 2h, Improvement: 1h, Finalization: 20min')\n\n# Hardware resolve\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\n# Load data\ntrain_df = pd.read_csv('/app/data/train.csv')\nval_df = pd.read_csv('/app/data/val.csv')\ntest_df = pd.read_csv('/app/data/test.csv')\n\nTARGET_COLUMN = 'target'\n\n# Trivial Baseline\ntrain_median = train_df[TARGET_COLUMN].median()\nval_preds_trivial = np.full(len(val_df), train_median)\ntrivial_rmse = np.sqrt(mean_squared_error(val_df[TARGET_COLUMN], val_preds_trivial))\nprint(f'TRIVIAL_BASELINE_RMSE={trivial_rmse}')\n\n# LightAutoML setup\ntask = Task('reg')\nroles = {'target': TARGET_COLUMN}\n# Using a reasonable timeout for convergence\nautoml = TabularAutoML(task=task, timeout=3600)\n\n# Fit and predict on validation for OOF score\n# LightAutoML internally handles splitting if we provide a validation set, \n# but for simplicity we fit on train and evaluate on val\nautoml.fit_predict(train_df, roles=roles)\n\nval_preds = automl.predict(val_df).data.reshape(-1)\nval_rmse = np.sqrt(mean_squared_error(val_df[TARGET_COLUMN], val_preds))\nprint(f'VALIDATION_SCORE={val_rmse}')\n\n# Ensure we beat the baseline\nif val_rmse < trivial_rmse:\n    print('Model beats trivial baseline. Proceeding to test predictions.')\n    test_preds = automl.predict(test_df).data.reshape(-1)\n    pd.DataFrame({'target': test_preds}).to_csv('/app/predictions.csv', index=False)\nelse:\n    print('Model failed to beat trivial baseline. Using trivial predictions.')\n    test_preds = np.full(len(test_df), train_median)\n    pd.DataFrame({'target': test_preds}).to_csv('/app/predictions.csv', index=False)\n\nprint('MODEL_USED=', type(automl).__name__)\nEOF\n"]
