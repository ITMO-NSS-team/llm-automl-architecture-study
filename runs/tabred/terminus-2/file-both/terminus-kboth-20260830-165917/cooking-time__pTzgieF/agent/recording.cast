[490.003817, "i", "cat << 'EOF' > solution.py\nimport torch\nimport pandas as pd\nimport numpy as np\nfrom sklearn.metrics import mean_squared_error\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\nfrom lightautoml.tasks import Task\n\nprint('BUDGET_ALLOCATION: Training: 1h')\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\ntrain_df = pd.read_csv('/app/data/train.csv')\nval_df = pd.read_csv('/app/data/val.csv')\ntest_df = pd.read_csv('/app/data/test.csv')\nTARGET_COLUMN = 'target'\n\ntrain_median = train_df[TARGET_COLUMN].median()\nval_preds_trivial = np.full(len(val_df), train_median)\ntrivial_rmse = np.sqrt(mean_squared_error(val_df[TARGET_COLUMN], val_preds_trivial))\nprint(f'TRIVIAL_BASELINE_RMSE={trivial_rmse}')\n\ntask = Task('reg')\nroles = {'target': TARGET_COLUMN}\nautoml = TabularAutoML(task=task, timeout=600)\n\nautoml.fit_predict(train_df, roles=roles)\nval_preds = automl.predict(val_df).data.reshape(-1)\nval_rmse = np.sqrt(mean_squared_error(val_df[TARGET_COLUMN], val_preds))\nprint(f'VALIDATION_SCORE={val_rmse}')\n\nif val_rmse < trivial_rmse:\n    test_preds = automl.predict(test_df).data.reshape(-1)\n    pd.DataFrame({'target': test_preds}).to_csv('/app/predictions.csv', index=False)\nelse:\n    test_preds = np.full(len(test_df), train_median)\n    pd.DataFrame({'target': test_preds}).to_csv('/app/predictions.csv', index=False)\n\nprint('MODEL_USED=', type(automl).__name__)\nEOF\n"]
[490.004529, "o", "cat << 'EOF' > solution.py\r\nimport torch\r\nimport pandas as pd\r\nimport numpy as np\r\nfrom sklearn.metrics import mean_squared_error\r\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\r\nfrom lightautoml.tasks import Task\r\n\r\nprint('BUDGET_ALLOCATION: Training: 1h')\r\nDEVICE = ('cuda' if torch.cuda.is_available()\r\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\r\nprint('DEVICE=', DEVICE)\r\n\r\ntrain_df = pd.read_csv('/app/data/train.csv')\r\nval_df = pd.read_csv('/app/data/val.csv')\r\ntest_df = pd.read_csv('/app/data/test.csv')\r\nTARGET_COLUMN = 'target'\r\n\r\ntrain_median = train_df[TARGET_COLUMN].median()\r\nval_preds_trivial = np.full(len(val_df), train_median)\r\ntrivial_rmse = np.sqrt(mean_squared_error(val_df[TARGET_COLUMN], val_preds_trivial))\r\nprint(f'TRIVIAL_BASELINE_RMSE={trivial_rmse}')\r\n\r\ntask = Task('reg')\r\nroles = {'target': TARGET_COLUMN}\r\nautoml = TabularAutoML(task=task, timeout=600)\r\n\r\nautoml.fit_predict(train_df, roles=roles)\r\nval_preds = automl.predict(val_df).data.reshape(-1)\r\nval_rmse = np.sqrt(mean_squared_error(val_df[TARGET_COLUMN], val_preds))\r\nprint(f'VALIDATION_SCORE={val_rmse}')\r\n\r\nif val_rmse < trivial_rmse:\r\n    test_preds = automl.predict(test_df).data.reshape(-1)\r\n    pd.DataFrame({'target': test_preds}).to_csv('/app/predictions.csv', index=False)\r\nelse:\r\n    test_preds = np.full(len(test_df), train_median)\r\n    pd.DataFrame({'target': test_preds}).to_csv('/app/predictions.csv', index=False)\r\n\r\nprint('MODEL_USED=', type(automl).__name__)\r\nEOF\r\n"]
[490.119974, "i", "python3 solution.py\n"]
