cat << 'EOF' > solution.py
import pandas as pd
import numpy as np
from sklearn.metrics import roc_auc_score
import torch
import sys
from lightautoml.automl.presets.tabular_presets import TabularAutoML
from lightautoml.tasks import Task

# Flush output
def log(msg):
    print(msg)
    sys.stdout.flush()

# 1. Hardware Resolution
DEVICE = ('cuda' if torch.cuda.is_available()
          else 'mps' if torch.backends.mps.is_available() else 'cpu')
log('DEVICE=', DEVICE)

# 2. Time Budget Allocation
log('TIME_BUDGET_ALLOCATION: Exploration: 5min, Training: 2 hours, Finalization: 15min')

log('Loading data...')
train_df = pd.read_csv('/app/data/train.csv')
val_df = pd.read_csv('/app/data/val.csv')
test_df = pd.read_csv('/app/data/test.csv')
log('Data loaded.')

TARGET_COLUMN = 'target'

# Trivial Baseline
baseline_pred = np.full(len(val_df), train_df[TARGET_COLUMN].mean())
baseline_score = roc_auc_score(val_df[TARGET_COLUMN], baseline_pred)
log(f'TRIVIAL_BASELINE_SCORE={baseline_score}')

# LightAutoML setup
task = Task('binary')
roles = {'target': TARGET_COLUMN}

# Reduced timeout to 1800s (30 mins) to ensure we get results and don't hang forever
log('Initializing TabularAutoML...')
automl = TabularAutoML(task=task, timeout=1800)

log('Fitting model (this may take a while)...')
automl.fit_predict(train_df, roles=roles)
log('Fitting complete.')

# Validation score
log('Evaluating on validation set...')
val_preds = automl.predict(val_df).data.reshape(-1)
val_score = roc_auc_score(val_df[TARGET_COLUMN], val_preds)
log(f'VALIDATION_SCORE={val_score}')

if val_score <= baseline_score:
    log('Warning: Model did not beat trivial baseline!')

# Predictions on test set
log('Predicting on test set...')
test_preds = automl.predict(test_df).data.reshape(-1)
submission = pd.DataFrame({'target': test_preds})
submission.to_csv('/app/predictions.csv', index=False)
log('Predictions saved to /app/predictions.csv')

log('MODEL_USED=', type(automl).__name__)
EOF
python3 solution.py
C-c
python3 solution.py
ls
python3 solution.py > output.log 2>&1 &
tail -f output.log
