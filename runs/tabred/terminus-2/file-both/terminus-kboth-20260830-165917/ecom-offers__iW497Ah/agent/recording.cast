[706.065697, "i", "cat << 'EOF' > solution_fast.py\nimport pandas as pd\nimport numpy as np\nfrom sklearn.metrics import roc_auc_score\nimport torch\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\nfrom lightautoml.tasks import Task\n\nDEVICE = ('cuda' if torch.cuda.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\ntrain_df = pd.read_csv('/app/data/train.csv')\nval_df = pd.read_csv('/app/data/val.csv')\ntest_df = pd.read_csv('/app/data/test.csv')\n\ntask = Task('binary')\nautoml = TabularAutoML(task=task, timeout=300)\nautoml.fit_predict(train_df, roles={'target': 'target'})\n\nval_preds = automl.predict(val_df).data.reshape(-1)\nprint(f'VALIDATION_SCORE={roc_auc_score(val_df[\"target\"], val_preds)}')\n\ntest_preds = automl.predict(test_df).data.reshape(-1)\npd.DataFrame({'target': test_preds}).to_csv('/app/predictions.csv', index=False)\nprint('MODEL_USED=', type(automl).__name__)\nEOF\n"]
[706.065942, "o", "cat << 'EOF' > solution_fast.py\r\nimport pandas as pd\r\nimport numpy as np\r\nfrom sklearn.metrics import roc_auc_score\r\nimport torch\r\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\r\nfrom lightautoml.tasks import Task\r\n\r\nDEVICE = ('cuda' if torch.cuda.is_available() else 'cpu')\r\nprint('DEVICE=', DEVICE)\r\n\r\ntrain_df = pd.read_csv('/app/data/train.csv')\r\nval_df = pd.read_csv('/app/data/val.csv')\r\ntest_df = pd.read_csv('/app/data/test.csv')\r\n\r\ntask = Task('binary')\r\nautoml = TabularAutoML(task=task, timeout=300)\r\nautoml.fit_predict(train_df, roles={'target': 'target'})\r\n\r\nval_preds = automl.predict(val_df).data.reshape(-1)\r\nprint(f'VALIDATION_SCORE={roc_auc_score(val_df[\"target\"], val_preds)}')\r\n\r\ntest_preds = automl.predict(test_df).data.reshape(-1)\r\npd.DataFrame({'target': test_preds}).to_csv('/app/predictions.csv', index=False)\r\nprint('MODEL_USED=', type(automl).__name__)\r\nEOF\r\n"]
