[421.418297, "i", "cat << 'EOF' > solution.py\nimport pandas as pd\nimport numpy as np\nfrom sklearn.metrics import roc_auc_score\nimport torch\nimport sys\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\nfrom lightautoml.tasks import Task\n\n# Flush output\ndef log(msg):\n    print(msg)\n    sys.stdout.flush()\n\n# 1. Hardware Resolution\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nlog('DEVICE=', DEVICE)\n\n# 2. Time Budget Allocation\nlog('TIME_BUDGET_ALLOCATION: Exploration: 5min, Training: 2 hours, Finalization: 15min')\n\nlog('Loading data...')\ntrain_df = pd.read_csv('/app/data/train.csv')\nval_df = pd.read_csv('/app/data/val.csv')\ntest_df = pd.read_csv('/app/data/test.csv')\nlog('Data loaded.')\n\nTARGET_COLUMN = 'target'\n\n# Trivial Baseline\nbaseline_pred = np.full(len(val_df), train_df[TARGET_COLUMN].mean())\nbaseline_score = roc_auc_score(val_df[TARGET_COLUMN], baseline_pred)\nlog(f'TRIVIAL_BASELINE_SCORE={baseline_score}')\n\n# LightAutoML setup\ntask = Task('binary')\nroles = {'target': TARGET_COLUMN}\n\n# Reduced timeout to 1800s (30 mins) to ensure we get results and don't hang forever\nlog('Initializing TabularAutoML...')\nautoml = TabularAutoML(task=task, timeout=1800)\n\nlog('Fitting model (this may take a while)...')\nautoml.fit_predict(train_df, roles=roles)\nlog('Fitting complete.')\n\n# Validation score\nlog('Evaluating on validation set...')\nval_preds = automl.predict(val_df).data.reshape(-1)\nval_score = roc_auc_score(val_df[TARGET_COLUMN], val_preds)\nlog(f'VALIDATION_SCORE={val_score}')\n\nif val_score <= baseline_score:\n    log('Warning: Model did not beat trivial baseline!')\n\n# Predictions on test set\nlog('Predicting on test set...')\ntest_preds = automl.predict(test_df).data.reshape(-1)\nsubmission = pd.DataFrame({'target': test_preds})\nsubmission.to_csv('/app/predictions.csv', index=False)\nlog('Predictions saved to /app/predictions.csv')\n\nlog('MODEL_USED=', type(automl).__name__)\nEOF\n"]
[421.418545, "o", "cat << 'EOF' > solution.py\r\nimport pandas as pd\r\nimport numpy as np\r\nfrom sklearn.metrics import roc_auc_score\r\nimport torch\r\nimport sys\r\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\r\nfrom lightautoml.tasks import Task\r\n\r\n# Flush output\r\ndef log(msg):\r\n    print(msg)\r\n    sys.stdout.flush()\r\n\r\n# 1. Hardware Resolution\r\nDEVICE = ('cuda' if torch.cuda.is_available()\r\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\r\nlog('DEVICE=', DEVICE)\r\n\r\n# 2. Time Budget Allocation\r\nlog('TIME_BUDGET_ALLOCATION: Exploration: 5min, Training: 2 hours, Finalization: 15min')\r\n\r\nlog('Loading data...')\r\ntrain_df = pd.read_csv('/app/data/train.csv')\r\nval_df = pd.read_csv('/app/data/val.csv')\r\ntest_df = pd.read_csv('/app/data/test.csv')\r\nlog('Data loaded.')\r\n\r\nTARGET_COLUMN = 'target'\r\n\r\n# Trivial Baseline\r\nbaseline_pred = np.full(len(val_df), train_df[TARGET_COLUMN].mean())\r\nbaseline_score = roc_auc_score(val_df[TARGET_COLUMN], baseline_pred)\r\nlog(f'TRIVIAL_BASELINE_SCORE={baseline_score}')\r\n\r\n# LightAutoML setup\r\ntask = Task('binary')\r\nroles = {'target': TARGET_COLUMN}\r\n\r\n# Reduced timeout to 1800s (30 mins) to ensure we get results and don't hang forever\r\nlog('Initializing TabularAutoML...')\r\nautoml = TabularAutoML(task=task, timeout=1800)\r\n\r\nlog('Fitting model (this may take a while)...')\r\nautoml.fit_predict(train_df, roles=roles)\r\nlog('Fitting complete.')\r\n\r\n# Validation score\r\nlog('Evaluating on validation set...')\r\nval_preds = automl.predict(val_df).data.reshape(-1)\r\nval_score = roc_auc_score(val_df[TARGET_COLUMN], val_preds)\r\nlog(f'VALIDATION_SCORE={val_score}')\r\n\r\nif val_score <= baseline_score:\r\n    log('Warning: Model did not beat trivial baseline!')\r\n\r\n# Predictions on test set\r\nlog('Predicting on test set...')\r\ntest_preds = automl.predict(test_df).data.reshape(-1)\r\nsubmission = pd.DataFrame({'target': test_preds})\r\nsubmission.to_csv('/app/predictions.csv', index=False)\r\nlog('Predictions saved to /app/predictions.csv')\r\n\r\nlog('MODEL_USED=', type(automl).__name__)\r\nEOF\r\n"]
