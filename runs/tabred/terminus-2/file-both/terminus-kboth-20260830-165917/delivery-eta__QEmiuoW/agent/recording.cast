[1032.771093, "i", "cat << 'EOF' > train_mini.py\nimport torch\nimport pandas as pd\nimport numpy as np\nfrom sklearn.metrics import root_mean_squared_error\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\nfrom lightautoml.tasks import Task\n\nDEVICE = ('cuda' if torch.cuda.is_available() else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\ntrain_df = pd.read_csv('/app/data/train.csv').sample(n=10000, random_state=42)\nval_df = pd.read_csv('/app/data/val.csv')\ntest_df = pd.read_csv('/app/data/test.csv')\n\nmedian_val = train_df['target'].median()\nbaseline_rmse = root_mean_squared_error(val_df['target'], np.full(len(val_df), median_val))\nprint(f'TRIVIAL_BASELINE_RMSE={baseline_rmse}')\n\nautoml = TabularAutoML(task=Task('reg'), timeout=300)\nautoml.fit_predict(train_df, roles={'target': 'target'})\n\nval_preds = automl.predict(val_df).data.reshape(-1)\nprint(f'VALIDATION_SCORE={root_mean_squared_error(val_df['target'], val_preds)}')\nprint('MODEL_USED=', type(automl).__name__)\n\npred = automl.predict(test_df).data.reshape(-1)\npd.DataFrame({'target': pred}).to_csv('/app/predictions.csv', index=False)\nprint('Predictions saved.')\nEOF\n"]
[1032.772133, "o", "cat << 'EOF' > train_mini.py\r\nimport torch\r\nimport pandas as pd\r\nimport numpy as np\r\nfrom sklearn.metrics import root_mean_squared_error\r\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\r\nfrom lightautoml.tasks import Task\r\n\r\nDEVICE = ('cuda' if torch.cuda.is_available() else 'mps' if torch.backends.mps.is_available() else 'cpu')\r\nprint('DEVICE=', DEVICE)\r\n\r\ntrain_df = pd.read_csv('/app/data/train.csv').sample(n=10000, random_state=42)\r\nval_df = pd.read_csv('/app/data/val.csv')\r\ntest_df = pd.read_csv('/app/data/test.csv')\r\n\r\nmedian_val = train_df['target'].median()\r\nbaseline_rmse = root_mean_squared_error(val_df['target'], np.full(len(val_df), median_val))\r\nprint(f'TRIVIAL_BASELINE_RMSE={baseline_rmse}')\r\n\r\nautoml = TabularAutoML(task=Task('reg'), timeout=300)\r\nautoml.fit_predict(train_df, roles={'target': 'target'})\r\n\r\nval_preds = automl.predict(val_df).data.reshape(-1)\r\nprint(f'VALIDATION_SCORE={root_mean_squared_error(val_df['target'], val_preds)}')\r\nprint('MODEL_USED=', type(automl).__name__)\r\n\r\npred = automl.predict(test_df).data.reshape(-1)\r\npd.DataFrame({'target': pred}).to_csv('/app/predictions.csv', index=False)\r\nprint('Predictions saved.')\r\nEOF\r\n"]
