[792.383234, "i", "cat << 'EOF' > train_model_fast.py\nimport torch\nimport pandas as pd\nimport numpy as np\nfrom sklearn.metrics import root_mean_squared_error\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\nfrom lightautoml.tasks import Task\n\nDEVICE = ('cuda' if torch.cuda.is_available() else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\ntrain_df = pd.read_csv('/app/data/train.csv')\nval_df = pd.read_csv('/app/data/val.csv')\ntest_df = pd.read_csv('/app/data/test.csv')\n\n# Sample training data to ensure it finishes in a reasonable time for a sanity check\ntrain_df_sampled = train_df.sample(n=50000, random_state=42)\nprint(f'Using sampled training set of size {len(train_df_sampled)}')\n\nmedian_val = train_df['target'].median()\nbaseline_preds = np.full(len(val_df), median_val)\nbaseline_rmse = root_mean_squared_error(val_df['target'], baseline_preds)\nprint(f'TRIVIAL_BASELINE_RMSE={baseline_rmse}')\n\nTARGET_COLUMN = 'target'\nTIME_BUDGET_SECONDS = 600\ntask = Task('reg')\nroles = {'target': TARGET_COLUMN}\n\nautoml = TabularAutoML(task=task, timeout=TIME_BUDGET_SECONDS)\n\nprint('Starting fit_predict...')\nautoml.fit_predict(train_df_sampled, roles=roles)\nprint('fit_predict completed.')\n\nval_preds = automl.predict(val_df).data.reshape(-1)\nval_rmse = root_mean_squared_error(val_df['target'], val_preds)\nprint(f'VALIDATION_SCORE={val_rmse}')\n\nprint('MODEL_USED=', type(automl).__name__)\npred = automl.predict(test_df).data.reshape(-1)\n\nsubmission = pd.DataFrame({'target': pred})\nsubmission.to_csv('/app/predictions.csv', index=False)\nprint('Predictions saved to /app/predictions.csv')\nEOF\n"]
[792.383665, "o", "cat << 'EOF' > train_model_fast.py\r\nimport torch\r\nimport pandas as pd\r\nimport numpy as np\r\nfrom sklearn.metrics import root_mean_squared_error\r\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\r\nfrom lightautoml.tasks import Task\r\n\r\nDEVICE = ('cuda' if torch.cuda.is_available() else 'mps' if torch.backends.mps.is_available() else 'cpu')\r\nprint('DEVICE=', DEVICE)\r\n\r\ntrain_df = pd.read_csv('/app/data/train.csv')\r\nval_df = pd.read_csv('/app/data/val.csv')\r\ntest_df = pd.read_csv('/app/data/test.csv')\r\n\r\n# Sample training data to ensure it finishes in a reasonable time for a sanity check\r\ntrain_df_sampled = train_df.sample(n=50000, random_state=42)\r\nprint(f'Using sampled training set of size {len(train_df_sampled)}')\r\n\r\nmedian_val = train_df['target'].median()\r\nbaseline_preds = np.full(len(val_df), median_val)\r\nbaseline_rmse = root_mean_squared_error(val_df['target'], baseline_preds)\r\nprint(f'TRIVIAL_BASELINE_RMSE={baseline_rmse}')\r\n\r\nTARGET_COLUMN = 'target'\r\nTIME_BUDGET_SECONDS = 600\r\ntask = Task('reg')\r\nroles = {'target': TARGET_COLUMN}\r\n\r\nautoml = TabularAutoML(task=task, timeout=TIME_BUDGET_SECONDS)\r\n\r\nprint('Starting fit_predict...')\r\nautoml.fit_predict(train_df_sampled, roles=roles)\r\nprint('fit_predict completed.')\r\n\r\nval_preds = automl.predict(val_df).data.reshape(-1)\r\nval_rmse = root_mean_squared_error(val_df['target'], val_preds)\r\nprint(f'VALIDATION_SCORE={val_rmse}')\r\n\r\nprint('MODEL_USED=', type(automl).__name__)\r\npred = automl.predict(test_df).data.reshape(-1)\r\n\r\nsubmission = pd.DataFrame({'target': pred})\r\nsubmission.to_csv('/app/predictions.csv', index=False)\r\nprint('Predictions saved to /app/predictions.csv')\r\nEOF\r\n"]
[792.502074, "i", "python3 train_model_fast.py\n"]
[792.502866, "o", "python3 train_model_fast.py\r\n"]
