Sending keys: ["cat << 'EOF' > solution.py\nimport pandas as pd\nimport numpy as np\nfrom sklearn.metrics import mean_squared_error\nimport torch\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\nfrom lightautoml.tasks import Task\n\n# Resolve device\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\n# Budget allocation\nprint('BUDGET_ALLOCATION: Training: 0.5h')\n\n# Load data\ntrain_df = pd.read_csv('/app/data/train.csv')\nval_df = pd.read_csv('/app/data/val.csv')\ntest_df = pd.read_csv('/app/data/test.csv')\n\nTARGET_COLUMN = 'target'\n\n# Trivial baseline: Median\nmedian_val = train_df[TARGET_COLUMN].median()\nbaseline_preds = np.full(len(val_df), median_val)\nbaseline_rmse = np.sqrt(mean_squared_error(val_df[TARGET_COLUMN], baseline_preds))\nprint(f'BASELINE_RMSE={baseline_rmse}')\n\n# LightAutoML Setup\ntask = Task('reg')\nroles = {'target': TARGET_COLUMN}\n# Reduced timeout for sanity check and stability\nautoml = TabularAutoML(task=task, timeout=1800)\n\nprint('Starting fit_predict...')\noof = automl.fit_predict(train_df, roles=roles)\nprint('fit_predict finished.')\n\n# Validate on val_df\nprint('Predicting on validation set...')\nval_preds = automl.predict(val_df).data.reshape(-1)\nval_rmse = np.sqrt(mean_squared_error(val_df[TARGET_COLUMN], val_preds))\nprint(f'VALIDATION_SCORE={val_rmse}')\n\n# Final predictions\nif val_rmse < baseline_rmse:\n    print('Model beats baseline. Generating test predictions.')\n    test_preds = automl.predict(test_df).data.reshape(-1)\nelse:\n    print('Model failed to beat baseline. Using baseline.')\n    test_preds = np.full(len(test_df), median_val)\n\n# Save predictions\nsubmission = pd.DataFrame({'target': test_preds})\nsubmission.to_csv('/app/predictions.csv', index=False)\n\nprint('MODEL_USED=', type(automl).__name__)\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
