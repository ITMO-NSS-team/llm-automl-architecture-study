Sending keys: ["cat << 'EOF' > solve.py\nimport pandas as pd\nimport numpy as np\nfrom sklearn.metrics import mean_squared_error\nimport torch\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\nfrom lightautoml.tasks import Task\nimport time\n\n# 1. Hardware detection\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\n# Time budget allocation\nprint('BUDGET_ALLOCATION: Exploration: 0, Training: 3600, Finalization: 300')\n\n# Load data\ntrain_df = pd.read_csv('/app/data/train.csv')\nval_df = pd.read_csv('/app/data/val.csv')\ntest_df = pd.read_csv('/app/data/test.csv')\n\nTARGET_COLUMN = 'target'\n\n# 2. Trivial Baseline\nbaseline_val = np.full(len(val_df), train_df[TARGET_COLUMN].median())\nbaseline_rmse = np.sqrt(mean_squared_error(val_df[TARGET_COLUMN], baseline_val))\nprint(f'BASELINE_SCORE={baseline_rmse:.6f}')\n\n# 3. LightAutoML\ntask = Task('reg')\nroles = {'target': TARGET_COLUMN}\n# Setting timeout to 1 hour (3600 seconds)\nautoml = TabularAutoML(task=task, timeout=3600)\n\n# Fit on training set\nautoml.fit_predict(train_df, roles=roles)\n\n# Predict on validation set\nval_pred = automl.predict(val_df).data.reshape(-1)\nval_rmse = np.sqrt(mean_squared_error(val_df[TARGET_COLUMN], val_pred))\nprint(f'VALIDATION_SCORE={val_rmse:.6f}')\n\n# Ensure we beat baseline\nif val_rmse >= baseline_rmse:\n    print('Model did not beat baseline, using baseline predictions for submission')\n    test_preds = np.full(len(test_df), train_df[TARGET_COLUMN].median())\nelse:\n    # Predict on test set\n    test_preds = automl.predict(test_df).data.reshape(-1)\n\n# 4. Final Submission\nsubmission = pd.DataFrame({'target': test_preds})\nsubmission.to_csv('/app/predictions.csv', index=False)\n\nprint('MODEL_USED=', type(automl).__name__)\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
