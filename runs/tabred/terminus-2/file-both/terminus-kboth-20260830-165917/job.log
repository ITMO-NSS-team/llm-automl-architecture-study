Sending keys: ["cat << 'EOF' > solution.py\nimport pandas as pd\nimport numpy as np\nimport sys\nfrom sklearn.metrics import mean_squared_error\nimport torch\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\nfrom lightautoml.tasks import Task\n\nprint('Starting script...', flush=True)\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE, flush=True)\n\nprint('Loading data...', flush=True)\ntrain_df = pd.read_csv('/app/data/train.csv')\nval_df = pd.read_csv('/app/data/val.csv')\ntest_df = pd.read_csv('/app/data/test.csv')\n\nTARGET_COLUMN = 'target'\n\ntrivial_val_preds = np.full(len(val_df), train_df[TARGET_COLUMN].median())\ntrivial_rmse = np.sqrt(mean_squared_error(val_df[TARGET_COLUMN], trivial_val_preds))\nprint(f'TRIVIAL_BASELINE_RMSE={trivial_rmse}', flush=True)\n\nprint('Training LightAutoML...', flush=True)\ntask = Task('reg')\nroles = {'target': TARGET_COLUMN}\nautoml = TabularAutoML(task=task, timeout=600)\n\nautoml.fit_predict(train_df, roles=roles)\n\nprint('Predicting validation set...', flush=True)\nval_preds = automl.predict(val_df).data.reshape(-1)\nval_rmse = np.sqrt(mean_squared_error(val_df[TARGET_COLUMN], val_preds))\nprint(f'VALIDATION_SCORE={val_rmse}', flush=True)\nprint('MODEL_USED=', type(automl).__name__, flush=True)\n\nif val_rmse < trivial_rmse:\n    print('Model beat baseline!', flush=True)\n    test_preds = automl.predict(test_df).data.reshape(-1)\n    submission = pd.DataFrame({'target': test_preds})\n    submission.to_csv('/app/predictions.csv', index=False)\nelse:\n    print('Model did not beat baseline, using trivial predictor', flush=True)\n    test_preds = np.full(len(test_df), train_df[TARGET_COLUMN].median())\n    submission = pd.DataFrame({'target': test_preds})\n    submission.to_csv('/app/predictions.csv', index=False)\nprint('Done!', flush=True)\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
