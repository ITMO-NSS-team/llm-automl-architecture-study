Sending keys: ["cat << 'EOF' > solution.py\nimport pandas as pd\nimport numpy as np\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\nfrom lightautoml.tasks import Task\nimport torch\nfrom sklearn.metrics import mean_squared_error\n\n# Hardware resolution\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\n# Time budget allocation\nprint('BUDGET_ALLOCATION: Exploration: 10m, Initial Model: 30m, Tuning: 1h, Final: 20m')\n\n# Load data\ntrain_df = pd.read_csv('/app/data/train.csv')\nval_df = pd.read_csv('/app/data/val.csv')\ntest_df = pd.read_csv('/app/data/test.csv')\n\ntarget_col = 'target'\n\n# Trivial Baseline\nmedian_val = train_df[target_col].median()\nbaseline_preds = np.full(len(val_df), median_val)\nbaseline_rmse = np.sqrt(mean_squared_error(val_df[target_col], baseline_preds))\nprint(f'BASELINE_SCORE={baseline_rmse}')\n\n# LightAutoML Setup\ntask = Task('reg')\nroles = {target_col: 'target'}\n# Giving it a substantial budget for convergence\nautoml = TabularAutoML(task=task, timeout=3600)\n\n# Fit and Predict\n# LightAutoML handles internal splitting and validation\n# We provide the full train_df and the roles\noof = automl.fit_predict(train_df, roles=roles)\n\n# Validation score on the provided val_df\nval_preds = automl.predict(val_df).data.reshape(-1)\nval_rmse = np.sqrt(mean_squared_error(val_df[target_col], val_preds))\nprint(f'VALIDATION_SCORE={val_rmse}')\n\nif val_rmse >= baseline_rmse:\n    print('Model failed to beat baseline, using baseline for submission')\n    test_preds = np.full(len(test_df), median_val)\nelse:\n    test_preds = automl.predict(test_df).data.reshape(-1)\n\n# Final submission\nsubmission = pd.DataFrame({'target': test_preds})\nsubmission.to_csv('/app/predictions.csv', index=False)\n\nprint('MODEL_USED=', type(automl).__name__)\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
