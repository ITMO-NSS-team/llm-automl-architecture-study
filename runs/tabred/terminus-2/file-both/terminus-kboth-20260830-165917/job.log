Sending keys: ["cat << 'EOF' > train_model.py\nimport torch\nimport pandas as pd\nimport numpy as np\nfrom sklearn.metrics import root_mean_squared_error\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\nfrom lightautoml.tasks import Task\n\n# Hardware - REQUIRED, STRICT\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\n# Load data\ntrain_df = pd.read_csv('/app/data/train.csv')\nval_df = pd.read_csv('/app/data/val.csv')\ntest_df = pd.read_csv('/app/data/test.csv')\n\n# Trivial Baseline\nmedian_val = train_df['target'].median()\nbaseline_preds = np.full(len(val_df), median_val)\nbaseline_rmse = root_mean_squared_error(val_df['target'], baseline_preds)\nprint(f'TRIVIAL_BASELINE_RMSE={baseline_rmse}')\n\n# Model Configuration\nTARGET_COLUMN = 'target'\nTIME_BUDGET_SECONDS = 3600\ntask = Task('reg')\nroles = {'target': TARGET_COLUMN}\n\nautoml = TabularAutoML(task=task, timeout=TIME_BUDGET_SECONDS)\n\n# Fit and Predict\n# Fit on train, evaluate on val (fit_predict returns OOF predictions for the train set)\n# To get validation score, we predict on the val_df\nautoml.fit_predict(train_df, roles=roles)\n\n# Validation\nval_preds = automl.predict(val_df).data.reshape(-1)\nval_rmse = root_mean_squared_error(val_df['target'], val_preds)\nprint(f'VALIDATION_SCORE={val_rmse}')\n\n# Ensure it beats baseline\nif val_rmse >= baseline_rmse:\n    print('WARNING: Model did not beat trivial baseline')\n\n# Final predictions\nprint('MODEL_USED=', type(automl).__name__)\npred = automl.predict(test_df).data.reshape(-1)\n\n# Save to CSV\nsubmission = pd.DataFrame({'target': pred})\nsubmission.to_csv('/app/predictions.csv', index=False)\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
