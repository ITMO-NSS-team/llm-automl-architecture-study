Sending keys: ["cat << 'EOF' > solution.py\nimport torch\nimport pandas as pd\nimport numpy as np\nfrom sklearn.metrics import mean_squared_error\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\nfrom lightautoml.tasks import Task\n\n# Time budget allocation\nprint('BUDGET_ALLOCATION: Exploration: 10min, Training: 2h, Improvement: 1h, Finalization: 20min')\n\n# Hardware resolve\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\n# Load data\ntrain_df = pd.read_csv('/app/data/train.csv')\nval_df = pd.read_csv('/app/data/val.csv')\ntest_df = pd.read_csv('/app/data/test.csv')\n\nTARGET_COLUMN = 'target'\n\n# Trivial Baseline\ntrain_median = train_df[TARGET_COLUMN].median()\nval_preds_trivial = np.full(len(val_df), train_median)\ntrivial_rmse = np.sqrt(mean_squared_error(val_df[TARGET_COLUMN], val_preds_trivial))\nprint(f'TRIVIAL_BASELINE_RMSE={trivial_rmse}')\n\n# LightAutoML setup\ntask = Task('reg')\nroles = {'target': TARGET_COLUMN}\n# Using a reasonable timeout for convergence\nautoml = TabularAutoML(task=task, timeout=3600)\n\n# Fit and predict on validation for OOF score\n# LightAutoML internally handles splitting if we provide a validation set, \n# but for simplicity we fit on train and evaluate on val\nautoml.fit_predict(train_df, roles=roles)\n\nval_preds = automl.predict(val_df).data.reshape(-1)\nval_rmse = np.sqrt(mean_squared_error(val_df[TARGET_COLUMN], val_preds))\nprint(f'VALIDATION_SCORE={val_rmse}')\n\n# Ensure we beat the baseline\nif val_rmse < trivial_rmse:\n    print('Model beats trivial baseline. Proceeding to test predictions.')\n    test_preds = automl.predict(test_df).data.reshape(-1)\n    pd.DataFrame({'target': test_preds}).to_csv('/app/predictions.csv', index=False)\nelse:\n    print('Model failed to beat trivial baseline. Using trivial predictions.')\n    test_preds = np.full(len(test_df), train_median)\n    pd.DataFrame({'target': test_preds}).to_csv('/app/predictions.csv', index=False)\n\nprint('MODEL_USED=', type(automl).__name__)\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
