Sending keys: ["cat << 'EOF' > solution.py\nimport pandas as pd\nimport numpy as np\nimport torch\nfrom sklearn.metrics import roc_auc_score\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\nfrom lightautoml.tasks import Task\nimport time\n\n# Hardware Resolve\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\n# Budget Allocation\nprint('BUDGET_ALLOCATION: Exploration: 5min, Training: 60min, Finalization: 5min')\nstart_time = time.time()\n\n# Load Data\ntrain_df = pd.read_csv('/app/data/train.csv')\nval_df = pd.read_csv('/app/data/val.csv')\ntest_df = pd.read_csv('/app/data/test.csv')\n\nTARGET_COLUMN = 'target'\n\n# Trivial Baseline\nbaseline_preds = np.full(len(val_df), train_df[TARGET_COLUMN].mean())\nbaseline_auc = roc_auc_score(val_df[TARGET_COLUMN], baseline_preds)\nprint(f'TRIVIAL_BASELINE_AUC={baseline_auc}')\n\n# LightAutoML Setup\ntask = Task('binary')\nroles = {'target': TARGET_COLUMN}\n\n# Use a reasonable timeout for convergence\nautoml = TabularAutoML(task=task, timeout=3600)\n\n# Fit model\n# LightAutoML handles the internal split if we provide a validation set or use oof\n# Here we use the provided val_df for final validation score\nautoml.fit_predict(train_df, roles=roles)\n\n# Predict on validation set\nval_preds = automl.predict(val_df).data.reshape(-1)\nval_auc = roc_auc_score(val_df[TARGET_COLUMN], val_preds)\nprint(f'VALIDATION_SCORE={val_auc}')\n\nif val_auc <= baseline_auc:\n    print('Model did not beat baseline. Check approach.')\n\n# Predict on test set\ntest_preds = automl.predict(test_df).data.reshape(-1)\n\n# Save predictions\nsubmission = pd.DataFrame({'target': test_preds})\nsubmission.to_csv('/app/predictions.csv', index=False)\n\nprint('MODEL_USED=', type(automl).__name__)\nprint(f'ELAPSED_TIME={time.time() - start_time:.2f}s')\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
