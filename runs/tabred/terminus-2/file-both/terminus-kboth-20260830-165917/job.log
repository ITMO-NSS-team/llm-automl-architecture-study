Sending keys: ["cat << 'EOF' > solution.py\nimport torch\nimport pandas as pd\nimport numpy as np\nfrom sklearn.metrics import mean_squared_error\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\nfrom lightautoml.tasks import Task\nimport time\n\n# Hardware check - REQUIRED EXACT SNIPPET\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\n# Time budget allocation\nprint('TIME_ALLOCATION: Exploration: 5m, Training: 60m, Finalization: 5m')\n\n# Load data\ntrain_df = pd.read_csv('/app/data/train.csv')\nval_df = pd.read_csv('/app/data/val.csv')\ntest_df = pd.read_csv('/app/data/test.csv')\n\nTARGET_COLUMN = 'target'\n\n# Trivial baseline: Median of training target\ntrivial_val = np.median(train_df[TARGET_COLUMN].fillna(train_df[TARGET_COLUMN].median()))\nbaseline_rmse = np.sqrt(mean_squared_error(val_df[TARGET_COLUMN], np.full(len(val_df), trivial_val)))\nprint(f'TRIVIAL_BASELINE_RMSE={baseline_rmse}')\n\n# LightAutoML setup\ntask = Task('reg')\nroles = {'target': TARGET_COLUMN}\n# Set a generous timeout for convergence\nautoml = TabularAutoML(task=task, timeout=3600)\n\n# Fit model\n# Note: LightAutoML handles missing values internally\noof = automl.fit_predict(train_df, roles=roles)\n\n# Validation\nval_preds = automl.predict(val_df).data.reshape(-1)\nval_rmse = np.sqrt(mean_squared_error(val_df[TARGET_COLUMN], val_preds))\nprint(f'VALIDATION_SCORE={val_rmse}')\nprint('MODEL_USED=', type(automl).__name__)\n\nif val_rmse < baseline_rmse:\n    print('Model beats trivial baseline!')\n    # Predict on test set\n    test_preds = automl.predict(test_df).data.reshape(-1)\n    submission = pd.DataFrame({'target': test_preds})\n    submission.to_csv('/app/predictions.csv', index=False)\n    print('Predictions saved to /app/predictions.csv')\nelse:\n    print('Model failed to beat trivial baseline. Using trivial baseline instead.')\n    test_preds = np.full(len(test_df), trivial_val)\n    submission = pd.DataFrame({'target': test_preds})\n    submission.to_csv('/app/predictions.csv', index=False)\n    print('Trivial predictions saved to /app/predictions.csv')\n\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
