Sending keys: ["cat << 'EOF' > solution.py\nimport pandas as pd\nimport numpy as np\nfrom sklearn.metrics import mean_squared_error\nimport torch\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\nfrom lightautoml.tasks import Task\n\n# Hardware detection\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\n# Budget allocation\nprint('BUDGET: Exploration: 0.1h, Training: 1h, Improvement: 0.5h, Finalization: 0.1h')\n\n# Load data\nprint('Loading data...')\ntrain_df = pd.read_csv('/app/data/train.csv')\nval_df = pd.read_csv('/app/data/val.csv')\ntest_df = pd.read_csv('/app/data/test.csv')\n\nTARGET_COLUMN = 'target'\n\n# Trivial baseline\ntrain_median = train_df[TARGET_COLUMN].median()\nval_preds_baseline = np.full(len(val_df), train_median)\nbaseline_rmse = np.sqrt(mean_squared_error(val_df[TARGET_COLUMN], val_preds_baseline))\nprint(f'BASELINE_RMSE={baseline_rmse}')\n\n# LightAutoML\ntask = Task('reg')\nroles = {'target': TARGET_COLUMN}\n# Set a reasonable timeout for convergence\nautoml = TabularAutoML(task=task, timeout=3600)\n\nprint('Training LightAutoML...')\n# fit_predict returns OOF predictions for the training set\n# We use the validation set for the final score printout as requested\nautoml.fit(train_df, roles=roles)\n\nval_preds = automl.predict(val_df).data.reshape(-1)\nval_rmse = np.sqrt(mean_squared_error(val_df[TARGET_COLUMN], val_preds))\nprint(f'VALIDATION_SCORE={val_rmse}')\n\nif val_rmse < baseline_rmse:\n    print('Model beat baseline!')\n    # Predictions for test set\n    test_preds = automl.predict(test_df).data.reshape(-1)\n    submission = pd.DataFrame({'target': test_preds})\n    submission.to_csv('/app/predictions.csv', index=False)\n    print('Predictions saved to /app/predictions.csv')\nelse:\n    print('Model did not beat baseline. Using baseline for submission.')\n    test_preds = np.full(len(test_df), train_median)\n    submission = pd.DataFrame({'target': test_preds})\n    submission.to_csv('/app/predictions.csv', index=False)\n    print('Baseline predictions saved to /app/predictions.csv')\n\nprint('MODEL_USED=', type(automl).__name__)\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
