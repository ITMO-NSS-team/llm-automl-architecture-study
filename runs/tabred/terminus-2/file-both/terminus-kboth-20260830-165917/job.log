Sending keys: ["cat << 'EOF' > solve.py\nimport pandas as pd\nimport numpy as np\nfrom sklearn.metrics import roc_auc_score\nimport torch\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\nfrom lightautoml.tasks import Task\n\n# Hardware requirement\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\n# Time budget allocation\nprint('BUDGET_ALLOCATION: Exploration: 10min, Training: 2h, Validation/Finalization: 30min')\n\n# Load data\ntrain_df = pd.read_csv('/app/data/train.csv')\nval_df = pd.read_csv('/app/data/val.csv')\ntest_df = pd.read_csv('/app/data/test.csv')\n\nTARGET_COLUMN = 'target'\n\n# Trivial Baseline\n# For ROC-AUC, a constant prediction is useless, but we'll check the mean target\nbaseline_pred = np.full(len(val_df), train_df[TARGET_COLUMN].mean())\nbaseline_score = roc_auc_score(val_df[TARGET_COLUMN], baseline_pred)\nprint(f'TRIVIAL_BASELINE_SCORE={baseline_score}')\n\n# LightAutoML Pipeline\ntask = Task('binary')\nroles = {'target': TARGET_COLUMN}\n\n# timeout is in seconds. Let's give it 3600s (1 hour)\nautoml = TabularAutoML(task=task, timeout=3600)\n\n# Fit and Predict on validation to get OOF/Score\n# Note: fit_predict expects the dataframe to contain the target\n# LightAutoML handles the internal splitting/validation\n# To strictly follow the instruction to validate on val.csv, we can fit on train and predict on val\nautoml.fit_predict(train_df, roles=roles)\n\n# Predict on validation set to get score\nval_preds = automl.predict(val_df).data.reshape(-1)\nval_score = roc_auc_score(val_df[TARGET_COLUMN], val_preds)\nprint(f'VALIDATION_SCORE={val_score}')\n\n# Final predictions on test set\npred = automl.predict(test_df).data.reshape(-1)\n\n# Save predictions\nsubmission = pd.DataFrame({'target': pred})\nsubmission.to_csv('/app/predictions.csv', index=False)\n\nprint('MODEL_USED=', type(automl).__name__)\nEOF\n"] min_timeout_sec: 0.1 m