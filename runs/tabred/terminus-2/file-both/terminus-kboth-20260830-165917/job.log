Sending keys: ["cat << 'EOF' > solution.py\nimport pandas as pd\nimport numpy as np\nimport torch\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\nfrom lightautoml.tasks import Task\nfrom sklearn.metrics import mean_squared_error\n\n# Hardware resolution\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\n# Time budget allocation\nprint('BUDGET_ALLOCATION: exploration: 0, training: 600, finalization: 300')\n\n# Load data\ntrain_df_full = pd.read_csv('/app/data/train.csv')\nval_df = pd.read_csv('/app/data/val.csv')\ntest_df = pd.read_csv('/app/data/test.csv')\n\nTARGET_COLUMN = 'target'\n\n# Sample training data for speed on CPU\ntrain_df = train_df_full.sample(n=50000, random_state=42)\n\n# Trivial Baseline\ntrivial_val = np.full(len(val_df), train_df_full[TARGET_COLUMN].median())\ntrivial_rmse = np.sqrt(mean_squared_error(val_df[TARGET_COLUMN], trivial_val))\nprint(f'TRIVIAL_BASELINE_RMSE={trivial_rmse}')\n\n# LightAutoML setup\ntask = Task('reg')\nroles = {'target': TARGET_COLUMN}\nautoml = TabularAutoML(task=task, timeout=300)\n\n# Fit\nautoml.fit_predict(train_df, roles=roles)\n\n# Validate on val_df\nval_preds = automl.predict(val_df).data.reshape(-1)\nval_rmse = np.sqrt(mean_squared_error(val_df[TARGET_COLUMN], val_preds))\nprint(f'VALIDATION_SCORE={val_rmse}')\n\n# Sanity check against baseline\nif val_rmse >= trivial_rmse:\n    print('Model did not beat baseline, using baseline predictions')\n    test_preds = np.full(len(test_df), train_df_full[TARGET_COLUMN].median())\nelse:\n    print('Model beat baseline')\n    test_preds = automl.predict(test_df).data.reshape(-1)\n\n# Submission\nsubmission = pd.DataFrame({'target': test_preds})\nsubmission.to_csv('/app/predictions.csv', index=False)\n\nprint('MODEL_USED=', type(automl).__name__)\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
