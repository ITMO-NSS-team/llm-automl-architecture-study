Sending keys: ["cat << 'EOF' > solution.py\nimport pandas as pd\nimport numpy as np\nimport torch\nfrom sklearn.metrics import roc_auc_score\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\nfrom lightautoml.tasks import Task\nimport time\n\n# Hardware - REQUIRED, STRICT\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\n# Time budget allocation\nprint('Budget Allocation: Exploration: 5m, Training: 2h, Finalization: 15m')\n\n# Load data\ntrain_df = pd.read_csv('/app/data/train.csv')\nval_df = pd.read_csv('/app/data/val.csv')\ntest_df = pd.read_csv('/app/data/test.csv')\n\nTARGET_COLUMN = 'target'\n\n# Trivial Baseline\ntrain_mean = train_df[TARGET_COLUMN].mean()\nval_preds_baseline = np.full(len(val_df), train_mean)\nbaseline_score = roc_auc_score(val_df[TARGET_COLUMN], val_preds_baseline)\nprint(f'TRIVIAL_BASELINE_SCORE={baseline_score}')\n\n# LightAutoML setup\ntask = Task('binary')\nroles = {'target': TARGET_COLUMN}\n# Set a reasonable timeout for convergence\nautoml = TabularAutoML(task=task, timeout=3600)\n\n# Train and validate\n# LightAutoML fit_predict uses the target column specified in roles\n# We use a part of the data if necessary, but the budget is generous here\nstart_time = time.time()\noof = automl.fit_predict(train_df, roles=roles)\nend_time = time.time()\nprint(f'Training time: {end_time - start_time:.2f} seconds')\n\n# Validation score\nval_preds = automl.predict(val_df).data.reshape(-1)\nval_score = roc_auc_score(val_df[TARGET_COLUMN], val_preds)\nprint(f'VALIDATION_SCORE={val_score}')\n\nif val_score <= baseline_score:\n    print('Model failed to beat baseline. Using baseline for submission.')\n    test_preds = np.full(len(test_df), train_mean)\nelse:\n    # Predict on test set\n    test_preds = automl.predict(test_df).data.reshape(-1)\n\n# Final submission\nsubmission = pd.DataFrame({'target': test_preds})\nsubmission.to_csv('/app/predictions.csv', index=False)\n\nprint('MODEL_USED=', type(automl).__name__)\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
