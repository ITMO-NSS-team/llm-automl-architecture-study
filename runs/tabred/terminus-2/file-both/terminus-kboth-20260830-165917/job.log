Sending keys: ["cat << 'EOF' > solution.py\nimport pandas as pd\nimport numpy as np\nfrom sklearn.metrics import mean_squared_error\nimport torch\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\nfrom lightautoml.tasks import Task\nimport sys\n\n# Hardware resolution\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\n# Budget allocation\nprint('BUDGET_ALLOCATION: Exploration: 5m, Training: 25m, Finalization: 5m')\n\n# Load data\ntrain_df = pd.read_csv('/app/data/train.csv')\nval_df = pd.read_csv('/app/data/val.csv')\ntest_df = pd.read_csv('/app/data/test.csv')\n\ntarget_col = 'target'\n\n# Trivial Baseline\ny_train = train_df[target_col]\ny_val = val_df[target_col]\nbaseline_pred = np.full(shape=y_val.shape, fill_value=y_train.median())\nbaseline_rmse = np.sqrt(mean_squared_error(y_val, baseline_pred))\nprint(f'BASELINE_SCORE={baseline_rmse}')\n\n# LightAutoML setup\ntask = Task('reg')\nroles = {target_col: 'target'}\n# Reduce timeout to 1800s (30m) to avoid excessive hanging\nautoml = TabularAutoML(task=task, timeout=1800)\n\nprint('Starting fit_predict...')\n_ = automl.fit_predict(train_df, roles=roles)\nprint('fit_predict completed.')\n\n# Predict on validation set\nprint('Predicting on validation set...')\nval_preds = automl.predict(val_df).data.reshape(-1)\nval_rmse = np.sqrt(mean_squared_error(y_val, val_preds))\nprint(f'VALIDATION_SCORE={val_rmse}')\n\n# Check if it beats baseline\nif val_rmse < baseline_rmse:\n    print('Model beat baseline. Proceeding to test predictions.')\n    test_preds = automl.predict(test_df).data.reshape(-1)\n    submission = pd.DataFrame({'target': test_preds})\n    submission.to_csv('/app/predictions.csv', index=False)\nelse:\n    print('Model did not beat baseline. Using baseline for submission.')\n    test_preds = np.full(shape=test_df.shape[0], fill_value=y_train.median())\n    submission = pd.DataFrame({'target': test_preds})\n    submission.to_csv('/app/predictions.csv', index=False)\n\nprint('MODEL_USED=', type(automl).__name__)\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
