[414.228998, "i", "cat << 'EOF' > solution.py\nimport pandas as pd\nimport numpy as np\nimport torch\nimport sys\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\nfrom lightautoml.tasks import Task\nfrom sklearn.metrics import mean_squared_error\nimport time\n\n# Hardware resolution\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE, flush=True)\n\n# Time budget allocation\nprint('ALLOCATION: Exploration: 5m, Training: 30m, Finalization: 10m', flush=True)\n\n# Load data\ntrain_df = pd.read_csv('/app/data/train.csv')\nval_df = pd.read_csv('/app/data/val.csv')\ntest_df = pd.read_csv('/app/data/test.csv')\n\nTARGET_COLUMN = 'target'\n\n# Trivial Baseline\nbaseline_val = np.full(len(val_df), train_df[TARGET_COLUMN].median())\nbaseline_rmse = np.sqrt(mean_squared_error(val_df[TARGET_COLUMN], baseline_val))\nprint(f'TRIVIAL_BASELINE_RMSE={baseline_rmse}', flush=True)\n\n# LightAutoML Setup\ntask = Task('reg')\nroles = {'target': TARGET_COLUMN}\nTIME_BUDGET = 1800\nautoml = TabularAutoML(task=task, timeout=TIME_BUDGET)\n\n# Training\nprint('Starting fit_predict...', flush=True)\nstart_time = time.time()\noof = automl.fit_predict(train_df, roles=roles)\nend_time = time.time()\nprint(f'TRAINING_TIME={end_time - start_time:.2f}s', flush=True)\n\n# Predict on validation set\nval_preds = automl.predict(val_df).data.reshape(-1)\nval_rmse = np.sqrt(mean_squared_error(val_df[TARGET_COLUMN], val_preds))\nprint(f'VALIDATION_SCORE={val_rmse}', flush=True)\n\n# Check if baseline is beaten\nif val_rmse < baseline_rmse:\n    print('Model beats trivial baseline.', flush=True)\nelse:\n    print('Model failed to beat trivial baseline.', flush=True)\n\n# Final predictions\nprint('MODEL_USED=', type(automl).__name__, flush=True)\ntest_preds = automl.predict(test_df).data.reshape(-1)\n\n# Save to CSV\npreds_df = pd.DataFrame({'target': test_preds})\npreds_df.to_csv('/app/predictions.csv', index=False)\nprint('Predictions saved to /app/predictions.csv', flush=True)\n\nEOF\n"]
[414.229333, "o", "cat << 'EOF' > solution.py\r\nimport pandas as pd\r\nimport numpy as np\r\nimport torch\r\nimport sys\r\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\r\nfrom lightautoml.tasks import Task\r\nfrom sklearn.metrics import mean_squared_error\r\nimport time\r\n\r\n# Hardware resolution\r\nDEVICE = ('cuda' if torch.cuda.is_available()\r\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\r\nprint('DEVICE=', DEVICE, flush=True)\r\n\r\n# Time budget allocation\r\nprint('ALLOCATION: Exploration: 5m, Training: 30m, Finalization: 10m', flush=True)\r\n\r\n# Load data\r\ntrain_df = pd.read_csv('/app/data/train.csv')\r\nval_df = pd.read_csv('/app/data/val.csv')\r\ntest_df = pd.read_csv('/app/data/test.csv')\r\n\r\nTARGET_COLUMN = 'target'\r\n\r\n# Trivial Baseline\r\nbaseline_val = np.full(len(val_df), train_df[TARGET_COLUMN].median())\r\nbaseline_rmse = np.sqrt(mean_squared_error(val_df[TARGET_COLUMN], baseline_val))\r\nprint(f'TRIVIAL_BASELINE_RMSE={baseline_rmse}', flush=True)\r\n\r\n# LightAutoML Setup\r\ntask = Task('reg')\r\nroles = {'target': TARGET_COLUMN}\r\nTIME_BUDGET = 1800\r\nautoml = TabularAutoML(task=task, timeout=TIME_BUDGET)\r\n\r\n# Training\r\nprint('Starting fit_predict...', flush=True)\r\nstart_time = time.time()\r\noof = automl.fit_predict(train_df, roles=roles)\r\nend_time = time.time()\r\nprint(f'TRAINING_TIME={end_time - start_time:.2f}s', flush=True)\r\n\r\n# Predict on validation set\r\nval_preds = automl.predict(val_df).data.reshape(-1)\r\nval_rmse = np.sqrt(mean_squared_error(val_df[TARGET_COLUMN], val_preds))\r\nprint(f'VALIDATION_SCORE={val_rmse}', flush=True)\r\n\r\n# Check if baseline is beaten\r\nif val_rmse < baseline_rmse:\r\n    print('Model beats trivial baseline.', flush=True)\r\nelse:\r\n    print('Model failed to beat trivial baseline.', flush=True)\r\n\r\n# Final predictions\r\nprint('MODEL_USED=', type(automl).__name__, flush=True)\r\ntest_preds = automl.predict(test_df).data.reshape(-1)\r\n\r\n# Save to CSV\r\npreds_df = pd.DataFrame({'target': test_preds})\r\npreds_df.to_csv('/app/predictions.csv', index=False)\r\nprint('Predictions saved to /app/predictions.csv', flush=True)\r\n\r\nEOF\r\n"]
