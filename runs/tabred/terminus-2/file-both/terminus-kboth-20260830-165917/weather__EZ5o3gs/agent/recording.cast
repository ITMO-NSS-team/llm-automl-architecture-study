[11.198481, "o", "\u001b[?2004hroot@f4a67ac80f7d:/workspace# "]
[63.614346, "i", "cat << 'EOF' > solution.py\nimport pandas as pd\nimport numpy as np\nfrom sklearn.metrics import mean_squared_error\nimport torch\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\nfrom lightautoml.tasks import Task\n\n# REQUIRED: Device detection snippet\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\n# Load data\nprint('Loading data...')\ntrain_df = pd.read_csv('/app/data/train.csv')\nval_df = pd.read_csv('/app/data/val.csv')\ntest_df = pd.read_csv('/app/data/test.csv')\n\nTARGET_COLUMN = 'target'\n\n# Trivial Baseline\n# Predict the mean of the training target for all validation samples\ntrain_mean = train_df[TARGET_COLUMN].mean()\nbaseline_preds = np.full(len(val_df), train_mean)\nbaseline_rmse = np.sqrt(mean_squared_error(val_df[TARGET_COLUMN], baseline_preds))\nprint(f'BASELINE_RMSE={baseline_rmse}')\n\n# LightAutoML Setup\ntask = Task('reg')\nroles = {TARGET_COLUMN: 'target'}\n# Budget: 1 hour for training to ensure convergence\nautoml = TabularAutoML(task=task, timeout=3600)\n\nprint('Training LightAutoML...')\n# Fit and predict on training set (oof is out-of-fold predictions)\n# Note: LightAutoML handles the internal splitting and validation\nautoml.fit_predict(train_df, roles=roles)\n\n# Predict on validation set\nval_preds = automl.predict(val_df).data.reshape(-1)\nval_rmse = np.sqrt(mean_squared_error(val_df[TARGET_COLUMN], val_preds))\nprint(f'VALIDATION_SCORE={val_rmse}')\nprint(f'MODEL_USED={type(automl).__name__}')\n\nif val_rmse < baseline_rmse:\n    print('Model beats baseline. Generating test predictions...')\n    test_preds = automl.predict(test_df).data.reshape(-1)\n    submission = pd.DataFrame({'target': test_preds})\n    submission.to_csv('/app/predictions.csv', index=False)\n    print('Predictions saved to /app/predictions.csv')\nelse:\n    print('Model failed to beat baseline. Using baseline for submission.')\n    test_preds = np.full(len(test_df), train_mean)\n    submission = pd.DataFrame({'target': test_preds})\n    submission.to_csv('/app/predictions.csv', index=False)\n    print('Baseline predictions saved to /app/predictions.csv')\n\nEOF\n"]
