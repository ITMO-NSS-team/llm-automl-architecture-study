[1114.019304, "i", "echo \"import pandas as pd; import numpy as np; import torch; import sys; from lightautoml.automl.presets.tabular_presets import TabularAutoML; from lightautoml.tasks import Task; from sklearn.metrics import mean_squared_error; DEVICE = ('cuda' if torch.cuda.is_available() else 'mps' if torch.backends.mps.is_available() else 'cpu'); print('DEVICE=', DEVICE); sys.stdout.flush(); print('BUDGET_ALLOCATION: exploration: 0, training: 600, finalization: 300'); sys.stdout.flush(); train_df_full = pd.read_csv('/app/data/train.csv'); val_df = pd.read_csv('/app/data/val.csv'); test_df = pd.read_csv('/app/data/test.csv'); TARGET_COLUMN = 'target'; train_df = train_df_full.sample(n=5000, random_state=42); trivial_val = np.full(len(val_df), train_df_full[TARGET_COLUMN].median()); trivial_rmse = np.sqrt(mean_squared_error(val_df[TARGET_COLUMN], trivial_val)); print(f'TRIVIAL_BASELINE_RMSE={trivial_rmse}'); sys.stdout.flush(); task = Task('reg'); roles = {'target': TARGET_COLUMN}; automl = TabularAutoML(task=task, timeout=60); automl.fit_predict(train_df, roles=roles); val_preds = automl.predict(val_df).data.reshape(-1); val_rmse = np.sqrt(mean_squared_error(val_df[TARGET_COLUMN], val_preds)); print(f'VALIDATION_SCORE={val_rmse}'); sys.stdout.flush(); test_preds = np.full(len(test_df), train_df_full[TARGET_COLUMN].median()) if val_rmse >= trivial_rmse else automl.predict(test_df).data.reshape(-1); pd.DataFrame({'target': test_preds}).to_csv('/app/predictions.csv', index=False); print('MODEL_USED=', type(automl).__name__); sys.stdout.flush()\" > solution.py\n"]
