[1199.72645, "i", "python3 -c \"import pandas as pd; import numpy as np; import torch; from lightautoml.automl.presets.tabular_presets import TabularAutoML; from lightautoml.tasks import Task; from sklearn.metrics import mean_squared_error; DEVICE = ('cuda' if torch.cuda.is_available() else 'mps' if torch.backends.mps.is_available() else 'cpu'); print('DEVICE=', DEVICE); train_df_full = pd.read_csv('/app/data/train.csv'); val_df = pd.read_csv('/app/data/val.csv'); test_df = pd.read_csv('/app/data/test.csv'); TARGET_COLUMN = 'target'; train_df = train_df_full.sample(n=5000, random_state=42); trivial_rmse = np.sqrt(mean_squared_error(val_df[TARGET_COLUMN], np.full(len(val_df), train_df_full[TARGET_COLUMN].median()))); print(f'TRIVIAL_BASELINE_RMSE={trivial_rmse}'); automl = TabularAutoML(task=Task('reg'), timeout=60); automl.fit_predict(train_df, roles={'target': TARGET_COLUMN}); val_preds = automl.predict(val_df).data.reshape(-1); val_rmse = np.sqrt(mean_squared_error(val_df[TARGET_COLUMN], val_preds)); print(f'VALIDATION_SCORE={val_rmse}'); test_preds = np.full(len(test_df), train_df_full[TARGET_COLUMN].median()) if val_rmse >= trivial_rmse else automl.predict(test_df).data.reshape(-1); pd.DataFrame({'target': test_preds}).to_csv('/app/predictions.csv', index=False); print('MODEL_USED=', type(automl).__name__)\"\n"]
