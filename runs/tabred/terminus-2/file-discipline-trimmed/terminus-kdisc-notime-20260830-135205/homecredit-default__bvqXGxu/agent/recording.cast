[63.824285, "o", "\r\n\u001b[?2004l\r"]
[65.868502, "i", "cat << 'EOF' > train_model.py\nimport pandas as pd\nimport numpy as np\nimport torch\nfrom lightgbm import LGBMClassifier\nfrom sklearn.metrics import roc_auc_score\n\n# REQUIRED Hardware selection\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\ndef load_data():\n    train = pd.read_csv('/app/data/train.csv')\n    val = pd.read_csv('/app/data/val.csv')\n    test = pd.read_csv('/app/data/test.csv')\n    return train, val, test\n\nif __name__ == '__main__':\n    train, val, test = load_data()\n    \n    X_train = train.drop(columns=['target'])\n    y_train = train['target']\n    X_val = val.drop(columns=['target'])\n    y_val = val['target']\n    X_test = test\n\n    # Identify categorical features\n    cat_cols = [col for col in X_train.columns if col.startswith('cat_')]\n    \n    # Use scale_pos_weight for imbalance: sum(negative) / sum(positive)\n    ratio = (y_train == 0).sum() / (y_train == 1).sum()\n    \n    model = LGBMClassifier(\n        n_estimators=1000,\n        learning_rate=0.05,\n        num_leaves=31,\n        scale_pos_weight=ratio,\n        random_state=42,\n        n_jobs=-1\n    )\n    \n    model.fit(\n        X_train, y_train,\n        eval_set=[(X_val, y_val)],\n        eval_metric='auc',\n        callbacks=[torch.nn.modules.utils.dummy if False else None] # just to avoid issues, not used\n    )\n    \n    # The LGBMClassifier fit with eval_set doesn't automatically use best iteration\n    # manually find best iteration or just use the fitted model\n    # For simplicity in this first pass, we use the fitted model\n    \n    val_preds = model.predict_proba(X_val)[:, 1]\n    auc = roc_auc_score(y_val, val_preds)\n    print(f'Model ROC-AUC: {auc}')\n    \n    test_preds = model.predict_proba(X_test)[:, 1]\n    pd.DataFrame({'target': test_preds}).to_csv('/app/predictions.csv', index=False)\n    print('Predictions saved to /app/predictions.csv')\nEOF\n"]
[65.869137, "o", "cat << 'EOF' > train_model.py\r\nimport pandas as pd\r\nimport numpy as np\r\nimport torch\r\nfrom lightgbm import LGBMClassifier\r\nfrom sklearn.metrics import roc_auc_score\r\n\r\n# REQUIRED Hardware selection\r\nDEVICE = ('cuda' if torch.cuda.is_available()\r\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\r\nprint('DEVICE=', DEVICE)\r\n\r\ndef load_data():\r\n    train = pd.read_csv('/app/data/train.csv')\r\n    val = pd.read_csv('/app/data/val.csv')\r\n    test = pd.read_csv('/app/data/test.csv')\r\n    return train, val, test\r\n\r\nif __name__ == '__main__':\r\n    train, val, test = load_data()\r\n    \r\n    X_train = train.drop(columns=['target'])\r\n    y_train = train['target']\r\n    X_val = val.drop(columns=['target'])\r\n    y_val = val['target']\r\n    X_test = test\r\n\r\n    # Identify categorical features\r\n    cat_cols = [col for col in X_train.columns if col.startswith('cat_')]\r\n    \r\n    # Use scale_pos_weight for imbalance: sum(negative) / sum(positive)\r\n    ratio = (y_train == 0).sum() / (y_train == 1).sum()\r\n    \r\n    model = LGBMClassifier(\r\n        n_estimators=1000,\r\n        learning_rate=0.05,\r\n        num_leaves=31,\r\n        scale_pos_weight=ratio,\r\n        random_state=42,\r\n        n_jobs=-1\r\n    )\r\n    \r\n    model.fit(\r\n        X_train, y_train,\r\n        eval_set=[(X_val, y_val)],\r\n        eval_metric='auc',\r\n        callbacks=[torch.nn.modules.utils.dummy if False else None] # just to avoid issues, not used\r\n    )\r\n    \r\n    # The LGBMClassifier fit with eval_set doesn't automatically use best iteration\r\n    # manually find best iteration or just use the fitted model\r\n    # For simplicity in this first pass, we use the fitted model\r\n    \r\n    val_preds = model.predict_proba(X_val)[:, 1]\r\n    auc = roc_auc_score(y_val, val_preds)\r\n    print(f'Model ROC-AUC: {auc}')\r\n    \r\n    test_preds = model.predict_proba(X_test)[:, 1]\r\n    pd.DataFrame({'target': test_preds}).to_csv('/app/predictions.csv', index=False)\r\n    print('Predictions saved to /app/predictions.csv')\r\nEOF\r\n"]
[66.003107, "i", "python3 train_model.py\n"]
[66.003423, "o", "python3 train_model.py\r\n"]
