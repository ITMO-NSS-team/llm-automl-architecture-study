[?2004hroot@92796fc28ebf:/workspace# cat << 'EOF' > solution.py
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import torch
[?2004l[?2004h> from lightgbm import LGBMRegressor
[?2004l[?2004h> from sklearn.metrics import mean_squared_error
[?2004l[?2004h> import os
[?2004l[?2004h> 
[?2004l[?2004h> # Resolve the compute device as REQUIRED
[?2004l[?2004h> DEVICE = ('cuda' if torch.cuda.is_available()
[?2004l[?2004h>           else 'mps' if torch.backends.mps.is_available() else 'cpu')
[?2004l[?2004h> print('DEVICE=', DEVICE)
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h> print('Loading data...')
[?2004l[?2004h> train_df = pd.read_csv('/app/data/train.csv')
[?2004l[?2004h> val_df = pd.read_csv('/app/data/val.csv')
[?2004l[?2004h> test_df = pd.read_csv('/app/data/test.csv')
[?2004l[?2004h> 
[?2004l[?2004h> target_col = 'target'
[?2004l[?2004h> features = [col for col in train_df.columns if col != target_col]
[?2004l[?2004h> 
[?2004l[?2004h> X_train = train_df[features]
[?2004l[?2004h> y_train = train_df[target_col]
[?2004l[?2004h> X_val = val_df[features]
[?2004l[?2004h> y_val = val_df[target_col]
[?2004l[?2004h> 
[?2004l[?2004h> # Handle missing values for LightGBM
[?2004l[?2004h> # LightGBM handles NaNs natively, but we should ensure types are correct
[?2004l[?2004h> # Numerical: num_*, Binary: bin_*, Categorical: cat_*
[?2004l[?2004h> for col in features:
[?2004l[?2004h>     if col.startswith('cat_') or col.startswith('bin_'):
[?2004l[?2004h>         X_train[col] = X_train[col].astype('category')
[?2004l[?2004h>         X_val[col] = X_val[col].astype('category')
[?2004l[?2004h>         test_df[col] = test_df[col].astype('category')
[?2004l[?2004h> 
[?2004l[?2004h> # Trivial Baseline: Median
[?2004l[?2004h> median_val = y_train.median()
[?2004l[?2004h> baseline_preds = np.full(len(y_val), median_val)
[?2004l[?2004h> baseline_rmse = np.sqrt(mean_squared_error(y_val, baseline_preds))
[?2004l[?2004h> print(f'Baseline (Median) RMSE: {baseline_rmse}')
[?2004l[?2004h> 
[?2004l[?2004h> # Train Model
[?2004l[?2004h> print('Training LightGBM model...')
[?2004l[?2004h> model = LGBMRegressor(n_estimators=1000, learning_rate=0.05, num_leaves=31, device=DEVICE if DEVICE != 'mps' else 'cpu')
[?2004l[?2004h> # LightGBM doesn't support 'mps' directly in the same way as torch, 
[?2004l[?2004h> # so we use 'cpu' or 'gpu' (cuda). 
[?2004l[?2004h> # If DEVICE is 'mps', we stay on 'cpu' for LGBM as it's typically fastest anyway.
[?2004l[?2004h> if DEVICE == 'cuda':
[?2004l[?2004h>     model.set_params(device='gpu')
[?2004l[?2004h> 
[?2004l[?2004h> model.fit(
[?2004l[?2004h>     X_train, y_train,
[?2004l[?2004h>     eval_set=[(X_val, y_val)],
[?2004l[?2004h>     eval_metric='rmse',
[?2004l[?2004h>     callbacks=[lambda x: None] # suppress output
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> # Evaluate Model
[?2004l[?2004h> model_preds = model.predict(X_val)
[?2004l[?2004h> model_rmse = np.sqrt(mean_squared_error(y_val, model_preds))
[?2004l[?2004h> print(f'Model RMSE: {model_rmse}')
[?2004l[?2004h> 
[?2004l[?2004h> if model_rmse < baseline_rmse:
[?2004l[?2004h>     print('Model beats baseline. Generating predictions...')
[?2004l[?2004h>     test_preds = model.predict(test_df)
[?2004l[?2004h>     pd.DataFrame({'target': test_preds}).to_csv('/app/predictions.csv', index=False)
[?2004l[?2004h> else:
[?2004l[?2004h>     print('Model failed to beat baseline. Using median...')
[?2004l[?2004h>     test_preds = np.full(len(test_df), median_val)
[?2004l[?2004h>     pd.DataFrame({'target': test_preds}).to_csv('/app/predictions.csv', index=False)
[?2004l[?2004h> 
[?2004l[?2004h> print('Process complete.')
[?2004l[?2004h> EOF
[?2004lpython3 solution.py
