[34.119127, "i", "cat << 'EOF' > solve.py\nimport pandas as pd\nimport numpy as np\nfrom sklearn.metrics import roc_auc_score\nimport lightgbm as lgb\nimport torch\nimport os\n\n# Resolve compute device as required\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\n# Load data\ntrain_df = pd.read_csv('/app/data/train.csv')\nval_df = pd.read_csv('/app/data/val.csv')\ntest_df = pd.read_csv('/app/data/test.csv')\n\nX_train = train_df.drop('target', axis=1)\ny_train = train_df['target']\nX_val = val_df.drop('target', axis=1)\ny_val = val_df['target']\n\n# Trivial Baseline: Constant prediction (mean of training target)\n# For ROC-AUC, a constant prediction usually gives 0.5, but let's be precise.\ntrain_mean = y_train.mean()\nbaseline_preds = np.full(len(y_val), train_mean)\nbaseline_auc = roc_auc_score(y_val, baseline_preds)\nprint(f'Trivial Baseline ROC-AUC: {baseline_auc:.4f}')\n\n# Model Training\n# Using LightGBM as it's efficient for tabular data\nmodel = lgb.LGBMClassifier(\n    n_estimators=1000,\n    learning_rate=0.05,\n    num_leaves=31,\n    device=DEVICE if DEVICE != 'mps' else 'cpu', # LGBM doesn't natively support mps well, use cpu if needed\n    random_state=42,\n    n_jobs=-1\n)\n\nmodel.fit(\n    X_train, y_train,\n    eval_set=[(X_val, y_val)],\n    eval_metric='auc',\n    callbacks=[lgb.early_stopping(stopping_rounds=50)]\n)\n\n# Predict probabilities for positive class\nval_probs = model.predict_proba(X_val)[:, 1]\nmodel_auc = roc_auc_score(y_val, val_probs)\nprint(f'Model ROC-AUC: {model_auc:.4f}')\n\nif model_auc > baseline_auc:\n    print('Model beat baseline. Generating predictions...')\n    test_probs = model.predict_proba(test_df)[:, 1]\n    # Save only the target column\n    predictions_df = pd.DataFrame({'target': test_probs})\n    predictions_df.to_csv('/app/predictions.csv', index=False)\n    print('Predictions saved to /app/predictions.csv')\nelse:\n    print('Model did not beat baseline. Using baseline instead.')\n    # In case model fails, ROC-AUC is 0.5 for constant, but required to beat trivial\n    # For ROC-AUC, predicting the mean doesn't really 'work', but the prompt requires it.\n    # We'll just output the probabilities from the model if it's the best we have,\n    # but the logic above ensures we only save if it's better.\n    # Actually, if we must submit, we'll submit the best available.\n    test_probs = model.predict_proba(test_df)[:, 1]\n    predictions_df = pd.DataFrame({'target': test_probs})\n    predictions_df.to_csv('/app/predictions.csv', index=False)\n\nEOF\n"]
[34.119991, "o", "cat << 'EOF' > solve.py"]
