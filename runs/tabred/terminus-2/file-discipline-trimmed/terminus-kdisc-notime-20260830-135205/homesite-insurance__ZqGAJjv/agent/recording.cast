[42.346421, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> model.fit(\r\n\u001b[?2004l\r\u001b[?2004h>     X_train, y_train,\r\n\u001b[?2004l\r\u001b[?2004h>     eval_set=[(X_val, y_val)],\r\n\u001b[?2004l\r\u001b[?2004h>     eval_metric='auc',\r\n\u001b[?2004l\r\u001b[?2004h>     callbacks=[lgb.early_stopping(stopping_rounds=50)]\r\n\u001b[?2004l\r\u001b[?2004h> )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Evaluate\r\n\u001b[?2004l\r\u001b[?2004h> val_preds = model.predict_proba(X_val)[:, 1]\r\n\u001b[?2004l\r\u001b[?2004h> model_auc = roc_auc_score(y_val, val_preds)\r\n\u001b[?2004l\r\u001b[?2004h> print(f'Model ROC-AUC: {model_auc}')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> if model_auc > baseline_auc:\r\n\u001b[?2004l\r\u001b[?2004h>     print('Model beats baseline. Generating predictions...')\r\n\u001b[?2004l\r\u001b[?2004h>     test_preds = model.predict_proba(test)[:, 1]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.3465, "o", "    pd.DataFrame({'target': test_preds}).to_csv('/app/predictions.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h"]
[42.346588, "o", "> "]
[42.346673, "o", "    print('Predictions saved to /app/predictions.csv')\r\n\u001b[?2004l\r\u001b[?2004h> else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[42.346735, "o", "> "]
[42.346796, "o", "    print('Model did not beat baseline. Saving baseline predictions...')\r\n\u001b[?2004l\r"]
[42.346861, "o", "\u001b[?2004h> "]
[42.346923, "o", "    test_preds = np.full(len(test), mean_val)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.347072, "o", "    pd.DataFrame({'target': test_preds}).to_csv('/app/predictions.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h"]
[42.347106, "o", "> "]
[42.34721, "o", "    print('Baseline predictions saved to /app/predictions.csv')\r\n\u001b[?2004l\r"]
