[33.251821, "o", "\u001b[33mWARNING: Running pip as the 'root' user can result in broken permissions and conflicting behaviour with the system package manager, possibly rendering your system unusable. It is recommended to use a virtual environment instead: https://pip.pypa.io/warnings/venv. Use the --root-user-action option if you know what you are doing and want to suppress this warning.\u001b[0m\u001b[33m\r\n\u001b[0m"]
[33.605003, "o", "\r\n\u001b[1m[\u001b[0m\u001b[34;49mnotice\u001b[0m\u001b[1;39;49m]\u001b[0m\u001b[39;49m A new release of pip is available: \u001b[0m\u001b[31;49m25.0.1\u001b[0m\u001b[39;49m -> \u001b[0m\u001b[32;49m26.2.1\u001b[0m\r\n\u001b[1m[\u001b[0m\u001b[34;49mnotice\u001b[0m\u001b[1;39;49m]\u001b[0m\u001b[39;49m To update, run: \u001b[0m\u001b[32;49mpip install --upgrade pip\u001b[0m\r\n"]
[33.659212, "o", "\u001b[?2004hroot@92ba54cca9db:/workspace# "]
[42.338556, "i", "cat << 'EOF' > solution.py\nimport pandas as pd\nimport numpy as np\nfrom sklearn.metrics import roc_auc_score\nimport lightgbm as lgb\nimport torch\n\n# REQUIRED DEVICE RESOLUTION\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\n# Load data\ntrain = pd.read_csv('/app/data/train.csv')\nval = pd.read_csv('/app/data/val.csv')\ntest = pd.read_csv('/app/data/test.csv')\n\nX_train = train.drop(columns=['target'])\ny_train = train['target']\nX_val = val.drop(columns=['target'])\ny_val = val['target']\n\n# Baseline: Training mean\nmean_val = y_train.mean()\nbaseline_preds = np.full(len(y_val), mean_val)\nbaseline_auc = roc_auc_score(y_val, baseline_preds)\nprint(f'Baseline ROC-AUC: {baseline_auc}')\n\n# Preprocessing\n# Identify categories\ncat_cols = [col for col in X_train.columns if col.startswith('cat_') or col.startswith('bin_')]\nnum_cols = [col for col in X_train.columns if col.startswith('num_')]\n\nfor col in cat_cols:\n    X_train[col] = X_train[col].astype('category')\n    X_val[col] = X_val[col].astype('category')\n    test[col] = test[col].astype('category')\n\n# Train LightGBM\nmodel = lgb.LGBMClassifier(\n    n_estimators=1000,\n    learning_rate=0.05,\n    num_leaves=31,\n    objective='binary',\n    metric='auc',\n    random_state=42,\n    device= 'gpu' if DEVICE == 'cuda' else 'cpu' # LGBM doesn't support mps directly in this way, fallback to cpu\n)\n\nmodel.fit(\n    X_train, y_train,\n    eval_set=[(X_val, y_val)],\n    eval_metric='auc',\n    callbacks=[lgb.early_stopping(stopping_rounds=50)]\n)\n\n# Evaluate\nval_preds = model.predict_proba(X_val)[:, 1]\nmodel_auc = roc_auc_score(y_val, val_preds)\nprint(f'Model ROC-AUC: {model_auc}')\n\nif model_auc > baseline_auc:\n    print('Model beats baseline. Generating predictions...')\n    test_preds = model.predict_proba(test)[:, 1]\n    pd.DataFrame({'target': test_preds}).to_csv('/app/predictions.csv', index=False)\n    print('Predictions saved to /app/predictions.csv')\nelse:\n    print('Model did not beat baseline. Saving baseline predictions...')\n    test_preds = np.full(len(test), mean_val)\n    pd.DataFrame({'target': test_preds}).to_csv('/app/predictions.csv', index=False)\n    print('Baseline predictions saved to /app/predictions.csv')\nEOF\n"]
