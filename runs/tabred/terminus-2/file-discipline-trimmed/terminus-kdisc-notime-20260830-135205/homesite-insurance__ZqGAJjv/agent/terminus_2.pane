[?2004hroot@92ba54cca9db:/workspace# cat << 'EOF' > solution.py
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from sklearn.metrics import roc_auc_score
[?2004l[?2004h> import lightgbm as lgb
[?2004l[?2004h> import torch
[?2004l[?2004h> 
[?2004l[?2004h> # REQUIRED DEVICE RESOLUTION
[?2004l[?2004h> DEVICE = ('cuda' if torch.cuda.is_available()
[?2004l[?2004h>           else 'mps' if torch.backends.mps.is_available() else 'cpu')
[?2004l[?2004h> print('DEVICE=', DEVICE)
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h> train = pd.read_csv('/app/data/train.csv')
[?2004l[?2004h> val = pd.read_csv('/app/data/val.csv')
[?2004l[?2004h> test = pd.read_csv('/app/data/test.csv')
[?2004l[?2004h> 
[?2004l[?2004h> X_train = train.drop(columns=['target'])
[?2004l[?2004h> y_train = train['target']
[?2004l[?2004h> X_val = val.drop(columns=['target'])
[?2004l[?2004h> y_val = val['target']
[?2004l[?2004h> 
[?2004l[?2004h> # Baseline: Training mean
[?2004l[?2004h> mean_val = y_train.mean()
[?2004l[?2004h> baseline_preds = np.full(len(y_val), mean_val)
[?2004l[?2004h> baseline_auc = roc_auc_score(y_val, baseline_preds)
[?2004l[?2004h> print(f'Baseline ROC-AUC: {baseline_auc}')
[?2004l[?2004h> 
[?2004l[?2004h> # Preprocessing
[?2004l[?2004h> # Identify categories
[?2004l[?2004h> cat_cols = [col for col in X_train.columns if col.startswith('cat_') or col.startswith('bin_')]
[?2004l[?2004h> num_cols = [col for col in X_train.columns if col.startswith('num_')]
[?2004l[?2004h> 
[?2004l[?2004h> for col in cat_cols:
[?2004l[?2004h>     X_train[col] = X_train[col].astype('category')
[?2004l[?2004h>     X_val[col] = X_val[col].astype('category')
[?2004l[?2004h>     test[col] = test[col].astype('category')
[?2004l[?2004h> 
[?2004l[?2004h> # Train LightGBM
[?2004l[?2004h> model = lgb.LGBMClassifier(
[?2004l[?2004h>     n_estimators=1000,
[?2004l[?2004h>     learning_rate=0.05,
[?2004l[?2004h>     num_leaves=31,
[?2004l[?2004h>     objective='binary',
[?2004l[?2004h>     metric='auc',
[?2004l[?2004h>     random_state=42,
[?2004l[?2004h>     device= 'gpu' if DEVICE == 'cuda' else 'cpu' # LGBM doesn't support mps directly in this way, fallback to cpu
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> model.fit(
[?2004l[?2004h>     X_train, y_train,
[?2004l[?2004h>     eval_set=[(X_val, y_val)],
[?2004l[?2004h>     eval_metric='auc',
[?2004l[?2004h>     callbacks=[lgb.early_stopping(stopping_rounds=50)]
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> # Evaluate
[?2004l[?2004h> val_preds = model.predict_proba(X_val)[:, 1]
[?2004l[?2004h> model_auc = roc_auc_score(y_val, val_preds)
[?2004l[?2004h> print(f'Model ROC-AUC: {model_auc}')
[?2004l[?2004h> 
[?2004l[?2004h> if model_auc > baseline_auc:
[?2004l[?2004h>     print('Model beats baseline. Generating predictions...')
[?2004l[?2004h>     test_preds = model.predict_proba(test)[:, 1]
[?2004l[?2004h>     pd.DataFrame({'target': test_preds}).to_csv('/app/predictions.csv', index=False)
[?2004l[?2004h>     print('Predictions saved to /app/predictions.csv')
[?2004l[?2004h> else:
[?2004l[?2004h>     print('Model did not beat baseline. Saving baseline predictions...')
[?2004l[?2004h>     test_preds = np.full(len(test), mean_val)
[?2004l[?2004h>     pd.DataFrame({'target': test_preds}).to_csv('/app/predictions.csv', index=False)
[?2004l[?2004h>     print('Baseline predictions saved to /app/predictions.csv')
[?2004l[?2004h> EOF
