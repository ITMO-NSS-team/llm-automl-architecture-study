[?2004hroot@b48347c36364:/workspace# cat << 'EOF' > solution.py
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from lightgbm import LGBMRegressor
[?2004l[?2004h> from sklearn.metrics import mean_squared_error
[?2004l[?2004h> import torch
[?2004l[?2004h> 
[?2004l[?2004h> # Hardware resolution as required
[?2004l[?2004h> DEVICE = ('cuda' if torch.cuda.is_available()
[?2004l[?2004h>           else 'mps' if torch.backends.mps.is_available() else 'cpu')
[?2004l[?2004h> print('DEVICE=', DEVICE)
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h> train = pd.read_csv('/app/data/train.csv')
[?2004l[?2004h> val = pd.read_csv('/app/data/val.csv')
[?2004l[?2004h> test = pd.read_csv('/app/data/test.csv')
[?2004l[?2004h> 
[?2004l[?2004h> # Split features and target
[?2004l[?2004h> X_train = train.drop(columns=['target'])
[?2004l[?2004h> y_train = train['target']
[?2004l[?2004h> X_val = val.drop(columns=['target'])
[?2004l[?2004h> y_val = val['target']
[?2004l[?2004h> 
[?2004l[?2004h> # Trivial Baseline: Median of training target
[?2004l[?2004h> baseline_val = np.full(len(y_val), y_train.median())
[?2004l[?2004h> baseline_rmse = np.sqrt(mean_squared_error(y_val, baseline_val))
[?2004l[?2004h> print(f'Baseline RMSE: {baseline_rmse}')
[?2004l[?2004h> 
[?2004l[?2004h> # Train LightGBM model
[?2004l[?2004h> model = LGBMRegressor(n_estimators=1000, learning_rate=0.05, random_state=42, n_jobs=-1)
[?2004l[?2004h> model.fit(X_train, y_train, eval_set=[(X_val, y_val)], eval_metric='rmse', callbacks=[])
[?2004l[?2004h> # Note: LightGBM doesn't use torch, so DEVICE isn't applied to it, 
[?2004l[?2004h> # but we print it as required by the prompt.
[?2004l[?2004h> 
[?2004l[?2004h> # Validate model
[?2004l[?2004h> val_preds = model.predict(X_val)
[?2004l[?2004h> model_rmse = np.sqrt(mean_squared_error(y_val, val_preds))
[?2004l[?2004h> print(f'Model RMSE: {model_rmse}')
[?2004l[?2004h> 
[?2004l[?2004h> if model_rmse < baseline_rmse:
[?2004l[?2004h>     print('Model beats baseline. Generating predictions...')
[?2004l[?2004h>     test_preds = model.predict(test)
[?2004l[?2004h>     pd.DataFrame({'target': test_preds}).to_csv('/app/predictions.csv', index=False)
[?2004l[?2004h>     print('Predictions saved to /app/predictions.csv')
[?2004l[?2004h> else:
[?2004l[?2004h>     print('Model did not beat baseline. Using baseline predictions...')
[?2004l[?2004h>     test_preds = np.full(len(test), y_train.median())
[?2004l[?2004h>     pd.DataFrame({'target': test_preds}).to_csv('/app/predictions.csv', index=False)
[?2004l[?2004h>     print('Baseline predictions saved to /app/predictions.csv')
[?2004l[?2004h> 
[?2004l[?2004h> EOF
