[17.647884, "i", "cat << 'EOF' > baseline.py\nimport pandas as pd\nimport numpy as np\nfrom sklearn.metrics import mean_squared_error\n\ndef rmse(y_true, y_pred):\n    return np.sqrt(mean_squared_error(y_true, y_pred))\n\ntrain = pd.read_csv('/app/data/train.csv')\nval = pd.read_csv('/app/data/val.csv')\n\ntrain_mean = train['target'].mean()\nval_target = val['target']\nval_pred = np.full(len(val_target), train_mean)\n\nscore = rmse(val_target, val_pred)\nprint(f'Training Mean: {train_mean}')\nprint(f'Baseline RMSE: {score}')\nEOF\n"]
[17.648655, "o", "cat << 'EOF' > baseline.py\r\n\u001b[?2004l\r\u001b[?2004h> import pandas as pd\r\n\u001b[?2004l\r\u001b[?2004h> "]
