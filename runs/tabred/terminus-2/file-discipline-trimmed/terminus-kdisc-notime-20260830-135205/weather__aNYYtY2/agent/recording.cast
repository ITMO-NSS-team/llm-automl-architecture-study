[55.093612, "o", "root@5d26729653d3:/workspace# "]
[101.474571, "i", "cat << 'EOF' > train_model.py\nimport pandas as pd\nimport numpy as np\nimport lightgbm as lgb\nfrom sklearn.metrics import mean_squared_error\nimport torch\nimport os\n\n# REQUIRED Hardware resolution\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\ndef rmse(y_true, y_pred):\n    return np.sqrt(mean_squared_error(y_true, y_pred))\n\n# Load data\nprint('Loading data...')\ntrain = pd.read_csv('/app/data/train.csv')\nval = pd.read_csv('/app/data/val.csv')\ntest = pd.read_csv('/app/data/test.csv')\n\ntrain_x = train.drop(columns=['target'])\ntrain_y = train['target']\nval_x = val.drop(columns=['target'])\nval_y = val['target']\n\n# Baseline\ntrain_mean = train_y.mean()\nbaseline_rmse = rmse(val_y, np.full(len(val_y), train_mean))\nprint(f'Baseline RMSE: {baseline_rmse}')\n\n# LightGBM Model\nprint('Training LightGBM...')\nlgb_train = lgb.Dataset(train_x, label=train_y)\nlgb_val = lgb.Dataset(val_x, label=val_y, reference=lgb_train)\n\nparams = {\n    'objective': 'regression',\n    'metric': 'rmse',\n    'verbosity': -1,\n    'boosting_type': 'gbdt',\n    'random_state': 42,\n    'learning_rate': 0.05,\n    'num_leaves': 31,\n    'feature_fraction': 0.8,\n    'bagging_fraction': 0.8,\n    'bagging_freq': 5\n}\n\nmodel = lgb.train(\n    params,\n    lgb_train,\n    num_boost_round=1000,\n    valid_sets=[lgb_train, lgb_val],\n    callbacks=[lgb.early_stopping(stopping_rounds=50)]\n)\n\n# Predict and Evaluate\nval_preds = model.predict(val_x)\nval_rmse = rmse(val_y, val_preds)\nprint(f'Model RMSE: {val_rmse}')\n\nif val_rmse < baseline_rmse:\n    print('Model beats baseline!')\n    # Save model\n    model.save_model('best_model.txt')\n    \n    # Final Predictions\n    print('Generating test predictions...')\n    test_preds = model.predict(test)\n    submission = pd.DataFrame({'target': test_preds})\n    submission.to_csv('/app/predictions.csv', index=False)\n    print('Predictions saved to /app/predictions.csv')\nelse:\n    print('Model failed to beat baseline. Using baseline for submission.')\n    test_preds = np.full(len(test), train_mean)\n    submission = pd.DataFrame({'target': test_preds})\n    submission.to_csv('/app/predictions.csv', index=False)\n    print('Baseline predictions saved to /app/predictions.csv')\nEOF\n"]
[101.475695, "o", "cat << 'EOF' > train_model.py\r\n\u001b[?2004l\r"]
[101.475948, "o", "\u001b[?2004h"]
