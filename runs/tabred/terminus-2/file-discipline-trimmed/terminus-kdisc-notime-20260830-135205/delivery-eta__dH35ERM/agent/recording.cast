[50.593068, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[50.593193, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[50.593274, "o", "> model = xgb.XGBRegressor("]
[50.593371, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.59344, "o", "    n_estimators=1000,"]
[50.593532, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.593594, "o", "    learning_rate=0.05,"]
[50.593685, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[50.593747, "o", ">     max_depth=6,"]
[50.593835, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[50.593898, "o", ">     tree_method='hist',"]
[50.594111, "o", "\r\n\u001b[?2004l\r"]
[50.59418, "o", "\u001b[?2004h>     device=DEVICE if DEVICE != 'mps' else 'cpu', # XGBoost uses 'cuda' or 'cpu'"]
[50.594276, "o", "\r\n"]
[50.594397, "o", "\u001b[?2004l\r"]
[50.594457, "o", "\u001b[?2004h>     early_stopping_rounds=50,"]
[50.594568, "o", "\r\n"]
[50.594645, "o", "\u001b[?2004l\r\u001b[?2004h>     eval_metric='rmse'"]
[50.594722, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[50.594805, "o", "> )\r\n\u001b[?2004l\r\u001b[?2004h"]
[50.595009, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.595079, "o", "# If DEVICE is cuda, we use gpu_id=0 or similar, but 'device' param in newer XGB handles it."]
[50.595128, "o", "\r\n"]
[50.595337, "o", "\u001b[?2004l\r"]
[50.595399, "o", "\u001b[?2004h> # To be safe with the requirement, we'll use 'cuda' if available."]
[50.595528, "o", "\r\n\u001b[?2004l\r"]
[50.595584, "o", "\u001b[?2004h> if DEVICE == 'cuda':"]
[50.595719, "o", "\r\n"]
[50.595796, "o", "\u001b[?2004l\r\u001b[?2004h>     model.set_params(device='cuda')"]
[50.59587, "o", "\r\n\u001b[?2004l\r"]
[50.595959, "o", "\u001b[?2004h> \r\n"]
[50.596084, "o", "\u001b[?2004l\r\u001b[?2004h> model.fit("]
[50.596154, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     X_train, y_train,"]
[50.596288, "o", "\r\n\u001b[?2004l\r"]
[50.59635, "o", "\u001b[?2004h>     eval_set=[(X_val, y_val)],"]
[50.596479, "o", "\r\n"]
[50.596551, "o", "\u001b[?2004l\r\u001b[?2004h>     verbose=100\r\n\u001b[?2004l\r"]
[50.596638, "o", "\u001b[?2004h> )\r\n\u001b[?2004l\r"]
[50.596743, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[50.596813, "o", "> val_preds = model.predict(X_val)"]
[50.596982, "o", "\r\n\u001b[?2004l\r"]
[50.597026, "o", "\u001b[?2004h> model_rmse = np.sqrt(mean_squared_error(y_val, val_preds))"]
[50.597234, "o", "\r\n\u001b[?2004l\r"]
[50.597308, "o", "\u001b[?2004h> "]
[50.597401, "o", "print(f'Model RMSE: {model_rmse}')\r\n"]
[50.597536, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[50.597597, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> if model_rmse < baseline_rmse:"]
[50.597728, "o", "\r\n"]
[50.597767, "o", "\u001b[?2004l\r\u001b[?2004h>     print('Model beats baseline!')"]
[50.5979, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[50.597965, "o", ">     # Predict test set"]
[50.598107, "o", "\r\n\u001b[?2004l\r"]
[50.598172, "o", "\u001b[?2004h>     test_preds = model.predict(test)"]
[50.598423, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     pd.DataFrame({'target': test_preds}).to_csv('/app/predictions.csv', index=False)"]
[50.598483, "o", "\r\n\u001b[?2004l\r"]
[50.598551, "o", "\u001b[?2004h"]
[50.598695, "o", ">     print('Predictions saved to /app/predictions.csv')"]
[50.598766, "o", "\r\n"]
[50.598866, "o", "\u001b[?2004l\r\u001b[?2004h"]
[50.59907, "o", "> else:\r\n"]
[50.599135, "o", "\u001b[?2004l\r\u001b[?2004h>     print('Model failed to beat baseline. Using baseline predictions.')"]
[50.59921, "o", "\r\n"]
[50.599366, "o", "\u001b[?2004l\r"]
[50.599408, "o", "\u001b[?2004h>     test_preds = np.full(len(test), median_val)"]
[50.599658, "o", "\r\n\u001b[?2004l\r"]
[50.599717, "o", "\u001b[?2004h>     pd.DataFrame({'target': test_preds}).to_csv('/app/predictions.csv', index=False)"]
[50.599798, "o", "\r\n\u001b[?2004l\r"]
[50.599971, "o", "\u001b[?2004h"]
[50.600031, "o", ">     print('Baseline predictions saved to /app/predictions.csv')"]
[50.60013, "o", "\r\n"]
[50.600424, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[50.600465, "o", "EOF\r\n\u001b[?2004l\r"]
