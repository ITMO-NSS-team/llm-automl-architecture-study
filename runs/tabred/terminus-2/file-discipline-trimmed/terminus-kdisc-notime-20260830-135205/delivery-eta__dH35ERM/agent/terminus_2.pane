[?2004hroot@f645a8fae298:/workspace# cat << 'EOF' > baseline_and_train.py
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from sklearn.metrics import mean_squared_error
[?2004l[?2004h> import torch
[?2004l[?2004h> import xgboost as xgb
[?2004l[?2004h> 
[?2004l[?2004h> # Required hardware device resolution
[?2004l[?2004h> DEVICE = ('cuda' if torch.cuda.is_available()
[?2004l[?2004h>           else 'mps' if torch.backends.mps.is_available() else 'cpu')
[?2004l[?2004h> print('DEVICE=', DEVICE)
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h> print('Loading data...')
[?2004l[?2004h> train = pd.read_csv('/app/data/train.csv')
[?2004l[?2004h> val = pd.read_csv('/app/data/val.csv')
[?2004l[?2004h> test = pd.read_csv('/app/data/test.csv')
[?2004l[?2004h> 
[?2004l[?2004h> target_col = 'target'
[?2004l[?2004h> 
[?2004l[?2004h> # Trivial Baseline: Median of training target
[?2004l[?2004h> median_val = train[target_col].median()
[?2004l[?2004h> baseline_preds = np.full(len(val), median_val)
[?2004l[?2004h> baseline_rmse = np.sqrt(mean_squared_error(val[target_col], baseline_preds))
[?2004l[?2004h> print(f'Trivial Baseline (Median): {median_val}')
[?2004l[?2004h> print(f'Baseline RMSE: {baseline_rmse}')
[?2004l[?2004h> 
[?2004l[?2004h> # Preprocessing
[?2004l[?2004h> # Identify feature types
[?2004l[?2004h> num_cols = [c for c in train.columns if c.startswith('num_')]
[?2004l[?2004h> bin_cols = [c for c in train.columns if c.startswith('bin_')]
[?2004l[?2004h> cat_cols = [c for c in train.columns if c.startswith('cat_')]
[?2004l[?2004h> 
[?2004l[?2004h> # Fill numerical NaNs with median
[?2004l[?2004h> for col in num_cols:
[?2004l[?2004h>     train[col] = train[col].fillna(train[col].median())
[?2004l[?2004h>     val[col] = val[col].fillna(train[col].median())
[?2004l[?2004h>     test[col] = test[col].fillna(train[col].median())
[?2004l[?2004h> 
[?2004l[?2004h> # Simple categorical encoding (label encoding)
[?2004l[?2004h> for col in cat_cols:
[?2004l[?2004h>     train[col] = train[col].astype(str).astype('category').cat.codes
[?2004l[?2004h>     val[col] = val[col].astype(str).astype('category').cat.codes
[?2004l[?2004h>     test[col] = test[col].astype(str).astype('category').cat.codes
[?2004l[?2004h> 
[?2004l[?2004h> # Train XGBoost
[?2004l[?2004h> X_train = train.drop(columns=[target_col])
[?2004l[?2004h> y_train = train[target_col]
[?2004l[?2004h> X_val = val.drop(columns=[target_col])
[?2004l[?2004h> y_val = val[target_col]
[?2004l[?2004h> 
[?2004l[?2004h> model = xgb.XGBRegressor(
[?2004l[?2004h>     n_estimators=1000,
[?2004l[?2004h>     learning_rate=0.05,
[?2004l[?2004h>     max_depth=6,
[?2004l[?2004h>     tree_method='hist',
[?2004l[?2004h>     device=DEVICE if DEVICE != 'mps' else 'cpu', # XGBoost uses 'cuda' or 'cpu'
[?2004l[?2004h>     early_stopping_rounds=50,
[?2004l[?2004h>     eval_metric='rmse'
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> # If DEVICE is cuda, we use gpu_id=0 or similar, but 'device' param in newer XGB handles it.
[?2004l[?2004h> # To be safe with the requirement, we'll use 'cuda' if available.
[?2004l[?2004h> if DEVICE == 'cuda':
[?2004l[?2004h>     model.set_params(device='cuda')
[?2004l[?2004h> 
[?2004l[?2004h> model.fit(
[?2004l[?2004h>     X_train, y_train,
[?2004l[?2004h>     eval_set=[(X_val, y_val)],
[?2004l[?2004h>     verbose=100
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> val_preds = model.predict(X_val)
[?2004l[?2004h> model_rmse = np.sqrt(mean_squared_error(y_val, val_preds))
[?2004l[?2004h> print(f'Model RMSE: {model_rmse}')
[?2004l[?2004h> 
[?2004l[?2004h> if model_rmse < baseline_rmse:
[?2004l[?2004h>     print('Model beats baseline!')
[?2004l[?2004h>     # Predict test set
[?2004l[?2004h>     test_preds = model.predict(test)
[?2004l[?2004h>     pd.DataFrame({'target': test_preds}).to_csv('/app/predictions.csv', index=False)
[?2004l[?2004h>     print('Predictions saved to /app/predictions.csv')
[?2004l[?2004h> else:
[?2004l[?2004h>     print('Model failed to beat baseline. Using baseline predictions.')
[?2004l[?2004h>     test_preds = np.full(len(test), median_val)
[?2004l[?2004h>     pd.DataFrame({'target': test_preds}).to_csv('/app/predictions.csv', index=False)
[?2004l[?2004h>     print('Baseline predictions saved to /app/predictions.csv')
[?2004l[?2004h> 
[?2004l[?2004h> EOF
