[27.409411, "o", "Trivial Baseline (Median) RMSE: 0.3876076720129878\r\n"]
[27.532684, "o", "\u001b[?2004hroot@d0062f854a85:/workspace# "]
[53.386357, "i", "cat << 'EOF' > train_model.py\nimport pandas as pd\nimport numpy as np\nimport torch\nfrom catboost import CatBoostRegressor, Pool\nfrom sklearn.metrics import mean_squared_error\n\n# HARDWARE REQUIREMENT\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\n# Load data\ntrain_df = pd.read_csv('/app/data/train.csv')\nval_df = pd.read_csv('/app/data/val.csv')\ntest_df = pd.read_csv('/app/data/test.csv')\n\nX_train = train_df.drop('target', axis=1)\ny_train = train_df['target']\nX_val = val_df.drop('target', axis=1)\ny_val = val_df['target']\n\n# Identify categorical features (cat_ prefix)\ncat_features = [col for col in X_train.columns if col.startswith('cat_')]\n\n# Trivial baseline for comparison\ntrain_median = y_train.median()\nbaseline_rmse = np.sqrt(mean_squared_error(y_val, np.full(len(y_val), train_median)))\nprint(f'Trivial Baseline RMSE: {baseline_rmse}')\n\n# Initialize CatBoost\n# task_type='GPU' if DEVICE == 'cuda' else 'CPU'\n# Note: CatBoost handles GPU/CPU via task_type. 'mps' is not directly supported by CatBoost's task_type,\n# it typically uses CPU. If DEVICE is cuda, we use GPU.\nct_device = 'GPU' if DEVICE == 'cuda' else 'CPU'\n\nmodel = CatBoostRegressor(\n    iterations=2000,\n    learning_rate=0.05,\n    depth=6,\n    eval_metric='RMSE',\n    task_type=ct_device,\n    random_seed=42,\n    verbose=200\n)\n\nmodel.fit(\n    X_train, y_train,\n    eval_set=(X_val, y_val),\n    cat_features=cat_features,\n    early_stopping_rounds=100\n)\n\n# Validation\nval_preds = model.predict(X_val)\nval_rmse = np.sqrt(mean_squared_error(y_val, val_preds))\nprint(f'Model Validation RMSE: {val_rmse}')\n\nif val_rmse < baseline_rmse:\n    print('Model beats baseline! Generating predictions...')\n    test_preds = model.predict(test_df)\n    submission = pd.DataFrame({'target': test_preds})\n    submission.to_csv('/app/predictions.csv', index=False)\n    print('Predictions saved to /app/predictions.csv')\nelse:\n    print('Model did not beat baseline. Saving baseline predictions.')\n    test_preds = np.full(len(test_df), train_median)\n    submission = pd.DataFrame({'target': test_preds})\n    submission.to_csv('/app/predictions.csv', index=False)\n    print('Baseline predictions saved to /app/predictions.csv')\n\nEOF\n"]
