[40.425415, "i", "cat << 'EOF' > solution.py\nimport pandas as pd\nimport numpy as np\nimport torch\nfrom lightgbm import LGBMClassifier\nfrom sklearn.metrics import roc_auc_score\nimport json\n\n# HARDWARE RESOLUTION\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\ndef solve():\n    # Load schema\n    with open('/app/data/schema.json', 'r') as f:\n        schema = json.load(f)\n    \n    target_col = schema['target_column']\n    features = schema['feature_columns']\n    \n    # Load data\n    train = pd.read_csv('/app/data/train.csv')\n    val = pd.read_csv('/app/data/val.csv')\n    test = pd.read_csv('/app/data/test.csv')\n\n    # Separate features and target\n    X_train = train[features]\n    y_train = train[target_col]\n    X_val = val[features]\n    y_val = val[target_col]\n    X_test = test[features]\n\n    # Trivial Baseline: Training Mean\n    train_mean = y_train.mean()\n    baseline_preds = np.full(len(y_val), train_mean)\n    baseline_auc = roc_auc_score(y_val, baseline_preds)\n    print(f'Trivial Baseline AUC (Training Mean): {baseline_auc:.4f}')\n\n    # Preprocessing\n    # Identify feature types\n    num_cols = [c for c in features if c.startswith('num_')]\n    cat_cols = [c for c in features if c.startswith('cat_')]\n    bin_cols = [c for c in features if c.startswith('bin_')]\n\n    # Fill numeric NaNs with median\n    for col in num_cols:\n        median_val = X_train[col].median()\n        X_train[col] = X_train[col].fillna(median_val)\n        X_val[col] = X_val[col].fillna(median_val)\n        X_test[col] = X_test[col].fillna(median_val)\n\n    # Handle categories (LightGBM can handle categorical features if they are 'category' type)\n    for col in cat_cols + bin_cols:\n        X_train[col] = X_train[col].astype('category')\n        X_val[col] = X_val[col].astype('category')\n        X_test[col] = X_test[col].astype('category')\n\n    # Model Training\n    model = LGBMClassifier(n_estimators=1000, learning_rate=0.05, random_state=42, device=DEVICE if DEVICE != 'mps' else 'cpu')\n    # LightGBM's 'device' parameter is 'cpu', 'gpu'. For MPS, we use CPU as LGBM doesn't natively support MPS in all versions.\n    # If DEVICE is 'cuda', we use 'gpu'.\n    if DEVICE == 'cuda':\n        model.set_params(device='gpu')\n    \n    model.fit(\n        X_train, y_train,\n        eval_set=[(X_val, y_val)],\n        eval_metric='auc',\n        callbacks=[]) # Add early stopping if needed, but for now keep it simple\n    \n    # Predict probabilities\n    val_probs = model.predict_proba(X_val)[:, 1]\n    model_auc = roc_auc_score(y_val, val_probs)\n    print(f'Model AUC: {model_auc:.4f}')\n\n    if model_auc <= baseline_auc:\n        print('Model failed to beat baseline. Using baseline predictions.')\n        test_probs = np.full(len(X_test), train_mean)\n    else:\n        print('Model beat baseline!')\n        test_probs = model.predict_proba(X_test)[:, 1]\n\n    # Save predictions\n    submission = pd.DataFrame({'target': test_probs})\n    submission.to_csv('/app/predictions.csv', index=False)\n    print('Predictions saved to /app/predictions.csv')\n\nif __name__ == '__main__':\n    solve()\nEOF\n"]
