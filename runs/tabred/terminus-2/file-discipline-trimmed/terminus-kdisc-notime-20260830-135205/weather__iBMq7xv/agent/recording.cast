[37.181803, "o", "\u001b[?2004hroot@48b3dd7b4593:/workspace# "]
[57.4076, "i", "cat << 'EOF' > train.py\nimport pandas as pd\nimport numpy as np\nimport lightgbm as lgb\nfrom sklearn.metrics import mean_squared_error\nimport torch\nimport joblib\n\n# REQUIRED Hardware Resolution\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\n# Load data\ntrain_df = pd.read_csv('/app/data/train.csv')\nval_df = pd.read_csv('/app/data/val.csv')\n\nfeatures = [col for col in train_df.columns if col != 'target']\nX_train = train_df[features]\ny_train = train_df['target']\nX_val = val_df[features]\ny_val = val_df['target']\n\n# LightGBM Model\nmodel = lgb.LGBMRegressor(\n    n_estimators=1000,\n    learning_rate=0.05,\n    num_leaves=31,\n    max_depth=-1,\n    n_jobs=-1,\n    random_state=42\n)\n\nmodel.fit(\n    X_train, y_train,\n    eval_set=[(X_val, y_val)],\n    eval_metric='rmse',\n    callbacks=[lgb.early_stopping(stopping_rounds=50)]\n)\n\npreds = model.predict(X_val)\nrmse = np.sqrt(mean_squared_error(y_val, preds))\nprint(f'Model RMSE: {rmse}')\n\n# Baseline was 4.0944\nif rmse < 4.0944:\n    print('Model beat baseline!')\n    joblib.dump(model, 'best_model.pkl')\nelse:\n    print('Model failed to beat baseline.')\n\nEOF\n"]
