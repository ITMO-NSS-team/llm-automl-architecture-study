[27.386846, "i", "cat << 'EOF' > baseline.py\nimport pandas as pd\nimport numpy as np\nfrom sklearn.metrics import mean_squared_error\n\ntrain = pd.read_csv('/app/data/train.csv')\nval = pd.read_csv('/app/data/val.csv')\n\nmean_val = train['target'].mean()\nval_preds = np.full(len(val), mean_val)\nrmse = np.sqrt(mean_squared_error(val['target'], val_preds))\n\nprint(f'Training Mean: {mean_val}')\nprint(f'Baseline RMSE: {rmse}')\nEOF\n"]
[27.387274, "o", "cat << 'EOF' > baseline.py\r\n\u001b[?2004l\r\u001b[?2004h> import pandas as pd\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np"]
