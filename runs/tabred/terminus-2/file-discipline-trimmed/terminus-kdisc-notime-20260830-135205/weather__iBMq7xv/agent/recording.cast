[114.534367, "i", "cat << 'EOF' > predict.py\nimport pandas as pd\nimport joblib\nimport numpy as np\n\n# Load model and test data\nmodel = joblib.load('best_model.pkl')\ntest_df = pd.read_csv('/app/data/test.csv')\n\n# Predict\npreds = model.predict(test_df)\n\n# Create output dataframe\noutput = pd.DataFrame({'target': preds})\n\n# Save to CSV without index\noutput.to_csv('/app/predictions.csv', index=False)\n\nprint(f'Predictions saved. Shape: {output.shape}')\nprint(f'First 5 predictions: {preds[:5]}')\nprint(f'Mean prediction: {preds.mean()}')\nprint(f'Min prediction: {preds.min()}')\nprint(f'Max prediction: {preds.max()}')\nEOF\n"]
