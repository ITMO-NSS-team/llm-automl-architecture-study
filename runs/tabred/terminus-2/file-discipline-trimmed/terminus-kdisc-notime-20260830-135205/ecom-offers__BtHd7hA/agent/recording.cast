[42.037964, "i", "cat << 'EOF' > solution.py\nimport pandas as pd\nimport numpy as np\nimport lightgbm as lgb\nfrom sklearn.metrics import roc_auc_score\nimport torch\n\n# Hardware device resolution as required\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\n# Load data\ntrain = pd.read_csv('/app/data/train.csv')\nval = pd.read_csv('/app/data/val.csv')\ntest = pd.read_csv('/app/data/test.csv')\n\nX_train = train.drop(columns=['target'])\ny_train = train['target']\nX_val = val.drop(columns=['target'])\ny_val = val['target']\n\n# Trivial baseline: predict the mean of training target\ntrain_mean = y_train.mean()\nbaseline_preds = np.full(len(y_val), train_mean)\nbaseline_auc = roc_auc_score(y_val, baseline_preds)\nprint(f'Trivial Baseline ROC-AUC: {baseline_auc:.5f}')\n\n# LightGBM model\n# Using categorical_feature if any, but here we have num and bin\n# bin features are already 0/1, so we treat them as numeric or category\ndtrain = lgb.Dataset(X_train, label=y_train)\ndval = lgb.Dataset(X_val, label=y_val, reference=dtrain)\n\nparams = {\n    'objective': 'binary',\n    'metric': 'auc',\n    'boosting_type': 'gbdt',\n    'verbosity': -1,\n    'seed': 42,\n    'learning_rate': 0.05,\n    'num_leaves': 31,\n    'feature_fraction': 0.8,\n    'bagging_fraction': 0.8,\n    'bagging_freq': 5,\n}\n\n# Train with early stopping\nmodel = lgb.train(\n    params,\n    dtrain,\n    num_boost_round=1000,\n    valid_sets=[dval],\n    callbacks=[lgb.early_stopping(stopping_rounds=50)]\n)\n\n# Validate\nval_preds = model.predict(X_val)\nmodel_auc = roc_auc_score(y_val, val_preds)\nprint(f'Model ROC-AUC: {model_auc:.5f}')\n\nif model_auc > baseline_auc:\n    print('Model beat baseline. Generating predictions...')\n    test_preds = model.predict(test)\n    # Ensure predictions are finite and target column name is correct\n    submission = pd.DataFrame({'target': test_preds})\n    submission.to_csv('/app/predictions.csv', index=False)\n    print('Predictions saved to /app/predictions.csv')\nelse:\n    print('Model did not beat baseline. Using baseline predictions.')\n    test_preds = np.full(len(test), train_mean)\n    submission = pd.DataFrame({'target': test_preds})\n    submission.to_csv('/app/predictions.csv', index=False)\n    print('Baseline predictions saved to /app/predictions.csv')\n\nEOF\n"]
