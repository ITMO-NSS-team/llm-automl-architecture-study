[?2004hroot@45f7feb1a1e2:/workspace# cat << 'EOF' > solution.py
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import lightgbm as lgb
[?2004l[?2004h> from sklearn.metrics import roc_auc_score
[?2004l[?2004h> import torch
[?2004l[?2004h> 
[?2004l[?2004h> # Hardware device resolution as required
[?2004l[?2004h> DEVICE = ('cuda' if torch.cuda.is_available()
[?2004l[?2004h>           else 'mps' if torch.backends.mps.is_available() else 'cpu')
[?2004l[?2004h> print('DEVICE=', DEVICE)
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h> train = pd.read_csv('/app/data/train.csv')
[?2004l[?2004h> val = pd.read_csv('/app/data/val.csv')
[?2004l[?2004h> test = pd.read_csv('/app/data/test.csv')
[?2004l[?2004h> 
[?2004l[?2004h> X_train = train.drop(columns=['target'])
[?2004l[?2004h> y_train = train['target']
[?2004l[?2004h> X_val = val.drop(columns=['target'])
[?2004l[?2004h> y_val = val['target']
[?2004l[?2004h> 
[?2004l[?2004h> # Trivial baseline: predict the mean of training target
[?2004l[?2004h> train_mean = y_train.mean()
[?2004l[?2004h> baseline_preds = np.full(len(y_val), train_mean)
[?2004l[?2004h> baseline_auc = roc_auc_score(y_val, baseline_preds)
[?2004l[?2004h> print(f'Trivial Baseline ROC-AUC: {baseline_auc:.5f}')
[?2004l[?2004h> 
[?2004l[?2004h> # LightGBM model
[?2004l[?2004h> # Using categorical_feature if any, but here we have num and bin
[?2004l[?2004h> # bin features are already 0/1, so we treat them as numeric or category
[?2004l[?2004h> dtrain = lgb.Dataset(X_train, label=y_train)
[?2004l[?2004h> dval = lgb.Dataset(X_val, label=y_val, reference=dtrain)
[?2004l[?2004h> 
[?2004l[?2004h> params = {
[?2004l[?2004h>     'objective': 'binary',
[?2004l[?2004h>     'metric': 'auc',
[?2004l[?2004h>     'boosting_type': 'gbdt',
[?2004l[?2004h>     'verbosity': -1,
[?2004l[?2004h>     'seed': 42,
[?2004l[?2004h>     'learning_rate': 0.05,
[?2004l[?2004h>     'num_leaves': 31,
[?2004l[?2004h>     'feature_fraction': 0.8,
[?2004l[?2004h>     'bagging_fraction': 0.8,
[?2004l[?2004h>     'bagging_freq': 5,
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> # Train with early stopping
[?2004l[?2004h> model = lgb.train(
[?2004l[?2004h>     params,
[?2004l[?2004h>     dtrain,
[?2004l[?2004h>     num_boost_round=1000,
[?2004l[?2004h>     valid_sets=[dval],
[?2004l[?2004h>     callbacks=[lgb.early_stopping(stopping_rounds=50)]
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> # Validate
[?2004l[?2004h> val_preds = model.predict(X_val)
[?2004l[?2004h> model_auc = roc_auc_score(y_val, val_preds)
[?2004l[?2004h> print(f'Model ROC-AUC: {model_auc:.5f}')
[?2004l[?2004h> 
[?2004l[?2004h> if model_auc > baseline_auc:
[?2004l[?2004h>     print('Model beat baseline. Generating predictions...')
[?2004l[?2004h>     test_preds = model.predict(test)
[?2004l[?2004h>     # Ensure predictions are finite and target column name is correct
[?2004l[?2004h>     submission = pd.DataFrame({'target': test_preds})
[?2004l[?2004h>     submission.to_csv('/app/predictions.csv', index=False)
[?2004l[?2004h>     print('Predictions saved to /app/predictions.csv')
[?2004l[?2004h> else:
[?2004l[?2004h>     print('Model did not beat baseline. Using baseline predictions.')
[?2004l[?2004h>     test_preds = np.full(len(test), train_mean)
[?2004l[?2004h>     submission = pd.DataFrame({'target': test_preds})
[?2004l[?2004h>     submission.to_csv('/app/predictions.csv', index=False)
[?2004l[?2004h>     print('Baseline predictions saved to /app/predictions.csv')
[?2004l[?2004h> 
[?2004l[?2004h> EOF
