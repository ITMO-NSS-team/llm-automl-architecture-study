[?2004hroot@ec87f36e3848:/workspace# cat << 'EOF' > solution.py
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from lightgbm import LGBMClassifier
[?2004l[?2004h> from sklearn.metrics import roc_auc_score
[?2004l[?2004h> import torch
[?2004l[?2004h> 
[?2004l[?2004h> # Hardware resolution
[?2004l[?2004h> DEVICE = ('cuda' if torch.cuda.is_available()
[?2004l[?2004h>           else 'mps' if torch.backends.mps.is_available() else 'cpu')
[?2004l[?2004h> print('DEVICE=', DEVICE)
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h> print('Loading data...')
[?2004l[?2004h> train_df = pd.read_csv('/app/data/train.csv')
[?2004l[?2004h> val_df = pd.read_csv('/app/data/val.csv')
[?2004l[?2004h> test_df = pd.read_csv('/app/data/test.csv')
[?2004l[?2004h> 
[?2004l[?2004h> X_train = train_df.drop(columns=['target'])
[?2004l[?2004h> y_train = train_df['target']
[?2004l[?2004h> X_val = val_df.drop(columns=['target'])
[?2004l[?2004h> y_val = val_df['target']
[?2004l[?2004h> 
[?2004l[?2004h> # Trivial baseline
[?2004l[?2004h> train_mean = y_train.mean()
[?2004l[?2004h> val_baseline_preds = np.full(len(y_val), train_mean)
[?2004l[?2004h> baseline_score = roc_auc_score(y_val, val_baseline_preds)
[?2004l[?2004h> print(f'Trivial Baseline ROC-AUC: {baseline_score}')
[?2004l[?2004h> 
[?2004l[?2004h> # Model training
[?2004l[?2004h> print('Training LightGBM model...')
[?2004l[?2004h> model = LGBMClassifier(
[?2004l[?2004h>     n_estimators=1000,
[?2004l[?2004h>     learning_rate=0.05,
[?2004l[?2004h>     num_leaves=31,
[?2004l[?2004h>     max_depth=-1,
[?2004l[?2004h>     random_state=42,
[?2004l[?2004h>     n_jobs=-1
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> model.fit(
[?2004l[?2004h>     X_train, y_train,
[?2004l[?2004h>     eval_set=[(X_val, y_val)],
[?2004l[?2004h>     eval_metric='auc',
[?2004l[?2004h>     callbacks=[]) # LightGBM handles early stopping via separate callbacks in newer versions, but for simplicity we'll use fixed iterations or a simple loop
[?2004l[?2004h> 
[?2004l[?2004h> # Note: In newer LightGBM, early_stopping is a callback. 
[?2004l[?2004h> # For this task, a robust default set of hyperparameters usually beats 0.5 easily.
[?2004l[?2004h> 
[?2004l[?2004h> # Validation
[?2004l[?2004h> val_probs = model.predict_proba(X_val)[:, 1]
[?2004l[?2004h> val_score = roc_auc_score(y_val, val_probs)
[?2004l[?2004h> print(f'Model Validation ROC-AUC: {val_score}')
[?2004l[?2004h> 
[?2004l[?2004h> if val_score <= baseline_score:
[?2004l[?2004h>     print('Model did not beat baseline. Using baseline predictions.')
[?2004l[?2004h>     test_probs = np.full(len(test_df), train_mean)
[?2004l[?2004h> else:
[?2004l[?2004h>     print('Model beat baseline. Generating predictions...')
[?2004l[?2004h>     test_probs = model.predict_proba(test_df)[:, 1]
[?2004l[?2004h> 
[?2004l[?2004h> # Save predictions
[?2004l[?2004h> submission = pd.DataFrame({'target': test_probs})
[?2004l[?2004h> submission.to_csv('/app/predictions.csv', index=False)
[?2004l[?2004h> print('Predictions saved to /app/predictions.csv')
[?2004l[?2004h> EOF
