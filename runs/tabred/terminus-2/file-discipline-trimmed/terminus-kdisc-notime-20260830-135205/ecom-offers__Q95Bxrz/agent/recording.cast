[60.553053, "o", "\u001b[?2004hroot@ec87f36e3848:/workspace# "]
[60.686864, "i", "cat << 'EOF' > solution.py\nimport pandas as pd\nimport numpy as np\nfrom lightgbm import LGBMClassifier\nfrom sklearn.metrics import roc_auc_score\nimport torch\n\n# Hardware resolution\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\n# Load data\nprint('Loading data...')\ntrain_df = pd.read_csv('/app/data/train.csv')\nval_df = pd.read_csv('/app/data/val.csv')\ntest_df = pd.read_csv('/app/data/test.csv')\n\nX_train = train_df.drop(columns=['target'])\ny_train = train_df['target']\nX_val = val_df.drop(columns=['target'])\ny_val = val_df['target']\n\n# Trivial baseline\ntrain_mean = y_train.mean()\nval_baseline_preds = np.full(len(y_val), train_mean)\nbaseline_score = roc_auc_score(y_val, val_baseline_preds)\nprint(f'Trivial Baseline ROC-AUC: {baseline_score}')\n\n# Model training\nprint('Training LightGBM model...')\nmodel = LGBMClassifier(\n    n_estimators=1000,\n    learning_rate=0.05,\n    num_leaves=31,\n    max_depth=-1,\n    random_state=42,\n    n_jobs=-1\n)\n\nmodel.fit(\n    X_train, y_train,\n    eval_set=[(X_val, y_val)],\n    eval_metric='auc',\n    callbacks=[]) # LightGBM handles early stopping via separate callbacks in newer versions, but for simplicity we'll use fixed iterations or a simple loop\n\n# Note: In newer LightGBM, early_stopping is a callback. \n# For this task, a robust default set of hyperparameters usually beats 0.5 easily.\n\n# Validation\nval_probs = model.predict_proba(X_val)[:, 1]\nval_score = roc_auc_score(y_val, val_probs)\nprint(f'Model Validation ROC-AUC: {val_score}')\n\nif val_score <= baseline_score:\n    print('Model did not beat baseline. Using baseline predictions.')\n    test_probs = np.full(len(test_df), train_mean)\nelse:\n    print('Model beat baseline. Generating predictions...')\n    test_probs = model.predict_proba(test_df)[:, 1]\n\n# Save predictions\nsubmission = pd.DataFrame({'target': test_probs})\nsubmission.to_csv('/app/predictions.csv', index=False)\nprint('Predictions saved to /app/predictions.csv')\nEOF\n"]
