[60.689117, "o", "val_baseline_preds = np.full(len(y_val), train_mean)\r\n\u001b[?2004l\r\u001b[?2004h> baseline_score = roc_auc_score(y_val, val_baseline_preds)\r\n\u001b[?2004l\r\u001b[?2004h> print(f'Trivial Baseline ROC-AUC: {baseline_score}')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Model training\r\n\u001b[?2004l\r"]
[60.691203, "o", "\u001b[?2004h> print('Training LightGBM model...')\r\n\u001b[?2004l\r\u001b[?2004h> model = LGBMClassifier(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[60.691883, "o", "    n_estimators=1000,\r\n\u001b[?2004l\r\u001b[?2004h>     learning_rate=0.05,\r\n\u001b[?2004l\r\u001b[?2004h>     num_leaves=31,\r\n\u001b[?2004l\r\u001b[?2004h>     max_depth=-1,\r\n\u001b[?2004l\r\u001b[?2004h>     random_state=42,\r\n\u001b[?2004l\r\u001b[?2004h>     n_jobs=-1\r\n\u001b[?2004l\r\u001b[?2004h> )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> model.fit(\r\n\u001b[?2004l\r\u001b[?2004h>     X_train, y_train,\r\n\u001b[?2004l\r\u001b[?2004h>     eval_set=[(X_val, y_val)],\r\n\u001b[?2004l\r\u001b[?2004h>     eval_metric='auc',\r\n\u001b[?2004l\r\u001b[?2004h>     callbacks=[]) # LightGBM handles early stopping via separate callbacks in newer versions, but for simplicity we'll use fixed iterations or a simple loop\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Note: In newer LightGBM, early_stopping is a callback. \r\n\u001b[?2004l\r\u001b[?2004h> # For this task, a robust default set of hyperparameters usually beats 0.5 easily.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Validation\r\n\u001b[?2004l\r\u001b[?2004h> val_probs = model.predict_proba(X_val)[:, 1]\r\n\u001b[?2004l\r\u001b[?2004h> val_score = roc_auc_score(y_val, val_probs)\r\n\u001b[?2004l\r\u001b[?2004h> print(f'Model Validation ROC-AUC: {val_score}')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> if val_score <= baseline_score:\r\n\u001b[?2004l\r\u001b[?2004h>     print('Model did not beat baseline. Using baseline predictions.')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[60.69283, "o", "    test_probs = np.full(len(test_df), train_mean)\r\n\u001b[?2004l\r\u001b[?2004h> else:\r\n\u001b[?2004l\r\u001b[?2004h>     print('Model beat baseline. Generating predictions...')\r\n\u001b[?2004l\r\u001b[?2004h>     test_probs = model.predict_proba(test_df)[:, 1]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Save predictions\r\n\u001b[?2004l\r\u001b[?2004h> submission = pd.DataFrame({'target': test_probs})\r\n\u001b[?2004l\r\u001b[?2004h> submission.to_csv('/app/predictions.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h> print('Predictions saved to /app/predictions.csv')\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
