[83.181875, "i", "cat << 'EOF' > predict.py\nimport pandas as pd\nimport joblib\n\n# Load model\nmodel = joblib.load('best_model.pkl')\n\n# Load test data\ntest = pd.read_csv('/app/data/test.csv')\n\n# Handle categorical features to match training\ncat_cols = [col for col in test.columns if col.startswith('cat_')]\nfor col in cat_cols:\n    test[col] = test[col].astype('category')\n\n# Predict probabilities for positive class\npreds = model.predict_proba(test)[:, 1]\n\n# Save to predictions.csv\nsubmission = pd.DataFrame({'target': preds})\nsubmission.to_csv('/app/predictions.csv', index=False)\n\nprint(f'Predictions saved. Shape: {submission.shape}')\nEOF\n"]
