[22.692039, "i", "cat << 'EOF' > baseline_and_train.py\nimport pandas as pd\nimport numpy as np\nfrom sklearn.metrics import roc_auc_score\nimport lightgbm as lgb\nimport torch\nimport joblib\n\n# Hardware resolution\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\n# Load data\ntrain = pd.read_csv('/app/data/train.csv')\nval = pd.read_csv('/app/data/val.csv')\n\nX_train = train.drop(columns=['target'])\ny_train = train['target']\nX_val = val.drop(columns=['target'])\ny_val = val['target']\n\n# Trivial baseline: Training mean\ntrain_mean = y_train.mean()\nbaseline_preds = np.full(len(y_val), train_mean)\nbaseline_auc = roc_auc_score(y_val, baseline_preds)\nprint(f'Trivial Baseline (Mean) ROC-AUC: {baseline_auc}')\n\n# Handle categorical features for LightGBM\ncat_cols = [col for col in X_train.columns if col.startswith('cat_')]\nfor col in cat_cols:\n    X_train[col] = X_train[col].astype('category')\n    X_val[col] = X_val[col].astype('category')\n\n# Train LightGBM\nmodel = lgb.LGBMClassifier(\n    n_estimators=1000,\n    learning_rate=0.05,\n    num_leaves=31,\n    device=DEVICE if DEVICE != 'mps' else 'cpu', # LGBM doesn't support mps directly via 'device'\n    random_state=42,\n    n_jobs=-1\n)\n\nmodel.fit(\n    X_train, y_train,\n    eval_set=[(X_val, y_val)],\n    eval_metric='auc',\n    callbacks=[lgb.early_stopping(stopping_rounds=50)]\n)\n\n# Validate model\nval_preds = model.predict_proba(X_val)[:, 1]\nmodel_auc = roc_auc_score(y_val, val_preds)\nprint(f'Model ROC-AUC: {model_auc}')\n\nif model_auc > baseline_auc:\n    print('Model beats baseline!')\n    joblib.dump(model, 'best_model.pkl')\nelse:\n    print('Model failed to beat baseline.')\nEOF\n"]
[22.692657, "o", "cat << 'EOF' > baseline_and_train.py\r\n"]
