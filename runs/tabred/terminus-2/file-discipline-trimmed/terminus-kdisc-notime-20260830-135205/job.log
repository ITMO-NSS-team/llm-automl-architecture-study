Sending keys: ["cat << 'EOF' > solution.py\nimport pandas as pd\nimport numpy as np\nimport lightgbm as lgb\nfrom sklearn.metrics import mean_squared_error\n\n# Load data\n train_df = pd.read_csv('/app/data/train.csv')\n val_df = pd.read_csv('/app/data/val.csv')\n test_df = pd.read_csv('/app/data/test.csv')\n\n target_col = 'target'\n X_train = train_df.drop(columns=[target_col])\n y_train = train_df[target_col]\n X_val = val_df.drop(columns=[target_col])\n y_val = val_df[target_col]\n\n # Trivial baseline: Median\n train_median = y_train.median()\n baseline_preds = np.full(len(y_val), train_median)\n baseline_rmse = np.sqrt(mean_squared_error(y_val, baseline_preds))\n print(f'Trivial Baseline (Median) RMSE: {baseline_rmse}')\n print(f'Training Median: {train_median}')\n\n # Train LightGBM\n # Identify categorical features from schema (cat_X)\n cat_features = [col for col in X_train.columns if col.startswith('cat_')]\n\n model = lgb.LGBMRegressor(\n     n_estimators=1000,\n     learning_rate=0.05,\n     num_leaves=31,\n     random_state=42,\n     importance_type='gain'\n )\n\n model.fit(\n     X_train, y_train,\n     eval_set=[(X_val, y_val)],\n     eval_metric='rmse',\n     callbacks=[lgb.early_stopping(stopping_rounds=50)]\n )\n\n # Predict and evaluate\n val_preds = model.predict(X_val)\n model_rmse = np.sqrt(mean_squared_error(y_val, val_preds))\n print(f'LightGBM RMSE: {model_rmse}')\n\n if model_rmse < baseline_rmse:\n     print('Model beats baseline. Generating predictions...')\n     test_preds = model.predict(test_df)\n     pd.DataFrame({'target': test_preds}).to_csv('/app/predictions.csv', index=False)\n else:\n     print('Model failed to beat baseline. Using baseline predictions.')\n     test_preds = np.full(len(test_df), train_median)\n     pd.DataFrame({'target': test_preds}).to_csv('/app/predictions.csv', index=False)\n\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
