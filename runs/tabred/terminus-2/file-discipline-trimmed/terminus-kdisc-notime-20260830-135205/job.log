Sending keys: ["cat << 'EOF' > baseline_and_train.py\nimport pandas as pd\nimport numpy as np\nfrom sklearn.metrics import mean_squared_error\nimport torch\nimport xgboost as xgb\n\n# Required hardware device resolution\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\n# Load data\nprint('Loading data...')\ntrain = pd.read_csv('/app/data/train.csv')\nval = pd.read_csv('/app/data/val.csv')\ntest = pd.read_csv('/app/data/test.csv')\n\ntarget_col = 'target'\n\n# Trivial Baseline: Median of training target\nmedian_val = train[target_col].median()\nbaseline_preds = np.full(len(val), median_val)\nbaseline_rmse = np.sqrt(mean_squared_error(val[target_col], baseline_preds))\nprint(f'Trivial Baseline (Median): {median_val}')\nprint(f'Baseline RMSE: {baseline_rmse}')\n\n# Preprocessing\n# Identify feature types\nnum_cols = [c for c in train.columns if c.startswith('num_')]\nbin_cols = [c for c in train.columns if c.startswith('bin_')]\ncat_cols = [c for c in train.columns if c.startswith('cat_')]\n\n# Fill numerical NaNs with median\nfor col in num_cols:\n    train[col] = train[col].fillna(train[col].median())\n    val[col] = val[col].fillna(train[col].median())\n    test[col] = test[col].fillna(train[col].median())\n\n# Simple categorical encoding (label encoding)\nfor col in cat_cols:\n    train[col] = train[col].astype(str).astype('category').cat.codes\n    val[col] = val[col].astype(str).astype('category').cat.codes\n    test[col] = test[col].astype(str).astype('category').cat.codes\n\n# Train XGBoost\nX_train = train.drop(columns=[target_col])\ny_train = train[target_col]\nX_val = val.drop(columns=[target_col])\ny_val = val[target_col]\n\nmodel = xgb.XGBRegressor(\n    n_estimators=1000,\n    learning_rate=0.05,\n    max_depth=6,\n    tree_method='hist',\n    device=DEVICE if DEVICE != 'mps' else 'cpu', # XGBoost uses 'cuda' or 'cpu'\n    early_stopping_rounds=50,\n    eval_metric='rmse'\n)\n\n# If DEVICE is cuda, we use gpu_id=0 or similar, but 'device' param in newer XGB handles it.\n# To be safe with the requirement, we'll use 'cuda' if available.\nif DEVICE == 'cuda':\n    model.set_params(device='cuda')\n\nmodel.fit(\n    X_train, y_train,\n    eval_set=[(X_val, y_val)],\n    verbose=100\n)\n\nval_preds = model.predict(X_val)\nmodel_rmse = np.sqrt(mean_squared_error(y_val, val_preds))\nprint(f'Model RMSE: {model_rmse}')\n\nif model_rmse < baseline_rmse:\n    print('Model beats baseline!')\n    # Predict test set\n    test_preds = model.predict(test)\n    pd.DataFrame({'target': test_preds}).to_csv('/app/predictions.csv', index=False)\n    print('Predictions saved to /app/predictions.csv')\nelse:\n    print('Model failed to beat baseline. Using baseline predictions.')\n    test_preds = np.full(len(test), median_val)\n    pd.DataFrame({'target': test_preds}).to_csv('/app/predictions.csv', index=False)\n    print('Baseline predictions saved to /app/predictions.csv')\n\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
