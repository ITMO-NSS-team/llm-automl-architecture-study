Sending keys: ["cat << 'EOF' > solution.py\nimport pandas as pd\nimport numpy as np\nfrom sklearn.metrics import roc_auc_score\nimport lightgbm as lgb\nimport torch\nimport json\n\n# Hardware resolution\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\ndef solve():\n    # Load schema\n    with open('/app/data/schema.json', 'r') as f:\n        schema = json.load(f)\n    \n    target_col = schema['target_column']\n    feature_cols = schema['feature_columns']\n    \n    # Load data\n    train = pd.read_csv('/app/data/train.csv')\n    val = pd.read_csv('/app/data/val.csv')\n    test = pd.read_csv('/app/data/test.csv')\n    \n    X_train = train[feature_cols]\n    y_train = train[target_col]\n    X_val = val[feature_cols]\n    y_val = val[target_col]\n    X_test = test[feature_cols]\n    \n    # Trivial baseline\n    train_mean = y_train.mean()\n    baseline_preds = np.full(len(y_val), train_mean)\n    baseline_auc = roc_auc_score(y_val, baseline_preds)\n    print(f'Trivial Baseline (train mean): {train_mean:.4f}')\n    print(f'Baseline ROC-AUC: {baseline_auc:.4f}')\n    \n    # Simple LightGBM model\n    # Using a basic config to ensure it runs and beats baseline\n    model = lgb.LGBMClassifier(\n        n_estimators=1000,\n        learning_rate=0.05,\n        num_leaves=31,\n        objective='binary',\n        random_state=42,\n        n_jobs=-1\n    )\n    \n    model.fit(\n        X_train, y_train,\n        eval_set=[(X_val, y_val)],\n        eval_metric='auc',\n        callbacks=[lgb.early_stopping(stopping_rounds=50)]\n    )\n    \n    val_preds = model.predict_proba(X_val)[:, 1]\n    model_auc = roc_auc_score(y_val, val_preds)\n    print(f'Model ROC-AUC: {model_auc:.4f}')\n    \n    if model_auc <= baseline_auc:\n        print('Model did not beat baseline. Using baseline predictions.')\n        test_preds = np.full(len(X_test), train_mean)\n    else:\n        print('Model beat baseline. Using model predictions.')\n        test_preds = model.predict_proba(X_test)[:, 1]\n    \n    # Save predictions\n    submission = pd.DataFrame({'target': test_preds})\n    submission.to_csv('/app/predictions.csv', index=False)\n    print('Predictions saved to /app/predictions.csv')\n\nif __name__ == '__main__':\n    solve()\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
