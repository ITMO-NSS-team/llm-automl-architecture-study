Sending keys: ["cat << 'EOF' > train_model.py\nimport pandas as pd\nimport numpy as np\nimport torch\nfrom lightgbm import LGBMClassifier, early_stopping, log_evaluation\nfrom sklearn.metrics import roc_auc_score\n\n# REQUIRED Hardware selection\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\ndef load_data():\n    train = pd.read_csv('/app/data/train.csv')\n    val = pd.read_csv('/app/data/val.csv')\n    test = pd.read_csv('/app/data/test.csv')\n    return train, val, test\n\nif __name__ == '__main__':\n    train, val, test = load_data()\n    \n    X_train = train.drop(columns=['target'])\n    y_train = train['target']\n    X_val = val.drop(columns=['target'])\n    y_val = val['target']\n    X_test = test\n\n    # Use scale_pos_weight for imbalance\n    ratio = (y_train == 0).sum() / (y_train == 1).sum()\n    \n    model = LGBMClassifier(\n        n_estimators=1000,\n        learning_rate=0.05,\n        num_leaves=31,\n        scale_pos_weight=ratio,\n        random_state=42,\n        n_jobs=-1\n    )\n    \n    model.fit(\n        X_train, y_train,\n        eval_set=[(X_val, y_val)],\n        eval_metric='auc',\n        callbacks=[early_stopping(stopping_rounds=50), log_evaluation(period=100)]\n    )\n    \n    val_preds = model.predict_proba(X_val)[:, 1]\n    auc = roc_auc_score(y_val, val_preds)\n    print(f'Model ROC-AUC: {auc}')\n    \n    test_preds = model.predict_proba(X_test)[:, 1]\n    pd.DataFrame({'target': test_preds}).to_csv('/app/predictions.csv', index=False)\n    print('Predictions saved to /app/predictions.csv')\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
