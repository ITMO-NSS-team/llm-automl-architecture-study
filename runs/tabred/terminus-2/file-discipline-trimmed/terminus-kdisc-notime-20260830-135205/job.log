Sending keys: ["cat << 'EOF' > solution.py\nimport pandas as pd\nimport numpy as np\nimport torch\nfrom lightgbm import LGBMRegressor\nfrom sklearn.metrics import mean_squared_error\nimport os\n\n# Resolve the compute device as REQUIRED\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\n# Load data\nprint('Loading data...')\ntrain_df = pd.read_csv('/app/data/train.csv')\nval_df = pd.read_csv('/app/data/val.csv')\ntest_df = pd.read_csv('/app/data/test.csv')\n\ntarget_col = 'target'\nfeatures = [col for col in train_df.columns if col != target_col]\n\nX_train = train_df[features]\ny_train = train_df[target_col]\nX_val = val_df[features]\ny_val = val_df[target_col]\n\n# Handle missing values for LightGBM\n# LightGBM handles NaNs natively, but we should ensure types are correct\n# Numerical: num_*, Binary: bin_*, Categorical: cat_*\nfor col in features:\n    if col.startswith('cat_') or col.startswith('bin_'):\n        X_train[col] = X_train[col].astype('category')\n        X_val[col] = X_val[col].astype('category')\n        test_df[col] = test_df[col].astype('category')\n\n# Trivial Baseline: Median\nmedian_val = y_train.median()\nbaseline_preds = np.full(len(y_val), median_val)\nbaseline_rmse = np.sqrt(mean_squared_error(y_val, baseline_preds))\nprint(f'Baseline (Median) RMSE: {baseline_rmse}')\n\n# Train Model\nprint('Training LightGBM model...')\nmodel = LGBMRegressor(n_estimators=1000, learning_rate=0.05, num_leaves=31, device=DEVICE if DEVICE != 'mps' else 'cpu')\n# LightGBM doesn't support 'mps' directly in the same way as torch, \n# so we use 'cpu' or 'gpu' (cuda). \n# If DEVICE is 'mps', we stay on 'cpu' for LGBM as it's typically fastest anyway.\nif DEVICE == 'cuda':\n    model.set_params(device='gpu')\n\nmodel.fit(\n    X_train, y_train,\n    eval_set=[(X_val, y_val)],\n    eval_metric='rmse',\n    callbacks=[lambda x: None] # suppress output\n)\n\n# Evaluate Model\nmodel_preds = model.predict(X_val)\nmodel_rmse = np.sqrt(mean_squared_error(y_val, model_preds))\nprint(f'Model RMSE: {model_rmse}')\n\nif model_rmse < baseline_rmse:\n    print('Model beats baseline. Generating predictions...')\n    test_preds = model.predict(test_df)\n    pd.DataFrame({'target': test_preds}).to_csv('/app/predictions.csv', index=False)\nelse:\n    print('Model failed to beat baseline. Using median...')\n    test_preds = np.full(len(test_df), median_val)\n    pd.DataFrame({'target': test_preds}).to_csv('/app/predictions.csv', index=False)\n\nprint('Process complete.')\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
