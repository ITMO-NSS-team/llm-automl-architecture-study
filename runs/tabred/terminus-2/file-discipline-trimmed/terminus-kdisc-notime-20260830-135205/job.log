Sending keys: ["cat << 'EOF' > train_and_predict.py\nimport pandas as pd\nimport numpy as np\nimport torch\nfrom sklearn.metrics import root_mean_squared_error\nimport lightgbm as lgb\nimport json\n\n# REQUIRED: Hardware device resolution\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\n# Load schema\nwith open('/app/data/schema.json', 'r') as f:\n    schema = json.load(f)\n\nfeature_cols = schema['feature_columns']\ntarget_col = schema['target_column']\n\n# Load data\nprint('Loading data...')\ntrain_df = pd.read_csv('/app/data/train.csv')\nval_df = pd.read_csv('/app/data/val.csv')\ntest_df = pd.read_csv('/app/data/test.csv')\n\n# Trivial Baseline: Training Median\ntrain_median = train_df[target_col].median()\nval_preds_baseline = np.full(len(val_df), train_median)\nbaseline_rmse = root_mean_squared_error(val_df[target_col], val_preds_baseline)\nprint(f'Baseline (Median) RMSE: {baseline_rmse:.4f}')\n\n# Prepare training sets\nX_train = train_df[feature_cols]\ny_train = train_df[target_col]\nX_val = val_df[feature_cols]\ny_val = val_df[target_col]\n\n# LightGBM doesn't need much preprocessing for NaNs\n# Identify categorical features\ncat_features = [col for col in feature_cols if col.startswith('cat_') or col.startswith('bin_')]\nfor col in cat_features:\n    X_train[col] = X_train[col].astype('category')\n    X_val[col] = X_val[col].astype('category')\n    test_df[col] = test_df[col].astype('category')\n\nprint('Training LightGBM model...')\nmodel = lgb.LGBMRegressor(\n    n_estimators=1000,\n    learning_rate=0.05,\n    num_leaves=31,\n    objective='regression',\n    metric='rmse',\n    random_state=42,\n    device=DEVICE if DEVICE == 'cuda' else 'cpu' # LightGBM only supports cuda/cpu\n)\n\nmodel.fit(\n    X_train, y_train,\n    eval_set=[(X_val, y_val)],\n    callbacks=[lgb.early_stopping(stopping_rounds=50)]\n)\n\nval_preds_model = model.predict(X_val)\nmodel_rmse = root_mean_squared_error(y_val, val_preds_model)\nprint(f'Model RMSE: {model_rmse:.4f}')\n\nif model_rmse < baseline_rmse:\n    print('Model beats baseline. Generating predictions...')\n    test_preds = model.predict(test_df[feature_cols])\nelse:\n    print('Model does not beat baseline. Using baseline predictions...')\n    test_preds = np.full(len(test_df), train_median)\n\n# Save predictions\nsubmission = pd.DataFrame({'target': test_preds})\nsubmission.to_csv('/app/predictions.csv', index=False)\nprint('Predictions saved to /app/predictions.csv')\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
