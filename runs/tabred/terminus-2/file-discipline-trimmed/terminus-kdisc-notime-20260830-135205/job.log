Sending keys: ["cat << 'EOF' > solution.py\nimport pandas as pd\nimport numpy as np\nimport torch\nfrom sklearn.metrics import roc_auc_score\nimport lightgbm as lgb\n\n# Hardware resolution\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\ndef solve():\n    # Load data\n    train = pd.read_csv('/app/data/train.csv')\n    val = pd.read_csv('/app/data/val.csv')\n    test = pd.read_csv('/app/data/test.csv')\n\n    target_col = 'target'\n    X_train = train.drop(columns=[target_col])\n    y_train = train[target_col]\n    X_val = val.drop(columns=[target_col])\n    y_val = val[target_col]\n\n    # Trivial baseline: mean of training target\n    train_mean = y_train.mean()\n    baseline_preds = np.full(len(y_val), train_mean)\n    baseline_auc = roc_auc_score(y_val, baseline_preds)\n    print(f'Trivial Baseline (Train Mean): {baseline_auc:.4f}')\n\n    # Identify feature types\n    cat_features = [col for col in X_train.columns if col.startswith('cat_')]\n    # LightGBM handles nan for numericals naturally. For categoricals, we cast to category type.\n    for col in cat_features:\n        X_train[col] = X_train[col].astype('category')\n        X_val[col] = X_val[col].astype('category')\n        test[col] = test[col].astype('category')\n\n    # Model training\n    # Use LightGBM with early stopping on validation set\n    model = lgb.LGBMClassifier(\n        n_estimators=1000,\n        learning_rate=0.05,\n        num_leaves=31,\n        objective='binary',\n        metric='auc',\n        random_state=42,\n        n_jobs=-1,\n        verbosity=-1\n    )\n\n    model.fit(\n        X_train, y_train,\n        eval_set=[(X_val, y_val)],\n        eval_metric='auc',\n        callbacks=[lgb.early_stopping(stopping_rounds=50)]\n    )\n\n    val_preds = model.predict_proba(X_val)[:, 1]\n    model_auc = roc_auc_score(y_val, val_preds)\n    print(f'Model Validation AUC: {model_auc:.4f}')\n\n    if model_auc <= baseline_auc:\n        print('Model did not beat baseline. Using baseline for submission.')\n        final_preds = np.full(len(test), train_mean)\n    else:\n        print('Model beat baseline. Generating test predictions.')\n        final_preds = model.predict_proba(test)[:, 1]\n\n    # Sanity check predictions\n    if np.isnan(final_preds).any() or np.isinf(final_preds).any():\n        print('Warning: NaN or Inf detected in predictions. Filling with mean.')\n        final_preds = np.nan_to_num(final_preds, nan=train_mean)\n\n    # Save submission\n    submission = pd.DataFrame({'target': final_preds})\n    submission.to_csv('/app/predictions.csv', index=False)\n    print('Predictions saved to /app/predictions.csv')\n\nif __name__ == '__main__':\n    solve()\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
