Sending keys: ["cat << 'EOF' > solution.py\nimport pandas as pd\nimport numpy as np\nfrom lightgbm import LGBMRegressor\nfrom sklearn.metrics import mean_squared_error\nimport torch\n\n# Hardware resolution as required\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\n# Load data\ntrain = pd.read_csv('/app/data/train.csv')\nval = pd.read_csv('/app/data/val.csv')\ntest = pd.read_csv('/app/data/test.csv')\n\n# Split features and target\nX_train = train.drop(columns=['target'])\ny_train = train['target']\nX_val = val.drop(columns=['target'])\ny_val = val['target']\n\n# Trivial Baseline: Median of training target\nbaseline_val = np.full(len(y_val), y_train.median())\nbaseline_rmse = np.sqrt(mean_squared_error(y_val, baseline_val))\nprint(f'Baseline RMSE: {baseline_rmse}')\n\n# Train LightGBM model\nmodel = LGBMRegressor(n_estimators=1000, learning_rate=0.05, random_state=42, n_jobs=-1)\nmodel.fit(X_train, y_train, eval_set=[(X_val, y_val)], eval_metric='rmse', callbacks=[])\n# Note: LightGBM doesn't use torch, so DEVICE isn't applied to it, \n# but we print it as required by the prompt.\n\n# Validate model\nval_preds = model.predict(X_val)\nmodel_rmse = np.sqrt(mean_squared_error(y_val, val_preds))\nprint(f'Model RMSE: {model_rmse}')\n\nif model_rmse < baseline_rmse:\n    print('Model beats baseline. Generating predictions...')\n    test_preds = model.predict(test)\n    pd.DataFrame({'target': test_preds}).to_csv('/app/predictions.csv', index=False)\n    print('Predictions saved to /app/predictions.csv')\nelse:\n    print('Model did not beat baseline. Using baseline predictions...')\n    test_preds = np.full(len(test), y_train.median())\n    pd.DataFrame({'target': test_preds}).to_csv('/app/predictions.csv', index=False)\n    print('Baseline predictions saved to /app/predictions.csv')\n\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
