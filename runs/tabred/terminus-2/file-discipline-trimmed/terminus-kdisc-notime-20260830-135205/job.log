Sending keys: ["cat << 'EOF' > solution.py\nimport pandas as pd\nimport numpy as np\nfrom sklearn.metrics import mean_squared_error\nimport lightgbm as lgb\n\n# Load data\ntrain_df = pd.read_csv('/app/data/train.csv')\nval_df = pd.read_csv('/app/data/val.csv')\ntest_df = pd.read_csv('/app/data/test.csv')\n\nX_train = train_df.drop(columns=['target'])\ny_train = train_df['target']\nX_val = val_df.drop(columns=['target'])\ny_val = val_df['target']\n\n# Identify categorical features\ncat_cols = [col for col in X_train.columns if col.startswith('cat_')]\nfor col in cat_cols:\n    X_train[col] = X_train[col].astype('category')\n    X_val[col] = X_val[col].astype('category')\n    test_df[col] = test_df[col].astype('category')\n\n# Baseline\nmedian_train = y_train.median()\nbaseline_rmse = np.sqrt(mean_squared_error(y_val, np.full(len(y_val), median_train)))\nprint(f'Baseline RMSE: {baseline_rmse}')\n\n# Model training\nmodel = lgb.LGBMRegressor(n_estimators=1000, learning_rate=0.05, random_state=42)\nmodel.fit(X_train, y_train, eval_set=[(X_val, y_val)], eval_metric='rmse', callbacks=[lgb.early_stopping(stopping_rounds=50)])\n\n# Evaluation\nval_preds = model.predict(X_val)\nval_rmse = np.sqrt(mean_squared_error(y_val, val_preds))\nprint(f'Model RMSE: {val_rmse}')\n\nif val_rmse < baseline_rmse:\n    print('Model beats baseline!')\n    test_preds = model.predict(test_df)\n    pd.DataFrame({'target': test_preds}).to_csv('/app/predictions.csv', index=False)\n    print('Predictions saved to /app/predictions.csv')\nelse:\n    print('Model failed to beat baseline, using median')\n    test_preds = np.full(len(test_df), median_train)\n    pd.DataFrame({'target': test_preds}).to_csv('/app/predictions.csv', index=False)\n    print('Baseline predictions saved to /app/predictions.csv')\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
