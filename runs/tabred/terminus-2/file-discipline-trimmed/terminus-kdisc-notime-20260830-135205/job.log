Sending keys: ["cat << 'EOF' > solution.py\nimport pandas as pd\nimport numpy as np\nfrom sklearn.metrics import mean_squared_error\nimport lightgbm as lgb\n\n# Load data\ntrain = pd.read_csv('/app/data/train.csv')\nval = pd.read_csv('/app/data/val.csv')\ntest = pd.read_csv('/app/data/test.csv')\n\n# Define features\nnum_cols = [c for c in train.columns if c.startswith('num_')]\nbin_cols = [c for c in train.columns if c.startswith('bin_')]\ncat_cols = [c for c in train.columns if c.startswith('cat_')]\nfeatures = num_cols + bin_cols + cat_cols\ntarget_col = 'target'\n\n# Trivial Baseline: Median of training target\ntrain_median = train[target_col].median()\nval_baseline_preds = np.full(len(val), train_median)\nval_baseline_rmse = np.sqrt(mean_squared_error(val[target_col], val_baseline_preds))\n\nprint(f'Trivial Baseline (Median): {train_median}')\nprint(f'Baseline Val RMSE: {val_baseline_rmse}')\n\n# Model Training: LightGBM\nX_train = train[features]\ny_train = train[target_col]\nX_val = val[features]\ny_val = val[target_col]\n\n# LightGBM handles categorical features if specified, but we'll keep it simple\n# Convert cat_0 to categorical type for LGBM\nfor col in cat_cols:\n    X_train[col] = X_train[col].astype('category')\n    X_val[col] = X_val[col].astype('category')\n\nmodel = lgb.LGBMRegressor(\n    n_estimators=1000,\n    learning_rate=0.05,\n    num_leaves=31,\n    random_state=42,\n    n_jobs=-1\n)\n\nmodel.fit(\n    X_train, y_train,\n    eval_set=[(X_val, y_val)],\n    eval_metric='rmse',\n    callbacks=[lgb.early_stopping(stopping_rounds=50)]\n)\n\n# Validation prediction\nval_preds = model.predict(X_val)\nval_model_rmse = np.sqrt(mean_squared_error(y_val, val_preds))\nprint(f'Model Val RMSE: {val_model_rmse}')\n\nif val_model_rmse < val_baseline_rmse:\n    print('Model beats baseline. Generating predictions...')\n    X_test = test[features]\n    for col in cat_cols:\n        X_test[col] = X_test[col].astype('category')\n    \n    test_preds = model.predict(X_test)\n    submission = pd.DataFrame({'target': test_preds})\n    submission.to_csv('/app/predictions.csv', index=False)\n    print('Predictions saved to /app/predictions.csv')\nelse:\n    print('Model did not beat baseline. Using baseline predictions...')\n    test_preds = np.full(len(test), train_median)\n    submission = pd.DataFrame({'target': test_preds})\n    submission.to_csv('/app/predictions.csv', index=False)\n    print('Baseline predictions saved to /app/predictions.csv')\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
