Sending keys: ["cat << 'EOF' > solution.py\nimport pandas as pd\nimport numpy as np\nfrom lightgbm import LGBMRegressor\nfrom sklearn.metrics import root_mean_squared_error\nimport torch\n\n# Hardware resolution snippet (Required)\nDEVICE = ('cuda' if torch.cuda.is_available()\n          else 'mps' if torch.backends.mps.is_available() else 'cpu')\nprint('DEVICE=', DEVICE)\n\ndef main():\n    train_df = pd.read_csv('/app/data/train.csv')\n    val_df = pd.read_csv('/app/data/val.csv')\n    test_df = pd.read_csv('/app/data/test.csv')\n\n    target_col = 'target'\n    \n    # Identify feature types from column names\n    num_cols = [c for c in train_df.columns if c.startswith('num_')]\n    bin_cols = [c for c in train_df.columns if c.startswith('bin_')]\n    cat_cols = [c for c in train_df.columns if c.startswith('cat_')]\n\n    X_train = train_df.drop(columns=[target_col])\n    y_train = train_df[target_col]\n    X_val = val_df.drop(columns=[target_col])\n    y_val = val_df[target_col]\n\n    # Trivial Baseline: Median of training target\n    baseline_val = y_train.median()\n    baseline_preds = np.full(len(y_val), baseline_val)\n    baseline_rmse = root_mean_squared_error(y_val, baseline_preds)\n    print(f'Baseline (Median) Value: {baseline_val}')\n    print(f'Baseline RMSE: {baseline_rmse}')\n\n    # Prepare data for LGBM\n    for col in cat_cols + bin_cols:\n        X_train[col] = X_train[col].astype('category')\n        X_val[col] = X_val[col].astype('category')\n        test_df[col] = test_df[col].astype('category')\n\n    # Train Model\n    model = LGBMRegressor(n_estimators=1000, learning_rate=0.05, num_leaves=31, random_state=42, n_jobs=-1)\n    model.fit(X_train, y_train, eval_set=[(X_val, y_val)], eval_metric='rmse', callbacks=[])\n    \n    # The above fit might need a callback for early stopping to be optimal, \n    # but let's use a reasonable number of estimators first.\n    \n    preds_val = model.predict(X_val)\n    model_rmse = root_mean_squared_error(y_val, preds_val)\n    print(f'Model RMSE: {model_rmse}')\n\n    if model_rmse < baseline_rmse:\n        print('Model beats baseline. Using model predictions.')\n        final_preds = model.predict(test_df)\n    else:\n        print('Model failed to beat baseline. Using baseline predictions.')\n        final_preds = np.full(len(test_df), baseline_val)\n\n    # Final Sanity Check\n    if np.isnan(final_preds).any() or np.isinf(final_preds).any():\n        print('Warning: Predictions contain NaNs or Infs. Filling with baseline.')\n        final_preds = np.nan_to_num(final_preds, nan=baseline_val, posinf=baseline_val, neginf=baseline_val)\n\n    # Save predictions\n    submission = pd.DataFrame({'target': final_preds})\n    submission.to_csv('/app/predictions.csv', index=False)\n    print('Predictions saved to /app/predictions.csv')\n\nif __name__ == '__main__':\n    main()\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
