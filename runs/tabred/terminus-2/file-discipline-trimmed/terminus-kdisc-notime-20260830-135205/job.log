ctor.')\n    test_preds = np.full(len(test), median_target)\n    submission = pd.DataFrame({'target': test_preds})\n    submission.to_csv('/app/predictions.csv', index=False)\n    print('Trivial predictions saved to /app/predictions.csv')\n\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
