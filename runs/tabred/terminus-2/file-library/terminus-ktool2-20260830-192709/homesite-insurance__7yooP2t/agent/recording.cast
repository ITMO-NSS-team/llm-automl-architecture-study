[18.578203, "i", "cat <<EOF > solve.py\nimport pandas as pd\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\nfrom lightautoml.tasks import Task\n\n# Load data\ntrain_df = pd.read_csv('/app/data/train.csv')\nval_df = pd.read_csv('/app/data/val.csv')\ntest_df = pd.read_csv('/app/data/test.csv')\n\n# Define target\nTARGET_COLUMN = 'target'\n\n# LightAutoML setup\ntask = Task('binary')\nroles = {'target': TARGET_COLUMN}\n\n# Time budget: set to a reasonable value for the environment, e.g., 3600 seconds (1 hour)\nautoml = TabularAutoML(task=task, timeout=3600)\n\n# Fit and predict OOF on train (and potentially val)\n# The instruction says 'train and validate any model you choose'\n# LightAutoML uses the roles to identify the target\nautoml.fit_predict(train_df, roles=roles)\n\n# Predict on test set\n# Predict returns a Prediction object, .data contains the numeric predictions\npred = automl.predict(test_df).data.reshape(-1)\n\n# Required output line\nprint('MODEL_USED=', type(automl).__name__)\n\n# Save to CSV\npredictions_df = pd.DataFrame({'target': pred})\npredictions_df.to_csv('/app/predictions.csv', index=False)\nEOF\n"]
