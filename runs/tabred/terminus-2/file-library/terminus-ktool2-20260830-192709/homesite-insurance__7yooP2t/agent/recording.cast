[1056.635273, "i", "cat <<EOF > solve.py\nimport pandas as pd\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\nfrom lightautoml.tasks import Task\nimport sys\n\ntry:\n    print('Loading data...')\n    train_df = pd.read_csv('/app/data/train.csv')\n    test_df = pd.read_csv('/app/data/test.csv')\n    print('Data loaded.')\n\n    TARGET_COLUMN = 'target'\n    task = Task('binary')\n    roles = {'target': TARGET_COLUMN}\n\n    # Set a very tight timeout to ensure it finishes\n    automl = TabularAutoML(task=task, timeout=120)\n\n    print('Fitting model...')\n    automl.fit_predict(train_df, roles=roles)\n    print('Fitting complete.')\n\n    print('Predicting...')\n    pred = automl.predict(test_df).data.reshape(-1)\n    \n    print('MODEL_USED=', type(automl).__name__)\n\n    predictions_df = pd.DataFrame({'target': pred})\n    predictions_df.to_csv('/app/predictions.csv', index=False)\n    print('Predictions saved to /app/predictions.csv')\nexcept Exception as e:\n    print(f'Error: {e}')\n    sys.exit(1)\nEOF\n"]
[1056.635615, "o", "cat <<EOF > solve.py\r\nimport pandas as pd\r\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\r\nfrom lightautoml.tasks import Task\r\nimport sys\r\n\r\ntry:\r\n    print('Loading data...')\r\n    train_df = pd.read_csv('/app/data/train.csv')\r\n    test_df = pd.read_csv('/app/data/test.csv')\r\n    print('Data loaded.')\r\n\r\n    TARGET_COLUMN = 'target'\r\n    task = Task('binary')\r\n    roles = {'target': TARGET_COLUMN}\r\n\r\n    # Set a very tight timeout to ensure it finishes\r\n    automl = TabularAutoML(task=task, timeout=120)\r\n\r\n    print('Fitting model...')\r\n    automl.fit_predict(train_df, roles=roles)\r\n    print('Fitting complete.')\r\n\r\n    print('Predicting...')\r\n    pred = automl.predict(test_df).data.reshape(-1)\r\n    \r\n    print('MODEL_USED=', type(automl).__name__)\r\n\r\n    predictions_df = pd.DataFrame({'target': pred})\r\n    predictions_df.to_csv('/app/predictions.csv', index=False)\r\n    print('Predictions saved to /app/predictions.csv')\r\nexcept Exception as e:\r\n    print(f'Error: {e}')\r\n    sys.exit(1)\r\nEOF\r\n"]
