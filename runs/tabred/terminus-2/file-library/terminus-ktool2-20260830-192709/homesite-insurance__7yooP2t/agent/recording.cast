[7.115315, "o", "total 186156\r\ndrwxr-xr-x 2 root root      4096 Aug 28 16:21 .\r\ndrwxr-xr-x 3 root root      4096 Aug 28 16:21 ..\r\n-rw-rw-r-- 1 root root      4679 Aug 27 21:18 schema.json\r\n-rw-rw-r-- 1 root root  11884185 Aug 27 21:18 test.csv\r\n-rw-rw-r-- 1 root root 163985615 Aug 27 21:18 train.csv\r\n-rw-rw-r-- 1 root root  14728219 Aug 27 21:18 val.csv\r\n\u001b[?2004h"]
