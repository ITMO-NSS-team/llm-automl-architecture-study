[709.763002, "i", "cat <<EOF > solve.py\nimport pandas as pd\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\nfrom lightautoml.tasks import Task\n\n# Load data\ntrain_df_full = pd.read_csv('/app/data/train.csv')\ntest_df = pd.read_csv('/app/data/test.csv')\n\n# Use a very small sample to guarantee completion\ntrain_df = train_df_full.sample(n=10000, random_state=42)\n\ntarget_col = 'target'\n\n# Define task and roles\ntask = Task('reg')\nroles = {'target': target_col}\n\n# Initialize TabularAutoML with a very short timeout\nautoml = TabularAutoML(task=task, timeout=60)\n\n# Fit\nautoml.fit_predict(train_df, roles=roles)\n\n# Predict on test set\npred = automl.predict(test_df).data.reshape(-1)\n\n# Save predictions\npredictions_df = pd.DataFrame({'target': pred})\npredictions_df.to_csv('/app/predictions.csv', index=False)\n\nprint('MODEL_USED=', type(automl).__name__)\nEOF\n"]
