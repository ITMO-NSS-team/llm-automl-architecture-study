[14.360789, "o", "\u001b[?2004h> from lightautoml.tasks import Task\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Load data\r\n\u001b[?2004l\r\u001b[?2004h> train_df = pd.read_csv('/app/data/train.csv')\r\n\u001b[?2004l\r\u001b[?2004h> val_df = pd.read_csv('/app/data/val.csv')\r\n\u001b[?2004l\r\u001b[?2004h> test_df = pd.read_csv('/app/data/test.csv')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> TARGET_COLUMN = 'target'\r\n\u001b[?2004l\r\u001b[?2004h> TIME_BUDGET_SECONDS = 3600\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> task = Task('reg')\r\n\u001b[?2004l\r\u001b[?2004h> roles = {'target': TARGET_COLUMN}\r\n\u001b[?2004l\r\u001b[?2004h> automl = TabularAutoML(task=task, timeout=TIME_BUDGET_SECONDS)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Fit the model using the train and validation sets\r\n\u001b[?2004l\r\u001b[?2004h> # In LightAutoML, we can provide the validation set via roles\r\n\u001b[?2004l\r\u001b[?2004h> # However, fit_predict usually takes a single dataframe and handles splits\r\n\u001b[?2004l\r\u001b[?2004h> # For better control, we can use the train_df\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Note: LightAutoML handles NaN values automatically\r\n\u001b[?2004l\r\u001b[?2004h> automl.fit_predict(train_df, roles=roles)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Predict on test set\r\n\u001b[?2004l\r\u001b[?2004h> pred = automl.predict(test_df).data.reshape(-1)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Save predictions\r\n\u001b[?2004l\r\u001b[?2004h> pred_df = pd.DataFrame({'target': pred})\r\n\u001b[?2004l\r\u001b[?2004h> pred_df.to_csv('/app/predictions.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print('MODEL_USED=', type(automl).__name__)\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
