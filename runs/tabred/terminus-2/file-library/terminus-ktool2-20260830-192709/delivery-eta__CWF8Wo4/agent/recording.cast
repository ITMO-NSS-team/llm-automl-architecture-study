[14.224432, "o", "\u001b[?2004hroot@b4788b1ec943:/workspace# "]
[14.352928, "i", "cat <<EOF > solution.py\nimport pandas as pd\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\nfrom lightautoml.tasks import Task\n\n# Load data\ntrain_df = pd.read_csv('/app/data/train.csv')\nval_df = pd.read_csv('/app/data/val.csv')\ntest_df = pd.read_csv('/app/data/test.csv')\n\nTARGET_COLUMN = 'target'\nTIME_BUDGET_SECONDS = 3600\n\ntask = Task('reg')\nroles = {'target': TARGET_COLUMN}\nautoml = TabularAutoML(task=task, timeout=TIME_BUDGET_SECONDS)\n\n# Fit the model using the train and validation sets\n# In LightAutoML, we can provide the validation set via roles\n# However, fit_predict usually takes a single dataframe and handles splits\n# For better control, we can use the train_df\n\n# Note: LightAutoML handles NaN values automatically\nautoml.fit_predict(train_df, roles=roles)\n\n# Predict on test set\npred = automl.predict(test_df).data.reshape(-1)\n\n# Save predictions\npred_df = pd.DataFrame({'target': pred})\npred_df.to_csv('/app/predictions.csv', index=False)\n\nprint('MODEL_USED=', type(automl).__name__)\nEOF\n"]
[14.353424, "o", "cat <<EOF > solution.py\r\n"]
