[249.403511, "i", "cat << 'EOF' > solution.py\nimport pandas as pd\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\nfrom lightautoml.tasks import Task\nimport sys\n\nprint('Loading data...', flush=True)\ntrain_df = pd.read_csv('/app/data/train.csv')\ntest_df = pd.read_csv('/app/data/test.csv')\n\nTARGET_COLUMN = 'target'\nTIME_BUDGET_SECONDS = 60\n\nprint('Initializing LightAutoML...', flush=True)\ntask = Task('reg')\nroles = {'target': TARGET_COLUMN}\nautoml = TabularAutoML(task=task, timeout=TIME_BUDGET_SECONDS)\n\nprint('Fitting model...', flush=True)\nautoml.fit_predict(train_df, roles=roles)\n\nprint('Predicting...', flush=True)\npred = automl.predict(test_df).data.reshape(-1)\n\nprint('Saving predictions...', flush=True)\npredictions_df = pd.DataFrame({'target': pred})\npredictions_df.to_csv('/app/predictions.csv', index=False)\n\nprint('MODEL_USED=', type(automl).__name__, flush=True)\nEOF\n"]
[249.404473, "o", "cat << 'EOF' > solution.py\r\nimport pandas as pd\r\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\r\nfrom lightautoml.tasks import Task\r\nimport sys\r\n\r\nprint('Loading data...', flush=True)\r\ntrain_df = pd.read_csv('/app/data/train.csv')\r\ntest_df = pd.read_csv('/app/data/test.csv')\r\n\r\nTARGET_COLUMN = 'target'\r\nTIME_BUDGET_SECONDS = 60\r\n\r\nprint('Initializing LightAutoML...', flush=True)\r\ntask = Task('reg')\r\nroles = {'target': TARGET_COLUMN}\r\nautoml = TabularAutoML(task=task, timeout=TIME_BUDGET_SECONDS)\r\n\r\nprint('Fitting model...', flush=True)\r\nautoml.fit_predict(train_df, roles=roles)\r\n\r\nprint('Predicting...', flush=True)\r\npred = automl.predict(test_df).data.reshape(-1)\r\n\r\nprint('Saving predictions...', flush=True)\r\npredictions_df = pd.DataFrame({'target': pred})\r\npredictions_df.to_csv('/app/predictions.csv', index=False)\r\n\r\nprint('MODEL_USED=', type(automl).__name__, flush=True)\r\nEOF\r\n"]
