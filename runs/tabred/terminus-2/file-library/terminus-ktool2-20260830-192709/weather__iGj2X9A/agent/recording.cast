[132.413984, "i", "cat << 'EOF' > solution.py\nimport pandas as pd\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\nfrom lightautoml.tasks import Task\nimport sys\n\ndef main():\n    print('Loading data...')\n    sys.stdout.flush()\n    train_df = pd.read_csv('/app/data/train.csv')\n    test_df = pd.read_csv('/app/data/test.csv')\n    print('Data loaded.')\n    sys.stdout.flush()\n\n    task = Task('reg')\n    roles = {'target': 'target'}\n    # Reduced timeout to 300s for faster feedback\n    automl = TabularAutoML(task=task, timeout=300)\n    \n    print('Fitting model...')\n    sys.stdout.flush()\n    automl.fit_predict(train_df, roles=roles)\n    print('Model fitted.')\n    sys.stdout.flush()\n    \n    print('Predicting...')\n    sys.stdout.flush()\n    pred = automl.predict(test_df).data.reshape(-1)\n    \n    predictions_df = pd.DataFrame({'target': pred})\n    predictions_df.to_csv('/app/predictions.csv', index=False)\n    print('Predictions saved to /app/predictions.csv')\n    sys.stdout.flush()\n    \n    print('MODEL_USED=', type(automl).__name__)\n    sys.stdout.flush()\n\nif __name__ == '__main__':\n    main()\nEOF\n"]
[132.414253, "o", "cat << 'EOF' > solution.py\r\nimport pandas as pd\r\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\r\nfrom lightautoml.tasks import Task\r\nimport sys\r\n\r\ndef main():\r\n    print('Loading data...')\r\n    sys.stdout.flush()\r\n    train_df = pd.read_csv('/app/data/train.csv')\r\n    test_df = pd.read_csv('/app/data/test.csv')\r\n    print('Data loaded.')\r\n    sys.stdout.flush()\r\n\r\n    task = Task('reg')\r\n    roles = {'target': 'target'}\r\n    # Reduced timeout to 300s for faster feedback\r\n    automl = TabularAutoML(task=task, timeout=300)\r\n    \r\n    print('Fitting model...')\r\n    sys.stdout.flush()\r\n    automl.fit_predict(train_df, roles=roles)\r\n    print('Model fitted.')\r\n    sys.stdout.flush()\r\n    \r\n    print('Predicting...')\r\n    sys.stdout.flush()\r\n    pred = automl.predict(test_df).data.reshape(-1)\r\n    \r\n    predictions_df = pd.DataFrame({'target': pred})\r\n    predictions_df.to_csv('/app/predictions.csv', index=False)\r\n    print('Predictions saved to /app/predictions.csv')\r\n    sys.stdout.flush()\r\n    \r\n    print('MODEL_USED=', type(automl).__name__)\r\n    sys.stdout.flush()\r\n\r\nif __name__ == '__main__':\r\n    main()\r\nEOF\r\n"]
