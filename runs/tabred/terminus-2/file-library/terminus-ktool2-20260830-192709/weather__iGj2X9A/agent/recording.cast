[9.326432, "o", "\u001b[?2004hroot@8d20974f76eb:/workspace# "]
[24.267109, "i", "cat << 'EOF' > solution.py\nimport pandas as pd\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\nfrom lightautoml.tasks import Task\n\ndef main():\n    train_df = pd.read_csv('/app/data/train.csv')\n    test_df = pd.read_csv('/app/data/test.csv')\n\n    task = Task('reg')\n    roles = {'target': 'target'}\n    # Setting a reasonable timeout for the competition environment\n    automl = TabularAutoML(task=task, timeout=3600)\n    \n    # fit_predict returns OOF predictions\n    automl.fit_predict(train_df, roles=roles)\n    \n    # Generate predictions for test set\n    pred = automl.predict(test_df).data.reshape(-1)\n    \n    # Create DataFrame and save to CSV\n    predictions_df = pd.DataFrame({'target': pred})\n    predictions_df.to_csv('/app/predictions.csv', index=False)\n    \n    print('MODEL_USED=', type(automl).__name__)\n\nif __name__ == '__main__':\n    main()\nEOF\n"]
