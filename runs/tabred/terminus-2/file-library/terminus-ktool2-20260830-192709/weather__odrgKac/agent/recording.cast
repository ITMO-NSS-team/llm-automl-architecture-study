[305.763375, "i", "cat <<EOF > solution.py\nimport pandas as pd\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\nfrom lightautoml.tasks import Task\n\n# Load data\ntrain_df = pd.read_csv('/app/data/train.csv')\ntest_df = pd.read_csv('/app/data/test.csv')\n\nTARGET_COLUMN = 'target'\n# Reduce timeout to ensure it finishes\nTIME_BUDGET_SECONDS = 600 \n\ntask = Task('reg')\nroles = {'target': TARGET_COLUMN}\nautoml = TabularAutoML(task=task, timeout=TIME_BUDGET_SECONDS)\n\n# Fit and predict\nautoml.fit_predict(train_df, roles=roles)\n\n# Predict on test\npred = automl.predict(test_df).data.reshape(-1)\n\n# Save predictions\nsubmission = pd.DataFrame({'target': pred})\nsubmission.to_csv('/app/predictions.csv', index=False)\n\nprint('MODEL_USED=', type(automl).__name__)\nEOF\n"]
[305.763695, "o", "cat <<EOF > solution.py\r\nimport pandas as pd\r\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\r\nfrom lightautoml.tasks import Task\r\n\r\n# Load data\r\ntrain_df = pd.read_csv('/app/data/train.csv')\r\ntest_df = pd.read_csv('/app/data/test.csv')\r\n\r\nTARGET_COLUMN = 'target'\r\n# Reduce timeout to ensure it finishes\r\nTIME_BUDGET_SECONDS = 600 \r\n\r\ntask = Task('reg')\r\nroles = {'target': TARGET_COLUMN}\r\nautoml = TabularAutoML(task=task, timeout=TIME_BUDGET_SECONDS)\r\n\r\n# Fit and predict\r\nautoml.fit_predict(train_df, roles=roles)\r\n\r\n# Predict on test\r\npred = automl.predict(test_df).data.reshape(-1)\r\n\r\n# Save predictions\r\nsubmission = pd.DataFrame({'target': pred})\r\nsubmission.to_csv('/app/predictions.csv', index=False)\r\n\r\nprint('MODEL_USED=', type(automl).__name__)\r\nEOF\r\n"]
