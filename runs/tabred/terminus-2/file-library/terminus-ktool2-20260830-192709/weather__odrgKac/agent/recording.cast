[14.26825, "o", "\u001b[?2004hroot@776b91718ef9:/workspace# "]
[14.385475, "i", "cat <<EOF > solution.py\nimport pandas as pd\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\nfrom lightautoml.tasks import Task\n\n# Load data\ntrain_df = pd.read_csv('/app/data/train.csv')\nval_df = pd.read_csv('/app/data/val.csv')\ntest_df = pd.read_csv('/app/data/test.csv')\n\nTARGET_COLUMN = 'target'\nTIME_BUDGET_SECONDS = 3600 # 1 hour\n\ntask = Task('reg')\nroles = {'target': TARGET_COLUMN}\nautoml = TabularAutoML(task=task, timeout=TIME_BUDGET_SECONDS)\n\n# Fit and predict OOF\n# Use train_df and val_df for training and validation if possible, \n# but fit_predict typically handles the split or takes the whole train set\n# To utilize val_df for better evaluation, we can combine or just use train_df\n# LightAutoML fit_predict expects the target in the dataframe\n\nautoml.fit_predict(train_df, roles=roles)\n\n# Predict on test\npred = automl.predict(test_df).data.reshape(-1)\n\n# Save predictions\nsubmission = pd.DataFrame({'target': pred})\nsubmission.to_csv('/app/predictions.csv', index=False)\n\nprint('MODEL_USED=', type(automl).__name__)\nEOF\n"]
