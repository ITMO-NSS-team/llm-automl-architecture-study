[425.640803, "i", "cat << 'EOF' > solution.py\nimport pandas as pd\nimport numpy as np\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\nfrom lightautoml.tasks import Task\nimport os\n\nprint('Loading data...')\ntrain_df = pd.read_csv('/app/data/train.csv')\ntest_df = pd.read_csv('/app/data/test.csv')\nprint(f'Train shape: {train_df.shape}, Test shape: {test_df.shape}')\n\nTARGET_COLUMN = 'target'\n\nprint('Initializing LightAutoML...')\ntask = Task('binary')\nroles = {'target': TARGET_COLUMN}\nautoml = TabularAutoML(task=task, timeout=1800)\n\nprint('Fitting model...')\nautoml.fit_predict(train_df, roles=roles)\n\nprint('Predicting...')\npred = automl.predict(test_df).data.reshape(-1)\n\nprint('Saving predictions...')\nsubmission = pd.DataFrame({'target': pred})\nsubmission.to_csv('/app/predictions.csv', index=False)\n\nprint('MODEL_USED=', type(automl).__name__)\nprint('Predictions saved to /app/predictions.csv')\nEOF\n"]
[425.641011, "o", "cat << 'EOF' > solution.py\r\nimport pandas as pd\r\nimport numpy as np\r\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\r\nfrom lightautoml.tasks import Task\r\nimport os\r\n\r\nprint('Loading data...')\r\ntrain_df = pd.read_csv('/app/data/train.csv')\r\ntest_df = pd.read_csv('/app/data/test.csv')\r\nprint(f'Train shape: {train_df.shape}, Test shape: {test_df.shape}')\r\n\r\nTARGET_COLUMN = 'target'\r\n\r\nprint('Initializing LightAutoML...')\r\ntask = Task('binary')\r\nroles = {'target': TARGET_COLUMN}\r\nautoml = TabularAutoML(task=task, timeout=1800)\r\n\r\nprint('Fitting model...')\r\nautoml.fit_predict(train_df, roles=roles)\r\n\r\nprint('Predicting...')\r\npred = automl.predict(test_df).data.reshape(-1)\r\n\r\nprint('Saving predictions...')\r\nsubmission = pd.DataFrame({'target': pred})\r\nsubmission.to_csv('/app/predictions.csv', index=False)\r\n\r\nprint('MODEL_USED=', type(automl).__name__)\r\nprint('Predictions saved to /app/predictions.csv')\r\nEOF\r\n"]
