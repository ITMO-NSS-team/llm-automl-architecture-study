[478.922254, "i", "cat <<EOF > solution.py\nimport pandas as pd\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\nfrom lightautoml.tasks import Task\n\n# Load data\ntrain_df = pd.read_csv('/app/data/train.csv')\ntest_df = pd.read_csv('/app/data/test.csv')\n\n# Define task and roles\ntask = Task('binary')\nroles = {'target': 'target'}\n\n# Initialize and fit LightAutoML with a shorter timeout for efficiency\nautoml = TabularAutoML(task=task, timeout=600)\nautoml.fit_predict(train_df, roles=roles)\n\n# Predict on test set\npred = automl.predict(test_df).data.reshape(-1)\n\n# Write to CSV\npred_df = pd.DataFrame({'target': pred})\npred_df.to_csv('/app/predictions.csv', index=False)\n\nprint('MODEL_USED=', type(automl).__name__)\nEOF\n"]
[478.922482, "o", "cat <<EOF > solution.py\r\nimport pandas as pd\r\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\r\nfrom lightautoml.tasks import Task\r\n\r\n# Load data\r\ntrain_df = pd.read_csv('/app/data/train.csv')\r\ntest_df = pd.read_csv('/app/data/test.csv')\r\n\r\n# Define task and roles\r\ntask = Task('binary')\r\nroles = {'target': 'target'}\r\n\r\n# Initialize and fit LightAutoML with a shorter timeout for efficiency\r\nautoml = TabularAutoML(task=task, timeout=600)\r\nautoml.fit_predict(train_df, roles=roles)\r\n\r\n# Predict on test set\r\npred = automl.predict(test_df).data.reshape(-1)\r\n\r\n# Write to CSV\r\npred_df = pd.DataFrame({'target': pred})\r\npred_df.to_csv('/app/predictions.csv', index=False)\r\n\r\nprint('MODEL_USED=', type(automl).__name__)\r\nEOF\r\n"]
