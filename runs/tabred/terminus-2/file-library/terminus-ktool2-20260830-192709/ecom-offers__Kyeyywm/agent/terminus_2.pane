cat << 'EOF' > solution.py
import pandas as pd
from lightautoml.automl.presets.tabular_presets import TabularAutoML
from lightautoml.tasks import Task

train_df = pd.read_csv('/app/data/train.csv')
test_df = pd.read_csv('/app/data/test.csv')
task = Task('binary')
roles = {'target': 'target'}
automl = TabularAutoML(task=task, timeout=120)
automl.fit_predict(train_df, roles=roles)
pred_df = automl.predict(test_df)
pred = pred_df.data.reshape(-1)
pred_final = pd.DataFrame({'target': pred})
pred_final.to_csv('/app/predictions.csv', index=False)
print('MODEL_USED=', type(automl).__name__)
EOF
nohup python3 solution.py > output.log 2>&1 &
sleep 60
cat output.log
ls -la /app/predictions.csv
cat output.log
ls -la /app/predictions.csv
ls -la /app/predictions.csv
cat output.log
ls -la /app/predictions.csv
cat output.log
