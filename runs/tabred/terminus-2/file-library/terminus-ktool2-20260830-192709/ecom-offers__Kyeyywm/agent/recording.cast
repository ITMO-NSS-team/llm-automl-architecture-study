[507.068011, "i", "cat << 'EOF' > solution.py\nimport pandas as pd\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\nfrom lightautoml.tasks import Task\n\ntrain_df = pd.read_csv('/app/data/train.csv')\ntest_df = pd.read_csv('/app/data/test.csv')\ntask = Task('binary')\nroles = {'target': 'target'}\nautoml = TabularAutoML(task=task, timeout=120)\nautoml.fit_predict(train_df, roles=roles)\npred_df = automl.predict(test_df)\npred = pred_df.data.reshape(-1)\npred_final = pd.DataFrame({'target': pred})\npred_final.to_csv('/app/predictions.csv', index=False)\nprint('MODEL_USED=', type(automl).__name__)\nEOF\n"]
[507.068246, "o", "cat << 'EOF' > solution.py\r\nimport pandas as pd\r\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\r\nfrom lightautoml.tasks import Task\r\n\r\ntrain_df = pd.read_csv('/app/data/train.csv')\r\ntest_df = pd.read_csv('/app/data/test.csv')\r\ntask = Task('binary')\r\nroles = {'target': 'target'}\r\nautoml = TabularAutoML(task=task, timeout=120)\r\nautoml.fit_predict(train_df, roles=roles)\r\npred_df = automl.predict(test_df)\r\npred = pred_df.data.reshape(-1)\r\npred_final = pd.DataFrame({'target': pred})\r\npred_final.to_csv('/app/predictions.csv', index=False)\r\nprint('MODEL_USED=', type(automl).__name__)\r\nEOF\r\n"]
