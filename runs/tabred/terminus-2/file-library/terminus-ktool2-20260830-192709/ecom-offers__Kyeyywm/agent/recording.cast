[315.143026, "i", "cat << 'EOF' > solution.py\nimport pandas as pd\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\nfrom lightautoml.tasks import Task\n\n# Load data\ntrain_df = pd.read_csv('/app/data/train.csv')\ntest_df = pd.read_csv('/app/data/test.csv')\n\n# Setup LightAutoML\ntask = Task('binary')\nroles = {'target': 'target'}\n# Use a shorter timeout to ensure completion\nautoml = TabularAutoML(task=task, timeout=300)\n\n# Fit and predict\nautoml.fit_predict(train_df, roles=roles)\n\n# Predict on test set\npred_df = automl.predict(test_df)\npred = pred_df.data.reshape(-1)\n\n# Save predictions\npred_final = pd.DataFrame({'target': pred})\npred_final.to_csv('/app/predictions.csv', index=False)\n\nprint('MODEL_USED=', type(automl).__name__)\nEOF\n"]
[315.143737, "o", "cat << 'EOF' > solution.py\r\nimport pandas as pd\r\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\r\nfrom lightautoml.tasks import Task\r\n\r\n# Load data\r\ntrain_df = pd.read_csv('/app/data/train.csv')\r\ntest_df = pd.read_csv('/app/data/test.csv')\r\n\r\n# Setup LightAutoML\r\ntask = Task('binary')\r\nroles = {'target': 'target'}\r\n# Use a shorter timeout to ensure completion\r\nautoml = TabularAutoML(task=task, timeout=300)\r\n\r\n# Fit and predict\r\nautoml.fit_predict(train_df, roles=roles)\r\n\r\n# Predict on test set\r\npred_df = automl.predict(test_df)\r\npred = pred_df.data.reshape(-1)\r\n\r\n# Save predictions\r\npred_final = pd.DataFrame({'target': pred})\r\npred_final.to_csv('/app/predictions.csv', index=False)\r\n\r\nprint('MODEL_USED=', type(automl).__name__)\r\nEOF\r\n"]
