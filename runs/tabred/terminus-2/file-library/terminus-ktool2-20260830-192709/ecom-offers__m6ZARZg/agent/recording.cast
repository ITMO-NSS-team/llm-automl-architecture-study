[265.481703, "i", "cat << 'EOF' > solution.py\nimport pandas as pd\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\nfrom lightautoml.tasks import Task\n\n# Load data\ntrain_df = pd.read_csv('/app/data/train.csv')\ntest_df = pd.read_csv('/app/data/test.csv')\n\n# Task configuration\ntask = Task('binary')\nroles = {'target': 'target'}\n\n# LightAutoML setup - reduce timeout for faster execution\nautoml = TabularAutoML(task=task, timeout=600)\n\n# Fit and predict\n# fit_predict internally uses a validation set if provided, but we'll use train_df\noof = automl.fit_predict(train_df, roles=roles)\n\n# Predict probabilities for test set\npred = automl.predict(test_df).data.reshape(-1)\n\n# Save predictions\npred_df = pd.DataFrame({'target': pred})\npred_df.to_csv('/app/predictions.csv', index=False)\n\nprint('MODEL_USED=', type(automl).__name__)\nEOF\n"]
[265.482011, "o", "cat << 'EOF' > solution.py\r\nimport pandas as pd\r\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\r\nfrom lightautoml.tasks import Task\r\n\r\n# Load data\r\ntrain_df = pd.read_csv('/app/data/train.csv')\r\ntest_df = pd.read_csv('/app/data/test.csv')\r\n\r\n# Task configuration\r\ntask = Task('binary')\r\nroles = {'target': 'target'}\r\n\r\n# LightAutoML setup - reduce timeout for faster execution\r\nautoml = TabularAutoML(task=task, timeout=600)\r\n\r\n# Fit and predict\r\n# fit_predict internally uses a validation set if provided, but we'll use train_df\r\noof = automl.fit_predict(train_df, roles=roles)\r\n\r\n# Predict probabilities for test set\r\npred = automl.predict(test_df).data.reshape(-1)\r\n\r\n# Save predictions\r\npred_df = pd.DataFrame({'target': pred})\r\npred_df.to_csv('/app/predictions.csv', index=False)\r\n\r\nprint('MODEL_USED=', type(automl).__name__)\r\nEOF\r\n"]
