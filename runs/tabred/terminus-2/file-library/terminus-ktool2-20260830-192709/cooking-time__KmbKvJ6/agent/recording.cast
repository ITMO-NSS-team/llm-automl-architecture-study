[17.773491, "i", "cat <<EOF > solve.py\nimport pandas as pd\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\nfrom lightautoml.tasks import Task\n\n# Load data\ntrain_df = pd.read_csv('/app/data/train.csv')\nval_df = pd.read_csv('/app/data/val.csv')\ntest_df = pd.read_csv('/app/data/test.csv')\n\n# Define task\nTARGET_COLUMN = 'target'\ntask = Task('reg')\nroles = {'target': TARGET_COLUMN}\n\n# Initialize LightAutoML\n# Using a modest timeout for efficiency while maintaining quality\nautoml = TabularAutoML(task=task, timeout=600)\n\n# Fit and predict on train (oof = out-of-fold predictions)\n# We use train_df which includes the target\nautoml.fit_predict(train_df, roles=roles)\n\n# Predict on test\npred = automl.predict(test_df).data.reshape(-1)\n\n# Save predictions\npred_df = pd.DataFrame({'target': pred})\npred_df.to_csv('/app/predictions.csv', index=False)\n\nprint('MODEL_USED=', type(automl).__name__)\nEOF\n"]
[17.773886, "o", "cat <<EOF > solve.py\r\n\u001b[?2004l\r"]
