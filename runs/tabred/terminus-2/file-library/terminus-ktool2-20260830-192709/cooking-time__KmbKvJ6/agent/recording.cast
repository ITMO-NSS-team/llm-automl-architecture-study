[360.021015, "i", "cat <<EOF > solve_test.py\nimport pandas as pd\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\nfrom lightautoml.tasks import Task\n\ntrain_df = pd.read_csv('/app/data/train.csv').head(1000)\ntest_df = pd.read_csv('/app/data/test.csv').head(100)\n\nTARGET_COLUMN = 'target'\ntask = Task('reg')\nroles = {'target': TARGET_COLUMN}\nautoml = TabularAutoML(task=task, timeout=30)\nautoml.fit_predict(train_df, roles=roles)\npred = automl.predict(test_df).data.reshape(-1)\npred_df = pd.DataFrame({'target': pred})\npred_df.to_csv('/app/predictions_test.csv', index=False)\nprint('MODEL_USED=', type(automl).__name__)\nEOF\n"]
[360.021521, "o", "cat <<EOF > solve_test.py\r\nimport pandas as pd\r\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\r\nfrom lightautoml.tasks import Task\r\n\r\ntrain_df = pd.read_csv('/app/data/train.csv').head(1000)\r\ntest_df = pd.read_csv('/app/data/test.csv').head(100)\r\n\r\nTARGET_COLUMN = 'target'\r\ntask = Task('reg')\r\nroles = {'target': TARGET_COLUMN}\r\nautoml = TabularAutoML(task=task, timeout=30)\r\nautoml.fit_predict(train_df, roles=roles)\r\npred = automl.predict(test_df).data.reshape(-1)\r\npred_df = pd.DataFrame({'target': pred})\r\npred_df.to_csv('/app/predictions_test.csv', index=False)\r\nprint('MODEL_USED=', type(automl).__name__)\r\nEOF\r\n"]
[360.121051, "i", "python3 solve_test.py\n"]
