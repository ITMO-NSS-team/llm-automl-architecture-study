[132.991658, "i", "cat <<EOF > solution.py\nimport pandas as pd\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\nfrom lightautoml.tasks import Task\n\n# Load data\ntrain_df = pd.read_csv('/app/data/train.csv')\ntest_df = pd.read_csv('/app/data/test.csv')\n\ntask = Task('reg')\nroles = {'target': 'target'}\n\n# Short timeout for testing\nautoml = TabularAutoML(task=task, timeout=30)\n\n# Use a subset of data for faster verification\ntrain_subset = train_df.sample(frac=0.1, random_state=42)\noof = automl.fit_predict(train_subset, roles=roles)\n\npred = automl.predict(test_df).data.reshape(-1)\npred_df = pd.DataFrame({'target': pred})\npred_df.to_csv('/app/predictions.csv', index=False)\n\nprint('MODEL_USED=', type(automl).__name__)\nEOF\n"]
[132.992216, "o", "cat <<EOF > solution.py\r\nimport pandas as pd\r\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\r\nfrom lightautoml.tasks import Task\r\n\r\n# Load data\r\ntrain_df = pd.read_csv('/app/data/train.csv')\r\ntest_df = pd.read_csv('/app/data/test.csv')\r\n\r\ntask = Task('reg')\r\nroles = {'target': 'target'}\r\n\r\n# Short timeout for testing\r\nautoml = TabularAutoML(task=task, timeout=30)\r\n\r\n# Use a subset of data for faster verification\r\ntrain_subset = train_df.sample(frac=0.1, random_state=42)\r\noof = automl.fit_predict(train_subset, roles=roles)\r\n\r\npred = automl.predict(test_df).data.reshape(-1)\r\npred_df = pd.DataFrame({'target': pred})\r\npred_df.to_csv('/app/predictions.csv', index=False)\r\n\r\nprint('MODEL_USED=', type(automl).__name__)\r\nEOF\r\n"]
[133.124906, "i", "python3 solution.py\n"]
[133.125225, "o", "python3 solution.py\r\n"]
[207.741991, "i", "cat <<EOF > solution.py\nimport pandas as pd\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\nfrom lightautoml.tasks import Task\n\ntrain_df = pd.read_csv('/app/data/train.csv')\ntest_df = pd.read_csv('/app/data/test.csv')\ntask = Task('reg')\nroles = {'target': 'target'}\nautoml = TabularAutoML(task=task, timeout=300)\nautoml.fit_predict(train_df, roles=roles)\npred = automl.predict(test_df).data.reshape(-1)\npred_df = pd.DataFrame({'target': pred})\npred_df.to_csv('/app/predictions.csv', index=False)\nprint('MODEL_USED=', type(automl).__name__)\nEOF\n"]
[207.743353, "o", "cat <<EOF > solution.py\r\nimport pandas as pd\r\nfrom lightautoml.automl.presets.tabular_presets import TabularAutoML\r\nfrom lightautoml.tasks import Task\r\n\r\ntrain_df = pd.read_csv('/app/data/train.csv')\r\ntest_df = pd.read_csv('/app/data/test.csv')\r\ntask = Task('reg')\r\nroles = {'target': 'target'}\r\nautoml = TabularAutoML(task=task, timeout=300)\r\nautoml.fit_predict(train_df, roles=roles)\r\npred = automl.predict(test_df).data.reshape(-1)\r\npred_df = pd.DataFrame({'target': pred})\r\npred_df.to_csv('/app/predictions.csv', index=False)\r\nprint('MODEL_USED=', type(automl).__name__)\r\nEOF\r\n"]
