[139.550363, "o", "\u001b[?2004h> )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Train model\r\n\u001b[?2004l\r\u001b[?2004h> model.fit(X_train, y_train)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Predict on test set\r\n\u001b[?2004l\r\u001b[?2004h> preds = model.predict(X_test)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.550425, "o", "# Save predictions to CSV\r\n\u001b[?2004l\r\u001b[?2004h> preds_df = pd.DataFrame({'target': preds})\r\n\u001b[?2004l\r\u001b[?2004h> "]
[139.550589, "o", "preds_df.to_csv('/app/predictions.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
