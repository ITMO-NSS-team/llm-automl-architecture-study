[19.653353, "o", "\u001b[?2004hroot@c88dbe21840e:/workspace# "]
[26.776732, "i", "cat << 'EOF' > solution.py\nimport pandas as pd\nimport lightgbm as lgb\nimport numpy as np\n\n# Load data\ntrain = pd.read_csv('/app/data/train.csv')\nval = pd.read_csv('/app/data/val.csv')\ntest = pd.read_csv('/app/data/test.csv')\n\nX_train = train.drop(columns=['target'])\ny_train = train['target']\nX_val = val.drop(columns=['target'])\ny_val = val['target']\n\n# Identify feature types\nnum_cols = [c for c in X_train.columns if c.startswith('num_')]\nbin_cols = [c for c in X_train.columns if c.startswith('bin_')]\ncat_cols = [c for c in X_train.columns if c.startswith('cat_')]\n\n# Basic preprocessing\n# LightGBM handles NaNs and categorical features if specified\nfor col in cat_cols:\n    X_train[col] = X_train[col].astype('category')\n    X_val[col] = X_val[col].astype('category')\n    test[col] = test[col].astype('category')\n\n# Model training\nmodel = lgb.LGBMRegressor(\n    n_estimators=1000,\n    learning_rate=0.05,\n    num_leaves=31,\n    random_state=42,\n    n_jobs=-1\n)\n\nmodel.fit(\n    X_train, y_train,\n    eval_set=[(X_val, y_val)],\n    eval_metric='rmse',\n    callbacks=[lgb.early_stopping(stopping_rounds=50)]\n)\n\n# Prediction\npreds = model.predict(test)\n\n# Save predictions\noutput = pd.DataFrame({'target': preds})\noutput.to_csv('/app/predictions.csv', index=False)\nEOF\n"]
