[145.810242, "o", "\u001b[?2004hroot@3fa1c9d82a72:/workspace# "]
[243.343895, "i", "cat << 'EOF' > solution.py\nimport pandas as pd\nfrom sklearn.ensemble import HistGradientBoostingClassifier\nimport numpy as np\n\n# Load data\ntrain = pd.read_csv('/app/data/train.csv')\nval = pd.read_csv('/app/data/val.csv')\ntest = pd.read_csv('/app/data/test.csv')\n\nX_train = train.drop(columns=['target'])\ny_train = train['target']\nX_val = val.drop(columns=['target'])\ny_val = val['target']\nX_test = test\n\n# HistGradientBoostingClassifier handles NaNs automatically\n# It is conceptually similar to LightGBM\nmodel = HistGradientBoostingClassifier(\n    max_iter=100,\n    learning_rate=0.1,\n    max_depth=10,\n    random_state=42\n)\n\nmodel.fit(X_train, y_train)\n\n# Predict probabilities for the positive class\n# predict_proba returns [prob_class_0, prob_class_1]\npreds_proba = model.predict_proba(X_test)[:, 1]\n\n# Save predictions to CSV\npred_df = pd.DataFrame({'target': preds_proba})\npred_df.to_csv('/app/predictions.csv', index=False)\nEOF\n"]
