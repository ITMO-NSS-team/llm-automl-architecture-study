[?2004hroot@3fa1c9d82a72:/workspace# cat << 'EOF' > solution.py
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> from sklearn.ensemble import HistGradientBoostingClassifier
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h> train = pd.read_csv('/app/data/train.csv')
[?2004l[?2004h> val = pd.read_csv('/app/data/val.csv')
[?2004l[?2004h> test = pd.read_csv('/app/data/test.csv')
[?2004l[?2004h> 
[?2004l[?2004h> X_train = train.drop(columns=['target'])
[?2004l[?2004h> y_train = train['target']
[?2004l[?2004h> X_val = val.drop(columns=['target'])
[?2004l[?2004h> y_val = val['target']
[?2004l[?2004h> X_test = test
[?2004l[?2004h> 
[?2004l[?2004h> # HistGradientBoostingClassifier handles NaNs automatically
[?2004l[?2004h> # It is conceptually similar to LightGBM
[?2004l[?2004h> model = HistGradientBoostingClassifier(
[?2004l[?2004h>     max_iter=100,
[?2004l[?2004h>     learning_rate=0.1,
[?2004l[?2004h>     max_depth=10,
[?2004l[?2004h>     random_state=42
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> model.fit(X_train, y_train)
[?2004l[?2004h> 
[?2004l[?2004h> # Predict probabilities for the positive class
[?2004l[?2004h> # predict_proba returns [prob_class_0, prob_class_1]
[?2004l[?2004h> preds_proba = model.predict_proba(X_test)[:, 1]
[?2004l[?2004h> 
[?2004l[?2004h> # Save predictions to CSV
[?2004l[?2004h> pred_df = pd.DataFrame({'target': preds_proba})
[?2004l[?2004h> pred_df.to_csv('/app/predictions.csv', index=False)
[?2004l[?2004h> EOF
