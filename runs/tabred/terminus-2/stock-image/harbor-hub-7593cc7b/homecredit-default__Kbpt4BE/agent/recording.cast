[20.642682, "i", "cat << 'EOF' > solution.py\nimport pandas as pd\nimport lightgbm as lgb\nfrom sklearn.metrics import roc_auc_score\n\n# Load data\ntrain = pd.read_csv('/app/data/train.csv')\nval = pd.read_csv('/app/data/val.csv')\ntest = pd.read_csv('/app/data/test.csv')\n\ntarget_col = 'target'\nX_train = train.drop(columns=[target_col])\ny_train = train[target_col]\nX_val = val.drop(columns=[target_col])\ny_val = val[target_col]\n\n# Identify feature types\ncat_features = [col for col in X_train.columns if col.startswith('cat_') or col.startswith('bin_')]\nfor col in cat_features:\n    X_train[col] = X_train[col].astype('category')\n    X_val[col] = X_val[col].astype('category')\n    test[col] = test[col].astype('category')\n\n# Initialize and train model\nmodel = lgb.LGBMClassifier(\n    n_estimators=1000,\n    learning_rate=0.05,\n    num_leaves=31,\n    objective='binary',\n    metric='auc',\n    random_state=42,\n    n_jobs=-1\n)\n\nmodel.fit(\n    X_train, y_train,\n    eval_set=[(X_val, y_val)],\n    callbacks=[lgb.early_stopping(stopping_rounds=50)]\n)\n\n# Predict\nprobs = model.predict_proba(test)[:, 1]\n\n# Save predictions\npred_df = pd.DataFrame({'target': probs})\npred_df.to_csv('/app/predictions.csv', index=False)\nEOF\n"]
[20.642983, "o", "cat << 'EOF' > solution.py\r\nimport pandas as pd\r\nimport lightgbm as lgb\r\nfrom sklearn.metrics import roc_auc_score\r\n\r\n# Load data\r\ntrain = pd.read_csv('/app/data/train.csv')\r\nval = pd.read_csv('/app/data/val.csv')\r\ntest = pd.read_csv('/app/data/test.csv')\r\n\r\ntarget_col = 'target'\r\nX_train = train.drop(columns=[target_col])\r\ny_train = train[target_col]\r\nX_val = val.drop(columns=[target_col])\r\ny_val = val[target_col]\r\n\r\n# Identify feature types\r\ncat_features = [col for col in X_train.columns if col.startswith('cat_') or col.startswith('bin_')]\r\nfor col in cat_features:\r\n    X_train[col] = X_train[col].astype('category')\r\n    X_val[col] = X_val[col].astype('category')\r\n    test[col] = test[col].astype('category')\r\n\r\n# Initialize and train model\r\nmodel = lgb.LGBMClassifier(\r\n    n_estimators=1000,\r\n    learning_rate=0.05,\r\n    num_leaves=31,\r\n    objective='binary',\r\n    metric='auc',\r\n    random_state=42,\r\n    n_jobs=-1\r\n)\r\n\r\nmodel.fit(\r\n    X_train, y_train,\r\n    eval_set=[(X_val, y_val)],\r\n    callbacks=[lgb.early_stopping(stopping_rounds=50)]\r\n)\r\n\r\n# Predict\r\nprobs = model.predict_proba(test)[:, 1]\r\n\r\n# Save predictions\r\npred_df = pd.DataFrame({'target': probs})\r\npred_df.to_csv('/app/predictions.csv', index=False)\r\nEOF\r\n"]
[20.735175, "i", "python3 solution.py\n"]
