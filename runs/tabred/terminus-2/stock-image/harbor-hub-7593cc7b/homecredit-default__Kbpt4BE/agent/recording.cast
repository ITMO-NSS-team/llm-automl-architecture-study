[21.743403, "o", "    eval_set=[(X_val, y_val)],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[21.74347, "o", "    callbacks=[lgb.early_stopping(stopping_rounds=50)]\r\n\u001b[?2004l\r\u001b[?2004h> )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[21.743533, "o", "# Predict\r\n\u001b[?2004l\r\u001b[?2004h"]
[21.743559, "o", "> probs = model.predict_proba(test)[:, 1]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[21.743602, "o", "\u001b[?2004h> # Save predictions\r\n\u001b[?2004l\r\u001b[?2004h> "]
[21.743722, "o", "pred_df = pd.DataFrame({'target': probs})\r\n\u001b[?2004l\r\u001b[?2004h> pred_df.to_csv('/app/predictions.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
