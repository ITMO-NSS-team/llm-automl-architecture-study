[0m[?2004hroot@845657bf18e5:/workspace# cat << 'EOF' > solution.py
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import lightgbm as lgb
[?2004l[?2004h> from sklearn.preprocessing import LabelEncoder
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h> print('Loading data...')
[?2004l[?2004h> train = pd.read_csv('/app/data/train.csv')
[?2004l[?2004h> val = pd.read_csv('/app/data/val.csv')
[?2004l[?2004h> test = pd.read_csv('/app/data/test.csv')
[?2004l[?2004h> 
[?2004l[?2004h> y = train['target']
[?2004l[?2004h> X = train.drop(columns=['target'])
[?2004l[?2004h> y_val = val['target']
[?2004l[?2004h> X_val = val.drop(columns=['target'])
[?2004l[?2004h> X_test = test
[?2004l[?2004h> 
[?2004l[?2004h> # Identify columns
[?2004l[?2004h> num_cols = [c for c in X.columns if c.startswith('num_')]
[?2004l[?2004h> bin_cols = [c for c in X.columns if c.startswith('bin_')]
[?2004l[?2004h> cat_cols = [c for c in X.columns if c.startswith('cat_')]
[?2004l[?2004h> 
[?2004l[?2004h> # Preprocess categorical features
[?2004l[?2004h> for col in cat_cols:
[?2004l[?2004h>     le = LabelEncoder()
[?2004l[?2004h>     # Fit on combined train and val to ensure all categories are covered
[?2004l[?2004h>     all_cats = pd.concat([X[col], X_val[col], X_test[col]]).astype(str)
[?2004l[?2004h>     le.fit(all_cats)
[?2004l[?2004h>     X[col] = le.transform(X[col].astype(str))
[?2004l[?2004h>     X_val[col] = le.transform(X_val[col].astype(str))
[?2004l[?2004h>     X_test[col] = le.transform(X_test[col].astype(str))
[?2004l[?2004h> 
[?2004l[?2004h> # Train LightGBM
[?2004l[?2004h> print('Training model...')
[?2004l[?2004h> model = lgb.LGBMRegressor(
[?2004l[?2004h>     n_estimators=1000,
[?2004l[?2004h>     learning_rate=0.05,
[?2004l[?2004h>     num_leaves=31,
[?2004l[?2004h>     random_state=42,
[?2004l[?2004h>     n_jobs=-1
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> model.fit(
[?2004l[?2004h>     X, y,
[?2004l[?2004h>     eval_set=[(X_val, y_val)],
[?2004l[?2004h>     eval_metric='rmse',
[?2004l[?2004h>     callbacks=[lgb.early_stopping(stopping_rounds=50)]
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> # Predict
[?2004l[?2004h> print('Predicting on test set...')
[?2004l[?2004h> preds = model.predict(X_test)
[?2004l[?2004h> 
[?2004l[?2004h> # Save results
[?2004l[?2004h> print('Saving predictions...')
[?2004l[?2004h> pred_df = pd.DataFrame({'target': preds})
[?2004l[?2004h> pred_df.to_csv('/app/predictions.csv', index=False)
[?2004l[?2004h> print('Done!')
[?2004l[?2004h> EOF
