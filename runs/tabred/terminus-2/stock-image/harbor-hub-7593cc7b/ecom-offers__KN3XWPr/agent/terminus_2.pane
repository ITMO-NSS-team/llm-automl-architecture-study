[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import lightgbm as lgb
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h> train = pd.read_csv('/app/data/train.csv')
[?2004l[?2004h> val = pd.read_csv('/app/data/val.csv')
[?2004l[?2004h> test = pd.read_csv('/app/data/test.csv')
[?2004l[?2004h> 
[?2004l[?2004h> X_train = train.drop('target', axis=1)
[?2004l[?2004h> y_train = train['target']
[?2004l[?2004h> X_val = val.drop('target', axis=1)
[?2004l[?2004h> y_val = val['target']
[?2004l[?2004h> X_test = test
[?2004l[?2004h> 
[?2004l[?2004h> # LightGBM parameters
[?2004l[?2004h> params = {
[?2004l[?2004h>     'objective': 'binary',
[?2004l[?2004h>     'metric': 'auc',
[?2004l[?2004h>     'verbosity': -1,
[?2004l[?2004h>     'boosting_type': 'gbdt',
[?2004l[?2004h>     'random_state': 42,
[?2004l[?2004h>     'learning_rate': 0.05,
[?2004l[?2004h>     'num_leaves': 31,
[?2004l[?2004h>     'feature_fraction': 0.8,
[?2004l[?2004h>     'bagging_fraction': 0.8,
[?2004l[?2004h>     'bagging_freq': 5
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> # Create LightGBM datasets
[?2004l[?2004h> dtrain = lgb.Dataset(X_train, label=y_train)
[?2004l[?2004h> val_set = lgb.Dataset(X_val, label=y_val, reference=dtrain)
[?2004l[?2004h> 
[?2004l[?2004h> # Train model
[?2004l[?2004h> model = lgb.train(
[?2004l[?2004h>     params,
[?2004l[?2004h>     dtrain,
[?2004l[?2004h>     num_boost_round=1000,
[?2004l[?2004h>     valid_sets=[dtrain, val_set],
[?2004l[?2004h>     callbacks=[lgb.early_stopping(stopping_rounds=50)]
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> # Predict probabilities for the positive class
[?2004l[?2004h> y_pred = model.predict(X_test)
[?2004l[?2004h> 
[?2004l[?2004h> # Save to CSV
