[?2004hroot@1ed0f5322b06:/workspace# pip list | grep scikit-learn
[?2004lcat << 'EOF' > solution.py
import pandas as pd
import numpy as np
from sklearn.ensemble import HistGradientBoostingClassifier

# Load data
train = pd.read_csv('/app/data/train.csv')
val = pd.read_csv('/app/data/val.csv')
test = pd.read_csv('/app/data/test.csv')

X_train = train.drop('target', axis=1)
y_train = train['target']
X_val = val.drop('target', axis=1)
y_val = val['target']
X_test = test

# Initialize HistGradientBoostingClassifier
# It handles NaNs natively
model = HistGradientBoostingClassifier(
    max_iter=100,
    learning_rate=0.1,
    max_depth=10,
    random_state=42
)

# Fit model
model.fit(X_train, y_train)

# Predict probabilities for the positive class
y_pred = model.predict_proba(X_test)[:, 1]

# Save to CSV
pred_df = pd.DataFrame({'target': y_pred})
pred_df.to_csv('/app/predictions.csv', index=False)
EOF
