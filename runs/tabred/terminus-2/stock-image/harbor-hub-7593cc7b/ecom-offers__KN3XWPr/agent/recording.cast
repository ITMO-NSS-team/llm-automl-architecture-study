[40.465401, "i", "cat << 'EOF' > solution.py\nimport pandas as pd\nimport lightgbm as lgb\nimport numpy as np\n\n# Load data\ntrain = pd.read_csv('/app/data/train.csv')\nval = pd.read_csv('/app/data/val.csv')\ntest = pd.read_csv('/app/data/test.csv')\n\nX_train = train.drop('target', axis=1)\ny_train = train['target']\nX_val = val.drop('target', axis=1)\ny_val = val['target']\nX_test = test\n\n# LightGBM parameters\nparams = {\n    'objective': 'binary',\n    'metric': 'auc',\n    'verbosity': -1,\n    'boosting_type': 'gbdt',\n    'random_state': 42,\n    'learning_rate': 0.05,\n    'num_leaves': 31,\n    'feature_fraction': 0.8,\n    'bagging_fraction': 0.8,\n    'bagging_freq': 5\n}\n\n# Create LightGBM datasets\ndtrain = lgb.Dataset(X_train, label=y_train)\nval_set = lgb.Dataset(X_val, label=y_val, reference=dtrain)\n\n# Train model\nmodel = lgb.train(\n    params,\n    dtrain,\n    num_boost_round=1000,\n    valid_sets=[dtrain, val_set],\n    callbacks=[lgb.early_stopping(stopping_rounds=50)]\n)\n\n# Predict probabilities for the positive class\ny_pred = model.predict(X_test)\n\n# Save to CSV\npred_df = pd.DataFrame({'target': y_pred})\npred_df.to_csv('/app/predictions.csv', index=False)\nEOF\n"]
