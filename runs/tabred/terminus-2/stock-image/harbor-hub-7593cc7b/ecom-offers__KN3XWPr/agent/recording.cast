[65.881672, "o", "y_pred = model.predict_proba(X_test)[:, 1]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Save to CSV\r\n\u001b[?2004l\r\u001b[?2004h> pred_df = pd.DataFrame({'target': y_pred})\r\n\u001b[?2004l\r\u001b[?2004h> pred_df.to_csv('/app/predictions.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
