[65.737956, "i", "cat << 'EOF' > solution.py\nimport pandas as pd\nimport numpy as np\nfrom sklearn.ensemble import HistGradientBoostingClassifier\n\n# Load data\ntrain = pd.read_csv('/app/data/train.csv')\nval = pd.read_csv('/app/data/val.csv')\ntest = pd.read_csv('/app/data/test.csv')\n\nX_train = train.drop('target', axis=1)\ny_train = train['target']\nX_val = val.drop('target', axis=1)\ny_val = val['target']\nX_test = test\n\n# Initialize HistGradientBoostingClassifier\n# It handles NaNs natively\nmodel = HistGradientBoostingClassifier(\n    max_iter=100,\n    learning_rate=0.1,\n    max_depth=10,\n    random_state=42\n)\n\n# Fit model\nmodel.fit(X_train, y_train)\n\n# Predict probabilities for the positive class\ny_pred = model.predict_proba(X_test)[:, 1]\n\n# Save to CSV\npred_df = pd.DataFrame({'target': y_pred})\npred_df.to_csv('/app/predictions.csv', index=False)\nEOF\n"]
[65.738162, "o", "cat << 'EOF' > solution.py\r\nimport pandas as pd\r\nimport numpy as np\r\nfrom sklearn.ensemble import HistGradientBoostingClassifier\r\n\r\n# Load data\r\ntrain = pd.read_csv('/app/data/train.csv')\r\nval = pd.read_csv('/app/data/val.csv')\r\ntest = pd.read_csv('/app/data/test.csv')\r\n\r\nX_train = train.drop('target', axis=1)\r\ny_train = train['target']\r\nX_val = val.drop('target', axis=1)\r\ny_val = val['target']\r\nX_test = test\r\n\r\n# Initialize HistGradientBoostingClassifier\r\n# It handles NaNs natively\r\nmodel = HistGradientBoostingClassifier(\r\n    max_iter=100,\r\n    learning_rate=0.1,\r\n    max_depth=10,\r\n    random_state=42\r\n)\r\n\r\n# Fit model\r\nmodel.fit(X_train, y_train)\r\n\r\n# Predict probabilities for the positive class\r\ny_pred = model.predict_proba(X_test)[:, 1]\r\n\r\n# Save to CSV\r\npred_df = pd.DataFrame({'target': y_pred})\r\npred_df.to_csv('/app/predictions.csv', index=False)\r\nEOF\r\n"]
