[0m[?2004hroot@b1893aadc496:/workspace# cat << 'EOF' > solution.py
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import xgboost as xgb
[?2004l[?2004h> from sklearn.metrics import mean_squared_error
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h> train = pd.read_csv('/app/data/train.csv')
[?2004l[?2004h> val = pd.read_csv('/app/data/val.csv')
[?2004l[?2004h> test = pd.read_csv('/app/data/test.csv')
[?2004l[?2004h> 
[?2004l[?2004h> # Separate features and target
[?2004l[?2004h> X_train = train.drop(columns=['target'])
[?2004l[?2004h> y_train = train['target']
[?2004l[?2004h> X_val = val.drop(columns=['target'])
[?2004l[?2004h> y_val = val['target']
[?2004l[?2004h> 
[?2004l[?2004h> # Simple preprocessing
[?2004l[?2004h> # Categorical features are identified by 'cat_'
[?2004l[?2004h> # Binary features by 'bin_'
[?2004l[?2004h> # Numerical features by 'num_'
[?2004l[?2004h> 
[?2004l[?2004h> # Convert categorical features to categories/integers
[?2004l[?2004h> cat_cols = [col for col in X_train.columns if col.startswith('cat_')]
[?2004l[?2004h> for col in cat_cols:
[?2004l[?2004h>     X_train[col] = X_train[col].astype('category').cat.codes
[?2004l[?2004h>     X_val[col] = X_val[col].astype('category').cat.codes
[?2004l[?2004h>     test[col] = test[col].astype('category').cat.codes
[?2004l[?2004h> 
[?2004l[?2004h> # Handle missing values for numerical features (XGBoost handles NaNs, but let's be safe)
[?2004l[?2004h> # XGBoost natively handles NaNs, so we don't necessarily need to fill them.
[?2004l[?2004h> 
[?2004l[?2004h> # Train XGBoost model
[?2004l[?2004h> model = xgb.XGBRegressor(n_estimators=1000, learning_rate=0.05, max_depth=6, random_state=42, objective='reg:squarederror')
[?2004l[?2004h> model.fit(X_train, y_train, eval_set=[(X_val, y_val)], early_stopping_rounds=50, verbose=100)
[?2004l[?2004h> 
[?2004l[?2004h> # Predict on test set
[?2004l[?2004h> preds = model.predict(test)
[?2004l[?2004h> 
[?2004l[?2004h> # Save to CSV
[?2004l[?2004h> submission = pd.DataFrame({'target': preds})
[?2004l[?2004h> submission.to_csv('/app/predictions.csv', index=False)
[?2004l[?2004h> EOF
