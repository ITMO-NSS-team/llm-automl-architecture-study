import pandas as pd
import xgboost as xgb
from sklearn.metrics import mean_squared_error
import numpy as np

# Load data
train = pd.read_csv('/app/data/train.csv')
val = pd.read_csv('/app/data/val.csv')
test = pd.read_csv('/app/data/test.csv')

# Separate features and target
X_train = train.drop(columns=['target'])
y_train = train['target']
X_val = val.drop(columns=['target'])
y_val = val['target']

# Simple preprocessing
# Categorical features are identified by 'cat_'
# Binary features by 'bin_'
# Numerical features by 'num_'

# Convert categorical features to categories/integers
cat_cols = [col for col in X_train.columns if col.startswith('cat_')]
for col in cat_cols:
    X_train[col] = X_train[col].astype('category').cat.codes
    X_val[col] = X_val[col].astype('category').cat.codes
    test[col] = test[col].astype('category').cat.codes

# Handle missing values for numerical features (XGBoost handles NaNs, but let's be safe)
# XGBoost natively handles NaNs, so we don't necessarily need to fill them.

# Train XGBoost model
model = xgb.XGBRegressor(n_estimators=1000, learning_rate=0.05, max_depth=6, random_state=42, objective='reg:squarederror')
model.fit(X_train, y_train, eval_set=[(X_val, y_val)], early_stopping_rounds=50, verbose=100)

# Predict on test set
preds = model.predict(test)

# Save to CSV
submission = pd.DataFrame({'target': preds})
submission.to_csv('/app/predictions.csv', index=False)
