[126.019331, "o", "\u001b[33mWARNING: Running pip as the 'root' user can result in broken permissions and conflicting behaviour with the system package manager, possibly rendering your system unusable. It is recommended to use a virtual environment instead: https://pip.pypa.io/warnings/venv. Use the --root-user-action option if you know what you are doing and want to suppress this warning.\u001b[0m\u001b[33m\r\n\u001b[0m"]
[126.061922, "o", "\u001b[?2004hroot@b1893aadc496:/workspace# cat << 'EOF' > solution.py\r\n\u001b[?2004l\r"]
[126.061955, "o", "\u001b[?2004h> import pandas as pd\r\n\u001b[?2004l\r"]
[126.062107, "o", "\u001b[?2004h> import xgboost as xgb\r\n\u001b[?2004l\r\u001b[?2004h> from sklearn.metrics import mean_squared_error\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h"]
[126.062218, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> # Load data\r\n\u001b[?2004l\r\u001b[?2004h> "]
[126.062319, "o", "train = pd.read_csv('/app/data/train.csv')\r\n\u001b[?2004l\r\u001b[?2004h> val = pd.read_csv('/app/data/val.csv')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[126.062434, "o", "test = pd.read_csv('/app/data/test.csv')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Separate features and target\r\n\u001b[?2004l\r\u001b[?2004h> "]
[126.06246, "o", "X_train = train.drop(columns=['target'])\r\n\u001b[?2004l\r\u001b[?2004h> y_train = train['target']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[126.062529, "o", "X_val = val.drop(columns=['target'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[126.062595, "o", "y_val = val['target']\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Simple preprocessing\r\n\u001b[?2004l\r\u001b[?2004h> "]
[126.062708, "o", "# Categorical features are identified by 'cat_'\r\n\u001b[?2004l\r"]
[126.062793, "o", "\u001b[?2004h> # Binary features by 'bin_'\r\n\u001b[?2004l\r"]
[126.062903, "o", "\u001b[?2004h> # Numerical features by 'num_'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[126.062982, "o", "# Convert categorical features to categories/integers\r\n\u001b[?2004l\r\u001b[?2004h> "]
[126.063091, "o", "cat_cols = [col for col in X_train.columns if col.startswith('cat_')]\r\n\u001b[?2004l\r\u001b[?2004h> for col in cat_cols:\r\n\u001b[?2004l\r\u001b[?2004h"]
[126.063111, "o", "> "]
[126.063205, "o", "    X_train[col] = X_train[col].astype('category').cat.codes\r\n\u001b[?2004l\r\u001b[?2004h> "]
[126.063285, "o", "    X_val[col] = X_val[col].astype('category').cat.codes\r\n\u001b[?2004l\r"]
[126.063332, "o", "\u001b[?2004h> "]
[126.063416, "o", "    test[col] = test[col].astype('category').cat.codes\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[126.063497, "o", "# Handle missing values for numerical features (XGBoost handles NaNs, but let's be safe)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[126.063576, "o", "# XGBoost natively handles NaNs, so we don't necessarily need to fill them.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Train XGBoost model\r\n\u001b[?2004l\r"]
[126.063626, "o", "\u001b[?2004h> "]
[126.06373, "o", "model = xgb.XGBRegressor(n_estimators=1000, learning_rate=0.05, max_depth=6, random_state=42, objective='reg:squarederror')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[126.063839, "o", "model.fit(X_train, y_train, eval_set=[(X_val, y_val)], early_stopping_rounds=50, verbose=100)\r\n"]
