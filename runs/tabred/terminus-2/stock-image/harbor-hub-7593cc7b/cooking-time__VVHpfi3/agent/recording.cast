[132.247485, "o", "  File \u001b[35m\"/workspace/solution.py\"\u001b[0m, line \u001b[35m34\u001b[0m, in \u001b[35m<module>\u001b[0m\r\n    \u001b[31mmodel.fit\u001b[0m\u001b[1;31m(X_train, y_train, eval_set=[(X_val, y_val)], early_stopping_rounds=50, verbose=100)\u001b[0m\r\n    \u001b[31m~~~~~~~~~\u001b[0m\u001b[1;31m^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\u001b[0m\r\n  File \u001b[35m\"/usr/local/lib/python3.13/site-packages/xgboost/core.py\"\u001b[0m, line \u001b[35m553\u001b[0m, in \u001b[35minner_f\u001b[0m\r\n    return func(**kwargs)\r\n\u001b[1;35mTypeError\u001b[0m: \u001b[35mXGBModel.fit() got an unexpected keyword argument 'early_stopping_rounds'\u001b[0m\r\n"]
[132.356116, "o", "\u001b[?2004hroot@b1893aadc496:/workspace# "]
[166.532951, "i", "cat << 'EOF' > solution.py\nimport pandas as pd\nimport xgboost as xgb\nimport numpy as np\n\n# Load data\ntrain = pd.read_csv('/app/data/train.csv')\nval = pd.read_csv('/app/data/val.csv')\ntest = pd.read_csv('/app/data/test.csv')\n\n# Separate features and target\nX_train = train.drop(columns=['target'])\ny_train = train['target']\nX_val = val.drop(columns=['target'])\ny_val = val['target']\n\n# Handle Categorical features\n# To ensure consistency across train, val, and test, we fit categories on train\ncat_cols = [col for col in X_train.columns if col.startswith('cat_')]\nfor col in cat_cols:\n    # Combine all values to create a consistent mapping\n    all_values = pd.concat([X_train[col], X_val[col], test[col]]).astype(str).unique()\n    mapping = {val: i for i, val in enumerate(all_values)}\n    X_train[col] = X_train[col].astype(str).map(mapping)\n    X_val[col] = X_val[col].astype(str).map(mapping)\n    test[col] = test[col].astype(str).map(mapping)\n\n# Train XGBoost model\nmodel = xgb.XGBRegressor(n_estimators=1000, learning_rate=0.05, max_depth=6, random_state=42, objective='reg:squarederror')\nmodel.fit(X_train, y_train, eval_set=[(X_val, y_val)], early_stopping_rounds=50, verbose=100)\n\n# Predict on test set\npreds = model.predict(test)\n\n# Save to CSV\nsubmission = pd.DataFrame({'target': preds})\nsubmission.to_csv('/app/predictions.csv', index=False)\nEOF\n"]
