[155.593041, "i", "cat <<EOF > solution.py\nimport pandas as pd\nimport numpy as np\nfrom sklearn.ensemble import HistGradientBoostingRegressor\n\n# Load data\ntrain = pd.read_csv('/app/data/train.csv')\nval = pd.read_csv('/app/data/val.csv')\ntest = pd.read_csv('/app/data/test.csv')\n\n# Identify feature types\nnum_cols = [c for c in train.columns if c.startswith('num_')]\nbin_cols = [c for c in train.columns if c.startswith('bin_')]\ncat_cols = [c for c in train.columns if c.startswith('cat_')]\n\n# target column\ny_train = train['target']\ny_val = val['target']\n\n# Prepare features\nX_train = train.drop(columns=['target'])\nX_val = val.drop(columns=['target'])\nX_test = test\n\n# HistGradientBoostingRegressor handles NaNs natively.\n# We just need to ensure categories are represented as integers for the 'categorical_features' parameter\nall_cat_cols = cat_cols + bin_cols\n\n# Convert categories to codes\nfor col in all_cat_cols:\n    X_train[col] = X_train[col].astype('category').cat.codes\n    X_val[col] = X_val[col].astype('category').cat.codes\n    X_test[col] = X_test[col].astype('category').cat.codes\n\n# Identify indices of categorical features\ncat_indices = [X_train.columns.get_loc(col) for col in all_cat_cols]\n\n# Train model\nmodel = HistGradientBoostingRegressor(\n    max_iter=1000,\n    learning_rate=0.05,\n    categorical_features=cat_indices,\n    random_state=42\n)\n\nmodel.fit(X_train, y_train)\n\n# Predict\npreds = model.predict(X_test)\n\n# Save predictions\npreds_df = pd.DataFrame({'target': preds})\npreds_df.to_csv('/app/predictions.csv', index=False)\nEOF\n"]
