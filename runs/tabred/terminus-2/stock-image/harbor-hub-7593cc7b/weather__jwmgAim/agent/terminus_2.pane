[?2004hroot@65c9ea28cd7e:/workspace# cat << 'EOF' > solution.py
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import lightgbm as lgb
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from sklearn.metrics import mean_squared_error
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h> train = pd.read_csv('/app/data/train.csv')
[?2004l[?2004h> val = pd.read_csv('/app/data/val.csv')
[?2004l[?2004h> test = pd.read_csv('/app/data/test.csv')
[?2004l[?2004h> 
[?2004l[?2004h> # Separate features and target
[?2004l[?2004h> X_train = train.drop(columns=['target'])
[?2004l[?2004h> y_train = train['target']
[?2004l[?2004h> X_val = val.drop(columns=['target'])
[?2004l[?2004h> y_val = val['target']
[?2004l[?2004h> 
[?2004l[?2004h> # Identify categorical features if any (starting with cat_)
[?2004l[?2004h> cat_features = [col for col in X_train.columns if col.startswith('cat_')]
[?2004l[?2004h> for col in cat_features:
[?2004l[?2004h>     X_train[col] = X_train[col].astype('category')
[?2004l[?2004h>     X_val[col] = X_val[col].astype('category')
[?2004l[?2004h>     test[col] = test[col].astype('category')
[?2004l[?2004h> 
[?2004l[?2004h> # LightGBM params
[?2004l[?2004h> params = {
[?2004l[?2004h>     'objective': 'regression',
[?2004l[?2004h>     'metric': 'rmse',
[?2004l[?2004h>     'verbosity': -1,
[?2004l[?2004h>     'boosting_type': 'gbdt',
[?2004l[?2004h>     'random_state': 42,
[?2004l[?2004h>     'learning_rate': 0.05,
[?2004l[?2004h>     'num_leaves': 31,
[?2004l[?2004h>     'feature_fraction': 0.8,
[?2004l[?2004h>     'bagging_fraction': 0.8,
[?2004l[?2004h>     'bagging_freq': 5
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> # Create LightGBM datasets
[?2004l[?2004h> dtrain = lgb.Dataset(X_train, label=y_train, categorical_feature=cat_features)
[?2004l[?2004h> val_set = lgb.Dataset(X_val, label=y_val, reference=dtrain, categorical_feature=cat_features)
[?2004l[?2004h> 
[?2004l[?2004h> # Train model
[?2004l[?2004h> model = lgb.train(
[?2004l[?2004h>     params,
[?2004l[?2004h>     dtrain,
[?2004l[?2004h>     num_boost_round=1000,
[?2004l[?2004h>     valid_sets=[dtrain, val_set],
[?2004l[?2004h>     callbacks=[lgb.early_stopping(stopping_rounds=50), lgb.log_evaluation(period=100)]
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> # Predict and evaluate on validation set
[?2004l[?2004h> val_preds = model.predict(X_val)
[?2004l[?2004h> rmse = np.sqrt(mean_squared_error(y_val, val_preds))
[?2004l[?2004h> print(f'Validation RMSE: {rmse}')
[?2004l[?2004h> 
[?2004l[?2004h> # Predict on test set
[?2004l[?2004h> test_preds = model.predict(test)
[?2004l[?2004h> 
[?2004l[?2004h> # Save predictions to CSV
[?2004l[?2004h> preds_df = pd.DataFrame({'target': test_preds})
[?2004l[?2004h> preds_df.to_csv('/app/predictions.csv', index=False)
[?2004l[?2004h> print('Predictions saved to /app/predictions.csv')
[?2004l[?2004h> EOF
