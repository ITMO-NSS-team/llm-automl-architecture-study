[0m[?2004hroot@3916ae05b741:/workspace# cat <<EOF > solution.py
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import lightgbm as lgb
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from sklearn.metrics import mean_squared_error
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h> train = pd.read_csv('/app/data/train.csv')
[?2004l[?2004h> val = pd.read_csv('/app/data/val.csv')
[?2004l[?2004h> test = pd.read_csv('/app/data/test.csv')
[?2004l[?2004h> 
[?2004l[?2004h> X_train = train.drop('target', axis=1)
[?2004l[?2004h> y_train = train['target']
[?2004l[?2004h> X_val = val.drop('target', axis=1)
[?2004l[?2004h> y_val = val['target']
[?2004l[?2004h> 
[?2004l[?2004h> # Identify categorical features
[?2004l[?2004h> cat_features = [col for col in X_train.columns if col.startswith('cat_') or col.startswith('bin_')]
[?2004l[?2004h> for col in cat_features:
[?2004l[?2004h>     X_train[col] = X_train[col].astype('category')
[?2004l[?2004h>     X_val[col] = X_val[col].astype('category')
[?2004l[?2004h>     test[col] = test[col].astype('category')
[?2004l[?2004h> 
[?2004l[?2004h> # Model training
[?2004l[?2004h> model = lgb.LGBMRegressor(n_estimators=1000, learning_rate=0.05, random_state=42)
[?2004l[?2004h> model.fit(X_train, y_train, eval_set=[(X_val, y_val)], eval_metric='rmse', callbacks=[lgb.early_stopping(stopping_rounds=50)])
[?2004l[?2004h> 
[?2004l[?2004h> # Prediction
[?2004l[?2004h> preds = model.predict(test)
[?2004l[?2004h> 
[?2004l[?2004h> # Save output
[?2004l[?2004h> output = pd.DataFrame({'target': preds})
[?2004l[?2004h> output.to_csv('/app/predictions.csv', index=False)
[?2004l[?2004h> EOF
