[26.141605, "i", "cat <<EOF > solution.py\nimport pandas as pd\nimport lightgbm as lgb\nimport numpy as np\nfrom sklearn.metrics import mean_squared_error\n\n# Load data\ntrain = pd.read_csv('/app/data/train.csv')\nval = pd.read_csv('/app/data/val.csv')\ntest = pd.read_csv('/app/data/test.csv')\n\nX_train = train.drop('target', axis=1)\ny_train = train['target']\nX_val = val.drop('target', axis=1)\ny_val = val['target']\n\n# Identify categorical features\ncat_features = [col for col in X_train.columns if col.startswith('cat_') or col.startswith('bin_')]\nfor col in cat_features:\n    X_train[col] = X_train[col].astype('category')\n    X_val[col] = X_val[col].astype('category')\n    test[col] = test[col].astype('category')\n\n# Model training\nmodel = lgb.LGBMRegressor(n_estimators=1000, learning_rate=0.05, random_state=42)\nmodel.fit(X_train, y_train, eval_set=[(X_val, y_val)], eval_metric='rmse', callbacks=[lgb.early_stopping(stopping_rounds=50)])\n\n# Prediction\npreds = model.predict(test)\n\n# Save output\noutput = pd.DataFrame({'target': preds})\noutput.to_csv('/app/predictions.csv', index=False)\nEOF\n"]
[26.143577, "o", "cat <<EOF > solution.py\r\n\u001b[?2004l\r\u001b[?2004h> import pandas as pd\r\n\u001b[?2004l\r\u001b[?2004h> import lightgbm as lgb\r\n\u001b[?2004l\r\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h> from sklearn.metrics import mean_squared_error\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Load data\r\n\u001b[?2004l\r\u001b[?2004h> train = pd.read_csv('/app/data/train.csv')\r\n\u001b[?2004l\r\u001b[?2004h> val = pd.read_csv('/app/data/val.csv')\r\n\u001b[?2004l\r\u001b[?2004h> test = pd.read_csv('/app/data/test.csv')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> X_train = train.drop('target', axis=1)\r\n\u001b[?2004l\r\u001b[?2004h> y_train = train['target']\r\n\u001b[?2004l\r\u001b[?2004h> X_val = val.drop('target', axis=1)\r\n\u001b[?2004l\r\u001b[?2004h> y_val = val['target']\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Identify categorical features\r\n\u001b[?2004l\r\u001b[?2004h> cat_features = [col for col in X_train.columns if col.startswith('cat_') or col.startswith('bin_')]\r\n\u001b[?2004l\r\u001b[?2004h> for col in cat_features:\r\n\u001b[?2004l\r\u001b[?2004h>     X_train[col] = X_train[col].astype('category')\r\n\u001b[?2004l\r\u001b[?2004h>     X_val[col] = X_val[col].astype('category')\r\n\u001b[?2004l\r\u001b[?2004h>     test[col] = test[col].astype('category')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Model training\r\n\u001b[?2004l\r\u001b[?2004h> model = lgb.LGBMRegressor(n_estimators=1000, learning_rate=0.05, random_state=42)\r\n\u001b[?2004l\r\u001b[?2004h> model.fit(X_train, y_train, eval_set=[(X_val, y_val)], eval_metric='rmse', callbacks=[lgb.early_stopping(stopping_rounds=50)])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Prediction\r\n\u001b[?2004l\r\u001b[?2004h> preds = model.predict(test)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Save output\r\n\u001b[?2004l\r\u001b[?2004h> output = pd.DataFrame({'target': preds})\r\n\u001b[?2004l\r\u001b[?2004h> output.to_csv('/app/predictions.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
