[0m[?2004hroot@910cf2619620:/workspace# cat << 'EOF' > solution.py
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import lightgbm as lgb
[?2004l[?2004h> from sklearn.metrics import roc_auc_score
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h> train = pd.read_csv('/app/data/train.csv')
[?2004l[?2004h> val = pd.read_csv('/app/data/val.csv')
[?2004l[?2004h> test = pd.read_csv('/app/data/test.csv')
[?2004l[?2004h> 
[?2004l[?2004h> # Identify feature types
[?2004l[?2004h> num_cols = [col for col in train.columns if col.startswith('num_')]
[?2004l[?2004h> bin_cols = [col for col in train.columns if col.startswith('bin_')]
[?2004l[?2004h> cat_cols = [col for col in train.columns if col.startswith('cat_')]
[?2004l[?2004h> 
[?2004l[?2004h> # Target column
[?2004l[?2004h> label = 'target'
[?2004l[?2004h> 
[?2004l[?2004h> # Basic preprocessing
[?2004l[?2004h> # Fill numerical NaNs with median
[?2004l[?2004h> for col in num_cols:
[?2004l[?2004h>     train[col] = train[col].fillna(train[col].median())
[?2004l[?2004h>     val[col] = val[col].fillna(train[col].median())
[?2004l[?2004h>     test[col] = test[col].fillna(train[col].median())
[?2004l[?2004h> 
[?2004l[?2004h> # Handle categorical features by converting to category type for LightGBM
[?2004l[?2004h> for col in cat_cols:
[?2004l[?2004h>     train[col] = train[col].astype('category')
[?2004l[?2004h>     val[col] = val[col].astype('category')
[?2004l[?2004h>     test[col] = test[col].astype('category')
[?2004l[?2004h> 
[?2004l[?2004h> # Split features and target
[?2004l[?2004h> X_train, y_train = train.drop(columns=[label]), train[label]
[?2004l[?2004h> X_val, y_val = val.drop(columns=[label]), val[label]
[?2004l[?2004h> 
[?2004l[?2004h> # Train LightGBM
[?2004l[?2004h> model = lgb.LGBMClassifier(n_estimators=1000, learning_rate=0.05, num_leaves=31, random_state=42)
[?2004l[?2004h> model.fit(
[?2004l[?2004h>     X_train, y_train,
[?2004l[?2004h>     eval_set=[(X_val, y_val)],
[?2004l[?2004h>     eval_metric='auc',
[?2004l[?2004h>     callbacks=[lgb.early_stopping(stopping_rounds=50)]
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> # Predict probabilities for the positive class
[?2004l[?2004h> preds = model.predict_proba(test)[:, 1]
[?2004l[?2004h> 
[?2004l[?2004h> # Save to CSV
[?2004l[?2004h> preds_df = pd.DataFrame({'target': preds})
[?2004l[?2004h> preds_df.to_csv('/app/predictions.csv', index=False)
[?2004l[?2004h> EOF
