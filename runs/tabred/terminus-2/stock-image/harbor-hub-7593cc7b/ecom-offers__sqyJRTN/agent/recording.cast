[49.317481, "o", "\u001b[?2004hroot@910cf2619620:/workspace# "]
[56.318535, "i", "cat << 'EOF' > solution.py\nimport pandas as pd\nimport numpy as np\nimport lightgbm as lgb\nfrom sklearn.metrics import roc_auc_score\n\n# Load data\ntrain = pd.read_csv('/app/data/train.csv')\nval = pd.read_csv('/app/data/val.csv')\ntest = pd.read_csv('/app/data/test.csv')\n\n# Identify feature types\nnum_cols = [col for col in train.columns if col.startswith('num_')]\nbin_cols = [col for col in train.columns if col.startswith('bin_')]\ncat_cols = [col for col in train.columns if col.startswith('cat_')]\n\n# Target column\nlabel = 'target'\n\n# Basic preprocessing\n# Fill numerical NaNs with median\nfor col in num_cols:\n    train[col] = train[col].fillna(train[col].median())\n    val[col] = val[col].fillna(train[col].median())\n    test[col] = test[col].fillna(train[col].median())\n\n# Handle categorical features by converting to category type for LightGBM\nfor col in cat_cols:\n    train[col] = train[col].astype('category')\n    val[col] = val[col].astype('category')\n    test[col] = test[col].astype('category')\n\n# Split features and target\nX_train, y_train = train.drop(columns=[label]), train[label]\nX_val, y_val = val.drop(columns=[label]), val[label]\n\n# Train LightGBM\nmodel = lgb.LGBMClassifier(n_estimators=1000, learning_rate=0.05, num_leaves=31, random_state=42)\nmodel.fit(\n    X_train, y_train,\n    eval_set=[(X_val, y_val)],\n    eval_metric='auc',\n    callbacks=[lgb.early_stopping(stopping_rounds=50)]\n)\n\n# Predict probabilities for the positive class\npreds = model.predict_proba(test)[:, 1]\n\n# Save to CSV\npreds_df = pd.DataFrame({'target': preds})\npreds_df.to_csv('/app/predictions.csv', index=False)\nEOF\n"]
