[?2004hroot@c5abba6907c1:/workspace# cat << 'EOF' > solution.py
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import lightgbm as lgb
[?2004l[?2004h> from sklearn.metrics import roc_auc_score
[?2004l[?2004h> 
[?2004l[?2004h> # Load data
[?2004l[?2004h> print('Loading data...')
[?2004l[?2004h> train = pd.read_csv('/app/data/train.csv')
[?2004l[?2004h> val = pd.read_csv('/app/data/val.csv')
[?2004l[?2004h> test = pd.read_csv('/app/data/test.csv')
[?2004l[?2004h> 
[?2004l[?2004h> x_train = train.drop('target', axis=1)
[?2004l[?2004h> y_train = train['target']
[?2004l[?2004h> x_val = val.drop('target', axis=1)
[?2004l[?2004h> y_val = val['target']
[?2004l[?2004h> 
[?2004l[?2004h> # Identify categorical features
[?2004l[?2004h> cat_cols = [col for col in x_train.columns if col.startswith('cat_')]
[?2004l[?2004h> 
[?2004l[?2004h> # Convert to category dtype for LightGBM
[?2004l[?2004h> for col in cat_cols:
[?2004l[?2004h>     x_train[col] = x_train[col].astype('category')
[?2004l[?2004h>     x_val[col] = x_val[col].astype('category')
[?2004l[?2004h>     test[col] = test[col].astype('category')
[?2004l[?2004h> 
[?2004l[?2004h> # Initialize and train LightGBM
[?2004l[?2004h> print('Training model...')
[?2004l[?2004h> model = lgb.LGBMClassifier(
[?2004l[?2004h>     n_estimators=1000,
[?2004l[?2004h>     learning_rate=0.05,
[?2004l[?2004h>     num_leaves=31,
[?2004l[?2004h>     random_state=42,
[?2004l[?2004h>     n_jobs=-1,
[?2004l[?2004h>     importance_type='gain'
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> model.fit(
[?2004l[?2004h>     x_train, y_train,
[?2004l[?2004h>     eval_set=[(x_val, y_val)],
[?2004l[?2004h>     eval_metric='auc',
[?2004l[?2004h>     callbacks=[lgb.early_stopping(stopping_rounds=50)]
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> # Predict probabilities for the positive class
[?2004l[?2004h> print('Predicting...')
[?2004l[?2004h> probs = model.predict_proba(test)[:, 1]
[?2004l[?2004h> 
[?2004l[?2004h> # Save predictions
[?2004l[?2004h> print('Saving predictions...')
[?2004l[?2004h> pred_df = pd.DataFrame({'target': probs})
[?2004l[?2004h> pred_df.to_csv('/app/predictions.csv', index=False)
[?2004l[?2004h> 
[?2004l[?2004h> # Validation score for sanity check
[?2004l[?2004h> val_probs = model.predict_proba(x_val)[:, 1]
[?2004l[?2004h> print(f'Validation ROC-AUC: {roc_auc_score(y_val, val_probs):.4f}')
[?2004l[?2004h> EOF
