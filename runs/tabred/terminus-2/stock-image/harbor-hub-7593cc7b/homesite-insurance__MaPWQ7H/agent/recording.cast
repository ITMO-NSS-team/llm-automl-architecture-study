[4.73348, "o", "\u001b[?2004hroot@c5abba6907c1:/workspace# "]
[20.411186, "i", "cat << 'EOF' > solution.py\nimport pandas as pd\nimport lightgbm as lgb\nfrom sklearn.metrics import roc_auc_score\n\n# Load data\nprint('Loading data...')\ntrain = pd.read_csv('/app/data/train.csv')\nval = pd.read_csv('/app/data/val.csv')\ntest = pd.read_csv('/app/data/test.csv')\n\nx_train = train.drop('target', axis=1)\ny_train = train['target']\nx_val = val.drop('target', axis=1)\ny_val = val['target']\n\n# Identify categorical features\ncat_cols = [col for col in x_train.columns if col.startswith('cat_')]\n\n# Convert to category dtype for LightGBM\nfor col in cat_cols:\n    x_train[col] = x_train[col].astype('category')\n    x_val[col] = x_val[col].astype('category')\n    test[col] = test[col].astype('category')\n\n# Initialize and train LightGBM\nprint('Training model...')\nmodel = lgb.LGBMClassifier(\n    n_estimators=1000,\n    learning_rate=0.05,\n    num_leaves=31,\n    random_state=42,\n    n_jobs=-1,\n    importance_type='gain'\n)\n\nmodel.fit(\n    x_train, y_train,\n    eval_set=[(x_val, y_val)],\n    eval_metric='auc',\n    callbacks=[lgb.early_stopping(stopping_rounds=50)]\n)\n\n# Predict probabilities for the positive class\nprint('Predicting...')\nprobs = model.predict_proba(test)[:, 1]\n\n# Save predictions\nprint('Saving predictions...')\npred_df = pd.DataFrame({'target': probs})\npred_df.to_csv('/app/predictions.csv', index=False)\n\n# Validation score for sanity check\nval_probs = model.predict_proba(x_val)[:, 1]\nprint(f'Validation ROC-AUC: {roc_auc_score(y_val, val_probs):.4f}')\nEOF\n"]
