[305.648841, "i", "cat << 'EOF' > solution.py\nimport pandas as pd\nimport numpy as np\nfrom sklearn.ensemble import HistGradientBoostingRegressor\n\n# Load data\nprint('Loading data...')\ntrain = pd.read_csv('/app/data/train.csv')\nval = pd.read_csv('/app/data/val.csv')\ntest = pd.read_csv('/app/data/test.csv')\n\n# Separate target and features\ntarget_col = 'target'\nX_train = train.drop(columns=[target_col])\ny_train = train[target_col]\nX_val = val.drop(columns=[target_col])\ny_val = val[target_col]\n\n# HistGradientBoostingRegressor handles NaNs and categorical features (if specified)\n# However, since most features are prefixed with num_ and only one is cat_, \n# we can treat everything as numeric or let it handle the single cat_ feature as numeric \n# (which often works fine for small cardinality) or explicitly set it.\n\n# Identify categorical columns\ncat_cols = [i for i, col in enumerate(X_train.columns) if col.startswith('cat_')]\ncategorical_mask = [i in cat_cols for i in range(len(X_train.columns))]\n\n# Model initialization\nprint('Training model...')\nmodel = HistGradientBoostingRegressor(\n    max_iter=1000,\n    learning_rate=0.1,\n    max_depth=10,\n    random_state=42,\n    categorical_features=categorical_mask,\n    early_stopping=True,\n    validation_fraction=0.1, # Internal split if we didn't have a val set\n    n_iter_no_change=50\n)\n\n# To use the provided val set for early stopping, we can use partial_fit or similar, \n# but HistGradientBoostingRegressor handles internal validation well.\n# Given the time and environment, a standard fit on train should be robust.\nmodel.fit(X_train, y_train)\n\n# Predict\nprint('Predicting...')\npreds = model.predict(test)\n\n# Save predictions\npred_df = pd.DataFrame({'target': preds})\npred_df.to_csv('/app/predictions.csv', index=False)\nprint('Predictions saved to /app/predictions.csv')\nEOF\n"]
[305.650098, "o", "cat << 'EOF' > solution.py\r\n\u001b[?2004l\r\u001b[?2004h> import pandas as pd"]
