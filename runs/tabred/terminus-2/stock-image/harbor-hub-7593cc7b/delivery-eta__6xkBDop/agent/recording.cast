[305.651166, "o", "# Separate target and features\r\n\u001b[?2004l\r\u001b[?2004h> target_col = 'target'\r\n\u001b[?2004l\r\u001b[?2004h> X_train = train.drop(columns=[target_col])\r\n\u001b[?2004l\r\u001b[?2004h> y_train = train[target_col]\r\n\u001b[?2004l\r\u001b[?2004h> X_val = val.drop(columns=[target_col])\r\n\u001b[?2004l\r\u001b[?2004h> y_val = val[target_col]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # HistGradientBoostingRegressor handles NaNs and categorical features (if specified)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.651263, "o", "# However, since most features are prefixed with num_ and only one is cat_, \r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.651694, "o", "# we can treat everything as numeric or let it handle the single cat_ feature as numeric \r\n\u001b[?2004l\r\u001b[?2004h> # (which often works fine for small cardinality) or explicitly set it.\r\n\u001b[?2004l\r\u001b[?2004h"]
[305.651806, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> # Identify categorical columns\r\n\u001b[?2004l\r\u001b[?2004h> cat_cols = [i for i, col in enumerate(X_train.columns) if col.startswith('cat_')]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.651903, "o", "categorical_mask = [i in cat_cols for i in range(len(X_train.columns))]\r\n\u001b[?2004l\r"]
[305.651925, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.652006, "o", "# Model initialization\r\n\u001b[?2004l\r"]
[305.652077, "o", "\u001b[?2004h> print('Training model...')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.652199, "o", "model = HistGradientBoostingRegressor(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.652247, "o", "    max_iter=1000,\r\n\u001b[?2004l\r\u001b[?2004h>     learning_rate=0.1,\r\n\u001b[?2004l\r\u001b[?2004h>     max_depth=10,\r\n\u001b[?2004l\r\u001b[?2004h>     random_state=42,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.652352, "o", "    categorical_features=categorical_mask,\r\n\u001b[?2004l\r\u001b[?2004h>     early_stopping=True,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.65244, "o", "    validation_fraction=0.1, # Internal split if we didn't have a val set\r\n\u001b[?2004l\r\u001b[?2004h>     n_iter_no_change=50\r\n\u001b[?2004l\r"]
[305.652509, "o", "\u001b[?2004h> )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.652593, "o", "# To use the provided val set for early stopping, we can use partial_fit or similar, \r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.652677, "o", "# but HistGradientBoostingRegressor handles internal validation well.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.652747, "o", "# Given the time and environment, a standard fit on train should be robust.\r\n\u001b[?2004l\r\u001b[?2004h> model.fit(X_train, y_train)"]
[305.652767, "o", "\r\n\u001b[?2004l\r"]
[305.65282, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Predict\r\n"]
[305.652835, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[305.652919, "o", "print('Predicting...')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.653058, "o", "preds = model.predict(test)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Save predictions\r\n\u001b[?2004l\r\u001b[?2004h> pred_df = pd.DataFrame({'target': preds})\r\n\u001b[?2004l\r"]
[305.653113, "o", "\u001b[?2004h> "]
[305.653274, "o", "pred_df.to_csv('/app/predictions.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[305.653358, "o", "print('Predictions saved to /app/predictions.csv')\r\n\u001b[?2004l\r\u001b[?2004h> EOF"]
[305.653428, "o", "\r\n\u001b[?2004l\r"]
[305.654084, "o", "\u001b[?2004hroot@429f0f3f7e19:/workspace# "]
[305.745984, "i", "python3 solution.py\n"]
[305.746159, "o", "python3 solution.py\r\n\u001b[?2004l\r"]
[306.905887, "o", "Loading data...\r\n"]
[313.148828, "o", "Training model...\r\n"]
[325.232523, "o", "Predicting...\r\n"]
[325.326502, "o", "Predictions saved to /app/predictions.csv\r\n"]
[325.424931, "o", "\u001b[?2004hroot@429f0f3f7e19:/workspace# "]
[411.178707, "i", "wc -l /app/predictions.csv\n"]
[411.179, "o", "wc -l /app/predictions.csv\r\n\u001b[?2004l\r"]
[411.181272, "o", "36928 /app/predictions.csv\r\n"]
[411.181461, "o", "\u001b[?2004hroot@429f0f3f7e19:/workspace# "]
