[25.617966, "i", "cat << 'EOF' > solution.py\nimport pandas as pd\nimport lightgbm as lgb\nimport numpy as np\n\n# Load data\nprint('Loading data...')\ntrain = pd.read_csv('/app/data/train.csv')\nval = pd.read_csv('/app/data/val.csv')\ntest = pd.read_csv('/app/data/test.csv')\n\n# Separate target and features\ntarget_col = 'target'\nX_train = train.drop(columns=[target_col])\ny_train = train[target_col]\nX_val = val.drop(columns=[target_col])\ny_val = val[target_col]\n\n# Identify feature types\n# num_ features are numeric, bin_ are numeric/binary, cat_ are categorical\ncat_features = [col for col in X_train.columns if col.startswith('cat_')]\n\n# LightGBM dataset\ndtrain = lgb.Dataset(X_train, label=y_train, categorical_feature=cat_features)\nval_set = lgb.Dataset(X_val, label=y_val, reference=dtrain, categorical_feature=cat_features)\n\n# Hyperparameters for regression\nparams = {\n    'objective': 'regression',\n    'metric': 'rmse',\n    'verbosity': -1,\n    'boosting_type': 'gbdt',\n    'random_state': 42,\n    'learning_rate': 0.05,\n    'num_leaves': 31,\n    'feature_fraction': 0.8,\n    'bagging_fraction': 0.8,\n    'bagging_freq': 5,\n}\n\n# Train model\nprint('Training model...')\nmodel = lgb.train(\n    params,\n    dtrain,\n    num_boost_round=2000,\n    valid_sets=[dtrain, val_set],\n    valid_names=['train', 'valid'],\n    callbacks=[lgb.early_stopping(stopping_rounds=50), lgb.log_evaluation(period=100)]\n)\n\n# Predict\nprint('Predicting...')\npreds = model.predict(test)\n\n# Save predictions\n# Required: single column named 'target', no index\npred_df = pd.DataFrame({'target': preds})\npred_df.to_csv('/app/predictions.csv', index=False)\nprint('Predictions saved to /app/predictions.csv')\nEOF\n"]
